            <math id="algorithm2.m36" class="ltx_Math" alttext="l^{\prime}\leftarrow(l^{\prime}-1)/(L-1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l^{\prime}\leftarrow(l^{\prime}-1)/(L-1)</annotation></semantics></math>  <span id="algorithm2.4.33.2" class="ltx_text"><span id="algorithm2.4.33.2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.33.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Normalize to [0, 1] range.</span> 
</div>
<div id="algorithm2.4.34" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.4.34.1" class="ltx_text"><span id="algorithm2.4.34.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.34.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Set initial ground truth estimate to sample at timestep <math id="algorithm2.m37" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#34A853;" mathcolor="#34A853">l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. </span> 
</div>
<div id="algorithm2.4.35" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.35.1" class="ltx_text ltx_font_bold">23</span></span>
            <math id="algorithm2.m38" class="ltx_Math" alttext="\{\hat{P}_{n_{T},1,l},\hat{V}_{n_{T},1,l},\hat{C}_{n_{T},1,l}\}\leftarrow\{\tilde{P}_{n_{T},l},\ \tilde{V}_{n_{T},l},\ \tilde{C}_{n_{T},l}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\hat{P}_{n_{T},1,l},\hat{V}_{n_{T},1,l},\hat{C}_{n_{T},1,l}\}\leftarrow\{\tilde{P}_{n_{T},l},\ \tilde{V}_{n_{T},l},\ \tilde{C}_{n_{T},l}\}</annotation></semantics></math>

</div>
<div id="algorithm2.4.36" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.4.36.1" class="ltx_text"><span id="algorithm2.4.36.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.36.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Iterate over refinement steps. </span> 
</div>
<div id="algorithm2.4.37" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.37.1" class="ltx_text ltx_font_bold">24</span></span>
            <span id="algorithm2.4.37.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.4.37.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m39" class="ltx_Math" alttext="k\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\leftarrow 1</annotation></semantics></math> <span id="algorithm2.4.37.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm2.m40" class="ltx_Math" alttext="K-1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K-1</annotation></semantics></math></em> <span id="algorithm2.4.37.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.38" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.4.38.1" class="ltx_text"><span id="algorithm2.4.38.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.38.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Sample multiscale feature crops centred at current ground truth estimate. </span> 
</div>
<div id="algorithm2.4.39" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.39.1" class="ltx_text ltx_font_bold">25</span></span>
            <math id="algorithm2.m41" class="ltx_Math" alttext="f^{\Omega(\hat{P}_{n_{T},k,l})}\leftarrow\texttt{sample\_feats}(F_{n_{T}},\ \Omega(\texttt{cat}(\{\hat{P}_{n_{T},k,l},\texttt{frame\_inds}\},3)))" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">sample_feats</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><msub><mi>n</mi><mi>T</mi></msub></msub><mo>,</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><mtext class="ltx_mathvariant_monospace">frame_inds</mtext><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{\Omega(\hat{P}_{n_{T},k,l})}\leftarrow\texttt{sample\_feats}(F_{n_{T}},\ \Omega(\texttt{cat}(\{\hat{P}_{n_{T},k,l},\texttt{frame\_inds}\},3)))</annotation></semantics></math>

</div>
<div id="algorithm2.4.40" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.4.40.1" class="ltx_text"><span id="algorithm2.4.40.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.40.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Compute multiscale 4D correlation features. </span> 
</div>
<div id="algorithm2.4.41" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.41.1" class="ltx_text ltx_font_bold">26</span></span>
            <math id="algorithm2.m42" class="ltx_Math" alttext="\texttt{Corr}\leftarrow\texttt{cat}(\{\mathcal{M}_{\rho}((f_{s}^{\Omega(P^{q})})^{\top}(f_{s}^{\Omega(\hat{P}_{n_{T},k,l})}))\}_{s=1}^{S},3)\in\mathbb{R}^{T\times N_{P^{q}}\times(S\times D_{\mathcal{M}})}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">Corr</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mi>s</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mi>q</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mi>s</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>D</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{Corr}\leftarrow\texttt{cat}(\{\mathcal{M}_{\rho}((f_{s}^{\Omega(P^{q})})^{\top}(f_{s}^{\Omega(\hat{P}_{n_{T},k,l})}))\}_{s=1}^{S},3)\in\mathbb{R}^{T\times N_{P^{q}}\times(S\times D_{\mathcal{M}})}</annotation></semantics></math>

</div>
<div id="algorithm2.4.42" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.4.42.1" class="ltx_text"><span id="algorithm2.4.42.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.42.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Prepare input and conditioning and compute refinement delta. </span> 
</div>
<div id="algorithm2.4.43" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.43.1" class="ltx_text ltx_font_bold">27</span></span>
            <math id="algorithm2.m43" class="ltx_math_unparsed" alttext="\texttt{forward\_disp}\leftarrow\texttt{cat}(\{0,\ \hat{P}_{n_{T},k,l,2:T}-\hat{P}_{n_{T},k,l,1:(T-1)}\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">forward_disp</mtext><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">cat</mtext><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{forward\_disp}\leftarrow\texttt{cat}(\{0,\ \hat{P}_{n_{T},k,l,2:T}-\hat{P}_{n_{T},k,l,1:(T-1)}\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}</annotation></semantics></math>

</div>
<div id="algorithm2.4.44" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.44.1" class="ltx_text ltx_font_bold">28</span></span>
            <math id="algorithm2.m44" class="ltx_math_unparsed" alttext="\texttt{backward\_disp}\leftarrow\texttt{cat}(\{\hat{P}_{n_{T},k,l,1:(T-1)}-\hat{P}_{n_{T},k,l,2:T},\ 0\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">backward_disp</mtext><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">cat</mtext><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></mrow></msub><mo>,</mo><mn> 0</mn><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{backward\_disp}\leftarrow\texttt{cat}(\{\hat{P}_{n_{T},k,l,1:(T-1)}-\hat{P}_{n_{T},k,l,2:T},\ 0\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}</annotation></semantics></math>

</div>
<div id="algorithm2.4.45" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.45.1" class="ltx_text ltx_font_bold">29</span></span>
            <math id="algorithm2.m45" class="ltx_Math" alttext="\texttt{disp}\leftarrow\texttt{cat}(\{\texttt{forward\_disp},\ \texttt{backward\_disp}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 4}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">disp</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mtext class="ltx_mathvariant_monospace">forward_disp</mtext><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_monospace">backward_disp</mtext><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{disp}\leftarrow\texttt{cat}(\{\texttt{forward\_disp},\ \texttt{backward\_disp}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 4}</annotation></semantics></math>

</div>
<div id="algorithm2.4.46" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.46.1" class="ltx_text ltx_font_bold">30</span></span>
            <math id="algorithm2.m46" class="ltx_Math" alttext="\texttt{input}\leftarrow\texttt{cat}(\{\texttt{disp},\ \texttt{sigmoid}(\hat{V}_{n_{T},k,l}),\ \texttt{sigmoid}(\hat{C}_{n_{T},k,l}),\ l^{\prime},\ \texttt{prior\_flag},\ \texttt{frame\_inds}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 9}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">input</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="ltx_mathvariant_monospace">disp</mtext><mo rspace="0.667em">,</mo><mrow><mtext class="ltx_mathvariant_monospace">sigmoid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mtext class="ltx_mathvariant_monospace">sigmoid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><msup><mi>l</mi><mo>′</mo></msup><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_monospace">prior_flag</mtext><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_monospace">frame_inds</mtext></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>9</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{input}\leftarrow\texttt{cat}(\{\texttt{disp},\ \texttt{sigmoid}(\hat{V}_{n_{T},k,l}),\ \texttt{sigmoid}(\hat{C}_{n_{T},k,l}),\ l^{\prime},\ \texttt{prior\_flag},\ \texttt{frame\_inds}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 9}</annotation></semantics></math>

</div>
