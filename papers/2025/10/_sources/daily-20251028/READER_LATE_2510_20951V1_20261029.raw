            <math id="algorithm1.m36" class="ltx_Math" alttext="\texttt{prior\_flag}\leftarrow\mathbf{0}\in\mathbb{R}^{T\times N_{P^{q}}\times 1}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">prior_flag</mtext><mo stretchy="false">←</mo><mn>𝟎</mn><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{prior\_flag}\leftarrow\mathbf{0}\in\mathbb{R}^{T\times N_{P^{q}}\times 1}</annotation></semantics></math>

</div>
<div id="algorithm1.4.33" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.33.1" class="ltx_text ltx_font_bold">22</span></span>
            end if
</div>
<div id="algorithm1.4.34" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.34.1" class="ltx_text ltx_font_bold">23</span></span>
            <math id="algorithm1.m37" class="ltx_Math" alttext="l\sim\mathcal{U}\{1,L\}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l\sim\mathcal{U}\{1,L\}</annotation></semantics></math>  <span id="algorithm1.4.34.2" class="ltx_text"><span id="algorithm1.4.34.2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.34.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Sample an ODE timestep.</span> 
</div>
<div id="algorithm1.4.35" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.35.1" class="ltx_text ltx_font_bold">24</span></span>
            <math id="algorithm1.m38" class="ltx_math_unparsed" alttext="l^{\prime}\leftarrow\texttt{repeat}(l,\text{``}1\rightarrow T\ N_{P^{q}}\ 1\text{''})\in\mathbb{R}^{T\times N_{P^{q}}\times 1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">repeat</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mtext>“</mtext><mn>1</mn><mo stretchy="false">→</mo><mi>T</mi><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mn> 1</mn><mtext>”</mtext><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">l^{\prime}\leftarrow\texttt{repeat}(l,\text{``}1\rightarrow T\ N_{P^{q}}\ 1\text{''})\in\mathbb{R}^{T\times N_{P^{q}}\times 1}</annotation></semantics></math>

</div>
<div id="algorithm1.4.36" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.36.1" class="ltx_text ltx_font_bold">25</span></span>
            <math id="algorithm1.m39" class="ltx_Math" alttext="l^{\prime}\leftarrow(l^{\prime}-1)/(L-1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l^{\prime}\leftarrow(l^{\prime}-1)/(L-1)</annotation></semantics></math>  <span id="algorithm1.4.36.2" class="ltx_text"><span id="algorithm1.4.36.2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.36.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Normalize to [0, 1] range.</span> 
</div>
<div id="algorithm1.4.37" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.37.1" class="ltx_text"><span id="algorithm1.4.37.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.37.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Use ground truth and sample from prior to sample a noisy interpolant at timestep <math id="algorithm1.m40" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#34A853;" mathcolor="#34A853">l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. </span> 
</div>
<div id="algorithm1.4.38" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.38.1" class="ltx_text ltx_font_bold">26</span></span>
            <math id="algorithm1.m41" class="ltx_Math" alttext="\{\epsilon_{\text{coord}},\epsilon_{\text{vis}},\epsilon_{\text{conf}}\}\sim\{\mathcal{N}(0,I),\mathcal{N}(0,I),\mathcal{N}(0,I)\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>ϵ</mi><mtext>coord</mtext></msub><mo>,</mo><msub><mi>ϵ</mi><mtext>vis</mtext></msub><mo>,</mo><msub><mi>ϵ</mi><mtext>conf</mtext></msub><mo stretchy="false">}</mo></mrow><mo>∼</mo><mrow><mo stretchy="false">{</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\epsilon_{\text{coord}},\epsilon_{\text{vis}},\epsilon_{\text{conf}}\}\sim\{\mathcal{N}(0,I),\mathcal{N}(0,I),\mathcal{N}(0,I)\}</annotation></semantics></math>

</div>
<div id="algorithm1.4.39" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.39.1" class="ltx_text ltx_font_bold">27</span></span>
            <math id="algorithm1.m42" class="ltx_Math" alttext="\tilde{P}_{n_{T},l}\leftarrow l^{\prime}*P_{n_{T}}+(1-l^{\prime})*\tilde{P}_{n_{T},1}+l^{\prime}*\sigma_{\text{coord}}\epsilon_{\text{coord}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∗</mo><msub><mi>P</mi><msub><mi>n</mi><mi>T</mi></msub></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∗</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∗</mo><msub><mi>σ</mi><mtext>coord</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mtext>coord</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{P}_{n_{T},l}\leftarrow l^{\prime}*P_{n_{T}}+(1-l^{\prime})*\tilde{P}_{n_{T},1}+l^{\prime}*\sigma_{\text{coord}}\epsilon_{\text{coord}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.40" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.40.1" class="ltx_text ltx_font_bold">28</span></span>
            <math id="algorithm1.m43" class="ltx_Math" alttext="\tilde{V}_{n_{T},l}\leftarrow l^{\prime}*V_{n_{T}}+(1-l^{\prime})*\tilde{V}_{n_{T},1}+l^{\prime}*\sigma_{\text{vis}}\epsilon_{\text{vis}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∗</mo><msub><mi>V</mi><msub><mi>n</mi><mi>T</mi></msub></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∗</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∗</mo><msub><mi>σ</mi><mtext>vis</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mtext>vis</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{V}_{n_{T},l}\leftarrow l^{\prime}*V_{n_{T}}+(1-l^{\prime})*\tilde{V}_{n_{T},1}+l^{\prime}*\sigma_{\text{vis}}\epsilon_{\text{vis}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.41" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.41.1" class="ltx_text ltx_font_bold">29</span></span>
            <math id="algorithm1.m44" class="ltx_Math" alttext="C_{n_{T},1,l}\leftarrow 1-\texttt{min}((\texttt{stopgrad}(\tilde{P}_{n_{T},l})-P_{n_{T}})^{2},16^{2})/16^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mtext class="ltx_mathvariant_monospace">min</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mtext class="ltx_mathvariant_monospace">stopgrad</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>P</mi><msub><mi>n</mi><mi>T</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>,</mo><msup><mn>16</mn><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mn>16</mn><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{n_{T},1,l}\leftarrow 1-\texttt{min}((\texttt{stopgrad}(\tilde{P}_{n_{T},l})-P_{n_{T}})^{2},16^{2})/16^{2}</annotation></semantics></math>  <span id="algorithm1.4.41.2" class="ltx_text"><span id="algorithm1.4.41.2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.41.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Ground truth confidence.</span> 
</div>
<div id="algorithm1.4.42" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.42.1" class="ltx_text ltx_font_bold">30</span></span>
            <math id="algorithm1.m45" class="ltx_Math" alttext="\tilde{C}_{n_{T},l}\leftarrow l^{\prime}*C_{n_{T},1,l}+(1-l^{\prime})*\tilde{C}_{n_{T},1}+l^{\prime}*\sigma_{\text{conf}}\epsilon_{\text{conf}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∗</mo><msub><mi>C</mi><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∗</mo><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><msup><mi>l</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∗</mo><msub><mi>σ</mi><mtext>conf</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mtext>conf</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{C}_{n_{T},l}\leftarrow l^{\prime}*C_{n_{T},1,l}+(1-l^{\prime})*\tilde{C}_{n_{T},1}+l^{\prime}*\sigma_{\text{conf}}\epsilon_{\text{conf}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.43" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.43.1" class="ltx_text"><span id="algorithm1.4.43.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.43.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Set initial ground truth estimate to sample at timestep <math id="algorithm1.m46" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#34A853;" mathcolor="#34A853">l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. </span> 
</div>
<div id="algorithm1.4.44" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.44.1" class="ltx_text ltx_font_bold">31</span></span>
            <math id="algorithm1.m47" class="ltx_Math" alttext="\{\hat{P}_{n_{T},1,l},\hat{V}_{n_{T},1,l},\hat{C}_{n_{T},1,l}\}\leftarrow\{\tilde{P}_{n_{T},l},\ \tilde{V}_{n_{T},l},\ \tilde{C}_{n_{T},l}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\hat{P}_{n_{T},1,l},\hat{V}_{n_{T},1,l},\hat{C}_{n_{T},1,l}\}\leftarrow\{\tilde{P}_{n_{T},l},\ \tilde{V}_{n_{T},l},\ \tilde{C}_{n_{T},l}\}</annotation></semantics></math>

</div>
<div id="algorithm1.4.45" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.45.1" class="ltx_text"><span id="algorithm1.4.45.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.45.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Iterate over refinement steps. </span> 
</div>
<div id="algorithm1.4.46" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.46.1" class="ltx_text ltx_font_bold">32</span></span>
            <span id="algorithm1.4.46.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.46.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m48" class="ltx_Math" alttext="k\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.46.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m49" class="ltx_Math" alttext="K-1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K-1</annotation></semantics></math></em> <span id="algorithm1.4.46.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.47" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.47.1" class="ltx_text"><span id="algorithm1.4.47.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.47.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Sample multiscale feature crops centred at current ground truth estimate. </span> 
</div>
<div id="algorithm1.4.48" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.48.1" class="ltx_text ltx_font_bold">33</span></span>
            <math id="algorithm1.m50" class="ltx_Math" alttext="f^{\Omega(\hat{P}_{n_{T},k,l})}\leftarrow\texttt{sample\_feats}(\{F_{n_{T}}^{s}\}_{s=1}^{S},\ \Omega(\texttt{cat}(\{\hat{P}_{n_{T},k,l},\texttt{frame\_inds}\},3)))" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">sample_feats</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>F</mi><msub><mi>n</mi><mi>T</mi></msub><mi>s</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mo>,</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><mtext class="ltx_mathvariant_monospace">frame_inds</mtext><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{\Omega(\hat{P}_{n_{T},k,l})}\leftarrow\texttt{sample\_feats}(\{F_{n_{T}}^{s}\}_{s=1}^{S},\ \Omega(\texttt{cat}(\{\hat{P}_{n_{T},k,l},\texttt{frame\_inds}\},3)))</annotation></semantics></math>

</div>
<div id="algorithm1.4.49" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.49.1" class="ltx_text"><span id="algorithm1.4.49.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.49.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Compute multiscale 4D correlation features. </span> 
</div>
<div id="algorithm1.4.50" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.50.1" class="ltx_text ltx_font_bold">34</span></span>
            <math id="algorithm1.m51" class="ltx_Math" alttext="\texttt{Corr}\leftarrow\texttt{cat}(\{\mathcal{M}_{\rho}((f_{s}^{\Omega(P^{q})})^{\top}(f_{s}^{\Omega(\hat{P}_{n_{T},k,l})}))\}_{s=1}^{S},3)\in\mathbb{R}^{T\times N_{P^{q}}\times(S\times D_{\mathcal{M}})}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">Corr</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mi>s</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mi>q</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mi>s</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>D</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{Corr}\leftarrow\texttt{cat}(\{\mathcal{M}_{\rho}((f_{s}^{\Omega(P^{q})})^{\top}(f_{s}^{\Omega(\hat{P}_{n_{T},k,l})}))\}_{s=1}^{S},3)\in\mathbb{R}^{T\times N_{P^{q}}\times(S\times D_{\mathcal{M}})}</annotation></semantics></math>

</div>
<div id="algorithm1.4.51" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.51.1" class="ltx_text"><span id="algorithm1.4.51.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.51.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Prepare input and conditioning and compute refinement delta. </span> 
</div>
<div id="algorithm1.4.52" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.52.1" class="ltx_text ltx_font_bold">35</span></span>
            <math id="algorithm1.m52" class="ltx_math_unparsed" alttext="\texttt{forward\_disp}\leftarrow\texttt{cat}(\{0,\ \hat{P}_{n_{T},k,l,2:T}-\hat{P}_{n_{T},k,l,1:(T-1)}\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">forward_disp</mtext><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">cat</mtext><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{forward\_disp}\leftarrow\texttt{cat}(\{0,\ \hat{P}_{n_{T},k,l,2:T}-\hat{P}_{n_{T},k,l,1:(T-1)}\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}</annotation></semantics></math>

</div>
<div id="algorithm1.4.53" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.53.1" class="ltx_text ltx_font_bold">36</span></span>
            <math id="algorithm1.m53" class="ltx_math_unparsed" alttext="\texttt{backward\_disp}\leftarrow\texttt{cat}(\{\hat{P}_{n_{T},k,l,1:(T-1)}-\hat{P}_{n_{T},k,l,2:T},\ 0\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">backward_disp</mtext><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">cat</mtext><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></mrow></msub><mo>,</mo><mn> 0</mn><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{backward\_disp}\leftarrow\texttt{cat}(\{\hat{P}_{n_{T},k,l,1:(T-1)}-\hat{P}_{n_{T},k,l,2:T},\ 0\},1)\in\mathbb{R}^{T\times N_{P^{q}}\times 2}</annotation></semantics></math>

</div>
<div id="algorithm1.4.54" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.54.1" class="ltx_text ltx_font_bold">37</span></span>
            <math id="algorithm1.m54" class="ltx_Math" alttext="\texttt{disp}\leftarrow\texttt{cat}(\{\texttt{forward\_disp},\ \texttt{backward\_disp}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 4}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">disp</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mtext class="ltx_mathvariant_monospace">forward_disp</mtext><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_monospace">backward_disp</mtext><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{disp}\leftarrow\texttt{cat}(\{\texttt{forward\_disp},\ \texttt{backward\_disp}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 4}</annotation></semantics></math>

</div>
<div id="algorithm1.4.55" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.55.1" class="ltx_text ltx_font_bold">38</span></span>
            <math id="algorithm1.m55" class="ltx_Math" alttext="\texttt{input}\leftarrow\texttt{cat}(\{\texttt{disp},\ \texttt{sigmoid}(\hat{V}_{n_{T},k,l}),\ \texttt{sigmoid}(\hat{C}_{n_{T},k,l}),\ l^{\prime},\ \texttt{prior\_flag},\ \texttt{frame\_inds}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 9}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">input</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">cat</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="ltx_mathvariant_monospace">disp</mtext><mo rspace="0.667em">,</mo><mrow><mtext class="ltx_mathvariant_monospace">sigmoid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mtext class="ltx_mathvariant_monospace">sigmoid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><msup><mi>l</mi><mo>′</mo></msup><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_monospace">prior_flag</mtext><mo rspace="0.667em">,</mo><mtext class="ltx_mathvariant_monospace">frame_inds</mtext></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>9</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\texttt{input}\leftarrow\texttt{cat}(\{\texttt{disp},\ \texttt{sigmoid}(\hat{V}_{n_{T},k,l}),\ \texttt{sigmoid}(\hat{C}_{n_{T},k,l}),\ l^{\prime},\ \texttt{prior\_flag},\ \texttt{frame\_inds}\},3)\in\mathbb{R}^{T\times N_{P^{q}}\times 9}</annotation></semantics></math>

</div>
<div id="algorithm1.4.56" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.56.1" class="ltx_text ltx_font_bold">39</span></span>
            <math id="algorithm1.m56" class="ltx_Math" alttext="\texttt{conditioning}\leftarrow\texttt{Corr}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">conditioning</mtext><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">Corr</mtext></mrow><annotation encoding="application/x-tex">\texttt{conditioning}\leftarrow\texttt{Corr}</annotation></semantics></math>

</div>
<div id="algorithm1.4.57" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.57.1" class="ltx_text ltx_font_bold">40</span></span>
            <math id="algorithm1.m57" class="ltx_Math" alttext="\{\Delta\hat{P}_{n_{T},k,l},\Delta\hat{V}_{n_{T},k,l},\Delta\hat{C}_{n_{T},k,l}\}\leftarrow\mathcal{T}_{\theta}(\texttt{input},\ \texttt{conditioning})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_monospace">input</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">conditioning</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\Delta\hat{P}_{n_{T},k,l},\Delta\hat{V}_{n_{T},k,l},\Delta\hat{C}_{n_{T},k,l}\}\leftarrow\mathcal{T}_{\theta}(\texttt{input},\ \texttt{conditioning})</annotation></semantics></math>

</div>
<div id="algorithm1.4.58" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.58.1" class="ltx_text"><span id="algorithm1.4.58.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.58.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Refine ground truth estimate. </span> 
</div>
<div id="algorithm1.4.59" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.59.1" class="ltx_text ltx_font_bold">41</span></span>
            <math id="algorithm1.m58" class="ltx_Math" alttext="\{\hat{P}_{n_{T},(k+1),l},\hat{V}_{n_{T},(k+1),l},\hat{C}_{n_{T},(k+1),l}\}\leftarrow\{\hat{P}_{n_{T},k,l}+\Delta\hat{P}_{n_{T},k,l},\hat{V}_{n_{T},k,l}+\Delta\hat{V}_{n_{T},k,l},\hat{C}_{n_{T},k,l}+\Delta\hat{C}_{n_{T},k,l}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\hat{P}_{n_{T},(k+1),l},\hat{V}_{n_{T},(k+1),l},\hat{C}_{n_{T},(k+1),l}\}\leftarrow\{\hat{P}_{n_{T},k,l}+\Delta\hat{P}_{n_{T},k,l},\hat{V}_{n_{T},k,l}+\Delta\hat{V}_{n_{T},k,l},\hat{C}_{n_{T},k,l}+\Delta\hat{C}_{n_{T},k,l}\}</annotation></semantics></math>

</div>
<div id="algorithm1.4.60" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.60.1" class="ltx_text"><span id="algorithm1.4.60.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.60.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Compute losses. </span> 
</div>
<div id="algorithm1.4.61" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.61.1" class="ltx_text ltx_font_bold">42</span></span>
            <math id="algorithm1.m59" class="ltx_Math" alttext="\mathcal{L}_{\text{coord}}\leftarrow\frac{0.05}{N_{T}K}|P_{n_{T}}-\hat{P}_{n_{T},(k+1),l}|" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>coord</mtext></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>0.05</mn><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>P</mi><msub><mi>n</mi><mi>T</mi></msub></msub><mo>−</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{coord}}\leftarrow\frac{0.05}{N_{T}K}|P_{n_{T}}-\hat{P}_{n_{T},(k+1),l}|</annotation></semantics></math>

</div>
<div id="algorithm1.4.62" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.62.1" class="ltx_text ltx_font_bold">43</span></span>
            <math id="algorithm1.m60" class="ltx_Math" alttext="\mathcal{L}_{\text{vis}}\leftarrow\frac{1}{N_{T}K}\texttt{BCE}(V_{n_{T}},\texttt{sigmoid}(\hat{V}_{n_{T},(k+1),l}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>vis</mtext></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">BCE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><msub><mi>n</mi><mi>T</mi></msub></msub><mo>,</mo><mrow><mtext class="ltx_mathvariant_monospace">sigmoid</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{vis}}\leftarrow\frac{1}{N_{T}K}\texttt{BCE}(V_{n_{T}},\texttt{sigmoid}(\hat{V}_{n_{T},(k+1),l}))</annotation></semantics></math>

</div>
<div id="algorithm1.4.63" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.63.1" class="ltx_text ltx_font_bold">44</span></span>
            <math id="algorithm1.m61" class="ltx_Math" alttext="C_{n_{T},(k+1),l}\leftarrow 1-\texttt{min}((\texttt{stopgrad}(\hat{P}_{n_{T},(k+1),l})-P_{n_{T}})^{2},16^{2})/16^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mtext class="ltx_mathvariant_monospace">min</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mtext class="ltx_mathvariant_monospace">stopgrad</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>P</mi><msub><mi>n</mi><mi>T</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>,</mo><msup><mn>16</mn><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msup><mn>16</mn><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{n_{T},(k+1),l}\leftarrow 1-\texttt{min}((\texttt{stopgrad}(\hat{P}_{n_{T},(k+1),l})-P_{n_{T}})^{2},16^{2})/16^{2}</annotation></semantics></math>  <span id="algorithm1.4.63.2" class="ltx_text"><span id="algorithm1.4.63.2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm1.4.63.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Ground truth confidence.</span> 
</div>
<div id="algorithm1.4.64" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.64.1" class="ltx_text ltx_font_bold">45</span></span>
            <math id="algorithm1.m62" class="ltx_Math" alttext="\mathcal{L}_{\text{conf}}\leftarrow\frac{1}{N_{T}K}|C_{n_{T},(k+1),l}-\hat{C}_{n_{T},(k+1),l}|" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>conf</mtext></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>N</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>C</mi><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>l</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{conf}}\leftarrow\frac{1}{N_{T}K}|C_{n_{T},(k+1),l}-\hat{C}_{n_{T},(k+1),l}|</annotation></semantics></math>

</div>
<div id="algorithm1.4.65" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.65.1" class="ltx_text ltx_font_bold">46</span></span>
            <math id="algorithm1.m63" class="ltx_Math" alttext="\mathcal{L}\leftarrow\mathcal{L}+\mathcal{L}_{\text{coord}}+\mathcal{L}_{\text{vis}}+\mathcal{L}_{\text{conf}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>coord</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>vis</mtext></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>conf</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}\leftarrow\mathcal{L}+\mathcal{L}_{\text{coord}}+\mathcal{L}_{\text{vis}}+\mathcal{L}_{\text{conf}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.66" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.66.1" class="ltx_text ltx_font_bold">47</span></span>
            end for
</div>
<div id="algorithm1.4.67" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.67.1" class="ltx_text ltx_font_bold">48</span></span>
            end for
</div>
<div id="algorithm1.4.68" class="ltx_listingline">
</div>
</div>
</figure>
