<div id="algorithm2.4.53" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.53.1" class="ltx_text ltx_font_bold">35</span></span>
            <math id="algorithm2.m50" class="ltx_Math" alttext="\{\tilde{P}^{\text{flow}},\tilde{V}^{\text{flow}},\tilde{C}^{\text{flow}}\}\leftarrow\{\hat{P}_{n_{T},K,l}-\tilde{P}_{n_{T},1},\ \hat{V}_{n_{T},K,l}-\tilde{V}_{n_{T},1},\ \hat{C}_{n_{T},K,l}-\tilde{C}_{n_{T},1}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msup><mover accent="true"><mi>P</mi><mo>~</mo></mover><mtext>flow</mtext></msup><mo>,</mo><msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mtext>flow</mtext></msup><mo>,</mo><msup><mover accent="true"><mi>C</mi><mo>~</mo></mover><mtext>flow</mtext></msup><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>K</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>P</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>K</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mi>K</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><msub><mi>n</mi><mi>T</mi></msub><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\tilde{P}^{\text{flow}},\tilde{V}^{\text{flow}},\tilde{C}^{\text{flow}}\}\leftarrow\{\hat{P}_{n_{T},K,l}-\tilde{P}_{n_{T},1},\ \hat{V}_{n_{T},K,l}-\tilde{V}_{n_{T},1},\ \hat{C}_{n_{T},K,l}-\tilde{C}_{n_{T},1}\}</annotation></semantics></math>

</div>
<div id="algorithm2.4.54" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm2.4.54.1" class="ltx_text"><span id="algorithm2.4.54.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">// </span> </span><span id="algorithm2.4.54.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#34A853;">Integrate to next sample using vector field estimate. </span> 
