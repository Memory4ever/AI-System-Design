<div id="algorithm2.4.55" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.55.1" class="ltx_text ltx_font_bold">36</span></span>
            <math id="algorithm2.m51" class="ltx_math_unparsed" alttext="l^{\prime\prime}\leftarrow\texttt{repeat}(l+1,\text{``}1\rightarrow T\ N_{P^{q}}\ 1\text{''})\in\mathbb{R}^{T\times N_{P^{q}}\times 1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mo>′′</mo></msup><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">repeat</mtext><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>+</mo><mn>1</mn><mo>,</mo><mtext>“</mtext><mn>1</mn><mo stretchy="false">→</mo><mi>T</mi><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mn> 1</mn><mtext>”</mtext><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>N</mi><msup><mi>P</mi><mi>q</mi></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">l^{\prime\prime}\leftarrow\texttt{repeat}(l+1,\text{``}1\rightarrow T\ N_{P^{q}}\ 1\text{''})\in\mathbb{R}^{T\times N_{P^{q}}\times 1}</annotation></semantics></math>

</div>
<div id="algorithm2.4.56" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.56.1" class="ltx_text ltx_font_bold">37</span></span>
            <math id="algorithm2.m52" class="ltx_Math" alttext="l^{\prime\prime}\leftarrow(l^{\prime\prime}-1)/(L-1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>l</mi><mo>′′</mo></msup><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>l</mi><mo>′′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l^{\prime\prime}\leftarrow(l^{\prime\prime}-1)/(L-1)</annotation></semantics></math>

</div>
<div id="algorithm2.4.57" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.57.1" class="ltx_text ltx_font_bold">38</span></span>
            <math id="algorithm2.m53" class="ltx_Math" alttext="\Delta l^{\prime}\leftarrow l^{\prime\prime}-l^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mo stretchy="false">←</mo><mrow><msup><mi>l</mi><mo>′′</mo></msup><mo>−</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\Delta l^{\prime}\leftarrow l^{\prime\prime}-l^{\prime}</annotation></semantics></math>

</div>
