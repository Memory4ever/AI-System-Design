-1 0 11.26)" width="23.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m7" class="ltx_Math" alttext="10^{-2}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">10^{-2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -16.16 -81.51)"><foreignObject style="--ltx-fo-width:1.72em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="23.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m8" class="ltx_Math" alttext="10^{-1}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">10^{-1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -12.43 -5.63)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.81em;--ltx-fo-depth:0em;font-size:10pt;" height="11.26" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="20.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m9" class="ltx_Math" alttext="10^{0}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mn>0</mn></msup><annotation encoding="application/x-tex">10^{0}</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp24"><path d="M 12.5 -174.6 L 282.32 -174.6 L 282.32 49.56 L 12.5 49.56 Z"></path></clipPath><g clip-path="url(#pgfcp24)"><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFF