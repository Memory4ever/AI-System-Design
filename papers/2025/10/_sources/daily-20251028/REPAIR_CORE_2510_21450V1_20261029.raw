</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 56.72 0) translate(20.48,0) matrix(1.0 0.0 0.0 1.0 -17.72 0)"><foreignObject style="--ltx-fo-width:3.76em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
