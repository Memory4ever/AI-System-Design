</span></span>
</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 46.51)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(26.39,0) matrix(1.0 0.0 0.0 1.0 -23.62 0)"><foreignObject style="--ltx-fo-width:5.01em;--ltx-fo-height:0.34em;--ltx-fo-depth:0em;font-size:10pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="69.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S1.F1.pic1.21" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:5.01em;">
