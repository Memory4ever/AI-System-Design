</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 46.51)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(16.55,0) matrix(1.0 0.0 0.0 1.0 -13.78 0)"><foreignObject style="--ltx-fo-width:2.92em;--ltx-fo-height:0.32em;--ltx-fo-depth:0em;font-size:10pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="40.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
