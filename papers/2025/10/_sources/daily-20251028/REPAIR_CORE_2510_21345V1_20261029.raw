o>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\frac{\Sigma_{\beta}}{1+\delta_{Q}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-\frac{\gamma}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]+\frac{\gamma}{n(1+\delta_{Q})^{2}}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex228"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex228.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\frac{\Sigma_{\beta}}{1+\delta_{Q}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-\frac{\gamma}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]{\bm{\mu}}_{\beta}+\frac{\gamma}{n(1+\delta_{Q})^{2}}\Tr(\Sigma_{\beta}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}])\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\frac{\Sigma_{\beta}}{1+\delta_{Q}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-\frac{\gamma}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]{\bm{\mu}}_{\beta}+\frac{\gamma}{n(1+\delta_{Q})^{2}}\Tr(\Sigma_{\beta}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}])\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px3.p1.2" class="ltx_p">And:</p>
<table id="A3.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex229.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}\tilde{\bm{w}}]=\tilde{\bm{w}}^{\top}\E[({\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p}){\mathbf{Q}}\Sigma_{\beta}]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐐</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>p</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}\tilde{\bm{w}}]=\tilde{\bm{w}}^{\top}\E[({\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p}){\mathbf{Q}}\Sigma_{\beta}]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex230.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\E[({\mathbf{I}}_{p}-\gamma{\mathbf{Q}})\Sigma_{\beta}]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐈</mi><mi>p</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\E[({\mathbf{I}}_{p}-\gamma{\mathbf{Q}})\Sigma_{\beta}]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex231.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}-\gamma\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}-\gamma\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Grouping all the terms:</h4>

<div id="A3.SS2.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px4.p1.1" class="ltx_p">Thus, we now that we have the expression of all the term, we will group them in the following way:</p>
<table id="A3.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex232.m1" class="ltx_Math" alttext="\displaystyle\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS0.Px5" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Terms without <math id="A3.SS2.SSS0.Px5.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>:</h4>

<div id="A3.SS2.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<table id="A3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E29.m1" class="ltx_Math" alttext="T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}-2(1-h)\right)+\frac{1-h}{h}" display="block" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}-2(1-h)\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS0.Px6" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Terms in <math id="A3.SS2.SSS0.Px6.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>:</h4>

<div id="A3.SS2.SSS0.Px6.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px6.p1.1" class="ltx_p">There are two : <math id="A3.SS2.SSS0.Px6.p1.m1" class="ltx_Math" alttext="2\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px6.p1.m2" class="ltx_Math" alttext="\frac{2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>2</mn><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}]</annotation></semantics></math>:</p>
<table id="A3.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex233"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex233.m1" class="ltx_Math" alttext="\displaystyle T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle T_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex233.m2" class="ltx_Math" alttext="\displaystyle=2\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]-\frac{2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]-\frac{2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex234"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex234.m1" class="ltx_Math" alttext="\displaystyle=\frac{2\gamma}{h(1+\delta_{Q})}\left(\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-(1-h)(1+\delta_{Q})\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2\gamma}{h(1+\delta_{Q})}\left(\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-(1-h)(1+\delta_{Q})\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex235"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex235.m1" class="ltx_Math" alttext="\displaystyle=\frac{2\gamma}{h(1+\delta_{Q})}\left(\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}^{2}{\bm{\mu}}_{\beta}-(1-h)(1+\delta_{Q})\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>+</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2\gamma}{h(1+\delta_{Q})}\left(\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}^{2}{\bm{\mu}}_{\beta}-(1-h)(1+\delta_{Q})\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px6.p1.2" class="ltx_p">And we have that:</p>
<table id="A3.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex236.m1" class="ltx_Math" alttext="\displaystyle\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}=\frac{(1+\delta_{Q})^{2}\|{\bm{\mu}}_{\beta}\|^{2}\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}},\quad\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}^{2}{\bm{\mu}}_{\beta}=\frac{(1+\delta_{Q})^{2}\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}=\frac{(1+\delta_{Q})^{2}\|{\bm{\mu}}_{\beta}\|^{2}\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}},\quad\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}^{2}{\bm{\mu}}_{\beta}=\frac{(1+\delta_{Q})^{2}\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px6.p1.3" class="ltx_p">Thus:</p>
<table id="A3.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex237.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}}{h(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}-(1-h)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}}{h(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}-(1-h)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS0.Px7" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Terms in <math id="A3.SS2.SSS0.Px7.m1" class="ltx_Math" alttext="\alpha^{2}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\alpha^{2}</annotation></semantics></math>:</h4>

<div id="A3.SS2.SSS0.Px7.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px7.p1.1" class="ltx_p">we have three terms: <math id="A3.SS2.SSS0.Px7.p1.m1" class="ltx_Math" alttext="\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]</annotation></semantics></math>, <math id="A3.SS2.SSS0.Px7.p1.m2" class="ltx_Math" alttext="\frac{1}{n^{2}}\E[(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}]" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{n^{2}}\E[(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}]</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px7.p1.m3" class="ltx_Math" alttext="\frac{-2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo>−</mo><mn>2</mn></mrow><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{-2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]</annotation></semantics></math>:</p>
</div>
<div id="A3.SS2.SSS0.Px7.p2" class="ltx_para ltx_noindent">
<table id="A3.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex238.m1" class="ltx_Math" alttext="\displaystyle T_{3}=\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]+\frac{1}{n^{2}}\E[(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}]-\frac{2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]+\frac{1}{n^{2}}\E[(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}]-\frac{2}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex239.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}+\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}-2\gamma\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}\tilde{\bm{w}}+\gamma^{2}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]\tilde{\bm{w}}-2\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}+2\gamma\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}+\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}-2\gamma\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}\tilde{\bm{w}}+\gamma^{2}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]\tilde{\bm{w}}-2\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}+2\gamma\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
