<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex174.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{h}\Tr(\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>h</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐑</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{h}\Tr(\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.4" class="ltx_p">Thus:</p>
<table id="A2.Ex175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex175.m1" class="ltx_Math" alttext="T_{3}=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[\Tr(\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})+\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐑</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mover accent="true"><mi>h</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{3}=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[\Tr(\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})+\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.5" class="ltx_p">Now remains to compute <math id="A2.SS2.SSS0.Px6.p1.m4" class="ltx_Math" alttext="\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐑</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]</annotation></semantics></math>. For that, we use lemma <a href="#A1.Thmtheorem7" title="Lemma A.7 (Deterministic equivalent). ‣ A.2 Deterministic equivalents ‣ Appendix A Useful results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.7</span></a>:</p>
<table id="A2.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex176.m1" class="ltx_Math" alttext="\displaystyle\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐑</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex176.m2" class="ltx_Math" alttext="\displaystyle=\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}}+\frac{1}{N}\frac{\Tr(\Sigma\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}})}{(1+\delta_{R})^{2}}\E[{\mathbf{R}}\Sigma{\mathbf{R}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐑</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}}+\frac{1}{N}\frac{\Tr(\Sigma\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}})}{(1+\delta_{R})^{2}}\E[{\mathbf{R}}\Sigma{\mathbf{R}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex177.m1" class="ltx_Math" alttext="\displaystyle=\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}}+\frac{1}{N}\frac{{\bm{\mu}}^{\top}\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}{\bm{\mu}}}{(1+\delta_{R})^{2}}\frac{1}{\tilde{h}}\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mover accent="true"><mi>h</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}}+\frac{1}{N}\frac{{\bm{\mu}}^{\top}\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}{\bm{\mu}}}{(1+\delta_{R})^{2}}\frac{1}{\tilde{h}}\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.6" class="ltx_p">And since we are in the regime of <math id="A2.SS2.SSS0.Px6.p1.m5" class="ltx_Math" alttext="N\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">N\to\infty</annotation></semantics></math>, then:</p>
<table id="A2.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex178.m1" class="ltx_Math" alttext="\frac{1}{N}{\bm{\mu}}^{\top}\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}{\bm{\mu}}={\mathcal{O}}(N^{-1})" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{N}{\bm{\mu}}^{\top}\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}{\bm{\mu}}={\mathcal{O}}(N^{-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.7" class="ltx_p">Thus:</p>
<table id="A2.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E20.m1" class="ltx_Math" alttext="\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]=\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐑</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\E[{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}{\mathbf{R}}]=\bar{\mathbf{R}}{\bm{\mu}}{\bm{\mu}}^{\top}\bar{\mathbf{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.8" class="ltx_p">Hence, <math id="A2.SS2.SSS0.Px6.p1.m6" class="ltx_Math" alttext="T_{3}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>3</mn></msub><annotation encoding="application/x-tex">T_{3}</annotation></semantics></math> becomes:</p>
<table id="A2.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex179.m1" class="ltx_Math" alttext="\displaystyle T_{3}=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}\bar{\mathbf{R}}{\bm{\mu}}+\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mover accent="true"><mi>h</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}\bar{\mathbf{R}}{\bm{\mu}}+\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.9" class="ltx_p">And we also have that:</p>
<table id="A2.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex180.m1" class="ltx_Math" alttext="\displaystyle{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}\bar{\mathbf{R}}{\bm{\mu}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}\bar{\mathbf{R}}{\bm{\mu}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex180.m2" class="ltx_Math" alttext="\displaystyle={\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}\bar{\mathbf{R}}{\bm{\mu}}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow><mo>+</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}\bar{\mathbf{R}}{\bm{\mu}}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex181"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex181.m1" class="ltx_Math" alttext="\displaystyle=\left({\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)^{2}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left({\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)^{2}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.10" class="ltx_p">And:</p>
<table id="A2.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex182.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{N}\Tr(\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{N}\Tr(\bar{\mathbf{R}}\Sigma\bar{\mathbf{R}}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex182.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{N}\Tr(\bar{\mathbf{R}}^{2}\bar{\mathbf{Q}}^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{N}\Tr(\bar{\mathbf{R}}^{2}\bar{\mathbf{Q}}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p1.11" class="ltx_p">Therefore:</p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="T_{3}=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[\left({\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)^{2}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}+\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}^{2}\bar{\mathbf{Q}}^{2})\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mfrac><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mover accent="true"><mi>h</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{3}=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[\left({\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)^{2}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}+\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}^{2}\bar{\mathbf{Q}}^{2})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.SSS0.Px6.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px6.p2.1" class="ltx_p">Then using lemmas <a href="#A1.Thmtheorem4" title="Lemma A.4 (Trace identities). ‣ A.2 Deterministic equivalents ‣ Appendix A Useful results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a> and <a href="#A1.Thmtheorem5" title="Lemma A.5 (Relevant Identities). ‣ A.2 Deterministic equivalents ‣ Appendix A Useful results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>:</p>
<table id="A2.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex183"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex183.m1" class="ltx_Math" alttext="\displaystyle T_{3}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\displaystyle T_{3}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex183.m2" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[\left({\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)^{2}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}\right]+\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}^{2}\bar{\mathbf{Q}}^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝝁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝝁</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mover accent="true"><mi>h</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐑</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left[\left({\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)^{2}+{\bm{\mu}}^{\top}\bar{\mathbf{R}}\bar{\mathbf{Q}}^{2}\bar{\mathbf{R}}{\bm{\mu}}\right]+\frac{\gamma^{2}}{h(1+\delta_{R})^{2}}\left(1-\frac{2}{(1+\delta_{R})}{\bm{\mu}}^{\top}\bar{\mathbf{R}}{\bm{\mu}}\right)\frac{1}{\tilde{h}}\frac{1}{N}\Tr(\bar{\mathbf{R}}^{2}\bar{\mathbf{Q}}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex184.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}\right)\right)+" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>R</mi><mn>2</mn></msubsup></mfrac></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mo>)</mo></mrow><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}\right)\right)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex185.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\tilde{\eta}}{(1+\gamma(1+\delta_{Q}))^{2}(1+\tilde{\gamma}(1+\delta_{R}))^{2}}\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>η</mi><mo>~</mo></mover><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mover accent="true"><mi>γ</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>R</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>R</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\tilde{\eta}}{(1+\gamma(1+\delta_{Q}))^{2}(1+\tilde{\gamma}(1+\delta_{R}))^{2}}\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex186.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}+(1-\tilde{h})\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)\right)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>R</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>R</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}+(1-\tilde{h})\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)\right)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p2.2" class="ltx_p">Finally:</p>
<table id="A2.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E22.m1" class="ltx_Math" alttext="\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="A2.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E23.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{2\gamma\beta(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}{\lambda_{R}\lambda_{Q}}\left(1-\frac{\gamma(1+\delta_{Q})}{h\lambda_{Q}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>λ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{2\gamma\beta(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}{\lambda_{R}\lambda_{Q}}\left(1-\frac{\gamma(1+\delta_{Q})}{h\lambda_{Q}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A2.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24.m1" class="ltx_Math" alttext="\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}+(1-\tilde{h})\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)\right)\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>R</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>R</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}+(1-\tilde{h})\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)\right)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p2.3" class="ltx_p">And the expression of the second order expectation reads:</p>
<table id="A2.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E25.m1" class="ltx_Math" alttext="\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px6.p2.4" class="ltx_p">And finally, Theorem <a href="#S4.Thmtheorem2" title="Theorem 4.2 (Gaussianity of the fine-tuned Ridge model). ‣ 4 Main results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> follows:</p>
</div>
<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem B.1</span></span><span id="A2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Gaussianity of the fine-tuned Ridge model)<span id="A2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p"><span id="A2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="{\bm{w}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}</annotation></semantics></math> be the fine-tuned classifier as defined in equation <a href="#S3.Ex3" title="In Fine-tuning phase. ‣ 3.1 Theoretical Setting ‣ 3 Problem setting and Background ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">
                  
                    α
                  
                -FTC</span></a> and suppose that Assumption <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Growth Rates). ‣ 4 Main results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> holds. The decision function <math id="A2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="{\bm{w}}_{\alpha}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}^{\top}{\bm{x}}</annotation></semantics></math>, on some test sample <math id="A2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="{\bm{x}}\in{\mathcal{C}}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{x}}\in{\mathcal{C}}_{a}</annotation></semantics></math> independent of <math id="A2.Thmtheorem1.p1.m4" class="ltx_Math" alttext="{\mathbf{X}}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">{\mathbf{X}}</annotation></semantics></math>, satisfies:</span></p>
<table id="A2.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex187.m1" class="ltx_Math" alttext="\displaystyle{\bm{w}}_{\alpha}^{\top}{\bm{x}}\,\,\toind\,\,{\mathcal{N}}\left((-1)^{a}m_{\alpha},\,\nu_{\alpha}-m_{\alpha}^{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒘</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi><mo lspace="0.618em" rspace="0em">​</mo><mrow><mover accent="true"><mo>→</mo><mo class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒟</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>α</mi></msub></mrow><mo>,</mo><mrow><msub><mi>ν</mi><mi>α</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{w}}_{\alpha}^{\top}{\bm{x}}\,\,\toind\,\,{\mathcal{N}}\left((-1)^{a}m_{\alpha},\,\nu_{\alpha}-m_{\alpha}^{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.Thmtheorem1.p2" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem1.p2.1" class="ltx_p"><span id="A2.Thmtheorem1.p2.1.1" class="ltx_text ltx_font_italic">where:</span></p>
<table id="A2.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex188.m1" class="ltx_Math" alttext="\displaystyle m_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{\alpha}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex188.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\lambda_{Q}}\left(\|{\bm{\mu}}_{\beta}\|^{2}+\frac{\alpha\beta\gamma(1+\delta_{Q})}{\lambda_{R}}\|{\bm{\mu}}\|^{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>λ</mi><mi>R</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\lambda_{Q}}\left(\|{\bm{\mu}}_{\beta}\|^{2}+\frac{\alpha\beta\gamma(1+\delta_{Q})}{\lambda_{R}}\|{\bm{\mu}}\|^{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex189.m1" class="ltx_Math" alttext="\displaystyle\nu_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\displaystyle\nu_{\alpha}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex189.m2" class="ltx_Math" alttext="\displaystyle=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem1.p2.2" class="ltx_p"><span id="A2.Thmtheorem1.p2.2.1" class="ltx_text ltx_font_italic">With:</span></p>
<table id="A2.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex190.m1" class="ltx_Math" alttext="\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex191.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{2\gamma\beta(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}{\lambda_{R}\lambda_{Q}}\left(1-\frac{\gamma(1+\delta_{Q})}{h\lambda_{Q}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>λ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{2\gamma\beta(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}{\lambda_{R}\lambda_{Q}}\left(1-\frac{\gamma(1+\delta_{Q})}{h\lambda_{Q}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex192.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mn>3</mn></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex193.m1" class="ltx_Math" alttext="\displaystyle\left[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}\right)\right)+\frac{(1-h)(1-\tilde{h})}{\eta}\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>R</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>R</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\frac{\|{\bm{\mu}}\|^{2}}{\lambda_{R}^{2}}\left(\frac{\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\left(1+\frac{\beta^{2}\|{\bm{\mu}}\|^{2}\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}^{2}}-\frac{2\beta^{2}\|{\bm{\mu}}\|^{2}}{\lambda_{Q}}\right)\right)+\frac{(1-h)(1-\tilde{h})}{\eta}\left(1-\frac{2\|{\bm{\mu}}\|^{2}}{\lambda_{R}}\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<figure id="A2.F6" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1"><object type="image/svg+xml" data="2510.21345v1/distribution-N-5000-n-200-p-400-mu-1.5-mu_orth-1-alpha-10-beta-0.3-gamma_pre-1-gamma_ft-1.svg" id="A2.F6.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:548/144;" width="548" height="144"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><object type="image/svg+xml" data="2510.21345v1/distribution-N-5000-n-200-p-400-mu-1.5-mu_orth-1-alpha-10-beta-0.3-gamma_pre-1-gamma_ft-1.svg" id="A2.F6.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:548/144;" width="548" height="144"></object></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1"><object type="image/svg+xml" data="2510.21345v1/legend_1.svg" id="A2.F6.g3" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:439/20;" width="439" height="20"></object></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>Distribution of the decision function <math id="A2.F6.m10" class="ltx_Math" alttext="{\bm{w}}_{\alpha}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}^{\top}{\bm{x}}</annotation></semantics></math> for different values of <math id="A2.F6.m11" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> (per column) and <math id="A2.F6.m12" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> (per row). Here we have <math id="A2.F6.m13" class="ltx_Math" alttext="N=5000" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>5000</mn></mrow><annotation encoding="application/x-tex">N=5000</annotation></semantics></math>, <math id="A2.F6.m14" class="ltx_Math" alttext="n=200" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>200</mn></mrow><annotation encoding="application/x-tex">n=200</annotation></semantics></math>, <math id="A2.F6.m15" class="ltx_Math" alttext="p=400" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>400</mn></mrow><annotation encoding="application/x-tex">p=400</annotation></semantics></math>, <math id="A2.F6.m16" class="ltx_Math" alttext="\|{\bm{\mu}}\|=1.5" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1.5</mn></mrow><annotation encoding="application/x-tex">\|{\bm{\mu}}\|=1.5</annotation></semantics></math>, <math id="A2.F6.m17" class="ltx_Math" alttext="\|{\bm{\mu}}^{\perp}\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msup><mi>𝝁</mi><mo>⟂</mo></msup><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|{\bm{\mu}}^{\perp}\|=1</annotation></semantics></math>, <math id="A2.F6.m18" class="ltx_Math" alttext="\gamma=\tilde{\gamma}=1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mover accent="true"><mi>γ</mi><mo>~</mo></mover><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gamma=\tilde{\gamma}=1</annotation></semantics></math>. The theoretical Gaussian distributions are predicted as per Theorem <a href="#S4.Thmtheorem2" title="Theorem 4.2 (Gaussianity of the fine-tuned Ridge model). ‣ 4 Main results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.</figcaption>
</figure>
</section>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Finding optimal <math id="A2.SS3.m1" class="ltx_Math" alttext="\alpha^{*}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\alpha^{*}</annotation></semantics></math></h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">Since the test accuracy is given by <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\text{test}}=1-\varphi\left((\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>test</mtext></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mi>α</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>α</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\text{test}}=1-\varphi\left((\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}\right)</annotation></semantics></math> as in Proposition <a href="#S4.Thmtheorem3" title="Proposition 4.3 (Asymptotic test accuracy of 𝒘_𝛼). ‣ 4 Main results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, and that <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="\phi(x)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(x)</annotation></semantics></math> is a non-increasing function, then finding the optimal <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="\alpha^{*}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\alpha^{*}</annotation></semantics></math> that maximizes the test accuracy boils down to maximizing the term inside <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. Thus, by computing the derivative with respect to <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> of <math id="A2.SS3.p1.m6" class="ltx_Math" alttext="(\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mi>α</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">(\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}</annotation></semantics></math> and finding the zero of the gradient gives us the final form of the best scaling parameter <math id="A2.SS3.p1.m7" class="ltx_Math" alttext="\alpha^{*}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\alpha^{*}</annotation></semantics></math>:</p>
<table id="A2.Ex194" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex194.m1" class="ltx_Math" alttext="\alpha^{*}=\frac{\lambda_{R}T_{2}\|{\bm{\mu}}_{\beta}\|^{2}-2\beta\gamma T_{1}(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}{\beta\gamma T_{2}(1+\delta_{Q})\|{\bm{\mu}}\|^{2}-2\lambda_{R}T_{3}\|{\bm{\mu}}_{\beta}\|^{2}}" display="block" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo>=</mo><mfrac><mrow><mrow><msub><mi>λ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha^{*}=\frac{\lambda_{R}T_{2}\|{\bm{\mu}}_{\beta}\|^{2}-2\beta\gamma T_{1}(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}{\beta\gamma T_{2}(1+\delta_{Q})\|{\bm{\mu}}\|^{2}-2\lambda_{R}T_{3}\|{\bm{\mu}}_{\beta}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p">And since the worst test accuracy is <math id="A2.SS3.p1.m8" class="ltx_Math" alttext="50\%" display="inline" intent=":literal"><semantics><mrow><mn>50</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">50\%</annotation></semantics></math> (random classification), which is obtained for <math id="A2.SS3.p1.m9" class="ltx_Math" alttext="m_{\alpha}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>α</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m_{\alpha}=0</annotation></semantics></math>, then solving the previous equation gives the worst scaling <math id="A2.SS3.p1.m10" class="ltx_Math" alttext="\bar{\alpha}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>α</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\alpha}</annotation></semantics></math> to use:</p>
<table id="A2.Ex195" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex195.m1" class="ltx_Math" alttext="\bar{\alpha}=-\frac{\lambda_{R}\|{\bm{\mu}}_{\beta}\|^{2}}{\beta\gamma(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><msub><mi>λ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝝁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\bar{\alpha}=-\frac{\lambda_{R}\|{\bm{\mu}}_{\beta}\|^{2}}{\beta\gamma(1+\delta_{Q})\|{\bm{\mu}}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>RMT Analysis of the fine-tuned classifier: the case of random source vector</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">Let <math id="A3.p1.m1" class="ltx_Math" alttext="{\bm{x}}\sim{\mathcal{N}}((-1)^{a}{\bm{\mu}}_{\beta},{\mathbf{I}}_{p})" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>,</mo><msub><mi>𝐈</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}\sim{\mathcal{N}}((-1)^{a}{\bm{\mu}}_{\beta},{\mathbf{I}}_{p})</annotation></semantics></math> be an independent test sample. Let <math id="A3.p1.m2" class="ltx_Math" alttext="\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{w}}</annotation></semantics></math> be the source classifier (obtained through some optimization algorithm). We recall that:</p>
<table id="A3.Ex196" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex196.m1" class="ltx_Math" alttext="{\bm{w}}_{\alpha}={\bm{w}}+\alpha\tilde{\bm{w}}-\frac{\alpha}{n}{\mathbf{Q}}(\gamma){\mathbf{X}}{\mathbf{X}}^{\top}\tilde{\bm{w}},\quad{\bm{w}}=\frac{1}{n}{\mathbf{Q}}(\gamma){\mathbf{X}}{\bm{y}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒘</mi><mi>α</mi></msub><mo>=</mo><mrow><mrow><mi>𝒘</mi><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><mo>−</mo><mrow><mfrac><mi>α</mi><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>𝒘</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}={\bm{w}}+\alpha\tilde{\bm{w}}-\frac{\alpha}{n}{\mathbf{Q}}(\gamma){\mathbf{X}}{\mathbf{X}}^{\top}\tilde{\bm{w}},\quad{\bm{w}}=\frac{1}{n}{\mathbf{Q}}(\gamma){\mathbf{X}}{\bm{y}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Test Expectation</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">We have that:</p>
<table id="A3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E26.m1" class="ltx_Math" alttext="\displaystyle\E[{\bm{w}}_{\alpha}^{\top}{\bm{x}}]=\E[{\bm{w}}^{\top}{\bm{x}}]+\alpha\E[\tilde{\bm{w}}^{\top}{\bm{x}}]-\frac{\alpha}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[{\bm{w}}_{\alpha}^{\top}{\bm{x}}]=\E[{\bm{w}}^{\top}{\bm{x}}]+\alpha\E[\tilde{\bm{w}}^{\top}{\bm{x}}]-\frac{\alpha}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p1.2" class="ltx_p">Let us compute each term of this previous sum.
<br class="ltx_break">First, using lemma <a href="#A1.Thmtheorem6" title="Lemma A.6 (Expectation some classifiers). ‣ A.2 Deterministic equivalents ‣ Appendix A Useful results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.6</span></a>, we have that, since <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> is independent of <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="{\mathbf{X}}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">{\mathbf{X}}</annotation></semantics></math>:</p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex197.m1" class="ltx_Math" alttext="\displaystyle\E[{\bm{w}}^{\top}{\bm{x}}]=\E[{\bm{w}}]^{\top}\E[{\bm{x}}]=\frac{(-1)^{a}}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mi>𝐰</mi><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[{\bm{w}}^{\top}{\bm{x}}]=\E[{\bm{w}}]^{\top}\E[{\bm{x}}]=\frac{(-1)^{a}}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.3" class="ltx_p">And we have that:</p>
<table id="A3.Ex198" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex198.m1" class="ltx_Math" alttext="\E[\tilde{\bm{w}}^{\top}{\bm{x}}]=(-1)^{a}\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\E[\tilde{\bm{w}}^{\top}{\bm{x}}]=(-1)^{a}\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.p2.1" class="ltx_p">And:</p>
<table id="A3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex199"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex199.m1" class="ltx_Math" alttext="\displaystyle\frac{\alpha}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mi>n</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\alpha}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex199.m2" class="ltx_Math" alttext="\displaystyle=\frac{\alpha}{n}\sum_{i=1}^{n}\E[\tilde{\bm{w}}^{\top}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha}{n}\sum_{i=1}^{n}\E[\tilde{\bm{w}}^{\top}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex200"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex200.m1" class="ltx_Math" alttext="\displaystyle=\frac{\alpha}{n(1+\delta_{Q})}\sum_{i=1}^{n}\E[\tilde{\bm{w}}^{\top}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha}{n(1+\delta_{Q})}\sum_{i=1}^{n}\E[\tilde{\bm{w}}^{\top}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex201"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex201.m1" class="ltx_Math" alttext="\displaystyle=\frac{\alpha}{n(1+\delta_{Q})}\sum_{i=1}^{n}\E[\tilde{\bm{w}}^{\top}\Sigma_{\beta}{\mathbf{Q}}_{-i}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha}{n(1+\delta_{Q})}\sum_{i=1}^{n}\E[\tilde{\bm{w}}^{\top}\Sigma_{\beta}{\mathbf{Q}}_{-i}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex202"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex202.m1" class="ltx_Math" alttext="\displaystyle=\frac{(-1)^{a}\alpha}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(-1)^{a}\alpha}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p">Thus:</p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex203"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex203.m1" class="ltx_Math" alttext="\displaystyle\E[{\bm{w}}_{\alpha}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[{\bm{w}}_{\alpha}^{\top}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex203.m2" class="ltx_Math" alttext="\displaystyle=(-1)^{a}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\alpha\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}-\frac{\alpha}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(-1)^{a}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\alpha\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}-\frac{\alpha}{1+\delta_{Q}}\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex204"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex204.m1" class="ltx_Math" alttext="\displaystyle=(-1)^{a}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\alpha\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}-\alpha\tilde{\bm{w}}^{\top}(\bar{\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p})\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>p</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(-1)^{a}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\alpha\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}-\alpha\tilde{\bm{w}}^{\top}(\bar{\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p})\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex205"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex205.m1" class="ltx_Math" alttext="\displaystyle=(-1)^{a}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\alpha\gamma\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(-1)^{a}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}+\alpha\gamma\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.3" class="ltx_p">Using the forumlas in lemma <a href="#A1.Thmtheorem5" title="Lemma A.5 (Relevant Identities). ‣ A.2 Deterministic equivalents ‣ Appendix A Useful results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>:</p>
<table id="A3.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E27.m1" class="ltx_Math" alttext="\E[{\bm{w}}_{\alpha}^{\top}{\bm{x}}]=\frac{(-1)^{a}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}\left(\|{\bm{\mu}}_{\beta}\|^{2}+\alpha\gamma(1+\delta_{Q})\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\E[{\bm{w}}_{\alpha}^{\top}{\bm{x}}]=\frac{(-1)^{a}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}\left(\|{\bm{\mu}}_{\beta}\|^{2}+\alpha\gamma(1+\delta_{Q})\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Test variance</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">To compute the variance of <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="{\bm{w}}_{\alpha}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}^{\top}{\bm{x}}</annotation></semantics></math>, it suffices to compute the second moment: <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]</annotation></semantics></math>.</p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E28.m1" class="ltx_Math" alttext="\displaystyle\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]=\E[({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})^{2}+\frac{\alpha^{2}}{n^{2}}(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}-\frac{2\alpha}{n}\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>α</mi><mn>2</mn></msup><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[({\bm{w}}_{\alpha}^{\top}{\bm{x}})^{2}]=\E[({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})^{2}+\frac{\alpha^{2}}{n^{2}}(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}-\frac{2\alpha}{n}\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<section id="A3.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">First term:</h4>

<div id="A3.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p1.1" class="ltx_p">We start by computing</p>
<table id="A3.Ex206" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex206.m1" class="ltx_Math" alttext="\E[({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]=\E[({\bm{w}}^{\top}{\bm{x}})^{2}]+\alpha^{2}\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]+2\alpha\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\E[({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]=\E[({\bm{w}}^{\top}{\bm{x}})^{2}]+\alpha^{2}\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]+2\alpha\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px1.p1.2" class="ltx_p">We have that, as proved in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Firdoussi &amp; Seddik (2024)</a></cite>:</p>
</div>
<div id="A3.SS2.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<table id="A3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex207"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex207.m1" class="ltx_Math" alttext="\displaystyle\E[({\bm{w}}^{\top}{\bm{x}})^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[({\bm{w}}^{\top}{\bm{x}})^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex207.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{h(1+\delta_{Q})}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-2(1-h){\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{h(1+\delta_{Q})}\left(\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}-2(1-h){\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex208"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex208.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{h(1+\delta_{Q})}\left(\frac{1}{1+\delta_{Q}}\left(({\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta})^{2}+{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}^{2}{\bm{\mu}}_{\beta}\right)-2(1-h){\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{h(1+\delta_{Q})}\left(\frac{1}{1+\delta_{Q}}\left(({\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta})^{2}+{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}^{2}{\bm{\mu}}_{\beta}\right)-2(1-h){\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex209"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex209.m1" class="ltx_Math" alttext="\displaystyle=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}-2(1-h)\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}-2(1-h)\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p3.1" class="ltx_p">And we have that:</p>
<table id="A3.Ex210" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex210.m1" class="ltx_Math" alttext="\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]=\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\E[(\tilde{\bm{w}}^{\top}{\bm{x}})^{2}]=\tilde{\bm{w}}^{\top}\Sigma_{\beta}\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px1.p3.2" class="ltx_p">And:</p>
<table id="A3.Ex211" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex211.m1" class="ltx_Math" alttext="\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]=\E[{\bm{w}}]^{\top}\Sigma_{\beta}\tilde{\bm{w}}=\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\tilde{\bm{w}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">[</mo><mi>𝐰</mi><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\E[{\bm{w}}^{\top}{\bm{x}}\tilde{\bm{w}}^{\top}{\bm{x}}]=\E[{\bm{w}}]^{\top}\Sigma_{\beta}\tilde{\bm{w}}=\frac{1}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px1.p3.3" class="ltx_p">Thus we have the first sum.</p>
</div>
</section>
<section id="A3.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Second term:</h4>

<div id="A3.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px2.p1.1" class="ltx_p">Now let us compute the expectation of the second term:</p>
<table id="A3.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex212"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex212.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n^{2}}\E[(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n^{2}}\E[(\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}})^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex212.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n^{2}}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}\tilde{\bm{w}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n^{2}}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}\tilde{\bm{w}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex213.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\E[\frac{1}{n}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}\Sigma_{\beta}\frac{1}{n}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\E[\frac{1}{n}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}\Sigma_{\beta}\frac{1}{n}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex214"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex214.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\E[({\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p}){\mathbf{Q}}\Sigma_{\beta}({\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p}){\mathbf{Q}}]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐐</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>p</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐐</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>p</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\E[({\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p}){\mathbf{Q}}\Sigma_{\beta}({\mathbf{Q}}^{-1}-\gamma{\mathbf{I}}_{p}){\mathbf{Q}}]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex215.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\E[({\mathbf{I}}_{p}-\gamma{\mathbf{Q}})\Sigma_{\beta}({\mathbf{I}}_{p}-\gamma{\mathbf{Q}})]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐈</mi><mi>p</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐈</mi><mi>p</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\E[({\mathbf{I}}_{p}-\gamma{\mathbf{Q}})\Sigma_{\beta}({\mathbf{I}}_{p}-\gamma{\mathbf{Q}})]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex216.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\E\left[\Sigma_{\beta}-\gamma\Sigma_{\beta}{\mathbf{Q}}-\gamma{\mathbf{Q}}\Sigma_{\beta}+\gamma^{2}{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}\right]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\E\left[\Sigma_{\beta}-\gamma\Sigma_{\beta}{\mathbf{Q}}-\gamma{\mathbf{Q}}\Sigma_{\beta}+\gamma^{2}{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}\right]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex217.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\left(\Sigma_{\beta}-\gamma\Sigma_{\beta}\bar{\mathbf{Q}}-\gamma\bar{\mathbf{Q}}\Sigma_{\beta}+\gamma^{2}\right)\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub></mrow></mrow><mo>+</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\left(\Sigma_{\beta}-\gamma\Sigma_{\beta}\bar{\mathbf{Q}}-\gamma\bar{\mathbf{Q}}\Sigma_{\beta}+\gamma^{2}\right)\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex218.m1" class="ltx_Math" alttext="\displaystyle=\tilde{\bm{w}}^{\top}\Sigma_{\beta}{\bm{w}}-2\gamma\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}\tilde{\bm{w}}+\gamma^{2}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒘</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tilde{\bm{w}}^{\top}\Sigma_{\beta}{\bm{w}}-2\gamma\tilde{\bm{w}}^{\top}\Sigma_{\beta}\bar{\mathbf{Q}}\tilde{\bm{w}}+\gamma^{2}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Third term:</h4>

<div id="A3.SS2.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px3.p1.1" class="ltx_p">Now we will compute the last term: <math id="A3.SS2.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\frac{2\alpha}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})]" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>n</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{2\alpha}{n}\E[\tilde{\bm{w}}^{\top}{\mathbf{X}}{\mathbf{X}}^{\top}{\mathbf{Q}}{\bm{x}}({\bm{w}}^{\top}{\bm{x}}+\alpha\tilde{\bm{w}}^{\top}{\bm{x}})]</annotation></semantics></math>. 
<br class="ltx_break">We have that:</p>
<table id="A3.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
