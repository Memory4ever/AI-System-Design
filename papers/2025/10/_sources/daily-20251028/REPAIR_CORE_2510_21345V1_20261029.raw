<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex240.m1" class="ltx_Math" alttext="\displaystyle=\gamma^{2}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐰</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma^{2}\tilde{\bm{w}}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex241"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex241.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}}{h}\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}}{h}\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}\tilde{\bm{w}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex242"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex242.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}}{h}\left((\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta})^{2}+\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}^{2}\tilde{\bm{w}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}}{h}\left((\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta})^{2}+\tilde{\bm{w}}^{\top}\bar{\mathbf{Q}}^{2}\tilde{\bm{w}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex243"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex243.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left(\frac{(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}}+\frac{1-h}{\eta}\left(\|\tilde{\bm{w}}\|^{2}+\frac{\|{\bm{\mu}}_{\beta}\|^{2}(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}}-\frac{2(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left(\frac{(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}}+\frac{1-h}{\eta}\left(\|\tilde{\bm{w}}\|^{2}+\frac{\|{\bm{\mu}}_{\beta}\|^{2}(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{(\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q}))^{2}}-\frac{2(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex244"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex244.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left(\frac{(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\|\tilde{\bm{w}}\|^{2}+\frac{(1-h)(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left(\frac{(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\|\tilde{\bm{w}}\|^{2}+\frac{(1-h)(\tilde{\bm{w}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS0.Px7.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px7.p3.1" class="ltx_p">Which finally gives the following theorem:</p>
</div>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Gaussianity of the fine-tuned model for an arbitrary <math id="A3.Thmtheorem1.m1" class="ltx_Math" alttext="\tilde{\bm{w}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{w}}</annotation></semantics></math>)<span id="A3.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="{\bm{w}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}</annotation></semantics></math> be the fine-tuned classifier as defined in equation <a href="#S3.Ex3" title="In Fine-tuning phase. ‣ 3.1 Theoretical Setting ‣ 3 Problem setting and Background ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">
                  
                    α
                  
                -FTC</span></a> and suppose that Assumption <a href="#S4.Thmtheorem1" title="Assumption 4.1 (Growth Rates). ‣ 4 Main results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> holds. The decision function <math id="A3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="{\bm{w}}_{\alpha}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐰</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\alpha}^{\top}{\bm{x}}</annotation></semantics></math>, on some test sample <math id="A3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="{\bm{x}}\in{\mathcal{C}}_{a}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{x}}\in{\mathcal{C}}_{a}</annotation></semantics></math> independent of <math id="A3.Thmtheorem1.p1.m4" class="ltx_Math" alttext="{\mathbf{X}}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">{\mathbf{X}}</annotation></semantics></math>, satisfies:</span></p>
<table id="A3.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex245"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex245.m1" class="ltx_Math" alttext="\displaystyle{\bm{w}}_{\alpha}^{\top}{\bm{x}}\,\,\toind\,\,{\mathcal{N}}\left((-1)^{a}m_{\alpha},\,\nu_{\alpha}-m_{\alpha}^{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒘</mi><mi>α</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi><mo lspace="0.618em" rspace="0em">​</mo><mrow><mover accent="true"><mo>→</mo><mo class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒟</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>α</mi></msub></mrow><mo>,</mo><mrow><msub><mi>ν</mi><mi>α</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{w}}_{\alpha}^{\top}{\bm{x}}\,\,\toind\,\,{\mathcal{N}}\left((-1)^{a}m_{\alpha},\,\nu_{\alpha}-m_{\alpha}^{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem1.p1.2" class="ltx_p"><span id="A3.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where:</span></p>
<table id="A3.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex246"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex246.m1" class="ltx_Math" alttext="\displaystyle m_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\displaystyle m_{\alpha}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex246.m2" class="ltx_Math" alttext="\displaystyle=\frac{\|{\bm{\mu}}_{\beta}\|^{2}+\alpha\gamma(1+\delta_{Q})\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\|{\bm{\mu}}_{\beta}\|^{2}+\alpha\gamma(1+\delta_{Q})\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex247"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex247.m1" class="ltx_Math" alttext="\displaystyle\nu_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\displaystyle\nu_{\alpha}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex247.m2" class="ltx_Math" alttext="\displaystyle=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=T_{1}+\alpha T_{2}+\alpha^{2}T_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmtheorem1.p1.3" class="ltx_p"><span id="A3.Thmtheorem1.p1.3.1" class="ltx_text ltx_font_italic">with:</span></p>
<table id="A3.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex248"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex248.m1" class="ltx_Math" alttext="\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex249"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex249.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda}-(1-h)\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mi>λ</mi></mfrac></mstyle><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda}-(1-h)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex250"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex250.m1" class="ltx_Math" alttext="\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left(\frac{\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\|\tilde{\bm{w}}\|^{2}+\frac{(1-h)\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle^{2}}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\left(\frac{\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle^{2}}{\lambda_{Q}^{2}}+\frac{1-h}{\eta}\|\tilde{\bm{w}}\|^{2}+\frac{(1-h)\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle^{2}}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Finding optimal <math id="A3.SS3.m1" class="ltx_Math" alttext="\alpha^{*}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\alpha^{*}</annotation></semantics></math></h3>

<div id="A3.SS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS3.p1.1" class="ltx_p">Since the test accuracy is given by <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\text{test}}=1-\varphi\left((\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>test</mtext></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mi>α</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>α</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\text{test}}=1-\varphi\left((\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}\right)</annotation></semantics></math> as in Proposition <a href="#S4.Thmtheorem3" title="Proposition 4.3 (Asymptotic test accuracy of 𝒘_𝛼). ‣ 4 Main results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, and that <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="\phi(x)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(x)</annotation></semantics></math> is a non-increasing function, then finding the optimal <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="\alpha^{*}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\alpha^{*}</annotation></semantics></math> that maximizes the test accuracy boils down to maximizing the term inside <math id="A3.SS3.p1.m4" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>. Thus, by computing the derivative with respect to <math id="A3.SS3.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> of <math id="A3.SS3.p1.m6" class="ltx_Math" alttext="(\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mi>α</mi></msub><mo>−</mo><msubsup><mi>m</mi><mi>α</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">(\nu_{\alpha}-m_{\alpha}^{2})^{-\frac{1}{2}}m_{\alpha}</annotation></semantics></math> and finding the zero of the gradient gives us the final form of the best scaling parameter <math id="A3.SS3.p1.m7" class="ltx_Math" alttext="\alpha^{*}" display="inline" intent=":literal"><semantics><msup><mi>α</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\alpha^{*}</annotation></semantics></math>:</p>
<table id="A3.Ex251" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex251.m1" class="ltx_Math" alttext="\alpha^{*}=\frac{\eta(1+\gamma(1+\delta_{Q}))\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}{\gamma(1+\delta_{Q})\left(\lambda\|{\bm{\mu}}_{\beta}\|^{2}\|\tilde{\bm{w}}\|^{2}-(\lambda-\eta)\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle^{2}\right)}" display="block" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo>=</mo><mfrac><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>−</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha^{*}=\frac{\eta(1+\gamma(1+\delta_{Q}))\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}{\gamma(1+\delta_{Q})\left(\lambda\|{\bm{\mu}}_{\beta}\|^{2}\|\tilde{\bm{w}}\|^{2}-(\lambda-\eta)\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle^{2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.2" class="ltx_p">And since the worst test accuracy is <math id="A3.SS3.p1.m8" class="ltx_Math" alttext="50\%" display="inline" intent=":literal"><semantics><mrow><mn>50</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">50\%</annotation></semantics></math> (random classification), which is obtained for <math id="A3.SS3.p1.m9" class="ltx_Math" alttext="m_{\alpha}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>α</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m_{\alpha}=0</annotation></semantics></math>, then solving the previous equation gives the worst scaling <math id="A3.SS3.p1.m10" class="ltx_Math" alttext="\bar{\alpha}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>α</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\alpha}</annotation></semantics></math> to use:</p>
<table id="A3.Ex252" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex252.m1" class="ltx_Math" alttext="\bar{\alpha}=\frac{-\|{\bm{\mu}}_{\beta}\|^{2}}{\gamma(1+\delta_{Q})\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mo>=</mo><mfrac><mrow><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>𝒘</mi><mo>~</mo></mover><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\bar{\alpha}=\frac{-\|{\bm{\mu}}_{\beta}\|^{2}}{\gamma(1+\delta_{Q})\langle\tilde{\bm{w}},{\bm{\mu}}_{\beta}\rangle}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Extension to multi-source classifiers</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">Given <math id="A4.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> source classifiers <math id="A4.p1.m2" class="ltx_Math" alttext="\{{\bm{w}}_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>𝒘</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{{\bm{w}}_{t}\}_{t=1}^{T}</annotation></semantics></math> and a single target task, the goal is to fine-tune a mixture of these classifiers on the target task. Specifically, we want to find the optimal fine-tuned classifier <math id="A4.p1.m3" class="ltx_Math" alttext="{\bm{w}}_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>𝒘</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">{\bm{w}}_{\Omega}</annotation></semantics></math> that is written as:</p>
<table id="A4.Ex253" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex253.m1" class="ltx_Math" alttext="{\bm{w}}_{\Omega}=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}+{\bm{a}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝒘</mi><mi mathvariant="normal">Ω</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mi>𝒂</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\Omega}=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}+{\bm{a}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p">where <math id="A4.p1.m4" class="ltx_Math" alttext="\alpha_{t}\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\alpha_{t}\in{\mathbb{R}}</annotation></semantics></math> and <math id="A4.p1.m5" class="ltx_Math" alttext="{\bm{a}}" display="inline" intent=":literal"><semantics><mi>𝒂</mi><annotation encoding="application/x-tex">{\bm{a}}</annotation></semantics></math> is an adapter trained on the target dataset as follows:</p>
<table id="A4.Ex254" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex254.m1" class="ltx_Math" alttext="{\bm{a}}=\argmin_{{\bm{v}}}\frac{1}{n}\|{\mathbf{X}}^{\top}(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}+{\bm{v}})-{\bm{y}}\|^{2}+\gamma\|{\bm{v}}\|^{2}" display="block" intent=":literal"><semantics><mrow><mi>𝒂</mi><mo>=</mo><mrow><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>𝐯</mi></msub><mo>⁡</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mi>𝐯</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>𝐲</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝐯</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{a}}=\argmin_{{\bm{v}}}\frac{1}{n}\|{\mathbf{X}}^{\top}(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}+{\bm{v}})-{\bm{y}}\|^{2}+\gamma\|{\bm{v}}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.3" class="ltx_p">Then, <math id="A4.p1.m6" class="ltx_Math" alttext="{\bm{a}}" display="inline" intent=":literal"><semantics><mi>𝒂</mi><annotation encoding="application/x-tex">{\bm{a}}</annotation></semantics></math> expresses as:</p>
<table id="A4.Ex255" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex255.m1" class="ltx_Math" alttext="{\bm{a}}=\frac{1}{n}\left(\frac{1}{n}{\mathbf{X}}{\mathbf{X}}^{\top}+\gamma{\mathbf{I}}_{p}\right)^{-1}\left({\mathbf{X}}{\bm{y}}-{\mathbf{X}}{\mathbf{X}}^{\top}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}\right)" display="block" intent=":literal"><semantics><mrow><mi>𝒂</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐈</mi><mi>p</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>𝐗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow><mo>−</mo><mrow><msup><mi>𝐗𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{a}}=\frac{1}{n}\left(\frac{1}{n}{\mathbf{X}}{\mathbf{X}}^{\top}+\gamma{\mathbf{I}}_{p}\right)^{-1}\left({\mathbf{X}}{\bm{y}}-{\mathbf{X}}{\mathbf{X}}^{\top}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.4" class="ltx_p">Thus, our new fine-tuned classifier writes as:</p>
<table id="A4.Ex256" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex256.m1" class="ltx_Math" alttext="{\bm{w}}_{\Omega}=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}+{\bm{a}}=\frac{1}{n}{\mathbf{Q}}{\mathbf{X}}{\bm{y}}+\gamma\sum_{t=1}^{T}\alpha_{t}{\mathbf{Q}}{\bm{w}}_{t}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝒘</mi><mi mathvariant="normal">Ω</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mi>𝒂</mi></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐐𝐗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>t</mi></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\Omega}=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}+{\bm{a}}=\frac{1}{n}{\mathbf{Q}}{\mathbf{X}}{\bm{y}}+\gamma\sum_{t=1}^{T}\alpha_{t}{\mathbf{Q}}{\bm{w}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.5" class="ltx_p">To compute the theoretical test accuracy of this classifier, we will take a test sample <math id="A4.p1.m7" class="ltx_Math" alttext="{\bm{x}}\sim{\mathcal{N}}((-1)^{a}{\bm{\mu}}_{\beta},{\mathbf{I}}_{p})" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>,</mo><msub><mi>𝐈</mi><mi>p</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}\sim{\mathcal{N}}((-1)^{a}{\bm{\mu}}_{\beta},{\mathbf{I}}_{p})</annotation></semantics></math>, independent from the training data <math id="A4.p1.m8" class="ltx_Math" alttext="({\bm{x}}_{i})_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">({\bm{x}}_{i})_{i=1}^{n}</annotation></semantics></math>, and we compute the statistics of the decision function <math id="A4.p1.m9" class="ltx_Math" alttext="{\bm{w}}_{\Omega}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\Omega}^{\top}{\bm{x}}</annotation></semantics></math>.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Test Expectation</h3>

<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p">We have that:</p>
<table id="A4.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex257"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex257.m1" class="ltx_Math" alttext="\displaystyle\E[{\bm{w}}_{\Omega}^{\top}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[{\bm{w}}_{\Omega}^{\top}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex257.m2" class="ltx_Math" alttext="\displaystyle=\E[{\bm{w}}^{\top}{\bm{x}}]+\gamma\sum_{t=1}^{T}\alpha_{t}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\E[{\bm{w}}^{\top}{\bm{x}}]+\gamma\sum_{t=1}^{T}\alpha_{t}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex258"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex258.m1" class="ltx_Math" alttext="\displaystyle=\E[{\bm{w}}^{\top}{\bm{x}}]+(-1)^{a}\gamma\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\E[{\bm{w}}^{\top}{\bm{x}}]+(-1)^{a}\gamma\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.2" class="ltx_p">From the previous section, we have that:</p>
<table id="A4.Ex259" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex259.m1" class="ltx_Math" alttext="\E[{\bm{w}}^{\top}{\bm{x}}]=\frac{(-1)^{a}}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}=\frac{(-1)^{a}\|{\bm{\mu}}_{\beta}\|^{2}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>=</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\E[{\bm{w}}^{\top}{\bm{x}}]=\frac{(-1)^{a}}{1+\delta_{Q}}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}=\frac{(-1)^{a}\|{\bm{\mu}}_{\beta}\|^{2}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.3" class="ltx_p">And from lemma <a href="#A1.Thmtheorem5" title="Lemma A.5 (Relevant Identities). ‣ A.2 Deterministic equivalents ‣ Appendix A Useful results ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a>, we have that:</p>
<table id="A4.Ex260" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex260.m1" class="ltx_Math" alttext="{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}=\frac{(1+\delta_{Q})\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}=\frac{(1+\delta_{Q})\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.4" class="ltx_p">Finally, we get that:</p>
<table id="A4.Ex261" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex261.m1" class="ltx_Math" alttext="\boxed{\E[{\bm{w}}_{\Omega}^{\top}{\bm{x}}]=\frac{(-1)^{a}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}\left(\|{\bm{\mu}}_{\beta}\|^{2}+\gamma(1+\delta_{Q})\sum_{t=1}^{T}\alpha_{t}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\right)}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝐰</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></menclose><annotation encoding="application/x-tex">\boxed{\E[{\bm{w}}_{\Omega}^{\top}{\bm{x}}]=\frac{(-1)^{a}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}\left(\|{\bm{\mu}}_{\beta}\|^{2}+\gamma(1+\delta_{Q})\sum_{t=1}^{T}\alpha_{t}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p">In a vectorized form, denote by <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="\bm{\alpha}=(\alpha_{1},\dots,\alpha_{T})^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝜶</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>α</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\bm{\alpha}=(\alpha_{1},\dots,\alpha_{T})^{\top}</annotation></semantics></math> the vector of coefficients and by <math id="A4.SS1.p2.m2" class="ltx_Math" alttext="{\mathbf{W}}=({\bm{w}}_{1},\dots,{\bm{w}}_{T})\in{\mathbb{R}}^{p\times T}" display="inline" intent=":literal"><semantics><mrow><mi>𝐖</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒘</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝒘</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>p</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{W}}=({\bm{w}}_{1},\dots,{\bm{w}}_{T})\in{\mathbb{R}}^{p\times T}</annotation></semantics></math>, then we have that:</p>
<table id="A4.Ex262" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex262.m1" class="ltx_Math" alttext="\boxed{\E[{\bm{w}}_{\Omega}^{\top}{\bm{x}}]=(-1)^{a}\frac{\|{\bm{\mu}}_{\beta}\|^{2}+\gamma(1+\delta_{Q})\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow></menclose><annotation encoding="application/x-tex">\boxed{\E[{\bm{w}}_{\Omega}^{\top}{\bm{x}}]=(-1)^{a}\frac{\|{\bm{\mu}}_{\beta}\|^{2}+\gamma(1+\delta_{Q})\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}}{\|{\bm{\mu}}_{\beta}\|^{2}+1+\gamma(1+\delta_{Q})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Test variance</h3>

<div id="A4.SS2.p1" class="ltx_para ltx_noindent">
<p id="A4.SS2.p1.1" class="ltx_p">Now we will compute the expectation of the second order moment of <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="{\bm{w}}_{\Omega}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\Omega}^{\top}{\bm{x}}</annotation></semantics></math>:</p>
<table id="A4.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex263"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex263.m1" class="ltx_Math" alttext="\displaystyle\E[({\bm{w}}_{\Omega}^{\top}{\bm{x}})^{2}]=\E\left[({\bm{w}}^{\top}{\bm{x}})^{2}+\gamma^{2}\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}+2\gamma\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E[({\bm{w}}_{\Omega}^{\top}{\bm{x}})^{2}]=\E\left[({\bm{w}}^{\top}{\bm{x}})^{2}+\gamma^{2}\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}+2\gamma\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p1.2" class="ltx_p">Let us compute each term of this sum and then aggregate the results at the end.</p>
</div>
<section id="A4.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">First term.</h4>

<div id="A4.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px1.p1.1" class="ltx_p">We have that:</p>
<table id="A4.Ex264" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex264.m1" class="ltx_Math" alttext="\E[({\bm{w}}^{\top}{\bm{x}})^{2}]=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">\E[({\bm{w}}^{\top}{\bm{x}})^{2}]=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Second term.</h4>

<div id="A4.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px2.p1.1" class="ltx_p">Now let us compute the second term of the sum:</p>
<table id="A4.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex265"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex265.m1" class="ltx_Math" alttext="\displaystyle\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex265.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\alpha_{t}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}{\bm{w}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\alpha_{t}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}{\bm{w}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="A4.Ex266"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex266.m1" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\alpha_{t}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}\Sigma_{\beta}{\bm{w}}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\alpha_{t}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}\Sigma_{\beta}{\bm{w}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="A4.Ex267"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex267.m1" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}\frac{1}{n}\sum_{i=1}^{n}y_{i}{\mathbf{Q}}{\bm{x}}_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}\frac{1}{n}\sum_{i=1}^{n}y_{i}{\mathbf{Q}}{\bm{x}}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="A4.Ex268"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex268.m1" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}y_{i}{\bm{x}}_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}y_{i}{\bm{x}}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex268.m2" class="ltx_Math" alttext="\displaystyle({\bm{x}}_{i}\text{ i.i.d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> i.i.d</mtext></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{x}}_{i}\text{ i.i.d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex269"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex269.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{1+\delta_{Q}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1+\delta_{Q}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px2.p1.2" class="ltx_p">And since we have that:</p>
<table id="A4.Ex270" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex270.m1" class="ltx_Math" alttext="{\mathbf{Q}}={\mathbf{Q}}_{-i}-\frac{{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}}{n(1+\delta_{Q})}" display="block" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>=</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo>−</mo><mfrac><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒙</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{Q}}={\mathbf{Q}}_{-i}-\frac{{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}}{n(1+\delta_{Q})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px2.p2.1" class="ltx_p">Then:</p>
<table id="A4.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex271"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex271.m1" class="ltx_Math" alttext="\displaystyle\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]=\frac{1}{1+\delta_{Q}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E\left[\left({\mathbf{Q}}_{-i}-\frac{{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}}{n(1+\delta_{Q})}\right)\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub></mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]=\frac{1}{1+\delta_{Q}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E\left[\left({\mathbf{Q}}_{-i}-\frac{{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}}{n(1+\delta_{Q})}\right)\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex272"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex272.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{1+\delta_{Q}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]-\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{1+\delta_{Q}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]-\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px2.p2.2" class="ltx_p">We have that:</p>
<table id="A4.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex273"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex273.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex273.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex274"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex274.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{h}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{h}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex275"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex275.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{h}\sum_{t=1}^{T}\alpha_{t}\frac{(1+\delta_{Q})^{2}}{\lambda_{Q}^{2}}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\left(\|{\bm{\mu}}_{\beta}\|^{2}+1\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{h}\sum_{t=1}^{T}\alpha_{t}\frac{(1+\delta_{Q})^{2}}{\lambda_{Q}^{2}}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\left(\|{\bm{\mu}}_{\beta}\|^{2}+1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px2.p2.3" class="ltx_p">And we have that:</p>
<table id="A4.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex276"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex276.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]=\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}\Tr({\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i})]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}{\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]=\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}\Tr({\bm{x}}_{i}{\bm{x}}_{i}^{\top}{\mathbf{Q}}_{-i}\Sigma_{\beta}{\mathbf{Q}}_{-i})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex277"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex277.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}\Tr(\Sigma_{\beta}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}])]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}\Tr(\Sigma_{\beta}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}])]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex278"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex278.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]\frac{1}{h}\Tr((\Sigma_{\beta}\bar{\mathbf{Q}})^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐐</mi><mrow><mo>−</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐱</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>h</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n(1+\delta_{Q})^{2}}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}_{-i}y_{i}{\bm{x}}_{i}]\frac{1}{h}\Tr((\Sigma_{\beta}\bar{\mathbf{Q}})^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex279"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex279.m1" class="ltx_Math" alttext="\displaystyle=\frac{1-h}{h}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-h}{h}\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex280"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex280.m1" class="ltx_Math" alttext="\displaystyle=\frac{1-h}{h}\sum_{t=1}^{T}\alpha_{t}\frac{(1+\delta_{Q})\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-h}{h}\sum_{t=1}^{T}\alpha_{t}\frac{(1+\delta_{Q})\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px2.p3.1" class="ltx_p">Thus the second term is given by:</p>
<table id="A4.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex281"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex281.m1" class="ltx_Math" alttext="\displaystyle\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐰</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{w}}^{\top}{\bm{x}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex281.m2" class="ltx_Math" alttext="\displaystyle=\frac{(1+\delta_{Q})}{h\lambda_{Q}}\sum_{t=1}^{T}\alpha_{t}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(1+\delta_{Q})}{h\lambda_{Q}}\sum_{t=1}^{T}\alpha_{t}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex282"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex282.m1" class="ltx_Math" alttext="\displaystyle=\frac{(1+\delta_{Q})}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(1+\delta_{Q})}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS2.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Third term.</h4>

<div id="A4.SS2.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px3.p1.1" class="ltx_p">We have that:</p>
<table id="A4.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex283"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex283.m1" class="ltx_Math" alttext="\displaystyle\gamma^{2}\E\left[\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gamma^{2}\E\left[\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex283.m2" class="ltx_Math" alttext="\displaystyle=\gamma^{2}\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\sum_{k=1}^{T}\alpha_{k}{\bm{w}}_{k}^{\top}{\mathbf{Q}}{\bm{x}}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma^{2}\E\left[\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\sum_{k=1}^{T}\alpha_{k}{\bm{w}}_{k}^{\top}{\mathbf{Q}}{\bm{x}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex284"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex284.m1" class="ltx_Math" alttext="\displaystyle=\gamma^{2}\sum_{t,k=1}^{T}\E[\alpha_{t}\alpha_{k}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}{\mathbf{Q}}{\bm{w}}_{k}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐱𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma^{2}\sum_{t,k=1}^{T}\E[\alpha_{t}\alpha_{k}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}{\bm{x}}^{\top}{\mathbf{Q}}{\bm{w}}_{k}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex285"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex285.m1" class="ltx_Math" alttext="\displaystyle=\gamma^{2}\sum_{t,k=1}^{T}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}{\bm{w}}_{k}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>k</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma^{2}\sum_{t,k=1}^{T}\E[{\bm{w}}_{t}^{\top}{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}{\bm{w}}_{k}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex286"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex286.m1" class="ltx_Math" alttext="\displaystyle=\gamma^{2}\sum_{t,k=1}^{T}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]{\bm{w}}_{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝐐</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>k</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma^{2}\sum_{t,k=1}^{T}{\bm{w}}_{t}^{\top}\E[{\mathbf{Q}}\Sigma_{\beta}{\mathbf{Q}}]{\bm{w}}_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex287"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex287.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}}{h}\sum_{t,k=1}^{T}\alpha_{t}\alpha_{k}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{w}}_{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒘</mi><mi>k</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}}{h}\sum_{t,k=1}^{T}\alpha_{t}\alpha_{k}{\bm{w}}_{t}^{\top}\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}{\bm{w}}_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px3.p1.2" class="ltx_p">And we have that:</p>
<table id="A4.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex288"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex288.m1" class="ltx_Math" alttext="\displaystyle\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">\displaystyle\bar{\mathbf{Q}}\Sigma_{\beta}\bar{\mathbf{Q}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex288.m2" class="ltx_Math" alttext="\displaystyle=\bar{\mathbf{Q}}\left({\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}+{\mathbf{I}}_{p}\right)\bar{\mathbf{Q}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup></mrow><mo>+</mo><msub><mi>𝐈</mi><mi>p</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bar{\mathbf{Q}}\left({\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}+{\mathbf{I}}_{p}\right)\bar{\mathbf{Q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex289"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex289.m1" class="ltx_Math" alttext="\displaystyle=\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}+\bar{\mathbf{Q}}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover></mrow><mo>+</mo><msup><mover accent="true"><mi>𝐐</mi><mo>¯</mo></mover><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\bar{\mathbf{Q}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}\bar{\mathbf{Q}}+\bar{\mathbf{Q}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex290"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex290.m1" class="ltx_Math" alttext="\displaystyle=\frac{(1+\delta_{Q})^{2}}{\lambda_{Q}^{2}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}+\frac{(1+\delta_{Q})^{2}}{(1+\gamma(1+\delta_{Q}))^{2}}\left({\mathbf{I}}_{p}+\frac{({\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top})^{2}}{\lambda_{Q}^{2}}-\frac{2{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}}{\lambda_{Q}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝐈</mi><mi>p</mi></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(1+\delta_{Q})^{2}}{\lambda_{Q}^{2}}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}+\frac{(1+\delta_{Q})^{2}}{(1+\gamma(1+\delta_{Q}))^{2}}\left({\mathbf{I}}_{p}+\frac{({\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top})^{2}}{\lambda_{Q}^{2}}-\frac{2{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}}{\lambda_{Q}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px3.p1.3" class="ltx_p">Thus the last term is given by:</p>
<table id="A4.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex291"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex291.m1" class="ltx_math_unparsed" alttext="\displaystyle\gamma^{2}\E\left[\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}\right]=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mn>2</mn></msup><mi>𝔼</mi><mrow><mo>[</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>α</mi><mi>t</mi></msub><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mi>𝐐</mi><mi>𝐱</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma^{2}\E\left[\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}\right]=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex292"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex292.m1" class="ltx_Math" alttext="\displaystyle\sum_{t,k=1}^{T}\alpha_{t}\alpha_{k}\left[\frac{\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(\langle{\bm{w}}_{t},{\bm{w}}_{k}\rangle+\frac{\|{\bm{\mu}}_{\beta}\|^{2}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}-\frac{2\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒘</mi><mi>k</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t,k=1}^{T}\alpha_{t}\alpha_{k}\left[\frac{\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(\langle{\bm{w}}_{t},{\bm{w}}_{k}\rangle+\frac{\|{\bm{\mu}}_{\beta}\|^{2}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}-\frac{2\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px3.p1.4" class="ltx_p">In a vectorized form, we have that:</p>
<table id="A4.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex293.m1" class="ltx_math_unparsed" alttext="\displaystyle\gamma^{2}\E\left[\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}\right]=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mn>2</mn></msup><mi>𝔼</mi><mrow><mo>[</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>α</mi><mi>t</mi></msub><msubsup><mi>𝐰</mi><mi>t</mi><mo>⊤</mo></msubsup><mi>𝐐</mi><mi>𝐱</mi><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gamma^{2}\E\left[\left(\sum_{t=1}^{T}\alpha_{t}{\bm{w}}_{t}^{\top}{\mathbf{Q}}{\bm{x}}\right)^{2}\right]=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex294.m1" class="ltx_Math" alttext="\displaystyle\left[\frac{(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\mathbf{W}}\bm{\alpha}+\frac{\|{\bm{\mu}}_{\beta}\|^{2}(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}^{2}}-\frac{2(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\frac{(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\mathbf{W}}\bm{\alpha}+\frac{\|{\bm{\mu}}_{\beta}\|^{2}(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}^{2}}-\frac{2(\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta})^{2}}{\lambda_{Q}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex295.m1" class="ltx_Math" alttext="\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\bm{\alpha}^{\top}{\mathbf{M}}\bm{\alpha}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐌</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\bm{\alpha}^{\top}{\mathbf{M}}\bm{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px3.p1.5" class="ltx_p">where:</p>
<table id="A4.Ex296" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex296.m1" class="ltx_Math" alttext="{\mathbf{M}}=\frac{(1-h)}{\eta}{\mathbf{W}}^{\top}{\mathbf{W}}+\left(\frac{1}{\lambda_{Q}^{2}}+\frac{(1-h)}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right){\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}{\mathbf{W}}^{\top}" display="block" intent=":literal"><semantics><mrow><mi>𝐌</mi><mo>=</mo><mrow><mrow><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac><mo>+</mo><mrow><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac><mo>−</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{M}}=\frac{(1-h)}{\eta}{\mathbf{W}}^{\top}{\mathbf{W}}+\left(\frac{1}{\lambda_{Q}^{2}}+\frac{(1-h)}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right){\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}{\mathbf{W}}^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px3.p2.1" class="ltx_p">Finally gives us the expression of the second order moment of <math id="A4.SS2.SSS0.Px3.p2.m1" class="ltx_Math" alttext="{\bm{w}}_{\Omega}^{\top}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><annotation encoding="application/x-tex">{\bm{w}}_{\Omega}^{\top}{\bm{x}}</annotation></semantics></math> as follows:</p>
<table id="A4.Ex297" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex297.m1" class="ltx_Math" alttext="\E[({\bm{w}}_{\Omega}^{\top}{\bm{x}})^{2}]=T_{1}+T_{2}+T_{3}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐰</mi><mi mathvariant="normal">Ω</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><msub><mi>T</mi><mn>2</mn></msub><mo>+</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\E[({\bm{w}}_{\Omega}^{\top}{\bm{x}})^{2}]=T_{1}+T_{2}+T_{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px3.p2.2" class="ltx_p">where:</p>
<table id="A4.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex298.m1" class="ltx_Math" alttext="\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex299"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex299.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})}{h\lambda_{Q}}\sum_{t=1}^{T}\alpha_{t}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})}{h\lambda_{Q}}\sum_{t=1}^{T}\alpha_{t}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex300"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex300.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mn>3</mn></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex301"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex301.m1" class="ltx_Math" alttext="\displaystyle\sum_{t,k=1}^{T}\alpha_{t}\alpha_{k}\left[\frac{\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(\langle{\bm{w}}_{t},{\bm{w}}_{k}\rangle+\frac{\|{\bm{\mu}}_{\beta}\|^{2}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}-\frac{2\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>t</mi><mo>,</mo><mi>k</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝒘</mi><mi>k</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝒘</mi><mi>k</mi></msub><mo>,</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t,k=1}^{T}\alpha_{t}\alpha_{k}\left[\frac{\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}+\frac{1}{(1+\gamma(1+\delta_{Q}))^{2}}\left(\langle{\bm{w}}_{t},{\bm{w}}_{k}\rangle+\frac{\|{\bm{\mu}}_{\beta}\|^{2}\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}^{2}}-\frac{2\langle{\bm{w}}_{t},{\bm{\mu}}_{\beta}\rangle\langle{\bm{w}}_{k},{\bm{\mu}}_{\beta}\rangle}{\lambda_{Q}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS2.SSS0.Px3.p3" class="ltx_para ltx_noindent">
<p id="A4.SS2.SSS0.Px3.p3.1" class="ltx_p">Which also writes in a vectorized form:</p>
<table id="A4.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex302"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex302.m1" class="ltx_Math" alttext="\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-2(1-h)\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex303"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex303.m1" class="ltx_Math" alttext="\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{2}=\frac{2\gamma(1+\delta_{Q})}{h\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{\lambda_{Q}}-(1-h)\right)\bm{\alpha}^{\top}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex304"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex304.m1" class="ltx_Math" alttext="\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\bm{\alpha}^{\top}{\mathbf{M}}\bm{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐌</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{3}=\frac{\gamma^{2}(1+\delta_{Q})^{2}}{h}\bm{\alpha}^{\top}{\mathbf{M}}\bm{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Finding optimal <math id="A4.SS3.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></h3>

<div id="A4.SS3.p1" class="ltx_para ltx_noindent">
<p id="A4.SS3.p1.1" class="ltx_p">The theoretical test accuracy writes as follows:</p>
<table id="A4.Ex305" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex305.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\text{test}}(\bm{\alpha})=\varphi\left(\frac{a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1}}{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>test</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜶</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>1</mn></msub></mrow></mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow></msqrt></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\text{test}}(\bm{\alpha})=\varphi\left(\frac{a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1}}{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p1.2" class="ltx_p">where:</p>
<table id="A4.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex306"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex306.m1" class="ltx_Math" alttext="\displaystyle a_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}},\quad{\bm{v}}_{1}=\frac{\gamma(1+\delta_{Q})}{\lambda_{Q}}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta},\quad a_{2}=T_{1}-a_{1}^{2}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{h\lambda_{Q}}-\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-\frac{2(1-h)}{h}\right)+\frac{1-h}{h}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>𝒗</mi><mn>1</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><msubsup><mi>a</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>h</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle a_{1}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}},\quad{\bm{v}}_{1}=\frac{\gamma(1+\delta_{Q})}{\lambda_{Q}}{\mathbf{W}}^{\top}{\bm{\mu}}_{\beta},\quad a_{2}=T_{1}-a_{1}^{2}=\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{h\lambda_{Q}}-\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-\frac{2(1-h)}{h}\right)+\frac{1-h}{h}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex307"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex307.m1" class="ltx_Math" alttext="\displaystyle{\bm{v}}_{2}=\frac{(1+\delta_{Q})}{\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{h\lambda_{Q}}-\frac{2\gamma\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-\frac{1-h}{h}\right){\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒗</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mi>h</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{v}}_{2}=\frac{(1+\delta_{Q})}{\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}+1}{h\lambda_{Q}}-\frac{2\gamma\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-\frac{1-h}{h}\right){\mathbf{W}}^{\top}{\bm{\mu}}_{\beta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex308"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex308.m1" class="ltx_Math" alttext="\displaystyle\tilde{M}=\frac{\gamma^{2}(1+\delta_{Q})^{2}(1-h)}{h}\left(\frac{1}{\eta}{\mathbf{W}}^{\top}{\mathbf{W}}+\left(\frac{1}{\lambda_{Q}^{2}}+\frac{1}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right){\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}{\mathbf{W}}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>M</mi><mo>~</mo></mover><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>h</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐖</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>λ</mi><mi>Q</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msub><mi>λ</mi><mi>Q</mi></msub></mfrac></mstyle><mo>−</mo><mn>2</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝝁</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝝁</mi><mi>β</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐖</mi><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{M}=\frac{\gamma^{2}(1+\delta_{Q})^{2}(1-h)}{h}\left(\frac{1}{\eta}{\mathbf{W}}^{\top}{\mathbf{W}}+\left(\frac{1}{\lambda_{Q}^{2}}+\frac{1}{\eta\lambda_{Q}}\left(\frac{\|{\bm{\mu}}_{\beta}\|^{2}}{\lambda_{Q}}-2\right)\right){\mathbf{W}}^{\top}{\bm{\mu}}_{\beta}{\bm{\mu}}_{\beta}^{\top}{\mathbf{W}}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p1.3" class="ltx_p">And therefore, since <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is non-decreasing, maximizing this test accuracy boils down to maximizing the term inside it, i.e we want to find <math id="A4.SS3.p1.m2" class="ltx_Math" alttext="\bm{\alpha}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝜶</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\bm{\alpha}^{*}</annotation></semantics></math> that satisfies:</p>
<table id="A4.Ex309" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex309.m1" class="ltx_Math" alttext="\bm{\alpha}^{*}\in\argmax_{\bm{\alpha}}\frac{a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1}}{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{M}\bm{\alpha}}}=\argmax_{\bm{\alpha}}g(\bm{\alpha})" display="block" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>𝜶</mi></msub><mo>⁡</mo><mfrac><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>1</mn></msub></mrow></mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>M</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow></msqrt></mfrac></mrow><mo>=</mo><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>𝜶</mi></msub><mo>⁡</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜶</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\alpha}^{*}\in\argmax_{\bm{\alpha}}\frac{a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1}}{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{M}\bm{\alpha}}}=\argmax_{\bm{\alpha}}g(\bm{\alpha})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.p2" class="ltx_para ltx_noindent">
<p id="A4.SS3.p2.1" class="ltx_p">We compute the gradient of <math id="A4.SS3.p2.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> with respect to <math id="A4.SS3.p2.m2" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math> to find the extremum values of these mixing parameters:</p>
<table id="A4.Ex310" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex310.m1" class="ltx_Math" alttext="\nabla_{\alpha}g(\bm{\alpha})=\frac{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}\tilde{\mathbf{M}}\bm{\alpha}}\,\ {\bm{v}}_{1}-(a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1})\frac{{\bm{v}}_{2}+2\tilde{\mathbf{M}}\bm{\alpha}}{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}}}}{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>α</mi></msub><mi>g</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜶</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mi>𝜶</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow></msqrt><mo lspace="0.670em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>𝒗</mi><mn>2</mn></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow></msqrt></mfrac></mrow></mrow><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\nabla_{\alpha}g(\bm{\alpha})=\frac{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}\tilde{\mathbf{M}}\bm{\alpha}}\,\ {\bm{v}}_{1}-(a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1})\frac{{\bm{v}}_{2}+2\tilde{\mathbf{M}}\bm{\alpha}}{\sqrt{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}}}}{a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.p3" class="ltx_para ltx_noindent">
<p id="A4.SS3.p3.1" class="ltx_p">Thus the roots <math id="A4.SS3.p3.m1" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math> of <math id="A4.SS3.p3.m2" class="ltx_Math" alttext="\nabla g(\bm{\alpha})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>g</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜶</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla g(\bm{\alpha})</annotation></semantics></math> satisfy the following equation:</p>
<table id="A4.Ex311" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex311.m1" class="ltx_Math" alttext="\boxed{(a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}){\bm{v}}_{1}-(a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1})({\bm{v}}_{2}+2\tilde{\mathbf{M}}\bm{\alpha})=0}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>1</mn></msub></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mrow><msup><mi>𝜶</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒗</mi><mn>2</mn></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝐌</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝜶</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow></menclose><annotation encoding="application/x-tex">\boxed{(a_{2}+\bm{\alpha}^{\top}{\bm{v}}_{2}+\bm{\alpha}^{\top}\tilde{\mathbf{M}}\bm{\alpha}){\bm{v}}_{1}-(a_{1}+\bm{\alpha}^{\top}{\bm{v}}_{1})({\bm{v}}_{2}+2\tilde{\mathbf{M}}\bm{\alpha})=0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>LLMs Experimental details</h2>

<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p">The pseudo-code algorithm for training with <math id="A5.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>-LoRA is given as follows in <a href="#alg1" title="Algorithm 1 ‣ Appendix E LLMs Experimental details ‣ 𝛼-LoRA: Effective Fine-Tuning via Base Model Rescaling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.4" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> <math id="alg1.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="alg1.5" class="ltx_text ltx_font_smallcaps">-LoRA Fine-Tuning</span></figcaption>
<div id="alg1.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">0:</span>
            
            
           Base model weights <math id="alg1.l0.m1" class="ltx_Math" alttext="\{{\mathbf{W}}^{*}_{i}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐖</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{{\mathbf{W}}^{*}_{i}\}_{i=1}^{N}</annotation></semantics></math>,
fine-tuning dataset <math id="alg1.l0.m2" class="ltx_Math" alttext="{\mathcal{D}}=\{B_{j}\}_{j=1}^{b}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>B</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{D}}=\{B_{j}\}_{j=1}^{b}</annotation></semantics></math> divided into batches,
update period <math id="alg1.l0.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>,
optimizers <span id="alg1.l0.2" class="ltx_text ltx_font_typewriter">optim</span> (for LoRA modules) and <span id="alg1.l0.3" class="ltx_text ltx_font_typewriter">optim_alpha</span> (for <math id="alg1.l0.m4" class="ltx_Math" alttext="\bm{\alpha}=\{\alpha_{i}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>𝜶</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></mrow><annotation encoding="application/x-tex">\bm{\alpha}=\{\alpha_{i}\}_{i=1}^{N}</annotation></semantics></math>),
number of epochs <math id="alg1.l0.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.

</div>
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
           <span id="alg1.l1.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l1.m1" class="ltx_Math" alttext="k=1\dots n" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">k=1\dots n</annotation></semantics></math> <span id="alg1.l1.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
            <span id="alg1.l2.2" class="ltx_text ltx_font_bold">for</span> batch <math id="alg1.l2.m1" class="ltx_Math" alttext="B_{j}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>j</mi></msub><annotation encoding="application/x-tex">B_{j}</annotation></semantics></math> in <math id="alg1.l2.m2" class="ltx_Math" alttext="{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">{\mathcal{D}}</annotation></semantics></math> <span id="alg1.l2.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
             Update LoRA modules <math id="alg1.l3.m1" class="ltx_Math" alttext="\{(A_{i},B_{i})\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo>,</mo><msub><mi>B</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{(A_{i},B_{i})\}_{i=1}^{N}</annotation></semantics></math> with a gradient step on <math id="alg1.l3.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> using <span id="alg1.l3.2" class="ltx_text ltx_font_typewriter">optim</span>.

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
             <span id="alg1.l4.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="j\bmod T=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>mod</mo><mi>T</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\bmod T=0</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
              Sample a fresh batch <math id="alg1.l5.m1" class="ltx_Math" alttext="B_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>α</mi></msub><annotation encoding="application/x-tex">B_{\alpha}</annotation></semantics></math> from <math id="alg1.l5.m2" class="ltx_Math" alttext="{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">{\mathcal{D}}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
              Update <math id="alg1.l6.m1" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math> with a gradient step on <math id="alg1.l6.m2" class="ltx_Math" alttext="B_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>α</mi></msub><annotation encoding="application/x-tex">B_{\alpha}</annotation></semantics></math> using <span id="alg1.l6.2" class="ltx_text ltx_font_typewriter">optim_alpha</span>.

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
             <span id="alg1.l7.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
            <span id="alg1.l8.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
           <span id="alg1.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Hyperparameters</h3>

<div id="A5.SS1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.p1.1" class="ltx_p">In this section, we summarize all the details about our experiments on Fine-tuning <span id="A5.SS1.p1.1.1" class="ltx_text ltx_font_typewriter">roberta-base</span> model on GLUE tasks. Let us define some notations first then give their corresponding values in each experiment: <span id="A5.SS1.p1.1.2" class="ltx_text ltx_font_typewriter">lora_r</span> denotes the rank of LoRA modules, <span id="A5.SS1.p1.1.3" class="ltx_text ltx_font_typewriter">lora_alpha</span> denotes the LoRA scaling parameter, <span id="A5.SS1.p1.1.4" class="ltx_text ltx_font_typewriter">lr_adapter</span> means the learning rate used to train LoRA modules, <span id="A5.SS1.p1.1.5" class="ltx_text ltx_font_typewriter">batch_size</span> and <span id="A5.SS1.p1.1.6" class="ltx_text ltx_font_typewriter">batch_alpha</span> is the training batch size for LoRA modules and the vectors <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math> respectively, <span id="A5.SS1.p1.1.7" class="ltx_text ltx_font_typewriter">lr_alpha</span> is the learning rate used to update <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math>, <span id="A5.SS1.p1.1.8" class="ltx_text ltx_font_typewriter">optim_alpha</span> is the optimizer used to train the vectors <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math>, <span id="A5.SS1.p1.1.9" class="ltx_text ltx_font_typewriter">val_split</span> is the percentage of the training set used to train <math id="A5.SS1.p1.m4" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math>.</p>
</div>
<section id="A5.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Common to all experiments.</h4>

<div id="A5.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.SSS0.Px1.p1.1" class="ltx_p">We optimize the LoRA modules using <span id="A5.SS1.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_typewriter">AdamW</span> for all the benchmarks and with a linear scheduler for the learning rate. We initialize the vectors <math id="A5.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\bm{\alpha}" display="inline" intent=":literal"><semantics><mi>𝜶</mi><annotation encoding="application/x-tex">\bm{\alpha}</annotation></semantics></math> to the vector <math id="A5.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\bm{1}" display="inline" intent=":literal"><semantics><mn>𝟏</mn><annotation encoding="application/x-tex">\bm{1}</annotation></semantics></math>. The target modules are: the final classifier layer <span id="A5.SS1.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_typewriter">classifier</span> (full training) and the attention modules <span id="A5.SS1.SSS0.Px1.p1.1.3" class="ltx_text ltx_font_typewriter">query</span> and <span id="A5.SS1.SSS0.Px1.p1.1.4" class="ltx_text ltx_font_typewriter">value</span> (Low Rank Adaptation).</p>
</div>
<figure id="A5.T3" class="ltx_table">
<table id="A5.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A5.T3.2.1" class="ltx_tr">
<th id="A5.T3.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.1.1.1" class="ltx_text ltx_font_bold">Parameter</span></th>
<td id="A5.T3.2.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="A5.T3.2.1.2.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="A5.T3.2.2" class="ltx_tr">
<th id="A5.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.2.1.1" class="ltx_text ltx_font_typewriter">optimizer</span></th>
<td id="A5.T3.2.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">AdamW</td></tr>
<tr id="A5.T3.2.3" class="ltx_tr">
<th id="A5.T3.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" colspan="2"><span id="A5.T3.2.3.1.1" class="ltx_text ltx_font_bold">LoRA Arguments</span></th></tr>
<tr id="A5.T3.2.4" class="ltx_tr">
<th id="A5.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.4.1.1" class="ltx_text ltx_font_typewriter">lora_r</span></th>
<td id="A5.T3.2.4.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">8</td></tr>
<tr id="A5.T3.2.5" class="ltx_tr">
<th id="A5.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.5.1.1" class="ltx_text ltx_font_typewriter">lora_alpha</span></th>
<td id="A5.T3.2.5.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">8</td></tr>
<tr id="A5.T3.2.6" class="ltx_tr">
<th id="A5.T3.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.6.1.1" class="ltx_text ltx_font_typewriter">lr_adapter</span></th>
<td id="A5.T3.2.6.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="A5.T3.m1" class="ltx_Math" alttext="10^{-4}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup><annotation encoding="application/x-tex">10^{-4}</annotation></semantics></math></td></tr>
<tr id="A5.T3.2.7" class="ltx_tr">
<th id="A5.T3.2.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" colspan="2"><span id="A5.T3.2.7.1.1" class="ltx_text ltx_font_bold">Trainer Arguments</span></th></tr>
<tr id="A5.T3.2.8" class="ltx_tr">
<th id="A5.T3.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.8.1.1" class="ltx_text ltx_font_typewriter">n_epochs</span></th>
<td id="A5.T3.2.8.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">10</td></tr>
<tr id="A5.T3.2.9" class="ltx_tr">
<th id="A5.T3.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.9.1.1" class="ltx_text ltx_font_typewriter">batch_size</span></th>
<td id="A5.T3.2.9.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">64</td></tr>
<tr id="A5.T3.2.10" class="ltx_tr">
<th id="A5.T3.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.10.1.1" class="ltx_text ltx_font_typewriter">optim_alpha</span></th>
<td id="A5.T3.2.10.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">AdamW</td></tr>
<tr id="A5.T3.2.11" class="ltx_tr">
<th id="A5.T3.2.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.11.1.1" class="ltx_text ltx_font_typewriter">batch_alpha</span></th>
<td id="A5.T3.2.11.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">64</td></tr>
<tr id="A5.T3.2.12" class="ltx_tr">
<th id="A5.T3.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="A5.T3.2.12.1.1" class="ltx_text ltx_font_typewriter">lr_alpha</span></th>
