<th id="S4.T4.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.4.1.4.1" class="ltx_text ltx_font_bold">Motion Quality</span></th>
<th id="S4.T4.4.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.4.1.5.1" class="ltx_text ltx_font_bold">Text Alignment</span></th>
<th id="S4.T4.4.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.4.1.6.1" class="ltx_text ltx_font_bold">Overall</span></th></tr>
