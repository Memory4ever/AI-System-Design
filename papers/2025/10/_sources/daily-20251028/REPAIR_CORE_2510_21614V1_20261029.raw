             Select node <math id="alg1.l10.m1" class="ltx_Math" alttext="a^{\star}=\arg\max_{a}S_{C}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mi>a</mi></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>S</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a^{\star}=\arg\max_{a}S_{C}(a)</annotation></semantics></math>

