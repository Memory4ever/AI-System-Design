</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
              Sample <math id="alg1.l8.m1" class="ltx_Math" alttext="S_{C}(a)\sim\text{Beta}(\tau(1+n^{C}_{\text{success}}(a)),\;\tau(1+n^{C}_{\text{failure}}(a)))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mtext>Beta</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msubsup><mi>n</mi><mtext>success</mtext><mi>C</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msubsup><mi>n</mi><mtext>failure</mtext><mi>C</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{C}(a)\sim\text{Beta}(\tau(1+n^{C}_{\text{success}}(a)),\;\tau(1+n^{C}_{\text{failure}}(a)))</annotation></semantics></math>

