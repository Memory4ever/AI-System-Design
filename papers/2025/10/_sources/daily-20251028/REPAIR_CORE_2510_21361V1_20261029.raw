            <span id="alg7.l10.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg7.l10.m1" class="ltx_Math" alttext="s_{i}\in G" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>∈</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">s_{i}\in G</annotation></semantics></math> <span id="alg7.l10.4" class="ltx_text ltx_font_bold">do</span>

