            <math id="alg5.l6.m1" class="ltx_Math" alttext="\text{expandedTrees}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mtext>expandedTrees</mtext><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\text{expandedTrees}\leftarrow 0</annotation></semantics></math>

</div>
<div id="alg5.l7" class="ltx_listingline">
