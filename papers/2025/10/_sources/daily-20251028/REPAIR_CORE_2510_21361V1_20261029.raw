<tr id="A1.T6.5.20" class="ltx_tr">
<td id="A1.T6.5.20.1" class="ltx_td ltx_align_left ltx_border_t">Embedding Dimension</td>
<td id="A1.T6.5.20.2" class="ltx_td ltx_align_left ltx_border_t">128</td></tr>
<tr id="A1.T6.5.21" class="ltx_tr">
<td id="A1.T6.5.21.1" class="ltx_td ltx_align_left">Number of Layers</td>
<td id="A1.T6.5.21.2" class="ltx_td ltx_align_left">12</td></tr>
<tr id="A1.T6.5.22" class="ltx_tr">
<td id="A1.T6.5.22.1" class="ltx_td ltx_align_left">Number of Attention Heads</td>
<td id="A1.T6.5.22.2" class="ltx_td ltx_align_left">4</td></tr>
<tr id="A1.T6.5.23" class="ltx_tr">
