<figure id="alg6" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg6.3" class="ltx_text ltx_font_bold">Algorithm 6</span> </span> Preplan Composer (PC) - Building Plan Graph</figcaption>
<div id="alg6.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg6.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <math id="alg6.l1.m1" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>: environment, <math id="alg6.l1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>: diffusion planner, <math id="alg6.l1.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>: plan horizon, <math id="alg6.l1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>: number of waypoints

</div>
<div id="alg6.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          Plan graph <math id="alg6.l2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> encoding environment connectivity

</div>
<div id="alg6.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          <span id="alg6.l3.3" class="ltx_text ltx_font_bold">procedure</span> <span id="alg6.l3.4" class="ltx_text ltx_font_smallcaps">BuildPlanGraph</span>(<math id="alg6.l3.m1" class="ltx_Math" alttext="\mathcal{E},D,H,N" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi>D</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">\mathcal{E},D,H,N</annotation></semantics></math>) <span id="alg6.l3.5" class="ltx_text" style="float:right;"><math id="alg6.l3.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Pre-building phase
</span>
</div>
<div id="alg6.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <math id="alg6.l4.m1" class="ltx_Math" alttext="S\leftarrow\text{SelectWaypoints}(\mathcal{E},N)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">←</mo><mrow><mtext>SelectWaypoints</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\leftarrow\text{SelectWaypoints}(\mathcal{E},N)</annotation></semantics></math> <span id="alg6.l4.3" class="ltx_text" style="float:right;"><math id="alg6.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Identify <math id="alg6.l4.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> strategic waypoints
</span>
</div>
<div id="alg6.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            <math id="alg6.l5.m1" class="ltx_Math" alttext="G\leftarrow(S,\emptyset)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G\leftarrow(S,\emptyset)</annotation></semantics></math> <span id="alg6.l5.3" class="ltx_text" style="float:right;"><math id="alg6.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize plan graph
</span>
</div>
<div id="alg6.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
            <span id="alg6.l6.3" class="ltx_text ltx_font_bold">for</span> each pair <math id="alg6.l6.m1" class="ltx_Math" alttext="(s_{i},s_{j})\in S\times S" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>s</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">(s_{i},s_{j})\in S\times S</annotation></semantics></math> where <math id="alg6.l6.m2" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math> <span id="alg6.l6.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg6.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg6.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
