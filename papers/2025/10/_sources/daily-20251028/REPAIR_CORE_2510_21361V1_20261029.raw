<figure id="alg7" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg7.3" class="ltx_text ltx_font_bold">Algorithm 7</span> </span> Preplan Composer - Inference</figcaption>
<div id="alg7.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg7.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg7.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <math id="alg7.l1.m1" class="ltx_Math" alttext="s_{\text{start}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mtext>start</mtext></msub><annotation encoding="application/x-tex">s_{\text{start}}</annotation></semantics></math>: start state, <math id="alg7.l1.m2" class="ltx_Math" alttext="s_{\text{goal}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mtext>goal</mtext></msub><annotation encoding="application/x-tex">s_{\text{goal}}</annotation></semantics></math>: goal state, <math id="alg7.l1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>: prebuilt plan graph, <math id="alg7.l1.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>: diffusion planner, <math id="alg7.l1.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>: plan horizon, <math id="alg7.l1.m6" class="ltx_Math" alttext="L^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mo>′</mo></msup><annotation encoding="application/x-tex">L^{\prime}</annotation></semantics></math>: local path horizon, <math id="alg7.l1.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>: full-plan horizon

</div>
<div id="alg7.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg7.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
