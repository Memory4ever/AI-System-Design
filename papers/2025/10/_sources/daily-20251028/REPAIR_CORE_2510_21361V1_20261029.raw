<figure id="alg5" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg5.3" class="ltx_text ltx_font_bold">Algorithm 5</span> </span> Distributed Composer (DC)</figcaption>
<div id="alg5.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg5.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <math id="alg5.l1.m1" class="ltx_Math" alttext="s_{\text{start}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mtext>start</mtext></msub><annotation encoding="application/x-tex">s_{\text{start}}</annotation></semantics></math>: start state, <math id="alg5.l1.m2" class="ltx_Math" alttext="s_{\text{goal}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mtext>goal</mtext></msub><annotation encoding="application/x-tex">s_{\text{goal}}</annotation></semantics></math>: goal state, <math id="alg5.l1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>: diffusion planner, <math id="alg5.l1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>: plan horizon, <math id="alg5.l1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>: full-plan horizon, <math id="alg5.l1.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>: expansion budget, <math id="alg5.l1.m7" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>: number of origin positions

</div>
<div id="alg5.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          A full trajectory <math id="alg5.l2.m1" class="ltx_Math" alttext="\tau_{\text{full}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mtext>full</mtext></msub><annotation encoding="application/x-tex">\tau_{\text{full}}</annotation></semantics></math> from <math id="alg5.l2.m2" class="ltx_Math" alttext="s_{\text{start}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mtext>start</mtext></msub><annotation encoding="application/x-tex">s_{\text{start}}</annotation></semantics></math> to <math id="alg5.l2.m3" class="ltx_Math" alttext="s_{\text{goal}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mtext>goal</mtext></msub><annotation encoding="application/x-tex">s_{\text{goal}}</annotation></semantics></math> or failure

</div>
<div id="alg5.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          <span id="alg5.l3.3" class="ltx_text ltx_font_bold">procedure</span> <span id="alg5.l3.4" class="ltx_text ltx_font_smallcaps">Distributed Composer</span>(<math id="alg5.l3.m1" class="ltx_Math" alttext="s_{\text{start}},s_{\text{goal}},D,H,L,B,N" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mtext>start</mtext></msub><mo>,</mo><msub><mi>s</mi><mtext>goal</mtext></msub><mo>,</mo><mi>D</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">s_{\text{start}},s_{\text{goal}},D,H,L,B,N</annotation></semantics></math>)

</div>
<div id="alg5.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <math id="alg5.l4.m1" class="ltx_Math" alttext="\mathcal{S}\leftarrow\{s_{\text{start}}\}\cup\text{SamplePositions}(N-1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">{</mo><msub><mi>s</mi><mtext>start</mtext></msub><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mtext>SamplePositions</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}\leftarrow\{s_{\text{start}}\}\cup\text{SamplePositions}(N-1)</annotation></semantics></math> <span id="alg5.l4.3" class="ltx_text" style="float:right;"><math id="alg5.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg5.l4.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> origin positions
</span>
</div>
<div id="alg5.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            <math id="alg5.l5.m1" class="ltx_Math" alttext="G\leftarrow(\mathcal{S},\emptyset)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G\leftarrow(\mathcal{S},\emptyset)</annotation></semantics></math> <span id="alg5.l5.3" class="ltx_text" style="float:right;"><math id="alg5.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initialize connectivity graph
