<td id="S5.T2.7.1.5.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T2.7.1.5.3.1" class="ltx_text ltx_markedasmath ltx_font_bold">21.5</span><math id="S5.T2.m30" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080" mathsize="0.700em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S5.T2.7.1.5.3.2" class="ltx_text" style="font-size:70%;--ltx-fg-color:#808080;"> 0.4</span></td>
