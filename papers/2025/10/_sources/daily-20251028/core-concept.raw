<span id="S7.F5.3.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:57.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:57.2pt;transform:translate(-25.2pt,-25.2pt) rotate(-90deg) ;">
<span id="S7.F5.3.3.1.1.1.1" class="ltx_p"><span id="S7.F5.3.3.1.1.1.1.1" class="ltx_text ltx_font_bold">Normalised</span></span>
</span></span></span></td>
<td id="S7.F5.3.3.2" class="ltx_td ltx_align_center"></td>
<td id="S7.F5.3.3.3" class="ltx_td ltx_align_center"></td></tr>
</tbody>
</table></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S7.F5.fig1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.22362v1/figures/hate/hate_viol_easy_unnorm.png" id="S7.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/271;" width="476" height="271" alt="Refer to caption">
