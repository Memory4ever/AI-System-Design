<span id="S4.T1.5.10.1.1.1" class="ltx_p ltx_align_center"><math id="S4.T1.m12" class="ltx_Math" alttext="M^{\text{peak}}_{jid}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-bg-color:#FEFED9;" mathbackground="#FEFED9">M</mi><mrow><mi style="--ltx-bg-color:#FEFED9;" mathbackground="#FEFED9">j</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FEFED9;" mathbackground="#FEFED9">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#FEFED9;" mathbackground="#FEFED9">d</mi></mrow><mtext style="--ltx-bg-color:#FEFED9;" mathbackground="#FEFED9">peak</mtext></msubsup><annotation encoding="application/x-tex">M^{\text{peak}}_{jid}</annotation></semantics></math></span>
</span></td>
