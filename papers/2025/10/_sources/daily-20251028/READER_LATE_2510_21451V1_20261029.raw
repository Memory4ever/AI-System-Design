<td id="S4.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t">16</td>
<td id="S4.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t">22</td></tr>
<tr id="S4.T6.2.3" class="ltx_tr">
<td id="S4.T6.2.3.1" class="ltx_td ltx_align_center"><math id="S4.T6.m2" class="ltx_Math" alttext="Scalpel_{c}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>l</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">Scalpel_{c}</annotation></semantics></math></td>
<td id="S4.T6.2.3.2" class="ltx_td ltx_align_center">7</td>
<td id="S4.T6.2.3.3" class="ltx_td ltx_align_center">16</td></tr>
<tr id="S4.T6.2.4" class="ltx_tr">
<td id="S4.T6.2.4.1" class="ltx_td ltx_align_center"><math id="S4.T6.m3" class="ltx_Math" alttext="Scalpel_{o}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>l</mi><mi>o</mi></msub></mrow><annotation encoding="application/x-tex">Scalpel_{o}</annotation></semantics></math></td>
<td id="S4.T6.2.4.2" class="ltx_td ltx_align_center">8</td>
<td id="S4.T6.2.4.3" class="ltx_td ltx_align_center">13</td></tr>
<tr id="S4.T6.2.5" class="ltx_tr">
<td id="S4.T6.2.5.1" class="ltx_td ltx_align_center ltx_border_b"><math id="S4.T6.m4" class="ltx_Math" alttext="Random" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">Random</annotation></semantics></math></td>
