<td id="S3.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.2.4.2.1" class="ltx_text"></span> <span id="S3.T1.2.4.2.2" class="ltx_text">
<span id="S3.T1.2.4.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.2.4.2.2.1.1" class="ltx_tr">
