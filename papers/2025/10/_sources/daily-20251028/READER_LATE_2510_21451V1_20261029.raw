<td id="S4.T5.2.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.2.1.2.1" class="ltx_text ltx_font_bold">Operator Coverage</span></td>
<td id="S4.T5.2.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.2.1.3.1" class="ltx_text ltx_font_bold">Component Coverage</span></td></tr>
