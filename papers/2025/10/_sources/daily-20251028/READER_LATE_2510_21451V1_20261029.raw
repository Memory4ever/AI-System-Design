<tr id="S4.T5.2.4" class="ltx_tr">
<td id="S4.T5.2.4.1" class="ltx_td ltx_align_center">Muffin</td>
<td id="S4.T5.2.4.2" class="ltx_td ltx_align_center">60.71%</td>
<td id="S4.T5.2.4.3" class="ltx_td ltx_align_center">0%</td></tr>
<tr id="S4.T5.2.5" class="ltx_tr">
