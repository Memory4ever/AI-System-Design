<span id="S3.T2.6.6.3.1.1" class="ltx_p ltx_align_right"><math id="S3.T2.m5" class="ltx_Math" alttext="46\,186" display="inline" intent=":literal"><semantics><mn>46 186</mn><annotation encoding="application/x-tex">46\,186</annotation></semantics></math></span>
</span></td></tr>
