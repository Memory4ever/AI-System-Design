</span></td>
<td id="S2.T1.6.7.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T1.6.7.2.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="S2.T1.6.7.2.1.1" class="ltx_p"><math id="S2.T1.m2" class="ltx_Math" alttext="3\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.700em">3</mn><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><msup><mn mathsize="0.700em">10</mn><mrow><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3\times 10^{-4}</annotation></semantics></math></span>
</span></td></tr>
<tr id="S2.T1.6.8" class="ltx_tr">
<td id="S2.T1.6.8.1" class="ltx_td ltx_align_center ltx_align_top" colspan="2"><span id="S2.T1.6.8.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Model and PEFT Configuration</span></td></tr>
<tr id="S2.T1.6.9" class="ltx_tr">
<td id="S2.T1.6.9.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S2.T1.6.9.1.1" class="ltx_inline-block ltx_align_top" style="width:44.1pt;">
<span id="S2.T1.6.9.1.1.1" class="ltx_p"><span id="S2.T1.6.9.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Base model</span></span>
</span></td>
<td id="S2.T1.6.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S2.T1.6.9.2.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="S2.T1.6.9.2.1.1" class="ltx_p"><span id="S2.T1.6.9.2.1.1.1" class="ltx_text" style="font-size:70%;">CodeLlama2-7B</span></span>
</span></td></tr>
<tr id="S2.T1.6.10" class="ltx_tr">
<td id="S2.T1.6.10.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T1.6.10.1.1" class="ltx_inline-block ltx_align_top" style="width:44.1pt;">
<span id="S2.T1.6.10.1.1.1" class="ltx_p"><span id="S2.T1.6.10.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">LoRA</span></span>
</span></td>
<td id="S2.T1.6.10.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T1.6.10.2.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="S2.T1.6.10.2.1.1" class="ltx_p"><span id="S2.T1.6.10.2.1.1.1" class="ltx_text" style="font-size:70%;">rank </span><math id="S2.T1.m3" class="ltx_Math" alttext="r{=}8" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">r</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">8</mn></mrow><annotation encoding="application/x-tex">r{=}8</annotation></semantics></math><span id="S2.T1.6.10.2.1.1.2" class="ltx_text" style="font-size:70%;">, </span><math id="S2.T1.m4" class="ltx_Math" alttext="\alpha{=}16" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">α</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">16</mn></mrow><annotation encoding="application/x-tex">\alpha{=}16</annotation></semantics></math><span id="S2.T1.6.10.2.1.1.3" class="ltx_text" style="font-size:70%;">; injected in attention Q/V projections</span></span>
</span></td></tr>
<tr id="S2.T1.6.11" class="ltx_tr">
<td id="S2.T1.6.11.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T1.6.11.1.1" class="ltx_inline-block ltx_align_top" style="width:44.1pt;">
<span id="S2.T1.6.11.1.1.1" class="ltx_p"><span id="S2.T1.6.11.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Context length</span></span>
</span></td>
<td id="S2.T1.6.11.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T1.6.11.2.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="S2.T1.6.11.2.1.1" class="ltx_p"><math id="S2.T1.m5" class="ltx_Math" alttext="4096" display="inline" intent=":literal"><semantics><mn mathsize="0.700em">4096</mn><annotation encoding="application/x-tex">4096</annotation></semantics></math><span id="S2.T1.6.11.2.1.1.1" class="ltx_text" style="font-size:70%;"> tokens</span></span>
</span></td></tr>
<tr id="S2.T1.6.12" class="ltx_tr">
<td id="S2.T1.6.12.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S2.T1.6.12.1.1" class="ltx_inline-block ltx_align_top" style="width:44.1pt;">
<span id="S2.T1.6.12.1.1.1" class="ltx_p"><span id="S2.T1.6.12.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Infilling mode</span></span>
</span></td>
<td id="S2.T1.6.12.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S2.T1.6.12.2.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="S2.T1.6.12.2.1.1" class="ltx_p"><span id="S2.T1.6.12.2.1.1.1" class="ltx_text" style="font-size:70%;">Fill-in-the-Middle (FIM) with </span><span id="S2.T1.6.12.2.1.1.2" class="ltx_text ltx_font_typewriter" style="font-size:70%;">&lt;FILL_ME&gt;</span></span>
</span></td></tr>
