<span id="S5.T4.8.13.3.1.1.3.1" class="ltx_inline-block ltx_align_middle" style="width:13.0pt;">
<span id="S5.T4.8.13.3.1.1.3.1.1" class="ltx_p ltx_align_center"><span id="S5.T4.8.13.3.1.1.3.1.1.1" class="ltx_text" style="font-size:80%;">22</span></span>
</span></td></tr>
</table></td>
