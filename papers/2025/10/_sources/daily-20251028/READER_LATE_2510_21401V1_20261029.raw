</div>
<div id="lstnumberx12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12</span>
              
              
              
              
              
              
              
            <span id="lstnumberx12.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">  </span><span id="lstnumberx12.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#0000FF;">return</span><span id="lstnumberx12.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx12.5" class="ltx_text ltx_lst_keywords4 ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#008000;">true</span><span id="lstnumberx12.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;">;</span>
</div>
