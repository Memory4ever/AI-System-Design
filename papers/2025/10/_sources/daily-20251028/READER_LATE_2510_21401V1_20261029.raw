<span id="S2.T1.6.6.2.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
<span id="S2.T1.6.6.2.1.1" class="ltx_p"><span id="S2.T1.6.6.2.1.1.1" class="ltx_text" style="font-size:70%;">1 (for both </span><span id="S2.T1.6.6.2.1.1.2" class="ltx_text ltx_font_smallcaps" style="font-size:70%;">Flames</span><span id="S2.T1.6.6.2.1.1.3" class="ltx_text" style="font-size:70%;">-20k and </span><span id="S2.T1.6.6.2.1.1.4" class="ltx_text ltx_font_smallcaps" style="font-size:70%;">Flames</span><span id="S2.T1.6.6.2.1.1.5" class="ltx_text" style="font-size:70%;">-100k)</span></span>
