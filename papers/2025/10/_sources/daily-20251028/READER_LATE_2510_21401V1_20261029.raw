            <span id="lstnumberx34.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">      </span><span id="lstnumberx34.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">balances</span><span id="lstnumberx34.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">[</span><span id="lstnumberx34.5" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#800080;">msg</span><span id="lstnumberx34.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.</span><span id="lstnumberx34.7" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#800080;">sender</span><span id="lstnumberx34.8" class="ltx_text ltx_font_typewriter" style="font-size:70%;">]</span><span id="lstnumberx34.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx34.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;">-=</span><span id="lstnumberx34.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx34.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">_am</span><span id="lstnumberx34.13" class="ltx_text ltx_font_typewriter" style="font-size:70%;">;</span>
