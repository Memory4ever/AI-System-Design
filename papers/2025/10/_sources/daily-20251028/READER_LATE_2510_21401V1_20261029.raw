tx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx9.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">_value</span><span id="lstnumberx9.21" class="ltx_text ltx_font_typewriter" style="font-size:70%;">);</span>
</div>
