<tr id="S5.T4.8.2.2.1.1" class="ltx_tr">
<td id="S5.T4.8.2.2.1.1.1" class="ltx_td ltx_align_left ltx_align_middle" style="padding-left:0.0pt;padding-right:0.0pt;">
<table id="S5.T4.8.2.2.1.1.1.1" class="ltx_tabular ltx_centering ltx_align_middle" style="width:13.0pt;">
<tr id="S5.T4.8.2.2.1.1.1.1.1" class="ltx_tr">
<td id="S5.T4.8.2.2.1.1.1.1.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-4.25pt 0.0pt;"><span id="S5.T4.8.2.2.1.1.1.1.1.1.1" class="ltx_text ltx_align_center ltx_inline-block" style="font-size:80%;width:3.4pt;--ltx-bg-color:#CFD9F8;"><math id="S5.T4.m5" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#CFD9F8;" mathbackground="#CFD9F8" mathcolor="#000000">∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math></span></td></tr>
<tr id="S5.T4.8.2.2.1.1.1.1.2" class="ltx_tr">
<td id="S5.T4.8.2.2.1.1.1.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-4.25pt 0.0pt;"><span id="S5.T4.8.2.2.1.1.1.1.2.1.1" class="ltx_text ltx_phantom ltx_align_center" style="font-size:80%;width:3.4pt;--ltx-bg-color:#C8E2C8;"><span style="visibility:hidden"><math id="S5.T4.m6" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#C8E2C8;" mathbackground="#C8E2C8">∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math></span></span></td></tr>
</table></td>
<td id="S5.T4.8.2.2.1.1.2" class="ltx_td ltx_align_left ltx_align_middle" style="padding-left:0.0pt;padding-right:0.0pt;">
