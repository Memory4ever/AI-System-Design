<span id="S3.T2.6.4.3.1.1" class="ltx_p ltx_align_right"><math id="S3.T2.m3" class="ltx_Math" alttext="144\,857" display="inline" intent=":literal"><semantics><mn>144 857</mn><annotation encoding="application/x-tex">144\,857</annotation></semantics></math></span>
</span></td></tr>
<tr id="S3.T2.6.5" class="ltx_tr">
<td id="S3.T2.6.5.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.25pt;padding-bottom:0.25pt;">
<span id="S3.T2.6.5.1.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
