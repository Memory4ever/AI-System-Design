            <span id="lstnumberx4.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">  </span><span id="lstnumberx4.3" class="ltx_text ltx_lst_keywords2 ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#008080;">uint256</span><span id="lstnumberx4.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">amount</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx4.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.9" class="ltx_text ltx_lst_keywords2 ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#008080;">uint256</span><span id="lstnumberx4.10" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx4.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">cnt</span><span id="lstnumberx4.12" class="ltx_text ltx_font_typewriter" style="font-size:70%;">)</span><span id="lstnumberx4.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.14" class="ltx_text ltx_font_typewriter" style="font-size:70%;">*</span><span id="lstnumberx4.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx4.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">_value</span><span id="lstnumberx4.17" class="ltx_text ltx_font_typewriter" style="font-size:70%;">;</span>
</div>
<div id="lstnumberx5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5</span>
              
              
              
              
              
              
              
            <span id="lstnumberx5.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">  </span><span id="lstnumberx5.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;--ltx-fg-color:#0000FF;">require</span><span id="lstnumberx5.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx5.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">cnt</span><span id="lstnumberx5.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx5.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;">&gt;</span><span id="lstnumberx5.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx5.9" class="ltx_text ltx_font_typewriter" style="font-size:70%;">0</span><span id="lstnumberx5.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx5.11" class="ltx_text ltx_font_typewriter" style="font-size:70%;">&amp;&amp;</span><span id="lstnumberx5.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx5.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">cnt</span><span id="lstnumberx5.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx5.15" class="ltx_text ltx_font_typewriter" style="font-size:70%;">&lt;=</span><span id="lstnumberx5.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx5.17" class="ltx_text ltx_font_typewriter" style="font-size:70%;">20);</span>
</div>
<div id="lstnumberx6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6</span>
              
              
              
              
              
              
              
