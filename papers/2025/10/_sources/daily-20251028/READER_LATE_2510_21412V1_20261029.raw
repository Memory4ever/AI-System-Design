<th id="S5.T6.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">21.1</th>
<td id="S5.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">44.72</td></tr>
