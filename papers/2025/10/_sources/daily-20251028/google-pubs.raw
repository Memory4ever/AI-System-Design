          <a class="row-card__heading glue-link" href=https://research.google/pubs/calibrating-trustworthiness-in-genai/ >
            
              Calibrating Trustworthiness in GenAI 
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Allison Woodruff
                      
                    </div>
                
              
            
              
                
                  
