{"data":{"id":"10.48550/arxiv.2510.22235","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.22235","prefix":"10.48550","suffix":"arxiv.2510.22235","identifiers":[{"identifier":"2510.22235","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.22235"}],"creators":[{"name":"Nie, Yixiao","nameType":"Personal","givenName":"Yixiao","familyName":"Nie","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yang","nameType":"Personal","givenName":"Yang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Jin, Yingjie","nameType":"Personal","givenName":"Yingjie","familyName":"Jin","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zhepeng","nameType":"Personal","givenName":"Zhepeng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xiu","nameType":"Personal","givenName":"Xiu","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xiang","nameType":"Personal","givenName":"Xiang","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CGoT: A Novel Inference Mechanism for Embodied Multi-Agent Systems Using Composable Graphs of Thoughts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-25T09:39:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:32:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The integration of self-driving cars and service robots is becoming increasingly prevalent across a wide array of fields, playing a crucial and expanding role in both industrial applications and everyday life. In parallel, the rapid advancements in Large Language Models (LLMs) have garnered substantial attention and interest within the research community. This paper introduces a novel vehicle-robot system that leverages the strengths of both autonomous vehicles and service robots. In our proposed system, two autonomous ego-vehicles transports service robots to locations within an office park, where they perform a series of tasks. The study explores the feasibility and potential benefits of incorporating LLMs into this system, with the aim of enhancing operational efficiency and maximizing the potential of the cooperative mechanisms between the vehicles and the robots. This paper proposes a novel inference mechanism which is called CGOT toward this type of system where an agent can carry another agent. Experimental results are presented to validate the performance of the proposed method.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.22235","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T03:10:32.000Z","registered":"2025-10-28T03:10:33.000Z","published":"2025","updated":"2025-10-28T03:10:33.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.22235","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}