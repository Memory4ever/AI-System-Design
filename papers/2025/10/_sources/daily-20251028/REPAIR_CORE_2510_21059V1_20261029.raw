<td id="S5.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="S5.T4.2.1.2.1" class="ltx_text ltx_font_bold">ESR ↑</span></td>
<td id="S5.T4.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="S5.T4.2.1.3.1" class="ltx_text ltx_font_bold">PC ↑</span></td>
<td id="S5.T4.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="S5.T4.2.1.4.1" class="ltx_text ltx_font_bold">RR ↑</span></td></tr>
<tr id="S5.T4.2.2" class="ltx_tr">
<td id="S5.T4.2.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;">IKE</td>
<td id="S5.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;">0.69</td>
<td id="S5.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;">0.52</td>
<td id="S5.T4.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="S5.T4.2.2.4.1" class="ltx_text ltx_font_bold">0.57</span></td></tr>
<tr id="S5.T4.2.3" class="ltx_tr">
<td id="S5.T4.2.3.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_l ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="S5.T4.2.3.1.1" class="ltx_text ltx_font_bold">DR-IKE</span></td>
<td id="S5.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:12.0pt;padding-right:12.0pt;"><span id="S5.T4.2.3.2.1" class="ltx_text ltx_font_bold">0.91</span></td>
