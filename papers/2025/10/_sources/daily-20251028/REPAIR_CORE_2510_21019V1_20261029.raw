<span id="S4.T1.3.1.3.1" class="ltx_inline-block ltx_align_top" style="width:139.1pt;">
<span id="S4.T1.3.1.3.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.3.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Methods</span></span>
</span></td></tr>
<tr id="S4.T1.3.2" class="ltx_tr">
<td id="S4.T1.3.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 4.0pt;padding:0.45pt 3.0pt;"><span id="S4.T1.3.2.1.1" class="ltx_inline-logical-block ltx_align_top" style="width:119.2pt;">
<span id="S4.T1.p1" class="ltx_para ltx_align_left ltx_noindent">
<span id="S4.T1.p1.1" class="ltx_p"><span id="S4.T1.p1.1.1" class="ltx_text"></span><span id="S4.T1.p1.1.2" class="ltx_text" style="font-size:80%;">
<span id="S4.T1.p1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.p1.1.2.1.1" class="ltx_tr">
<span id="S4.T1.p1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;"><span id="S4.T1.p1.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Prototype<cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T1.p1.1.2.1.1.1.1.1" class="ltx_text ltx_font_medium">[</span><a href="#bib.bib34" title="" class="ltx_ref">34</a><span id="S4.T1.p1.1.2.1.1.1.1.2" class="ltx_text ltx_font_medium">]</span></cite></span></span></span>
<span id="S4.T1.p1.1.2.1.2" class="ltx_tr">
<span id="S4.T1.p1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;">(nearest-centroid)</span></span>
</span></span><span id="S4.T1.p1.1.3" class="ltx_text"></span></span>
</span></span></td>
<td id="S4.T1.3.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 4.0pt;padding:0.45pt 3.0pt;"><span id="S4.T1.3.2.2.1" class="ltx_inline-logical-block ltx_align_top" style="width:233.5pt;">
<span id="S4.T1.p2" class="ltx_para ltx_align_left ltx_noindent">
<span id="S4.T1.p2.1" class="ltx_p"><span id="S4.T1.p2.1.1" class="ltx_text"></span><span id="S4.T1.p2.1.2" class="ltx_text" style="font-size:80%;">
<span id="S4.T1.p2.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.p2.1.2.1.1" class="ltx_tr">
<span id="S4.T1.p2.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;">Centroid: <math id="S4.T1.p2.m1" class="ltx_Math" alttext="c_{y}=\dfrac{1}{|D_{y}|}\sum\!f_{\theta}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>y</mi></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>D</mi><mi>y</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.037em">∑</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{y}=\dfrac{1}{|D_{y}|}\sum\!f_{\theta}(x)</annotation></semantics></math></span></span>
<span id="S4.T1.p2.1.2.1.2" class="ltx_tr">
<span id="S4.T1.p2.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;">Predict: <math id="S4.T1.p2.m2" class="ltx_Math" alttext="\hat{y}=\arg\min_{y}\|h-c_{y}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo mathsize="1.250em">^</mo></mover><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>min</mi><mi>y</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>h</mi><mo>−</mo><msub><mi>c</mi><mi>y</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{y}=\arg\min_{y}\|h-c_{y}\|^{2}</annotation></semantics></math></span></span>
</span></span><span id="S4.T1.p2.1.3" class="ltx_text"></span></span>
</span></span></td>
<td id="S4.T1.3.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="padding-bottom: 4.0pt;padding:0.45pt 3.0pt;"><span id="S4.T1.3.2.3.1" class="ltx_inline-logical-block ltx_align_top" style="width:139.1pt;">
<span id="S4.T1.p3" class="ltx_para ltx_align_left ltx_noindent">
<span id="S4.T1.p3.1" class="ltx_p"><span id="S4.T1.p3.1.1" class="ltx_text"></span><span id="S4.T1.p3.1.2" class="ltx_text" style="font-size:80%;">
<span id="S4.T1.p3.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.p3.1.2.1.1" class="ltx_tr">
<span id="S4.T1.p3.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 3.0pt;">SimpleCIL<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib53" title="" class="ltx_ref">53</a>]</cite></span></span>
