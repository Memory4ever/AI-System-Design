<td id="S5.T3.3.13.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T3.3.13.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">75.80</span></td>
