<figure id="S5.T3" class="ltx_table">
<div id="S5.T3.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:447.2pt;height:64.4pt;vertical-align:-30.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-33.3pt,4.8pt) scale(0.87044330164473,0.87044330164473) ;">
