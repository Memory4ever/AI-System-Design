<td id="S5.T2.5.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T2.m9" class="ltx_Math" alttext="2.92_{2.89}^{2.95}" display="inline" intent=":literal"><semantics><msubsup><mn>2.92</mn><mn>2.89</mn><mn>2.95</mn></msubsup><annotation encoding="application/x-tex">2.92_{2.89}^{2.95}</annotation></semantics></math></td>
<td id="S5.T2.5.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T2.m10" class="ltx_Math" alttext="1.059_{1.049}^{1.070}" display="inline" intent=":literal"><semantics><msubsup><mn>1.059</mn><mn>1.049</mn><mn>1.070</mn></msubsup><annotation encoding="application/x-tex">1.059_{1.049}^{1.070}</annotation></semantics></math></td>
<td id="S5.T2.5.2.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T2.m11" class="ltx_Math" alttext="1.16_{0.32}^{1.96}" display="inline" intent=":literal"><semantics><msubsup><mn>1.16</mn><mn>0.32</mn><mn>1.96</mn></msubsup><annotation encoding="application/x-tex">1.16_{0.32}^{1.96}</annotation></semantics></math></td></tr>
<tr id="S5.T2.5.3" class="ltx_tr">
