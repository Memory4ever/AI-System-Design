<td id="S5.T3.5.4.4" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T3.m20" class="ltx_Math" alttext="4.365_{4.144}^{4.583}" display="inline" intent=":literal"><semantics><msubsup><mn>4.365</mn><mn>4.144</mn><mn>4.583</mn></msubsup><annotation encoding="application/x-tex">4.365_{4.144}^{4.583}</annotation></semantics></math></td>
<td id="S5.T3.5.4.5" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T3.m21" class="ltx_Math" alttext="9.11_{4.57}^{13.18}" display="inline" intent=":literal"><semantics><msubsup><mn>9.11</mn><mn>4.57</mn><mn>13.18</mn></msubsup><annotation encoding="application/x-tex">9.11_{4.57}^{13.18}</annotation></semantics></math></td></tr>
