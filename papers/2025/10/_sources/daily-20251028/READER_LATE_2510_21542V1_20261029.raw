<th id="S5.T3.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">baseline</th>
<td id="S5.T3.5.5.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T3.m22" class="ltx_Math" alttext="0.048_{0.029}^{0.051}" display="inline" intent=":literal"><semantics><msubsup><mn>0.048</mn><mn>0.029</mn><mn>0.051</mn></msubsup><annotation encoding="application/x-tex">0.048_{0.029}^{0.051}</annotation></semantics></math></td>
