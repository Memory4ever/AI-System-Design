<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="Sx4.F3.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="Sx4.F3.sf3.4" class="ltx_text" style="font-size:90%;">Cup Catch *</span></figcaption>
