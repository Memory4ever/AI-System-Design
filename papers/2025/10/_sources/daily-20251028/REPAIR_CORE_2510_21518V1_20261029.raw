<span id="S5.T3.fig1.8.1.4.2.1.2" class="ltx_p">inhibition (<math id="S5.T3.m1" class="ltx_Math" alttext="k=16,\alpha=-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>16</mn></mrow><mo>,</mo><mrow><mi>α</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">k=16,\alpha=-1</annotation></semantics></math>)</span>
</span></td>
<td id="S5.T3.fig1.8.1.4.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top ltx_border_tt">
