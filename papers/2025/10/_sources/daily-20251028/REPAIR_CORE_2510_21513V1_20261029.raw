<td id="S4.T2.5.1.4.3" class="ltx_td ltx_nopad_r ltx_align_right">84<math id="S4.T2.m25" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math><span id="S4.T2.5.1.4.3.1" class="ltx_text ltx_phantom"><span style="visibility:hidden">1</span></span>87<sup id="S4.T2.5.1.4.3.2" class="ltx_sup"><span id="S4.T2.5.1.4.3.2.1" class="ltx_text ltx_font_italic">(-0.46)</span></sup></td>
<td id="S4.T2.5.1.4.4" class="ltx_td ltx_nopad_r ltx_align_right">80<math id="S4.T2.m27" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>122<sup id="S4.T2.5.1.4.4.1" class="ltx_sup"><span id="S4.T2.5.1.4.4.1.1" class="ltx_text ltx_font_italic">(+1.31)</span></sup></td></tr>
<tr id="S4.T2.5.1.5" class="ltx_tr">
<td id="S4.T2.5.1.5.1" class="ltx_td ltx_nopad_r ltx_align_left">Mistral</td>
<td id="S4.T2.5.1.5.2" class="ltx_td ltx_align_right">108<math id="S4.T2.m29" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>104<sup id="S4.T2.5.1.5.2.1" class="ltx_sup"><span id="S4.T2.5.1.5.2.1.1" class="ltx_text ltx_font_italic">(+0.21)</span></sup></td>
