<td id="S3.T1.5.7.4" class="ltx_td ltx_align_center"><math id="S3.T1.m6" class="ltx_Math" alttext="GM_{L}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">GM_{L}</annotation></semantics></math></td></tr>
