              <span id="alg4.l14.3" class="ltx_text ltx_font_bold">else</span> <span id="alg4.l14.4" class="ltx_text ltx_font_bold">if</span> <span id="alg4.l14.5" class="ltx_text ltx_font_typewriter">depth</span> <math id="alg4.l14.m1" class="ltx_Math" alttext="=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">=0</annotation></semantics></math> and <math id="alg4.l14.m2" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> = <span id="alg4.l14.6" class="ltx_text ltx_font_smallcaps">Classification</span> <span id="alg4.l14.7" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg4.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               <span id="alg4.l15.3" class="ltx_text ltx_font_typewriter">target</span> <math id="alg4.l15.m1" class="ltx_Math" alttext="\sim\mathcal{U}(\{0,\dots,N_{c}-1\})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>N</mi><mi>c</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sim\mathcal{U}(\{0,\dots,N_{c}-1\})</annotation></semantics></math>

