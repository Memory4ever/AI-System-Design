<th id="A3.T11.7.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A3.T11.7.1.2.1.1" class="ltx_text ltx_font_bold">Avg. Rank </span> <math id="A3.T11.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
