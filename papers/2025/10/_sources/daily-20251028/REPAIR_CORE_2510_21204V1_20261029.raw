            <span id="alg4.l10.3" class="ltx_text ltx_font_bold">function</span> <span id="alg4.l10.4" class="ltx_text ltx_font_smallcaps">RandDT</span>([<span id="alg4.l10.5" class="ltx_text ltx_font_typewriter">lb</span>, <span id="alg4.l10.6" class="ltx_text ltx_font_typewriter">ub</span>]=<span id="alg4.l10.7" class="ltx_text ltx_font_typewriter">thres-int</span>, <span id="alg4.l10.8" class="ltx_text ltx_font_typewriter">tree</span>=None, <span id="alg4.l10.9" class="ltx_text ltx_font_typewriter">depth</span>=0, <span id="alg4.l10.10" class="ltx_text ltx_font_typewriter">rs</span> = {}, <span id="alg4.l10.11" class="ltx_text ltx_font_typewriter">ind</span> = None)

</div>
