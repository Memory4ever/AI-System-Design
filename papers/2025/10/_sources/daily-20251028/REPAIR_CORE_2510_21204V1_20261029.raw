<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.3" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Construct Random Decision Tree (DT)</figcaption>
<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Feature dimension <math id="alg4.l1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, number of classes <math id="alg4.l1.m2" class="ltx_Math" alttext="N_{c}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>c</mi></msub><annotation encoding="application/x-tex">N_{c}</annotation></semantics></math>, task type <math id="alg4.l1.m3" class="ltx_Math" alttext="\mathcal{T}\in\{\textsc{Classification},\textsc{Regression}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="ltx_font_smallcaps">Classification</mtext><mo>,</mo><mtext class="ltx_font_smallcaps">Regression</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}\in\{\textsc{Classification},\textsc{Regression}\}</annotation></semantics></math>, minimum and maximum tree depths <math id="alg4.l1.m4" class="ltx_Math" alttext="d_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{\min}&gt;0</annotation></semantics></math>, <math id="alg4.l1.m5" class="ltx_Math" alttext="d_{\max}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>max</mi></msub><annotation encoding="application/x-tex">d_{\max}</annotation></semantics></math>, split threshold interval <span id="alg4.l1.3" class="ltx_text ltx_font_typewriter">thres-int</span>, probability of no children <math id="alg4.l1.m6" class="ltx_Math" alttext="p_{\text{nc}}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mtext>nc</mtext></msub><annotation encoding="application/x-tex">p_{\text{nc}}</annotation></semantics></math>, Gaussian parameters for
regression leaf nodes <math id="alg4.l1.m7" class="ltx_Math" alttext="(\mu,\sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mu,\sigma)</annotation></semantics></math>, global leaf counter <math id="alg4.l1.m8" class="ltx_Math" alttext="N_{\text{leaf}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mtext>leaf</mtext></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">N_{\text{leaf}}=0</annotation></semantics></math>.

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg4.l2.3" class="ltx_text ltx_font_bold">class</span> <span id="alg4.l2.4" class="ltx_text ltx_font_smallcaps">Node</span>(<span id="alg4.l2.5" class="ltx_text ltx_font_typewriter">depth</span>, <math id="alg4.l2.m1" class="ltx_Math" alttext="d_{\min}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>min</mi></msub><annotation encoding="application/x-tex">d_{\min}</annotation></semantics></math>, <math id="alg4.l2.m2" class="ltx_Math" alttext="d_{\max}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>max</mi></msub><annotation encoding="application/x-tex">d_{\max}</annotation></semantics></math>, <span id="alg4.l2.6" class="ltx_text ltx_font_typewriter">thres-int</span>)

</div>
<div id="alg4.l3" class="ltx_listingline">
