ge (or scale/reject) </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 23.73)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 53.15 0)"><foreignObject style="--ltx-fo-width:2.67em;--ltx-fo-height:0.71em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.96" overflow="visible" transform="matrix(1 0 0 -1 0 9.89)" width="36.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m8" class="ltx_Math" alttext="\to\theta_{\text{new}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">→</mo><msub><mi>θ</mi><mtext>new</mtext></msub></mrow><annotation encoding="application/x-tex">\to\theta_{\text{new}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#F2F2FF;" fill="#F2F2FF" stroke="#6666FF" stroke-width="0.8pt"><g style="--ltx-fill-color:#808080;" fill="#808080" fill-opacity="0.15" stroke-opacity="0.15" transform="matrix(1.0 0.0 0.0 1.0 0.69 -0.69)"><path style="stroke:none" d="M 855.35 -138.9 L 735.36 -138.9 C 733.83 -138.9 732.59 -140.14 732.59 -141.67 L 732.59 -175.5 C 732.59 -177.03 733.83 -178.27 735.36 -178.27 L 855.35 -178.27 C 856.88 -178.27 858.12 -177.03 858.12 -175.5 L 858.12 -141.67 C 858.12 -140.14 856.88 -138.9 855.35 -138.9 Z M 732.59 -178.27"></path></g><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#F2F2FF;" fill="#F2F2FF" stroke="#6666FF" stroke-width="0.8pt"><path d="M 855.35 -138.9 L 735.36 -138.9 C 733.83 -138.9 732.59 -140.14 732.59 -141.67 L 732.59 -175.5 C 732.59 -177.03 733.83 -178.27 735.36 -178.27 L 855.35 -178.27 C 856.88 -178.27 858.12 -177.03 858.12 -175.5 L 858.12 -141.67 C 858.12 -140.14 856.88 -138.9 855.35 -138.9 Z M 732.59 -178.27"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 737.2 -162.05)"><foreignObject style="--ltx-fo-width:8.46em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="117.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">Evaluate forgetting</span></span></foreignObject></g></g><g style="--ltx-stroke-color:#A6A6A6;" stroke="#A6A6A6" stroke-width="0.8pt"><path style="fill:none" d="M 43.86 -158.59 L 114.83 -158.59"></path><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 110.79 -158.59)"><path d="M 10.34 0 L 1.79 3.19 L 4.32 0 L 1.79 -3.19 Z"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;" stroke="#A6A6A6" stroke-width="0.8pt"><path style="fill:none" d="M 254.31 -158.59 L 325.28 -158.59"></path><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 321.24 -158.59)"><path d="M 10.34 0 L 1.79 3.19 L 4.32 0 L 1.79 -3.19 Z"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;" stroke="#A6A6A6" stroke-width="0.8pt"><path style="fill:none" d="M 421.05 -158.59 L 492.02 -158.59"></path><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 487.98 -158.59)"><path d="M 10.34 0 L 1.79 3.19 L 4.32 0 L 1.79 -3.19 Z"></path></g></g><g style="--ltx-stroke-color:#A6A6A6;" stroke="#A6A6A6" stroke-width="0.8pt"><path style="fill:none" d="M 653.3 -158.59 L 724.27 -158.59"></path><g style="--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 720.23 -158.59)"><path d="M 10.34 0 L 1.79 3.19 L 4.32 0 L 1.79 -3.19 Z"></path></g></g><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 287.03 59.85)"><foreignObject style="--ltx-fo-width:9.45em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.17em;font-size:13.5pt;" height="14.76" overflow="visible" transform="matrix(1 0 0 -1 0 11.53)" width="176.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.2" class="ltx_text ltx_font_bold" style="font-size:120%;">Unconstrained Merge</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 317.22 -98.74)"><foreignObject style="--ltx-fo-width:6.22em;--ltx-fo-height:0.62em;--ltx-fo-depth:0.17em;font-size:13.5pt;" height="14.76" overflow="visible" transform="matrix(1 0 0 -1 0 11.53)" width="116.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.3" class="ltx_text ltx_font_bold" style="font-size:120%;">Gated Editing</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><g style="--ltx-stroke-color:#FFA64D;--ltx-fill-color:#FFA64D;--ltx-fg-color:#FFA64D;" color="#FFA64D" fill="#FFA64D" stroke="#FFA64D"><path style="fill:none" d="M 333.05 -192.75 M 333.05 -192.75 C 334.71 -196.07 338.59 -198.28 344.12 -198.28 L 365.98 -198.28 C 371.52 -198.28 375.39 -200.5 377.05 -203.82 C 378.71 -200.5 382.59 -198.28 388.12 -198.28 L 409.98 -198.28 C 415.52 -198.28 419.39 -196.07 421.05 -192.75"></path></g><g style="--ltx-stroke-color:#FF9933;--ltx-fill-color:#FF9933;" fill="#FF9933" stroke="#FF9933" transform="matrix(1.0 0.0 0.0 1.0 337.26 -217.63)"><foreignObject style="--ltx-fg-color:#FF9933;--ltx-fo-width:6.19em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.44pt;" color="#FF9933" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="80.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.4" class="ltx_text ltx_font_italic" style="font-size:90%;">Key difference</span></span></span></foreignObject></g></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Comparison of unconstrained LoRA merging (top) versus gated merging (bottom). The gate ensures edits are validated for forgetting before merges are accepted, providing a critical safeguard against performance degradation.</figcaption>
</figure>
<section id="S3.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.1.1 </span>Formulation</h4>

<div id="S3.SS1.SSS1.p1" class="ltx_para">
<p id="S3.SS1.SSS1.p1.1" class="ltx_p">The gating mechanism can be formalized as a constraint on how much an edit is allowed
to alter prior knowledge. We express this constraint mathematically as follows.</p>
</div>
<div id="S3.SS1.SSS1.p2" class="ltx_para">
<p id="S3.SS1.SSS1.p2.1" class="ltx_p">Let <math id="S3.SS1.SSS1.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> denote a forgetting measure and <math id="S3.SS1.SSS1.p2.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> a budget.
A merge is accepted only if</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="f\leq\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>≤</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f\leq\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.p2.2" class="ltx_p">otherwise the edit is either rejected or rescaled by a factor
<math id="S3.SS1.SSS1.p2.m3" class="ltx_Math" alttext="\alpha\in[\alpha_{\min},1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[\alpha_{\min},1]</annotation></semantics></math> to satisfy the constraint.
We compare three alternative metrics for <math id="S3.SS1.SSS1.p2.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>.</p>
</div>
<section id="S3.SS1.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Exact Match (EM) Drop.</h5>

<div id="S3.SS1.SSS1.Px1.p1" class="ltx_para">
<p id="S3.SS1.SSS1.Px1.p1.1" class="ltx_p">The EM metric quantifies task level forgetting as the reduction in factual accuracy on
anchor questions after adaptation. For each question <math id="S3.SS1.SSS1.Px1.p1.m1" class="ltx_Math" alttext="q_{i}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>i</mi></msub><annotation encoding="application/x-tex">q_{i}</annotation></semantics></math> with gold answer <math id="S3.SS1.SSS1.Px1.p1.m2" class="ltx_Math" alttext="y_{i}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">y_{i}</annotation></semantics></math>, a
large language model grader provides a binary reward</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\text{LLM}(q_{i},\hat{y})\in\{0,1\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>LLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>i</mi></msub><mo>,</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{LLM}(q_{i},\hat{y})\in\{0,1\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px1.p1.2" class="ltx_p">which equals <math id="S3.SS1.SSS1.Px1.p1.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> if the generated answer <math id="S3.SS1.SSS1.Px1.p1.m4" class="ltx_Math" alttext="\hat{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>y</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{y}</annotation></semantics></math> matches <math id="S3.SS1.SSS1.Px1.p1.m5" class="ltx_Math" alttext="y_{i}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">y_{i}</annotation></semantics></math>, and <math id="S3.SS1.SSS1.Px1.p1.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> otherwise.
Baseline and adapter accuracies are computed as</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\text{EM}_{\text{base}}=\frac{1}{N}\sum_{i=1}^{N}\text{LLM}(q_{i},\hat{y}_{i}^{\text{base}}),\quad\text{EM}_{\text{adapter}}=\frac{1}{N}\sum_{i=1}^{N}\text{LLM}(q_{i},\hat{y}_{i}^{\text{adapter}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mtext>EM</mtext><mtext>base</mtext></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><mtext>LLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>i</mi><mtext>base</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mtext>EM</mtext><mtext>adapter</mtext></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><mtext>LLM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>i</mi><mtext>adapter</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{EM}_{\text{base}}=\frac{1}{N}\sum_{i=1}^{N}\text{LLM}(q_{i},\hat{y}_{i}^{\text{base}}),\quad\text{EM}_{\text{adapter}}=\frac{1}{N}\sum_{i=1}^{N}\text{LLM}(q_{i},\hat{y}_{i}^{\text{adapter}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px1.p1.3" class="ltx_p">The forgetting signal is then defined as</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="f_{\mathrm{EM}}=\max\!\left(0,\,\text{EM}_{\text{base}}-\text{EM}_{\text{adapter}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>EM</mi></msub><mo>=</mo><mrow><mpadded style="width:1.808em;" width="1.808em"><mi>max</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mrow><msub><mtext>EM</mtext><mtext>base</mtext></msub><mo>−</mo><msub><mtext>EM</mtext><mtext>adapter</mtext></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\mathrm{EM}}=\max\!\left(0,\,\text{EM}_{\text{base}}-\text{EM}_{\text{adapter}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px1.p1.4" class="ltx_p">This metric captures the portion of factual accuracy lost after merging.
For example, <math id="S3.SS1.SSS1.Px1.p1.m7" class="ltx_Math" alttext="f_{\mathrm{EM}}=0.05" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>EM</mi></msub><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">f_{\mathrm{EM}}=0.05</annotation></semantics></math> indicates a <math id="S3.SS1.SSS1.Px1.p1.m8" class="ltx_Math" alttext="5\%" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">5\%</annotation></semantics></math> decline in correctness on anchor
questions, while <math id="S3.SS1.SSS1.Px1.p1.m9" class="ltx_Math" alttext="f_{\mathrm{EM}}=0.10" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>EM</mi></msub><mo>=</mo><mn>0.10</mn></mrow><annotation encoding="application/x-tex">f_{\mathrm{EM}}=0.10</annotation></semantics></math> represents a moderate <math id="S3.SS1.SSS1.Px1.p1.m10" class="ltx_Math" alttext="10\%" display="inline" intent=":literal"><semantics><mrow><mn>10</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">10\%</annotation></semantics></math> degradation in
factual retention.</p>
</div>
</section>
<section id="S3.SS1.SSS1.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bits Increase.</h5>

<div id="S3.SS1.SSS1.Px2.p1" class="ltx_para">
<p id="S3.SS1.SSS1.Px2.p1.1" class="ltx_p">The bits metric measures confidence level forgetting by comparing how efficiently each
model encodes its own answers, expressed in bits per token. Both the base and adapter
models independently generate answers to the same anchor questions and then evaluate the
log probabilities of their own outputs. A less confident model assigns lower probability
to its generated tokens, resulting in a higher average bits per token score.</p>
</div>
<div id="S3.SS1.SSS1.Px2.p2" class="ltx_para">
<p id="S3.SS1.SSS1.Px2.p2.1" class="ltx_p">For a sequence <math id="S3.SS1.SSS1.Px2.p2.m1" class="ltx_math_unparsed" alttext="x_{1:T}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{1:T}</annotation></semantics></math> produced by model <math id="S3.SS1.SSS1.Px2.p2.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, we define</p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_math_unparsed" alttext="\text{bits}(\theta)=-\frac{1}{T\log 2}\sum_{t=1}^{T}\log p_{\theta}(x_{t})," display="block" intent=":literal"><semantics><mrow><mtext>bits</mtext><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow></mrow></mfrac><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mi>log</mi><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{bits}(\theta)=-\frac{1}{T\log 2}\sum_{t=1}^{T}\log p_{\theta}(x_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px2.p2.2" class="ltx_p">and quantify forgetting as</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="f_{\mathrm{bits}}=\max\!\left(0,\;\text{bits}_{\text{adapter}}-\text{bits}_{\text{base}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>bits</mi></msub><mo>=</mo><mrow><mpadded style="width:1.808em;" width="1.808em"><mi>max</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mrow><msub><mtext>bits</mtext><mtext>adapter</mtext></msub><mo>−</mo><msub><mtext>bits</mtext><mtext>base</mtext></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{\mathrm{bits}}=\max\!\left(0,\;\text{bits}_{\text{adapter}}-\text{bits}_{\text{base}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px2.p2.3" class="ltx_p">where <span id="S3.SS1.SSS1.Px2.p2.3.1" class="ltx_text ltx_markedasmath">bits</span> denotes the mean across all anchor questions.
This metric reflects how much additional information (in bits) the adapter model requires
to express the same knowledge. Even if both models produce identical answers, a higher
bits score indicates reduced confidence. For instance, a 0.08 bits/token threshold requires the adapter to remain approximately
95% as confident as the base model on average</p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\frac{p_{\mathrm{adapter}}}{p_{\mathrm{base}}}=2^{-\Delta_{\mathrm{bits}}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msub><mi>p</mi><mi>adapter</mi></msub><msub><mi>p</mi><mi>base</mi></msub></mfrac><mo>=</mo><msup><mn>2</mn><mrow><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>bits</mi></msub></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{p_{\mathrm{adapter}}}{p_{\mathrm{base}}}=2^{-\Delta_{\mathrm{bits}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S3.SS1.SSS1.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">KL Divergence.</h5>

<div id="S3.SS1.SSS1.Px3.p1" class="ltx_para">
<p id="S3.SS1.SSS1.Px3.p1.1" class="ltx_p">We compute the KL divergence between the base (reference) model and the adapted
(LoRA merged) model using the log probabilities of the generated tokens themselves.
For each token <math id="S3.SS1.SSS1.Px3.p1.m1" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math> in a sampled sequence, let <math id="S3.SS1.SSS1.Px3.p1.m2" class="ltx_Math" alttext="\pi_{\text{base}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>base</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{base}}</annotation></semantics></math> and
<math id="S3.SS1.SSS1.Px3.p1.m3" class="ltx_Math" alttext="\pi_{\text{adapter}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>adapter</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{adapter}}</annotation></semantics></math> denote the conditional distributions of the base and adapter
models, respectively. The per token KL term is</p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_math_unparsed" alttext="D_{\mathrm{KL}}\!\left(\pi_{\text{adapter}}(\cdot\mid x_{&lt;t})\,\|\,\pi_{\text{base}}(\cdot\mid x_{&lt;t})\right)=\mathbb{E}_{x_{t}\sim\pi_{\text{adapter}}}\!\left[\log_{2}\frac{\pi_{\text{adapter}}(x_{t}\mid x_{&lt;t})}{\pi_{\text{base}}(x_{t}\mid x_{&lt;t})}\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo>(</mo><msub><mi>π</mi><mtext>adapter</mtext></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0.337em">∥</mo><msub><mi>π</mi><mtext>base</mtext></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>π</mi><mtext>adapter</mtext></msub></mrow></msub><mrow><mo>[</mo><msub><mi>log</mi><mn>2</mn></msub><mfrac><mrow><msub><mi>π</mi><mtext>adapter</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>base</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\mathrm{KL}}\!\left(\pi_{\text{adapter}}(\cdot\mid x_{&lt;t})\,\|\,\pi_{\text{base}}(\cdot\mid x_{&lt;t})\right)=\mathbb{E}_{x_{t}\sim\pi_{\text{adapter}}}\!\left[\log_{2}\frac{\pi_{\text{adapter}}(x_{t}\mid x_{&lt;t})}{\pi_{\text{base}}(x_{t}\mid x_{&lt;t})}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px3.p1.2" class="ltx_p">The overall drift metric averages this divergence over all tokens:</p>
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_Math" alttext="f_{\mathrm{KL}}=\frac{1}{T\log 2}\sum_{t=1}^{T}\left(\log\pi_{\text{adapter}}(x_{t}\mid x_{&lt;t})-\log\pi_{\text{base}}(x_{t}\mid x_{&lt;t})\right)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>KL</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mo>(</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mtext>adapter</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mtext>base</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{\mathrm{KL}}=\frac{1}{T\log 2}\sum_{t=1}^{T}\left(\log\pi_{\text{adapter}}(x_{t}\mid x_{&lt;t})-\log\pi_{\text{base}}(x_{t}\mid x_{&lt;t})\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS1.Px3.p1.3" class="ltx_p">where the division by <math id="S3.SS1.SSS1.Px3.p1.m4" class="ltx_Math" alttext="\log 2" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\log 2</annotation></semantics></math> converts from nats to bits per token.
KL measures distributional drift between the two models, the extent to which the
adapter’s token probabilities diverge from the base model. A KL of 0 indicates identical distributions, while higher values
reflect increasing divergence. Lower KL values indicate stronger alignment with
the base model and reduced distributional drift.</p>
</div>
</section>
</section>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Gate Logic</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Our framework employs a LoRA gating mechanism, which ensures
each adapter merge satisfies the forgetting constraint. If the computed forgetting
score <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> exceeds the budget <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, a binary search is performed over the scaling
factor <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="\alpha\in[\alpha_{\min},1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[\alpha_{\min},1]</annotation></semantics></math> to find the largest value that satisfies</p>
<table id="S3.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex10.m1" class="ltx_Math" alttext="f(\alpha\cdot W_{\text{LoRA}})\leq\epsilon," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>W</mi><mtext>LoRA</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f(\alpha\cdot W_{\text{LoRA}})\leq\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">where <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="W_{\text{LoRA}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mtext>LoRA</mtext></msub><annotation encoding="application/x-tex">W_{\text{LoRA}}</annotation></semantics></math> denotes the LoRA weight update. If no such <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> exists
above the minimum threshold <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\alpha_{\min}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\alpha_{\min}</annotation></semantics></math>, the merge is rejected.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">This procedure effectively projects edits onto the feasible region of bounded
forgetting, ensuring that all accepted merges adhere to the defined stability
constraint.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Gated LoRA Merge (LoRA Clip)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
             <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input:</span> base model <math id="alg1.l1.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, LoRA update <math id="alg1.l1.m2" class="ltx_Math" alttext="W_{\text{LoRA}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mtext>LoRA</mtext></msub><annotation encoding="application/x-tex">W_{\text{LoRA}}</annotation></semantics></math>, budget <math id="alg1.l1.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, min scale <math id="alg1.l1.m4" class="ltx_Math" alttext="\alpha_{\min}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\alpha_{\min}</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             Compute forgetting score <math id="alg1.l2.m1" class="ltx_Math" alttext="f(W_{\text{LoRA}})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mtext>LoRA</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(W_{\text{LoRA}})</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
             <span id="alg1.l3.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="f(W_{\text{LoRA}})\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mtext>LoRA</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">f(W_{\text{LoRA}})\leq\epsilon</annotation></semantics></math> <span id="alg1.l3.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <span id="alg1.l4.3" class="ltx_text ltx_font_bold">Accept</span> full merge with <math id="alg1.l4.m1" class="ltx_Math" alttext="\alpha=1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha=1</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
             <span id="alg1.l5.3" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              Binary search for <math id="alg1.l6.m1" class="ltx_Math" alttext="\alpha\in[\alpha_{\min},1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mi>min</mi></msub><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[\alpha_{\min},1]</annotation></semantics></math> satisfying <math id="alg1.l6.m2" class="ltx_Math" alttext="f(\alpha\cdot W_{\text{LoRA}})\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>W</mi><mtext>LoRA</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">f(\alpha\cdot W_{\text{LoRA}})\leq\epsilon</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <span id="alg1.l7.3" class="ltx_text ltx_font_bold">if</span> such <math id="alg1.l7.m1" class="ltx_Math" alttext="\alpha\geq\alpha_{\min}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≥</mo><msub><mi>α</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">\alpha\geq\alpha_{\min}</annotation></semantics></math> exists <span id="alg1.l7.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
               <span id="alg1.l8.3" class="ltx_text ltx_font_bold">Accept</span> scaled merge with factor <math id="alg1.l8.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
