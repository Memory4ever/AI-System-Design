      Kwak, Nojun&quot;,
    editor = &quot;Liakata, Maria  and
      Moreira, Viviane P.  and
      Zhang, Jiajun  and
      Jurgens, David&quot;,
    booktitle = &quot;Proceedings of the 64th Annual Meeting of the {A}ssociation for {C}omputational {L}inguistics (Volume 1: Long Papers)&quot;,
    month = jul,
    year = &quot;2026&quot;,
    address = &quot;San Diego, California, United States&quot;,
    publisher = &quot;Association for Computational Linguistics&quot;,
    url = &quot;https://aclanthology.org/2026.acl-long.284/&quot;,
    doi = &quot;10.18653/v1/2026.acl-long.284&quot;,
    pages = &quot;6273--6287&quot;,
    ISBN = &quot;979-8-89176-390-6&quot;,
}</code></pre></div></div></section><footer class="footer"><div class="container"><div class="columns is-centered"><div class="column is-8"><div class="content"><p>This project page follows the original<!-- --> <a href="https://nerfies.github.io/" target="_blank" rel="noopener noreferrer">Nerfies</a> <!-- -->website template structure. If you use or adapt this site code, please link back to our project page.</p></div></div></div></div></footer></div><!--$--><!--/$--><script src="/_next/static/chunks/webpack-9c4567587d0e3be0.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[7121,[],\"\"]\n3:I[4581,[],\"\"]\n4:I[6978,[\"3414\",\"static/chunks/app/template-infilling/page-d5c0d0550b0f1176.js\"],\"default\"]\n5:I[484,[],\"OutletBoundary\"]\n6:\"$Sreact.suspense\"\n8:I[484,[],\"ViewportBoundary\"]\na:I[484,[],\"MetadataBoundary\"]\nc:I[7123,[],\"\"]\n:HL[\"/_next/static/css/404c646aa5e8a7de.css\",\"style\"]\n:HL[\"/_next/static/css/e452188c7170a003.css\",\"style\"]\n:HL[\"/_next/static/css/98dbd992316bc699.css\",\"style\"]\n"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"b\":\"pEvr1btjIIsnD3bWjRw_C\",\"c\":[\"\",\"template-infilling\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"template-infilling\",{\"children\":[\"__PAGE__\",{}]}]},\"$undefined\",\"$undefined\",true],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/404c646aa5e8a7de.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"scroll-smooth\",\"data-public-theme\":\"light\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"\\n(() =\u003e {\\n  try {\\n    const saved = window.localStorage.getItem(\\\"junhoo-public-theme\\\");\\n    document.docume