<!DOCTYPE html><!--pEvr1btjIIsnD3bWjRw_C--><html lang="en" class="scroll-smooth" data-public-theme="light"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" as="image" href="/template-infilling/figure-qual.png"/><link rel="preload" as="image" href="/template-infilling/figure-main.png"/><link rel="preload" as="image" href="/template-infilling/main-results-table.png"/><link rel="preload" as="image" href="/template-infilling/figure-exp.png"/><link rel="preload" as="image" href="/template-infilling/analysis-ablation.png"/><link rel="preload" as="image" href="/template-infilling/analysis-genorder.png"/><link rel="stylesheet" href="/_next/static/css/404c646aa5e8a7de.css" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/e452188c7170a003.css" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/98dbd992316bc699.css" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-9c4567587d0e3be0.js"/><script src="/_next/static/chunks/4bd1b696-102bd7438bd0e593.js" async=""></script><script src="/_next/static/chunks/3794-9502324d289c548f.js" async=""></script><script src="/_next/static/chunks/main-app-e35121af2afc149c.js" async=""></script><script src="/_next/static/chunks/app/template-infilling/page-d5c0d0550b0f1176.js" async=""></script><meta name="next-size-adjust" content=""/><title>Template Infilling | Junhoo Lee</title><meta name="description" content="Project page for Unlocking the Potential of Diffusion Language Models through Template Infilling."/><link rel="canonical" href="https://junhoo.me/template-infilling"/><meta name="naver-site-verification" content="14977446e9eaa2b746946e2cf949d7c5edab3e7f"/><meta property="og:title" content="Junhoo Lee | Machine Learning Researcher"/><meta property="og:description" content="Junhoo Lee is a postdoctoral researcher at KAIST working on robot harnesses, looped models, and continual harnessing."/><meta property="og:url" content="https://junhoo.me"/><meta property="og:site_name" content="Junhoo Lee"/><meta property="og:image" content="https://junhoo.me/myface.jpeg"/><meta property="og:image:alt" content="Junhoo Lee"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content="Junhoo Lee | Machine Learning Researcher"/><meta name="twitter:description" content="Junhoo Lee is a postdoctoral researcher at KAIST working on robot harnesses, looped models, and continual harnessing."/><meta name="twitter:image" content="https://junhoo.me/myface.jpeg"/><link rel="icon" href="/icon.svg?2bee4e787300b6b1" type="image/svg+xml" sizes="any"/><script>
