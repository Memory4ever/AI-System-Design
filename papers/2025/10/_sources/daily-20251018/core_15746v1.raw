<th id="A6.T7.2.1.1.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.1.11.1" class="ltx_text ltx_font_bold">Cop</span></th>
<th id="A6.T7.2.1.1.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.1.12.1" class="ltx_text ltx_font_bold">Bor</span></th>
<th id="A6.T7.2.1.1.13" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.1.13.1" class="ltx_text ltx_font_bold">Irv</span></th>
<th id="A6.T7.2.1.1.14" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A6.T7.2.1.1.14.1" class="ltx_text ltx_font_bold">Spm</span></th>
