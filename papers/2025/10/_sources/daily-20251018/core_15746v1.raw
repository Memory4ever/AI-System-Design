<span id="S3.T1.2.1.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:34.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:34.4pt;transform:translate(-13.8pt,-13.8pt) rotate(-90deg) ;">
<span id="S3.T1.2.1.2.1.1.1.1" class="ltx_p">Pearson</span>
</span></span></span></td>
<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S3.T1.2.1.2.2.1" class="ltx_text ltx_font_bold">Mean</span></td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.645</td>
