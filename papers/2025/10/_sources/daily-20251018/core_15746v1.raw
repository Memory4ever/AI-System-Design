<td id="S3.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.616</td>
<td id="S3.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.555</td>
<td id="S3.T1.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t">0.426</td>
<td id="S3.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.262</td>
<td id="S3.T1.2.1.2.9" class="ltx_td ltx_align_center ltx_border_t">0.664</td>
<td id="S3.T1.2.1.2.10" class="ltx_td ltx_align_center ltx_border_t">0.659</td>
<td id="S3.T1.2.1.2.11" class="ltx_td ltx_align_center ltx_border_t">0.665</td>
<td id="S3.T1.2.1.2.12" class="ltx_td ltx_align_center ltx_border_t">0.670</td>
