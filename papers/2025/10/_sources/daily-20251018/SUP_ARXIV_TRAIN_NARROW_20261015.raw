      <a href="/search/?searchtype=author&amp;query=Wu%2C+L">Lulu Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+S">Saiyong Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lin%2C+Y">Yankai Lin</a>
      
