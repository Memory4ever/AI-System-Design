      <a href="/search/?searchtype=author&amp;query=Abate%2C+A+G">Arega Getaneh Abate</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+X">Xiao-Bing Zhang</a>, 
      
