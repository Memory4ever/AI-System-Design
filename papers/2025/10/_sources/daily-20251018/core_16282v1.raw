<span id="S4.T1.8.1.1.1.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.8.1.1.1.1.1.1.1.5.1" class="ltx_text ltx_font_bold">PAG</span></span>
<span id="S4.T1.8.1.1.1.1.1.1.1.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S4.T1.8.1.1.1.1.1.1.1.6.1" class="ltx_text"><span id="S4.T1.8.1.1.1.1.1.1.1.6.1.1" class="ltx_text"></span> <span id="S4.T1.8.1.1.1.1.1.1.1.6.1.2" class="ltx_text">
