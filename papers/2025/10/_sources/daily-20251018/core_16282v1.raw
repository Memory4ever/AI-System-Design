<span id="S4.T1.8.1.1.1.1.1.1.1.7.1.2.1.2" class="ltx_tr">
<span id="S4.T1.8.1.1.1.1.1.1.1.7.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.8.1.1.1.1.1.1.1.7.1.2.1.2.1.1" class="ltx_text ltx_font_bold">LoRA</span></span></span>
</span></span><span id="S4.T1.8.1.1.1.1.1.1.1.7.1.3" class="ltx_text"></span></span></span>
<span id="S4.T1.8.1.1.1.1.1.1.1.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S4.T1.8.1.1.1.1.1.1.1.8.1" class="ltx_text"><span id="S4.T1.8.1.1.1.1.1.1.1.8.1.1" class="ltx_text"></span> <span id="S4.T1.8.1.1.1.1.1.1.1.8.1.2" class="ltx_text">
<span id="S4.T1.8.1.1.1.1.1.1.1.8.1.2.1" class="ltx_tabular ltx_align_middle">
