<td id="A0.T2.7.14.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">85</td>
<td id="A0.T2.7.14.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">87</td>
