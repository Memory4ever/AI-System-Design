        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.14901">pdf</a>, <a href="https://arxiv.org/ps/2510.14901">ps</a>, <a href="https://arxiv.org/format/2510.14901">other</a>]&nbsp;</span>
