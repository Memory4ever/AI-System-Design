        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.15868">pdf</a>, <a href="https://arxiv.org/ps/2510.15868">ps</a>, <a href="https://arxiv.org/format/2510.15868">other</a>]&nbsp;</span>
