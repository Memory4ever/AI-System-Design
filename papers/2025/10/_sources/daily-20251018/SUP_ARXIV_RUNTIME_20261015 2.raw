      <a href="/search/?searchtype=author&amp;query=Sriram%2C+S">Samira Sriram</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xiong%2C+C">Crescent Xiong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pei%2C+Z">Zhoutao Pei</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shao%2C+A">Angela Shao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+A">Alex Li</a>, 
      
