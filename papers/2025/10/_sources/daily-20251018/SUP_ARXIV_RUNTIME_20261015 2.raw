        <span>&nbsp;[<a href="https://arxiv.org/pdf/2601.02361">pdf</a>, <a href="https://arxiv.org/ps/2601.02361">ps</a>, <a href="https://arxiv.org/format/2601.02361">other</a>]&nbsp;</span>
