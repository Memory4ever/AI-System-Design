      <a href="/search/?searchtype=author&amp;query=Kolb%2C+C">Caitlin Kolb</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kistler%2C+T">Thomas Kistler</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Moore%2C+Z">Zach Moore</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Firooz%2C+H">Hamed Firooz</a>
      
