      <a href="/search/?searchtype=author&amp;query=Kachaev%2C+N">Nikita Kachaev</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zelezetsky%2C+D">Daniil Zelezetsky</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cherepanov%2C+E">Egor Cherepanov</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kovelev%2C+A+K">Alexey K. Kovelev</a>, 
      
