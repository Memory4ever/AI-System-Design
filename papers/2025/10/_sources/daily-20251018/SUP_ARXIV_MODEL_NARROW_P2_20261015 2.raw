    <p class="title is-5 mathjax">
      
        DSCD: <span class="search-hit mathjax">Large</span> <span class="search-hit mathjax">Language</span> <span class="search-hit mathjax">Model</span> Detoxification with Self-Constrained Decoding
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Dong%2C+M">Ming Dong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jinkui Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zheng%2C+B">Bolong Zheng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tu%2C+X">Xinhui Tu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hu%2C+P">Po Hu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=He%2C+T">Tingting He</a>
      
