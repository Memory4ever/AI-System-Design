      <a href="/search/?searchtype=author&amp;query=Yao%2C+H">Handong Yao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+R">Ruopeng Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+X">Xianliang Huang</a>
      
