      <a href="/search/?searchtype=author&amp;query=Lee%2C+J">Jaehone Lee</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+S">Sang-Woo Lee</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Park%2C+J">Joonsuk Park</a>, 
      
