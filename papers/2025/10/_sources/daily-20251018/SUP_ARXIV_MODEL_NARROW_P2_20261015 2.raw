      <a href="/search/?searchtype=author&amp;query=Cort%C3%A9s%2C+G">Gianfranco Cortés</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cho%2C+S">Suin Cho</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kaplan%2C+D+Z">Daniel Z. Kaplan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Warner%2C+B">Benjamin Warner</a>, 
      
