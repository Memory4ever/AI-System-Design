<th id="S4.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">CR</th>
<td id="S4.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">31.6</td>
<td id="S4.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">36.0</td>
<td id="S4.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">52.1</td>
<td id="S4.T3.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">40.8</td></tr>
<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">MR</th>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center">8.1</td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center">8.0</td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center">6.7</td>
<td id="S4.T3.2.1.3.5" class="ltx_td ltx_align_center">7.5</td></tr>
<tr id="S4.T3.2.1.4" class="ltx_tr">
<th id="S4.T3.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" rowspan="2"><span id="S4.T3.2.1.4.1.1" class="ltx_text">RARR</span></th>
<th id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">CR</th>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center">30.7</td>
<td id="S4.T3.2.1.4.4" class="ltx_td ltx_align_center">49.3</td>
<td id="S4.T3.2.1.4.5" class="ltx_td ltx_align_center">51.3</td>
<td id="S4.T3.2.1.4.6" class="ltx_td ltx_align_center">47.1</td></tr>
