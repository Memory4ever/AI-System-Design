<th id="S4.T3.2.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r">MR</th>
<td id="S4.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">5.5</td>
<td id="S4.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">4.3</td>
<td id="S4.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bb">4.5</td>
