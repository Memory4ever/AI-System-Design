<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S4.SS2" title="In IV Results ‣ EgMM-Corpus: A Multimodal Vision-Language Dataset for Egyptian Culture" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">IV-B</span> </span><span class="ltx_text ltx_font_italic">Overall Performance</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S4.SS3" title="In IV Results ‣ EgMM-Corpus: A Multimodal Vision-Language Dataset for Egyptian Culture" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">IV-C</span> </span><span class="ltx_text ltx_font_italic">Per-Concept Analysis</span></span></a></li>
</ol></li>
