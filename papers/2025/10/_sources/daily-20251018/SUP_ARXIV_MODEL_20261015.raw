      <a href="/search/?searchtype=author&amp;query=Oh%2C+S">Saejin Oh</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fang%2C+X">Xinyi Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lin%2C+I">I-Hsin Lin</a>, 
      
