      <a href="/search/?searchtype=author&amp;query=Long%2C+P">Phillip Long</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hou%2C+Y">Yupeng Hou</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+K">Ke Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Berg-Kirkpatrick%2C+T">Taylor Berg-Kirkpatrick</a>, 
      
      <a href="/search/?searchtype=author&amp;query=McAuley%2C+J">Julian McAuley</a>
      
