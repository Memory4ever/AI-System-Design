  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2510.17882">arXiv:2510.17882</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.17882">pdf</a>, <a href="https://arxiv.org/ps/2510.17882">ps</a>, <a href="https://arxiv.org/format/2510.17882">other</a>]&nbsp;</span>
