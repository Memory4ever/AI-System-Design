<td id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.1.3.4.1" class="ltx_text ltx_font_bold">93.76</span></td>
<td id="S4.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0</td>
<td id="S4.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">10</td>
<td id="S4.T1.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S4.T1.2.1.3.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0</td>
<td id="S4.T1.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t">14</td>
<td id="S4.T1.2.1.3.10" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S4.T1.2.1.3.11" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0</td>
<td id="S4.T1.2.1.3.12" class="ltx_td ltx_align_center ltx_border_t">14</td>
<td id="S4.T1.2.1.3.13" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S4.T1.2.1.3.14" class="ltx_td ltx_align_center ltx_border_t">0</td></tr>
<tr id="S4.T1.2.1.4" class="ltx_tr">
<td id="S4.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="3"><span id="S4.T1.2.1.4.1.1" class="ltx_text">BadWord</span></td>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Vanilla</td>
<td id="S4.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">93.40</td>
