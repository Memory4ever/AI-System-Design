<td id="A2.T7.2.1.11.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A2.T7.m3" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></td>
<td id="A2.T7.2.1.11.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">+0.39%</td>
<td id="A2.T7.2.1.11.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">+83.92%</td>
<td id="A2.T7.2.1.11.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">+1.66%</td>
