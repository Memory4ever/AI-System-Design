<figure id="Sx2.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 3: </span>Proper Shutdown Tile Disabled</figcaption>
<table id="Sx2.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
