<td id="A4.T7.2.3.5" class="ltx_td ltx_align_center">API model</td></tr>
<tr id="A4.T7.2.4" class="ltx_tr">
<td id="A4.T7.2.4.1" class="ltx_td ltx_align_left">Qwen series</td>
<td id="A4.T7.2.4.2" class="ltx_td ltx_align_center">0.1</td>
<td id="A4.T7.2.4.3" class="ltx_td ltx_align_center">0.9</td>
