      <a href="/search/?searchtype=author&amp;query=Gad%2C+A">Ahmed Gad</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Abdelgawad%2C+H">Hesham Abdelgawad</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Aref%2C+M">Mohamed Aref</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fares%2C+A">Ahmed Fares</a>
      
