            <span id="lstnumberx44.2" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF00FF;">input</span><span id="lstnumberx44.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=</span><span id="lstnumberx44.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">flow</span><span id="lstnumberx44.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx44.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">tensor</span><span id="lstnumberx44.9" class="ltx_text ltx_font_typewriter" style="font-size:80%;">([[[1.,</span><span id="lstnumberx44.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.11" class="ltx_text ltx_font_typewriter" style="font-size:80%;">2,</span><span id="lstnumberx44.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;">3,</span><span id="lstnumberx44.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">4,</span><span id="lstnumberx44.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.17" class="ltx_text ltx_font_typewriter" style="font-size:80%;">5,</span><span id="lstnumberx44.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;">6,</span><span id="lstnumberx44.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.21" class="ltx_text ltx_font_typewriter" style="font-size:80%;">7,</span><span id="lstnumberx44.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx44.23" class="ltx_text ltx_font_typewriter" style="font-size:80%;">8]]])</span>
</div>
