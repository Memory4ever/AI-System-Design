<td id="S3.T1.4.1.5.3" class="ltx_td ltx_align_center"><span id="S3.T1.4.1.5.3.1" class="ltx_text" style="font-size:90%;">57 (16.01%)</span></td>
<td id="S3.T1.4.1.5.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.4.1.5.4.1" class="ltx_text" style="font-size:90%;">76</span></td></tr>
