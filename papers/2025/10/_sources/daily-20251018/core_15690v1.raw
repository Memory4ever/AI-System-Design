<td id="S3.T1.4.1.4.2" class="ltx_td ltx_align_center"><span id="S3.T1.4.1.4.2.1" class="ltx_text" style="font-size:90%;">970</span></td>
<td id="S3.T1.4.1.4.3" class="ltx_td ltx_align_center"><span id="S3.T1.4.1.4.3.1" class="ltx_text" style="font-size:90%;">94 (9.69%)</span></td>
<td id="S3.T1.4.1.4.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.4.1.4.4.1" class="ltx_text" style="font-size:90%;">141</span></td></tr>
