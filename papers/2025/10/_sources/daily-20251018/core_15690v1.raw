<th id="S3.T1.4.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S3.T1.4.1.6.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Total</span></th>
<td id="S3.T1.4.1.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T1.4.1.6.2.1" class="ltx_text" style="font-size:90%;">88160</span></td>
<td id="S3.T1.4.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T1.4.1.6.3.1" class="ltx_text" style="font-size:90%;">4336 (4.92%)</span></td>
<td id="S3.T1.4.1.6.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t"><span id="S3.T1.4.1.6.4.1" class="ltx_text" style="font-size:90%;">7167</span></td></tr>
