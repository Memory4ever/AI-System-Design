<th id="S5.T6.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="3"><span id="S5.T6.2.1.3.1.1" class="ltx_text ltx_font_bold">Zero-shot</span></th>
<th id="S5.T6.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">CodeLLama</th>
<td id="S5.T6.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">66.67%(20/30)</td>
<td id="S5.T6.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">33.33%(10/30)</td>
