<td id="S3.T1.4.1.3.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.4.1.3.4.1" class="ltx_text" style="font-size:90%;">3257</span></td></tr>
<tr id="S3.T1.4.1.4" class="ltx_tr">
