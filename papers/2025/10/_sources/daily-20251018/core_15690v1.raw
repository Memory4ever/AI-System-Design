            <span id="lstnumberx45.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">output</span><span id="lstnumberx45.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx45.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx45.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">indices</span><span id="lstnumberx45.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx45.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=</span><span id="lstnumberx45.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx45.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">pool</span><span id="lstnumberx45.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx45.11" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF00FF;">input</span><span id="lstnumberx45.12" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span><span id="lstnumberx45.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx45.14" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#009900;">#<span id="lstnumberx45.14.1" class="ltx_text ltx_lst_space"> </span>bug</span>
