<th id="S3.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_th_row ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"></th>
<th id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Ma-f1<math id="S3.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
