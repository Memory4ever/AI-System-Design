<div id="A2.T2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:464.7pt;vertical-align:-228.7pt;"><span class="ltx_transformed_inner" style="transform:translate(55.0pt,-74.1pt) scale(1.46784454737642,1.46784454737642) ;">
