<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S3.T1.2.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="S3.T1.2.1.3.1.1.1" class="ltx_p">
<span id="S3.T1.2.1.3.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.1pt;height:57.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:57.8pt;transform:translate(-25.8pt,-25.8pt) rotate(-90deg) ;">
<span id="S3.T1.2.1.3.1.1.1.1.1" class="ltx_p"><span id="S3.T1.2.1.3.1.1.1.1.1.1" class="ltx_text ltx_font_typewriter">Llama3.1-8b</span></span>
</span></span></span>
</span></th>
<th id="S3.T1.2.1.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S3.T1.2.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S3.T1.2.1.3.2.1.1" class="ltx_p"><span id="S3.T1.2.1.3.2.1.1.1" class="ltx_text ltx_font_typewriter">Zero-shot</span></span>
</span></th>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">10.3</td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">36.9</td>
