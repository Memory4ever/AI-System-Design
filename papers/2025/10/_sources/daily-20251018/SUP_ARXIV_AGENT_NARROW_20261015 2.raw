      <a href="/search/?searchtype=author&amp;query=Johnson%2C+R+T">Reid T. Johnson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pain%2C+M+D">Michelle D. Pain</a>, 
      
      <a href="/search/?searchtype=author&amp;query=West%2C+J+D">Jordan D. West</a>
      
