<div id="S3.F4.4" class="ltx_logical-block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:131.2pt;">
        
<div id="S3.F4.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S3.F4.p3.pic1" class="ltx_picture" height="153.54" overflow="visible" version="1.1" viewBox="0 0 181.5 153.54" width="181.5"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,153.54) matrix(1 0 0 -1 0 0)"><clipPath id="pgfcp15"><path d="M -22670.54 -22670.54 L 22670.54 -22670.54 L 22670.54 22670.54 L -22670.54 22670.54 Z M 0 8.98 L 0 144.56 C 0 149.52 4.02 153.54 8.98 153.54 L 172.52 153.54 C 177.48 153.54 181.5 149.52 181.5 144.56 L 181.5 8.98 C 181.5 4.02 177.48 0 172.52 0 L 8.98 0 C 4.02 0 0 4.02 0 8.98 Z"></path></clipPath><g fill-rule="evenodd"><g style="--ltx-fill-color:#005959;" fill="#005959" fill-opacity="1.0"><path style="stroke:none" d="M 0 8.98 L 0 144.56 C 0 149.52 4.02 153.54 8.98 153.54 L 172.52 153.54 C 177.48 153.54 181.5 149.52 181.5 144.56 L 181.5 8.98 C 181.5 4.02 177.48 0 172.52 0 L 8.98 0 C 4.02 0 0 4.02 0 8.98 Z M 1.11 8.98 L 1.11 113.78 L 180.39 113.78 L 180.39 8.98 C 180.39 4.63 176.87 1.11 172.52 1.11 L 8.98 1.11 C 4.63 1.11 1.11 4.63 1.11 8.98 Z"></path></g><g style="--ltx-fill-color:#F2F9F9;" fill="#F2F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 8.98 L 1.11 113.78 L 180.39 113.78 L 180.39 8.98 C 180.39 4.63 176.87 1.11 172.52 1.11 L 8.98 1.11 C 4.63 1.11 1.11 4.63 1.11 8.98 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.92 122.29)"><foreignObject style="--ltx-fo-width:9.78em;--ltx-fo-height:1.89em;--ltx-fo-depth:0.25em;font-size:10pt;" height="29.67" overflow="visible" transform="matrix(1 0 0 -1 0 26.21)" width="135.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F4.p3.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:9.78em;">
<span id="S3.F4.p3.pic1.1.1" class="ltx_inline-block fa fa-play ltx_align_left" aria-hidden="true">
</span>
<span id="S3.F4.p3.pic1.1.2" class="ltx_p ltx_align_left"><span id="S3.F4.p3.pic1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Run Benchmark (B)</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.92 -53.14)"><foreignObject style="--ltx-fo-width:11.25em;--ltx-fo-height:11.49em;--ltx-fo-depth:0em;font-size:10pt;" height="159.05" overflow="visible" transform="matrix(1 0 0 -1 0 159.05)" width="155.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
