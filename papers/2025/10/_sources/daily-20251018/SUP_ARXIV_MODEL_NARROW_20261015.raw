      <a href="/search/?searchtype=author&amp;query=Contreras%2C+J">Jhonatan Contreras</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chippalkatti%2C+R">Rohan Chippalkatti</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Abankwa%2C+D+K">Daniel Kwaku Abankwa</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Eggeling%2C+C">Christian Eggeling</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bocklitz%2C+T">Thomas Bocklitz</a>
      
