        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.15624">pdf</a>, <a href="https://arxiv.org/ps/2510.15624">ps</a>, <a href="https://arxiv.org/format/2510.15624">other</a>]&nbsp;</span>
