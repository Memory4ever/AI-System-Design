<td id="S5.T2.2.1.2" class="ltx_td ltx_align_left ltx_border_tttt" style="padding:-1pt 3.0pt;" rowspan="2"><span id="S5.T2.2.1.2.1" class="ltx_text ltx_font_bold">Draft Model</span></td>
