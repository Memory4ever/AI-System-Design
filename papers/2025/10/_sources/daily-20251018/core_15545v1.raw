<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Related Algorithms</h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Token-level Intersection (TLI)</h3>

<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> (Token-Level Intersection, TLI <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib25" title="" class="ltx_ref">Timor et al., 2025a</a>)</cite>), an iteration of speculative decoding for heterogeneous vocabularies with token-level rejection sampling verification</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
             <span id="alg3.l1.2" class="ltx_text ltx_font_bold">Input:</span> Probability distributions <math id="alg3.l1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="alg3.l1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> over vocabularies <math id="alg3.l1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and <math id="alg3.l1.m4" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, respectively. Drafting lookahead <math id="alg3.l1.m5" class="ltx_Math" alttext="i\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i\in\mathbb{N}</annotation></semantics></math>.

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
             <span id="alg3.l2.2" class="ltx_text ltx_font_bold">Output:</span> A sequence of tokens from <math id="alg3.l2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, containing between <math id="alg3.l2.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="alg3.l2.m3" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math> tokens.

</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
             <span id="alg3.l3.2" class="ltx_text ltx_font_bold">Procedure:</span>

</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
             Define a probability distribution <math id="alg3.l4.m1" class="ltx_Math" alttext="q^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mo>′</mo></msup><annotation encoding="application/x-tex">q^{\prime}</annotation></semantics></math> over the vocabulary <math id="alg3.l4.m2" class="ltx_Math" alttext="T\cap D" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∩</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">T\cap D</annotation></semantics></math> such that <math id="alg3.l4.m3" class="ltx_Math" alttext="q^{\prime}(x)=\frac{q(x)}{\sum_{t\in T}q(t)}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>t</mi><mo>∈</mo><mi>T</mi></mrow></msub></mstyle><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">q^{\prime}(x)=\frac{q(x)}{\sum_{t\in T}q(t)}</annotation></semantics></math> if <math id="alg3.l4.m4" class="ltx_Math" alttext="x\in T" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">x\in T</annotation></semantics></math> and <math id="alg3.l4.m5" class="ltx_Math" alttext="q^{\prime}(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q^{\prime}(x)=0</annotation></semantics></math> otherwise.

</div>
<div id="alg3.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
             <span id="alg3.l5.2" class="ltx_text ltx_font_bold">Run</span> Standard Speculative Decoding with <math id="alg3.l5.m1" class="ltx_Math" alttext="p,q^{\prime},i,c" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo>,</mo><mi>i</mi><mo>,</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">p,q^{\prime},i,c</annotation></semantics></math>.

</div>
</div>
</figure>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Standard Speculative Decoding</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">Standard Speculative Decoding accelerates autoregressive generation by pre-generating candidate tokens with a draft model for batch verification, converting sequential decoding into parallel computation. The algorithm ensures distribution consistency via probability ratio acceptance but is limited to homogeneous vocabularies, which TokenTiming overcomes through dynamic alignment.</p>
</div>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.3" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Standard Speculative Decoding <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Leviathan et al., 2023</a>; <a href="#bib.bib4" title="" class="ltx_ref">Chen et al., 2023</a>)</cite></figcaption>
<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
             <span id="alg4.l1.2" class="ltx_text ltx_font_bold">Input:</span> Probability distributions <math id="alg4.l1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="alg4.l1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> over a vocabulary <math id="alg4.l1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. Drafting lookahead <math id="alg4.l1.m4" class="ltx_Math" alttext="i\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">i\in\mathbb{N}</annotation></semantics></math>. An input prompt <math id="alg4.l1.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>.

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
             <span id="alg4.l2.2" class="ltx_text ltx_font_bold">Output:</span> A sequence of tokens from <math id="alg4.l2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, containing between <math id="alg4.l2.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="alg4.l2.m3" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math> tokens.

</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
             <span id="alg4.l3.2" class="ltx_text ltx_font_bold">Procedure:</span>

</div>
<div id="alg4.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
             <span id="alg4.l4.2" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l4.m1" class="ltx_Math" alttext="j\leftarrow 1,\ldots,i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">j\leftarrow 1,\ldots,i</annotation></semantics></math> <span id="alg4.l4.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              Sample a draft token from the drafter, <math id="alg4.l5.m1" class="ltx_Math" alttext="d_{j}\sim q_{c\oplus d_{1}\oplus\ldots\oplus d_{j-1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>∼</mo><msub><mi>q</mi><mrow><mi>c</mi><mo>⊕</mo><msub><mi>d</mi><mn>1</mn></msub><mo>⊕</mo><mi mathvariant="normal">…</mi><mo>⊕</mo><msub><mi>d</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">d_{j}\sim q_{c\oplus d_{1}\oplus\ldots\oplus d_{j-1}}</annotation></semantics></math>.

</div>
<div id="alg4.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
             <span id="alg4.l6.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l6.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg4.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
             In parallel, compute the <math id="alg4.l7.m1" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math> logits of the target model: <math id="alg4.l7.m2" class="ltx_Math" alttext="p_{c},~p_{c\oplus d_{1}},~\cdots,~p_{c\oplus d_{1}\oplus\cdots\oplus d_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>c</mi></msub><mo rspace="0.497em">,</mo><msub><mi>p</mi><mrow><mi>c</mi><mo>⊕</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub><mo rspace="0.219em">,</mo><mo rspace="0em">⋯</mo><mo rspace="0.497em">,</mo><msub><mi>p</mi><mrow><mi>c</mi><mo>⊕</mo><msub><mi>d</mi><mn>1</mn></msub><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">p_{c},~p_{c\oplus d_{1}},~\cdots,~p_{c\oplus d_{1}\oplus\cdots\oplus d_{i}}</annotation></semantics></math>.

</div>
<div id="alg4.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
             <span id="alg4.l8.2" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l8.m1" class="ltx_Math" alttext="j\leftarrow 1,\ldots,i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">j\leftarrow 1,\ldots,i</annotation></semantics></math> <span id="alg4.l8.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
              Let <math id="alg4.l9.m1" class="ltx_Math" alttext="x\leftarrow c\oplus d_{1}\oplus\cdots\oplus d_{j-1}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo stretchy="false">←</mo><mrow><mi>c</mi><mo>⊕</mo><msub><mi>d</mi><mn>1</mn></msub><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><msub><mi>d</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">x\leftarrow c\oplus d_{1}\oplus\cdots\oplus d_{j-1}</annotation></semantics></math>.

</div>
<div id="alg4.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
              <span id="alg4.l10.2" class="ltx_text ltx_font_bold">if</span> <math id="alg4.l10.m1" class="ltx_Math" alttext="p_{x}(d_{j})\leq q_{x}(d_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>q</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{x}(d_{j})\leq q_{x}(d_{j})</annotation></semantics></math> <span id="alg4.l10.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg4.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
               With probability <math id="alg4.l11.m1" class="ltx_Math" alttext="1-\frac{p_{x}(d_{j})}{q_{x}(d_{j})}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msub><mi>p</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{p_{x}(d_{j})}{q_{x}(d_{j})}</annotation></semantics></math>, <span id="alg4.l11.2" class="ltx_text ltx_font_bold">reject</span> <math id="alg4.l11.m2" class="ltx_Math" alttext="d_{j}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>j</mi></msub><annotation encoding="application/x-tex">d_{j}</annotation></semantics></math> and <span id="alg4.l11.3" class="ltx_text ltx_font_bold">break</span>.

</div>
<div id="alg4.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
              <span id="alg4.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l12.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg4.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
              <span id="alg4.l13.2" class="ltx_text ltx_font_bold">Accept</span> the draft token <math id="alg4.l13.m1" class="ltx_Math" alttext="d_{j}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>j</mi></msub><annotation encoding="application/x-tex">d_{j}</annotation></semantics></math>.

</div>
<div id="alg4.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
             <span id="alg4.l14.2" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l14.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg4.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
             Let <math id="alg4.l15.m1" class="ltx_Math" alttext="j\in\{0,1,\ldots,i\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{0,1,\ldots,i\}</annotation></semantics></math> be the number of accepted drafts. 

</div>
<div id="alg4.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
             Set <math id="alg4.l16.m1" class="ltx_Math" alttext="x\leftarrow c\oplus d_{1}\oplus\ldots\oplus d_{j}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo stretchy="false">←</mo><mrow><mi>c</mi><mo>⊕</mo><msub><mi>d</mi><mn>1</mn></msub><mo>⊕</mo><mi mathvariant="normal">…</mi><mo>⊕</mo><msub><mi>d</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x\leftarrow c\oplus d_{1}\oplus\ldots\oplus d_{j}</annotation></semantics></math>.

</div>
<div id="alg4.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">17:</span>
              
              
             Sample <math id="alg4.l17.m1" class="ltx_Math" alttext="t\sim r_{x}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><msub><mi>r</mi><mi>x</mi></msub></mrow><annotation encoding="application/x-tex">t\sim r_{x}</annotation></semantics></math> where <math id="alg4.l17.m2" class="ltx_Math" alttext="r_{x}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{x}(\cdot)</annotation></semantics></math> is the modified distribution.

</div>
<div id="alg4.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
             <span id="alg4.l18.2" class="ltx_text ltx_font_bold">Return</span> <math id="alg4.l18.m1" class="ltx_Math" alttext="d_{1},\ldots,d_{j},t" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>j</mi></msub><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">d_{1},\ldots,d_{j},t</annotation></semantics></math>.

</div>
</div>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
