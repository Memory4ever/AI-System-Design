<td id="S5.T2.2.1.7" class="ltx_td ltx_align_center ltx_border_tttt" style="padding:-1pt 3.0pt;" colspan="2"><span id="S5.T2.2.1.7.1" class="ltx_text ltx_font_bold">QA</span></td></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
<td id="S5.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-1pt 3.0pt;"><span id="S5.T2.2.2.1.1" class="ltx_text ltx_font_bold">TLI</span></td>
<td id="S5.T2.2.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:-1pt 3.0pt;"><span id="S5.T2.2.2.2.1" class="ltx_text ltx_font_bold">Ours</span></td>
<td id="S5.T2.2.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:-1pt 3.0pt;"><span id="S5.T2.2.2.3.1" class="ltx_text ltx_font_bold">TLI</span></td>
