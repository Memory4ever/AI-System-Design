<td id="S5.T2.2.21.7" class="ltx_td ltx_align_left" style="--ltx-bg-color:#B4DCFF;padding:-1pt 3.0pt;"><span id="S5.T2.2.21.7.1" class="ltx_text" style="--ltx-bg-color:#B4DCFF;">1.41</span></td>
<td id="S5.T2.2.21.8" class="ltx_td ltx_align_left" style="padding:-1pt 3.0pt;"><math id="S5.T2.m94" class="ltx_Math" alttext="0.87" display="inline" intent=":literal"><semantics><mn>0.87</mn><annotation encoding="application/x-tex">0.87</annotation></semantics></math></td>
<td id="S5.T2.2.21.9" class="ltx_td ltx_align_left" style="--ltx-bg-color:#87C8FF;padding:-1pt 3.0pt;"><span id="S5.T2.2.21.9.1" class="ltx_text" style="--ltx-bg-color:#87C8FF;">1.64</span></td>
<td id="S5.T2.2.21.10" class="ltx_td ltx_align_left" style="padding:-1pt 3.0pt;"><math id="S5.T2.m95" class="ltx_Math" alttext="1.29" display="inline" intent=":literal"><semantics><mn>1.29</mn><annotation encoding="application/x-tex">1.29</annotation></semantics></math></td>
<td id="S5.T2.2.21.11" class="ltx_td ltx_align_left" style="--ltx-bg-color:#B4DCFF;padding:-1pt 3.0pt;"><span id="S5.T2.2.21.11.1" class="ltx_text" style="--ltx-bg-color:#B4DCFF;">1.30</span></td></tr>
<tr id="S5.T2.2.22" class="ltx_tr">
<td id="S5.T2.2.22.1" class="ltx_td ltx_align_left ltx_border_bbbb" style="padding:-1pt 3.0pt;">opt-350m</td>
<td id="S5.T2.2.22.2" class="ltx_td ltx_align_left ltx_border_bbbb" style="padding:-1pt 3.0pt;"><math id="S5.T2.m96" class="ltx_Math" alttext="1.64" display="inline" intent=":literal"><semantics><mn>1.64</mn><annotation encoding="application/x-tex">1.64</annotation></semantics></math></td>
<td id="S5.T2.2.22.3" class="ltx_td ltx_align_left ltx_border_bbbb" style="--ltx-bg-color:#E1F0FF;padding:-1pt 3.0pt;"><span id="S5.T2.2.22.3.1" class="ltx_text" style="--ltx-bg-color:#E1F0FF;">1.34</span></td>
<td id="S5.T2.2.22.4" class="ltx_td ltx_align_left ltx_border_bbbb" style="padding:-1pt 3.0pt;"><math id="S5.T2.m97" class="ltx_Math" alttext="1.30" display="inline" intent=":literal"><semantics><mn>1.30</mn><annotation encoding="application/x-tex">1.30</annotation></semantics></math></td>
