              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.20.1" class="ltx_text ltx_font_bold">18</span></span>
            <math id="algorithm1.m24" class="ltx_Math" alttext="\alpha_{d}\leftarrow\frac{N_{d}}{N_{d}+\lambda}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>d</mi></msub><mo stretchy="false">←</mo><mfrac><msub><mi>N</mi><mi>d</mi></msub><mrow><msub><mi>N</mi><mi>d</mi></msub><mo>+</mo><mi>λ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha_{d}\leftarrow\frac{N_{d}}{N_{d}+\lambda}</annotation></semantics></math>
</div>
<div id="algorithm1.4.21" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
