            <span id="algorithm1.4.19.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.19.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m23" class="ltx_Math" alttext="d\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">d\in\mathcal{D}</annotation></semantics></math></em> <span id="algorithm1.4.19.4" class="ltx_text ltx_font_bold">do</span>
</div>
