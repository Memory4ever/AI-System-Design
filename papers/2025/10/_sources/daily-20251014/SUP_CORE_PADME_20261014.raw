ation/x-tex">0.28</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.49 100.54)"><foreignObject style="--ltx-fo-width:1.83em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:7.36pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="18.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m8" class="ltx_Math" alttext="0.62" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.500em">0.62</mn><annotation encoding="application/x-tex">0.62</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 141.32 100.54)"><foreignObject style="--ltx-fo-width:1.83em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:7.36pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="18.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m9" class="ltx_Math" alttext="0.62" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.500em">0.62</mn><annotation encoding="application/x-tex">0.62</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 240.16 114.42)"><foreignObject style="--ltx-fo-width:1.83em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:7.36pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="18.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F5.pic1.m10" class="ltx_Math" alttext="0.71" display="inline"