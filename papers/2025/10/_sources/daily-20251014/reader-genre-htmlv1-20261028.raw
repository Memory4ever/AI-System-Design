<td id="S2.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><span id="S2.T1.2.1.2.1" class="ltx_text ltx_font_bold">Total</span></td></tr>
<tr id="S2.T1.2.2" class="ltx_tr">
<td id="S2.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Idiom Translation</td>
<td id="S2.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">2,844</td></tr>
<tr id="S2.T1.2.3" class="ltx_tr">
<td id="S2.T1.2.3.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Lexical Ambiguity</td>
<td id="S2.T1.2.3.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">4,576</td></tr>
