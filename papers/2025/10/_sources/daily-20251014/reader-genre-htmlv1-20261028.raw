<td id="S2.T1.2.7.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">Cultural Safety</td>
<td id="S2.T1.2.7.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">100</td></tr>
