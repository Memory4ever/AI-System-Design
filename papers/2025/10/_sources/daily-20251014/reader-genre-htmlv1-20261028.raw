<td id="S2.T1.2.4.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Terminology Localization</td>
<td id="S2.T1.2.4.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1,836</td></tr>
<tr id="S2.T1.2.5" class="ltx_tr">
