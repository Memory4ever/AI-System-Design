<td id="S6.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_t">84.22</td></tr>
<tr id="S6.T2.2.4" class="ltx_tr">
<th id="S6.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">
<span id="S6.T2.2.4.1.1" class="ltx_inline-block ltx_align_top">
<span id="S6.T2.2.4.1.1.1" class="ltx_p">(-) localization</span>
</span></th>
<td id="S6.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_t">57.80</td>
<td id="S6.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_t">65.72</td>
<td id="S6.T2.2.4.4" class="ltx_td ltx_align_center ltx_border_t">83.61</td></tr>
