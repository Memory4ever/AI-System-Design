<figure id="A4.T4" class="ltx_table">
<table id="A4.T4.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A4.T4.2.1" class="ltx_tr">
<th id="A4.T4.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="2">
<span id="A4.T4.2.1.1.1" class="ltx_inline-block ltx_align_top">
<span id="A4.T4.2.1.1.1.1" class="ltx_p">Model</span>
</span></th>
<th id="A4.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" rowspan="2"><span id="A4.T4.2.1.2.1" class="ltx_text">Well-formed</span></th>
<th id="A4.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" rowspan="2"><span id="A4.T4.2.1.3.1" class="ltx_text">Repair</span></th>
