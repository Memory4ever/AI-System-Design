</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.35 14.04)"><foreignObject style="--ltx-fo-width:45.27em;--ltx-fo-height:6.55em;--ltx-fo-depth:0.25em;font-size:10pt;" height="94.09" overflow="visible" transform="matrix(1 0 0 -1 0 90.63)" width="626.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
