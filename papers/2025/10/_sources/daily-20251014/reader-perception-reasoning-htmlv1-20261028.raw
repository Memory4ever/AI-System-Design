<td id="S3.T3.8.1.2.3" class="ltx_td ltx_align_center ltx_border_t">RA<sub id="S3.T3.8.1.2.3.1" class="ltx_sub"><span id="S3.T3.8.1.2.3.1.1" class="ltx_text ltx_font_italic">0.1</span></sub></td>
<td id="S3.T3.8.1.2.4" class="ltx_td ltx_align_center ltx_border_t">RA<math id="S3.T3.m4" class="ltx_Math" alttext="{}_{\text{avg}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>avg</mtext></msub><annotation encoding="application/x-tex">{}_{\text{avg}}</annotation></semantics></math></td>
