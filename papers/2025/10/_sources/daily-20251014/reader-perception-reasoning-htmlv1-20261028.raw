<td id="A2.T6.1.4.2" class="ltx_td ltx_align_center"><span id="A2.T6.1.4.2.1" class="ltx_text ltx_font_bold">64.7</span></td>
<td id="A2.T6.1.4.3" class="ltx_td ltx_align_center"><span id="A2.T6.1.4.3.1" class="ltx_text ltx_font_bold">88.3</span></td></tr>
