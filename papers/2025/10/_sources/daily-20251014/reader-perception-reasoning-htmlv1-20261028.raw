<td id="S3.T3.8.1.5.4" class="ltx_td ltx_align_center">24.0</td>
<td id="S3.T3.8.1.5.5" class="ltx_td ltx_align_center">53.8</td>
<td id="S3.T3.8.1.5.6" class="ltx_td ltx_align_center">16.0</td>
<td id="S3.T3.8.1.5.7" class="ltx_td ltx_align_center">47.8</td>
