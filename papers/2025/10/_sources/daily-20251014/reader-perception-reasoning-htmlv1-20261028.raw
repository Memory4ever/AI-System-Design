<td id="A2.T6.1.2.2" class="ltx_td ltx_align_center ltx_border_t">RA<math id="A2.m2" class="ltx_Math" alttext="{}_{\text{avg}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>avg</mtext></msub><annotation encoding="application/x-tex">{}_{\text{avg}}</annotation></semantics></math></td></tr>
<tr id="A2.T6.1.3" class="ltx_tr">
