<td id="S3.T3.8.1.2.8" class="ltx_td ltx_align_center ltx_border_t">RA<math id="S3.T3.m8" class="ltx_Math" alttext="{}_{\text{avg}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>avg</mtext></msub><annotation encoding="application/x-tex">{}_{\text{avg}}</annotation></semantics></math></td></tr>
