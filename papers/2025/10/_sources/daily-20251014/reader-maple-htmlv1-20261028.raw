<td id="S5.T8.4.9.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T8.4.9.2.1" class="ltx_text ltx_font_bold">33 (73.3%)</span></td>
<td id="S5.T8.4.9.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T8.4.9.3.1" class="ltx_text ltx_font_bold">10 (22.2%)</span></td>
<td id="S5.T8.4.9.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T8.4.9.4.1" class="ltx_text ltx_font_bold">2 (4.4%)</span></td></tr>
