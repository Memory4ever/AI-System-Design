<td id="S5.T2.5.3.2" class="ltx_td ltx_align_center"><span id="S5.T2.5.3.2.1" class="ltx_text" style="font-size:90%;">99.63 ± 0.65</span></td>
<td id="S5.T2.5.3.3" class="ltx_td ltx_align_center"><span id="S5.T2.5.3.3.1" class="ltx_text" style="font-size:90%;">99.24 ± 0.03</span></td>
<td id="S5.T2.5.3.4" class="ltx_td ltx_align_center"><span id="S5.T2.5.3.4.1" class="ltx_text" style="font-size:90%;">99.42 ± 0.33</span></td>
<td id="S5.T2.5.3.5" class="ltx_td ltx_align_center"><span id="S5.T2.5.3.5.1" class="ltx_text" style="font-size:90%;">–</span></td></tr>
