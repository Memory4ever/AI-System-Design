<th id="S5.T2.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Precision (%)</span></th>
<th id="S5.T2.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Recall (%)</span></th>
<th id="S5.T2.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.5.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">F1-Score (%)</span></th>
<th id="S5.T2.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.5.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Accuracy (%)</span></th></tr>
</thead>
