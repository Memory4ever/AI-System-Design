<td id="S5.T2.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.2.2.1" class="ltx_text" style="font-size:90%;">94.20 ± 0.91</span></td>
<td id="S5.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.2.3.1" class="ltx_text" style="font-size:90%;">95.73 ± 0.43</span></td>
<td id="S5.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.2.4.1" class="ltx_text" style="font-size:90%;">94.89 ± 0.67</span></td>
<td id="S5.T2.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.2.5.1" class="ltx_text" style="font-size:90%;">–</span></td></tr>
