<figure id="algorithm2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span><span id="algorithm2.5" class="ltx_text ltx_font_smallcaps">SplitKUpdate</span>(<math id="algorithm2.m3" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>, <math id="algorithm2.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>)</figcaption>
<div id="algorithm2.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm2.6.1" class="ltx_listingline">
<span id="algorithm2.6.1.1" class="ltx_text"><span id="algorithm2.6.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><math id="algorithm2.m5" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>: the target loop nest to be fused
</div>
<div id="algorithm2.6.2" class="ltx_listingline"><span id="algorithm2.6.2.1" class="ltx_text"><span id="algorithm2.6.2.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><math id="algorithm2.m6" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>: the target loop to fuse <math id="algorithm2.m7" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> under
</div>
<div id="algorithm2.6.3" class="ltx_listingline"><span id="algorithm2.6.3.1" class="ltx_text"><span id="algorithm2.6.3.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>A pair of loop nests: the local and global versions of fused <math id="algorithm2.m8" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>
</div>
<div id="algorithm2.6.4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.4.1" class="ltx_text ltx_font_bold">1</span></span>
            <math id="algorithm2.m9" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> = <span id="algorithm2.6.4.2" class="ltx_text ltx_font_smallcaps">InlineMapReturnReduce</span>(<math id="algorithm2.m10" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>);
</div>
<div id="algorithm2.6.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.5.1" class="ltx_text ltx_font_bold">2</span></span>
            <math id="algorithm2.m11" class="ltx_Math" alttext="(M^{\text{local}},M^{\text{global}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mtext>local</mtext></msup><mo>,</mo><msup><mi>M</mi><mtext>global</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M^{\text{local}},M^{\text{global}})</annotation></semantics></math> = (dict(), dict());
</div>
<div id="algorithm2.6.6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.6.1" class="ltx_text ltx_font_bold">3</span></span>
            <span id="algorithm2.6.6.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.6.6.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m12" class="ltx_Math" alttext="L\in\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">L\in\mathcal{L}_{r}</annotation></semantics></math></em> <span id="algorithm2.6.6.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.6.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.7.1" class="ltx_text ltx_font_bold">4</span></span>
            <math id="algorithm2.m13" class="ltx_Math" alttext="(L^{\text{local}},L^{\text{global}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mtext>local</mtext></msup><mo>,</mo><msup><mi>L</mi><mtext>global</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L^{\text{local}},L^{\text{global}})</annotation></semantics></math> = <span id="algorithm2.6.7.2" class="ltx_text ltx_font_smallcaps">FuseAndPrivatize</span>(<math id="algorithm2.m14" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, <math id="algorithm2.m15" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>);
</div>
<div id="algorithm2.6.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.8.1" class="ltx_text ltx_font_bold">5</span></span>
            <math id="algorithm2.m16" class="ltx_Math" alttext="(M^{\text{local}}[L],M^{\text{global}}[L])" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msup><mi>M</mi><mtext>local</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>M</mi><mtext>global</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M^{\text{local}}[L],M^{\text{global}}[L])</annotation></semantics></math> = <math id="algorithm2.m17" class="ltx_Math" alttext="(L^{\text{local}},L^{\text{global}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mtext>local</mtext></msup><mo>,</mo><msup><mi>L</mi><mtext>global</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L^{\text{local}},L^{\text{global}})</annotation></semantics></math>;
</div>
<div id="algorithm2.6.9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.9.1" class="ltx_text ltx_font_bold">6</span></span>
            <math id="algorithm2.m18" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> = <span id="algorithm2.6.9.2" class="ltx_text ltx_font_smallcaps">ReplaceTensorReads</span>(<math id="algorithm2.m19" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>, <math id="algorithm2.m20" class="ltx_Math" alttext="M^{\text{local}}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mtext>local</mtext></msup><annotation encoding="application/x-tex">M^{\text{local}}</annotation></semantics></math>);
</div>
<div id="algorithm2.6.10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.10.1" class="ltx_text ltx_font_bold">7</span></span>
            <math id="algorithm2.m21" class="ltx_Math" alttext="(L_{t}^{\text{local}},L_{t}^{\text{global}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>t</mi><mtext>local</mtext></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>t</mi><mtext>global</mtext></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L_{t}^{\text{local}},L_{t}^{\text{global}})</annotation></semantics></math> = <span id="algorithm2.6.10.2" class="ltx_text ltx_font_smallcaps">FuseAndPrivatize</span>(<math id="algorithm2.m22" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>, <math id="algorithm2.m23" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>);
</div>
<div id="algorithm2.6.11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.11.1" class="ltx_text ltx_font_bold">8</span></span>
            <math id="algorithm2.m24" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> = <span id="algorithm2.6.11.2" class="ltx_text ltx_font_smallcaps">RollingUpdateSolveRepairFunc</span>(<math id="algorithm2.m25" class="ltx_Math" alttext="L_{t}^{\text{local}},\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>t</mi><mtext>local</mtext></msubsup><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">L_{t}^{\text{local}},\mathcal{L}_{r}</annotation></semantics></math>);
</div>
<div id="algorithm2.6.12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.12.1" class="ltx_text ltx_font_bold">9</span></span>
            <math id="algorithm2.m26" class="ltx_Math" alttext="L_{t}^{\text{global}}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>t</mi><mtext>global</mtext></msubsup><annotation encoding="application/x-tex">L_{t}^{\text{global}}</annotation></semantics></math> = <span id="algorithm2.6.12.2" class="ltx_text ltx_font_smallcaps">SplitKApplyRepairTerm</span>(<math id="algorithm2.m27" class="ltx_Math" alttext="L_{t}^{\text{global}}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>t</mi><mtext>global</mtext></msubsup><annotation encoding="application/x-tex">L_{t}^{\text{global}}</annotation></semantics></math>, <math id="algorithm2.m28" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>, <math id="algorithm2.m29" class="ltx_Math" alttext="M^{\text{local}}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mtext>local</mtext></msup><annotation encoding="application/x-tex">M^{\text{local}}</annotation></semantics></math>);
</div>
<div id="algorithm2.6.13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.13.1" class="ltx_text ltx_font_bold">10</span></span>
            <span id="algorithm2.6.13.2" class="ltx_text ltx_font_bold">return</span> <em id="algorithm2.6.13.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m30" class="ltx_Math" alttext="(L_{t}^{\text{local}},L_{t}^{\text{global}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>t</mi><mtext class="ltx_mathvariant_italic">local</mtext></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>t</mi><mtext class="ltx_mathvariant_italic">global</mtext></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L_{t}^{\text{local}},L_{t}^{\text{global}})</annotation></semantics></math></em>;
</div>
<div id="algorithm2.6.14" class="ltx_listingline">
</div>
</div>
</figure>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p">Algorithm <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> outlines the split-k update algorithm.
We explain this algorithm in comparison to rolling update:</p>
<ul id="S4.I2" class="ltx_itemize" style="--ltx-enum-leftmargin:1em;">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p">Split-k update applies step 1 of rolling update to get <math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p">On algorithm lines <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> to <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>,
split-k update uses the fusion + privatization primitive
to fuse all reduce predecessors of <math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> under <math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>,
and tracks their local and global loop nests.</p>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p">Line <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> replaces tensor reads in <math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>
such that it reads from the local nests of the reduce predecessors.
Line <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> fuses and privatizes <math id="S4.I2.i3.p1.m2" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> under <math id="S4.I2.i3.p1.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i4.p1" class="ltx_para">
<p id="S4.I2.i4.p1.1" class="ltx_p">Line <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> reuses rolling update steps 3 and 4 to find the repair function <math id="S4.I2.i4.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>
from <math id="S4.I2.i4.p1.m2" class="ltx_Math" alttext="L_{t}^{\text{local}}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>t</mi><mtext>local</mtext></msubsup><annotation encoding="application/x-tex">L_{t}^{\text{local}}</annotation></semantics></math>, which we show as a single line.</p>
</div></li>
<li id="S4.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i5.p1" class="ltx_para">
<p id="S4.I2.i5.p1.1" class="ltx_p">Line <a href="#algorithm2" title="In 4.3. Split-K Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> applies the repair function <math id="S4.I2.i5.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> to the global nest <math id="S4.I2.i5.p1.m2" class="ltx_Math" alttext="L_{t}^{\text{global}}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>t</mi><mtext>global</mtext></msubsup><annotation encoding="application/x-tex">L_{t}^{\text{global}}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S4.SS3.p4" class="ltx_para ltx_noindent">
<p id="S4.SS3.p4.1" class="ltx_p"><span id="S4.SS3.p4.1.1" class="ltx_text ltx_font_bold">Applying the Repair Function <math id="S4.SS3.p4.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> (Split-K).</span>
Split-k update does not apply the repair function to the local section, keeping the local section parallelizable.
Instead, it repairs the global loop nest <math id="S4.SS3.p4.m2" class="ltx_Math" alttext="L_{t}^{\text{global}}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>t</mi><mtext>global</mtext></msubsup><annotation encoding="application/x-tex">L_{t}^{\text{global}}</annotation></semantics></math> to make the final result correct.
Another difference from rolling update is that split-k applies the repair function on the right-hand side of the reducer.
Both differences show in the example:
<span id="S4.SS3.p4.1.2" class="ltx_text ltx_font_typewriter">s_sum_global</span> has the store statement <span id="S4.SS3.p4.1.3" class="ltx_text ltx_font_typewriter">sum_g[i] = sum_g[i] + <span id="S4.SS3.p4.1.3.1" class="ltx_text ltx_ulem_uline">exp(max_l[i, j0] - max_g[i])</span> * sum_l[i, j0]</span>
where the underlined term is the repair term.</p>
</div>
<div id="S4.SS3.p5" class="ltx_para">
<p id="S4.SS3.p5.1" class="ltx_p">Split-k update applies the repair function with this rewrite:</p>
<table id="S4.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex13.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0.6992,0.3359,0.1563}X_{t,g}[\phi_{t,g}(\boldsymbol{i})]}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">X</mi><mrow><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">t</mi><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628">,</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">ϕ</mi><mrow><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">t</mi><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628">,</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">(</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">𝒊</mi><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0.6992,0.3359,0.1563}X_{t,g}[\phi_{t,g}(\boldsymbol{i})]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex13.m2" class="ltx_Math" alttext="\displaystyle={\color[rgb]{0.6992,0.3359,0.1563}X_{t,g}[\phi_{t,g}(\boldsymbol{i})]}\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ {\color[rgb]{0.6992,0.3359,0.1563}X_{t,l}[\phi_{t,l}(\boldsymbol{i})]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">X</mi><mrow><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">t</mi><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628">,</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">ϕ</mi><mrow><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">t</mi><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628">,</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">g</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">(</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">𝒊</mi><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#B25628;" mathcolor="#B25628" stretchy="false">]</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#00