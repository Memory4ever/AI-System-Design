<span id="lstnumberx141.23" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx141.24" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx141.25" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx141.26" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx141.27" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j1</span><span id="lstnumberx141.28" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx141.29" class="ltx_text" style="font-size:90%;">*</span><span id="lstnumberx141.30" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx141.31" class="ltx_text" style="font-size:90%;">2</span><span id="lstnumberx141.32" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx141.33" class="ltx_text" style="font-size:90%;">+</span><span id="lstnumberx141.34" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx141.35" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j2</span><span id="lstnumberx141.36" class="ltx_text" style="font-size:90%;">])</span>
