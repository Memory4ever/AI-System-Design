<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex19.m1" class="ltx_Math" alttext="\displaystyle y=g(x,c)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">g</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">c</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle y=g(x,c)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex19.m2" class="ltx_Math" alttext="\displaystyle=\exp(c-x)\ \Rightarrow\ c=g_{c}^{-1}(x,y)=x+\ln(y)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">x</mi></mrow><mo maxsize="0.900em" minsize="0.900em" rspace="0.460em">)</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.738em" stretchy="false">⇒</mo><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">=</mo><mrow><msubsup><mi mathsize="0.900em">g</mi><mi mathsize="0.900em">c</mi><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">ln</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(c-x)\ \Rightarrow\ c=g_{c}^{-1}(x,y)=x+\ln(y)</annotation></semantics></math></td>
