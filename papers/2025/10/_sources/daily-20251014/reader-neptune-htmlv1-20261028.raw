<td id="S8.T4.5.5.4" class="ltx_td ltx_align_center" style="padding-top:-0.3pt;padding-bottom:-0.3pt;"><span id="S8.T4.5.5.4.1" class="ltx_text" style="font-size:90%;">0.99</span></td>
<td id="S8.T4.5.5.5" class="ltx_td ltx_align_center" style="padding-top:-0.3pt;padding-bottom:-0.3pt;"><span id="S8.T4.5.5.5.1" class="ltx_text" style="font-size:90%;">5.32</span></td></tr>
