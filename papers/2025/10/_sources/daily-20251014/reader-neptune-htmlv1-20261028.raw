\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ expr(\boldsymbol{i},\boldsymbol{j})\ \}" display="block" intent=":literal"><semantics><mrow><mi>r</mi><mi>n</mi><mi>e</mi><mi>s</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝒏</mi><mo>,</mo><mi>𝒋</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝒎</mi><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0.500em" stretchy="false">{</mo><mi>X</mi><mrow><mo stretchy="false">[</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>X</mi><mrow><mo stretchy="false">[</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.500em" stretchy="false">]</mo></mrow><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)"> <foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="6.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.800em">f</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mi>e</mi><mi>x</mi><mi>p</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><m