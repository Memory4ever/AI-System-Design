<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_lst_space" style="font-size:80%;">  </span><span id="lstnumberx22.2" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_0</span><span id="lstnumberx22.3" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx22.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx22.5" class="ltx_text" style="font-size:80%;">]</span><span id="lstnumberx22.6" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx22.7" class="ltx_text" style="font-size:80%;">=</span><span id="lstnumberx22.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx22.9" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx22.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;">inf</span>
</div>
<div id="lstnumberx23" class="ltx_listingline"><span id="lstnumberx23.1" class="ltx_text ltx_lst_space" style="font-size:80%;">  </span><span id="lstnumberx23.2" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:80%;">for</span><span id="lstnumberx23.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx23.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">j</span><span id="lstnumberx23.5" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx23.6" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:80%;">in</span><span id="lstnumberx23.7" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx23.8" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="font-size:80%;">range</span><span id="lstnumberx23.9" class="ltx_text" style="font-size:80%;">(4):</span><span id="lstnumberx23.10" class="ltx_text ltx_lst_space" style="font-size:80%;">  </span><span id="lstnumberx23.11" class="ltx_text ltx_lst_comment ltx_font_italic" style="font-size:80%;">#<span id="lstnumberx23.11.1" class="ltx_text ltx_lst_space"> </span>loop_j</span>
</div>
<div id="lstnumberx24" class="ltx_listingline"><span id="lstnumberx24.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx24.2" class="ltx_text ltx_lst_comment ltx_font_italic" style="font-size:80%;">#<span id="lstnumberx24.2.1" class="ltx_text ltx_lst_space"> </span>s_max:</span>
</div>
<div id="lstnumberx25" class="ltx_listingline"><span id="lstnumberx25.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx25.2" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_1</span><span id="lstnumberx25.3" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx25.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx25.5" class="ltx_text" style="font-size:80%;">]</span><span id="lstnumberx25.6" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx25.7" class="ltx_text" style="font-size:80%;">=</span><span id="lstnumberx25.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx25.9" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="font-size:80%;">max</span><span id="lstnumberx25.10" class="ltx_text" style="font-size:80%;">(</span><span id="lstnumberx25.11" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_0</span><span id="lstnumberx25.12" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx25.13" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx25.14" class="ltx_text" style="font-size:80%;">],</span><span id="lstnumberx25.15" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx25.16" class="ltx_text ltx_lst_identifier" style="font-size:80%;">inp</span><span id="lstnumberx25.17" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx25.18" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx25.19" class="ltx_text" style="font-size:80%;">,</span><span id="lstnumberx25.20" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx25.21" class="ltx_text ltx_lst_identifier" style="font-size:80%;">j</span><span id="lstnumberx25.22" class="ltx_text" style="font-size:80%;">])</span>
</div>
<div id="lstnumberx26" class="ltx_listingline"><span id="lstnumberx26.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx26.2" class="ltx_text ltx_lst_comment ltx_font_italic" style="font-size:80%;">#<span id="lstnumberx26.2.1" class="ltx_text ltx_lst_space"> </span>s_sum:</span>
</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx27.2" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xsum</span><span id="lstnumberx27.3" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx27.5" class="ltx_text" style="font-size:80%;">]</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.7" class="ltx_text" style="font-size:80%;">=</span><span id="lstnumberx27.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx27.9" class="ltx_text" style="font-size:80%;">(</span>
</div>
<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_lst_space" style="font-size:80%;">      </span><span id="lstnumberx28.2" class="ltx_text ltx_lst_identifier" style="font-size:80%;">exp</span><span id="lstnumberx28.3" class="ltx_text" style="font-size:80%;">(</span><span id="lstnumberx28.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_0</span><span id="lstnumberx28.5" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx28.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx28.7" class="ltx_text" style="font-size:80%;">]</span><span id="lstnumberx28.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.9" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx28.10" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.11" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_1</span><span id="lstnumberx28.12" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx28.13" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx28.14" class="ltx_text" style="font-size:80%;">])</span><span id="lstnumberx28.15" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.16" class="ltx_text" style="font-size:80%;">*</span><span id="lstnumberx28.17" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx28.18" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xsum</span><span id="lstnumberx28.19" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx28.20" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx28.21" class="ltx_text" style="font-size:80%;">]</span>
</div>
<div id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_lst_space" style="font-size:80%;">      </span><span id="lstnumberx29.2" class="ltx_text" style="font-size:80%;">+</span><span id="lstnumberx29.3" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">exp</span><span id="lstnumberx29.5" class="ltx_text" style="font-size:80%;">(</span><span id="lstnumberx29.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;">inp</span><span id="lstnumberx29.7" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx29.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx29.9" class="ltx_text" style="font-size:80%;">,</span><span id="lstnumberx29.10" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.11" class="ltx_text ltx_lst_identifier" style="font-size:80%;">j</span><span id="lstnumberx29.12" class="ltx_text" style="font-size:80%;">]</span><span id="lstnumberx29.13" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.14" class="ltx_text" style="font-size:80%;">-</span><span id="lstnumberx29.15" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx29.16" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_1</span><span id="lstnumberx29.17" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx29.18" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx29.19" class="ltx_text" style="font-size:80%;">]))</span>
</div>
<div id="lstnumberx30" class="ltx_listingline"><span id="lstnumberx30.1" class="ltx_text ltx_lst_space" style="font-size:80%;">    </span><span id="lstnumberx30.2" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_0</span><span id="lstnumberx30.3" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx30.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx30.5" class="ltx_text" style="font-size:80%;">]</span><span id="lstnumberx30.6" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx30.7" class="ltx_text" style="font-size:80%;">=</span><span id="lstnumberx30.8" class="ltx_text ltx_lst_space" style="font-size:80%;"> </span><span id="lstnumberx30.9" class="ltx_text ltx_lst_identifier" style="font-size:80%;">xmax_1</span><span id="lstnumberx30.10" class="ltx_text" style="font-size:80%;">[</span><span id="lstnumberx30.11" class="ltx_text ltx_lst_identifier" style="font-size:80%;">i</span><span id="lstnumberx30.12" class="ltx_text" style="font-size:80%;">]</span>
</div>
</div>
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.sf3.12" class="ltx_text" style="font-size:113%;">(c)</span> </span><span id="S2.F1.sf3.13" class="ltx_text" style="font-size:113%;">Correct fusion of Figure <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(a)</span></a>,
which also inlines <span id="S2.F1.sf3.13.1" class="ltx_text ltx_font_typewriter">s_exp</span> and edits the compute expressions of <span id="S2.F1.sf3.13.2" class="ltx_text ltx_font_typewriter">s_sum</span>
in addition to Figure <a href="#S2.F1.sf2" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(b)</span></a>.</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S2.F1.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.08726v1/x1.png" id="S2.F1.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:500/283;" width="500" height="283" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.sf4.8" class="ltx_text" style="font-size:113%;">(d)</span> </span><span id="S2.F1.sf4.9" class="ltx_text" style="font-size:113%;">Materialized example of Figure <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(a)</span></a>.
Data dependencies are shown in <span id="S2.F1.sf4.9.1" class="ltx_text" style="--ltx-fg-color:#4E95D9;">blue</span>.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S2.F1.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.08726v1/x2.png" id="S2.F1.sf5.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:419/375;" width="419" height="375" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.sf5.10" class="ltx_text" style="font-size:113%;">(e)</span> </span><span id="S2.F1.sf5.11" class="ltx_text" style="font-size:113%;">Materialized example of Figure <a href="#S2.F1.sf2" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(b)</span></a>; <span id="S2.F1.sf5.11.1" class="ltx_text ltx_font_typewriter">inp</span> is omitted;
incorrect results and dependencies in <span id="S2.F1.sf5.11.2" class="ltx_text" style="--ltx-fg-color:#B25628;">orange</span>.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S2.F1.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.08726v1/x3.png" id="S2.F1.sf6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:467/302;" width="467" height="302" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.sf6.10" class="ltx_text" style="font-size:113%;">(f)</span> </span><span id="S2.F1.sf6.11" class="ltx_text" style="font-size:113%;">Materialized example of the correctly fused Figure <a href="#S2.F1.sf3" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(c)</span></a>.
Values of the repair term and the repaired <span id="S2.F1.sf6.11.1" class="ltx_text ltx_font_typewriter">xsum</span> are shown in <span id="S2.F1.sf6.11.2" class="ltx_text" style="--ltx-fg-color:#278117;">green</span>. Note, <math id="S2.F1.sf6.m2" class="ltx_Math" alttext="{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 3\rangle}}={\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle 3\rangle}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">i</mi><mrow><mo maxsize="1.580em" minsize="1.580em" stretchy="true">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117">3</mn><mo maxsize="1.580em" minsize="1.580em" stretchy="true">⟩</mo></mrow></msubsup><mo>=</mo><msubsup><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">s</mi><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">i</mi><mrow><mo maxsize="1.580em" minsize="1.580em" stretchy="true">⟨</mo><mn style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">3</mn><mo maxsize="1.580em" minsize="1.580em" stretchy="true">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 3\rangle}}={\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle 3\rangle}}</annotation></semantics></math></span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering" style="font-size:80%;"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.13" class="ltx_text" style="font-size:113%;">Figure 1</span>. </span><span id="S2.F1.14" class="ltx_text" style="font-size:113%;">An example program requiring reduction fusion, incorrect result using naive loop fusion,
and a correctly fused program, shown on the first row.
The second row (“materialized example”) shows the values of each matrix in the programs
when applied to a concrete <span id="S2.F1.14.1" class="ltx_text ltx_font_typewriter">inp</span> matrix.
<span id="S2.F1.14.2" class="ltx_text ltx_font_typewriter">xmax</span> and <span id="S2.F1.14.3" class="ltx_text ltx_font_typewriter">xsum</span> are each shown four times since their values vary over <span id="S2.F1.14.4" class="ltx_text ltx_font_typewriter">j</span> iterations.</span></figcaption>
</figure>
<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">Figure <a href="#S2.F1" title="Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> shows
an example of the reduction fusion problem, where data dependencies make loop fusion challenging.
The code in Figure <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(a)</span></a> runs on a 2-by-4 matrix <span id="S2.p1.1.1" class="ltx_text ltx_font_typewriter">inp</span>
and has three loop nests:
a row-wise max <span id="S2.p1.1.2" class="ltx_text ltx_font_typewriter">s_max</span>, an element-wise exponential <span id="S2.p1.1.3" class="ltx_text ltx_font_typewriter">s_exp</span>, and a row-wise sum <span id="S2.p1.1.4" class="ltx_text ltx_font_typewriter">s_sum</span>.
Figure <a href="#S2.F1.sf4" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(d)</span></a> shows a concrete execution of the program,
where blue arrows mark data dependencies.
We denote <math id="S2.p1.m1" class="ltx_Math" alttext="x_{ij}:=\texttt{inp[i, j]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>:=</mo><mtext class="ltx_mathvariant_monospace">inp[i, j]</mtext></mrow><annotation encoding="application/x-tex">x_{ij}:=\texttt{inp[i, j]}</annotation></semantics></math>, <math id="S2.p1.m2" class="ltx_Math" alttext="p_{ij}:=\texttt{{xexp}[i, j]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>:=</mo><mtext class="ltx_mathvariant_monospace">xexp[i, j]</mtext></mrow><annotation encoding="application/x-tex">p_{ij}:=\texttt{{xexp}[i, j]}</annotation></semantics></math>.
We denote <math id="S2.p1.m3" class="ltx_Math" alttext="s_{i}^{\langle j\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">s_{i}^{\langle j\rangle}</annotation></semantics></math> as the value of <span id="S2.p1.1.5" class="ltx_text ltx_font_typewriter">xsum[i]</span> at iteration <math id="S2.p1.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>,
and <math id="S2.p1.m5" class="ltx_Math" alttext="m_{i}^{\langle j\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle j\rangle}</annotation></semantics></math> as the value of <span id="S2.p1.1.6" class="ltx_text ltx_font_typewriter">xmax[i]</span> at iteration <math id="S2.p1.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>.
<span id="S2.p1.1.7" class="ltx_text">The final result of this program is <math id="S2.p1.m7" class="ltx_Math" alttext="{\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle 3\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">s</mi><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">3</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle 3\rangle}}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p">Fusing <span id="S2.p2.1.1" class="ltx_text ltx_font_typewriter">s_exp</span> into the reduce loop nest <span id="S2.p2.1.2" class="ltx_text ltx_font_typewriter">s_max</span> is an example of reduction fusion
that today’s loop fusion is not capable of.
Figure <a href="#S2.F1.sf2" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(b)</span></a> shows the incorrect program that current loop fusion would produce,
if we naively fuse <span id="S2.p2.1.3" class="ltx_text ltx_font_typewriter">s_exp</span> and <span id="S2.p2.1.4" class="ltx_text ltx_font_typewriter">s_sum</span> into <span id="S2.p2.1.5" class="ltx_text ltx_font_typewriter">s_max</span>, by disregarding loop-carried dependencies between the <span id="S2.p2.1.6" class="ltx_text ltx_font_typewriter">s_max</span> and <span id="S2.p2.1.7" class="ltx_text ltx_font_typewriter">s_exp</span>.
Figure <a href="#S2.F1.sf5" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(e)</span></a> shows its
execution on a concrete <span id="S2.p2.1.8" class="ltx_text ltx_font_typewriter">inp</span> matrix, illustrating why the naive fusion is incorrect:
fusing <span id="S2.p2.1.9" class="ltx_text ltx_font_typewriter">s_exp</span> under <span id="S2.p2.1.10" class="ltx_text ltx_font_typewriter">loop_j</span> changes some <span id="S2.p2.1.11" class="ltx_text ltx_font_typewriter">s_exp</span> iterations to read from <span id="S2.p2.1.12" class="ltx_text ltx_font_typewriter">xmax</span> too early.
The brown arrows mark these incorrect data dependencies.
For example, in the first iteration, <math id="S2.p2.m1" class="ltx_Math" alttext="{\color[rgb]{0.6992,0.3359,0.1563}p_{i0}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">p</mi><mrow><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">i</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#B25628;" mathcolor="#B25628">0</mn></mrow></msub><annotation encoding="application/x-tex">{\color[rgb]{0.6992,0.3359,0.1563}p_{i0}}</annotation></semantics></math> reads from <math id="S2.p2.m2" class="ltx_Math" alttext="m_{i}^{\langle 0\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle 0\rangle}</annotation></semantics></math>
at the same iteration, instead of <math id="S2.p2.m3" class="ltx_Math" alttext="m_{i}^{\langle 3\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mn>3</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle 3\rangle}</annotation></semantics></math> computed after 4 iterations.
Thus, the result of <math id="S2.p2.m4" class="ltx_Math" alttext="{\color[rgb]{0.6992,0.3359,0.1563}p_{ij}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">p</mi><mrow><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">j</mi></mrow></msub><annotation encoding="application/x-tex">{\color[rgb]{0.6992,0.3359,0.1563}p_{ij}}</annotation></semantics></math> is incorrect and propagates to the final result <math id="S2.p2.m5" class="ltx_Math" alttext="{\color[rgb]{0.6992,0.3359,0.1563}s_{i}^{\langle 3\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">s</mi><mi style="--ltx-fg-color:#B25628;" mathcolor="#B25628">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#B25628;" mathcolor="#B25628">3</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.6992,0.3359,0.1563}s_{i}^{\langle 3\rangle}}</annotation></semantics></math>.
In practice, tensor compilers would reject this incorrect fusion.</p>
</div>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p">However, correct reduction fusion is possible if we <span id="S2.p3.1.1" class="ltx_text ltx_font_italic">update the compute expressions</span>
in addition to changing the loop <span id="S2.p3.1.2" class="ltx_text">structure.</span>
We can find new expressions for <span id="S2.p3.1.3" class="ltx_text ltx_font_typewriter">s_exp</span> and <span id="S2.p3.1.4" class="ltx_text ltx_font_typewriter">s_sum</span>
that not only compute results for the current iteration,
but also <span id="S2.p3.1.5" class="ltx_text ltx_font_italic">repair</span> results from the previous iteration,
as we move <span id="S2.p3.1.6" class="ltx_text">forward</span> in the reduce dimension <math id="S2.p3.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>.
Figure <a href="#S2.F1.sf3" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(c)</span></a> shows the correct fusion result that builds on this idea.
This program multiplies a <span id="S2.p3.1.7" class="ltx_text ltx_font_italic">repair term</span>
<span id="S2.p3.1.8" class="ltx_text ltx_font_typewriter">exp(xmax_0[i] - xmax_1[i])</span> with <span id="S2.p3.1.9" class="ltx_text ltx_font_typewriter">xsum[i]</span>.
Figure <a href="#S2.F1.sf6" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(f)</span></a> shows the values of this repair term
and the repaired <math id="S2.p3.m2" class="ltx_Math" alttext="{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle j\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">i</mi><mrow><mo stretchy="false">⟨</mo><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle j\rangle}}</annotation></semantics></math> values.
The repaired program is correct because <math id="S2.p3.m3" class="ltx_Math" alttext="{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 3\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117">3</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 3\rangle}}</annotation></semantics></math> is equal to <math id="S2.p3.m4" class="ltx_Math" alttext="{\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle 3\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">s</mi><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">3</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle 3\rangle}}</annotation></semantics></math>,
even though <math id="S2.p3.m5" class="ltx_Math" alttext="{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle j\rangle}}\neq{\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle j\rangle}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">i</mi><mrow><mo stretchy="false">⟨</mo><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>≠</mo><msubsup><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">s</mi><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">i</mi><mrow><mo stretchy="false">⟨</mo><mi style="--ltx-fg-color:#4E95D9;" mathcolor="#4E95D9">j</mi><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle j\rangle}}\neq{\color[rgb]{0.3047,0.5859,0.8516}s_{i}^{\langle j\rangle}}</annotation></semantics></math> for <math id="S2.p3.m6" class="ltx_Math" alttext="j&lt;3" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">j&lt;3</annotation></semantics></math>.</p>
</div>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p">To show how the repair term repairs the <span id="S2.p4.1.1" class="ltx_text ltx_markedasmath ltx_font_typewriter">xsum[i]</span> at every <math id="S2.p4.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> iteration,
we write out <math id="S2.p4.m3" class="ltx_Math" alttext="{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle j\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">i</mi><mrow><mo stretchy="false">⟨</mo><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle j\rangle}}</annotation></semantics></math> for three iterations,
as an expression of <math id="S2.p4.m4" class="ltx_Math" alttext="x_{ij}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">x_{ij}</annotation></semantics></math> and <math id="S2.p4.m5" class="ltx_Math" alttext="m_{i}^{\langle j\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle j\rangle}</annotation></semantics></math>:</p>
</div>
<div id="S2.p5" class="ltx_para">
<table id="S2.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex1.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 0\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 0\rangle}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex1.m2" class="ltx_Math" alttext="\displaystyle=\exp(x_{i0}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}0}\rangle});" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">0</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">0</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(x_{i0}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}0}\rangle});</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex2.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 1\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 1\rangle}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex2.m2" class="ltx_Math" alttext="\displaystyle=\exp(m_{i}^{\langle 0\rangle}-m_{i}^{\langle 1\rangle})\cdot{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 0\rangle}}+\exp(x_{i1}-m_{i}^{\langle 1\rangle})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" rspace="0.055em">)</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">⋅</mo><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">0</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(m_{i}^{\langle 0\rangle}-m_{i}^{\langle 1\rangle})\cdot{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 0\rangle}}+\exp(x_{i1}-m_{i}^{\langle 1\rangle})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex3.m1" class="ltx_Math" alttext="\displaystyle=\exp(\cancel{m_{i}^{\langle 0\rangle}}-m_{i}^{\langle 1\rangle})\cdot{\color[rgb]{0.1523,0.5078,0.0898}\exp(x_{i0}-\cancel{m_{i}^{\langle 0\rangle}})}+\exp(x_{i1}-m_{i}^{\langle 1\rangle})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><menclose notation="updiagonalstrike"><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">0</mn><mo stretchy="false">⟩</mo></mrow></msubsup></menclose><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" rspace="0.055em">)</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">x</mi><mrow><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">0</mn></mrow></msub><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">−</mo><menclose style="--ltx-fg-color:#278117;" mathcolor="#278117" notation="updiagonalstrike"><mstyle style="--ltx-fg-color:#278117;" mathcolor="#278117"><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">m</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟩</mo></mrow></msubsup></mstyle></menclose></mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(\cancel{m_{i}^{\langle 0\rangle}}-m_{i}^{\langle 1\rangle})\cdot{\color[rgb]{0.1523,0.5078,0.0898}\exp(x_{i0}-\cancel{m_{i}^{\langle 0\rangle}})}+\exp(x_{i1}-m_{i}^{\langle 1\rangle})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex4.m1" class="ltx_Math" alttext="\displaystyle=\exp(x_{i0}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}1}\rangle})+\exp(x_{i1}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}1}\rangle})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">0</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(x_{i0}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}1}\rangle})+\exp(x_{i1}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}1}\rangle})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex5.m1" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 2\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">s</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">2</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0.1523,0.5078,0.0898}s_{i}^{\langle 2\rangle}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex5.m2" class="ltx_Math" alttext="\displaystyle=\exp(\cancel{m_{i}^{\langle 1\rangle}}-m_{i}^{\langle 2\rangle})\cdot\left({\color[rgb]{0.1523,0.5078,0.0898}\exp(x_{i0}-\cancel{m_{i}^{\langle 1\rangle}})+\exp(x_{i1}-\cancel{m_{i}^{\langle 1\rangle}})}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><menclose notation="updiagonalstrike"><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">1</mn><mo stretchy="false">⟩</mo></mrow></msubsup></menclose><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">2</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em" rspace="0.055em">)</mo></mrow></mrow><mo mathsize="0.900em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">x</mi><mrow><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">0</mn></mrow></msub><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">−</mo><menclose style="--ltx-fg-color:#278117;" mathcolor="#278117" notation="updiagonalstrike"><mstyle style="--ltx-fg-color:#278117;" mathcolor="#278117"><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">m</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟩</mo></mrow></msubsup></mstyle></menclose></mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">+</mo><mrow><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">x</mi><mrow><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">1</mn></mrow></msub><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">−</mo><menclose style="--ltx-fg-color:#278117;" mathcolor="#278117" notation="updiagonalstrike"><mstyle style="--ltx-fg-color:#278117;" mathcolor="#278117"><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">m</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">i</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⟩</mo></mrow></msubsup></mstyle></menclose></mrow><mo style="--ltx-fg-color:#278117;" mathcolor="#278117" maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(\cancel{m_{i}^{\langle 1\rangle}}-m_{i}^{\langle 2\rangle})\cdot\left({\color[rgb]{0.1523,0.5078,0.0898}\exp(x_{i0}-\cancel{m_{i}^{\langle 1\rangle}})+\exp(x_{i1}-\cancel{m_{i}^{\langle 1\rangle}})}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex6.m1" class="ltx_Math" alttext="\displaystyle+\exp(x_{i2}-m_{i}^{\langle 2\rangle})" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em" rspace="0.167em">+</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">2</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn mathsize="0.900em">2</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\exp(x_{i2}-m_{i}^{\langle 2\rangle})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex7.m1" class="ltx_Math" alttext="\displaystyle=\exp(x_{i0}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}2}\rangle})+\exp(x_{i1}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}2}\rangle})+\exp(x_{i2}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}2}\rangle})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><mrow><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">0</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">2</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">1</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">2</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msub><mi mathsize="0.900em">x</mi><mrow><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.900em">2</mn></mrow></msub><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">m</mi><mi mathsize="0.900em">i</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117" mathsize="0.900em">2</mn><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp(x_{i0}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}2}\rangle})+\exp(x_{i1}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}2}\rangle})+\exp(x_{i2}-m_{i}^{\langle{\color[rgb]{0.1523,0.5078,0.0898}2}\rangle})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.p6" class="ltx_para">
<p id="S2.p6.1" class="ltx_p">We observe that the following behavior is key to a working repair term:
at each iteration <math id="S2.p6.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, the repair term multiplies with the previous iteration result
<math id="S2.p6.m2" class="ltx_Math" alttext="s_{i}^{\langle j-1\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">s_{i}^{\langle j-1\rangle}</annotation></semantics></math>, which is an expression of <math id="S2.p6.m3" class="ltx_Math" alttext="m_{i}^{\langle j-1\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle j-1\rangle}</annotation></semantics></math>,
and replaces all uses of <math id="S2.p6.m4" class="ltx_Math" alttext="m_{i}^{\langle j-1\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle j-1\rangle}</annotation></semantics></math> with <math id="S2.p6.m5" class="ltx_Math" alttext="m_{i}^{\langle j\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>m</mi><mi>i</mi><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">m_{i}^{\langle j\rangle}</annotation></semantics></math>,
as shown in Equation <a href="#S2.Ex7" title="In 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
This repair term is a <span id="S2.p6.1.1" class="ltx_text ltx_font_italic">tag updater</span>
(<span id="S2.p6.1.2" class="ltx_text">considering</span> that <math id="S2.p6.m6" class="ltx_Math" alttext="\langle{j}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle{j}\rangle</annotation></semantics></math> is a tag on the array access).
We show in Section <a href="#S4" title="4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> that Neptune automatically finds
this repair term for a large class of programs.</p>
</div>
<div id="S2.p7" class="ltx_para">
<p id="S2.p7.1" class="ltx_p">This solution of reduction fusion as shown in Figure <a href="#S2.F1.sf3" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(c)</span></a>
adds a small number of instructions to compute the repair term,
as the repair term is a short expression calculated once per iteration.
It also adds some memory overhead to keep the previous iteration of reductions
(i.e. <span id="S2.p7.1.1" class="ltx_text ltx_font_typewriter">xmax_0</span> and <span id="S2.p7.1.2" class="ltx_text ltx_font_typewriter">xmax_1</span>), in GPU registers or shared memory.
This memory overhead is low as the reduction output arrays are small
compared to other arrays in the program, such as <span id="S2.p7.1.3" class="ltx_text ltx_font_typewriter">xexp</span> and <span id="S2.p7.1.4" class="ltx_text ltx_font_typewriter">inp</span>.
These overheads trade off with the benefit of reduced memory pressure,
which is often profitable on GPUs.</p>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>System Overview</h2>

<figure id="S3.F2" class="ltx_figure"><img src="2510.08726v1/x4.png" id="S3.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:429/322;" width="429" height="322" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>. </span><span id="S3.F2.4" class="ltx_text" style="font-size:90%;">The main components of Neptune.</span></figcaption>
</figure>
<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">Figure <a href="#S3.F2" title="Figure 2 ‣ 3. System Overview ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> summarizes the main components of Neptune
and sections in this paper where we describe them.
Neptune takes as input a program written in tensor expression
and a template of transformations for the program.
Transformation template is a user-provided recipe
with a list of high-level optimizations to apply to the program.
The compiler optimizes programs using the following steps:</p>
</div>
<div id="S3.p2" class="ltx_para">
<ul id="S3.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">The template-guided optimizer
automatically applies the transformations in the template to the loop nests in the program.
Section <a href="#S4" title="4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> presents two novel advanced fusion <span id="S3.I1.i1.p1.1.1" class="ltx_text">algorithms</span>
that compose with other built-in <span id="S3.I1.i1.p1.1.2" class="ltx_text">transformations.</span>
At this point, we have a loop-scalar program that has undergone high-level optimizations.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">To facilitate tile optimizations,
the loop-to-tile translator automatically identifies tensorizable expressions,
which we describe in Section <a href="#S5" title="5. Translating from Loop-scalar IR to Tile IR ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.
The tile optimizer applies tile-specific transformations on the program
(e.g., data movement, tile data layout, and HW-specific execution)
and produces an executable kernel.</p>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p">Neptune has an autotuner that tunes parameters in the transformation template,
which we describe in Section <a href="#S6" title="6. Implementation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div></li>
</ul>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p"><span id="S3.p3.1.1" class="ltx_text ltx_font_bold">Input: Tensor Expression.</span>
Neptune provides a compact expression language for the user to define the computation of the program.
Tensor expressions translate straightforwardly into Neptune’s loop-scalar IR.
Figure <a href="#S3.F2" title="Figure 2 ‣ 3. System Overview ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (top left) shows tensor expressions
that produce the loop program in Figure <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(a)</span></a>.
Tensor expressions are written in TVM expression language here;
JAX’s jaxpr language could be used instead in principle.</p>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p"><span id="S3.p4.1.1" class="ltx_text ltx_font_bold">Input: Transformation Template.</span>
A transformation template is a list of transformation steps
the user writes to describe how to optimize the program.
Each step calls a transformation primitive in Neptune,
with parameters that describe where to apply the transformation on the program.
The template-guided optimizer applies each step in the template to the program.
We describe the optimizer and the transformation primitives available in Section <a href="#S3" title="3. System Overview ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.
Figure <a href="#S3.F2" title="Figure 2 ‣ 3. System Overview ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (top right) shows an example template
that is applicable to the given tensor expression program.</p>
</div>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p">While transformation templates resemble the scheduling languages
used in some tensor compilers, Neptune’s template is concise.
In a few lines of code, a user can express all the transformations
needed to optimize a complex operator with multiple loop nests.
Transformation templates only describe high-level optimizations
that benefit from user direction,
while Neptune delegates low-level optimizations to its tile optimizer, without user intervention.
An example of tensor expression and schedule for
<span id="S3.p5.1.1" class="ltx_text">attention is in Appendix <a href="#A1" title="Appendix A Neptune Inputs ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</span></p>
</div>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p"><span id="S3.p6.1.1" class="ltx_text ltx_font_bold">Preliminaries and Notation.</span>
We define notations we will use next;
some common notations are in Appendix <a href="#A2" title="Appendix B Background ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.
We use a compact notation for loop nests: <math id="S3.p6.m1" class="ltx_Math" alttext="nest(\boldsymbol{i}:\boldsymbol{n})\{s\}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝒏</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">nest(\boldsymbol{i}:\boldsymbol{n})\{s\}</annotation></semantics></math>
to represent <math id="S3.p6.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> perfectly nested loops with upper bounds <math id="S3.p6.m3" class="ltx_Math" alttext="\boldsymbol{n}:=(n_{1},\dots,n_{K})" display="inline" intent=":literal"><semantics><mrow><mi>𝒏</mi><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>n</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{n}:=(n_{1},\dots,n_{K})</annotation></semantics></math> and body <math id="S3.p6.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
<math id="S3.p6.m5" class="ltx_Math" alttext="\boldsymbol{i}\in\mathbb{Z}^{K}" display="inline" intent=":literal"><semantics><mrow><mi>𝒊</mi><mo>∈</mo><msup><mi>ℤ</mi><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{i}\in\mathbb{Z}^{K}</annotation></semantics></math> is an iteration vector of the nest.
The <span id="S3.p6.1.2" class="ltx_text">iteration</span> domain <math id="S3.p6.m6" class="ltx_Math" alttext="\mathcal{D}^{s}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>s</mi></msup><annotation encoding="application/x-tex">\mathcal{D}^{s}</annotation></semantics></math> is the set of values <math id="S3.p6.m7" class="ltx_Math" alttext="\boldsymbol{i}" display="inline" intent=":literal"><semantics><mi>𝒊</mi><annotation encoding="application/x-tex">\boldsymbol{i}</annotation></semantics></math> can take, given by <math id="S3.p6.m8" class="ltx_Math" alttext="\boldsymbol{n}" display="inline" intent=":literal"><semantics><mi>𝒏</mi><annotation encoding="application/x-tex">\boldsymbol{n}</annotation></semantics></math>.
We denote the previous iteration of <math id="S3.p6.m9" class="ltx_Math" alttext="\boldsymbol{i}" display="inline" intent=":literal"><semantics><mi>𝒊</mi><annotation encoding="application/x-tex">\boldsymbol{i}</annotation></semantics></math> as <math id="S3.p6.m10" class="ltx_Math" alttext="\operatorname{prev}(\boldsymbol{i})" display="inline" intent=":literal"><semantics><mrow><mi>prev</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{prev}(\boldsymbol{i})</annotation></semantics></math>
and the next iteration as <math id="S3.p6.m11" class="ltx_Math" alttext="\operatorname{next}(\boldsymbol{i})" display="inline" intent=":literal"><semantics><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{next}(\boldsymbol{i})</annotation></semantics></math>.</p>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p">In a tensor access <math id="S3.p7.m1" class="ltx_Math" alttext="X[\phi(\boldsymbol{i})]" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X[\phi(\boldsymbol{i})]</annotation></semantics></math> in a loop nest (iteration vector <math id="S3.p7.m2" class="ltx_Math" alttext="\boldsymbol{i}" display="inline" intent=":literal"><semantics><mi>𝒊</mi><annotation encoding="application/x-tex">\boldsymbol{i}</annotation></semantics></math>),
<math id="S3.p7.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is an <span id="S3.p7.1.1" class="ltx_text ltx_font_italic">affine access function</span> that projects <math id="S3.p7.m4" class="ltx_Math" alttext="\boldsymbol{i}" display="inline" intent=":literal"><semantics><mi>𝒊</mi><annotation encoding="application/x-tex">\boldsymbol{i}</annotation></semantics></math> to tensor indices.
In Figure <a href="#S2.F1.sf2" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(b)</span></a>, the tensor store <span id="S3.p7.1.2" class="ltx_text ltx_font_typewriter">xsum[i]</span>
has an access function <math id="S3.p7.m5" class="ltx_Math" alttext="\phi(i,j)=i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">\phi(i,j)=i</annotation></semantics></math>.
When a tensor entry is updated multiple times,
we add a <span id="S3.p7.1.3" class="ltx_text ltx_font_italic">tag</span> on the access to mark which iteration we refer to:
<math id="S3.p7.m6" class="ltx_Math" alttext="X[\phi(\boldsymbol{i})]^{\langle j\rangle}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X[\phi(\boldsymbol{i})]^{\langle j\rangle}</annotation></semantics></math> (<math id="S3.p7.m7" class="ltx_Math" alttext="\texttt{{xsum}[i]}^{\langle j\rangle}" display="inline" intent=":literal"><semantics><msup><mtext class="ltx_mathvariant_monospace">xsum[i]</mtext><mrow><mo stretchy="false">⟨</mo><mi>j</mi><mo stretchy="false">⟩</mo></mrow></msup><annotation encoding="application/x-tex">\texttt{{xsum}[i]}^{\langle j\rangle}</annotation></semantics></math> for example).
Tags reflect temporal data dependency on the same tensor entry.</p>
</div>
<div id="S3.p8" class="ltx_para">
<p id="S3.p8.1" class="ltx_p">In a reduction, the reducer <math id="S3.p8.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is an associative binary function.
We use <math id="S3.p8.m2" class="ltx_Math" alttext="a\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0.500em" rspace="0em">​</mo><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)"> <foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="6.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.800em">f</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ b</annotation></semantics></math> to express <math id="S3.p8.m3" class="ltx_Math" alttext="f(a,b)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(a,b)</annotation></semantics></math>.
We define the reduce operator <math id="S3.p8.m4" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math> to express the value of a reduction compactly:
<math id="S3.p8.m5" class="ltx_math_unparsed" alttext="\mathcal{R}(f,0\leq j\leq j_{0},g(j))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><msub><mi>j</mi><mn>0</mn></msub><mo>,</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}(f,0\leq j\leq j_{0},g(j))</annotation></semantics></math> applies <math id="S3.p8.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to fold over <math id="S3.p8.m7" class="ltx_Math" alttext="g(j)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(j)</annotation></semantics></math>
from <math id="S3.p8.m8" class="ltx_Math" alttext="j=0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j=0</annotation></semantics></math> to <math id="S3.p8.m9" class="ltx_Math" alttext="j_{0}" display="inline" intent=":literal"><semantics><msub><mi>j</mi><mn>0</mn></msub><annotation encoding="application/x-tex">j_{0}</annotation></semantics></math> to produce a single value.
For instance, <math id="S3.p8.m10" class="ltx_math_unparsed" alttext="\mathcal{R}(+,0\leq j\leq 2,\texttt{xexp}[i,j])" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">+</mo><mo>,</mo><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>2</mn><mo>,</mo><mtext class="ltx_mathvariant_monospace">xexp</mtext><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}(+,0\leq j\leq 2,\texttt{xexp}[i,j])</annotation></semantics></math> equals
<math id="S3.p8.m11" class="ltx_Math" alttext="\texttt{xexp}[i,0]+\texttt{xexp}[i,1]+\texttt{xexp}[i,2]" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_monospace">xexp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mtext class="ltx_mathvariant_monospace">xexp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mtext class="ltx_mathvariant_monospace">xexp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{xexp}[i,0]+\texttt{xexp}[i,1]+\texttt{xexp}[i,2]</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Template-Guided Optimizer</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">The template-guided optimizer translates the input program given as tensor expressions
into Neptune’s loop-scalar IR,
and applies the transformation primitives in the template to the program.
The abstract syntax of this IR is in Appendix <a href="#A5" title="Appendix E Neptune IR Syntax and Translation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>;
it is similar to the loop-level IR in many tensor compilers.
This level includes standard loop transformations, data layout transformations,
and data placement transformations (e.g., caching in shared memory).
Neptune also provides novel transformations
that permit reduction fusion,
described next.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Rolling Update</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Rolling update is Neptune’s novel transformation solving the reduction fusion problem
described in Section <a href="#S2" title="2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
It applies to a reduce loop nest <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> to be fused
and a target loop <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> (the <span id="S4.SS1.p1.1.1" class="ltx_text ltx_font_italic">rolling loop</span>) to fuse <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> under:
<span id="S4.SS1.p1.1.2" class="ltx_text ltx_font_typewriter">RollingUpdate(<math id="S4.SS1.p1.m4" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>,<math id="S4.SS1.p1.m5" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>)</span>.
Rolling update requires that <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> depends on at least one reduce loop nest,
such as <span id="S4.SS1.p1.1.3" class="ltx_text ltx_font_typewriter">s_sum</span> depends on <span id="S4.SS1.p1.1.4" class="ltx_text ltx_font_typewriter">s_max</span> through <span id="S4.SS1.p1.1.5" class="ltx_text ltx_font_typewriter">s_exp</span> in Figure <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(a)</span></a>.</p>
</div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.4" class="ltx_text ltx_font_bold">Algorithm 1</span> </span><span id="algorithm1.5" class="ltx_text ltx_font_smallcaps">RollingUpdate</span>(<math id="algorithm1.m3" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>, <math id="algorithm1.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>)</figcaption>
<div id="algorithm1.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.6.1" class="ltx_listingline">
<span id="algorithm1.6.1.1" class="ltx_text"><span id="algorithm1.6.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><math id="algorithm1.m5" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>: the target loop nest to be fused. <math id="algorithm1.m6" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> holds a reference to the entire program.
</div>
<div id="algorithm1.6.2" class="ltx_listingline"><span id="algorithm1.6.2.1" class="ltx_text"><span id="algorithm1.6.2.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><math id="algorithm1.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>: the loop to fuse <math id="algorithm1.m8" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> under (‘‘rolling loop’’).
</div>
<div id="algorithm1.6.3" class="ltx_listingline"><span id="algorithm1.6.3.1" class="ltx_text"><span id="algorithm1.6.3.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>The fused loop nest
</div>
<div id="algorithm1.6.4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.4.1" class="ltx_text ltx_font_bold">1</span></span>
            <math id="algorithm1.m9" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> = <span id="algorithm1.6.4.2" class="ltx_text ltx_font_smallcaps">InlineMapReturnReduce</span>(<math id="algorithm1.m10" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>);
</div>
<div id="algorithm1.6.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.5.1" class="ltx_text ltx_font_bold">2</span></span>
            <span id="algorithm1.6.5.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.6.5.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m11" class="ltx_Math" alttext="L\in\mathcal{L}_{r}\cup\text{set}(L_{t})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><mo>∪</mo><mrow><mtext class="ltx_mathvariant_italic">set</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">L\in\mathcal{L}_{r}\cup\text{set}(L_{t})</annotation></semantics></math></em> <span id="algorithm1.6.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.6.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.6.1" class="ltx_text ltx_font_bold">3</span></span>
            <math id="algorithm1.m12" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> = <span id="algorithm1.6.6.2" class="ltx_text ltx_font_smallcaps">NaiveLoopFusion</span>(<math id="algorithm1.m13" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, <math id="algorithm1.m14" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>);
</div>
<div id="algorithm1.6.7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.7.1" class="ltx_text ltx_font_bold">4</span></span>
            <math id="algorithm1.m15" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> = <span id="algorithm1.6.7.2" class="ltx_text ltx_font_smallcaps">MatchReducePattern</span>(<math id="algorithm1.m16" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>, <math id="algorithm1.m17" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math>);
</div>
<div id="algorithm1.6.8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.8.1" class="ltx_text ltx_font_bold">5</span></span>
            <math id="algorithm1.m18" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> = <span id="algorithm1.6.8.2" class="ltx_text ltx_font_smallcaps">SolveRepairFuncH</span>(<math id="algorithm1.m19" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>);
</div>
<div id="algorithm1.6.9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.9.1" class="ltx_text ltx_font_bold">6</span></span>
            <span id="algorithm1.6.9.2" class="ltx_text ltx_font_smallcaps">ValidateHCommutative</span>(<math id="algorithm1.m20" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>, <math id="algorithm1.m21" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>);
</div>
<div id="algorithm1.6.10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.10.1" class="ltx_text ltx_font_bold">7</span></span>
            <math id="algorithm1.m22" class="ltx_Math" alttext="M_{x}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>x</mi></msub><annotation encoding="application/x-tex">M_{x}</annotation></semantics></math> = dict();
</div>
<div id="algorithm1.6.11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.11.1" class="ltx_text ltx_font_bold">8</span></span>
            <span id="algorithm1.6.11.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.6.11.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m23" class="ltx_Math" alttext="L\in\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">L\in\mathcal{L}_{r}</annotation></semantics></math></em> <span id="algorithm1.6.11.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.6.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.12.1" class="ltx_text ltx_font_bold">9</span></span>
            <math id="algorithm1.m24" class="ltx_Math" alttext="(x_{\text{prev}},x_{\text{curr}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mtext>prev</mtext></msub><mo>,</mo><msub><mi>x</mi><mtext>curr</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{\text{prev}},x_{\text{curr}})</annotation></semantics></math> = <span id="algorithm1.6.12.2" class="ltx_text ltx_font_smallcaps">CacheReducePrevResult</span>(<math id="algorithm1.m25" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>);
</div>
<div id="algorithm1.6.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.13.1" class="ltx_text ltx_font_bold">10</span></span>
            <math id="algorithm1.m26" class="ltx_Math" alttext="M_{x}[L]" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">M_{x}[L]</annotation></semantics></math> = <math id="algorithm1.m27" class="ltx_Math" alttext="(x_{\text{prev}},x_{\text{curr}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mtext>prev</mtext></msub><mo>,</mo><msub><mi>x</mi><mtext>curr</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{\text{prev}},x_{\text{curr}})</annotation></semantics></math>;
</div>
<div id="algorithm1.6.14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.14.1" class="ltx_text ltx_font_bold">11</span></span>
            <math id="algorithm1.m28" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> = <span id="algorithm1.6.14.2" class="ltx_text ltx_font_smallcaps">ApplyRepairTerm</span>(<math id="algorithm1.m29" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>, <math id="algorithm1.m30" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>, <math id="algorithm1.m31" class="ltx_Math" alttext="M_{x}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>x</mi></msub><annotation encoding="application/x-tex">M_{x}</annotation></semantics></math>);
</div>
<div id="algorithm1.6.15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.15.1" class="ltx_text ltx_font_bold">12</span></span>
            <span id="algorithm1.6.15.2" class="ltx_text ltx_font_bold">return</span> <em id="algorithm1.6.15.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m32" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math></em>

</div>
</div>
</figure>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">Algorithm <a href="#algorithm1" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> outlines the full rolling-update algorithm.
There are five major steps in rolling update, which we explain in the following paragraphs.
When any step fails (such as pattern matching and repair function solving),
rolling update returns the original program.
A step-by-step example of applying rolling update on Figure <a href="#S2.F1.sf1" title="In Figure 1 ‣ 2. Motivation ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1(a)</span></a>
is in Appendix <a href="#A3" title="Appendix C Step-By-Step Algorithm Application on Motivational Example ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text ltx_font_bold">Dataflow Reorganization.</span>
Rolling update performs an analysis on the dataflow graph
to find and manipulate predecessors of <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>. On line <a href="#algorithm1" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,
<span id="S4.SS1.p3.1.2" class="ltx_text ltx_font_smallcaps">InlineMapReturnReduce</span> finds predecessors of <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> that are reduce loop nests, as a set <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math>, called the <span id="S4.SS1.p3.1.3" class="ltx_text ltx_font_italic">reduce predecessors</span> of <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>.
Then on each path from <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> that ends in <math id="S4.SS1.p3.m6" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> (excluding both ends),
rolling update inlines all the loop nests.
These inlined loop nests are map loop nests and predecessors of <math id="S4.SS1.p3.m7" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>,
so their computation eventually accumulates in <math id="S4.SS1.p3.m8" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>.
After inlining, all of <math id="S4.SS1.p3.m9" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> are direct producers of <math id="S4.SS1.p3.m10" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p"><span id="S4.SS1.p4.1.1" class="ltx_text ltx_font_bold">Loop Transformation.</span>
On lines <a href="#algorithm1" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> to <a href="#algorithm1" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,
rolling update fuses <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> and each of <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> under <math id="S4.SS1.p4.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> using naive loop fusion, skipping
loop nests is already under <math id="S4.SS1.p4.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.
This step ensures that all loop nests in <math id="S4.SS1.p4.m5" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> share an outer loop nest with <math id="S4.SS1.p4.m6" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>.
<math id="S4.SS1.p4.m7" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> now is a fused loop nest producing incorrect results and needs to be repaired.</p>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_bold">Code Pattern Matching.</span>
Pattern matching gathers important information to prepare for solving the repair function next.
On line <a href="#algorithm1" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,
<span id="S4.SS1.p5.1.2" class="ltx_text ltx_font_smallcaps">MatchReducePattern</span> matches the compute statement of <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> and <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{r}</annotation></semantics></math> simultaneously.
It requires <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> and each <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="L_{i}\in\mathcal{L}_{r}(i\in\{1,\dots,|\mathcal{L}_{r}|\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><mo stretchy="false">|</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{i}\in\mathcal{L}_{r}(i\in\{1,\dots,|\mathcal{L}_{r}|\})</annotation></semantics></math> to be a reduction.</p>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p">The structure of <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> is critical to expression repair, so we zoom in on it.
<math id="S4.SS1.p6.m2" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> is already a reduce loop nest: <math id="S4.SS1.p6.m3" class="ltx_math_unparsed" alttext="L_{t}=rnest(\boldsymbol{i}:\boldsymbol{n},\boldsymbol{j}:\boldsymbol{m})\{s_{t}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>t</mi></msub><mo>=</mo><mi>r</mi><mi>n</mi><mi>e</mi><mi>s</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝒏</mi><mo>,</mo><mi>𝒋</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝒎</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">{</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L_{t}=rnest(\boldsymbol{i}:\boldsymbol{n},\boldsymbol{j}:\boldsymbol{m})\{s_{t}\}</annotation></semantics></math>.
For the body <math id="S4.SS1.p6.m4" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math>, we further capture any computation on the right of the reducer <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>
into a function <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="g:\mathcal{X}\times\mathcal{X}\to\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></mrow><annotation encoding="application/x-tex">g:\mathcal{X}\times\mathcal{X}\to\mathcal{X}</annotation></semantics></math>, to arrive at the specific pattern</p>
<table id="S4.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
