<div id="lstnumberx146" class="ltx_listingline"><span id="lstnumberx146.1" class="ltx_text ltx_lst_space" style="font-size:90%;">      </span><span id="lstnumberx146.2" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xsump</span><span id="lstnumberx146.3" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx146.4" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx146.5" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx146.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.7" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j1</span><span id="lstnumberx146.8" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx146.9" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.10" class="ltx_text" style="font-size:90%;">+=</span><span id="lstnumberx146.11" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.12" class="ltx_text ltx_lst_identifier" style="font-size:90%;">exp</span><span id="lstnumberx146.13" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx146.14" class="ltx_text ltx_lst_identifier" style="font-size:90%;">inp</span><span id="lstnumberx146.15" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx146.16" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx146.17" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx146.18" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.19" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j1</span><span id="lstnumberx146.20" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.21" class="ltx_text" style="font-size:90%;">*</span><span id="lstnumberx146.22" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.23" class="ltx_text" style="font-size:90%;">2</span><span id="lstnumberx146.24" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.25" class="ltx_text" style="font-size:90%;">+</span><span id="lstnumberx146.26" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.27" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j2</span><span id="lstnumberx146.28" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx146.29" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.30" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx146.31" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx146.32" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xmax_1</span><span id="lstnumberx146.33" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx146.34" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx146.35" class="ltx_text" style="font-size:90%;">])</span>
</div>
<div id="lstnumberx147" class="ltx_listingline"><span id="lstnumberx147.1" class="ltx_text ltx_lst_space" style="font-size:90%;">    </span><span id="lstnumberx147.2" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xsum</span><span id="lstnumberx147.3" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx147.4" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx147.5" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx147.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.7" class="ltx_text" style="font-size:90%;">=</span><span id="lstnumberx147.8" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.9" class="ltx_text ltx_lst_identifier" style="font-size:90%;">exp</span><span id="lstnumberx147.10" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx147.11" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xmax_0</span><span id="lstnumberx147.12" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx147.13" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx147.14" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx147.15" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.16" class="ltx_text" style="font-size:90%;">-</span><span id="lstnumberx147.17" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.18" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xmax_1</span><span id="lstnumberx147.19" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx147.20" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx147.21" class="ltx_text" style="font-size:90%;">])</span><span id="lstnumberx147.22" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.23" class="ltx_text" style="font-size:90%;">*</span><span id="lstnumberx147.24" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.25" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xsum</span><span id="lstnumberx147.26" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx147.27" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx147.28" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx147.29" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.30" class="ltx_text" style="font-size:90%;">+</span><span id="lstnumberx147.31" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.32" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xsump</span><span id="lstnumberx147.33" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx147.34" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx147.35" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx147.36" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx147.37" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j1</span><span id="lstnumberx147.38" class="ltx_text" style="font-size:90%;">]</span>
</div>
<div id="lstnumberx148" class="ltx_listingline"><span id="lstnumberx148.1" class="ltx_text ltx_lst_space" style="font-size:90%;">    </span><span id="lstnumberx148.2" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xmax_0</span><span id="lstnumberx148.3" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx148.4" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx148.5" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx148.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx148.7" class="ltx_text" style="font-size:90%;">=</span><span id="lstnumberx148.8" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx148.9" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xmax_1</span><span id="lstnumberx148.10" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx148.11" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx148.12" class="ltx_text" style="font-size:90%;">]</span>
</div>
</div>
