</div>
</div>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_figure">(a) </span>Step 1: dataflow reorganization.
This step inlines <span id="A3.F10.sf1.11" class="ltx_text ltx_font_typewriter">s_exp</span> (into <span id="A3.F10.sf1.12" class="ltx_text ltx_font_typewriter">s_sum</span>) and finds <math id="A3.F10.sf1.m2" class="ltx_Math" alttext="\mathcal{L}_{r}=\{\texttt{s\_max}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub><mo>=</mo><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><mtext class="ltx_mathvariant_monospace">s_max</mtext><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{r}=\{\texttt{s\_max}\}</annotation></semantics></math>.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A3.F10.sf2" class="ltx_figure ltx_figure_panel ltx_align_center">
<div id="A3.F10.sf2.3" class="ltx_listing ltx_lst_language_python ltx_lstlisting ltx_align_center ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64,Zm9yIGkgaW4gcmFuZ2UoMik6CiAgZm9yIGogaW4gcmFuZ2UoNCk6ICAjIGxvb3BfagogICAgIyBzX21heDoKICAgIHhtYXhbaV0gPSBtYXgoCiAgICAgIHhtYXhbaV0sIGlucFtpLCBqXSkKICAgICMgc19zdW06CiAgICB4c3VtW2ldID0geHN1bVtpXSArIGV4cCgKICAgICAgaW5wW2ksIGpdIC0geG1heFtpXSk=" download="">⬇</a></div>
<div id="lstnumberx128" class="ltx_listingline"><span id="lstnumberx128.1" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:90%;">for</span><span id="lstnumberx128.2" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx128.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx128.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx128.5" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:90%;">in</span><span id="lstnumberx128.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx128.7" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="font-size:90%;">range</span><span id="lstnumberx128.8" class="ltx_text" style="font-size:90%;">(2):</span>
</div>
<div id="lstnumberx129" class="ltx_listingline"><span id="lstnumberx129.1" class="ltx_text ltx_lst_space" style="font-size:90%;">  </span><span id="lstnumberx129.2" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:90%;">for</span><span id="lstnumberx129.3" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx129.4" class="ltx_text ltx_lst_identifier" style="font-size:90%;">j</span><span id="lstnumberx129.5" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx129.6" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:90%;">in</span><span id="lstnumberx129.7" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx129.8" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="font-size:90%;">range</span><span id="lstnumberx129.9" class="ltx_text" style="font-size:90%;">(4):</span><span id="lstnumberx129.10" class="ltx_text ltx_lst_space" style="font-size:90%;">  </span><span id="lstnumberx129.11" class="ltx_text ltx_lst_comment ltx_font_italic" style="font-size:90%;">#<span id="lstnumberx129.11.1" class="ltx_text ltx_lst_space"> </span>loop_j</span>
</div>
<div id="lstnumberx130" class="ltx_listingline"><span id="lstnumberx130.1" class="ltx_text ltx_lst_space" style="font-size:90%;">    </span><span id="lstnumberx130.2" class="ltx_text ltx_lst_comment ltx_font_italic" style="font-size:90%;">#<span id="lstnumberx130.2.1" class="ltx_text ltx_lst_space"> </span>s_max:</span>
</div>
<div id="lstnumberx131" class="ltx_listingline"><span id="lstnumberx131.1" class="ltx_text ltx_lst_space" style="font-size:90%;">    </span><span id="lstnumberx131.2" class="ltx_text ltx_lst_identifier" style="font-size:90%;">xmax</span><span id="lstnumberx131.3" class="ltx_text" style="font-size:90%;">[</span><span id="lstnumberx131.4" class="ltx_text ltx_lst_identifier" style="font-size:90%;">i</span><span id="lstnumberx131.5" class="ltx_text" style="font-size:90%;">]</span><span id="lstnumberx131.6" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx131.7" class="ltx_text" style="font-size:90%;">=</span><span id="lstnumberx131.8" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx131.9" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold" style="font-size:90%;">max</span><span id="lstnumberx131.10" class="ltx_text" style="font-size:90%;">(</span>
