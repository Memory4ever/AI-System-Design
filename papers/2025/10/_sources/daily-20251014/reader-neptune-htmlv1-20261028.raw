</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proofs of Rolling Update Correctness Theorems</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">We use these abbreviations for the following proofs:</p>
<table id="A4.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex25.m1" class="ltx_Math" alttext="\displaystyle C[\phi_{c}(\boldsymbol{i},\boldsymbol{j})]" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo>,</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle C[\phi_{c}(\boldsymbol{i},\boldsymbol{j})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex25.m2" class="ltx_Math" alttext="\displaystyle=:C_{\boldsymbol{j}};" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msub><mi>C</mi><mi>𝒋</mi></msub></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=:C_{\boldsymbol{j}};</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex25.m3" class="ltx_Math" alttext="\displaystyle X_{t}[\phi_{t}(\boldsymbol{i})]^{\langle\boldsymbol{j}\rangle}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle X_{t}[\phi_{t}(\boldsymbol{i})]^{\langle\boldsymbol{j}\rangle}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex25.m4" class="ltx_Math" alttext="\displaystyle=:X_{t}^{\langle\boldsymbol{j}\rangle};" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=:X_{t}^{\langle\boldsymbol{j}\rangle};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex26.m1" class="ltx_Math" alttext="\displaystyle X_{r}[\phi_{r}(\boldsymbol{i})]^{\langle\operatorname{next}(\boldsymbol{j})\rangle}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle X_{r}[\phi_{r}(\boldsymbol{i})]^{\langle\operatorname{next}(\boldsymbol{j})\rangle}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex26.m2" class="ltx_Math" alttext="\displaystyle=:X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=:X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex26.m3" class="ltx_Math" alttext="\displaystyle X_{r}[\phi_{r}(\boldsymbol{i})]^{\langle\boldsymbol{j}\rangle}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ϕ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒊</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle X_{r}[\phi_{r}(\boldsymbol{i})]^{\langle\boldsymbol{j}\rangle}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex26.m4" class="ltx_Math" alttext="\displaystyle=:X_{r}^{\langle\boldsymbol{j}\rangle};" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\displaystyle=:X_{r}^{\langle\boldsymbol{j}\rangle};</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p">because all the proofs involve a single loop nest,
where the map iteration vector <math id="A4.p1.m1" class="ltx_Math" alttext="\boldsymbol{i}" display="inline" intent=":literal"><semantics><mi>𝒊</mi><annotation encoding="application/x-tex">\boldsymbol{i}</annotation></semantics></math> is unambiguous.</p>
</div>
<div id="A4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmtheorem2" title="Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>.</h6>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p"><span id="A4.p2.1.1" class="ltx_text">We assume that <math id="A4.p2.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> satisfies the conditions of Eqns. <a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> and <a href="#S4.E5" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>,
and prove that <math id="A4.p2.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> meets the definition <a href="#S4.Thmtheorem1" title="Definition 4.1. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> which is an equality.
The left-hand side of the equality is <math id="A4.p2.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> applied to the reduce expression</span></p>
<table id="A4.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex27.m1" class="ltx_math_unparsed" alttext="\mathcal{R}\left(f,0\preceq\boldsymbol{j}^{\prime}\preceq\boldsymbol{j}_{0},g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\boldsymbol{j}^{\prime}})\right)=:R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mo>(</mo><mi>f</mi><mo>,</mo><mn>0</mn><mo>⪯</mo><msup><mi>𝒋</mi><mo>′</mo></msup><mo>⪯</mo><msub><mi>𝒋</mi><mn>0</mn></msub><mo>,</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><msup><mi>𝒋</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{R}\left(f,0\preceq\boldsymbol{j}^{\prime}\preceq\boldsymbol{j}_{0},g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\boldsymbol{j}^{\prime}})\right)=:R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.2" class="ltx_p"><span id="A4.p2.2.1" class="ltx_text">and the right-hand is the updated reduce expression</span></p>
<table id="A4.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex28.m1" class="ltx_math_unparsed" alttext="\mathcal{R}\left(f,0\preceq\boldsymbol{j}^{\prime}\preceq\boldsymbol{j}_{0},g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{\boldsymbol{j}^{\prime}})\right)=:R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mo>(</mo><mi>f</mi><mo>,</mo><mn>0</mn><mo>⪯</mo><msup><mi>𝒋</mi><mo>′</mo></msup><mo>⪯</mo><msub><mi>𝒋</mi><mn>0</mn></msub><mo>,</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><msup><mi>𝒋</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{R}\left(f,0\preceq\boldsymbol{j}^{\prime}\preceq\boldsymbol{j}_{0},g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{\boldsymbol{j}^{\prime}})\right)=:R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.3" class="ltx_p"><span id="A4.p2.3.1" class="ltx_text">We use <math id="A4.p2.m4" class="ltx_Math" alttext="\boldsymbol{j}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒋</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\boldsymbol{j}_{0}</annotation></semantics></math> as the reduce range to distinguish it from the tag <math id="A4.p2.m5" class="ltx_Math" alttext="\boldsymbol{j}" display="inline" intent=":literal"><semantics><mi>𝒋</mi><annotation encoding="application/x-tex">\boldsymbol{j}</annotation></semantics></math>.
We prove by induction over the reduce range <math id="A4.p2.m6" class="ltx_Math" alttext="\boldsymbol{j}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒋</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\boldsymbol{j}_{0}</annotation></semantics></math>:</span></p>
<table id="A4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E10.m1" class="ltx_Math" alttext="h\left(R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>=</mo><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">h\left(R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.4" class="ltx_p"><span id="A4.p2.4.1" class="ltx_text">for <math id="A4.p2.m7" class="ltx_Math" alttext="\boldsymbol{j}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒋</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\boldsymbol{j}_{0}</annotation></semantics></math> from <math id="A4.p2.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="A4.p2.m9" class="ltx_Math" alttext="\boldsymbol{j}" display="inline" intent=":literal"><semantics><mi>𝒋</mi><annotation encoding="application/x-tex">\boldsymbol{j}</annotation></semantics></math>, while all the tags are fixed.</span></p>
<ul id="A4.I1" class="ltx_itemize" style="--ltx-enum-leftmargin:1em;">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p">Base case: when <math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="\boldsymbol{j}_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒋</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{j}_{0}=0</annotation></semantics></math>, <math id="A4.I1.i1.p1.m2" class="ltx_Math" alttext="R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}</annotation></semantics></math> and <math id="A4.I1.i1.p1.m3" class="ltx_Math" alttext="R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}</annotation></semantics></math> are each a single term,</p>
<table id="A4.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex29.m1" class="ltx_Math" alttext="R^{\langle\boldsymbol{j}\rangle}_{0}=g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{0});\quad R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{0}=g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{0})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>R</mi><mn>0</mn><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">;</mo><mrow><msubsup><mi>R</mi><mn>0</mn><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{\langle\boldsymbol{j}\rangle}_{0}=g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{0});\quad R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{0}=g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i1.p1.2" class="ltx_p">so the condition to prove simplifies to</p>
<table id="A4.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex30.m1" class="ltx_Math" alttext="h\left(g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{0}),X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)=g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{0})" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h\left(g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{0}),X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)=g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i1.p1.3" class="ltx_p">which is true by applying Eqn. <a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p">Inductive step: for any <math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="\boldsymbol{j}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝒋</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\boldsymbol{j}_{0}</annotation></semantics></math> where the inductive hypothesis
Eqn. <a href="#A4.E10" title="In Proof of Theorem . ‣ Appendix D Proofs of Rolling Update Correctness Theorems ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> is true,
we add one term to <math id="A4.I1.i2.p1.m2" class="ltx_Math" alttext="R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}</annotation></semantics></math>:</p>
<table id="A4.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex31.m1" class="ltx_Math" alttext="R^{\langle\boldsymbol{j}\rangle}_{\operatorname{next}(\boldsymbol{j}_{0})}=R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\operatorname{next}(\boldsymbol{j}_{0})})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒋</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)"> <foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="6.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.800em">f</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</