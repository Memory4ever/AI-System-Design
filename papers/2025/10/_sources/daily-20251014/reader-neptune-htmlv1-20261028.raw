\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\operatorname{next}(\operatorname{next}(\boldsymbol{j}))})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>R</mi><msub><mi>𝒋</mi><mn>0</mn></msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)"> <foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="6.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.800em">f</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}_{0}}\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\operatorname{next}(\operatorname{next}(\boldsymbol{j}))})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex37.m1" class="ltx_Math" alttext="\displaystyle=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\operatorname{next}(\boldsymbol{j}_{0})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msubsup><mi>R</mi><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒋</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\operatorname{next}(\boldsymbol{j}_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i2.p1.3" class="ltx_p">Therefore, the inductive hypothesis is true for <math id="A4.I1.i2.p1.m4" class="ltx_Math" alttext="\operatorname{next}(\boldsymbol{j}_{0})" display="inline" intent=":literal"><semantics><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒋</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{next}(\boldsymbol{j}_{0})</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A4.p2.5" class="ltx_p"><span id="A4.p2.5.1" class="ltx_text">By induction, the theorem is true for all <math id="A4.p2.m10" class="ltx_Math" alttext="\boldsymbol{j}_{0}\preceq\boldsymbol{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒋</mi><mn>0</mn></msub><mo>⪯</mo><mi>𝒋</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{j}_{0}\preceq\boldsymbol{j}</annotation></semantics></math>.
We substitute <math id="A4.p2.m11" class="ltx_Math" alttext="\boldsymbol{j}_{0}=\boldsymbol{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒋</mi><mn>0</mn></msub><mo>=</mo><mi>𝒋</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{j}_{0}=\boldsymbol{j}</annotation></semantics></math> to get</span></p>
<table id="A4.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex38.m1" class="ltx_Math" alttext="h\left(R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>R</mi><mi>𝒋</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo>=</mo><msubsup><mi>R</mi><mi>𝒋</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">h\left(R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)=R^{\langle\operatorname{next}(\boldsymbol{j})\rangle}_{\boldsymbol{j}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.6" class="ltx_p"><span id="A4.p2.6.1" class="ltx_text">which is the theorem to prove.
∎</span></p>
</div>
</div>
<div id="A4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>.</h6>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p"><span id="A4.p3.1.1" class="ltx_text">We prove that Eqn. <a href="#S4.E6" title="In Theorem 4.3. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> is a solution to Equation <a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>
by simple substitution.
Since <math id="A4.p3.m1" class="ltx_Math" alttext="g_{c}^{-1}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">g_{c}^{-1}</annotation></semantics></math> is the second-argument inverse of <math id="A4.p3.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, we have</span></p>
<table id="A4.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex39.m1" class="ltx_Math" alttext="g_{c}^{-1}(x,g(x,c))=c" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>g</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">g_{c}^{-1}(x,g(x,c))=c</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.2" class="ltx_p"><span id="A4.p3.2.1" class="ltx_text">In Eqn. <a href="#S4.E6" title="In Theorem 4.3. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, substitute <math id="A4.p3.m3" class="ltx_Math" alttext="t=g(r,c)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t=g(r,c)</annotation></semantics></math> to get</span></p>
<table id="A4.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex40.m1" class="ltx_Math" alttext="h(g(r,c),r,r^{\prime})=g(r^{\prime},g_{c}^{-1}(r,g(r,c)))=g(r^{\prime},c)" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>r</mi><mo>,</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo>,</mo><mrow><msubsup><mi>g</mi><mi>c</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h(g(r,c),r,r^{\prime})=g(r^{\prime},g_{c}^{-1}(r,g(r,c)))=g(r^{\prime},c)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.3" class="ltx_p"><span id="A4.p3.3.1" class="ltx_text">which is Eqn. <a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
∎</span></p>
</div>
</div>
<div id="A4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>.</h6>
<div id="A4.p4" class="ltx_para">
<p id="A4.p4.1" class="ltx_p"><span id="A4.p4.1.1" class="ltx_text">The proof is that the recurrent form in Eqn. <a href="#S4.Ex12" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>
(with tag added for clarity)</span></p>
<table id="A4.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex41.m1" class="ltx_Math" alttext="X_{t}^{\langle\boldsymbol{j}\rangle}=h\left(X_{t}^{\langle\operatorname{prev}(\boldsymbol{j})\rangle},X_{r}^{\langle\operatorname{prev}(\boldsymbol{j})\rangle},X_{r}^{\langle\boldsymbol{j}\rangle}\right)\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\boldsymbol{j}})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>prev</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>prev</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)"> <foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="6.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.800em">f</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mi>𝒋</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{t}^{\langle\boldsymbol{j}\rangle}=h\left(X_{t}^{\langle\operatorname{prev}(\boldsymbol{j})\rangle},X_{r}^{\langle\operatorname{prev}(\boldsymbol{j})\rangle},X_{r}^{\langle\boldsymbol{j}\rangle}\right)\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\boldsymbol{j}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p4.2" class="ltx_p"><span id="A4.p4.2.1" class="ltx_text">is equivalent to the explicit form in Eqn. <a href="#S4.E3" title="In 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></span></p>
<table id="A4.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex42.m1" class="ltx_math_unparsed" alttext="{\color[rgb]{0.1523,0.5078,0.0898}X_{t}^{\langle\boldsymbol{j}\rangle}}=\mathcal{R}(f,0\preceq\boldsymbol{j}^{\prime}\preceq\boldsymbol{j},g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\boldsymbol{j}^{\prime}}))=:R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">X</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">t</mi><mrow><mo stretchy="false">⟨</mo><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mn>0</mn><mo>⪯</mo><msup><mi>𝒋</mi><mo>′</mo></msup><mo>⪯</mo><mi>𝒋</mi><mo>,</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><msup><mi>𝒋</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><msubsup><mi>R</mi><mi>𝒋</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}X_{t}^{\langle\boldsymbol{j}\rangle}}=\mathcal{R}(f,0\preceq\boldsymbol{j}^{\prime}\preceq\boldsymbol{j},g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\boldsymbol{j}^{\prime}}))=:R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p4.3" class="ltx_p"><span id="A4.p4.3.1" class="ltx_text">i.e., <math id="A4.p4.m1" class="ltx_Math" alttext="X_{t}^{\langle\boldsymbol{j}\rangle}=R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><msubsup><mi>R</mi><mi>𝒋</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">X_{t}^{\langle\boldsymbol{j}\rangle}=R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}}</annotation></semantics></math>
for all <math id="A4.p4.m2" class="ltx_Math" alttext="\boldsymbol{j}" display="inline" intent=":literal"><semantics><mi>𝒋</mi><annotation encoding="application/x-tex">\boldsymbol{j}</annotation></semantics></math> in the iteration domain. We prove it by induction on <math id="A4.p4.m3" class="ltx_Math" alttext="\boldsymbol{j}" display="inline" intent=":literal"><semantics><mi>𝒋</mi><annotation encoding="application/x-tex">\boldsymbol{j}</annotation></semantics></math>.</span></p>
<ul id="A4.I2" class="ltx_itemize" style="--ltx-enum-leftmargin:1em;">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p">Base case: when <math id="A4.I2.i1.p1.m1" class="ltx_Math" alttext="\boldsymbol{j}=0" display="inline" intent=":literal"><semantics><mrow><mi>𝒋</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{j}=0</annotation></semantics></math>, the recurrent <math id="A4.I2.i1.p1.m2" class="ltx_Math" alttext="X_{0}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>0</mn></msub><annotation encoding="application/x-tex">X_{0}</annotation></semantics></math> has iterated once:</p>
<table id="A4.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex43.m1" class="ltx_Math" alttext="X_{t}^{\langle 0\rangle}=g(X_{r}^{\langle 0\rangle},C_{0})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{t}^{\langle 0\rangle}=g(X_{r}^{\langle 0\rangle},C_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.i1.p1.2" class="ltx_p">and the explicit <math id="A4.I2.i1.p1.m3" class="ltx_Math" alttext="{\color[rgb]{0.1523,0.5078,0.0898}X_{t}^{\langle 0\rangle}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">X</mi><mi style="--ltx-fg-color:#278117;" mathcolor="#278117">t</mi><mrow><mo stretchy="false">⟨</mo><mn style="--ltx-fg-color:#278117;" mathcolor="#278117">0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">{\color[rgb]{0.1523,0.5078,0.0898}X_{t}^{\langle 0\rangle}}</annotation></semantics></math> has a single term:</p>
<table id="A4.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex44.m1" class="ltx_Math" alttext="R^{\langle 0\rangle}_{0}=g(X_{r}^{\langle 0\rangle},C_{0})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mn>0</mn><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mn>0</mn><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msub><mi>C</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R^{\langle 0\rangle}_{0}=g(X_{r}^{\langle 0\rangle},C_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.i1.p1.3" class="ltx_p">and they are equal, so the inductive hypothesis is true.</p>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p">Inductive step: for any <math id="A4.I2.i2.p1.m1" class="ltx_Math" alttext="\boldsymbol{j}" display="inline" intent=":literal"><semantics><mi>𝒋</mi><annotation encoding="application/x-tex">\boldsymbol{j}</annotation></semantics></math> where the inductive hypothesis is true,
the next iteration <math id="A4.I2.i2.p1.m2" class="ltx_Math" alttext="\operatorname{next}(\boldsymbol{j})" display="inline" intent=":literal"><semantics><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{next}(\boldsymbol{j})</annotation></semantics></math> updates the recurrent <math id="A4.I2.i2.p1.m3" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> once.
We write down the updated value,
apply the inductive hypothesis to convert to explicit form,
then use the tag-updating property of <math id="A4.I2.i2.p1.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> to get</p>
<table id="A4.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex45.m1" class="ltx_Math" alttext="\displaystyle X_{t}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle X_{t}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex46.m1" class="ltx_Math" alttext="\displaystyle=h\left(X_{t}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
}{{{{\lx@inpgf@ignorespaces}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{-2.48265pt}{-2.0pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)} \pgfsys@hbox{58}\lxSVG@closescope }}}
\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle},C_{\operatorname{next}(\boldsymbol{j})})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>t</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mtext> <svg style="vertical-align:-4.45px" height="14.43" overflow="visible" version="1.1" viewBox="0 0 14.43 14.43" width="14.43"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,14.43) matrix(1 0 0 -1 0 0) translate(7.22,0) translate(0,7.22)"> <path style="fill:none" d="M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0"></path> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.44 -2.77)"> <foreignObject style="--ltx-fo-width:0.58em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="6.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.800em">f</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>g</mi><mo lspac