\lxSVG@closescope }}}
}
\lxSVG@closescope {{{}}}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}\ g(X_{r}^{\langle\boldsymbol{j}\rangle},C_{\operatorname{next}(\boldsymbol{j}_{0})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i2.p1.2" class="ltx_p">Apply <math id="A4.I1.i2.p1.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> to both sides, apply Eqn. <a href="#S4.E5" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>,
then apply Eqn. <a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. Rolling Update ‣ 4. Template-Guided Optimizer ‣ Neptune: Advanced ML Operator Fusion for Locality and Parallelism on GPUs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>,
and finally apply the inductive hypothesis on the underlined term, to get</p>
<table id="A4.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex32.m1" class="ltx_Math" alttext="\displaystyle h\left(R^{\langle\boldsymbol{j}\rangle}_{\operatorname{next}(\boldsymbol{j}_{0})},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>R</mi><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒋</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mi>𝒋</mi><mo stretchy="false">⟩</mo></mrow></msubsup><mo>,</mo><msubsup><mi>X</mi><mi>r</mi><mrow><mo stretchy="false">⟨</mo><mrow><mi>next</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒋</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h\left(R^{\langle\boldsymbol{j}\rangle}_{\operatorname{next}(\boldsymbol{j}_{0})},X_{r}^{\langle\boldsymbol{j}\rangle},X_{r}^{\langle\operatorname{next}(\boldsymbol{j})\rangle}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex33.m1" class="ltx_Math" alttext="\displaystyle=h\left(R^{\langle\boldsymbol{j}\rangle}_{\boldsymbol{j}_{0}}\ \hbox to10.43pt{\vbox to10.43pt{\pgfpicture\makeatletter\hbox{\hskip 5.21538pt\lower-5.21538pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} {{{}}\lx@inpgf@ignorespaces\hbox{\hbox{{\lxSVG@begingroup@{_scopebegin=1} {{}{{{}}}{{}}{}{}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{}{}{}{}{}{{}\lxSVG@stroke\lxSVG@drawpath@unclipped{M 6.94 0 C 6.94 3.83 3.83 6.94 0 6.94 C -3.83 6.94 -6.94 3.83 -6.94 0 C -6.94 -3.83 -3.83 -6.94 0 -6.94 C 3.83 -6.94 6.94 -3.83 6.94 0 Z M 0 0}{fill:none} \lx@inpgf@ignorespaces
