<td id="S4.T2.2.6.1" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;"><span id="S4.T2.2.6.1.1" class="ltx_text" style="--ltx-bg-color:#DCF0DC;">+Boundary-Aware(online)</span></td>
