<td id="S4.T2.2.7.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;"><math id="S4.T2.m5" class="ltx_Math" style="--ltx-bg-color:#DCF0DC;" alttext="\mathbf{35.74}_{{\color[rgb]{0,1,0}+0.35}}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-bg-color:#DCF0DC;" class="ltx_mathvariant_bold" mathbackground="#DCF0DC" mathvariant="bold">35.74</mn><mrow><mo style="--ltx-fg-color:#00FF00;--ltx-bg-color:#DCF0DC;" mathbackground="#DCF0DC" mathcolor="#00FF00">+</mo><mn style="--ltx-fg-color:#00FF00;--ltx-bg-color:#DCF0DC;" mathbackground="#DCF0DC" mathcolor="#00FF00">0.35</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{35.74}_{{\color[rgb]{0,1,0}+0.35}}</annotation></semantics></math></td></tr>
