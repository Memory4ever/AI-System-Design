<td id="S4.T2.2.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding:0.75pt 10.0pt;"><span id="S4.T2.2.1.2.1" class="ltx_text ltx_font_bold">Performance (Avg)</span></td></tr>
<tr id="S4.T2.2.2" class="ltx_tr">
<td id="S4.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;">Mask-Voting</td>
<td id="S4.T2.2.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;"><math id="S4.T2.m1" class="ltx_Math" alttext="35.39" display="inline" intent=":literal"><semantics><mn>35.39</mn><annotation encoding="application/x-tex">35.39</annotation></semantics></math></td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<td id="S4.T2.2.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 10.0pt;" colspan="2"><span id="S4.T2.2.3.1.1" class="ltx_text ltx_font_italic">Layer Budget Allocation</span></td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<td id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;">+SqueezeAttention</td>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;"><math id="S4.T2.m2" class="ltx_Math" alttext="35.62_{{\color[rgb]{0,1,0}+0.23}}" display="inline" intent=":literal"><semantics><msub><mn>35.62</mn><mrow><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">+</mo><mn style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">0.23</mn></mrow></msub><annotation encoding="application/x-tex">35.62_{{\color[rgb]{0,1,0}+0.23}}</annotation></semantics></math></td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
<td id="S4.T2.2.5.1" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;">+PyramidKV</td>
<td id="S4.T2.2.5.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;"><math id="S4.T2.m3" class="ltx_Math" alttext="33.52_{{\color[rgb]{0.5,0.5,0.5}-1.87}}" display="inline" intent=":literal"><semantics><msub><mn>33.52</mn><mrow><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">−</mo><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1.87</mn></mrow></msub><annotation encoding="application/x-tex">33.52_{{\color[rgb]{0.5,0.5,0.5}-1.87}}</annotation></semantics></math></td></tr>
