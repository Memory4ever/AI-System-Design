<td id="S4.T1.4.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;" colspan="16"><span id="S4.T1.4.1.3.1.1" class="ltx_text ltx_font_bold">LLaDA-8B-Instruct</span></td></tr>
<tr id="S4.T1.4.1.4" class="ltx_tr">
<td id="S4.T1.4.1.4.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;" colspan="16">Full KV Cache</td></tr>
<tr id="S4.T1.4.1.5" class="ltx_tr">
<td id="S4.T1.4.1.5.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S4.T1.4.1.5.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">dLLM w/o Cache</span></td>
<td id="S4.T1.4.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S4.T1.4.1.5.2.1" class="ltx_text" style="--ltx-fg-color:#808080;">16.96</span></td>
<td id="S4.T1.4.1.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;"><span id="S4.T1.4.1.5.3.1" class="ltx_text" style="--ltx-fg-color:#808080;">31.31</span></td>
