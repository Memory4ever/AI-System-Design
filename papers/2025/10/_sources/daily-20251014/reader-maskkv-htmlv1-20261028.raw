<tr id="S4.T2.2.9" class="ltx_tr">
<td id="S4.T2.2.9.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;">+adaKV</td>
<td id="S4.T2.2.9.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;"><math id="S4.T2.m6" class="ltx_Math" alttext="35.70_{{\color[rgb]{0,1,0}+0.32}}" display="inline" intent=":literal"><semantics><msub><mn>35.70</mn><mrow><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">+</mo><mn style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">0.32</mn></mrow></msub><annotation encoding="application/x-tex">35.70_{{\color[rgb]{0,1,0}+0.32}}</annotation></semantics></math></td></tr>
<tr id="S4.T2.2.10" class="ltx_tr" style="--ltx-bg-color:#DCF0DC;">
<td id="S4.T2.2.10.1" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;"><span id="S4.T2.2.10.1.1" class="ltx_text" style="--ltx-bg-color:#DCF0DC;">+Prompt-Preference</span></td>
<td id="S4.T2.2.10.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;"><math id="S4.T2.m7" class="ltx_Math" style="--ltx-bg-color:#DCF0DC;" alttext="\mathbf{35.96}_{{\color[rgb]{0,1,0}+0.57}}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-bg-color:#DCF0DC;" class="ltx_mathvariant_bold" mathbackground="#DCF0DC" mathvariant="bold">35.96</mn><mrow><mo style="--ltx-fg-color:#00FF00;--ltx-bg-color:#DCF0DC;" mathbackground="#DCF0DC" mathcolor="#00FF00">+</mo><mn style="--ltx-fg-color:#00FF00;--ltx-bg-color:#DCF0DC;" mathbackground="#DCF0DC" mathcolor="#00FF00">0.57</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{35.96}_{{\color[rgb]{0,1,0}+0.57}}</annotation></semantics></math></td></tr>
<tr id="S4.T2.2.11" class="ltx_tr">
<td id="S4.T2.2.11.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 10.0pt;" colspan="2"><span id="S4.T2.2.11.1.1" class="ltx_text ltx_font_italic">Layer + Head Allocation</span></td></tr>
