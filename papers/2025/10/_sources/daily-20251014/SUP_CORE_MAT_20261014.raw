<td id="A10.T12.2.1.3.3" class="ltx_td ltx_align_center"><math id="A10.T12.m10" class="ltx_Math" alttext="69.0\pm 0.3" display="inline" intent=":literal"><semantics><mrow><mn>69.0</mn><mo>±</mo><mn>0.3</mn></mrow><annotation encoding="application/x-tex">69.0\pm 0.3</annotation></semantics></math></td>
<td id="A10.T12.2.1.3.4" class="ltx_td ltx_align_center"><math id="A10.T12.m11" class="ltx_Math" alttext="0.050\pm 0.006" display="inline" intent=":literal"><semantics><mrow><mn>0.050</mn><mo>±</mo><mn>0.006</mn></mrow><annotation encoding="application/x-tex">0.050\pm 0.006</annotation></semantics></math></td>
<td id="A10.T12.2.1.3.5" class="ltx_td ltx_align_center"><math id="A10.T12.m12" class="ltx_Math" alttext="50\pm 2" display="inline" intent=":literal"><semantics><mrow><mn>50</mn><mo>±</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">50\pm 2</annotation></semantics></math></td></tr>
<tr id="A10.T12.2.1.4" class="ltx_tr">
<th id="A10.T12.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A10.T12.m13" class="ltx_Math" alttext="w_{\mathrm{mAP}}{=}0.8,\;w_{\mathrm{stab}}{=}1.0,\;w_{\mathrm{conv}}{=}1.2,\;w_{\mathrm{pen}}{=}0.2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>mAP</mi></msub><mo>=</mo><mn>0.8</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>stab</mi></msub><mo>=</mo><mn>1.0</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>conv</mi></msub><mo>=</mo><mn>1.2</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>pen</mi></msub><mo>=</mo><mn>0.2</mn></mrow></mrow><annotation encoding="application/x-tex">w_{\mathrm{mAP}}{=}0.8,\;w_{\mathrm{stab}}{=}1.0,\;w_{\mathrm{conv}}{=}1.2,\;w_{\mathrm{pen}}{=}0.2</annotation></semantics></math></th>
<td id="A10.T12.2.1.4.2" class="ltx_td ltx_align_center"><math id="A10.T12.m14" class="ltx_Math" alttext="91.5\pm 0.2" display="inline" intent=":literal"><semantics><mrow><mn>91.5</mn><mo>±</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">91.5\pm 0.2</annotation></semantics></math></td>
<td id="A10.T12.2.1.4.3" class="ltx_td ltx_align_center"><math id="A10.T12.m15" class="ltx_Math" alttext="69.5\pm 0.2" display="inline" intent=":literal"><semantics><mrow><mn>69.5</mn><mo>±</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">69.5\pm 0.2</annotation></semantics></math></td>
<td id="A10.T12.2.1.4.4" class="ltx_td ltx_align_center"><math id="A10.T12.m16" class="ltx_Math" alttext="0.080\pm 0.009" display="inline" intent=":literal"><semantics><mrow><mn>0.080</mn><mo>±</mo><mn>0.009</mn></mrow><annotation encoding="application/x-tex">0.080\pm 0.009</annotation></semantics></math></td>
<td id="A10.T12.2.1.4.5" class="ltx_td ltx_align_center"><math id="A10.T12.m17" class="ltx_Math" alttext="45\pm 1" display="inline" intent=":literal"><semantics><mrow><mn>45</mn><mo>±</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">45\pm 1</annotation></semantics></math></td></tr>
<tr id="A10.T12.2.1.5" class="ltx_tr">
<th id="A10.T12.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A10.T12.m18" class="ltx_Math" alttext="w_{\mathrm{mAP}}{=}0.8,\;w_{\mathrm{stab}}{=}1.0,\;w_{\mathrm{conv}}{=}0.8,\;w_{\mathrm{pen}}{=}0.5" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>mAP</mi></msub><mo>=</mo><mn>0.8</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>stab</mi></msub><mo>=</mo><mn>1.0</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>conv</mi></msub><mo>=</mo><mn>0.8</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>pen</mi></msub><mo>=</mo><mn>0.5</mn></mrow></mrow><annotation encoding="application/x-tex">w_{\mathrm{mAP}}{=}0.8,\;w_{\mathrm{stab}}{=}1.0,\;w_{\mathrm{conv}}{=}0.8,\;w_{\mathrm{pen}}{=}0.5</annotation></semantics></math></th>
<td id="A10.T12.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A10.T12.m19" class="ltx_Math" alttext="91.0\pm 0.3" display="inline" intent=":literal"><semantics><mrow><mn>91.0</mn><mo>±</mo><mn>0.3</mn></mrow><annotation encoding="application/x-tex">91.0\pm 0.3</annotation></semantics></math></td>
