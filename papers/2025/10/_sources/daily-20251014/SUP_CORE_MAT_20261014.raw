<th id="A3.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A3.T4.m1" class="ltx_Math" alttext="\rho=1" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho=1</annotation></semantics></math></th>
<td id="A3.T4.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">35.2</td>
<td id="A3.T4.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">22.3</td>
<td id="A3.T4.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">28.5</td>
<td id="A3.T4.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">24.3</td>
<td id="A3.T4.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">42.1</td>
<td id="A3.T4.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">38.5</td>
<td id="A3.T4.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t">37.2</td>
<td id="A3.T4.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t">30.5</td></tr>
<tr id="A3.T4.2.1.4" class="ltx_tr">
<th id="A3.T4.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A3.T4.m2" class="ltx_Math" alttext="\rho=2" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\rho=2</annotation></semantics></math></th>
<td id="A3.T4.2.1.4.2" class="ltx_td ltx_align_center">38.7</td>
