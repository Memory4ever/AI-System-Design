<tr id="A10.T12.2.1.2" class="ltx_tr">
<th id="A10.T12.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A10.T12.m3" class="ltx_Math" alttext="w_{\mathrm{mAP}}{=}1.0,\;w_{\mathrm{stab}}{=}1.0,\;w_{\mathrm{conv}}{=}0.8,\;w_{\mathrm{pen}}{=}0.2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>mAP</mi></msub><mo>=</mo><mn>1.0</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>stab</mi></msub><mo>=</mo><mn>1.0</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>conv</mi></msub><mo>=</mo><mn>0.8</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>pen</mi></msub><mo>=</mo><mn>0.2</mn></mrow></mrow><annotation encoding="application/x-tex">w_{\mathrm{mAP}}{=}1.0,\;w_{\mathrm{stab}}{=}1.0,\;w_{\mathrm{conv}}{=}0.8,\;w_{\mathrm{pen}}{=}0.2</annotation></semantics></math></th>
