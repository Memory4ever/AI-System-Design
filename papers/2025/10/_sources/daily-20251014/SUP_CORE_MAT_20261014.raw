<th id="A3.T4.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A3.T4.m3" class="ltx_Math" alttext="\rho=5" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">\rho=5</annotation></semantics></math></th>
<td id="A3.T4.2.1.5.2" class="ltx_td ltx_align_center">45.3</td>
<td id="A3.T4.2.1.5.3" class="ltx_td ltx_align_center">32.8</td>
<td id="A3.T4.2.1.5.4" class="ltx_td ltx_align_center">37.5</td>
