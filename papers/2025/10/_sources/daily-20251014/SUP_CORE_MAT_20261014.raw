<td id="A4.T5.2.1.10.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T5.2.1.10.7.1" class="ltx_text ltx_font_bold">67.5</span></td>
<td id="A4.T5.2.1.10.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T5.2.1.10.8.1" class="ltx_text ltx_font_bold">87.8</span></td>
<td id="A4.T5.2.1.10.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T5.2.1.10.9.1" class="ltx_text ltx_font_bold">74.3</span></td></tr>
