<td id="A10.T12.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A10.T12.m6" class="ltx_Math" alttext="0.070\pm 0.008" display="inline" intent=":literal"><semantics><mrow><mn>0.070</mn><mo>±</mo><mn>0.008</mn></mrow><annotation encoding="application/x-tex">0.070\pm 0.008</annotation></semantics></math></td>
<td id="A10.T12.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A10.T12.m7" class="ltx_Math" alttext="47\pm 1" display="inline" intent=":literal"><semantics><mrow><mn>47</mn><mo>±</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">47\pm 1</annotation></semantics></math></td></tr>
<tr id="A10.T12.2.1.3" class="ltx_tr">
<th id="A10.T12.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A10.T12.m8" class="ltx_Math" alttext="w_{\mathrm{mAP}}{=}0.6,\;w_{\mathrm{stab}}{=}1.2,\;w_{\mathrm{conv}}{=}0.8,\;w_{\mathrm{pen}}{=}0.2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>mAP</mi></msub><mo>=</mo><mn>0.6</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>stab</mi></msub><mo>=</mo><mn>1.2</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>conv</mi></msub><mo>=</mo><mn>0.8</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>w</mi><mi>pen</mi></msub><mo>=</mo><mn>0.2</mn></mrow></mrow><annotation encoding="application/x-tex">w_{\mathrm{mAP}}{=}0.6,\;w_{\mathrm{stab}}{=}1.2,\;w_{\mathrm{conv}}{=}0.8,\;w_{\mathrm{pen}}{=}0.2</annotation></semantics></math></th>
