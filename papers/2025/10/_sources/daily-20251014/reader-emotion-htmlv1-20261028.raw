-ltx-fo-height:0.64em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.72" overflow="visible" transform="matrix(1 0 0 -1 0 7.56)" width="47.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.8" class="ltx_text" style="font-size:80%;">Accuracy</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 61.1 169.61)"><foreignObject style="--ltx-fo-width:15.64em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="183.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.9" class="ltx_text" style="font-size:80%;">Accuracy vs Missing Modality Rate</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M -25.3 -61.6 h 356.74 v 22.75 h -356.74 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -21.15 -50.22)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.22)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.61)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="1.2pt" transform="matrix(1 0 0 -1 0 0) translate(0.83,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path style="fill:none" d="M 14.58 0 C 14.58 1.53 13.34 2.77 11.81 2.77 C 10.28 2.77 9.04 1.53 9.04 0 C 9.04 -1.53 10.28 -2.77 11.81 -2.77 C 13.34 -2.77 14.58 -1.53 14.58 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.28 0) translate(54.27,0) matrix(1.0 0.0 0.0 1.0 -51.5 -3.77)"><foreignObject style="--ltx-fo-width:7.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="103.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.10" class="ltx_text">Edu-EmotionNet</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="1.2pt" transform="matrix(1 0 0 -1 133.83 0) translate(0.83,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 14.58 0 C 14.58 1.53 13.34 2.77 11.81 2.77 C 10.28 2.77 9.04 1.53 9.04 0 C 9.04 -1.53 10.28 -2.77 11.81 -2.77 C 13.34 -2.77 14.58 -1.53 14.58 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 159.11 0) translate(43.66,0) matrix(1.0 0.0 0.0 1.0 -40.9 -3.77)"><foreignObject style="--ltx-fo-width:5.99em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="82.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.11" class="ltx_text">HybridFusion</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="1.2pt" transform="matrix(1 0 0 -1 246.44 0) translate(0.83,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path style="fill:none" d="M 11.81 0 L 11.81 2.77 M 11.81 0 L 14.44 0.86 M 11.81 0 L 13.44 -2.24 M 11.81 0 L 10.18 -2.24 M 11.81 0 L 9.18 0.86"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 271.72 0) translate(38.36,0) matrix(1.0 0.0 0.0 1.0 -35.59 -3.69)"><foreignObject style="--ltx-fo-width:5.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="72.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.pic1.12" class="ltx_text">Late Fusion</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 5: </span>Accuracy under increasing missing modality rates.</figcaption>
</figure>
<div id="S5.SS5.p1" class="ltx_para">
<p id="S5.SS5.p1.1" class="ltx_p">Figure <a href="#S5.F5" title="Fig. 5 ‣ V-E Robustness to Missing Modalities ‣ V Results ‣ Edu-EmotionNet: Cross-Modality Attention Alignment with Temporal Feedback Loops" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> highlights Edu-EmotionNet’s remarkable resilience when modalities become unavailable: unlike HybridFusion and Late Fusion, which suffer steep performance drops beyond 40% missing data, our model’s accuracy declines only marginally (from 0.88 to 0.85 at 60% missing), demonstrating effective uncertainty-driven fusion and redundancy across modalities.</p>
</div>
</section>
<section id="S5.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS6.4" class="ltx_text">V-F</span> </span><span id="S5.SS6.5" class="ltx_text ltx_font_italic">Main Results</span></h3>

<figure id="S5.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">TABLE II: </span>Performance comparison (mean <math id="S5.T2.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> std over three runs)</figcaption>
