<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\beta}\log\prod_{i=1}^{n}\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]+\frac{1}{\beta}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\Big[q(\bm{z}_{1:T}\mid\bm{x})^{-n}\Big]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>β</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mi>log</mi><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>q</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>n</mi></mrow></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\log\prod_{i=1}^{n}\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]+\frac{1}{\beta}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\Big[q(\bm{z}_{1:T}\mid\bm{x})^{-n}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E21.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E21.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\beta}\sum_{i=1}^{n}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]+\tilde{C}(T)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi>log</mi><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>β</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>+</mo><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\sum_{i=1}^{n}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]+\tilde{C}(T)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A2.p5.2" class="ltx_p"><span id="A2.p5.2.1" class="ltx_text">Here, <math id="A2.p5.m2" class="ltx_math_unparsed" alttext="\bm{y}_{1:T}^{i}" display="inline" intent=":literal"><semantics><mrow><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\bm{y}_{1:T}^{i}</annotation></semantics></math> are copies of <math id="A2.p5.m3" class="ltx_math_unparsed" alttext="\bm{z}_{1:T}" display="inline" intent=":literal"><semantics><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{z}_{1:T}</annotation></semantics></math> enforced to agree with <math id="A2.p5.m4" class="ltx_math_unparsed" alttext="\bm{z}_{1:T}" display="inline" intent=":literal"><semantics><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{z}_{1:T}</annotation></semantics></math> using the indicator <math id="A2.p5.m5" class="ltx_math_unparsed" alttext="\mathbbm{1}(\bm{y}_{1:T}^{i}=\bm{z}_{1:T})" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒚</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mi>i</mi></msubsup><mo>=</mo><msub><mi>𝒛</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbbm{1}(\bm{y}_{1:T}^{i}=\bm{z}_{1:T})</annotation></semantics></math>. <math id="A2.p5.m6" class="ltx_Math" alttext="C(T)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(T)</annotation></semantics></math> is a constant independent of <math id="A2.p5.m7" class="ltx_Math" alttext="\bm{{\bm{\theta}}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">\bm{{\bm{\theta}}}</annotation></semantics></math>, and the first term in <a href="#A2.E21" title="In Proof. ‣ Appendix B Evidence Upper Bound for dLLMs ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">21</span></a> can be derived similar to the single variable case in <a href="#A2.E20" title="In Proof. ‣ Appendix B Evidence Upper Bound for dLLMs ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">20</span></a>:</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\beta}\sum_{i=1}^{n}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi>log</mi><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>β</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\sum_{i=1}^{n}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\beta}\sum_{i=1}^{n}\log\sum_{t=1}^{T-1}\mathbb{E}_{\bm{z}_{t+1}\sim q(\cdot\mid\bm{x})}\Bigg[\frac{\alpha_{t}-\alpha_{t+1}}{1-\alpha_{t+1}}\cdot\mathbbm{1}(\bm{z}_{t+1,i}=\bm{m})\cdot\pi_{{\bm{\theta}}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t+1})\Bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mi>𝒎</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\sum_{i=1}^{n}\log\sum_{t=1}^{T-1}\mathbb{E}_{\bm{z}_{t+1}\sim q(\cdot\mid\bm{x})}\Bigg[\frac{\alpha_{t}-\alpha_{t+1}}{1-\alpha_{t+1}}\cdot\mathbbm{1}(\bm{z}_{t+1,i}=\bm{m})\cdot\pi_{{\bm{\theta}}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t+1})\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.p6" class="ltx_para">
<p id="A2.p6.1" class="ltx_p"><span id="A2.p6.1.1" class="ltx_text">Additionally, for <math id="A2.p6.m1" class="ltx_Math" alttext="\beta\geq n" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>≥</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\beta\geq n</annotation></semantics></math>, we can obtain a tighter bound using Hölder’s inequality:</span></p>
</div>
<div id="A2.p7" class="ltx_para">
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\beta}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\prod_{i=1}^{n}\bigg(\frac{p_{\bm{{\bm{\theta}}}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mi>log</mi><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>β</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\prod_{i=1}^{n}\bigg(\frac{p_{\bm{{\bm{\theta}}}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{\beta}\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{n\beta}\sum_{i=1}^{n}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{{\bm{\theta}}}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{n\beta}\bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi>log</mi><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n\beta}\sum_{i=1}^{n}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{{\bm{\theta}}}}(\bm{z}_{t,i}\mid\bm{z}_{t+1})}{q(\bm{z}_{t,i}\mid\bm{z}_{t+1},\bm{x})}\bigg)^{n\beta}\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E22.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E22.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{n\beta}\sum_{i=1}^{n}\log\sum_{t=1}^{T-1}\mathbb{E}_{\bm{z}_{t+1}\sim q(\cdot\mid\bm{x})}\Bigg[\frac{\alpha_{t}-\alpha_{t+1}}{1-\alpha_{t+1}}\cdot\mathbbm{1}(\bm{z}_{t+1,i}=\bm{m})\cdot\pi_{{\bm{\theta}}}^{n\beta}(\bm{x}_{i}\mid\bm{z}_{t+1})\Bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi>log</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mi>𝒎</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>π</mi><mi>𝜽</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n\beta}\sum_{i=1}^{n}\log\sum_{t=1}^{T-1}\mathbb{E}_{\bm{z}_{t+1}\sim q(\cdot\mid\bm{x})}\Bigg[\frac{\alpha_{t}-\alpha_{t+1}}{1-\alpha_{t+1}}\cdot\mathbbm{1}(\bm{z}_{t+1,i}=\bm{m})\cdot\pi_{{\bm{\theta}}}^{n\beta}(\bm{x}_{i}\mid\bm{z}_{t+1})\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p8" class="ltx_para">
<p id="A2.p8.1" class="ltx_p"><span id="A2.p8.1.1" class="ltx_text">Denote <math id="A2.p8.m1" class="ltx_Math" alttext="\tilde{\beta}\vcentcolon=n\beta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>β</mi><mo>~</mo></mover><mo>:=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{\beta}\vcentcolon=n\beta</annotation></semantics></math>. Then the upper bound <math id="A2.p8.m2" class="ltx_math_unparsed" alttext="\log\pi_{{\bm{\theta}}}(\bm{x}_{1:n})\leq\mathcal{L}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>EUBO</mtext></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>;</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log\pi_{{\bm{\theta}}}(\bm{x}_{1:n})\leq\mathcal{L}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}})</annotation></semantics></math> holds with the constant term <math id="A2.p8.m3" class="ltx_Math" alttext="C(T)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(T)</annotation></semantics></math> being zero and the hyperparameter <math id="A2.p8.m4" class="ltx_Math" alttext="\tilde{\beta}\geq n" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>β</mi><mo>~</mo></mover><mo>≥</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\tilde{\beta}\geq n</annotation></semantics></math>. Combining these two cases, we have <math id="A2.p8.m5" class="ltx_Math" alttext="C(T)=\begin{cases}\tilde{C}(T),&amp;1\leq\beta&lt;n\\
0,&amp;\beta\geq n\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>&lt;</mo><mi>n</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>β</mi><mo>≥</mo><mi>n</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">C(T)=\begin{cases}\tilde{C}(T),&amp;1\leq\beta&lt;n\\
0,&amp;\beta\geq n\end{cases}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.p9" class="ltx_para">
<p id="A2.p9.1" class="ltx_p"><span id="A2.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.p10" class="ltx_para">
<p id="A2.p10.1" class="ltx_p">Furthermore, we can derive the continuous time version by omitting the constant term that does not affect the gradient with respect to <math id="A2.p10.m1" class="ltx_Math" alttext="\bm{{\bm{\theta}}}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">\bm{{\bm{\theta}}}</annotation></semantics></math>, and taking the limit of <math id="A2.p10.m2" class="ltx_Math" alttext="T\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">T\rightarrow\infty</annotation></semantics></math> similar as the derivations for <math id="A2.p10.m3" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math>, as shown in <a href="#S3.E7" title="In Corollary 1. ‣ 3.2 A Tractable Evidence Upper Bound ‣ 3 Sandwiched Policy Gradient with Evidence Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a>:</p>
</div>
<div id="Thmcorollary1a" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1a.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1a.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1a.p1" class="ltx_para">
<p id="Thmcorollary1a.p1.1" class="ltx_p"><span id="Thmcorollary1a.p1.1.1" class="ltx_text ltx_font_italic">Taking the limit of <math id="Thmcorollary1a.p1.m1" class="ltx_Math" alttext="T\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">T\rightarrow\infty</annotation></semantics></math>, we have:</span></p>
<table id="A2.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E23.m1" class="ltx_Math" alttext="\begin{split}&amp;\nabla_{\bm{{\bm{\theta}}}}\mathcal{L}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}})=\nabla_{\bm{{\bm{\theta}}}}\Big(\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}})+C(T)\Big)=\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}}),~~~~\text{where}\\
&amp;\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1:n};{\bm{\theta}})=\frac{1}{\beta}\sum_{i=1}^{n}\log\mathbb{E}_{t,\bm{z}_{t}}\left[w(t)\cdot\mathbbm{1}(\bm{z}_{t,i}=\bm{m})\cdot\pi^{\beta}_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t})\right].\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>𝜽</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">EUBO</mtext></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>;</mo><mi>𝜽</mi><mo stretchy="false">)</mo><mo>=</mo><mo>∇</mo><msub><mrow></mrow><mi>𝜽</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">EUBO</mtext></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>;</mo><mi>𝜽</mi><mo stretchy="false">)</mo><mo>+</mo><mi>C</mi><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mo>=</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>𝜽</mi></msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">EUBO</mtext></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>;</mo><mi>𝜽</mi><mo stretchy="false">)</mo><mo rspace="1.817em">,</mo><mtext class="ltx_mathvariant_italic">where</mtext></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">EUBO</mtext></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>;</mo><mi>𝜽</mi><mo stretchy="false">)</mo><mo>=</mo><mfrac><mn>1</mn><mi>β</mi></mfrac><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>log</mi><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub></mrow></msub><mo>[</mo><mi>w</mi><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟙</mn><mo stretchy="false">(</mo><mi>𝒛</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mi>𝒎</mi><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>π</mi><msup><mrow></mrow><mi>β</mi></msup><msub><mrow></mrow><mi>𝜽</mi></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mo>]</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\nabla_{\bm{{\bm{\theta}}}}\mathcal{L}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}})=\nabla_{\bm{{\bm{\theta}}}}\Big(\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}})+C(T)\Big)=\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1:n};\bm{{\bm{\theta}}}),~~~~\text{where}\\
&amp;\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1:n};{\bm{\theta}})=\frac{1}{\beta}\sum_{i=1}^{n}\log\mathbb{E}_{t,\bm{z}_{t}}\left[w(t)\cdot\mathbbm{1}(\bm{z}_{t,i}=\bm{m})\cdot\pi^{\beta}_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t})\right].\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.p11" class="ltx_para">
<p id="A2.p11.1" class="ltx_p">One caveat of the above <math id="A2.p11.m1" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> is that the <math id="A2.p11.m2" class="ltx_Math" alttext="\log" display="inline" intent=":literal"><semantics><mi>log</mi><annotation encoding="application/x-tex">\log</annotation></semantics></math> is outside of the expectation, which in general makes Monte Carlo sample estimates biased. One could certainly further loosen the bound using the inequality <math id="A2.p11.m3" class="ltx_Math" alttext="\log x\leq x-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>x</mi></mrow><mo>≤</mo><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\log x\leq x-1</annotation></semantics></math>:</p>
<table id="A2.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E24.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\text{EUBO}}(\bm{x})\leq\frac{1}{\beta}\sum_{i=1}^{n}\mathbb{E}_{t\sim\mathcal{U}[0,1],\bm{z}_{t}\sim q}\Bigg[w(t)\cdot\mathbbm{1}(\bm{z}_{t,i}=\bm{m})\cdot\pi_{\bm{{\bm{\theta}}}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t})\Bigg]-\frac{n}{\beta}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>EUBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mrow><mrow><mi>t</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>∼</mo><mi>q</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mrow><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mn>𝟙</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒛</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mi>𝒎</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>n</mi><mi>β</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{EUBO}}(\bm{x})\leq\frac{1}{\beta}\sum_{i=1}^{n}\mathbb{E}_{t\sim\mathcal{U}[0,1],\bm{z}_{t}\sim q}\Bigg[w(t)\cdot\mathbbm{1}(\bm{z}_{t,i}=\bm{m})\cdot\pi_{\bm{{\bm{\theta}}}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t})\Bigg]-\frac{n}{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p12" class="ltx_para">
<p id="A2.p12.1" class="ltx_p">But in practice we found this results in much worse performance, as demonstrated in <a href="#A5.T10" title="In Ablations on the Looser Upper Bound. ‣ E.2 Additional Ablation Results ‣ Appendix E Additional Results ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">10</span></a>, potentially due to the much larger gap between EUBO and likelihood.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Additional Analysis on Upper and Lower Bounds</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Proof of <a href="#S3.Ex4" title="Proposition 1 (Optimal Mixture Strictly Reduces Variance). ‣ Mixture of Upper and Lower Bound for Negative Advantage Traces. ‣ 3.3 Practical Considerations ‣ 3 Sandwiched Policy Gradient with Evidence Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="Thmprop1a" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop1a.2" class="ltx_text ltx_font_bold">Proposition 1</span></span><span id="Thmprop1a.3" class="ltx_text ltx_font_bold"> </span>(Optimal Mixture Strictly Reduces Variance)<span id="Thmprop1a.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop1a.p1" class="ltx_para">
<p id="Thmprop1a.p1.1" class="ltx_p"><span id="Thmprop1a.p1.1.1" class="ltx_text ltx_font_italic">Fix a coordinate <math id="Thmprop1a.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and let</span></p>
<table id="A3.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex22.m1" class="ltx_Math" alttext="\rho_{\beta}\coloneqq{w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})}/{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>≔</mo><mrow><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho_{\beta}\coloneqq{w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})}/{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmprop1a.p1.2" class="ltx_p"><span id="Thmprop1a.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmprop1a.p1.m2" class="ltx_Math" alttext="w(t,\bm{z}_{t})\coloneqq w(t)\mathbbm{1}(z_{t}=\bm{m})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>=</mo><mi>𝐦</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w(t,\bm{z}_{t})\coloneqq w(t)\mathbbm{1}(z_{t}=\bm{m})</annotation></semantics></math>. Then, the gradient of mixture objective (<a href="#S3.E8" title="Equation 8 ‣ Mixture of Upper and Lower Bound for Negative Advantage Traces. ‣ 3.3 Practical Considerations ‣ 3 Sandwiched Policy Gradient with Evidence Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) is given by</span></p>
<table id="A3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E25.m1" class="ltx_Math" alttext="\displaystyle g_{\omega,k}=((1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta})\,\partial_{\bm{\theta}_{k}}\log\pi_{\bm{\theta}}(\bm{x}\mid\bm{z}_{t},\bm{c})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mrow><mi>ω</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∂</mo><msub><mi>𝜽</mi><mi>k</mi></msub></msub><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>𝜽</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle g_{\omega,k}=((1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta})\,\partial_{\bm{\theta}_{k}}\log\pi_{\bm{\theta}}(\bm{x}\mid\bm{z}_{t},\bm{c}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="Thmprop1a.p1.3" class="ltx_p"><span id="Thmprop1a.p1.3.1" class="ltx_text ltx_font_italic">If <math id="Thmprop1a.p1.m3" class="ltx_Math" alttext="\operatorname{Var}((\rho_{\beta}-w(t,\bm{z}_{t}))\partial_{\bm{\theta}_{k}}\log\pi_{\bm{\theta}}(\bm{x}\mid\bm{z}_{t},\bm{c}))&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∂</mo><msub><mi>𝛉</mi><mi>k</mi></msub></msub><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>𝛉</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐳</mi><mi>t</mi></msub><mo>,</mo><mi>𝐜</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Var}((\rho_{\beta}-w(t,\bm{z}_{t}))\partial_{\bm{\theta}_{k}}\log\pi_{\bm{\theta}}(\bm{x}\mid\bm{z}_{t},\bm{c}))&gt;0</annotation></semantics></math>, then <math id="Thmprop1a.p1.m4" class="ltx_Math" alttext="\operatorname{Var}[g_{\omega,k}]" display="inline" intent=":literal"><semantics><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>g</mi><mrow><mi>ω</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Var}[g_{\omega,k}]</annotation></semantics></math> is a strictly convex quadratic in <math id="Thmprop1a.p1.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> and thus admits a unique minimizer <math id="Thmprop1a.p1.m6" class="ltx_Math" alttext="\omega_{k}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\omega_{k}^{\star}</annotation></semantics></math>. Moreover,</span></p>
<table id="A3.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex23.m1" class="ltx_Math" alttext="\operatorname{Var}[g_{\omega_{k}^{\star},k}]\;&lt;\;\min\!\big\{\operatorname{Var}[g_{0,k}],\ \operatorname{Var}[g_{1,k}]\big\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>g</mi><mrow><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.558em">&lt;</mo><mrow><mpadded style="width:1.653em;" width="1.653em"><mi>min</mi></mpadded><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>g</mi><mrow><mn>0</mn><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>g</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{Var}[g_{\omega_{k}^{\star},k}]\;&lt;\;\min\!\big\{\operatorname{Var}[g_{0,k}],\ \operatorname{Var}[g_{1,k}]\big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p"><span id="A3.SS1.p1.1.1" class="ltx_text">We first derive the formulas for the gradient of each objective. Consider a specific example <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>.
The gradient of the <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{ELBO}}</annotation></semantics></math> are given by:</span></p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E26.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\mathcal{L}_{\text{ELBO}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E26.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[w(t,\bm{z}_{t})\nabla\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>log</mi><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[w(t,\bm{z}_{t})\nabla\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
<tbody id="A3.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E27.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E27.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\nabla\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>[</mo><mi>w</mi><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">)</mo><mi>π</mi><msub><mrow></mrow><mi>𝜽</mi></msub><msup><mrow></mrow><mi>β</mi></msup><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>𝜽</mi></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo><mo>]</mo></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\nabla\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p1.2" class="ltx_p"><span id="A3.SS1.p1.2.1" class="ltx_text">Then the gradient of the mixture objective <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{Mix}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>Mix</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{Mix}}</annotation></semantics></math> is given by:</span></p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E28.m1" class="ltx_Math" alttext="\displaystyle\nabla_{\bm{\theta}}\tilde{\mathcal{L}}_{\text{Mix}}=\mathbb{E}\left[\Big((1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta}\Big)\nabla_{\bm{\theta}}\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>Mix</mtext></msub></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>𝜽</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>𝜽</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\bm{\theta}}\tilde{\mathcal{L}}_{\text{Mix}}=\mathbb{E}\left[\Big((1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta}\Big)\nabla_{\bm{\theta}}\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text">We further compute the per-parameter (per-dimension) variance of the gradient of <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{Mix}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>Mix</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{Mix}}</annotation></semantics></math> and consider the optimal mixture coefficient <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> to minimize the variance. For simplicity, we use the following short-hand notation:</span></p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex24.m1" class="ltx_Math" alttext="\displaystyle s_{k}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle s_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24.m2" class="ltx_Math" alttext="\displaystyle\coloneqq\partial_{\bm{\theta}_{k}}\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.111em">≔</mo><mrow><msub><mo rspace="0.167em">∂</mo><msub><mi>𝜽</mi><mi>k</mi></msub></msub><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>𝜽</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\coloneqq\partial_{\bm{\theta}_{k}}\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p"><span id="A3.SS1.p2.2.1" class="ltx_text">We denote the <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th coordinate of the gradient <math id="A3.SS1.p2.m4" class="ltx_Math" alttext="\nabla_{\bm{\theta}}\tilde{\mathcal{L}}_{\text{Mix}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>Mix</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla_{\bm{\theta}}\tilde{\mathcal{L}}_{\text{Mix}}</annotation></semantics></math> by <math id="A3.SS1.p2.m5" class="ltx_Math" alttext="g_{\omega,k}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>ω</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">g_{\omega,k}</annotation></semantics></math>. Then, the coordinate-wise variance of the gradient is given by</span></p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex25.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\!\big[g_{\omega,k}\big]" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><mi>ω</mi><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\!\big[g_{\omega,k}\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex25.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\!\Big[\big((1-\omega)\,w+\omega\,\rho_{\beta}\big)^{2}\,s_{k}^{2}\Big]-\Big(\mathbb{E}\!\big[\big((1-\omega)\,w+\omega\,\rho_{\beta}\big)\,s_{k}\big]\Big)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>s</mi><mi>k</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>−</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\!\Big[\big((1-\omega)\,w+\omega\,\rho_{\beta}\big)^{2}\,s_{k}^{2}\Big]-\Big(\mathbb{E}\!\big[\big((1-\omega)\,w+\omega\,\rho_{\beta}\big)\,s_{k}\big]\Big)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26.m1" class="ltx_Math" alttext="\displaystyle=\operatorname{Var}(ws_{k})+2\omega\operatorname{Cov}(ws_{k},(\rho_{\beta}-w)s_{k})+\omega^{2}\operatorname{Var}((\rho_{\beta}-w)s_{k})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>ω</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}(ws_{k})+2\omega\operatorname{Cov}(ws_{k},(\rho_{\beta}-w)s_{k})+\omega^{2}\operatorname{Var}((\rho_{\beta}-w)s_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.3" class="ltx_p"><span id="A3.SS1.p2.3.1" class="ltx_text">where we used the shorthand <math id="A3.SS1.p2.m6" class="ltx_Math" alttext="w\equiv w(t,z_{t})" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>≡</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w\equiv w(t,z_{t})</annotation></semantics></math>. The above expression is quadratic in <math id="A3.SS1.p2.m7" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> and we find the optimal <math id="A3.SS1.p2.m8" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> by setting the derivative of variance to zero:</span></p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex27.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial}{\partial\omega}\operatorname{Var}\!\big[g_{\omega,k}\big]=2\,\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)+2\omega\,\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>ω</mi></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><mi>ω</mi><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0.337em" rspace="0em">​</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\partial}{\partial\omega}\operatorname{Var}\!\big[g_{\omega,k}\big]=2\,\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)+2\omega\,\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex28.m1" class="ltx_Math" alttext="\displaystyle\Rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">⇒</mo><annotation encoding="application/x-tex">\displaystyle\Rightarrow</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex28.m2" class="ltx_Math" alttext="\displaystyle\;\omega_{k}^{\star}=-\,\frac{\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><mo>=</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;\omega_{k}^{\star}=-\,\frac{\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.4" class="ltx_p"><span id="A3.SS1.p2.4.1" class="ltx_text">The above yields a per-coordinate optimal <math id="A3.SS1.p2.m9" class="ltx_Math" alttext="\omega^{\star}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\omega^{\star}_{k}</annotation></semantics></math>. Equivalently, we can write <math id="A3.SS1.p2.m10" class="ltx_Math" alttext="\omega^{\star}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\omega^{\star}_{k}</annotation></semantics></math> as follows:</span></p>
<table id="A3.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex29.m1" class="ltx_Math" alttext="\displaystyle\omega_{k}^{\star}=\frac{\operatorname{Var}\!\big(w\,s_{k}\big)-\operatorname{Cov}\!\big(w\,s_{k},\rho_{\beta}\,s_{k}\big)}{\operatorname{Var}\!\big(w\,s_{k}\big)+\operatorname{Var}\!\big(\rho_{\beta}\,s_{k}\big)-2\,\operatorname{Cov}\!\big(w\,s_{k},\rho_{\beta}\,s_{k}\big)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.337em" rspace="0em">​</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\omega_{k}^{\star}=\frac{\operatorname{Var}\!\big(w\,s_{k}\big)-\operatorname{Cov}\!\big(w\,s_{k},\rho_{\beta}\,s_{k}\big)}{\operatorname{Var}\!\big(w\,s_{k}\big)+\operatorname{Var}\!\big(\rho_{\beta}\,s_{k}\big)-2\,\operatorname{Cov}\!\big(w\,s_{k},\rho_{\beta}\,s_{k}\big)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.5" class="ltx_p"><span id="A3.SS1.p2.5.1" class="ltx_text">Furthermore, <math id="A3.SS1.p2.m11" class="ltx_Math" alttext="\omega^{\star}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\omega^{\star}_{k}</annotation></semantics></math> is a minimizer of coordinate-wise variance in the non-degenerative case with <math id="A3.SS1.p2.m12" class="ltx_Math" alttext="\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)&gt;0</annotation></semantics></math>, as the variance is strongly convex in <math id="A3.SS1.p2.m13" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.p3" class="ltx_para">
<p id="A3.SS1.p3.1" class="ltx_p"><span id="A3.SS1.p3.1.1" class="ltx_text">The coordinate-wise variance of gradients in <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> (<math id="A3.SS1.p3.m2" class="ltx_Math" alttext="\omega=0" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\omega=0</annotation></semantics></math>) and <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{ELBO}}</annotation></semantics></math> (<math id="A3.SS1.p3.m4" class="ltx_Math" alttext="\omega=1" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\omega=1</annotation></semantics></math>), and the optimal mixture coefficient <math id="A3.SS1.p3.m5" class="ltx_Math" alttext="\omega^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\omega^{\star}</annotation></semantics></math> are then given by</span></p>
<table id="A3.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathcal{L}_{\text{ELBO}}:\quad\operatorname{Var}\!\big[g_{0,k}\big]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><mn>0</mn><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{ELBO}}:\quad\operatorname{Var}\!\big[g_{0,k}\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30.m2" class="ltx_Math" alttext="\displaystyle=\operatorname{Var}\!\big[w\,s_{k}\big]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}\!\big[w\,s_{k}\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_math_unparsed" alttext="\displaystyle\tilde{\mathcal{L}}_{\text{ELBO}}:\quad\operatorname{Var}\!\big[g_{1,k}\big]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>ELBO</mtext></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><mn>1</mn><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mathcal{L}}_{\text{ELBO}}:\quad\operatorname{Var}\!\big[g_{1,k}\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m2" class="ltx_Math" alttext="\displaystyle=\operatorname{Var}\!\big[w\,s_{k}\big]+2\,\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)+\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.337em" rspace="0em">​</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}\!\big[w\,s_{k}\big]+2\,\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)+\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_math_unparsed" alttext="\displaystyle\text{Optimal:}\;\;\operatorname{Var}\!\big[g_{\omega_{k}^{\star},k}\big]" display="inline" intent=":literal"><semantics><mrow><mtext>Optimal:</mtext><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{Optimal:}\;\;\operatorname{Var}\!\big[g_{\omega_{k}^{\star},k}\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m2" class="ltx_Math" alttext="\displaystyle=\operatorname{Var}\!\big[w\,s_{k}\big]-\frac{\Big(\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)\Big)^{2}}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0.170em">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\operatorname{Var}\!\big[w\,s_{k}\big]-\frac{\Big(\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)\Big)^{2}}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p3.2" class="ltx_p"><span id="A3.SS1.p3.2.1" class="ltx_text">The difference between the variance of <math id="A3.SS1.p3.m6" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.SS1.p3.m7" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{ELBO}}</annotation></semantics></math> with the optimal mixture coefficient can then be derived as follows:</span></p>
<table id="A3.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex33.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\!\big[w\,s_{k}\big]-\operatorname{Var}\!\big[g_{\omega_{k}^{\star},k}\big]" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\!\big[w\,s_{k}\big]-\operatorname{Var}\!\big[g_{\omega_{k}^{\star},k}\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex33.m2" class="ltx_Math" alttext="\displaystyle=\frac{\Big(\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)\Big)^{2}}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}\geq 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mfrac></mstyle><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\Big(\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)\Big)^{2}}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex34.m1" class="ltx_Math" alttext="\displaystyle\operatorname{Var}\!\big[\rho_{\beta}\,s_{k}\big]-\operatorname{Var}\!\big[g_{\omega_{k}^{\star},k}\big]" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>−</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>g</mi><mrow><msubsup><mi>ω</mi><mi>k</mi><mo>⋆</mo></msubsup><mo>,</mo><mi>k</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{Var}\!\big[\rho_{\beta}\,s_{k}\big]-\operatorname{Var}\!\big[g_{\omega_{k}^{\star},k}\big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m2" class="ltx_Math" alttext="\displaystyle=\frac{\Big(\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)+\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)\Big)^{2}}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}\geq 0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>w</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ρ</mi><mi>β</mi></msub><mo>−</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mfrac></mstyle><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\Big(\operatorname{Cov}\!\big(w\,s_{k},\;(\rho_{\beta}-w)\,s_{k}\big)+\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)\Big)^{2}}{\operatorname{Var}\!\big((\rho_{\beta}-w)\,s_{k}\big)}\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p3.3" class="ltx_p"><span id="A3.SS1.p3.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Additional Comparison Between the Mixture Loss and the Lower and Upper Bounds</h3>

<section id="A3.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Comparing Mixture with the Lower Bound.</h4>

<div id="A3.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS2.SSS0.Px1.p1.1" class="ltx_p">Consider the ratio of the coefficient of score function <math id="A3.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\nabla_{\bm{\theta}}\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\bm{\theta}}\log\pi_{\bm{\theta}}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})</annotation></semantics></math> in the gradient in the case of the mixture objective (i.e., <math id="A3.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{Mix}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>Mix</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{Mix}}</annotation></semantics></math> in <a href="#A3.E28" title="In Proof. ‣ C.1 Proof of ‣ Appendix C Additional Analysis on Upper and Lower Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">28</span></a>) over using only the lower bound (i.e., <math id="A3.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\nabla_{\bm{{\bm{\theta}}}}\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla_{\bm{{\bm{\theta}}}}\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> in <a href="#A3.E26" title="In Proof. ‣ C.1 Proof of ‣ Appendix C Additional Analysis on Upper and Lower Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">26</span></a>):</p>
<table id="A3.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_Math" alttext="\displaystyle\frac{w_{\text{Mix}}}{w_{\text{ELBO}}}=\frac{(1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta}}{w(t,\bm{z}_{t})}=(1-\omega)+\omega\frac{\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})}{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>w</mi><mtext>Mix</mtext></msub><msub><mi>w</mi><mtext>ELBO</mtext></msub></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow></mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{w_{\text{Mix}}}{w_{\text{ELBO}}}=\frac{(1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta}}{w(t,\bm{z}_{t})}=(1-\omega)+\omega\frac{\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})}{\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px1.p1.2" class="ltx_p">Treating the expectation over all samples <math id="A3.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[w(t,\bm{z}_{t})\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})\right]</annotation></semantics></math> as a constant (since it is averaged), the second term in the above ratio is strictly increasing in <math id="A3.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})</annotation></semantics></math>. This realizes a <span id="A3.SS2.SSS0.Px1.p1.2.1" class="ltx_text ltx_font_italic">confidence-aware weighting</span>: uncertain tokens with small <math id="A3.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})</annotation></semantics></math>, i.e., those with a low recovery chance, have a smaller weight, while confident tokens with large <math id="A3.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})</annotation></semantics></math> are upweighted, with sharpness being controlled by parameter <math id="A3.SS2.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and the blend by <math id="A3.SS2.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Comparing Mixture with the Upper Bound.</h4>

<div id="A3.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS2.SSS0.Px2.p1.1" class="ltx_p">We compute the ratio of coefficient of score function in the gradient of upper bound (i.e., <math id="A3.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> in <a href="#A3.E27" title="In Proof. ‣ C.1 Proof of ‣ Appendix C Additional Analysis on Upper and Lower Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">27</span></a>) over the mixture gradient:</p>
<table id="A3.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle\frac{w_{\text{EUBO}}}{w_{\text{Mix}}}=\frac{\omega\rho_{\beta}}{(1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msub><mi>w</mi><mtext>EUBO</mtext></msub><msub><mi>w</mi><mtext>Mix</mtext></msub></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>β</mi></msub></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{w_{\text{EUBO}}}{w_{\text{Mix}}}=\frac{\omega\rho_{\beta}}{(1-\omega)w(t,\bm{z}_{t})+\omega\rho_{\beta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px2.p1.2" class="ltx_p">Considering the above ratio, when <math id="A3.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><mi>𝒄</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\bm{\theta}}^{\beta}(\bm{x}_{i}\mid\bm{z}_{t},\bm{c})</annotation></semantics></math> is very small, the coefficient of score function in <math id="A3.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>𝜽</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla_{\bm{{\bm{\theta}}}}\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math>, <math id="A3.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="w_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">w_{\text{EUBO}}</annotation></semantics></math>, becomes very small, preventing updates to the parameters. However, the mixing approach maintains per-sample weights by preventing that from collapsing to (near) zero. In other words, for each sample, the mixture coefficient computes a convex interpolation that simultaneously floors very small EUBO weights to a minimum value and applies an uncertainty-aware capping to large EUBO weights.</p>
</div>
<figure id="A3.F7" class="ltx_figure"><img src="2510.09541v1/grad_norm.png" id="A3.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:405/120;" width="405" height="120" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7: </span>Dynamics of the gradient norm of models trained with different log-likelihood estimation methods. SPG w/ Mixture achieves lower gradient norm and more stable optimization. We report mean and standard deviation over a rolling window of 50 steps.</figcaption>
</figure>
</section>
<section id="A3.SS2.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Empirical Evidence of Reduced Gradient Variance.</h4>

<div id="A3.SS2.SSS0.Px3.p1" class="ltx_para">
<p id="A3.SS2.SSS0.Px3.p1.1" class="ltx_p">As a practical indicator of gradient variance, we plot the gradient norm of each model trained with different log-likelihood estimation methods for negative advantage traces in <a href="#A3.F7" title="In Comparing Mixture with the Upper Bound. ‣ C.2 Additional Comparison Between the Mixture Loss and the Lower and Upper Bounds ‣ Appendix C Additional Analysis on Upper and Lower Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">7</span></a>. When using the mixture objective, the model has consistently smaller and more stable gradient norm throughout training, aligning well with our theoretical analysis.</p>
</div>
</section>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Toy Example for Upper and Lower Bounds.</h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">In this section, we provide a toy example highlighting the contrasting behaviors and landscapes of the upper and lower bounds, further demonstrating the necessity to select the appropriate bound for optimization based on the optimization direction.</p>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p">Consider a simple case where the sequence length is 2 and the vocabulary size is 2, i.e., <math id="A3.SS3.p2.m1" class="ltx_Math" alttext="\bm{x}=[\bm{x}_{1},\bm{x}_{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒙</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝒙</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{x}=[\bm{x}_{1},\bm{x}_{2}]</annotation></semantics></math> and <math id="A3.SS3.p2.m2" class="ltx_Math" alttext="\mathcal{V}=\{A,B\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}=\{A,B\}</annotation></semantics></math>. Then, We can calculate <math id="A3.SS3.p2.m3" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.SS3.p2.m4" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> in closed form:</p>
<table id="A3.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E29.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\text{ELBO}}(\bm{x}=\text{AA})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒙</mi><mo>=</mo><mtext>AA</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{ELBO}}(\bm{x}=\text{AA})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E29.m2" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{2}\Big[\log\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MA})+\log\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MM})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>log</mi><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mtext>A</mtext><mo lspace="0em" rspace="0.167em">∣</mo><mtext>MA</mtext><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mtext>A</mtext><mo lspace="0em" rspace="0.167em">∣</mo><mtext>MM</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\Big[\log\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MA})+\log\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MM})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
<tbody id="A3.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E30.m1" class="ltx_math_unparsed" alttext="\displaystyle+\log\pi_{\bm{\theta}}(\bm{x}_{2}=\text{A}\mid\text{AM})+\log\pi_{\bm{\theta}}(\bm{x}_{2}=\text{A}\mid\text{MM})\Big]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>log</mi><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo>=</mo><mtext>A</mtext><mo lspace="0em" rspace="0.167em">∣</mo><mtext>AM</mtext><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>2</mn></msub><mo>=</mo><mtext>A</mtext><mo lspace="0em" rspace="0.167em">∣</mo><mtext>MM</mtext><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\log\pi_{\bm{\theta}}(\bm{x}_{2}=\text{A}\mid\text{AM})+\log\pi_{\bm{\theta}}(\bm{x}_{2}=\text{A}\mid\text{MM})\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
<tbody id="A3.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E31.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}=\text{AA})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒙</mi><mo>=</mo><mtext>AA</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}=\text{AA})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E31.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\beta}\log\Big(\frac{\pi_{\bm{\theta}}^{\beta}(\bm{x}_{1}=\text{A}\mid\text{MA})+\pi_{\bm{\theta}}^{\beta}(\bm{x}_{1}=\text{A}\mid\text{MM})}{2}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mtext>A</mtext></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mtext>MA</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mtext>A</mtext></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mtext>MM</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\beta}\log\Big(\frac{\pi_{\bm{\theta}}^{\beta}(\bm{x}_{1}=\text{A}\mid\text{MA})+\pi_{\bm{\theta}}^{\beta}(\bm{x}_{1}=\text{A}\mid\text{MM})}{2}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
<tbody id="A3.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E32.m1" class="ltx_Math" alttext="\displaystyle+\frac{1}{\beta}\log\Big(\frac{\pi_{\bm{\theta}}^{\beta}(\bm{x}_{2}=\text{A}\mid\text{AM})+\pi_{\bm{\theta}}^{\beta}(\bm{x}_{2}=\text{A}\mid\text{MM})}{2}\Big)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mn>2</mn></msub><mo>=</mo><mtext>A</mtext></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mtext>AM</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>π</mi><mi>𝜽</mi><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mn>2</mn></msub><mo>=</mo><mtext>A</mtext></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mtext>MM</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{\beta}\log\Big(\frac{\pi_{\bm{\theta}}^{\beta}(\bm{x}_{2}=\text{A}\mid\text{AM})+\pi_{\bm{\theta}}^{\beta}(\bm{x}_{2}=\text{A}\mid\text{MM})}{2}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p3" class="ltx_para">
<p id="A3.SS3.p3.1" class="ltx_p">For simplicity, denote <math id="A3.SS3.p3.m1" class="ltx_Math" alttext="a:=\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MA})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>:=</mo><mrow><msub><mi>π</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mtext>A</mtext></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mtext>MA</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a:=\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MA})</annotation></semantics></math> and <math id="A3.SS3.p3.m2" class="ltx_Math" alttext="b:=\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MM})" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>:=</mo><mrow><msub><mi>π</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒙</mi><mn>1</mn></msub><mo>=</mo><mtext>A</mtext></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mtext>MM</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b:=\pi_{\bm{\theta}}(\bm{x}_{1}=\text{A}\mid\text{MM})</annotation></semantics></math>, and consider the of the likelihood of the first token <math id="A3.SS3.p3.m3" class="ltx_Math" alttext="\bm{x}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{x}_{1}</annotation></semantics></math>. We have</p>
<table id="A3.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E33.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\text{ELBO}}(\bm{x}_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{ELBO}}(\bm{x}_{1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E33.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}(\log a+\log b)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>a</mi></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>b</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}(\log a+\log b)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
<tbody id="A3.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E34.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\beta}\log\Big(\frac{a^{\beta}+b^{\beta}}{2}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>a</mi><mi>β</mi></msup><mo>+</mo><msup><mi>b</mi><mi>β</mi></msup></mrow><mn>2</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\beta}\log\Big(\frac{a^{\beta}+b^{\beta}}{2}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p4" class="ltx_para">
<p id="A3.SS3.p4.1" class="ltx_p">Take the partial gradient with respect to <math id="A3.SS3.p4.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.SS3.p4.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> respectively,</p>
<table id="A3.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathcal{L}_{\text{ELBO}}(\bm{x}_{1})}{\partial a}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>a</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}_{\text{ELBO}}(\bm{x}_{1})}{\partial a}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2a};\ \frac{\partial\mathcal{L}_{\text{ELBO}}(\bm{x}_{1})}{\partial b}=\frac{1}{2b}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mfrac></mstyle></mrow><mo rspace="0.667em">;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>b</mi></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2a};\ \frac{\partial\mathcal{L}_{\text{ELBO}}(\bm{x}_{1})}{\partial b}=\frac{1}{2b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
<tbody id="A3.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1})}{\partial a}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>a</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1})}{\partial a}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36.m2" class="ltx_Math" alttext="\displaystyle=\frac{a^{\beta-1}}{a^{\beta}+b^{\beta}};\ \frac{\partial\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1})}{\partial b}=\frac{b^{\beta-1}}{a^{\beta}+b^{\beta}}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>a</mi><mrow><mi>β</mi><mo>−</mo><mn>1</mn></mrow></msup><mrow><msup><mi>a</mi><mi>β</mi></msup><mo>+</mo><msup><mi>b</mi><mi>β</mi></msup></mrow></mfrac></mstyle></mrow><mo rspace="0.667em">;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>b</mi></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>b</mi><mrow><mi>β</mi><mo>−</mo><mn>1</mn></mrow></msup><mrow><msup><mi>a</mi><mi>β</mi></msup><mo>+</mo><msup><mi>b</mi><mi>β</mi></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{a^{\beta-1}}{a^{\beta}+b^{\beta}};\ \frac{\partial\tilde{\mathcal{L}}_{\text{EUBO}}(\bm{x}_{1})}{\partial b}=\frac{b^{\beta-1}}{a^{\beta}+b^{\beta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p5" class="ltx_para">
<p id="A3.SS3.p5.1" class="ltx_p">Therefore, for <math id="A3.SS3.p5.m1" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math>, the gradient direction is dominated by the larger one between <math id="A3.SS3.p5.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.SS3.p5.m3" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>, while for <math id="A3.SS3.p5.m4" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math>, the gradient direction is dominated by the smaller one. Such property is illustrated in the landscapes of <math id="A3.SS3.p5.m5" class="ltx_Math" alttext="-\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><annotation encoding="application/x-tex">-\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.SS3.p5.m6" class="ltx_Math" alttext="-\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub></mrow><annotation encoding="application/x-tex">-\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> for <math id="A3.SS3.p5.m7" class="ltx_Math" alttext="a,b\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a,b\in(0,1)</annotation></semantics></math> in <a href="#A3.F8" title="In C.3 Toy Example for Upper and Lower Bounds. ‣ Appendix C Additional Analysis on Upper and Lower Bounds ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">8</span></a>.</p>
</div>
<figure id="A3.F8" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2"><img src="2510.09541v1/../iclr2026/images/elbo_3d.png" id="A3.F8.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/212;" width="229" height="212" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2510.09541v1/../iclr2026/images/eubo_3d.png" id="A3.F8.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/214;" width="229" height="214" alt="Refer to caption"></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8: </span>Landscapes of <math id="A3.F8.m6" class="ltx_Math" alttext="-\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><annotation encoding="application/x-tex">-\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.F8.m7" class="ltx_Math" alttext="-\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub></mrow><annotation encoding="application/x-tex">-\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> for <math id="A3.F8.m8" class="ltx_Math" alttext="0&lt;a,b&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>&lt;</mo><mi>a</mi></mrow><mo>,</mo><mrow><mi>b</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">0&lt;a,b&lt;1</annotation></semantics></math>. <math id="A3.F8.m9" class="ltx_Math" alttext="-\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub></mrow><annotation encoding="application/x-tex">-\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> is flatter among low value regions while sharper among high value regions, making it more suitable for log-likelihood minimization; vice versa for <math id="A3.F8.m10" class="ltx_Math" alttext="-\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub></mrow><annotation encoding="application/x-tex">-\mathcal{L}_{\text{ELBO}}</annotation></semantics></math>.</figcaption>
</figure>
<div id="A3.SS3.p6" class="ltx_para">
<p id="A3.SS3.p6.1" class="ltx_p">When <math id="A3.SS3.p6.m1" class="ltx_Math" alttext="\bm{x}=\text{AA}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>=</mo><mtext>AA</mtext></mrow><annotation encoding="application/x-tex">\bm{x}=\text{AA}</annotation></semantics></math> has negative advantage, the corresponding <math id="A3.SS3.p6.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.SS3.p6.m3" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> are minimized. For <math id="A3.SS3.p6.m4" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math>, the model benefits more from further decreasing the smaller one between probabilities <math id="A3.SS3.p6.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.SS3.p6.m6" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>. In the extreme case, <math id="A3.SS3.p6.m7" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}=-\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}=-\infty</annotation></semantics></math> when either <math id="A3.SS3.p6.m8" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> or <math id="A3.SS3.p6.m9" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> equals to zero, leaving the other term not sufficiently decreased. Instead, when using <math id="A3.SS3.p6.m10" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> for negative advantage traces, the larger one between <math id="A3.SS3.p6.m11" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.SS3.p6.m12" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> is preferentially minimized, leading to a more balanced optimization that stably decreases the log-likelihood.</p>
</div>
<div id="A3.SS3.p7" class="ltx_para">
<p id="A3.SS3.p7.1" class="ltx_p">Similarly, when <math id="A3.SS3.p7.m1" class="ltx_Math" alttext="\bm{x}=\text{AA}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>=</mo><mtext>AA</mtext></mrow><annotation encoding="application/x-tex">\bm{x}=\text{AA}</annotation></semantics></math> has positive advantage, the corresponding <math id="A3.SS3.p7.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> and <math id="A3.SS3.p7.m3" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> are maximized. Using <math id="A3.SS3.p7.m4" class="ltx_Math" alttext="\mathcal{L}_{\text{ELBO}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ELBO</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{ELBO}}</annotation></semantics></math> enables effectively increasing the smaller likelihood, while <math id="A3.SS3.p7.m5" class="ltx_Math" alttext="\tilde{\mathcal{L}}_{\text{EUBO}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mtext>EUBO</mtext></msub><annotation encoding="application/x-tex">\tilde{\mathcal{L}}_{\text{EUBO}}</annotation></semantics></math> focuses on the larger one, leading to a less efficient optimization.</p>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Additional Experimental Details</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Datasets and Reward Functions</h3>

<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">We follow the setting in <span id="A4.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">D1</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib50" title="" class="ltx_ref">Zhao et al., 2025</a>)</cite> and <span id="A4.SS1.p1.1.2" class="ltx_text ltx_font_smallcaps">WD1</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Tang et al., 2025</a>)</cite>, using the same reward functions and train-test splitting, except for Sudoku. The rewards are designed to encourage both correctness and proper formatting, with varying levels of granularity tailored for each task. For completeness, we provide details as follows.</p>
</div>
<section id="A4.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">GSM8K.</h4>

<div id="A4.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS1.SSS0.Px1.p1.1" class="ltx_p">We utilize the train split of the GSM8K dataset<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
                <span class="ltx_tag ltx_tag_note">3</span>
                
                
                
                
                
                
                
              <a href="https://huggingface.co/datasets/openai/gsm8k" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/openai/gsm8k</a></span></span></span> for RL training, and evaluate model performance on the test split. We follow the Unsloth reward setup<span id="footnote4" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">4</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">4</sup>
                <span class="ltx_tag ltx_tag_note">4</span>
                
                
                
                
                
                
                
              <a href="https://unsloth.ai/blog/r1-reasoning" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://unsloth.ai/blog/r1-reasoning</a></span></span></span>, utilizing five equally-weighted additive components:</p>
<ul id="A4.I1" class="ltx_itemize">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p">XML Structure Reward: +0.125 per correct formatting tag; small penalties for extra contents after the closing tag.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p">Soft Format Reward: +0.5 for outputs matching the pattern:
<br class="ltx_break"><span id="A4.I1.i2.p1.1.1" class="ltx_text ltx_font_typewriter">&lt;reasoning&gt;...&lt;/reasoning&gt;&lt;answer&gt;...&lt;/answer&gt;</span></p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p">Strict Format Reward: +0.5 for exact formatting with correct line breaks.</p>
</div></li>
<li id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i4.p1" class="ltx_para">
<p id="A4.I1.i4.p1.1" class="ltx_p">Integer Answer Reward: +0.5 if the answer is a valid integer.</p>
</div></li>
<li id="A4.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i5.p1" class="ltx_para">
<p id="A4.I1.i5.p1.1" class="ltx_p">Correctness Reward: +2.0 of the answer matches the ground truth.</p>
</div></li>
</ul>
</div>
</section>
<section id="A4.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">MATH500.</h4>

<div id="A4.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A4.SS1.SSS0.Px2.p1.1" class="ltx_p">We utilize the train split of the MATH dataset<span id="footnote5" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">5</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">5</sup>
                <span class="ltx_tag ltx_tag_note">5</span>
                
                
                
                
                
                
                
              <a href="https://huggingface.co/datasets/ankner/math-500" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/ankner/math-500</a></span></span></span> for RL training, and evaluate model performance on the test split. We use a format reward and a correctness reward:</p>
<ul id="A4.I2" class="ltx_itemize">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p">Format Reward: We award 1.00 if &lt;answer&gt;&lt;/answer&gt; tags are present with \boxed inside them; 0.75 if answer tags are present without \boxed; 0.50 if answer tags are not present but \boxed is present; 0.25 if neither the answer tags nor \boxed is present.</p>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p">Correctness Reward: We award 2.00 if the answer in <span id="A4.I2.i2.p1.1.1" class="ltx_text ltx_font_typewriter">\boxed{}</span> matches the ground truth.</p>
</div></li>
</ul>
</div>
</section>
<section id="A4.SS1.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Countdown.</h4>

<div id="A4.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="A4.SS1.SSS0.Px3.p1.1" class="ltx_p">We utilize the train split of the Countdown dataset<span id="footnote6" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">6</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">6</sup>
                <span class="ltx_tag ltx_tag_note">6</span>
                
                
                
                
                
                
                
              <a href="https://huggingface.co/datasets/Jiayi-Pan/Countdown-Tasks-3to4" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/Jiayi-Pan/Countdown-Tasks-3to4</a></span></span></span> for RL training, restricting to instances that use only three numbers. We evaluate on the same set of 256 synthetically generated countdown questions with 3 numbers as in <span id="A4.SS1.SSS0.Px3.p1.1.1" class="ltx_text ltx_font_smallcaps">D1</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib50" title="" class="ltx_ref">Zhao et al., 2025</a>)</cite>. The reward covers three cases: +1.0 if the expression reaches the target using the exact numbers; +0.1 if the numbers are correct but does not reach the target; +0.0 otherwise.</p>
</div>
</section>
<section id="A4.SS1.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sudoku.</h4>

<div id="A4.SS1.SSS0.Px4.p1" class="ltx_para">
<p id="A4.SS1.SSS0.Px4.p1.1" class="ltx_p">We experiment on the 4<math id="A4.SS1.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>4 Sudoku dataset<span id="footnote7" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">7</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">7</sup>
                <span class="ltx_tag ltx_tag_note">7</span>
                
                
                
                
                
                
                
              <a href="https://github.com/Black-Phoenix/4x4-Sudoku-Dataset" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://github.com/Black-Phoenix/4x4-Sudoku-Dataset</a></span></span></span> generated by <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib1" title="" class="ltx_ref">Arel (2025)</a></cite>. The original training split contains 1M unique Sudoku puzzles covering all 288 4<math id="A4.SS1.SSS0.Px4.p1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>4 Soduku solutions. To avoid train-test leakage and potential cheating by memorizing all the solutions, we randomly select 200 solutions and include all puzzles corresponding to these solutions into the new training set, resulting in 694,006 training puzzles. We then randomly select 2 or 3 puzzles corresponding to the left 88 solutions to construct the test set, which has 256 Soduku puzzles in total.</p>
</div>
<div id="A4.SS1.SSS0.Px4.p2" class="ltx_para">
<p id="A4.SS1.SSS0.Px4.p2.1" class="ltx_p">We observe that the zero-shot setting is too difficult for the base LLaDA-8B-Instruct model, which has test accuracy below 7% with a generation length of 256 and struggles to correctly interpret the questions, leading to very few meaningful RL rollouts. Therefore, we instead use 3-shot for all the Sudoku experiments. We ensure that the solutions presented in the 3-shot samples do not appear in test set solutions, and the puzzles do not appear in both train and test set. The detailed few-shot samples are provided in <a href="#A4.SS3" title="D.3 Few-Shot Samples for Sudoku ‣ Appendix D Additional Experimental Details ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">D.3</span></a>.</p>
</div>
</section>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Hyperparameter Settings and Implementation Details</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p">We follow <span id="A4.SS2.p1.1.1" class="ltx_text ltx_font_smallcaps">D1</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib50" title="" class="ltx_ref">Zhao et al., 2025</a>)</cite> for most hyperparameter settings. We employ Low-Rank Adaptation (LoRA) with a rank of <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="r=128" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>128</mn></mrow><annotation encoding="application/x-tex">r=128</annotation></semantics></math> and scaling factor <math id="A4.SS2.p1.m2" class="ltx_Math" alttext="\alpha=64" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">\alpha=64</annotation></semantics></math>. The training was conducted on 8 NVIDIA A100-80G or NVIDIA H100-80G GPU, with the following hyperparameters: batch size of 6 per GPU, and gradient accumulation steps of 2. We set the number of inner gradient update <math id="A4.SS2.p1.m3" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> as 4 for all models. We use the AdamW optimizer <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib23" title="" class="ltx_ref">Loshchilov and Hutter, 2017</a>)</cite>, with <math id="A4.SS2.p1.m4" class="ltx_Math" alttext="\beta_{1}=0.9" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\beta_{1}=0.9</annotation></semantics></math>, <math id="A4.SS2.p1.m5" class="ltx_Math" alttext="\beta_{2}=0.99" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.99</mn></mrow><annotation encoding="application/x-tex">\beta_{2}=0.99</annotation></semantics></math>, weight decay of 0.1, learning rate of <math id="A4.SS2.p1.m6" class="ltx_Math" alttext="3\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3\times 10^{-6}</annotation></semantics></math>, and gradient clipping at 0.2. We utilize Flash Attention 2 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib11" title="" class="ltx_ref">Dao, 2023</a>)</cite>and 4-bit quantization.</p>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p">For RL rollout, we use sequence length of 256 tokens, and 128 diffusion steps. We employ confidence-based semi-autoregressive generation with block size 32, and set the temperature as 0.9 (except for Sudoku where temperature is set as 0.3 following <span id="A4.SS2.p2.1.1" class="ltx_text ltx_font_smallcaps">D1</span>). We set number of completions per prompt <math id="A4.SS2.p2.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> as 6, and number of Monte Carlo estimation samples <math id="A4.SS2.p2.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> as 2 due to computational constraint. Since the rollout stage dominates the training time, the average time per gradient update step for SPG is similar to that of the other baselines.</p>
</div>
<div id="A4.SS2.p3" class="ltx_para">
<p id="A4.SS2.p3.1" class="ltx_p">We train 6000 steps (i.e., number of gradient updates) for GSM8K and Countdown, 4000 steps for MATH500, and 2500 steps for Sudoku. For all RL models, we run evaluation every 100 steps with generation sequence length 128, 256, 512, and report the result of the checkpoint with the highest average accuracy over the three generation lengths, except for the ablations on inference strategies in <a href="#A5.T13" title="In Ablations on Pass@K Performance. ‣ E.2 Additional Ablation Results ‣ Appendix E Additional Results ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">13</span></a>, where we only evaluate on generation length 256.</p>
</div>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Few-Shot Samples for Sudoku</h3>

<section id="A4.SS3.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sample 1:</h4>

<div id="A4.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS3.SSS0.Px1.p1.pic1" class="ltx_picture" height="469.54" overflow="visible" version="1.1" viewBox="0 0 653.15 469.54" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,469.54) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#F9F5E9;" fill="#F9F5E9" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 469.54 L 653.15 469.54 L 653.15 0 Z"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 469.19 L 653.15 469.19"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 0.35 L 653.15 0.35"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 467.81 L 653.15 467.81"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 1.73 L 653.15 1.73"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 4.15 7.61)"><foreignObject style="--ltx-fo-width:46.6em;--ltx-fo-height:33.08em;--ltx-fo-depth:0.25em;font-size:10pt;" height="461.24" overflow="visible" transform="matrix(1 0 0 -1 0 457.78)" width="644.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.SS3.SSS0.Px1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:46.6em;">
<span id="A4.SS3.SSS0.Px1.p1.pic1.1.1" class="ltx_p"><span id="A4.SS3.SSS0.Px1.p1.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Question:
<br class="ltx_break">Solve the following Sudoku puzzle: 3014002020004130
<br class="ltx_break">Answer:
<br class="ltx_break">&lt;reasoning&gt;
<br class="ltx_break">Interpret puzzle as 4 rows of 4:
<br class="ltx_break">R1: 3 0 1 4
<br class="ltx_break">R2: 0 0 2 0
<br class="ltx_break">R3: 2 0 0 0
<br class="ltx_break">R4: 4 1 3 0
<br class="ltx_break">
<br class="ltx_break">Fill easy singles:
<br class="ltx_break">R1 missing 2 → R1C2=2.
<br class="ltx_break">R4 missing 2 → R4C4=2.
<br class="ltx_break">Box D (R3-4,C3-4) then needs 1,4; column4 can only accept 1 → R3C4=1, R3C3=4.
<br class="ltx_break">R3 now missing 3 → R3C2=3.
<br class="ltx_break">Column1 missing 1 → R2C1=1.
<br class="ltx_break">Column2 missing 4 → R2C2=4.
<br class="ltx_break">Last cell R2C4=3.
<br class="ltx_break">
<br class="ltx_break">Final grid:
<br class="ltx_break">R1: 3 2 1 4
<br class="ltx_break">R2: 1 4 2 3
<br class="ltx_break">R3: 2 3 4 1
<br class="ltx_break">R4: 4 1 3 2
<br class="ltx_break">&lt;/reasoning&gt;
<br class="ltx_break">&lt;answer&gt;
<br class="ltx_break">3214142323414132
<br class="ltx_break">&lt;/answer&gt;</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A4.SS3.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sample 2:</h4>

<div id="A4.SS3.SSS0.Px2.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS3.SSS0.Px2.p1.pic1" class="ltx_picture" height="486.14" overflow="visible" version="1.1" viewBox="0 0 653.15 486.14" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,486.14) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#F9F5E9;" fill="#F9F5E9" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 486.14 L 653.15 486.14 L 653.15 0 Z"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 485.79 L 653.15 485.79"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 0.35 L 653.15 0.35"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 484.41 L 653.15 484.41"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 1.73 L 653.15 1.73"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 4.15 7.61)"><foreignObject style="--ltx-fo-width:46.6em;--ltx-fo-height:34.28em;--ltx-fo-depth:0.25em;font-size:10pt;" height="477.84" overflow="visible" transform="matrix(1 0 0 -1 0 474.38)" width="644.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.SS3.SSS0.Px2.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:46.6em;">
<span id="A4.SS3.SSS0.Px2.p1.pic1.1.1" class="ltx_p"><span id="A4.SS3.SSS0.Px2.p1.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Question:
<br class="ltx_break">Solve the following Sudoku puzzle: 0000100420013142
<br class="ltx_break">Answer:
<br class="ltx_break">&lt;reasoning&gt;
<br class="ltx_break">Interpret puzzle as 4 rows of 4:
<br class="ltx_break">R1: 0 0 0 0
<br class="ltx_break">R2: 1 0 0 4
<br class="ltx_break">R3: 2 0 0 1
<br class="ltx_break">R4: 3 1 4 2
<br class="ltx_break">
<br class="ltx_break">Fill easy singles:
<br class="ltx_break">Col1 missing 4 → R1C1=4.
<br class="ltx_break">Col4 missing 3 → R1C4=3.
<br class="ltx_break">Box A (R1-2,C1-2) missing 2,3 and R1 now needs 1,2 → R1C2=2, R2C2=3.
<br class="ltx_break">R1C3=1.
<br class="ltx_break">R2 now missing 2 → R2C3=2.
<br class="ltx_break">Col2 missing 4 → R3C2=4, then R3C3=3.
<br class="ltx_break">
<br class="ltx_break">Final grid:
<br class="ltx_break">R1: 4 2 1 3
<br class="ltx_break">R2: 1 3 2 4
<br class="ltx_break">R3: 2 4 3 1
<br class="ltx_break">R4: 3 1 4 2
<br class="ltx_break">&lt;/reasoning&gt;
<br class="ltx_break">&lt;answer&gt;
<br class="ltx_break">4213132424313142
<br class="ltx_break">&lt;/answer&gt;</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A4.SS3.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sample 3:</h4>

<div id="A4.SS3.SSS0.Px3.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS3.SSS0.Px3.p1.pic1" class="ltx_picture" height="469.54" overflow="visible" version="1.1" viewBox="0 0 653.15 469.54" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,469.54) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#F9F5E9;" fill="#F9F5E9" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 469.54 L 653.15 469.54 L 653.15 0 Z"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 469.19 L 653.15 469.19"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 0.35 L 653.15 0.35"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 467.81 L 653.15 467.81"></path></g><g style="--ltx-stroke-color:#E0D7BC;--ltx-fill-color:#E0D7BC;--ltx-fg-color:#E0D7BC;" color="#E0D7BC" fill="#E0D7BC" stroke="#E0D7BC" stroke-width="0.5pt"><path style="fill:none" d="M 0 1.73 L 653.15 1.73"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 4.15 7.61)"><foreignObject style="--ltx-fo-width:46.6em;--ltx-fo-height:33.08em;--ltx-fo-depth:0.25em;font-size:10pt;" height="461.24" overflow="visible" transform="matrix(1 0 0 -1 0 457.78)" width="644.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.SS3.SSS0.Px3.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:46.6em;">
<span id="A4.SS3.SSS0.Px3.p1.pic1.1.1" class="ltx_p"><span id="A4.SS3.SSS0.Px3.p1.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Question:
<br class="ltx_break">Solve the following Sudoku puzzle: 2001403002001420
<br class="ltx_break">Answer:
<br class="ltx_break">&lt;reasoning&gt;
<br class="ltx_break">Interpret puzzle as 4 rows of 4:
<br class="ltx_break">R1: 2 0 0 1
<br class="ltx_break">R2: 4 0 3 0
<br class="ltx_break">R3: 0 2 0 0
<br class="ltx_break">R4: 1 4 2 0
<br class="ltx_break">
<br class="ltx_break">Fill easy singles:
<br class="ltx_break">R1 missing 3,4; Col2 can’t be 1 so R1C2=3 → R1C3=4.
<br class="ltx_break">R4 missing 3 → R4C4=3.
<br class="ltx_break">Col4 missing 2,4; R2 must take 2 → R2C4=2 → R2C2=1.
<br class="ltx_break">Col1 missing 3 → R3C1=3.
<br class="ltx_break">Col3 missing 1 → R3C3=1 → R3C4=4.
<br class="ltx_break">
<br class="ltx_break">Final grid:
<br class="ltx_break">R1: 2 3 4 1
<br class="ltx_break">R2: 4 1 3 2
<br class="ltx_break">R3: 3 2 1 4
<br class="ltx_break">R4: 1 4 2 3
<br class="ltx_break">&lt;/reasoning&gt;
<br class="ltx_break">&lt;answer&gt;
<br class="ltx_break">2341413232141423
<br class="ltx_break">&lt;/answer&gt;</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Additional Results</h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Additional Evaluations to the Main Results</h3>

<section id="A5.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Complete evaluation results.</h4>

<div id="A5.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A5.SS1.SSS0.Px1.p1.1" class="ltx_p">We provide the complete evaluation results, along with those reported in <span id="A5.SS1.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_smallcaps">D1</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib50" title="" class="ltx_ref">Zhao et al., 2025</a>)</cite> and <span id="A5.SS1.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_smallcaps">WD1</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Tang et al., 2025</a>)</cite>, in <a href="#A5.T4" title="In Complete evaluation results. ‣ E.1 Additional Evaluations to the Main Results ‣ Appendix E Additional Results ‣ SPG: Sandwiched Policy Gradient for Masked Diffusion Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">4</span></a>. Our reproduced numbers closely match the reported results. d1-LLaDA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib50" title="" class="ltx_ref">Zhao et al., 2025</a>)</cite> denotes the model that conducts first SFT and then RL (using <span id="A5.SS1.SSS0.Px1.p1.1.3" class="ltx_text ltx_font_smallcaps">D1</span>). All other models are trained solely with RL.
In <span id="A5.SS1.SSS0.Px1.p1.1.4" class="ltx_text ltx_font_smallcaps">D1</span> and d1-LLaDA, the best result for each generation length is reported separately, whereas we select a single checkpoint with the highest average accuracy across all three generation lengths, leading to slightly worse results than the reported numbers. The reported results in <span id="A5.SS1.SSS0.Px1.p1.1.5" class="ltx_text ltx_font_smallcaps">WD1</span> are based on evaluations on fewer checkpoints, so they are generally a bit lower than our reproduced values.</p>
</div>
<figure id="A5.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 4: </span>Complete model performance on four reasoning benchmarks compared with baselines. We provide both the reported and the reproduced results for <span id="A5.T4.4" class="ltx_text ltx_font_smallcaps">D1</span> and <span id="A5.T4.5" class="ltx_text ltx_font_smallcaps">WD1</span>. The best results are bolded and the second best are underlined. SPG consistently outperforms all other models.</figcaption>
