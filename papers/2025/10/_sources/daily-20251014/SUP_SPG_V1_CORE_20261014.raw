<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\beta}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[q(\bm{z}_{1:T}\mid\bm{x})^{-n}\prod_{i=1}^{n}\sum_{\bm{y}_{1:T}^{i}}q(\bm{y}_{1:T}^{i}\mid\bm{x})\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{y}_{t,i}^{i}\mid\bm{y}_{t+1}^{i}}{q(\bm{y}_{t,i}^{i}\mid\bm{y}_{t+1}^{i},\bm{x})}\bigg)^{\beta}\bigg]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle><mi>log</mi><msub><mi>𝔼</mi><mrow><mi>𝒛</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>q</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>n</mi></mrow></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><msup><mrow></mrow><mi>i</mi></msup></mrow></munder></mstyle><mi>q</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒚</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒚</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mi>i</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msubsup><mi>𝒚</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝒚</mi><mrow><mi>t</mi><mo>,</mo><mi>i</mi></mrow><mi>i</mi></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msubsup><mi>𝒚</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>,</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>β</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\beta}\log\mathbb{E}_{\bm{z}_{1:T}\sim q(\cdot\mid\bm{x})}\bigg[q(\bm{z}_{1:T}\mid\bm{x})^{-n}\prod_{i=1}^{n}\sum_{\bm{y}_{1:T}^{i}}q(\bm{y}_{1:T}^{i}\mid\bm{x})\prod_{t=1}^{T-1}\bigg(\frac{p_{\bm{\theta}}(\bm{y}_{t,i}^{i}\mid\bm{y}_{t+1}^{i}}{q(\bm{y}_{t,i}^{i}\mid\bm{y}_{t+1}^{i},\bm{x})}\bigg)^{\beta}\bigg]</annotation></semantics></math></td>
