<td id="S5.T1.2.15.1" class="ltx_td ltx_align_left">PI Sanitization</td>
<td id="S5.T1.2.15.2" class="ltx_td ltx_align_right">74.23</td>
<td id="S5.T1.2.15.3" class="ltx_td ltx_align_right">63.65</td>
<td id="S5.T1.2.15.4" class="ltx_td ltx_nopad_r ltx_align_right">13.91</td></tr>
<tr id="S5.T1.2.16" class="ltx_tr">
<td id="S5.T1.2.16.1" class="ltx_td ltx_align_left"><span id="S5.T1.2.16.1.1" class="ltx_text ltx_font_typewriter">CommandSans</span> (Ours)</td>
<td id="S5.T1.2.16.2" class="ltx_td ltx_align_right">68.04</td>
