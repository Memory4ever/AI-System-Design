<td id="S5.T1.2.16.4" class="ltx_td ltx_nopad_r ltx_align_right">2.53</td></tr>
<tr id="S5.T1.2.17" class="ltx_tr">
<td id="S5.T1.2.17.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S5.T1.2.17.1.1" class="ltx_text ltx_font_typewriter">CommandSans</span>* (Ours)</td>
<td id="S5.T1.2.17.2" class="ltx_td ltx_align_right ltx_border_bb">74.23</td>
