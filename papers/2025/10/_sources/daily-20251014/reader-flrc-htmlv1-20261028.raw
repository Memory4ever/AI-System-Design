<tr id="S3.T1.2.1.4" class="ltx_tr">
<th id="S3.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">-</th>
<th id="S3.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">Baseline</th>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">24.72</td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t">86.79</td>
<td id="S3.T1.2.1.4.5" class="ltx_td ltx_align_center ltx_border_t">24.34</td>
<td id="S3.T1.2.1.4.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">86.51</td>
<td id="S3.T1.2.1.4.7" class="ltx_td ltx_align_center ltx_border_t">24.56</td>
<td id="S3.T1.2.1.4.8" class="ltx_td ltx_align_center ltx_border_t">87.75</td>
<td id="S3.T1.2.1.4.9" class="ltx_td ltx_align_center ltx_border_t">24.82</td>
<td id="S3.T1.2.1.4.10" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">87.23</td></tr>
<tr id="S3.T1.2.1.5" class="ltx_tr">
