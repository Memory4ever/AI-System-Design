<td id="A5.T5.2.1.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" rowspan="2"><span id="A5.T5.2.1.1.2.1" class="ltx_text">DialogSum ROUGE-L ↑</span></td></tr>
