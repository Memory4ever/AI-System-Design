<tr id="A11.T14.2.1.1" class="ltx_tr">
<th id="A11.T14.2.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" rowspan="2"><span id="A11.T14.2.1.1.1.1" class="ltx_text">Method</span></th>
<th id="A11.T14.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" rowspan="2"><span id="A11.T14.2.1.1.2.1" class="ltx_text">Comp. Rate</span></th>
