<td id="A11.T14.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">7.81</td>
<td id="A11.T14.2.1.3.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">11.33</td></tr>
