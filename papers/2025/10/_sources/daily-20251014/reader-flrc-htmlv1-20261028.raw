<th id="S3.T2.2.1.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r">FLRC</th>
<th id="S3.T2.2.1.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.9.2.1" class="ltx_text ltx_font_bold">25.46</span></th>
<td id="S3.T2.2.1.9.3" class="ltx_td ltx_align_center ltx_border_bb">38.34</td>
<td id="S3.T2.2.1.9.4" class="ltx_td ltx_align_center ltx_border_bb">20.39</td>
<td id="S3.T2.2.1.9.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.2.1.9.5.1" class="ltx_text ltx_font_bold">30.84</span></td>
<td id="S3.T2.2.1.9.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.2.1.9.6.1" class="ltx_text ltx_font_bold">19.00</span></td>
<td id="S3.T2.2.1.9.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.2.1.9.7.1" class="ltx_text ltx_font_bold">59.51</span></td>
<td id="S3.T2.2.1.9.8" class="ltx_td ltx_align_center ltx_border_bb">21.68</td>
