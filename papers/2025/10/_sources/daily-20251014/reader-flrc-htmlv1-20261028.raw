<td id="A11.T14.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t">14.72</td>
<td id="A11.T14.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">48.03</td>
