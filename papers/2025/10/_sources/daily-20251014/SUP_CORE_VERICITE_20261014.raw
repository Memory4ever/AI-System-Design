<span id="A1.SS4.p1.pic1.2.4" class="ltx_p"><span id="A1.SS4.p1.pic1.2.4.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Document<span id="A1.SS4.p1.pic1.2.4.1.1" class="ltx_text ltx_font_medium">: [1](Title: {Title}): {Passage}
</span></span></span>
<span id="A1.SS4.p1.pic1.2.5" class="ltx_p"><span id="A1.SS4.p1.pic1.2.5.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Document<span id="A1.SS4.p1.pic1.2.5.1.1" class="ltx_text ltx_font_medium">: [2](Title: {Title}): {Passage}
</span></span></span>
<span id="A1.SS4.p1.pic1.2.6" class="ltx_p"><span id="A1.SS4.p1.pic1.2.6.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">...
</span></span>
<span id="A1.SS4.p1.pic1.2.7" class="ltx_p"><span id="A1.SS4.p1.pic1.2.7.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Answer statements<span id="A1.SS4.p1.pic1.2.7.1.1" class="ltx_text ltx_font_medium">:
