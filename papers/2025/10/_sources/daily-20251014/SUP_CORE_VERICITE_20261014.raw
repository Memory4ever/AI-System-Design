<div id="A1.SS1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS1.p1.pic1" class="ltx_picture" height="262.31" overflow="visible" version="1.1" viewBox="0 0 477.38 262.31" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,262.31) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.32 L 0 256.99 C 0 259.93 2.38 262.31 5.32 262.31 L 472.06 262.31 C 474.99 262.31 477.38 259.93 477.38 256.99 L 477.38 5.32 C 477.38 2.38 474.99 0 472.06 0 L 5.32 0 C 2.38 0 0 2.38 0 5.32 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.38 5.32 L 1.38 240.6 L 475.99 240.6 L 475.99 5.32 C 475.99 3.15 474.23 1.38 472.06 1.38 L 5.32 1.38 C 3.15 1.38 1.38 3.15 1.38 5.32 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 9.26 248.34)"><foreignObject style="--ltx-fo-width:35.85em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="496.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:35.85em;">
<span id="A1.SS1.p1.pic1.1.1" class="ltx_p"><span id="A1.SS1.p1.pic1.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FFFFFF;">Prompt Template for Initial Answer Generation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 9.26 9.26)"><foreignObject style="--ltx-fo-width:35.09em;--ltx-fo-height:16.15em;--ltx-fo-depth:0em;font-size:10pt;" height="223.47" overflow="visible" transform="matrix(1 0 0 -1 0 223.47)" width="485.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
