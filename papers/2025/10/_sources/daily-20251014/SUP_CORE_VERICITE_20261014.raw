<div id="A1.SS4.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS4.p1.pic1" class="ltx_picture" height="312.12" overflow="visible" version="1.1" viewBox="0 0 477.38 312.12" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,312.12) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.32 L 0 306.8 C 0 309.74 2.38 312.12 5.32 312.12 L 472.06 312.12 C 474.99 312.12 477.38 309.74 477.38 306.8 L 477.38 5.32 C 477.38 2.38 474.99 0 472.06 0 L 5.32 0 C 2.38 0 0 2.38 0 5.32 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.38 5.32 L 1.38 290.41 L 475.99 290.41 L 475.99 5.32 C 475.99 3.15 474.23 1.38 472.06 1.38 L 5.32 1.38 C 3.15 1.38 1.38 3.15 1.38 5.32 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 9.26 298.15)"><foreignObject style="--ltx-fo-width:35.85em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="496.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
