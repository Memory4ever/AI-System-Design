<th id="S3.T1.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_t" rowspan="2"><span id="S3.T1.2.5.1.1" class="ltx_text"><span id="S3.T1.2.5.1.1.1" class="ltx_text ltx_font_italic">Evaluation metrics</span></span></th>
<th id="S3.T1.2.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Correctness</th>
