<span id="A3.T3.3.15.2.1" class="ltx_inline-block ltx_align_top" style="width:150.8pt;">
<span id="A3.T3.3.15.2.1.1" class="ltx_p"><span id="A3.T3.3.15.2.1.1.1" class="ltx_text" style="font-size:80%;">[GT: </span><em id="A3.T3.3.15.2.1.1.2" class="ltx_emph ltx_font_italic" style="font-size:80%;">&lt;sentence ends&gt;</em><span id="A3.T3.3.15.2.1.1.3" class="ltx_text" style="font-size:80%;">]</span></span>
</span></td></tr>
