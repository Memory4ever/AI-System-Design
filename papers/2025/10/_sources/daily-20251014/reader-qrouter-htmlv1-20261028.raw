</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
          <span id="alg2.l4.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l4.m1" class="ltx_Math" alttext="t=1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\dots,T</annotation></semantics></math> <span id="alg2.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            <span id="alg2.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l5.m1" class="ltx_Math" alttext="\neg\text{active}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">¬</mo><mtext>active</mtext></mrow><annotation encoding="application/x-tex">\neg\text{active}</annotation></semantics></math> <span id="alg2.l5.4" class="ltx_text ltx_font_bold">and</span> <math id="alg2.l5.m2" class="ltx_Math" alttext="p_{t}\geq\tau_{\text{high}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo>≥</mo><msub><mi>τ</mi><mtext>high</mtext></msub></mrow><annotation encoding="application/x-tex">p_{t}\geq\tau_{\text{high}}</annotation></semantics></math> <span id="alg2.l5.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
             <math id="alg2.l6.m1" class="ltx_Math" alttext="\text{start}\leftarrow t" display="inline" intent=":literal"><semantics><mrow><mtext>start</mtext><mo stretchy="false">←</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\text{start}\leftarrow t</annotation></semantics></math>; <math id="alg2.l6.m2" class="ltx_Math" alttext="\text{active}\leftarrow\text{true}" display="inline" intent=":literal"><semantics><mrow><mtext>active</mtext><mo stretchy="false">←</mo><mtext>true</mtext></mrow><annotation encoding="application/x-tex">\text{active}\leftarrow\text{true}</annotation></semantics></math>

</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            <span id="alg2.l7.3" class="ltx_text ltx_font_bold">else</span> <span id="alg2.l7.4" class="ltx_text ltx_font_bold">if</span> <span id="alg2.l7.5" class="ltx_text ltx_markedasmath">active</span> <span id="alg2.l7.6" class="ltx_text ltx_font_bold">and</span> <math id="alg2.l7.m2" class="ltx_Math" alttext="p_{t}&lt;\tau_{\text{low}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo>&lt;</mo><msub><mi>τ</mi><mtext>low</mtext></msub></mrow><annotation encoding="application/x-tex">p_{t}&lt;\tau_{\text{low}}</annotation></semantics></math> <span id="alg2.l7.7" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
             <math id="alg2.l8.m1" class="ltx_Math" alttext="\text{end}\leftarrow t-1" display="inline" intent=":literal"><semantics><mrow><mtext>end</mtext><mo stretchy="false">←</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\text{end}\leftarrow t-1</annotation></semantics></math>

</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
             <span id="alg2.l9.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l9.m1" class="ltx_Math" alttext="\text{end}-\text{start}+1\geq L_{\text{min}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>end</mtext><mo>−</mo><mtext>start</mtext></mrow><mo>+</mo><mn>1</mn></mrow><mo>≥</mo><msub><mi>L</mi><mtext>min</mtext></msub></mrow><annotation encoding="application/x-tex">\text{end}-\text{start}+1\geq L_{\text{min}}</annotation></semantics></math> <span id="alg2.l9.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
               <math id="alg2.l10.m1" class="ltx_Math" alttext="\mathcal{C}\leftarrow\mathcal{C}\cup\{[\max(1,\text{start}-P),\min(T,\text{end}+P)]\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mtext>start</mtext><mo>−</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mrow><mtext>end</mtext><mo>+</mo><mi>P</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}\leftarrow\mathcal{C}\cup\{[\max(1,\text{start}-P),\min(T,\text{end}+P)]\}</annotation></semantics></math>
   
</div>
<div id="alg2.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
             <math id="alg2.l11.m1" class="ltx_Math" alttext="\text{active}\leftarrow\text{false}" display="inline" intent=":literal"><semantics><mrow><mtext>active</mtext><mo stretchy="false">←</mo><mtext>false</mtext></mrow><annotation encoding="application/x-tex">\text{active}\leftarrow\text{false}</annotation></semantics></math>
  
</div>
<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
          <span id="alg2.l12.3" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l12.m1" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>

</div>
</div>
</figure>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p">DiversifiedSelection (Algorithm <a href="#alg3" title="Algorithm 3 ‣ Appendix B Details on Artifact Localization ‣ Q-Router: Agentic Video Quality Assessment with Expert Model Routing and Artifact Localization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) ensures that sampled frames are both representative of artifacts and diverse in content.
First, the top-<math id="A2.p3.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> frames by probability are selected to guarantee artifact coverage.
Next, farthest-point sampling in HSV space ensures visual diversity by spreading samples across color distributions.
Finally, all detected shot boundaries are added to preserve scene structure.
The union of these sets constitutes the final frame subset, balancing probability, diversity, and structural cues.</p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> DiversifiedSelection: Balancing probability, diversity, and shot boundaries</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          Probabilities <math id="alg3.l1.m1" class="ltx_Math" alttext="\mathcal{P}=\{(t,p_{t})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>p</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}=\{(t,p_{t})\}</annotation></semantics></math>;
clip set <math id="alg3.l1.m2" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>;
top-<math id="alg3.l1.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> budget <math id="alg3.l1.m4" class="ltx_Math" alttext="K_{\text{top}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mtext>top</mtext></msub><annotation encoding="application/x-tex">K_{\text{top}}</annotation></semantics></math>;
farthest-point budget <math id="alg3.l1.m5" class="ltx_Math" alttext="K_{\text{fps}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mtext>fps</mtext></msub><annotation encoding="application/x-tex">K_{\text{fps}}</annotation></semantics></math>;
shot-boundary frames <math id="alg3.l1.m6" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          Final selected frame set <math id="alg3.l2.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          <math id="alg3.l3.m1" class="ltx_Math" alttext="\mathcal{F}_{1}\leftarrow\text{TopK}(\{(t,p_{t})\},K_{\text{top}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><mo stretchy="false">←</mo><mrow><mtext>TopK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>p</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><msub><mi>K</mi><mtext>top</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{1}\leftarrow\text{TopK}(\{(t,p_{t})\},K_{\text{top}})</annotation></semantics></math> <span id="alg3.l3.3" class="ltx_text" style="float:right;"><math id="alg3.l3.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Highest-probability frames
</span>
</div>
<div id="alg3.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
          <math id="alg3.l4.m1" class="ltx_Math" alttext="\mathcal{F}_{2}\leftarrow\textsc{FarthestPointSamplingHSV}(\{t\mid(t,p_{t})\in\mathcal{P}\},K_{\text{fps}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">FarthestPointSamplingHSV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mi>t</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>p</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo><msub><mi>K</mi><mtext>fps</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{2}\leftarrow\textsc{FarthestPointSamplingHSV}(\{t\mid(t,p_{t})\in\mathcal{P}\},K_{\text{fps}})</annotation></semantics></math> <span id="alg3.l4.3" class="ltx_text" style="float:right;"><math id="alg3.l4.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Diversity in color space
</span>
</div>
<div id="alg3.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
          <math id="alg3.l5.m1" class="ltx_Math" alttext="\mathcal{F}_{3}\leftarrow\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>3</mn></msub><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}_{3}\leftarrow\mathcal{S}</annotation></semantics></math> <span id="alg3.l5.3" class="ltx_text" style="float:right;"><math id="alg3.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Mandatory shot-boundary frames
</span>
</div>
<div id="alg3.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
          <math id="alg3.l6.m1" class="ltx_Math" alttext="\mathcal{F}\leftarrow\mathcal{F}_{1}\cup\mathcal{F}_{2}\cup\mathcal{F}_{3}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>2</mn></msub><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow\mathcal{F}_{1}\cup\mathcal{F}_{2}\cup\mathcal{F}_{3}</annotation></semantics></math>

</div>
<div id="alg3.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
          <span id="alg3.l7.3" class="ltx_text ltx_font_bold">return</span> <math id="alg3.l7.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:90%;"><span class="ltx_tag ltx_tag_float"><span id="alg4.5" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Artifact Localization Pipeline</figcaption>
<div id="alg4.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <span id="alg4.l1.3" class="ltx_text" style="font-size:90%;">Video </span><math id="alg4.l1.m1" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math><span id="alg4.l1.4" class="ltx_text" style="font-size:90%;">; Probabilistic extractor </span><math id="alg4.l1.m2" class="ltx_Math" alttext="\mathsf{PE}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">𝖯𝖤</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{PE}(\cdot)</annotation></semantics></math><span id="alg4.l1.5" class="ltx_text" style="font-size:90%;"> with features and weights; VLM filter </span><math id="alg4.l1.m3" class="ltx_Math" alttext="\mathsf{VLM}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">𝖵𝖫𝖬</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{VLM}(\cdot)</annotation></semantics></math><span id="alg4.l1.6" class="ltx_text" style="font-size:90%;">; optical flow method </span><math id="alg4.l1.m4" class="ltx_Math" alttext="\mathsf{Flow}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝖥𝗅𝗈𝗐</mi><annotation encoding="application/x-tex">\mathsf{Flow}</annotation></semantics></math><span id="alg4.l1.7" class="ltx_text" style="font-size:90%;"> (Farnebäck/TV-L1); LPIPS metric </span><math id="alg4.l1.m5" class="ltx_Math" alttext="\mathsf{LPIPS}_{\text{spatial}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝖫𝖯𝖨𝖯𝖲</mi><mtext mathsize="0.900em">spatial</mtext></msub><annotation encoding="application/x-tex">\mathsf{LPIPS}_{\text{spatial}}</annotation></semantics></math><span id="alg4.l1.8" class="ltx_text" style="font-size:90%;">; thresholds </span><math id="alg4.l1.m6" class="ltx_Math" alttext="\tau_{\text{high}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">τ</mi><mtext mathsize="0.900em">high</mtext></msub><annotation encoding="application/x-tex">\tau_{\text{high}}</annotation></semantics></math><span id="alg4.l1.9" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l1.m7" class="ltx_Math" alttext="\tau_{\text{low}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">τ</mi><mtext mathsize="0.900em">low</mtext></msub><annotation encoding="application/x-tex">\tau_{\text{low}}</annotation></semantics></math><span id="alg4.l1.10" class="ltx_text" style="font-size:90%;">; clip min length </span><math id="alg4.l1.m8" class="ltx_Math" alttext="L_{\text{min}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">L</mi><mtext mathsize="0.900em">min</mtext></msub><annotation encoding="application/x-tex">L_{\text{min}}</annotation></semantics></math><span id="alg4.l1.11" class="ltx_text" style="font-size:90%;">; padding </span><math id="alg4.l1.m9" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math><span id="alg4.l1.12" class="ltx_text" style="font-size:90%;">; mean pooling mode </span><math id="alg4.l1.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="alg4.l1.13" class="ltx_text" style="font-size:90%;">;overlay opacity </span><math id="alg4.l1.m11" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="alg4.l1.14" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg4.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          <span id="alg4.l2.3" class="ltx_text" style="font-size:90%;">For each clip: representative frame-pair, heatmaps/overlays; JSON summary
