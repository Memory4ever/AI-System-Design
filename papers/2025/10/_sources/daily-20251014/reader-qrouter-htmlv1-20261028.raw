          <span id="alg4.l18.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg4.l18.m1" class="ltx_math_unparsed" alttext="W_{2}\leftarrow\textsc{Warp}(F_{2}\!\to\!F_{1};\,\mathsf{Flow})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">W</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mtext class="ltx_font_smallcaps" mathsize="0.900em">Warp</mtext><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">F</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em" rspace="0.128em" stretchy="false">→</mo><msub><mi mathsize="0.900em">F</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em" rspace="0.337em">;</mo><mi mathsize="0.900em">𝖥𝗅𝗈𝗐</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">W_{2}\leftarrow\textsc{Warp}(F_{2}\!\to\!F_{1};\,\mathsf{Flow})</annotation></semantics></math><span id="alg4.l18.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg4.l18.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg4.l18.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Align <math id="alg4.l18.m3" class="ltx_Math" alttext="F_{2}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>2</mn></msub><annotation encoding="application/x-tex">F_{2}</annotation></semantics></math> to <math id="alg4.l18.m4" class="ltx_Math" alttext="F_{1}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>1</mn></msub><annotation encoding="application/x-tex">F_{1}</annotation></semantics></math> via optical flow
</span>
</div>
<div id="alg4.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
          <span id="alg4.l19.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg4.l19.m1" class="ltx_Math" alttext="H\leftarrow\mathsf{LPIPS}_{\text{spatial}}(F_{1},W_{2})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">H</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">𝖫𝖯𝖨𝖯𝖲</mi><mtext mathsize="0.900em">spatial</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">F</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">W</mi><mn mathsize="0.900em">2</mn></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H\leftarrow\mathsf{LPIPS}_{\text{spatial}}(F_{1},W_{2})</annotation></semantics></math><span id="alg4.l19.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg4.l19.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg4.l19.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Pixel-wise LPIPS activation map
</span>
</div>
<div id="alg4.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
          <span id="alg4.l20.3" class="ltx_text" style="font-size:90%;">   </span><math id="alg4.l20.m1" class="ltx_Math" alttext="\hat{H}\leftarrow\textsc{Normalize}(H)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.900em">H</mi><mo>^</mo></mover><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">Normalize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">H</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{H}\leftarrow\textsc{Normalize}(H)</annotation></semantics></math><span id="alg4.l20.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg4.l20.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg4.l20.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg4.l20.m3" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> normalization
</span>
</div>
<div id="alg4.l21" class="ltx_listingline">
