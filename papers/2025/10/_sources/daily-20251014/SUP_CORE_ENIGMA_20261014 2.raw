<span id="S5.T2.7.1.5.1.1" class="ltx_p ltx_align_left ltx_minipage ltx_align_bottom" style="width:345.0pt;"><math id="S5.T2.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathsize="0.800em" mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S5.T2.7.1.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;"> vs. base</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.7.2" class="ltx_tr">
<td id="S5.T2.7.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">
