<span id="S5.T2.7.1.4.1.1" class="ltx_p ltx_align_left ltx_minipage ltx_align_bottom" style="width:345.0pt;"><span id="S5.T2.7.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">TruthfulQA BLEU-acc</span></span>
