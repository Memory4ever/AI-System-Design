<td id="A4.T4.6.1.5.2" class="ltx_td ltx_align_right" style="padding:1pt 6.5pt;"><span id="A4.T4.6.1.5.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">$ 0.00021180</span></td>
<td id="A4.T4.6.1.5.3" class="ltx_td ltx_align_right" style="padding:1pt 6.5pt;"><span id="A4.T4.6.1.5.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">$ 0.00016905</span></td>
<td id="A4.T4.6.1.5.4" class="ltx_td ltx_align_right" style="padding:1pt 6.5pt;"><span id="A4.T4.6.1.5.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">$ 0.00020430</span></td></tr>
