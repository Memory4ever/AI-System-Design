ss="ltx_text ltx_lst_identifier ltx_font_typewriter">g</span><span id="lstnumberx2.25" class="ltx_text ltx_font_typewriter">.,</span><span id="lstnumberx2.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.27" class="ltx_text ltx_font_typewriter">[:</span><span id="lstnumberx2.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">symbol</span><span id="lstnumberx2.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">running</span><span id="lstnumberx2.31" class="ltx_text ltx_font_typewriter">:]</span><span id="lstnumberx2.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">matches</span><span id="lstnumberx2.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.35" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I</span><span id="lstnumberx2.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">am</span><span id="lstnumberx2.39" class="ltx_text ltx_font_typewriter">&lt;&lt;</span><span id="lstnumberx2.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">running</span><span id="lstnumberx2.42" class="ltx_text ltx_font_typewriter">&gt;&gt;"</span><span id="lstnumberx2.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx2.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.46" class="ltx_text ltx_font_typewriter">"&lt;&lt;</span><span id="lstnumberx2.47" class="ltx_text ltx_lst_space ltx_font_typewriter"> </