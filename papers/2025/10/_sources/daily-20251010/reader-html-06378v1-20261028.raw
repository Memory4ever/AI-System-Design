<td id="A4.T4.6.1.4.4" class="ltx_td ltx_align_right" style="padding:1pt 6.5pt;"><math id="A4.T4.m11" class="ltx_Math" alttext="33\pm 12" display="inline" intent=":literal"><semantics><mrow><mn>33</mn><mo>±</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">33\pm 12</annotation></semantics></math></td></tr>
