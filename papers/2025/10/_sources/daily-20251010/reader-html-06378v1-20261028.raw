<div id="lstnumberx4" class="ltx_listingline"><span id="lstnumberx4.1" class="ltx_text ltx_font_typewriter">*</span><span id="lstnumberx4.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.3" class="ltx_text ltx_font_typewriter">[:</span><span id="lstnumberx4.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">field</span><span id="lstnumberx4.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx4.7" class="ltx_text ltx_font_typewriter">:]</span><span id="lstnumberx4.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.9" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx4.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">matches</span><span id="lstnumberx4.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx4.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">phrase</span><span id="lstnumberx4.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx4.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx4.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">its</span><span id="lstnumberx4.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">semantic</span><span id="lstnumberx4.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">variants</span><span id="lstnumberx4.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.27" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx4.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">e</span><span id="lstnumberx4.29" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx4.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">g</span><span id="lstnumberx4.31" class="ltx_text ltx_font_typewriter">.,</span><span id="lstnumberx4.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.33" class="ltx_text ltx_font_typewriter">[:</span><span id="lstnumberx4.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">field</span><span id="lstnumberx4.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">run</span><span id="lstnumberx4.37" class="ltx_text ltx_font_typewriter">:]</span><span id="lstnumberx4.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">matches</span><span id="lstnumberx4.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.41" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx4.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">out</span><span id="lstnumberx4.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx4.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx4.47" class="ltx_text ltx_lst