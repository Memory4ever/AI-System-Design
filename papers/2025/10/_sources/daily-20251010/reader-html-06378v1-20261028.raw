<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_font_typewriter">*</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.3" class="ltx_text ltx_font_typewriter">[:</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">lexeme</span><span id="lstnumberx3.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx3.7" class="ltx_text ltx_font_typewriter">:]</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.9" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx3.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">matches</span><span id="lstnumberx3.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx3.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">phrase</span><span id="lstnumberx3.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx3.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx3.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">its</span><span id="lstnumberx3.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">syntactic</span><span id="lstnumberx3.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">variants</span><span id="lstnumberx3.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.27" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx3.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">e</span><span id="lstnumberx3.29" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx3.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">g</span><span id="lstnumberx3.31" class="ltx_text ltx_font_typewriter">.,</span><span id="lstnumberx3.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.33" class="ltx_text ltx_font_typewriter">[:</span><span id="lstnumberx3.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">lexeme</span><span id="lstnumberx3.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">run</span><span id="lstnumberx3.37" class="ltx_text ltx_font_typewriter">:]</span><span id="lstnumberx3.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">matches</span><span id="lstnumberx3.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.41" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx3.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">she</span><span id="lstnumberx3.43" class="ltx_text ltx_font_typewriter">&lt;&lt;</span><span id="lstnumberx3.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ran</span><span id="lstnumberx3.46" class="ltx_text ltx_font_typewriter">&gt;&gt;",</span><span id="lstnumberx3.47" class="ltx_text ltx_lst_space ltx_fon