<span id="S5.T1.4.1.7.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.7pt;padding-right:4.7pt;">Kill Chain</span></span>
</span></span><span id="S5.T1.4.1.7.2.2" class="ltx_text"></span></span></td></tr>
<tr id="S5.T1.4.2" class="ltx_tr">
<td id="S5.T1.4.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.7pt;padding-right:4.7pt;">Attacking via Pop-ups <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib71" title="" class="ltx_ref">Zhang et al., 2025c</a>)</cite></td>
<td id="S5.T1.4.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.7pt;padding-right:4.7pt;"><math id="S5.T1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S5.T1.4.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.7pt;padding-right:4.7pt;"><math id="S5.T1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S5.T1.4.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.7pt;padding-right:4.7pt;"><span id="S5.T1.4.2.4.1" class="ltx_text" style="--ltx-fg-color:#005000;">✓</span></td>
