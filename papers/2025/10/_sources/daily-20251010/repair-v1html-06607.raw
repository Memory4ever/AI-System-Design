<td id="A8.T7.4.16.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;"><span id="A8.T7.4.16.1.1" class="ltx_text">Cursor IDE</span></td>
<td id="A8.T7.4.16.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">Claude Sonnet 4</td>
<td id="A8.T7.4.16.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">97.41%</td>
<td id="A8.T7.4.16.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">94.60%</td>
<td id="A8.T7.4.16.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">50.00%</td>
<td id="A8.T7.4.16.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">33.33%</td>
<td id="A8.T7.4.16.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">0.00%</td>
<td id="A8.T7.4.16.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;">100.00%</td></tr>
<tr id="A8.T7.4.17" class="ltx_tr">
<td id="A8.T7.4.17.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.9pt;padding-right:1.9pt;"><span id="A8.T7.4.17.1.1" class="ltx_text">Cursor CLI</span></td>
<td id="A8.T7.4.17.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F2F9FF;padding-left:1.9pt;padding-right:1.9pt;"><span id="A8.T7.4.17.2.1" class="ltx_text" style="--ltx-bg-color:#F2F9FF;">Claude Opus 4.1</span></td>
<td id="A8.T7.4.17.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F2F9FF;padding-left:1.9pt;padding-right:1.9pt;"><span id="A8.T7.4.17.3.1" class="ltx_text" style="--ltx-bg-color:#F2F9FF;">71.87%</span></td>
