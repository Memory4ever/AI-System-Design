<td id="A8.T7.4.17.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F2F9FF;padding-left:1.9pt;padding-right:1.9pt;"><span id="A8.T7.4.17.5.1" class="ltx_text" style="--ltx-bg-color:#F2F9FF;">54.55%</span></td>
<td id="A8.T7.4.17.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#F2F9FF;padding-left:1.9pt;padding-right:1.9pt;"><span id="A8.T7.4.17.6.1" class="ltx_text" style="--ltx-bg-color:#F2F9FF;">50.00%</span></td>
