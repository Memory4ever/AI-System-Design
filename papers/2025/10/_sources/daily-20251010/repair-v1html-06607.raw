</span></span><span id="S5.T1.4.1.2.2.2" class="ltx_text"></span></span></td>
<td id="S5.T1.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.7pt;padding-right:4.7pt;"><span id="S5.T1.4.1.3.1" class="ltx_text"></span><span id="S5.T1.4.1.3.2" class="ltx_text ltx_font_bold"> <span id="S5.T1.4.1.3.2.1" class="ltx_text">
