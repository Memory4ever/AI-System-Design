<td id="A3.T5.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A3.T5.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math></td>
<td id="A3.T5.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="A3.T5.m8" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math></td>
<td id="A3.T5.4.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="A3.T5.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></td></tr>
