<tr id="A1.T6.2.2" class="ltx_tr">
<td id="A1.T6.2.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A1.T6.2.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:68.3pt;">
