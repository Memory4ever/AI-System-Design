</span></th>
<th id="S3.T2.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S3.T2.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:398.3pt;">
<span id="S3.T2.2.1.2.1.1" class="ltx_p"><span id="S3.T2.2.1.2.1.1.1" class="ltx_text ltx_font_bold">Response</span></span>
</span></th></tr>
