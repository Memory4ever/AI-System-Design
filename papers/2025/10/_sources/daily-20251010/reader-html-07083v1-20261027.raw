<td id="S4.T4.2.9.1" class="ltx_td ltx_align_left ltx_border_b"><span id="S4.T4.2.9.1.1" class="ltx_text ltx_font_smallcaps">Vital<math id="S4.T4.m4" class="ltx_Math" alttext="{}_{\textsc{Rec.}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_font_smallcaps">Rec.</mtext></msub><annotation encoding="application/x-tex">{}_{\textsc{Rec.}}</annotation></semantics></math></span></td>
<td id="S4.T4.2.9.2" class="ltx_td ltx_align_center ltx_border_b">52.44</td>
