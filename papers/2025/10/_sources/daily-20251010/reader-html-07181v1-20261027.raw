</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S0.F1.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.07181v1/teasor_v2_2.png" id="S0.F1.sf2.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/828;" width="476" height="828" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S0.F1.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S0.F1.sf2.4" class="ltx_text" style="font-size:90%;">Unified reasoning across viewpoints</span></figcaption>
