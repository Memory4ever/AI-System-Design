<span class="ltx_bibblock"><a href="https://huggingface.co/datasets/Spony/harmbench-dataset" title="" class="ltx_ref ltx_url ltx_font_typewriter" style="font-size:90%;">https://huggingface.co/datasets/Spony/harmbench-dataset</a><span id="bib.bib51.8" class="ltx_text" style="font-size:90%;">, 2024.
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib51.9" class="ltx_text" style="font-size:90%;">Hugging Face dataset.
</span>
</span></li>
      
<li id="bib.bib52" class="ltx_bibitem"><span class="ltx_tag ltx_role_refnum ltx_tag_bibitem"><span id="bib.bib52.4" class="ltx_text" style="font-size:90%;">[52]</span></span>
<span class="ltx_bibblock"><span id="bib.bib52.6" class="ltx_text" style="font-size:90%;">
Baidicoot.
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib52.7" class="ltx_text" style="font-size:90%;">augmented_advbench_v4 dataset.
</span>
</span>
<span class="ltx_bibblock"><a href="https://huggingface.co/datasets/Baidicoot/augmented_advbench_v4" title="" class="ltx_ref ltx_url ltx_font_typewriter" style="font-size:90%;">https://huggingface.co/datasets/Baidicoot/augmented_advbench_v4</a><span id="bib.bib52.8" class="ltx_text" style="font-size:90%;">, 2024.
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib52.9" class="ltx_text" style="font-size:90%;">Hugging Face dataset.
</span>
</span></li>
      
<li id="bib.bib53" class="ltx_bibitem"><span class="ltx_tag ltx_role_refnum ltx_tag_bibitem"><span id="bib.bib53.5" class="ltx_text" style="font-size:90%;">[53]</span></span>
<span class="ltx_bibblock"><span id="bib.bib53.7" class="ltx_text" style="font-size:90%;">
Yaoming Zhu, Sidi Lu, Lei Zheng, Jiaxian Guo, Weinan Zhang, Jun Wang, and Yong Yu.
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib53.8" class="ltx_text" style="font-size:90%;">Texygen: A benchmarking platform for text generation models.
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib53.9" class="ltx_text" style="font-size:90%;">In </span><em id="bib.bib53.10" class="ltx_emph ltx_font_italic" style="font-size:90%;">The 41st international ACM SIGIR conference on research &amp; development in information retrieval</em><span id="bib.bib53.11" class="ltx_text" style="font-size:90%;">, pages 1097–1100, 2018.
</span>
</span></li>
    
</ul>
