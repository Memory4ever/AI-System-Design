</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.4. </span>Resistance to Potential Adaptive Attacks</h3>

<figure id="S5.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 4. </span>The fingerprint similarities between the original instruct LLM and its attacked version using <span id="S5.T4.3" class="ltx_text ltx_font_smallcaps">ZeroPrint</span>.</figcaption>
<div id="S5.T4.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:262.1pt;height:42.2pt;vertical-align:-19.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-23.1pt,3.7pt) scale(0.8,0.8) ;">
<table id="S5.T4.4.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T4.4.1.1" class="ltx_tr">
<td id="S5.T4.4.1.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding:0.75pt 7.1pt;"><span id="S5.T4.4.1.1.1.1" class="ltx_text ltx_font_bold">Attack</span></td>
<td id="S5.T4.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.75pt 7.1pt;" colspan="3"><span id="S5.T4.4.1.1.2.1" class="ltx_text ltx_font_bold">Input Paraphrasing</span></td>
<td id="S5.T4.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.75pt 7.1pt;" colspan="3"><span id="S5.T4.4.1.1.3.1" class="ltx_text ltx_font_bold">Output Perturbation</span></td></tr>
<tr id="S5.T4.4.1.2" class="ltx_tr">
<td id="S5.T4.4.1.2.1" class="ltx_td ltx_align_left" style="padding:0.75pt 7.1pt;"><span id="S5.T4.4.1.2.1.1" class="ltx_text ltx_font_bold">Setting</span></td>
<td id="S5.T4.4.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.5B</td>
<td id="S5.T4.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">1B</td>
<td id="S5.T4.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">2B</td>
<td id="S5.T4.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.05</td>
<td id="S5.T4.4.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.10</td>
<td id="S5.T4.4.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.15</td></tr>
<tr id="S5.T4.4.1.3" class="ltx_tr">
<td id="S5.T4.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 7.1pt;"><span id="S5.T4.4.1.3.1.1" class="ltx_text ltx_font_bold">Qwen2.5-7B</span></td>
<td id="S5.T4.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.878</td>
<td id="S5.T4.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.876</td>
<td id="S5.T4.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.881</td>
<td id="S5.T4.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.865</td>
<td id="S5.T4.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.894</td>
<td id="S5.T4.4.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 7.1pt;">0.868</td></tr>
<tr id="S5.T4.4.1.4" class="ltx_tr">
<td id="S5.T4.4.1.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.75pt 7.1pt;"><span id="S5.T4.4.1.4.1.1" class="ltx_text ltx_font_bold">Llama3.1-8B</span></td>
