<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E9Xc.m2" class="ltx_Math" alttext="\displaystyle\approx\rho||\underbrace{\triangledown_{\theta_{Q}^{*}}\mathcal{L}_{R}(X^{(V)})-\triangledown_{\theta_{Q}}\mathcal{L}_{R}(X^{(V)})}_{\parbox{65.5503pt}{\footnotesize\raggedright First-order Taylor\@add@raggedright}}+\triangledown_{\theta_{Q}}\mathcal{L}_{R}(X^{(V)})||" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">≈</mo><mrow><mi mathsize="0.900em">ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">‖</mo><mrow><munder><munder accentunder="true"><mrow><mrow><msub><mi mathsize="0.900em" mathvariant="normal">▽</mi><msubsup><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">Q</mi><mo mathsize="0.900em">∗</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mi mathsize="0.900em">R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">V</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><msub><mi mathsize="0.900em" mathvariant="normal">▽</mi><msub><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">Q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mi mathsize="0.900em">R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">X</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">V</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mpadded style="widt