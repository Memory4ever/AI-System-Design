               <math id="alg1.l15.m1" class="ltx_Math" alttext="\mathcal{G}=\mathcal{G}-\gamma\partial\frac{\mathcal{L}_{FINAL}}{\mathcal{G}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><mfrac><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒢</mi></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=\mathcal{G}-\gamma\partial\frac{\mathcal{L}_{FINAL}}{\mathcal{G}}</annotation></semantics></math>

</div>
