</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
             Warm up <math id="alg1.l10.m1" class="ltx_Math" alttext="\theta_{Q}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\theta_{Q}</annotation></semantics></math>, <math id="alg1.l10.m2" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>, <math id="alg1.l10.m3" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> with BN loss (<a href="#S3.E20" title="Equation 20 ‣ 3.5 Final algorithm ‣ 3 Method ‣ Sharpness-Aware Data Generation for Zero-shot Quantization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>) for <math id="alg1.l10.m4" class="ltx_Math" alttext="N_{w}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>w</mi></msub><annotation encoding="application/x-tex">N_{w}</annotation></semantics></math> iterations.

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
             <span id="alg1.l11.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math> to <math id="alg1.l11.m2" class="ltx_Math" alttext="N_{g}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>g</mi></msub><annotation encoding="application/x-tex">N_{g}</annotation></semantics></math> <span id="alg1.l11.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="alg1.l12.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
               <math id="alg1.l13.m1" class="ltx_Math" alttext="\epsilon^{(\mathcal{N})}_{i}=\nu\frac{\triangledown_{\mathbf{z}_{i}}\mathcal{D}(\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})),\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})))}{\left\lVert\triangledown_{\mathbf{z}_{i}}\mathcal{D}(\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})),\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})))\right\rVert}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ϵ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi mathvariant="normal">▽</mi><msub><mi>𝐳</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">▽</mi><msub><mi>θ</mi><mi>Q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">▽</mi><msub><mi>θ</mi><mi>Q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mo>‖</mo><mrow><msub><mi mathvariant="normal">▽</mi><msub><mi>𝐳</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">▽</mi><msub><mi>θ</mi><mi>Q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">▽</mi><msub><mi>θ</mi><mi>Q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\epsilon^{(\mathcal{N})}_{i}=\nu\frac{\triangledown_{\mathbf{z}_{i}}\mathcal{D}(\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})),\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})))}{\left\lVert\triangledown_{\mathbf{z}_{i}}\mathcal{D}(\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})),\triangledown_{\theta_{Q}}\mathcal{L}_{R}(\mathcal{G}(\mathbf{z}_{i})))\right\rVert}</annotation></semantics></math> 
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
               <math id="alg1.l14.m1" class="ltx_Math" alttext="\mathbf{z}_{i}=\mathbf{z}_{i}-\gamma\partial\frac{\mathcal{L}_{FINAL}}{\mathbf{z}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>𝐳</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><mfrac><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><msub><mi>𝐳</mi><mi>i</mi></msub></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{i}=\mathbf{z}_{i}-\gamma\partial\frac{\mathcal{L}_{FINAL}}{\mathbf{z}_{i}}</annotation></semantics></math>

