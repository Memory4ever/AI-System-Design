             Initialize <math id="alg1.l8.m1" class="ltx_Math" alttext="\theta_{Q}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\theta_{Q}</annotation></semantics></math> from <math id="alg1.l8.m2" class="ltx_Math" alttext="\theta_{FP}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow></msub><annotation encoding="application/x-tex">\theta_{FP}</annotation></semantics></math>.

