<th id="S4.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">128</th>
<th id="S4.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">256</th>
