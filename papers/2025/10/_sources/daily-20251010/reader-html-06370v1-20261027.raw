<th id="S4.T1.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="2"><span id="S4.T1.2.5.1.1" class="ltx_text ltx_font_bold">Total pairwise preference evaluations</span></th>
<th id="S4.T1.2.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="2"><span id="S4.T1.2.5.2.1" class="ltx_text ltx_font_bold">165,888</span></th></tr>
