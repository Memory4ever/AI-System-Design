<td id="S4.T5.2.11.6" class="ltx_td ltx_align_center"><span id="S4.T5.2.11.6.1" class="ltx_text ltx_font_bold">79.45</span></td></tr>
<tr id="S4.T5.2.12" class="ltx_tr">
<td id="S4.T5.2.12.1" class="ltx_td ltx_align_left">SFT+RL</td>
