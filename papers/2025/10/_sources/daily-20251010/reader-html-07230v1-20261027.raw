<td id="S4.T5.2.12.3" class="ltx_td ltx_align_center">37.80</td>
<td id="S4.T5.2.12.4" class="ltx_td ltx_align_center">66.67</td>
<td id="S4.T5.2.12.5" class="ltx_td ltx_align_center">59.42</td>
<td id="S4.T5.2.12.6" class="ltx_td ltx_align_center">59.73</td></tr>
<tr id="S4.T5.2.13" class="ltx_tr">
<td id="S4.T5.2.13.1" class="ltx_td ltx_align_left ltx_border_bb">SFT+RL</td>
<td id="S4.T5.2.13.2" class="ltx_td ltx_align_left ltx_border_bb">w/o rationale</td>
