<td id="S4.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_tt">Percentage</td></tr>
<tr id="S4.T2.2.2" class="ltx_tr">
<td id="S4.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Click</td>
<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t">5,051</td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t">86.3%</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
