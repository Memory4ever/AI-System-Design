<td id="S4.T3.2.12.1" class="ltx_td ltx_align_left">cart_side_bar</td>
<td id="S4.T3.2.12.2" class="ltx_td ltx_align_center">145</td>
<td id="S4.T3.2.12.3" class="ltx_td ltx_align_center">2.9%</td></tr>
<tr id="S4.T3.2.13" class="ltx_tr">
<td id="S4.T3.2.13.1" class="ltx_td ltx_align_left">cart_page_select</td>
<td id="S4.T3.2.13.2" class="ltx_td ltx_align_center">139</td>
<td id="S4.T3.2.13.3" class="ltx_td ltx_align_center">2.8%</td></tr>
