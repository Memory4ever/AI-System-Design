<tbody class="ltx_tbody">
<tr id="S4.T2.3.1.3" class="ltx_tr">
<th id="S4.T2.3.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding:-0.85pt 3.0pt;" rowspan="7"><span id="S4.T2.3.1.3.1.1" class="ltx_text" style="font-size:80%;">
<span id="S4.T2.3.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:5.5pt;height:29.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:29.4pt;transform:translate(-12.0pt,-12.0pt) rotate(-90deg) ;">
<span id="S4.T2.3.1.3.1.1.1.1" class="ltx_p">ETTm1</span>
</span></span></span></th>
