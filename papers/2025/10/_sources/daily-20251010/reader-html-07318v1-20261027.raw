<td class="ltx_td ltx_align_center"><span class="ltx_text" style="font-size:70%;">25.40</span></td>
<td class="ltx_td ltx_align_center"><span class="ltx_text" style="font-size:70%;">28.00</span></td>
<td class="ltx_td ltx_align_center"><span class="ltx_text" style="font-size:70%;">27.80</span></td>
