<td class="ltx_td ltx_align_center ltx_border_tt">AHN-GDN</td>
</tr>
<tr class="ltx_tr">
<td class="ltx_td ltx_align_center ltx_border_t" rowspan="12">
<div class="ltx_inline-block ltx_transformed_outer" style="width:18.8pt;height:56.2pt;vertical-align:-18.7pt;"><span class="ltx_transformed_inner" style="width:56.3pt;transform:translate(-18.7pt,-18.7pt) rotate(-90deg) ;">
<span class="ltx_inline-block ltx_align_center">
<span class="ltx_p">Qwen2.5-3B-</span>
<span class="ltx_p">Instruct</span>
</span>
</span></div>
</td>
<td class="ltx_td ltx_align_left ltx_border_t"><span class="ltx_text ltx_font_bold">Average</span></td>
<td class="ltx_td ltx_align_center ltx_border_t">4.41</td>
<td class="ltx_td ltx_align_center ltx_border_t">4.59</td>
<td class="ltx_td ltx_align_center ltx_border_t">4.12</td>
