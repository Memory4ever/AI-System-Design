<span id="A7.F11.pic1.2.42" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.42.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.42.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
