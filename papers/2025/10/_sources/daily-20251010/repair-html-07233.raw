<span id="A7.F11.pic1.p43.1" class="ltx_p">{json.dumps(working_memory, indent=2)}</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.44" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.44.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.44.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:455.5pt;"></span></span></span>
<span id="A7.F11.pic1.2.45" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.45.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.45.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:455.5pt;"></span></span></span>
<span id="A7.F11.pic1.2.46" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.46.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.46.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p46" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p46.1" class="ltx_p">Return a JSON object with the following fields:</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.47" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.47.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.47.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p47" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p47.1" class="ltx_p">- "updated_memory": updated version of the working memory</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.48" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.48.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.48.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p48" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p48.1" class="ltx_p">- "cross_page_relationships": a list of new relationships across pages in the format:</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.49" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.49.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.49.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p49" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p49.1" class="ltx_p">  {{</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.50" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.50.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.50.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p50" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p50.1" class="ltx_p">    "from_object": "object_id_of_child_or_reference",</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.51" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.51.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.51.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p51" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p51.1" class="ltx_p">    "to_object": "object_id_of_parent_or_target",</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.52" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.52.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.52.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
<span id="A7.F11.pic1.p52" class="ltx_para ltx_noindent">
<span id="A7.F11.pic1.p52.1" class="ltx_p">    "type": "relationship_type"</span>
</span></span></span></span>
<span id="A7.F11.pic1.2.53" class="ltx_p" style="width:455.5pt;"><span id="A7.F11.pic1.2.53.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:455.5pt;--ltx-fg-color:#000000;"><span id="A7.F11.pic1.2.53.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:455.5pt;">
