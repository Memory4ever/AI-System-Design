              <span id="lstnumberx88.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx88.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">WHERE</span><span id="lstnumberx88.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.5" class="ltx_text ltx_font_typewriter">[<span id="lstnumberx88.5.1" class="ltx_text" style="text-decoration:line-through;text-decoration-color:#000000;;"><math id="lstnumberx88.m1" class="ltx_Math" alttext="\square_{1}\mapsto" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">□</mi><mn>1</mn></msub><mo stretchy="false">↦</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\square_{1}\mapsto</annotation></semantics></math></span><span id="lstnumberx88.5.2" class="ltx_text" style="--ltx-fg-color:#000080;text-decoration:line-through;text-decoration-color:#000000;;">t0:INT</span>]</span><span id="lstnumberx88.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000080;">(WITH seq(i) AS (VALUES (1)) SELECT sum(i) * t0.c0 FROM seq)</span><span id="lstnumberx88.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.9" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">IS</span><span id="lstnumberx88.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.11" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">NOT</span><span id="lstnumberx88.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.13" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">NULL</span>
