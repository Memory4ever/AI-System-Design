            <span id="lstnumberx9.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">SELECT</span><span id="lstnumberx9.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.4" class="ltx_text ltx_font_typewriter">*</span><span id="lstnumberx9.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.6" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">FROM</span><span id="lstnumberx9.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">t1</span><span id="lstnumberx9.9" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx9.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx9.11" class="ltx_text ltx_font_typewriter">[<math id="lstnumberx9.m1" class="ltx_Math" alttext="\square_{1}\mapsto" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">□</mi><mn>1</mn></msub><mo stretchy="false">↦</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\square_{1}\mapsto</annotation></semantics></math><span id="lstnumberx9.11.1" class="ltx_text" style="--ltx-fg-color:#000080;">TABLE</span>]</span><span id="lstnumberx9.12" class="ltx_text ltx_font_typewriter">;</span><span id="lstnumberx9.13" class="ltx_text ltx_lst_space ltx_font_typewriter">            </span><span id="lstnumberx9.14" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="--ltx-fg-color:#808080;">--<span id="lstnumberx9.14.1" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx9.14.2" class="ltx_text"><math id="lstnumberx9.m2" class="ltx_Math" alttext="Q_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#808080;" mathcolor="#808080">Q</mi><mn style="--ltx-fg-color:#808080;" mathcolor="#808080">1</mn></msub><annotation encoding="application/x-tex">Q_{1}</annotation></semantics></math></span></span>
