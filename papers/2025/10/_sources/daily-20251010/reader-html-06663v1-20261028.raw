<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Omitted Algorithm</h2>

<figure id="algorithm3" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span><math id="algorithm3.m2" class="ltx_Math" alttext="\mathsf{GuidedCAQPairsSampling}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝖦𝗎𝗂𝖽𝖾𝖽𝖢𝖠𝖰𝖯𝖺𝗂𝗋𝗌𝖲𝖺𝗆𝗉𝗅𝗂𝗇𝗀</mi><annotation encoding="application/x-tex">\mathsf{GuidedCAQPairsSampling}</annotation></semantics></math></figcaption>
<div id="algorithm3.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm3.4.1" class="ltx_listingline"><span id="algorithm3.4.1.1" class="ltx_text" style="font-size:90%;"><span id="algorithm3.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span><span id="algorithm3.4.1.2" class="ltx_text" style="font-size:90%;">
A DBMS <math id="algorithm3.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>, a set of equivalent CAQs <math id="algorithm3.m4" class="ltx_Math" alttext="\mathsf{Equal}" display="inline" intent=":literal"><semantics><mi>𝖤𝗊𝗎𝖺𝗅</mi><annotation encoding="application/x-tex">\mathsf{Equal}</annotation></semantics></math>, a number of maximal number of samples to return <math id="algorithm3.m5" class="ltx_Math" alttext="\mathsf{MaxSamples}" display="inline" intent=":literal"><semantics><mi>𝖬𝖺𝗑𝖲𝖺𝗆𝗉𝗅𝖾𝗌</mi><annotation encoding="application/x-tex">\mathsf{MaxSamples}</annotation></semantics></math>, a number of maximal iterations for clustering <math id="algorithm3.m6" class="ltx_Math" alttext="\mathsf{MaxIters}" display="inline" intent=":literal"><semantics><mi>𝖬𝖺𝗑𝖨𝗍𝖾𝗋𝗌</mi><annotation encoding="application/x-tex">\mathsf{MaxIters}</annotation></semantics></math>.
</span>
</div>
<div id="algorithm3.4.2" class="ltx_listingline"><span id="algorithm3.4.2.1" class="ltx_text" style="font-size:90%;"><span id="algorithm3.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span><span id="algorithm3.4.2.2" class="ltx_text" style="font-size:90%;">A sampled set of equivalent CAQ pairs </span><math id="algorithm3.m7" class="ltx_Math" alttext="\mathsf{Sam}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝖲𝖺𝗆</mi><annotation encoding="application/x-tex">\mathsf{Sam}</annotation></semantics></math><span id="algorithm3.4.2.3" class="ltx_text" style="font-size:90%;">.</span>
</div>
<div id="algorithm3.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></span>
          <span id="algorithm3.4.3.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Function</span><span id="algorithm3.4.3.3" class="ltx_text" style="font-size:90%;"> </span><em id="algorithm3.4.3.4" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="algorithm3.m8" class="ltx_Math" alttext="\mathsf{Distance}" display="inline" intent=":literal"><semantics><mi>𝖣𝗂𝗌𝗍𝖺𝗇𝖼𝖾</mi><annotation encoding="application/x-tex">\mathsf{Distance}</annotation></semantics></math><span id="algorithm3.4.3.4.1" class="ltx_text ltx_font_typewriter ltx_font_upright">(<em id="algorithm3.4.3.4.1.1" class="ltx_emph ltx_font_serif ltx_font_italic"><math id="algorithm3.m9" class="ltx_Math" alttext="\mathcal{D},\mathsf{caq},\mathsf{cluster}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>𝖼𝖺𝗊</mi><mo>,</mo><mi>𝖼𝗅𝗎𝗌𝗍𝖾𝗋</mi></mrow><annotation encoding="application/x-tex">\mathcal{D},\mathsf{caq},\mathsf{cluster}</annotation></semantics></math></em>)</span></em><span id="algorithm3.4.3.5" class="ltx_text ltx_font_bold" style="font-size:90%;">:</span>
</div>
<div id="algorithm3.4.4" class="ltx_listingline"><span id="algorithm3.4.4.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm3.4.4.2" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.4.3" class="ltx_text ltx_font_bold" style="font-size:90%;">2</span></span>
          <math id="algorithm3.m10" class="ltx_Math" alttext="\mathsf{MinDistance}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">𝖬𝗂𝗇𝖣𝗂𝗌𝗍𝖺𝗇𝖼𝖾</mi><annotation encoding="application/x-tex">\mathsf{MinDistance}</annotation></semantics></math><span id="algorithm3.4.4.4" class="ltx_text" style="font-size:90%;"> </span><math id="algorithm3.m11" class="ltx_Math" alttext="\leftarrow+\infty" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mo mathsize="0.900em">+</mo><mi mathsize="0.900em" mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\leftarrow+\infty</annotation></semantics></math><span id="algorithm3.4.4.5" class="ltx_text" style="font-size:90%;">;</span>
</div>
<div id="algorithm3.4.5" class="ltx_listingline"><span id="algorithm3.4.5.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm3.4.5.2" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.5.3" class="ltx_text ltx_font_bold" style="font-size:90%;">3</span></span>
          <span id="algorithm3.4.5.4" class="ltx_text ltx_font_bold" style="font-size:90%;">foreach</span><span id="algorithm3.4.5.5" class="ltx_text" style="font-size:90%;"> </span><em id="algorithm3.4.5.6" class="ltx_emph ltx_font_italic" style="font-size:90%;"><math id="algorithm3.m12" class="ltx_Math" alttext="\mathsf{q}\in\mathsf{cluster}" display="inline" intent=":literal"><semantics><mrow><mi>𝗊</mi><mo>∈</mo><mi>𝖼𝗅𝗎𝗌𝗍𝖾𝗋</mi></mrow><annotation encoding="application/x-tex">\mathsf{q}\in\mathsf{cluster}</annotation></semantics></math></em><span id="algorithm3.4.5.7" class="ltx_text" style="font-size:90%;"> </span><span id="algorithm3.4.5.8" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span>
</div>
<div id="algorithm3.4.6" class="ltx_listingline"><span id="algorithm3.4.6.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm3.4.6.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm3.4.6.3" class="ltx_text" style="font-size:90%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.6.4" class="ltx_text ltx_font_bold" style="font-size:90%;">4</span></span>
          <math id="algorithm3.m13" class="ltx_Math" alttext="\mathsf{plan}_{1}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝗉𝗅𝖺𝗇</mi><mn mathsize="0.900em">1</mn></msub><annotation encoding="application/x-tex">\mathsf{plan}_{1}</annotation></semantics></math><span id="algorithm3.4.6.5" class="ltx_text" style="font-size:90%;"> </span><math id="algorithm3.m14" class="ltx_Math" alttext="\leftarrow\mathcal{D}.\mathsf{Explain}(\mathsf{caq})" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo mathsize="0.900em" stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi></mrow><mo lspace="0em" mathsize="0.900em" rspace="0.167em">.</mo><mrow><mi mathsize="0.900em">𝖤𝗑𝗉𝗅𝖺𝗂𝗇</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝖼𝖺𝗊</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\leftarrow\mathcal{D}.\mathsf{Explain}(\mathsf{caq})</annotation></semantics></math><span id="algorithm3.4.6.6" class="ltx_text" style="font-size:90%;">;</span>
</div>
