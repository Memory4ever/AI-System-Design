          <math id="algorithm1.m32" class="ltx_Math" alttext="q\leftarrow\mathsf{GenerateCAQ}(\mathcal{G},\mathcal{D},s)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">q</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">𝖦𝖾𝗇𝖾𝗋𝖺𝗍𝖾𝖢𝖠𝖰</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒢</mi><mo mathsize="0.900em">,</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">s</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q\leftarrow\mathsf{GenerateCAQ}(\mathcal{G},\mathcal{D},s)</annotation></semantics></math><span id="algorithm1.4.22.4" class="ltx_text" style="font-size:90%;"> ;  </span><span id="algorithm1.4.22.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">// </span><a href="#S5.SS1" title="5.1. Database Seeding ‣ 5. Test Oracle Discovery ‣ Automated Discovery of Test Oracles for Database Management Systems Using LLMs" class="ltx_ref ltx_font_typewriter" style="font-size:90%;"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>
</div>
