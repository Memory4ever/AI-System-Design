          <math id="algorithm3.m36" class="ltx_Math" alttext="\mathsf{caq}\leftarrow\mathsf{RandomSample}(\mathsf{cluster},1)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">𝖼𝖺𝗊</mi><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">𝖱𝖺𝗇𝖽𝗈𝗆𝖲𝖺𝗆𝗉𝗅𝖾</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝖼𝗅𝗎𝗌𝗍𝖾𝗋</mi><mo mathsize="0.900em">,</mo><mn mathsize="0.900em">1</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{caq}\leftarrow\mathsf{RandomSample}(\mathsf{cluster},1)</annotation></semantics></math><span id="algorithm3.4.26.4" class="ltx_text" style="font-size:90%;">;</span>
</div>
