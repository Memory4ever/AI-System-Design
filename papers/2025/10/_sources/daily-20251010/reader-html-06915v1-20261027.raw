<span id="A9.pic2.2.1" class="ltx_p"><span id="A9.pic2.2.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="--ltx-fg-color:#000000;">System Prompt:</span><span id="A9.pic2.2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> 
