</span>
</span> and 
<span id="id2" class="ltx_tabular ltx_align_middle">
<span class="ltx_tbody">
<span id="id2.1" class="ltx_tr">
<span id="id2.1.1" class="ltx_td ltx_align_center"> <sup id="id2.1.1.1" class="ltx_sup"><span id="id2.1.1.1.1" class="ltx_text ltx_font_italic">1</span></sup>Soochow University  <sup id="id2.1.1.2" class="ltx_sup"><span id="id2.1.1.2.1" class="ltx_text ltx_font_italic">2</span></sup> LCM Laboratory</span></span>
</span>
</span> and 
<span id="id3" class="ltx_tabular ltx_align_middle">
<span class="ltx_tbody">
