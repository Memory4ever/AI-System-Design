<td id="S6.T2.20.1.9.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S6.T2.20.1.9.6.1" class="ltx_text ltx_font_bold">0.954</span></td>
<td id="S6.T2.20.1.9.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.994</td>
