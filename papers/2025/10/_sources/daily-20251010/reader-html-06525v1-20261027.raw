<td id="A1.T1.4.19.4" class="ltx_td ltx_align_center"><span id="A1.T1.4.19.4.1" class="ltx_text" style="font-size:90%;">50</span></td></tr>
<tr id="A1.T1.4.20" class="ltx_tr">
<td id="A1.T1.4.20.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A1.T1.4.20.1.1" class="ltx_text" style="font-size:90%;">FLUX.1-Krea-dev <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>]</cite></span></td>
<td id="A1.T1.4.20.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A1.T1.4.20.2.1" class="ltx_text" style="font-size:90%;">Black Forest Labs</span></td>
