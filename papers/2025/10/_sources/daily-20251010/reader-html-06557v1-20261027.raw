               <span id="alg1.l10.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l10.m1" class="ltx_Math" alttext="\operatorname{last}({\bm{y}})=\texttt{[EOS]}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>last</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mtext class="ltx_mathvariant_monospace">[EOS]</mtext></mrow><annotation encoding="application/x-tex">\operatorname{last}({\bm{y}})=\texttt{[EOS]}</annotation></semantics></math> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l10.4" class="ltx_text ltx_font_bold">break</span>    
