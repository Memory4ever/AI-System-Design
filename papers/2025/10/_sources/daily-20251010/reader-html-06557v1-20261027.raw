</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              
              
              <math id="alg1.l7.m1" class="ltx_math_unparsed" alttext="{\bm{q}}\leftarrow{\bm{q}}\oplus{\bm{y}}_{1:100}" display="inline" intent=":literal"><semantics><mrow><mi>𝒒</mi><mo stretchy="false">←</mo><mi>𝒒</mi><mo>⊕</mo><mi>𝒚</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>100</mn></mrow></msub></mrow><annotation encoding="application/x-tex">{\bm{q}}\leftarrow{\bm{q}}\oplus{\bm{y}}_{1:100}</annotation></semantics></math> <span id="alg1.l7.2" class="ltx_text" style="float:right;"><math id="alg1.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> concatenate first few tokens of <math id="alg1.l7.m3" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi>𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math>
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
              
              
              <math id="alg1.l8.m1" class="ltx_Math" alttext="\tau\leftarrow[({\bm{x}},{\bm{y}})]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\leftarrow[({\bm{x}},{\bm{y}})]</annotation></semantics></math> <span id="alg1.l8.2" class="ltx_text" style="float:right;"><math id="alg1.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> trace for group <math id="alg1.l8.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>
</span>
</div>
