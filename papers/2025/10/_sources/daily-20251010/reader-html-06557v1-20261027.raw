<td id="S3.F3.3.1.3.2" class="ltx_td ltx_align_center"><math id="S3.F3.m6" class="ltx_Math" alttext="nS" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">nS</annotation></semantics></math></td>
