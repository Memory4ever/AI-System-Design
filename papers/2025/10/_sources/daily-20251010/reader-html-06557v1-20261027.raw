</div>
<div id="lstnumberx38" class="ltx_listingline"><span id="lstnumberx38.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx38.2" class="ltx_text ltx_lst_comment ltx_font_italic">#<span id="lstnumberx38.2.1" class="ltx_text ltx_lst_space"> </span>Fold<span id="lstnumberx38.2.2" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx38.2.3" class="ltx_text ltx_lst_space"> </span>first<span id="lstnumberx38.2.4" class="ltx_text ltx_lst_space"> </span>hundered<span id="lstnumberx38.2.5" class="ltx_text ltx_lst_space"> </span>tokens<span id="lstnumberx38.2.6" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx38.2.7" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx38.2.8" class="ltx_text ltx_lst_space"> </span>first<span id="lstnumberx38.2.9" class="ltx_text ltx_lst_space"> </span>chunk<span id="lstnumberx38.2.10" class="ltx_text ltx_lst_space"> </span>into<span id="lstnumberx38.2.11" class="ltx_text ltx_lst_space"> </span>query</span>
</div>
<div id="lstnumberx39" class="ltx_listingline"><span id="lstnumberx39.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx39.2" class="ltx_text ltx_lst_identifier">query_ids</span><span id="lstnumberx39.3" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx39.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx39.5" class="ltx_text ltx_lst_identifier">query_ids</span><span id="lstnumberx39.6" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx39.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx39.8" class="ltx_text ltx_lst_identifier">response_ids</span>[:100]
</div>
<div id="lstnumberx40" class="ltx_listingline">
</div>
<div id="lstnumberx41" class="ltx_listingline"><span id="lstnumberx41.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx41.2" class="ltx_text ltx_lst_keyword ltx_font_bold">if</span><span id="lstnumberx41.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.4" class="ltx_text ltx_lst_identifier">response_ids</span>[-1]<span id="lstnumberx41.5" class="ltx_text ltx_lst_space"> </span>==<span id="lstnumberx41.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx41.7" class="ltx_text ltx_lst_identifier">tokenizer</span>.<span id="lstnumberx41.8" class="ltx_text ltx_lst_identifier">eos_token_id</span>:
</div>
<div id="lstnumberx42" class="ltx_listingline"><span id="lstnumberx42.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx42.2" class="ltx_text ltx_lst_keyword ltx_font_bold">break</span>
</div>
