</div>
<div id="lstnumberx12" class="ltx_listingline"><span id="lstnumberx12.1" class="ltx_text ltx_lst_space">    </span>[{<span id="lstnumberx12.2" class="ltx_text ltx_lst_string">"role"</span>:<span id="lstnumberx12.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.4" class="ltx_text ltx_lst_string">"user"</span>,<span id="lstnumberx12.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.6" class="ltx_text ltx_lst_string">"content"</span>:<span id="lstnumberx12.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx12.8" class="ltx_text ltx_lst_string">"Solve<span id="lstnumberx12.8.1" class="ltx_text ltx_lst_space">␣</span>the<span id="lstnumberx12.8.2" class="ltx_text ltx_lst_space">␣</span>problem<span id="lstnumberx12.8.3" class="ltx_text ltx_lst_space">␣</span>step<span id="lstnumberx12.8.4" class="ltx_text ltx_lst_space">␣</span>by<span id="lstnumberx12.8.5" class="ltx_text ltx_lst_space">␣</span>step;<span id="lstnumberx12.8.6" class="ltx_text ltx_lst_space">␣</span>…"</span>}],
</div>
<div id="lstnumberx13" class="ltx_listingline"><span id="lstnumberx13.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx13.2" class="ltx_text ltx_lst_identifier">tokenize</span>=<span id="lstnumberx13.3" class="ltx_text ltx_lst_identifier">True</span>,
</div>
<div id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx14.2" class="ltx_text ltx_lst_identifier">add_generation_prompt</span>=<span id="lstnumberx14.3" class="ltx_text ltx_lst_identifier">True</span>,
</div>
<div id="lstnumberx15" class="ltx_listingline">)
</div>
<div id="lstnumberx16" class="ltx_listingline">
</div>
<div id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_identifier">trace_ids</span><span id="lstnumberx17.2" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx17.3" class="ltx_text ltx_lst_space"> </span>[]<span id="lstnumberx17.4" class="ltx_text ltx_lst_space">  </span><span id="lstnumberx17.5" class="ltx_text ltx_lst_comment ltx_font_italic">#<span id="lstnumberx17.5.1" class="ltx_text ltx_lst_space"> </span>list<span id="lstnumberx17.5.2" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx17.5.3" class="ltx_text ltx_lst_space"> </span>generated<span id="lstnumberx17.5.4" class="ltx_text ltx_lst_space"> </span>token<span id="lstnumberx17.5.5" class="ltx_text ltx_lst_space"> </span>IDs<span id="lstnumberx17.5.6" class="ltx_text ltx_lst_space"> </span>across<span id="lstnumberx17.5.7" class="ltx_text ltx_lst_space"> </span>chunks</span>
</div>
<div id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_lst_identifier">prompt_ids</span><span id="lstnumberx18.2" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx18.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.4" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold">list</span>(<span id="lstnumberx18.5" class="ltx_text ltx_lst_identifier">query_ids</span>)<span id="lstnumberx18.6" class="ltx_text ltx_lst_space">  </span><span id="lstnumberx18.7" class="ltx_text ltx_lst_comment ltx_font_italic">#<span id="lstnumberx18.7.1" class="ltx_text ltx_lst_space"> </span>current-chunk<span id="lstnumberx18.7.2" class="ltx_text ltx_lst_space"> </span>prompt<span id="lstnumberx18.7.3" class="ltx_text ltx_lst_space"> </span>(reset<span id="lstnumberx18.7.4" class="ltx_text ltx_lst_space"> </span>each<span id="lstnumberx18.7.5" class="ltx_text ltx_lst_space"> </span>iteration)</span>
</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_identifier">it</span><span id="lstnumberx19.2" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx19.3" class="ltx_text ltx_lst_space"> </span>0
</div>
<div id="lstnumberx20" class="ltx_listingline">
</div>
<div id="lstnumberx21" class="ltx_listingline"><span id="lstnumberx21.1" class="ltx_text ltx_lst_keyword ltx_font_bold">while</span><span id="lstnumberx21.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.3" class="ltx_text ltx_lst_identifier">it</span><span id="lstnumberx21.4" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx21.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.6" class="ltx_text ltx_lst_identifier">I</span>:
</div>
<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx22.2" class="ltx_text ltx_lst_identifier">max_new</span><span id="lstnumberx22.3" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx22.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.5" class="ltx_text ltx_lst_identifier">C</span><span id="lstnumberx22.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.7" class="ltx_text ltx_lst_keyword ltx_font_bold">if</span><span id="lstnumberx22.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.9" class="ltx_text ltx_lst_identifier">it</span><span id="lstnumberx22.10" class="ltx_text ltx_lst_space"> </span>==<span id="lstnumberx22.11" class="ltx_text ltx_lst_space"> </span>0<span id="lstnumberx22.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.13" class="ltx_text ltx_lst_keyword ltx_font_bold">else</span><span id="lstnumberx22.14" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx22.15" class="ltx_text ltx_lst_identifier">C</span><span id="lstnumberx22.16" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx22.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.18" class="ltx_text ltx_lst_identifier">m</span>)
</div>
