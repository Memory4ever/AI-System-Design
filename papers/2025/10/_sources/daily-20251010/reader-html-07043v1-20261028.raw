<span id="A5.SS1.SSSx3.p2" class="ltx_para ltx_noindent">
<span id="A5.SS1.SSSx3.p2.1" class="ltx_p"><span id="A5.SS1.SSSx3.p2.1.1" class="ltx_text ltx_font_bold">When NOT making a recommendation:</span></span>
<span id="A5.SS1.SSSx3.p2.2" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64,ewogICJtZXNzYWdlIjogIllvdSBhcmUgd2VsY29tZSEgSG9wZSB5b3UgaGF2ZSBhIHdvbmRlcmZ1bCB0cmlwISIsCiAgImZvcm1hbF9yZWNvbW1lbmRhdGlvbiI6ICJOb25lIgp9" download="">⬇</a></span>
<span id="lstnumberx44" class="ltx_listingline"><span id="lstnumberx44.1" class="ltx_text ltx_font_typewriter">{</span>
</span>
<span id="lstnumberx45" class="ltx_listingline"><span id="lstnumberx45.1" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx45.2" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx45.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">message</span><span id="lstnumberx45.4" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx45.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.6" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx45.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx45.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx45.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">welcome</span><span id="lstnumberx45.12" class="ltx_text ltx_font_typewriter">!</span><span id="lstnumberx45.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Hope</span><span id="lstnumberx45.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx45.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">have</span><span id="lstnumberx45.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx45.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">wonderful</span><span id="lstnumberx45.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx45.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">trip</span><span id="lstnumberx45.25" class="ltx_text ltx_font_typewriter">!",</span>
</span>
