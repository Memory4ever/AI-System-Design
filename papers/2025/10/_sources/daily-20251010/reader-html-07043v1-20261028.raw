<th id="A1.T4.4.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T4.4.1.7.1" class="ltx_text ltx_font_bold">Mean (Std)</span></th></tr>
