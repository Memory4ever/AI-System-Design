</span>
<span id="lstnumberx12" class="ltx_listingline"><span id="lstnumberx12.1" class="ltx_text ltx_lst_space ltx_font_typewriter">               </span><span id="lstnumberx12.2" class="ltx_text ltx_font_typewriter">1.</span><span id="lstnumberx12.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx12.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question_response</span><span id="lstnumberx12.5" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx12.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx12.7" class="ltx_text ltx_font_typewriter">...</span>
</span>
<span id="lstnumberx13" class="ltx_listingline"><span id="lstnumberx13.1" class="ltx_text ltx_lst_space ltx_font_typewriter">               </span><span id="lstnumberx13.2" class="ltx_text ltx_font_typewriter">2.</span><span id="lstnumberx13.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">constraint_check</span><span id="lstnumberx13.5" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx13.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx13.7" class="ltx_text ltx_font_typewriter">...</span>
</span>
<span id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_lst_space ltx_font_typewriter">               </span><span id="lstnumberx14.2" class="ltx_text ltx_font_typewriter">3.</span><span id="lstnumberx14.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state_utility</span><span id="lstnumberx14.5" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx14.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.7" class="ltx_text ltx_font_typewriter">...</span>
</span>
<span id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_space ltx_font_typewriter">               </span><span id="lstnumberx15.2" class="ltx_text ltx_font_typewriter">4.</span><span id="lstnumberx15.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reveal_progressive_constraint</span><span id="lstnumberx15.5" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx15.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.7" class="ltx_text ltx_font_typewriter">...</span>
</span>
<span id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_space ltx_font_typewriter">               </span><span id="lstnumberx16.2" class="ltx_text ltx_font_typewriter">5.</span><span id="lstnumberx16.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question_and_verify</span><span id="lstnumberx16.5" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx16.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.7" class="ltx_text ltx_font_typewriter">...",</span>
</span>
<span id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx17.2" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">user_response</span><span id="lstnumberx17.4" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx17.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.6" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx17.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">what</span><span id="lstnumberx17.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">user</span><span id="lstnumberx17.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">would</span><span id="lstnumberx17.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">naturally</span><span id="lstnumberx17.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">respond</span><span id="lstnumberx17.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">based</span><span id="lstnumberx17.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">on</span><span id="lstnumberx17.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">analysis</span><span id="lstnumberx17.22" class="ltx_text ltx_font_typewriter">",</span>
</span>
