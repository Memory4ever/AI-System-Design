<span id="A3.SS1.tab1.1.7.1.1" class="ltx_inline-block ltx_align_top" style="width:19.9pt;">
<span id="A3.SS1.tab1.1.7.1.1.1" class="ltx_p">6</span>
</span></td>
<td id="A3.SS1.tab1.1.7.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="A3.SS1.tab1.1.7.2.1" class="ltx_inline-block ltx_align_top" style="width:99.4pt;">
<span id="A3.SS1.tab1.1.7.2.1.1" class="ltx_p">Critical Comments</span>
</span></td>
<td id="A3.SS1.tab1.1.7.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="A3.SS1.tab1.1.7.3.1" class="ltx_inline-block ltx_align_top" style="width:139.1pt;">
<span id="A3.SS1.tab1.1.7.3.1.1" class="ltx_p">Any other significant errors affecting the task</span>
</span></td>
<td id="A3.SS1.tab1.1.7.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
