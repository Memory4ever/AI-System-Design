<td id="S4.T6.2.4.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T6.2.4.8.1" class="ltx_text ltx_font_bold">69.3</span></td>
<td id="S4.T6.2.4.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">62.7</td></tr>
