<span id="A1.T6.2.8.3.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:27.9pt;">
<span id="A1.T6.2.8.3.1.1" class="ltx_p ltx_align_left">context-aware</span>
<span id="A1.T6.2.8.3.1.2" class="ltx_p ltx_align_left">semantic embedding</span>
</span></td>
