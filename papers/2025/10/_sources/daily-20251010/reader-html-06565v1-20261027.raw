<td id="S4.T4.2.1.2.3" class="ltx_td ltx_align_center" style="padding:-0.5pt 7.0pt;"><span id="S4.T4.2.1.2.3.1" class="ltx_text ltx_font_bold">News</span></td>
<td id="S4.T4.2.1.2.4" class="ltx_td ltx_align_center" style="padding:-0.5pt 7.0pt;"><span id="S4.T4.2.1.2.4.1" class="ltx_text ltx_font_bold">Movie</span></td>
<td id="S4.T4.2.1.2.5" class="ltx_td ltx_align_center" style="padding:-0.5pt 7.0pt;"><span id="S4.T4.2.1.2.5.1" class="ltx_text ltx_font_bold">Sentiment</span></td></tr>
<tr id="S4.T4.2.1.3" class="ltx_tr">
<td id="S4.T4.2.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 7.0pt;"><span id="S4.T4.2.1.3.1.1" class="ltx_text ltx_font_bold">KLD<math id="S4.T4.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T4.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 7.0pt;"><span id="S4.T4.2.1.3.2.1" class="ltx_text ltx_font_bold">KLD<math id="S4.T4.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T4.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.5pt 7.0pt;"><span id="S4.T4.2.1.3.3.1" class="ltx_text ltx_font_bold">KLD<math id="S4.T4.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S4.T4.2.1.4" class="ltx_tr">
<th id="S4.T4.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:-0.5pt 7.0pt;" colspan="5"><span class="ltx_rule" style="width:100%;height:0.5pt;--ltx-bg-color:black;display:inline-block;"> </span></th></tr>
<tr id="S4.T4.2.1.5" class="ltx_tr">
<th id="S4.T4.2.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:-0.5pt 7.0pt;" rowspan="3"><span id="S4.T4.2.1.5.1.1" class="ltx_text">Low</span></th>
