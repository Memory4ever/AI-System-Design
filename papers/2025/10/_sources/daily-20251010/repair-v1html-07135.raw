<td id="S2.T2.4.1.7.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S2.T2.m1" class="ltx_Math" alttext="\thicksim 1.5\times 10^{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.800em">∼</mo><mrow><mn mathsize="0.800em">1.5</mn><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">×</mo><msup><mn mathsize="0.800em">10</mn><mn mathsize="0.800em">5</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\thicksim 1.5\times 10^{5}</annotation></semantics></math></td>
