<td id="S4.T3.4.1.9.4" class="ltx_td ltx_align_center ltx_border_b" style="padding:1pt 8.0pt;"><span id="S4.T3.4.1.9.4.1" class="ltx_text ltx_font_bold">67.9</span></td>
