<th id="S5.T2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" colspan="3">Characteristics</th></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
<th id="S5.T2.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">Hidden Size</th>
<th id="S5.T2.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">Num. Heads</th>
<th id="S5.T2.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r">Head dimension</th></tr>
