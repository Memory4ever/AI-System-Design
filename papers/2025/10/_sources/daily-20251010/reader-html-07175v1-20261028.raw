<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A1.SS3" title="In Appendix A Related Work ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">A.3 </span>Data Contamination and Its Implications for Benchmarking LLMs</span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A2" title="In Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B </span>Experimental Details</span></a>
<ol class="ltx_toclist ltx_toclist_appendix">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS1" title="In Appendix B Experimental Details ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B.1 </span>Models</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS2" title="In Appendix B Experimental Details ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B.2 </span>Prompts</span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A3" title="In Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">C </span>Additional Results and Analyses</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A4" title="In Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D </span>Checklist for Responsible NLP Research</span></a>
<ol class="ltx_toclist ltx_toclist_appendix">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS1" title="In Appendix D Checklist for Responsible NLP Research ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.1 </span>The License of Artifacts</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS2" title="In Appendix D Checklist for Responsible NLP Research ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.2 </span>Artifact Use Consistent with Intended Use</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS3" title="In Appendix D Checklist for Responsible NLP Research ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.3 </span>Documentation of Artifacts</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS4" title="In Appendix D Checklist for Responsible NLP Research ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.4 </span>Statistics for Data</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS5" title="In Appendix D Checklist for Responsible NLP Research ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.5 </span>Descriptive Statistics</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS6" title="In Appendix D Checklist for Responsible NLP Research ‣ Quantifying Data Contamination in Psychometric Evaluations of LLMs" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.6 </span>AI Assistants in Research or Writing</span></a></li>
</ol></li>
</ol></nav>
