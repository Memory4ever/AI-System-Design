<tr id="A1.T9.2.6" class="ltx_tr">
<td id="A1.T9.2.6.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:1pt 4.0pt;"><span id="A1.T9.2.6.1.1" class="ltx_text">BERT-large</span></td>
<td id="A1.T9.2.6.2" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;">0.131</td>
<td id="A1.T9.2.6.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">0.015</td>
<td id="A1.T9.2.6.4" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;">0.033</td>
<td id="A1.T9.2.6.5" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">0.002</td>
<td id="A1.T9.2.6.6" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;">0.021</td>
<td id="A1.T9.2.6.7" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">0.001</td>
<td id="A1.T9.2.6.8" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;">0.068</td>
