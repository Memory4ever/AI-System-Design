<td id="S5.T4.2.1.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;" rowspan="3"><span id="S5.T4.2.1.7.1" class="ltx_text"><math id="S5.T4.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math></span></td>
<td id="S5.T4.2.1.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;" rowspan="3"><span id="S5.T4.2.1.8.1" class="ltx_text"><math id="S5.T4.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></span></td>
<td id="S5.T4.2.1.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 3.0pt;" rowspan="3"><span id="S5.T4.2.1.9.1" class="ltx_text"><math id="S5.T4.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></span></td></tr>
<tr id="S5.T4.2.2" class="ltx_tr">
<td id="S5.T4.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.5pt 3.0pt;">
<span id="S5.T4.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S5.T4.2.2.1.1.1" class="ltx_p"><math id="S5.T4.m4" class="ltx_Math" alttext="\text{DP}_{\text{male}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_bold">DP</mtext><mtext class="ltx_mathvariant_bold">male</mtext></msub><annotation encoding="application/x-tex">\text{DP}_{\text{male}}</annotation></semantics></math>
