<th id="A5.T11.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A5.T11.m1" class="ltx_math_unparsed" alttext="\mathrm{KL}(P||S)" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo stretchy="false">(</mo><mi>P</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}(P||S)</annotation></semantics></math></th>
<th id="A5.T11.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A5.T11.m2" class="ltx_math_unparsed" alttext="\mathrm{KL}(S||P)" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mrow><mo stretchy="false">(</mo><mi>S</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}(S||P)</annotation></semantics></math></th>
<th id="A5.T11.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A5.T11.m3" class="ltx_Math" alttext="\rho(X_{t},H_{t})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><msub><mi>H</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(X_{t},H_{t})</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
