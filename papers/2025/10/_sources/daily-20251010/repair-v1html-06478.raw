<td id="A2.T8.2.1.9.2" class="ltx_td ltx_align_center ltx_border_bb">93.8 <math id="A2.T8.m21" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.9</td>
