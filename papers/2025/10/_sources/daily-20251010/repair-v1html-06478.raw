-color:#00B300;--ltx-fg-color:#00B300;" color="#00B300" fill="#00B300" stroke="#00B300" stroke-width="0.8pt"><path style="fill:none" d="M 123.05 32.72 L 123.05 78.36"></path></g><g style="--ltx-stroke-color:#00B300;--ltx-fill-color:#00B300;--ltx-fg-color:#00B300;" color="#00B300" fill="#00B300" stroke="#00B300" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.0 -1.0 1.0 0.0 123.05 32.72)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#00B300;--ltx-fill-color:#00B300;--ltx-fg-color:#00B300;" color="#00B300" fill="#00B300" stroke="#00B300" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.0 1.0 -1.0 0.0 123.05 78.36)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g></g><g style="--ltx-stroke-color:#00B300;--ltx-fill-color:#00B300;--ltx-fg-color:#00B300;" color="#00B300" fill="#00B300" stroke="#00B300" transform="matrix(1.0 0.0 0.0 1.0 136.14 52.08)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:7.51em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" color="#000000" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="103.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.F2.pic1.m17" class="ltx_Math" alttext="X_{t}=\log\frac{P(y_{t})}{S(y_{t})}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">X</mi><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">t</mi></msub><mo style="--ltx-fg-color:#00B300;" mathcolor="#00B300">=</mo><mrow><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">log</mi><mo lspace="0.167em">⁡</mo><mfrac style="--ltx-fg-color:#00B300;" mathcolor="#00B300"><mrow><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">P</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#00B300;" mathcolor="#00B300" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">y</mi><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">t</mi></msub><mo style="--ltx-fg-color:#00B300;" mathcolor="#00B300" stretchy="false">)</mo></mrow></mrow><mrow><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">S</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#00B300;" mathcolor="#00B300" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">y</mi><mi style="--ltx-fg-color:#00B300;" mathcolor="#00B300">t</mi></msub><mo style="--ltx-fg-color:#00B300;" mathcolor="#00B300" stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">X_{t}=\log\frac{P(y_{t})}{S(y_{t})}</annotation></semantics></math></span></span></foreignObject></g><g></g></g><path d="M 127.2 79.34 C 127.2 81.64 125.34 83.5 123.05 83.5 C 120.76 83.5 118.9 81.64 118.9 79.34 C 118.9 77.05 120.76 75.19 123.05 75.19 C 125.34 75.19 127.2 77.05 127.2 79.34 Z M 123.05 79.34"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 180.88 -32.92)"><foreignObject style="--ltx-fo-width:3.08em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="42.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F2.pic1.2" class="ltx_text">Token <math id="A1.F2.pic1.m18" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -37.07 13.67)"><foreignObject style="--ltx-fo-width:4.93em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="68.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F2.pic1.3" class="ltx_text">Probability</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 214.54 50.57 h 183.06 v 41.51 h -183.06 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 218.69 62.33)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 35.97)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.99)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 32.31 0) translate(67.43,0) matrix(1.0 0.0 0.0 1.0 -64.66 -4.15)"><foreignObject style="--ltx-fo-width:4.03em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="55.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F2.pic1.4" class="ltx_text">Skeleton <math id="A1.F2.pic1.m19" class="ltx_Math" alttext="S(y_{t}|x,y_{&lt;t})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><msub><mi>y</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(y_{t}|x,y_{&lt;t})</annotation></semantics></math></span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 26.98)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(75.01,0) matrix(1.0 0.0 0.0 1.0 -72.24 -4.15)"><foreignObject style="--ltx-fo-width:5.04em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="69.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F2.pic1.5" class="ltx_text">Full model <math id="A1.F2.pic1.m20" class="ltx_Math" alttext="P(y_{t}|x,y_{&lt;t})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>x</mi><mo>,</mo><msub><mi>y</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(y_{t}|x,y_{&lt;t})</annotation></semantics></math></span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Information lift: Full model <math id="A1.F2.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> (peaked) vs. skeleton <math id="A1.F2.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> (flat). Large lift indicates evidence accumulation.</figcaption>
</figure>
<div id="A1.SS1.p5" class="ltx_para">
<p id="A1.SS1.p5.1" class="ltx_p">Building on this skeleton framework, our approach centers on measuring information lift—the log-likelihood gain when the full model assigns higher probability to tokens than the skeleton expects. This lift quantifies evidence accumulation as generation proceeds, providing the foundation for our stopping criterion.</p>
</div>
<div id="A1.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition A.1</span></span><span id="A1.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Clipped lift)<span id="A1.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem1.p1" class="ltx_para">
<p id="A1.Thmtheorem1.p1.1" class="ltx_p"><span id="A1.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">At step <math id="A1.Thmtheorem1.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, with <math id="A1.Thmtheorem1.p1.m2" class="ltx_Math" alttext="0\leq X_{t}\leq B" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>X</mi><mi>t</mi></msub><mo>≤</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">0\leq X_{t}\leq B</annotation></semantics></math> almost surely:</span></p>
<table id="A1.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E6.m1" class="ltx_math_unparsed" alttext="X_{t}=\min\!\left\{\max\!\left(\log\frac{P(y_{t}|x,y_{1:t-1})}{S(y_{t}|x,y_{1:t-1})},0\right),B\right\}" display="block" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>=</mo><mpadded style="width:1.653em;" width="1.653em"><mi>min</mi></mpadded><mrow><mo>{</mo><mpadded style="width:1.808em;" width="1.808em"><mi>max</mi></mpadded><mrow><mo>(</mo><mi>log</mi><mfrac><mrow><mi>P</mi><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo>,</mo><mi>y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>S</mi><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo>,</mo><mi>y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mfrac><mo>,</mo><mn>0</mn><mo>)</mo></mrow><mo>,</mo><mi>B</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">X_{t}=\min\!\left\{\max\!\left(\log\frac{P(y_{t}|x,y_{1:t-1})}{S(y_{t}|x,y_{1:t-1})},0\right),B\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="A1.Thmtheorem1.p1.2" class="ltx_p"><span id="A1.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">for clip <math id="A1.Thmtheorem1.p1.m3" class="ltx_Math" alttext="B&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS1.p6" class="ltx_para">
<p id="A1.SS1.p6.1" class="ltx_p">Our statistical testing framework operates on the formal null and alternative hypotheses:</p>
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E7.m1" class="ltx_Math" alttext="\displaystyle H_{0}:\quad" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle H_{0}:\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E7.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\sum_{t=1}^{\tau}X_{t}\mid\text{stop at }\tau\right]\leq\tau_{\text{sufficient}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><msub><mi>X</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mtext>stop at </mtext><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><msub><mi>τ</mi><mtext>sufficient</mtext></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\sum_{t=1}^{\tau}X_{t}\mid\text{stop at }\tau\right]\leq\tau_{\text{sufficient}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
<tbody id="A1.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E8.m1" class="ltx_Math" alttext="\displaystyle H_{1}:\quad" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle H_{1}:\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E8.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\sum_{t=1}^{\tau}X_{t}\mid\text{stop at }\tau\right]&gt;\tau_{\text{sufficient}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>τ</mi></munderover></mstyle><msub><mi>X</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mtext>stop at </mtext><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow><mo>]</mo></mrow></mrow><mo>&gt;</mo><msub><mi>τ</mi><mtext>sufficient</mtext></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\sum_{t=1}^{\tau}X_{t}\mid\text{stop at }\tau\right]&gt;\tau_{\text{sufficient}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p6.2" class="ltx_p">where <math id="A1.SS1.p6.m1" class="ltx_Math" alttext="\tau_{\text{sufficient}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mtext>sufficient</mtext></msub><annotation encoding="application/x-tex">\tau_{\text{sufficient}}</annotation></semantics></math> represents the threshold for information sufficiency. Under <math id="A1.SS1.p6.m2" class="ltx_Math" alttext="H_{0}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>0</mn></msub><annotation encoding="application/x-tex">H_{0}</annotation></semantics></math>, the cumulative lift remains below the sufficiency threshold, indicating inadequate evidence accumulation. Under <math id="A1.SS1.p6.m3" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, cumulative lift exceeds the threshold, warranting a stopping decision.</p>
</div>
<div id="A1.SS1.p7" class="ltx_para">
<p id="A1.SS1.p7.1" class="ltx_p">To illustrate this framework, consider a toy example with vocabulary <math id="A1.SS1.p7.m1" class="ltx_Math" alttext="\{" display="inline" intent=":literal"><semantics><mo stretchy="false">{</mo><annotation encoding="application/x-tex">\{</annotation></semantics></math>“unit”, “price”, “$0.67”<math id="A1.SS1.p7.m2" class="ltx_Math" alttext="\}" display="inline" intent=":literal"><semantics><mo stretchy="false">}</mo><annotation encoding="application/x-tex">\}</annotation></semantics></math> and two-step reasoning. The full model <math id="A1.SS1.p7.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> has access to worked examples while skeleton <math id="A1.SS1.p7.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> sees only the instruction. At step 1, both models assign moderate probability to “unit” (<math id="A1.SS1.p7.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>: 0.4, <math id="A1.SS1.p7.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>: 0.3), yielding lift <math id="A1.SS1.p7.m7" class="ltx_Math" alttext="X_{1}=\log(0.4/0.3)=0.29" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0.4</mn><mo>/</mo><mn>0.3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0.29</mn></mrow><annotation encoding="application/x-tex">X_{1}=\log(0.4/0.3)=0.29</annotation></semantics></math> nats. At step 2, the full model strongly favors the correct answer “$0.67” (<math id="A1.SS1.p7.m8" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>: 0.8) while the skeleton remains uncertain (<math id="A1.SS1.p7.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>: 0.2), producing <math id="A1.SS1.p7.m10" class="ltx_Math" alttext="X_{2}=\log(0.8/0.2)=1.39" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0.8</mn><mo>/</mo><mn>0.2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1.39</mn></mrow><annotation encoding="application/x-tex">X_{2}=\log(0.8/0.2)=1.39</annotation></semantics></math> nats. The cumulative lift <math id="A1.SS1.p7.m11" class="ltx_Math" alttext="\sum X_{t}=1.68" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∑</mo><msub><mi>X</mi><mi>t</mi></msub></mrow><mo>=</mo><mn>1.68</mn></mrow><annotation encoding="application/x-tex">\sum X_{t}=1.68</annotation></semantics></math> nats indicates evidence accumulation, and our e-process determines whether this exceeds the statistical boundary for certification.</p>
</div>
<div id="A1.SS1.p8" class="ltx_para">
<p id="A1.SS1.p8.1" class="ltx_p">The central challenge lies in unknown centering: we observe <math id="A1.SS1.p8.m1" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> but not the conditional expectation <math id="A1.SS1.p8.m2" class="ltx_Math" alttext="\mu_{t}=\mathbb{E}[X_{t}|\mathcal{F}_{t-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{t}=\mathbb{E}[X_{t}|\mathcal{F}_{t-1}]</annotation></semantics></math>. This uncertainty necessitates the self-normalized empirical-Bernstein e-processes developed in the following section, which estimate the centering online while maintaining statistical validity. The connection to information theory emerges naturally, as <math id="A1.SS1.p8.m3" class="ltx_Math" alttext="\mathbb{E}[X_{t}]\approx I(Y_{t};\text{Context})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≈</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>,</mo><mtext>Context</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[X_{t}]\approx I(Y_{t};\text{Context})</annotation></semantics></math>, the mutual information between the next token and the contextual information that distinguishes the full model from the skeleton.</p>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Automated Skeleton Recipes</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">Table <a href="#A2.T8" title="Table 8 ‣ Appendix B Automated Skeleton Recipes ‣ Valid Stopping for LLM Generation via Empirical Dynamic Formal Lift" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> demonstrates that automated skeletons perform comparably to hand-designed alternatives, with TPCA varying by 16 tokens (19% relative variation, from 84.3 to 100.3) across all methods while maintaining consistent empirical risk control (0.083–0.094, all within target <math id="A2.p1.m1" class="ltx_Math" alttext="\delta=0.1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\delta=0.1</annotation></semantics></math>).</p>
</div>
