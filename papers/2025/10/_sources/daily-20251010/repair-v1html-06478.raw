000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.77)"><foreignObject style="--ltx-fo-width:7.18em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="99.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.5" class="ltx_text">Entropy Halting</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 60.27)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 10.15 -1.66 h 3.32 v 3.32 h -3.32 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.77)"><foreignObject style="--ltx-fo-width:4.59em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="63.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.6" class="ltx_text">Conformal</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 77.49)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path d="M 11.81 2.08 L 13.37 0 L 11.81 -2.08 L 10.25 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.73 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.77)"><foreignObject style="--ltx-fo-width:7.48em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="103.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F1.pic1.7" class="ltx_text">E-Value Baseline</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Time-uniform empirical risk on GSM8K. Sequential-EDFL tracks target <math id="S4.F1.m2" class="ltx_Math" alttext="\delta=0.1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\delta=0.1</annotation></semantics></math> most closely.</figcaption>
</figure>
<div id="S4.SS1.p18" class="ltx_para">
<p id="S4.SS1.p18.1" class="ltx_p">Figure <a href="#S4.F1" title="Figure 1 ‣ 4.1 Main Results: Token Reduction with Formal Guarantees ‣ 4 Experiments ‣ Valid Stopping for LLM Generation via Empirical Dynamic Formal Lift" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> shows empirical type-I error rate computed at each timestep <math id="S4.SS1.p18.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> as the fraction of sequences stopped by time <math id="S4.SS1.p18.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> with incorrect answers. Sequential-EDFL tracks target <math id="S4.SS1.p18.m3" class="ltx_Math" alttext="\delta=0.1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\delta=0.1</annotation></semantics></math> closely throughout, while baselines exhibit poor calibration (entropy) or conservative behavior (conformal).</p>
</div>
<div id="S4.SS1.p19" class="ltx_para">
<p id="S4.SS1.p19.1" class="ltx_p">To assess robustness, we conduct sensitivity analysis across different parameter settings.</p>
</div>
