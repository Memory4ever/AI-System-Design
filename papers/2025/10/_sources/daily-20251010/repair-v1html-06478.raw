<td id="A2.T8.2.1.7.3" class="ltx_td ltx_align_center">0.087 <math id="A2.T8.m14" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.011</td>
<td id="A2.T8.2.1.7.4" class="ltx_td ltx_align_center">9%</td></tr>
<tr id="A2.T8.2.1.8" class="ltx_tr">
<th id="A2.T8.2.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   <math id="A2.T8.m15" class="ltx_Math" alttext="S_{\text{rand}}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mtext>rand</mtext></msub><annotation encoding="application/x-tex">S_{\text{rand}}</annotation></semantics></math> (<math id="A2.T8.m16" class="ltx_Math" alttext="\gamma{=}0.1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\gamma{=}0.1</annotation></semantics></math>)</th>
<td id="A2.T8.2.1.8.2" class="ltx_td ltx_align_center">88.2 <math id="A2.T8.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.6</td>
