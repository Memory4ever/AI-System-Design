<td id="S4.T5.2.1.15.5" class="ltx_td ltx_align_center">0.086<math id="S4.T5.m48" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.011</td></tr>
<tr id="S4.T5.2.1.16" class="ltx_tr">
<th id="S4.T5.2.1.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   <math id="S4.T5.m49" class="ltx_Math" alttext="\tau_{d}=0.10" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>d</mi></msub><mo>=</mo><mn>0.10</mn></mrow><annotation encoding="application/x-tex">\tau_{d}=0.10</annotation></semantics></math> (default)</th>
<td id="S4.T5.2.1.16.2" class="ltx_td ltx_align_center">84.3<math id="S4.T5.m50" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>2.0</td>
<td id="S4.T5.2.1.16.3" class="ltx_td ltx_align_center">12%</td>
<td id="S4.T5.2.1.16.4" class="ltx_td ltx_align_center">2.1<math id="S4.T5.m51" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.6</td>
<td id="S4.T5.2.1.16.5" class="ltx_td ltx_align_center">0.083<math id="S4.T5.m52" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.010</td></tr>
<tr id="S4.T5.2.1.17" class="ltx_tr">
