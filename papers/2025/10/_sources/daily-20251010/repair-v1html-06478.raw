<th id="S4.T5.2.1.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   <math id="S4.T5.m40" class="ltx_Math" alttext="\alpha=0.3" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0.3</mn></mrow><annotation encoding="application/x-tex">\alpha=0.3</annotation></semantics></math></th>
<td id="S4.T5.2.1.13.2" class="ltx_td ltx_align_center">83.1<math id="S4.T5.m41" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>2.0</td>
<td id="S4.T5.2.1.13.3" class="ltx_td ltx_align_center">12%</td>
<td id="S4.T5.2.1.13.4" class="ltx_td ltx_align_center">2.2<math id="S4.T5.m42" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.7</td>
<td id="S4.T5.2.1.13.5" class="ltx_td ltx_align_center">0.077<math id="S4.T5.m43" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.009</td></tr>
<tr id="S4.T5.2.1.14" class="ltx_tr">
<th id="S4.T5.2.1.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="5"><span id="S4.T5.2.1.14.1.1" class="ltx_text ltx_font_italic">Drift threshold <math id="S4.T5.m44" class="ltx_Math" alttext="\tau_{d}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\tau_{d}</annotation></semantics></math></span></th></tr>
<tr id="S4.T5.2.1.15" class="ltx_tr">
<th id="S4.T5.2.1.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">   <math id="S4.T5.m45" class="ltx_Math" alttext="\tau_{d}=0.05" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>d</mi></msub><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\tau_{d}=0.05</annotation></semantics></math></th>
<td id="S4.T5.2.1.15.2" class="ltx_td ltx_align_center">83.7<math id="S4.T5.m46" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>2.0</td>
<td id="S4.T5.2.1.15.3" class="ltx_td ltx_align_center">13%</td>
