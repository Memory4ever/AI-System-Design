<td id="S4.T5.2.1.17.2" class="ltx_td ltx_align_center ltx_border_bb">87.2<math id="S4.T5.m54" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>2.1</td>
<td id="S4.T5.2.1.17.3" class="ltx_td ltx_align_center ltx_border_bb">11%</td>
