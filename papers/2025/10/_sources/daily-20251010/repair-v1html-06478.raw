<td id="A5.T11.2.1.6.4" class="ltx_td ltx_align_center">-0.69</td></tr>
<tr id="A5.T11.2.1.7" class="ltx_tr">
<th id="A5.T11.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">LegalBench</th>
<td id="A5.T11.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb">6.2</td>
<td id="A5.T11.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb">7.1</td>
