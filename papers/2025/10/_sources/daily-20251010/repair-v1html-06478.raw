<td id="A4.T10.2.2.4" class="ltx_td ltx_align_center ltx_border_t">“…= <span id="A4.T10.2.2.4.1" class="ltx_text ltx_font_bold">$4.67</span>” <math id="A4.T10.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> STOP</td></tr>
