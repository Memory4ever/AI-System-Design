<td id="A5.T11.2.1.4.4" class="ltx_td ltx_align_center">-0.53</td></tr>
<tr id="A5.T11.2.1.5" class="ltx_tr">
<th id="A5.T11.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">TruthfulQA</th>
<td id="A5.T11.2.1.5.2" class="ltx_td ltx_align_center">4.3</td>
<td id="A5.T11.2.1.5.3" class="ltx_td ltx_align_center">5.1</td>
<td id="A5.T11.2.1.5.4" class="ltx_td ltx_align_center">-0.61</td></tr>
