<td id="A5.T11.2.1.3.2" class="ltx_td ltx_align_center">5.1</td>
<td id="A5.T11.2.1.3.3" class="ltx_td ltx_align_center">6.3</td>
<td id="A5.T11.2.1.3.4" class="ltx_td ltx_align_center">-0.58</td></tr>
<tr id="A5.T11.2.1.4" class="ltx_tr">
