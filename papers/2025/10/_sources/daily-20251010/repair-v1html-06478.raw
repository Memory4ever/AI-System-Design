<th id="A1.T7.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A1.T7.m3" class="ltx_Math" alttext="\rho(X_{t},H_{t})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo>,</mo><msub><mi>H</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(X_{t},H_{t})</annotation></semantics></math></th></tr>
