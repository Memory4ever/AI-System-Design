<th id="S5.T3.4.1.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S5.T3.4.1.1.8.1" class="ltx_text ltx_font_bold">ImageReward ↑</span></th></tr>
<tr id="S5.T3.4.1.2" class="ltx_tr">
<th id="S5.T3.4.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_bb ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;" rowspan="10"><span id="S5.T3.4.1.2.1.1" class="ltx_text ltx_font_bold">SD 3.5-Large</span></th>
<th id="S5.T3.4.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;" colspan="2"><span id="S5.T3.4.1.2.2.1" class="ltx_text ltx_font_bold">Dense Model</span></th>
