<th id="S5.T3.4.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S5.T3.4.1.1.6.1" class="ltx_text ltx_font_bold">FID ↓</span></th>
