<td id="S5.T4.2.6.2" class="ltx_td ltx_align_center">11.17</td>
<td id="S5.T4.2.6.3" class="ltx_td ltx_align_center">1.29<math id="S5.T4.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
<tr id="S5.T4.2.7" class="ltx_tr">
