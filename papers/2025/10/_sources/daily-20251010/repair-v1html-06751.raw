<th id="A3.SS1.fig1.1.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A3.SS1.fig1.1.1.2.1" class="ltx_text ltx_font_bold">Time (min)</span></th></tr>
