<td id="A2.T4.6.3.3" class="ltx_td ltx_align_center" style="padding:0.75pt 8.0pt;">✗</td>
<td id="A2.T4.6.3.4" class="ltx_td ltx_align_center" style="padding:0.75pt 8.0pt;">85.5</td></tr>
<tr id="A2.T4.6.4" class="ltx_tr">
<td id="A2.T4.6.4.1" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.75pt 8.0pt;">✓</td>
