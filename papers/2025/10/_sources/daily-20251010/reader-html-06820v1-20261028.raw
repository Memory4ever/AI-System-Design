<span id="S5.T2.6.1.1.1.1.1.1.10.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.2.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">12M</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.10.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.3.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">86.9</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.10.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.4.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">96.4</span></span>
