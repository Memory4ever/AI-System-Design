<span id="S5.T2.6.1.1.1.1.1.1.10.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.6.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">80.9</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.10.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.7.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">49kB</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.10.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.8.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">33M</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.10.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.10.9.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">1.91</span></span></span>
