<span id="S5.T2.6.1.1.1.1.1.1.9.3" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.3.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">87.1</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.9.4" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.4.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">96.3</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.9.5" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.5.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">64.6</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.9.6" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.6.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">81</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.9.7" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.7.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">98kB</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.9.8" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.8.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">33M</span></span>
<span id="S5.T2.6.1.1.1.1.1.1.9.9" class="ltx_td ltx_align_center" style="padding-top:0.6pt;padding-bottom:0.6pt;"><span id="S5.T2.6.1.1.1.1.1.1.9.9.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">2.04</span></span></span>
<span id="S5.T2.6.1.1.1.1.1.1.10" class="ltx_tr" style="--ltx-bg-color:#FFE6E6;">
