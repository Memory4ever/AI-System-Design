<tr id="A2.T4.6.2" class="ltx_tr">
<td id="A2.T4.6.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 8.0pt;">✓</td>
<td id="A2.T4.6.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 8.0pt;">✗</td>
<td id="A2.T4.6.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 8.0pt;">✗</td>
<td id="A2.T4.6.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 8.0pt;">82.3</td></tr>
<tr id="A2.T4.6.3" class="ltx_tr">
