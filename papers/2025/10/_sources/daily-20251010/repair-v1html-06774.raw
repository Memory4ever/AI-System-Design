<td id="A4.T6.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A4.T6.2.1.7.2.1" class="ltx_text ltx_font_bold">All Solvers</span></td>
<td id="A4.T6.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A4.T6.2.1.7.3.1" class="ltx_text ltx_font_bold">5,125</span></td></tr>
</table>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 6: </span>Training Data Statistics for Each Reasoning Engine</figcaption>
