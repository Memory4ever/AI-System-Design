<td id="S3.T4.2.1.4.3" class="ltx_td ltx_align_center"><math id="S3.T4.m2" class="ltx_Math" alttext="\underline{28.0}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mn>28.0</mn><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{28.0}</annotation></semantics></math></td></tr>
<tr id="S3.T4.2.1.5" class="ltx_tr">
<td id="S3.T4.2.1.5.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T4.2.1.5.1.1" class="ltx_text ltx_font_bold">GPT-CoT<sub id="S3.T4.2.1.5.1.1.1" class="ltx_sub"><span id="S3.T4.2.1.5.1.1.1.1" class="ltx_text ltx_font_italic">Sym</span></sub></span></td>
<td id="S3.T4.2.1.5.2" class="ltx_td ltx_align_center">21.0</td>
