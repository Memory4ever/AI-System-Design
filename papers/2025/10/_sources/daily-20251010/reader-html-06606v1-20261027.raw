<th id="S3.T2.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S3.T2.2.2.2.1" class="ltx_text ltx_font_bold">Strategy</span></th>
<td id="S3.T2.2.2.3" class="ltx_td ltx_align_right"><span id="S3.T2.2.2.3.1" class="ltx_text ltx_font_bold">Python</span></td>
<td id="S3.T2.2.2.4" class="ltx_td ltx_align_right ltx_border_r"><span id="S3.T2.2.2.4.1" class="ltx_text ltx_font_bold">Kotlin</span></td>
<td id="S3.T2.2.2.5" class="ltx_td ltx_align_right"><span id="S3.T2.2.2.5.1" class="ltx_text ltx_font_bold">Python</span></td>
<td id="S3.T2.2.2.6" class="ltx_td ltx_align_right ltx_border_r"><span id="S3.T2.2.2.6.1" class="ltx_text ltx_font_bold">Kotlin</span></td>
<td id="S3.T2.2.2.7" class="ltx_td ltx_align_right"><span id="S3.T2.2.2.7.1" class="ltx_text ltx_font_bold">Python</span></td>
<td id="S3.T2.2.2.8" class="ltx_td ltx_align_right ltx_border_r"><span id="S3.T2.2.2.8.1" class="ltx_text ltx_font_bold">Kotlin</span></td>
<td id="S3.T2.2.2.9" class="ltx_td ltx_align_right"><span id="S3.T2.2.2.9.1" class="ltx_text ltx_font_bold">Python</span></td>
<td id="S3.T2.2.2.10" class="ltx_td ltx_align_right"><span id="S3.T2.2.2.10.1" class="ltx_text ltx_font_bold">Kotlin</span></td></tr>
<tr id="S3.T2.2.3" class="ltx_tr">
