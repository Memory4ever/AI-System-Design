<tr id="S3.T2.2.4" class="ltx_tr">
<th id="S3.T2.2.4.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="S3.T2.2.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">Recent</th>
<td id="S3.T2.2.4.3" class="ltx_td ltx_align_right">0.57</td>
<td id="S3.T2.2.4.4" class="ltx_td ltx_align_right ltx_border_r">-</td>
