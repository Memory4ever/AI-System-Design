</div>
<div id="algorithm1.3.21" class="ltx_listingline">Initialize <math id="algorithm1.m36" class="ltx_Math" alttext="x_{T}\leftarrow\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{T}\leftarrow\mathcal{N}(0,I)</annotation></semantics></math>;
</div>
<div id="algorithm1.3.22" class="ltx_listingline">Initialize <math id="algorithm1.m37" class="ltx_Math" alttext="x_{T}^{visual}\leftarrow\text{stochastic\_encoding}(x_{0}^{visual},T)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>T</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msubsup><mo stretchy="false">←</mo><mrow><mtext>stochastic_encoding</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msubsup><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{T}^{visual}\leftarrow\text{stochastic\_encoding}(x_{0}^{visual},T)</annotation></semantics></math>;
</div>
<div id="algorithm1.3.23" class="ltx_listingline">Initialize <math id="algorithm1.m38" class="ltx_Math" alttext="t\leftarrow T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t\leftarrow T</annotation></semantics></math>;
