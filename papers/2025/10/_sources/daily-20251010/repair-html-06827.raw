<div id="algorithm1.3.28" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m46" class="ltx_Math" alttext="x_{t-1}\leftarrow\text{color\_calibration}(x_{t},\hat{x}_{t},x_{0}^{visual})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>color_calibration</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t-1}\leftarrow\text{color\_calibration}(x_{t},\hat{x}_{t},x_{0}^{visual})</annotation></semantics></math> ;
</div>
<div id="algorithm1.3.29" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end if
