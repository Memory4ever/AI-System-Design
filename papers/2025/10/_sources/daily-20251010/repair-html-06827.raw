</div>
<div id="algorithm1.3.27" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.3.27.1" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.3.27.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m45" class="ltx_Math" alttext="t_{\text{start}}\leq t\leq t_{\text{end}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mtext class="ltx_mathvariant_italic">start</mtext></msub><mo>≤</mo><mi>t</mi><mo>≤</mo><msub><mi>t</mi><mtext class="ltx_mathvariant_italic">end</mtext></msub></mrow><annotation encoding="application/x-tex">t_{\text{start}}\leq t\leq t_{\text{end}}</annotation></semantics></math></em> <span id="algorithm1.3.27.3" class="ltx_text ltx_font_bold">then</span>
