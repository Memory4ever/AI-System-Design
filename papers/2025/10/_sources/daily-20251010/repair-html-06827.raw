<div id="algorithm1.3.18" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m33" class="ltx_Math" alttext="\epsilon\sim\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon\sim\mathcal{N}(0,I)</annotation></semantics></math> ;  <span id="algorithm1.3.18.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.3.18.2" class="ltx_text ltx_font_typewriter">Generate random noise</span>
</div>
