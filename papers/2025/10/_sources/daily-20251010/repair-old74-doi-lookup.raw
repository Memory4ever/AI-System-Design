{"data":[{"id":"10.48550/arxiv.2510.06640","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06640","identifiers":[{"identifier":"2510.06640","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nhat M.","familyName":"Hoang","name":"Hoang, Nhat M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Do Xuan","familyName":"Long","name":"Long, Do Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong-Duy","familyName":"Nguyen","name":"Nguyen, Cong-Duy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunyan","familyName":"Miao","name":"Miao, Chunyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min-Yen","familyName":"Kan","name":"Kan, Min-Yen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luu Anh","familyName":"Tuan","name":"Tuan, Luu Anh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Contextual Representation Flow Across Depth in State-Space and Transformer Architectures"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T04:46:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:24:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-07T04:15:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-08T01:17:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-13T12:51:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-14T03:48:02Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"State Space Models (SSMs) have emerged as efficient, linear-time alternatives to Transformer-Based Models (TBMs) for long-context processing. However, their different mechanisms raise an important question: how does contextual representation flow across depth differ between these model families and their hybrids? We examine this question across twenty-one pretrained models, combining token-wise spectral diversity, layer-wise variation on seven datasets, and answer-location probing on two retrieval tasks. This joint analysis reveals that TBMs retain most of their token diversity at the output, whereas SSMs reach richer intermediate diversity but retain less of it on average, with late-layer compression. Comparisons with reinitialized weights reveal that these profiles depend on pretrained weights, while hybrids combine strong answer-location accessibility with architecture-dependent geometry, showing that high accessibility need not require the steadiest representation flow. Finally, we conduct theoretical case studies connecting these contrasts to mechanism-level differences: query-time token mixing in TBMs, repeated recurrent updates in SSMs, and preserved attention updates in hybrids."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06640","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:51:00Z","registered":"2025-10-09T01:51:01Z","published":null,"updated":"2026-10-14T08:20:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06492","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06492","identifiers":[{"identifier":"2510.06492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matthew","familyName":"Kim","name":"Kim, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kensuke","familyName":"Nakamura","name":"Nakamura, Kensuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Bajcsy","name":"Bajcsy, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Well Do Latent World Models Understand Partially Observable Safety Constraints?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T22:09:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:11:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-06T02:12:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-09T00:19:41Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-12T09:34:52Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-14T02:14:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Latent world models are a promising approach for learning state representations and dynamics directly from high-dimensional observations, enabling robot control in hard-to-model settings. However, control performance ultimately depends on the latent representation encoding the required information for the task. In this work, we study latent-space safe control problems and show how partial observability can induce control failures when safety-relevant information is not preserved in the latent state. Specifically, we identify two world model failure modes: estimation gaps, where current observations do not reveal safety-critical quantities (e.g., temperature in a cooking task), and prediction gaps, where failures are observable once they occur but cannot be reliably anticipated from available observations. We introduce two diagnostics for these gaps: a mutual-information-based measure of safety observability and a rollout-based measure of future safety predictability. Finally, we present mitigation strategies for each failure mode: privileged multimodal supervision for estimation gaps and conformal risk calibration for prediction gaps. Across two hardware case studies -- using unimodal RGB world models and multimodal RGB+Tactile and RGB+Thermal variants -- we show that these mitigation strategies improve the safety of a Franka Research 3 manipulator on challenging cooking tasks under partial observability, albeit with increased conservativeness. More broadly, our work raises the question of when world model state representations are sufficient for reliable robot control"},{"descriptionType":"Other","description":"10 tables 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06492","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:47:32Z","registered":"2025-10-09T01:47:33Z","published":null,"updated":"2026-10-14T08:20:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06710","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06710","identifiers":[{"identifier":"2510.06710","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongzhi","familyName":"Zang","name":"Zang, Hongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjie","familyName":"Wei","name":"Wei, Mingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Si","familyName":"Xu","name":"Xu, Si","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongji","familyName":"Wu","name":"Wu, Yongji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Guo","name":"Guo, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanqing","familyName":"Wang","name":"Wang, Yuanqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Lin","name":"Lin, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peihong","familyName":"Wang","name":"Wang, Peihong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangzhi","familyName":"Shi","name":"Shi, Liangzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Xie","name":"Xie, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhexuan","familyName":"Xu","name":"Xu, Zhexuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Liu","name":"Liu, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Chen","name":"Chen, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Tang","name":"Tang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quanlu","familyName":"Zhang","name":"Zhang, Quanlu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weinan","familyName":"Zhang","name":"Zhang, Weinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Yu","name":"Yu, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wang","name":"Wang, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLinf-VLA: A Unified and Efficient Framework for Reinforcement Learning of Vision-Language-Action Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T07:05:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:29:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-07T10:46:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T01:33:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-12T08:36:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-13T00:32:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent studies have demonstrated the potential of reinforcement learning (RL) to improve the task performance of vision-language-action (VLA) models through interaction. However, current efforts remain fragmented, lacking a unified platform for fair comparison across architectures and algorithms, as well as an efficient system design for scalable training. Therefore, we present RLinf-VLA, a unified and efficient framework for scalable RL training of VLA models. RLinf-VLA standardizes the integration of diverse VLA architectures, RL algorithms, and heterogeneous simulators through a unified interface, enabling extensibility and reproducibility. To improve efficiency, the framework adopts a flexible resource allocation architecture for rendering, inference, and training in RL pipelines. In particular, RLinf-VLA introduces a hybrid fine-grained pipeline allocation strategy that achieves a 1.61$\\times$-1.88$\\times$ training speedup on ManiSkill. Using this framework, RL-trained models achieve strong performance across embodied benchmarks, including 98.11% success on 130 LIBERO tasks, 97.66% success on 25 ManiSkill tasks, and 84.63% average success across 6 RoboTwin tasks. In addition, RLinf-VLA distills a set of effective practices for RL-based VLA training. We envision RLinf-VLA as a foundational framework for efficient, unified, and reproducible research in embodied intelligence."},{"descriptionType":"Other","description":"Accepted to RSS 2026. This is the technical report of the RLinf Team, focusing on the algorithm side. For the system-level design, please refer to arXiv:2509.15965. The open-sourced code link: https://github.com/RLinf/RLinf"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06710","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:52:39Z","registered":"2025-10-09T01:52:39Z","published":null,"updated":"2026-08-13T02:11:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07651","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07651","identifiers":[{"identifier":"2510.07651","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuzhe","familyName":"Gu","name":"Gu, Yuzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyu","familyName":"Liang","name":"Liang, Xiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaojiao","familyName":"Zhao","name":"Zhao, Jiaojiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enmao","familyName":"Diao","name":"Diao, Enmao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OBCache: Optimal Brain KV Cache Pruning for Efficient Long-Context LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-09T00:58:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-10T00:17:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T18:28:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-01T00:03:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-14T15:13:43Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T01:02:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-07T21:07:45Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-08-11T00:11:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) with extended context windows enable powerful applications but impose significant memory overhead, as caching all key-value (KV) states scales linearly with sequence length and batch size. Existing cache eviction methods address this by exploiting attention sparsity, yet they typically rank tokens heuristically using accumulated attention weights without considering their true impact on attention outputs. We propose Optimal Brain Cache (OBCache), a principled framework that formulates cache eviction as a layer-wise structured pruning problem. Building upon the Optimal Brain Damage (OBD) theory, OBCache quantifies token saliency by measuring the perturbation in attention outputs induced by pruning tokens, with closed-form scores derived for isolated keys, isolated values, and joint key-value pairs. Our scores account not only for attention weights but also for information from value states and attention outputs, thereby enhancing existing eviction strategies with output-aware signals. Experiments on LLaMA and Qwen models demonstrate that replacing the heuristic scores in existing works, which estimate token saliency across different query positions, with OBCache's output-aware scores consistently improves long-context accuracy. Code is available at https://github.com/DreamSoul-AI/OBCache."},{"descriptionType":"Other","description":"ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07651","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-10T02:02:44Z","registered":"2025-10-10T02:02:45Z","published":null,"updated":"2026-08-11T04:12:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05592","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05592","identifiers":[{"identifier":"2510.05592","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuofeng","familyName":"Li","name":"Li, Zhuofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxiang","familyName":"Zhang","name":"Zhang, Haoxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungju","familyName":"Han","name":"Han, Seungju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Liu","name":"Liu, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwen","familyName":"Xie","name":"Xie, Jianwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Zhang","name":"Zhang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yejin","familyName":"Choi","name":"Choi, Yejin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Zou","name":"Zou, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Lu","name":"Lu, Pan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"In-the-Flow Agentic System Optimization for Effective Planning and Tool Use"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T05:32:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:26:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-22T06:43:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-23T00:25:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Outcome-driven reinforcement learning has advanced reasoning in large language models (LLMs), but prevailing tool-augmented approaches train a single, monolithic policy that interleaves thoughts and tool calls under full context; this scales poorly with long horizons and diverse tools and generalizes weakly to new scenarios. Agentic systems offer a promising alternative by decomposing work across specialized modules, yet most remain training-free or rely on offline training decoupled from the live dynamics of multi-turn interaction. We introduce AgentFlow, a trainable, in-the-flow agentic framework that coordinates four modules (planner, executor, verifier, generator) through an evolving memory and directly optimizes its planner inside the multi-turn loop. To train on-policy in live environments, we propose Flow-based Group Refined Policy Optimization (Flow-GRPO), which tackles long-horizon, sparse-reward credit assignment by converting multi-turn optimization into a sequence of tractable single-turn policy updates. It broadcasts a single, verifiable trajectory-level outcome to every turn to align local planner decisions with global success and stabilizes learning with group-normalized advantages. Across ten benchmarks, AgentFlow with a 7B-scale backbone outperforms top-performing baselines with average accuracy gains of 14.9% on search, 14.0% on agentic, 14.5% on mathematical, and 4.1% on scientific tasks, even surpassing larger proprietary models like GPT-4o. Further analyses confirm the benefits of in-the-flow optimization, showing improved planning, enhanced tool-calling reliability, and positive scaling with model size and reasoning turns."},{"descriptionType":"Other","description":"47 pages, 12 figures. ICLR 2026 Oral. Project website: https://agentflow.stanford.edu/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05592","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:52:27Z","registered":"2025-10-08T01:52:28Z","published":null,"updated":"2026-07-23T02:07:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05969","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05969","identifiers":[{"identifier":"2510.05969","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sunbowen","familyName":"Lee","name":"Lee, Sunbowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyu","familyName":"Yin","name":"Yin, Qingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chak Tou","familyName":"Leong","name":"Leong, Chak Tou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialiang","familyName":"Zhang","name":"Zhang, Jialiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yicheng","familyName":"Gong","name":"Gong, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiwen","familyName":"Ni","name":"Ni, Shiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Yang","name":"Yang, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Shen","name":"Shen, Xiaoyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Probing the Difficulty Perception Mechanism of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T14:24:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:51:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-12T07:13:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:55:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-19T06:24:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-21T00:50:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly deployed on complex reasoning tasks, yet little is known about their ability to internally evaluate problem difficulty, which is an essential capability for adaptive reasoning and efficient resource allocation. In this work, we investigate whether LLMs implicitly encode problem difficulty in their internal representations. Using a linear probe on the final-token representations of LLMs, we demonstrate that the difficulty level of math problems can be linearly modeled. We further locate the specific attention heads of the final Transformer layer: these attention heads have opposite activation patterns for simple and difficult problems, thus achieving perception of difficulty. Our ablation experiments prove the accuracy of the location. Crucially, our experiments provide practical support for using LLMs as automatic difficulty annotators, potentially substantially reducing reliance on costly human labeling in benchmark construction and curriculum learning. We also uncover that there is a significant difference in entropy and difficulty perception at the token level. Our study reveals that difficulty perception in LLMs is not only present but also structurally organized, offering new theoretical insights and practical directions for future research. Our code is available at https://github.com/Aegis1863/Difficulty-Perception-of-LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05969","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:01:18Z","registered":"2025-10-08T02:01:19Z","published":null,"updated":"2026-07-21T03:43:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06717","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06717","identifiers":[{"identifier":"2510.06717","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuanfei","familyName":"Lin","name":"Lin, Yuanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Illing","name":"Illing, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Althoff","name":"Althoff, Matthias","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SanDRA: Safe Large-Language-Model-Based Decision Making for Automated Vehicles Using Reachability Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T07:13:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:29:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-11T02:10:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-14T00:16:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have been widely applied to knowledge-driven decision-making for automated vehicles due to their strong generalization and reasoning capabilities. However, the safety of the resulting decisions cannot be ensured due to possible hallucinations and the lack of integrated vehicle dynamics. To address this issue, we propose SanDRA, the first safe large-language-model-based decision making framework for automated vehicles using reachability analysis. Our approach starts with a comprehensive description of the driving scenario to prompt LLMs to generate and rank feasible driving actions. These actions are translated into temporal logic formulas that incorporate formalized traffic rules, and are subsequently integrated into reachability analysis to eliminate unsafe actions. We validate our approach in both open-loop and closed-loop driving environments using off-the-shelf and finetuned LLMs, showing that it can provide provably safe and, where possible, legally compliant driving actions, even under high-density traffic conditions. To ensure transparency and facilitate future research, all code and experimental setups are publicly available at github.com/CommonRoad/SanDRA."},{"descriptionType":"Other","description":"@2026 IEEE. Personal use of this material is permitted. Permission from IEEE must be obtained for all other uses, in any current or future media, including reprinting/republishing this material for advertising or promotional purposes, creating new collective works, for resale or redistribution to servers or lists, or reuse of any copyrighted component of this work in other works"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06717","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:52:48Z","registered":"2025-10-09T01:52:49Z","published":null,"updated":"2026-07-14T03:58:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05681","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05681","identifiers":[{"identifier":"2510.05681","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suhyeok","familyName":"Jang","name":"Jang, Suhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyoung","familyName":"Kim","name":"Kim, Dongyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changyeon","familyName":"Kim","name":"Kim, Changyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youngsuk","familyName":"Kim","name":"Kim, Youngsuk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwoo","familyName":"Shin","name":"Shin, Jinwoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Verifier-free Test-Time Sampling for Vision-Language-Action Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T08:38:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:33:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-04T15:45:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T01:19:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action models (VLAs) have demonstrated remarkable performance in robot control. However, they remain fundamentally limited in tasks that require high precision due to their single-inference paradigm. While test-time scaling approaches using external verifiers have shown promise, they require additional training and fail to generalize to unseen conditions. We propose Masking Distribution Guided Selection (MG-Select), a novel test-time scaling framework for VLAs that leverages the model's internal properties without requiring additional training or external modules. Our approach utilizes KL divergence from a reference action token distribution as a confidence metric for selecting the optimal action from multiple candidates. We introduce a reference distribution generated by the same VLA but with randomly masked states and language conditions as inputs, providing action uncertainty while remaining aligned with the target task distribution. Additionally, we propose a joint training strategy that enables the model to learn both conditional and unconditional distributions by applying dropout to state and language conditions, thereby further improving the quality of the reference distribution. Our experiments demonstrate that MG-Select provides a reliable reference for action selection through task-relevant condition masking and consistently improves base models across diverse simulation and real-world benchmarks."},{"descriptionType":"Other","description":"Accepted to ICLR 2026. Project page: https://suhyeok-jang.github.io/mg-select/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05681","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:54:31Z","registered":"2025-10-08T01:54:32Z","published":null,"updated":"2026-07-07T04:58:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06048","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06048","identifiers":[{"identifier":"2510.06048","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Hao","name":"Hao, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Yu","name":"Yu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhang","name":"Zhang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huixia","familyName":"Wang","name":"Wang, Huixia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Xu","name":"Xu, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingrui","familyName":"Liu","name":"Liu, Mingrui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BLISS: A Lightweight Bilevel Influence Scoring Method for Data Selection in Language Model Pretraining"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T15:42:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:55:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T17:49:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-09T01:03:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-02T22:11:07Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:13:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-31T22:01:59Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-02T01:25:24Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-06-18T04:28:50Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-06-19T00:23:54Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective data selection is essential for pretraining large language models (LLMs), enhancing efficiency and improving generalization to downstream tasks. However, existing approaches often require leveraging external pretrained models, making it difficult to disentangle the effects of data selection from those of the external pretrained models. In addition, they often overlook the long-term impact of selected data if the model is trained to convergence, primarily due to the prohibitive cost of full-scale LLM pretraining. In this paper, we introduce BLISS (\\textbf{B}ileve\\textbf{L} \\textbf{I}nfluence \\textbf{S}coring method for data \\textbf{S}election): a lightweight data selection method that operates entirely \\emph{from scratch}, without relying on any external pretrained oracle models, while explicitly accounting for the long-term impact of selected data. BLISS leverages a small proxy model as a surrogate for the LLM and employs a score model to estimate the long-term influence of training samples if the proxy model is trained to convergence. We formulate data selection as a bilevel optimization problem, where the upper-level objective optimizes the score model to assign importance weights to training samples, ensuring that minimizing the lower-level objective (i.e., training the proxy model over the weighted training loss until convergence) leads to best validation performance. Once optimized, the trained score model predicts influence scores for the dataset, enabling efficient selection of high-quality samples for LLM pretraining. We validate BLISS by pretraining 410M/1B/2.8B Pythia and LLaMA-0.5B models on selected subsets of the C4 dataset. Notably, under the 1B model setting, BLISS achieves $1.7\\times$ speedup in reaching the same performance as the state-of-the-art method, demonstrating superior performance across multiple downstream tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06048","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:03:10Z","registered":"2025-10-08T02:03:10Z","published":null,"updated":"2026-06-19T02:17:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07135","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07135","identifiers":[{"identifier":"2510.07135","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Karim El","familyName":"Khoury","name":"Khoury, Karim El","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxime","familyName":"Zanella","name":"Zanella, Maxime","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christophe","familyName":"De Vleeschouwer","name":"De Vleeschouwer, Christophe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benoit","familyName":"Macq","name":"Macq, Benoit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Few-Shot Adaptation Benchmark for Remote Sensing Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T15:29:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-01T01:05:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Remote Sensing Vision-Language Models (RSVLMs) have shown remarkable potential thanks to large-scale pretraining, achieving strong zero-shot performance on various tasks. However, their ability to generalize in low-data regimes, such as few-shot learning, remains insufficiently explored. In this work, we present the first structured benchmark for evaluating few-shot adaptation methods on RSVLMs. We conduct comprehensive experiments across ten remote sensing scene classification datasets, applying five widely used few-shot adaptation strategies to three state-of-the-art RSVLMs with varying backbones. Our findings reveal that models with similar zero-shot performance can exhibit markedly different behavior under few-shot adaptation, with some RSVLMs being inherently more amenable to such adaptation than others. The variability of performance and the absence of a clear winner among existing methods highlight the need for the development of more robust methods for few-shot adaptation tailored to RS. To facilitate future research, we provide a reproducible benchmarking framework and open-source code to systematically evaluate RSVLMs under few-shot conditions. The source code is publicly available on Github: https://github.com/elkhouryk/fewshot_RSVLMs"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07135","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:02:42Z","registered":"2025-10-09T02:02:42Z","published":null,"updated":"2026-06-01T02:33:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06182","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06182","identifiers":[{"identifier":"2510.06182","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yoav","familyName":"Gur-Arieh","name":"Gur-Arieh, Yoav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mor","familyName":"Geva","name":"Geva, Mor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atticus","familyName":"Geiger","name":"Geiger, Atticus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mixing Mechanisms: How Language Models Retrieve Bound Entities In-Context"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:44:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:02:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T05:00:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-29T00:31:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A key component of in-context reasoning is the ability of language models (LMs) to bind entities for later retrieval. For example, an LM might represent \"Ann loves pie\" by binding \"Ann\" to \"pie\", allowing it to later retrieve \"Ann\" when asked \"Who loves pie?\" Prior research on short lists of bound entities found strong evidence that LMs implement such retrieval via a positional mechanism, where \"Ann\" is retrieved based on its position in context. In this work, we find that this mechanism generalizes poorly to more complex settings; as the number of bound entities in context increases, the positional mechanism becomes noisy and unreliable in middle positions. To compensate for this, we find that LMs supplement the positional mechanism with a lexical mechanism (retrieving \"Ann\" using its bound counterpart \"pie\") and a reflexive mechanism (retrieving \"Ann\" through a direct pointer). Through extensive experiments on nine models and ten binding tasks, we uncover a consistent pattern in how LMs mix these mechanisms to drive model behavior. We leverage these insights to develop a causal model combining all three mechanisms that estimates next token distributions with 95% agreement. Finally, we show that our model generalizes to substantially longer inputs of open-ended text interleaved with entity groups, further demonstrating the robustness of our findings in more natural settings. Overall, our study establishes a more complete picture of how LMs bind and retrieve entities in-context."},{"descriptionType":"Other","description":"Accepted to ICLR 2026 Main Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06182","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:06:17Z","registered":"2025-10-08T02:06:18Z","published":null,"updated":"2026-05-29T02:57:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06133","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06133","identifiers":[{"identifier":"2510.06133","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kangyu","familyName":"Wang","name":"Wang, Kangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyun","familyName":"Jiang","name":"Jiang, Zhiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haibo","familyName":"Feng","name":"Feng, Haibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijia","familyName":"Zhao","name":"Zhao, Weijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Liu","name":"Liu, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianguo","familyName":"Li","name":"Li, Jianguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenzhong","familyName":"Lan","name":"Lan, Zhenzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiyao","familyName":"Lin","name":"Lin, Weiyao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CreditDecoding: Accelerating Parallel Decoding in Diffusion Large Language Models with Trace Credit"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:08:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:00:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-19T15:25:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T01:16:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-26T03:39:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-27T00:27:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion large language models (dLLMs) generate text through iterative denoising. In commonly adopted parallel decoding schemes, each step confirms only high-confidence positions while remasking the others. By analyzing dLLM denoising traces, we uncover a key inefficiency: models often predict the correct target token several steps before its confidence becomes high enough to be decoded. This gap between early prediction and late decoding forces repeated remasking of already-correct tokens, causing redundant iterations and limiting acceleration. To exploit this temporal redundancy, we introduce Trace Credit to quantify a token's decoding potential by accumulating historical evidence. Building on this, we propose CreditDecoding, a training-free parallel decoding method that fuses Trace Credit with current logits to boost the confidence of correct but underconfident tokens, thereby accelerating denoising and improving robustness. On eight benchmarks, CreditDecoding achieves up to 5.48 times speedup with +0.48 accuracy on LLaDA-8B and consistently improves performance across diverse dLLM architectures and parameter scales. It further scales to long contexts and remains orthogonal to mainstream inference optimizations, making it a practical and widely applicable solution."},{"descriptionType":"Other","description":"19 pages, 13 figures, 9 tables, Accepted to ACL 2026 main conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06133","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:05:07Z","registered":"2025-10-08T02:05:08Z","published":null,"updated":"2026-05-27T02:36:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07343","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07343","identifiers":[{"identifier":"2510.07343","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shaorong","familyName":"Zhang","name":"Zhang, Shaorong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rob","familyName":"Brekelmans","name":"Brekelmans, Rob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Greg Ver","familyName":"Steeg","name":"Steeg, Greg Ver","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local MAP Sampling for Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T19:02:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-10T00:00:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-12T18:18:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:11:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-24T18:40:06Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-26T01:13:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Posterior Sampling (DPS) provides a principled Bayesian approach to inverse problems by sampling from $p(x_0 \\mid y)$. While posterior sampling is valuable for capturing uncertainty and multi-modality, many classical and practical inverse problem settings ultimately prioritize accurate point estimation -- most notably the MAP estimator, which has long served as a standard reconstruction objective in imaging and scientific applications. We introduce Local MAP Sampling (LMAPS), a new inference framework that iteratively solves local MAP subproblems along the diffusion trajectory. This perspective clarifies their connection to global MAP and DPS, offering a unified probabilistic interpretation for optimization-based methods. Building on this foundation, we develop practical algorithms with a covariance approximation motivated by a Gaussian prior assumption, and a reformulated objective for stability and interpretability. Across a broad set of image restoration and scientific tasks, LMAPS achieves state-of-the-art performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07343","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-10T01:55:15Z","registered":"2025-10-10T01:55:16Z","published":null,"updated":"2026-05-26T04:04:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05699","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05699","identifiers":[{"identifier":"2510.05699","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Meng","familyName":"Tong","name":"Tong, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Du","name":"Du, Yuntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kejiang","familyName":"Chen","name":"Chen, Kejiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Zhang","name":"Zhang, Weiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ninghui","familyName":"Li","name":"Li, Ninghui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Membership Inference Attacks on Tokenizers of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T09:05:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:34:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-12T12:20:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T02:19:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-08T07:05:20Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T01:06:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-25T05:56:04Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-26T01:27:26Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Membership inference attacks (MIAs) are widely used to assess the privacy risks associated with machine learning models. However, when these attacks are applied to pre-trained large language models (LLMs), they encounter significant challenges, including mislabeled samples, distribution shifts, and discrepancies in model size between experimental and real-world settings. To address these limitations, we introduce tokenizers as a new attack vector for membership inference. Specifically, a tokenizer converts raw text into tokens for LLMs. Unlike full models, tokenizers can be efficiently trained from scratch, thereby avoiding the aforementioned challenges. In addition, the tokenizer's training data is typically representative of the data used to pre-train LLMs. Despite these advantages, the potential of tokenizers as an attack vector remains unexplored. To this end, we present the first study on membership leakage through tokenizers and explore five attack methods to infer dataset membership. Extensive experiments on millions of Internet samples reveal the vulnerabilities in the tokenizers of state-of-the-art LLMs. To mitigate this emerging risk, we further propose an adaptive defense. Our findings highlight tokenizers as an overlooked yet critical privacy threat, underscoring the urgent need for privacy-preserving mechanisms specifically designed for them."},{"descriptionType":"Other","description":"To appear at USENIX Security Symposium 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05699","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:54:57Z","registered":"2025-10-08T01:54:57Z","published":null,"updated":"2026-05-26T04:04:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05942","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05942","identifiers":[{"identifier":"2510.05942","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hadi","familyName":"Mohammadi","name":"Mohammadi, Hadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anastasia","familyName":"Giachanou","name":"Giachanou, Anastasia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert A.","familyName":"Bagheri","name":"Bagheri, Robert A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EvalMORAAL: Interpretable Chain-of-Thought and LLM-as-Judge Evaluation for Moral Alignment in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T13:52:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:49:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T08:03:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-09T00:32:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-19T21:16:02Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-21T00:13:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present EvalMORAAL, a transparent chain-of-thought (CoT) framework that uses two scoring methods (log-probabilities and direct ratings) plus a model-as-judge peer review to evaluate moral alignment in 20 large language models. We assess models on the World Values Survey (55 countries, 19 topics) and the PEW Global Attitudes Survey (39 countries, 8 topics). With EvalMORAAL, top models align closely with survey responses (Pearson's $r \\approx 0.90$ on WVS). Yet we find a clear regional difference: Western regions average $r=0.82$ while non-Western regions average $r=0.61$ (a 0.21 absolute gap), indicating a persistent regional alignment gap. Our framework adds three parts: (1) two scoring methods for all models to enable fair comparison, (2) a structured CoT protocol with self-consistency checks, and (3) a model-as-judge peer review that flags 348 conflicts using a data-driven threshold. Peer agreement relates to WVS survey alignment ($r=0.74$, $p\u0026lt;.001$; PEW $r=0.39$, n.s.), supporting automated quality checks. These results show real progress toward culture-aware AI while highlighting open challenges for use across regions."},{"descriptionType":"Other","description":"Accepted as a poster at *SEM 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05942","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:00:40Z","registered":"2025-10-08T02:00:40Z","published":null,"updated":"2026-05-21T02:35:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05921","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05921","identifiers":[{"identifier":"2510.05921","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hsien-Chin","familyName":"Lin","name":"Lin, Hsien-Chin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin Matthias","familyName":"Ruppik","name":"Ruppik, Benjamin Matthias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carel","familyName":"van Niekerk","name":"van Niekerk, Carel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chia-Hao","familyName":"Shen","name":"Shen, Chia-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Heck","name":"Heck, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nurul","familyName":"Lubis","name":"Lubis, Nurul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renato","familyName":"Vukovic","name":"Vukovic, Renato","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shutong","familyName":"Feng","name":"Feng, Shutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milica","familyName":"Gašić","name":"Gašić, Milica","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prompt reinforcing for long-term planning of large language models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T13:30:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:48:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-09T10:26:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-10T00:44:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-17T12:12:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-19T01:08:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have achieved remarkable success in a wide range of natural language processing tasks and can be adapted through prompting. However, they remain suboptimal in multi-turn interactions, often relying on incorrect early assumptions and failing to track user goals over time, which makes such tasks particularly challenging. Prior works in dialogue systems have shown that long-term planning is essential for handling interactive tasks. In this work, we propose a prompt optimisation framework inspired by reinforcement learning, which enables such planning to take place by only modifying the task instruction prompt of the LLM-based agent. By generating turn-by-turn feedback and leveraging experience replay for prompt rewriting, our proposed method shows significant improvement in multi-turn tasks such as text-to-SQL and task-oriented dialogue. Moreover, it generalises across different LLM-based agents and can leverage diverse LLMs as meta-prompting agents. This warrants future research in reinforcement learning-inspired parameter-free optimisation methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05921","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:00:10Z","registered":"2025-10-08T02:00:10Z","published":null,"updated":"2026-05-19T04:48:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06719","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06719","identifiers":[{"identifier":"2510.06719","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junki","familyName":"Mori","name":"Mori, Junki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kazuya","familyName":"Kakizaki","name":"Kakizaki, Kazuya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taiki","familyName":"Miyagawa","name":"Miyagawa, Taiki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Sakuma","name":"Sakuma, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Differentially Private Synthetic Text Generation for Retrieval-Augmented Generation (RAG)"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T07:15:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:29:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T15:11:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-13T01:14:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-Augmented Generation (RAG) enhances large language models (LLMs) by grounding them in external knowledge. However, its application in sensitive domains is limited by privacy risks. Existing private RAG methods typically rely on query-time differential privacy (DP), which requires repeated noise injection and leads to accumulated privacy loss. To address this issue, we propose DP-SynRAG, a framework that uses LLMs to generate differentially private synthetic RAG databases. Unlike prior methods, the synthetic text can be reused once created, thereby avoiding repeated noise injection and additional privacy costs. To preserve essential information for downstream RAG tasks, DP-SynRAG extends private prediction, which instructs LLMs to generate text that mimics subsampled database records in a DP manner. Experiments show that DP-SynRAG achieves superior performance to the state-of-the-art private RAG systems while maintaining a fixed privacy budget, offering a scalable solution for privacy-preserving RAG."},{"descriptionType":"Other","description":"Accepted to ACL 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06719","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:52:51Z","registered":"2025-10-09T01:52:52Z","published":null,"updated":"2026-05-13T02:57:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05950","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05950","identifiers":[{"identifier":"2510.05950","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Songyuan","familyName":"Sui","name":"Sui, Songyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihang","familyName":"Xu","name":"Xu, Zihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xia","familyName":"Hu","name":"Hu, Xia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training-Free Time Series Classification via In-Context Reasoning with LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T14:07:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:50:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-30T21:41:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-04T00:11:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series classification (TSC) spans diverse application scenarios, yet labeled data are often scarce, making task-specific training costly and inflexible. Recent reasoning-oriented large language models (LLMs) show promise in understanding temporal patterns, but purely zero-shot usage remains suboptimal. We propose FETA, a multi-agent framework for training-free TSC via exemplar-based in-context reasoning. FETA decomposes a multivariate series into channel-wise subproblems, retrieves a few structurally similar labeled examples for each channel, and leverages a reasoning LLM to compare the query against these exemplars, producing channel-level labels with self-assessed confidences; a confidence-weighted aggregator then fuses all channel decisions. This design eliminates the need for pretraining or fine-tuning, improves efficiency by pruning irrelevant channels and controlling input length, and enhances interpretability through exemplar grounding and confidence estimation. On nine challenging UEA datasets, FETA achieves strong accuracy under a fully training-free setting, surpassing multiple trained baselines. These results demonstrate that a multi-agent in-context reasoning framework can transform LLMs into competitive, plug-and-play TSC solvers without any parameter training. The code is available at https://github.com/SongyuanSui/FETATSC."},{"descriptionType":"Other","description":"8 pages main content, 12 pages total including appendix, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05950","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:00:51Z","registered":"2025-10-08T02:00:52Z","published":null,"updated":"2026-05-04T01:54:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06700","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06700","identifiers":[{"identifier":"2510.06700","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leonardo","familyName":"Bertolazzi","name":"Bertolazzi, Leonardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sandro","familyName":"Pezzelle","name":"Pezzelle, Sandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raffaella","familyName":"Bernardi","name":"Bernardi, Raffaella","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Language Models Conflate Logical Validity with Plausibility: A Representational Analysis of Content Effects"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T06:48:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:28:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-26T09:31:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T02:18:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-20T07:21:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-21T01:46:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Both humans and large language models (LLMs) exhibit content effects: biases in which the plausibility of the semantic content of a reasoning problem influences judgments regarding its logical validity. While this phenomenon in humans is best explained by the dual-process theory of reasoning, the mechanisms behind content effects in LLMs remain unclear. In this work, we address this issue by investigating how LLMs encode the concepts of validity and plausibility within their internal representations. We show that both concepts are linearly represented and strongly aligned in representational geometry, leading models to conflate plausibility with validity. Using steering vectors, we demonstrate that plausibility vectors can causally bias validity judgements, and vice versa, and that the degree of alignment between these two concepts predicts the magnitude of behavioral content effects across models. Finally, we construct debiasing vectors that disentangle these concepts, reducing content effects and improving reasoning accuracy. Our findings advance understanding of how abstract logical concepts are represented in LLMs and highlight representational interventions as a path toward more logical systems."},{"descriptionType":"Other","description":"ACL 2026 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06700","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:52:24Z","registered":"2025-10-09T01:52:25Z","published":null,"updated":"2026-04-21T04:50:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07043","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07043","identifiers":[{"identifier":"2510.07043","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Qin","name":"Qin, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"Bai","name":"Bai, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting-Yao","familyName":"Hu","name":"Hu, Ting-Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raviteja","familyName":"Vemulapalli","name":"Vemulapalli, Raviteja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hema Swetha","familyName":"Koppula","name":"Koppula, Hema Swetha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyang","familyName":"Xu","name":"Xu, Zhiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Jin","name":"Jin, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mert","familyName":"Cemri","name":"Cemri, Mert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiarui","familyName":"Lu","name":"Lu, Jiarui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zirui","familyName":"Wang","name":"Wang, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Cao","name":"Cao, Meng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"COMPASS: Benchmarking Constrained Optimization in LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T14:09:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:50:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-16T19:10:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-20T00:05:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Human decision-making often involves constrained optimization. As LLM agents are deployed to assist with real-world tasks like travel planning, shopping, and scheduling, they must mirror this capability. We introduce COMPASS, a benchmark that evaluates whether LLM agents can perform constrained optimization in realistic travel planning settings. To success in these tasks, agents must engage in multi-turn conversations with user to gather task information as well as use tools to gather information from the database. Then agents must propose a solution that not only satisfies hard constraints but also optimizes user's utility objective. Evaluating state-of-the-art models, we reveal a significant feasible-optimal gap: while models achieve 70-90% feasibility (constraint satisfaction), they reach only 20-60% optimality (utility optimization). Our analysis shows that tool use is not the bottleneck. Instead, the core limitation is insufficient exploration of the search space, with success strongly correlating with information gathered. Coding agents show a promising approach to mitigate this gap. Together, COMPASS provides a testbed for developing LLM agents that can truly mirror human decision-making by both satisfying constraints and optimizing objectives."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07043","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:00:30Z","registered":"2025-10-09T02:00:31Z","published":null,"updated":"2026-04-20T02:09:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06499","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06499","identifiers":[{"identifier":"2510.06499","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhepeng","familyName":"Cen","name":"Cen, Zhepeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haolin","familyName":"Chen","name":"Chen, Haolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyu","familyName":"Wang","name":"Wang, Shiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuxin","familyName":"Liu","name":"Liu, Zuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Liu","name":"Liu, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jielin","familyName":"Qiu","name":"Qiu, Jielin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ding","familyName":"Zhao","name":"Zhao, Ding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvio","familyName":"Savarese","name":"Savarese, Silvio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caiming","familyName":"Xiong","name":"Xiong, Caiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Wang","name":"Wang, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiran","familyName":"Yao","name":"Yao, Weiran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Webscale-RL: Automated Data Pipeline for Scaling RL Data to Pretraining Levels"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T22:30:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:11:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-10T04:08:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-13T00:22:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have achieved remarkable success through imitation learning on vast text corpora, but this paradigm creates a training-generation gap and limits robust reasoning. Reinforcement learning (RL) offers a more data-efficient solution capable of bridging this gap, yet its application has been constrained by a critical data bottleneck: existing RL datasets are orders of magnitude smaller and less diverse than web-scale pre-training corpora. To address this, we introduce the Webscale-RL pipeline, a scalable data engine that systematically converts large-scale pre-training documents into millions of diverse, verifiable question-answer pairs for RL. Using this pipeline, we construct the Webscale-RL dataset, containing 1.2 million examples across more than 9 domains. Our experiments show that the model trained on this dataset significantly outperforms continual pretraining and strong data refinement baselines across a suite of benchmarks. Notably, RL training with our dataset proves substantially more efficient, achieving the performance of continual pre-training with up to 100$\\times$ fewer tokens. Our work presents a viable path toward scaling RL to pre-training levels, enabling more capable and efficient language models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06499","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:47:41Z","registered":"2025-10-09T01:47:42Z","published":null,"updated":"2026-04-13T02:08:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07310","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07310","identifiers":[{"identifier":"2510.07310","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyoon","familyName":"Jin","name":"Jin, Siyoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seongchan","familyName":"Kim","name":"Kim, Seongchan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dahyun","familyName":"Chung","name":"Chung, Dahyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeho","familyName":"Lee","name":"Lee, Jaeho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunwook","familyName":"Choi","name":"Choi, Hyunwook","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jisu","familyName":"Nam","name":"Nam, Jisu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiyoung","familyName":"Kim","name":"Kim, Jiyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungryong","familyName":"Kim","name":"Kim, Seungryong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MATRIX: Mask Track Alignment for Interaction-aware Video Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T17:57:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T01:04:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-07T17:55:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-08T01:13:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Video DiTs have advanced video generation, yet they still struggle to model multi-instance or subject-object interactions. This raises a key question: How do these models internally represent interactions? To answer this, we curate MATRIX-11K, a video dataset with interaction-aware captions and multi-instance mask tracks. Using this dataset, we conduct a systematic analysis that formalizes two perspectives of video DiTs: semantic grounding, via video-to-text attention, which evaluates whether noun and verb tokens capture instances and their relations; and semantic propagation, via video-to-video attention, which assesses whether instance bindings persist across frames. We find both effects concentrate in a small subset of interaction-dominant layers. Motivated by this, we introduce MATRIX, a simple and effective regularization that aligns attention in specific layers of video DiTs with multi-instance mask tracks from the MATRIX-11K dataset, enhancing both grounding and propagation. We further propose InterGenEval, an evaluation protocol for interaction-aware video generation. In experiments, MATRIX improves both interaction fidelity and semantic alignment while reducing drift and hallucination. Extensive ablations validate our design choices. Codes and weights will be released."},{"descriptionType":"Other","description":"Project Page is available at: https://cvlab-kaist.github.io/MATRIX/, ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07310","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:06:52Z","registered":"2025-10-09T02:06:53Z","published":null,"updated":"2026-04-08T02:31:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.08640","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.08640","identifiers":[{"identifier":"2510.08640","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ha Min","familyName":"Son","name":"Son, Ha Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Ren","name":"Ren, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Zhao","name":"Zhao, Zhe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automating Android Build Repair: Bridging the Reasoning-Execution Gap in LLM Agents with Domain-Specific Tools"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-09T01:33:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-13T00:01:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-19T18:46:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-20T02:04:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-01T19:05:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-03T00:03:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Android is the largest mobile platform, yet automatically building applications remains a practical challenge. While Large Language Models (LLMs) show promise for code repair, their use for fixing Android build errors remains underexplored. To address this gap, we first introduce AndroidBuildBench, a benchmark of 1,019 build failures curated from the commit histories of 43 open-source Android projects. Each problem is paired with a verified solution from a subsequent commit, ensuring that fixes are feasible. Second, we propose GradleFixer, an LLM agent with domain-specific tools for inspecting and manipulating the Gradle build environment. GradleFixer achieves a resolve rate of 81.4% (pass@1), significantly outperforming a state-of-the-art coding agent that relies on a general-purpose shell. GradleFixer's success suggests that while LLMs possess the high-level knowledge to solve these failures, they struggle to translate this knowledge into effective low-level actions using a general-purpose shell. We demonstrate the effectiveness of a strategy we term Tool Bridging, which replaces general-purpose shell commands with domain-aware abstractions. We hypothesize this approach works through two mechanisms: 1) it provides tools in an API-like format that LLMs use more reliably, and 2) it constrains the action space to relevant operations. This approach bridges the gap between the model's high-level reasoning and effective low-level execution."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.08640","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-13T01:41:10Z","registered":"2025-10-13T01:41:11Z","published":null,"updated":"2026-04-03T02:14:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06662","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06662","identifiers":[{"identifier":"2510.06662","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Penghao","familyName":"Yu","name":"Yu, Penghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Jiang","name":"Jiang, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Bao","name":"Bao, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoxi","familyName":"Yu","name":"Yu, Ruoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianxiao","familyName":"Li","name":"Li, Qianxiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Effect of Attention Head Count on Transformer Approximation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T05:27:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:25:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T07:14:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:33:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer has become the dominant architecture for sequence modeling, yet a detailed understanding of how its structural parameters influence expressive power remains limited. In this work, we study the approximation properties of transformers, with particular emphasis on the role of the number of attention heads. Our analysis begins with the introduction of a generalized $D$-retrieval task, which we prove to be dense in the space of continuous functions, thereby providing the basis for our theoretical framework. We then establish both upper and lower bounds on the parameter complexity required for $ε$-approximation. Specifically, we show that transformers with sufficiently many heads admit efficient approximation, whereas with too few heads, the number of parameters must scale at least as $O(1/ε^{cT})$, for some constant $c$ and sequence length $T$. To the best of our knowledge, this constitutes the first rigorous lower bound of this type in a nonlinear and practically relevant setting. We further examine the single-head case and demonstrate that an embedding dimension of order $O(T)$ allows complete memorization of the input, where approximation is entirely achieved by the feed-forward block. Finally, we validate our theoretical findings with experiments on both synthetic data and real-world tasks, illustrating the practical relevance of our results."},{"descriptionType":"Other","description":"Accepted by ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06662","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:51:30Z","registered":"2025-10-09T01:51:31Z","published":null,"updated":"2026-04-01T02:31:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06552","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06552","identifiers":[{"identifier":"2510.06552","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tarek","familyName":"Naous","name":"Naous, Tarek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philippe","familyName":"Laban","name":"Laban, Philippe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xu","name":"Xu, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"Neville","name":"Neville, Jennifer","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flipping the Dialogue: Training and Evaluating User Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T01:04:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:15:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-22T13:18:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-24T01:06:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Conversations with LMs involve two participants: a human user leading the conversation, and an LM assistant responding to the user's request. To satisfy this specific role, LMs are post-trained to be helpful assistants -- optimized to produce exhaustive and well-structured responses, free of ambiguity and grammar errors. User utterances, on the other hand, are rarely perfected, with each user phrasing requests in unique ways, sometimes putting in partial effort at each turn and refining on the fly. To evaluate LM performance in realistic settings, prior work simulated users in multi-turn conversations, often by prompting an LM originally trained to be a helpful assistant to act as a user. However, we show that assistant LMs make for poor user simulators, with the surprising finding that better assistants yield worse simulators. Instead, we introduce purpose-built User Language Models (User LMs) - models post-trained to simulate human users in multi-turn conversations. Through various evaluations, we show how User LMs align better with human behavior and achieve better simulation robustness than existing simulation methods. When leveraging User LMs to simulate coding and math conversations, the performance of a strong assistant (GPT-4o) drops from 74.6% to 57.4%, confirming that more realistic simulation environments lead to assistant struggles as they fail to cope with the nuances of users in multi-turn setups."},{"descriptionType":"Other","description":"Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06552","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:48:56Z","registered":"2025-10-09T01:48:56Z","published":null,"updated":"2026-03-24T04:17:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06107","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06107","identifiers":[{"identifier":"2510.06107","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gagan","familyName":"Bhatia","name":"Bhatia, Gagan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Somayajulu G","familyName":"Sripada","name":"Sripada, Somayajulu G","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Allan","name":"Allan, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacobo","familyName":"Azcona","name":"Azcona, Jacobo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distributional Semantics Tracing: A Framework for Explaining Hallucinations in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T16:40:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:58:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T18:51:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:04:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-15T15:37:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-17T01:24:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Hallucinations in large language models (LLMs) produce fluent continuations that are not supported by the prompt, especially under minimal contextual cues and ambiguity. We introduce Distributional Semantics Tracing (DST), a model-native method that builds layer-wise semantic maps at the answer position by decoding residual-stream states through the unembedding, selecting a compact top-$K$ concept set, and estimating directed concept-to-concept support via lightweight causal tracing. Using these traces, we test a representation-level hypothesis: hallucinations arise from correlation-driven representational drift across depth, where the residual stream is pulled toward a locally coherent but context-inconsistent concept neighborhood reinforced by training co-occurrences. On Racing Thoughts dataset, DST yields more faithful explanations than attribution, probing, and intervention baselines under an LLM-judge protocol, and the resulting Contextual Alignment Score (CAS) strongly predicts failures, supporting this drift hypothesis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06107","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:04:32Z","registered":"2025-10-08T02:04:32Z","published":null,"updated":"2026-03-17T04:56:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05748","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05748","identifiers":[{"identifier":"2510.05748","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hachem","familyName":"Madmoun","name":"Madmoun, Hachem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salem","familyName":"Lahlou","name":"Lahlou, Salem","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Communication Enables Cooperation in LLM Agents: A Comparison with Curriculum-Based Approaches"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T10:06:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:38:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-16T09:52:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-19T01:28:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-11T12:10:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-12T00:46:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Eliciting cooperation in multi-agent LLM systems is critical for AI alignment. We investigate two approaches: direct communication and curriculum learning. In a 4-player Stag Hunt, a one-word \"cheap talk\" channel increases cooperation from 0% to 96.7%, demonstrating communication as a robust coordination mechanism. In contrast, we find that curriculum learning is highly sensitive to design choices: our pedagogical curriculum through progressively complex games reduced agent payoffs by 27.4% in an Iterated Public Goods Game with Punishment, demonstrating that optimizing for short-term rationality can actively undermine alignment goals. Qualitative analysis reveals that curricula emphasizing defection-equilibrium games can induce \"learned pessimism\" in agents. These findings suggest that for coordination problems, simple communication protocols may be more reliable than experience-based training, and that curriculum design for social dilemmas requires careful attention to the strategic lessons embedded in game sequences."},{"descriptionType":"Other","description":"Published in EACL 2026 - Corrected cooperation rates for two-stage communication conditions (96.7% and 100.0%, previously reported as 48.3% and 50.0% due to a denominator bug in the evaluation code). All other results unchanged"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05748","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:56:05Z","registered":"2025-10-08T01:56:05Z","published":null,"updated":"2026-03-12T02:25:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06195","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06195","identifiers":[{"identifier":"2510.06195","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yen-Ju","familyName":"Lu","name":"Lu, Yen-Ju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashesh","familyName":"Gaur","name":"Gaur, Yashesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhou","name":"Zhou, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Muller","name":"Muller, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesus","familyName":"Villalba","name":"Villalba, Jesus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Najim","familyName":"Dehak","name":"Dehak, Najim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luke","familyName":"Zettlemoyer","name":"Zettlemoyer, Luke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gargi","familyName":"Ghosh","name":"Ghosh, Gargi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mike","familyName":"Lewis","name":"Lewis, Mike","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srinivasan","familyName":"Iyer","name":"Iyer, Srinivasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duc","familyName":"Le","name":"Le, Duc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Latent Speech-Text Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:52:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:03:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T19:57:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-11T00:07:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Auto-regressive speech-text models pre-trained on interleaved text tokens and discretized speech tokens demonstrate strong speech understanding and generation, yet remain substantially less compute-efficient than text LLMs, partly due to the much longer sequences of speech tokens relative to text. This modality imbalance disproportionately allocates pre-training and inference compute to speech, potentially hindering effective cross-modal alignment and slowing performance scaling by orders of magnitude. We introduce the Latent Speech-Text Transformer (LST), which aggregates speech tokens into latent speech patches that serve as higher-level autoregressive units. This design aligns the sequence-modeling granularity between speech and text while improving computational efficiency. The resulting patches can align with textual units to facilitate cross-modal knowledge transfer and compactly capture recurring acoustic patterns such as silence. Across story-completion benchmarks under both compute-controlled and data-controlled settings, LST consistently improves speech accuracy while also improving text performance, achieving up to +6.5% absolute gain on speech HellaSwag in compute-controlled training (+5.3% in data-controlled training). Under compute-controlled scaling from 420M to 1.8B parameters in a near compute-optimal regime, gains grow with scale, and improvements persist up to 7B parameters under fixed-token budgets. These benefits extend to downstream tasks: LST stabilizes ASR adaptation and reduces the effective autoregressive sequence length during ASR and TTS inference, lowering computational cost without degrading reconstruction quality. The code is available at https://github.com/facebookresearch/lst."},{"descriptionType":"Other","description":"Accepted to ICLR 2026 (Oral)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06195","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:06:36Z","registered":"2025-10-08T02:06:37Z","published":null,"updated":"2026-03-11T02:33:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07181","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07181","identifiers":[{"identifier":"2510.07181","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi","familyName":"Han","name":"Han, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enshen","familyName":"Zhou","name":"Zhou, Enshen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanyu","familyName":"Rong","name":"Rong, Shanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingkun","familyName":"An","name":"An, Jingkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengwei","familyName":"Wang","name":"Wang, Pengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyuan","familyName":"Wang","name":"Wang, Zhongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Chi","name":"Chi, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Sheng","name":"Sheng, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanghang","familyName":"Zhang","name":"Zhang, Shanghang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TIGeR: Tool-Integrated Geometric Reasoning in Vision-Language Models for Robotics"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T16:20:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:58:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T13:56:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:57:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-04T07:07:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-05T01:36:37Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) have shown remarkable capabilities in spatial reasoning, yet they remain fundamentally limited to qualitative precision and lack the computational precision required for real-world robotics. Current approaches fail to leverage metric cues from depth sensors and camera calibration, instead reducing geometric problems to pattern recognition tasks that cannot deliver the centimeter-level accuracy essential for robotic manipulation. We present TIGeR (Tool-Integrated Geometric Reasoning), a novel framework that transforms VLMs from perceptual estimators to geometric computers by enabling them to generate and execute precise geometric computations through external tools. Rather than attempting to internalize complex geometric operations within neural networks, TIGeR empowers models to recognize geometric reasoning requirements, synthesize appropriate computational code, and invoke specialized libraries for exact calculations. To support this paradigm, we introduce TIGeR-300K, a comprehensive tool-invocation-oriented dataset covering point transformations, pose estimation, and spatial compatibility verification, complete with tool invocation sequences and intermediate computations. Through a two-stage training pipeline combining supervised fine-tuning (SFT) and reinforcement fine-tuning (RFT) with our proposed hierarchical reward design, TIGeR achieves SOTA performance on geometric reasoning benchmarks while demonstrating centimeter-level precision in real-world robotic manipulation tasks."},{"descriptionType":"Other","description":"8 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07181","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:03:48Z","registered":"2025-10-09T02:03:48Z","published":null,"updated":"2026-03-05T03:44:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05684","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05684","identifiers":[{"identifier":"2510.05684","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suhwan","familyName":"Choi","name":"Choi, Suhwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeyoon","familyName":"Jung","name":"Jung, Jaeyoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haebin","familyName":"Seong","name":"Seong, Haebin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minchan","familyName":"Kim","name":"Kim, Minchan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minyeong","familyName":"Kim","name":"Kim, Minyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongjun","familyName":"Cho","name":"Cho, Yongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoonshik","familyName":"Kim","name":"Kim, Yoonshik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yubeen","familyName":"Park","name":"Park, Yubeen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youngjae","familyName":"Yu","name":"Yu, Youngjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunsung","familyName":"Lee","name":"Lee, Yunsung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"D2E: Scaling Vision-Action Pretraining on Desktop Data for Transfer to Embodied AI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T08:40:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:33:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-17T19:23:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-19T01:05:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-03T08:55:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-04T01:36:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models leverage internet-scale text data, yet embodied AI remains constrained by the prohibitive costs of physical trajectory collection. Desktop environments -- particularly gaming -- offer a compelling alternative: they provide rich sensorimotor interactions at scale while maintaining the structured observation-action coupling essential for embodied learning. We present D2E (Desktop to Embodied AI), a framework that demonstrates desktop interactions can serve as an effective pretraining substrate for robotics embodied AI tasks. Unlike prior work that remained domain-specific (e.g., VPT for Minecraft) or kept data proprietary (e.g., SIMA), D2E establishes a complete pipeline from scalable desktop data collection to verified transfer in embodied domains. Our framework comprises three components: (1) the OWA Toolkit that unifies diverse desktop interactions into a standardized format with 152x compression, (2) the Generalist-IDM that achieves strong zero-shot generalization across unseen games through timestamp-based event prediction, enabling internet-scale pseudo-labeling, and (3) VAPT that transfers desktop-pretrained representations to physical manipulation and navigation. Using 1.3K+ hours of data (259 hours of human demonstrations and 1K+ hours of pseudo-labeled gameplay), our 1B-parameter model achieves 96.6% success on LIBERO manipulation and 83.3% on CANVAS navigation, matching or surpassing models up to 7x larger, such as π_{0} (3.3B) and OpenVLA (7B). These results demonstrate that sensorimotor primitives learned from digital interactions transfer effectively to real-world physical tasks, establishing desktop pretraining as a practical paradigm for embodied AI. All resources are publicly available at https://worv-ai.github.io/d2e."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05684","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:54:36Z","registered":"2025-10-08T01:54:36Z","published":null,"updated":"2026-03-04T03:18:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06377","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06377","identifiers":[{"identifier":"2510.06377","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rishabh","familyName":"Ranjan","name":"Ranjan, Rishabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valter","familyName":"Hudovernik","name":"Hudovernik, Valter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Znidar","name":"Znidar, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charilaos","familyName":"Kanatsoulis","name":"Kanatsoulis, Charilaos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roshan","familyName":"Upendra","name":"Upendra, Roshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahmoud","familyName":"Mohammadi","name":"Mohammadi, Mahmoud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joe","familyName":"Meyer","name":"Meyer, Joe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Palczewski","name":"Palczewski, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos","familyName":"Guestrin","name":"Guestrin, Carlos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jure","familyName":"Leskovec","name":"Leskovec, Jure","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Relational Transformer: Toward Zero-Shot Foundation Models for Relational Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T18:51:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:04:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-22T22:13:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-24T00:10:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-02T07:22:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-03T02:45:55Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Pretrained transformers readily adapt to new sequence modeling tasks via zero-shot prompting, but relational domains still lack architectures that transfer across datasets and tasks. The core challenge is the diversity of relational data, with varying heterogeneous schemas, graph structures and functional dependencies. In this paper, we present the Relational Transformer (RT) architecture, which can be pretrained on diverse relational databases and directly applied to unseen datasets and tasks without task- or dataset-specific fine-tuning, or retrieval of in-context examples. RT (i) incorporates task specification via task table prompting, (ii) tokenizes cells with table/column metadata, (iii) is pretrained via masked token prediction, and (iv) utilizes a novel Relational Attention mechanism over columns, rows, and primary-foreign key links. Pretrained on RelBench datasets spanning tasks such as churn and sales forecasting, RT attains strong zero-shot performance, averaging 93% of fully supervised AUROC on binary classification tasks with a single forward pass of a 22M parameter model, as opposed to 84% for a 27B LLM. Fine-tuning yields state-of-the-art results with high sample efficiency. Our experimental analyses show that RT's zero-shot transfer leverages task context, relational attention patterns and schema semantics. Overall, RT provides a practical path toward foundation models for relational data. Code, models, data: https://github.com/snap-stanford/relational-transformer."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06377","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:44:53Z","registered":"2025-10-09T01:44:54Z","published":null,"updated":"2026-03-03T05:45:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06820","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06820","identifiers":[{"identifier":"2510.06820","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mitchell Keren","familyName":"Taraday","name":"Taraday, Mitchell Keren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shahaf","familyName":"Wagner","name":"Wagner, Shahaf","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaim","familyName":"Baskin","name":"Baskin, Chaim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Discriminative Joint Encoders for Large Scale Vision-Language Reranking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T09:46:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:37:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-22T12:55:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-24T01:49:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal retrieval still leans on embedding-based models like CLIP for fast vector search over pre-computed image embeddings. Yet, unlike text retrieval, where joint-encoder rerankers are standard, comparable vision-language rerankers are largely absent. We find that seminal joint encoders such as BLIP are severely bottlenecked by an expensive visual feature-extraction stage, preventing practical deployment at scale. Motivated by this bottleneck, we introduce EDJE, an Efficient Discriminative Joint Encoder that precomputes vision tokens offline and compresses them via a lightweight attention-based adapter, so online inference runs only a compact joint encoder over a small set of visual tokens plus the text. EDJE preserves strong retrieval performance while drastically reducing storage and online compute, enabling high-throughput inference. Specifically, EDJE processes 50k image--text pairs/second while requiring 49kB of disk storage per image, matching prior art on Flickr (zero-shot) and COCO (fine-tuned) retrieval."},{"descriptionType":"Other","description":"Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06820","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:55:12Z","registered":"2025-10-09T01:55:13Z","published":null,"updated":"2026-02-24T04:00:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06751","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06751","identifiers":[{"identifier":"2510.06751","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junhan","familyName":"Zhu","name":"Zhu, Junhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hesong","familyName":"Wang","name":"Wang, Hesong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingluo","familyName":"Su","name":"Su, Mingluo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zefang","familyName":"Wang","name":"Wang, Zefang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Wang","name":"Wang, Huan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OBS-Diff: Accurate Pruning For Diffusion Models in One-Shot"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T08:19:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:32:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-02T06:03:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-05T01:33:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-23T08:33:05Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-24T02:15:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-scale text-to-image diffusion models, while powerful, suffer from prohibitive computational cost. Existing one-shot network pruning methods can hardly be directly applied to them due to the iterative denoising nature of diffusion models. To bridge the gap, this paper presents OBS-Diff, a novel one-shot pruning framework that enables accurate and training-free compression of large-scale text-to-image diffusion models. Specifically, (i) OBS-Diff revitalizes the classic Optimal Brain Surgeon (OBS), adapting it to the complex architectures of modern diffusion models and supporting diverse pruning granularity, including unstructured, N:M semi-structured, and structured (MHA heads and FFN neurons) sparsity; (ii) To align the pruning criteria with the iterative dynamics of the diffusion process, by examining the problem from an error-accumulation perspective, we propose a novel timestep-aware Hessian construction that incorporates a logarithmic-decrease weighting scheme, assigning greater importance to earlier timesteps to mitigate potential error accumulation; (iii) Furthermore, a computationally efficient group-wise sequential pruning strategy is proposed to amortize the expensive calibration process. Extensive experiments show that OBS-Diff achieves state-of-the-art one-shot pruning for diffusion models, delivering inference acceleration with minimal degradation in visual quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06751","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:53:35Z","registered":"2025-10-09T01:53:36Z","published":null,"updated":"2026-02-24T04:00:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06419","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06419","identifiers":[{"identifier":"2510.06419","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mert","familyName":"Kayaalp","name":"Kayaalp, Mert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caner","familyName":"Turkmen","name":"Turkmen, Caner","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oleksandr","familyName":"Shchur","name":"Shchur, Oleksandr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Mercado","name":"Mercado, Pedro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdul Fatir","familyName":"Ansari","name":"Ansari, Abdul Fatir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Bohlke-Schneider","name":"Bohlke-Schneider, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bernie","familyName":"Wang","name":"Wang, Bernie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Efficient Pretrained Model Portfolios for Time Series Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T19:57:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:06:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-11T21:43:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-13T01:10:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Is bigger always better for time series foundation models? With the question in mind, we explore an alternative to training a single, large monolithic model: building a portfolio of smaller, pretrained forecasting models. By applying ensembling or model selection over these portfolios, we achieve competitive performance on large-scale benchmarks using much fewer parameters. We explore strategies for designing such portfolios and find that collections of specialist models consistently outperform portfolios of independently trained generalists. Remarkably, we demonstrate that post-training a base model is a compute-effective approach for creating sufficiently diverse specialists, and provide evidences that ensembling and model selection are more compute-efficient than test-time fine-tuning."},{"descriptionType":"Other","description":"Accepted as an ICLR 2026 conference paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06419","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:45:51Z","registered":"2025-10-09T01:45:51Z","published":null,"updated":"2026-02-13T03:21:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06548","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06548","identifiers":[{"identifier":"2510.06548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seng Pei","familyName":"Liew","name":"Liew, Seng Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takuya","familyName":"Kato","name":"Kato, Takuya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reusing Overtrained Language Models Saturates Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T00:59:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:15:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-03T04:23:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-04T01:30:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reusing pretrained base models for further pretraining, such as continual pretraining or model growth, is promising at reducing the cost of training language models from scratch. However, the effectiveness remains unclear, especially when applied to overtrained base models. In this work, we empirically study the scaling properties of model reuse and find that the scaling efficiency diminishes in a predictable manner: The scaling exponent with respect to second-stage training tokens decreases logarithmically with the number of tokens used to pretrain the base model.\n The joint dependence on first- and second-stage tokens is accurately modeled by a simple scaling law.\n Such saturation effect reveals a fundamental trade-off in multi-stage pretraining strategies: the more extensively a base model is pretrained, the less benefit additional pretraining provides.\n Our findings provide practical insights for efficient language model training and raise important considerations for the reuse of overtrained models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06548","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:48:50Z","registered":"2025-10-09T01:48:51Z","published":null,"updated":"2026-02-04T03:41:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05609","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05609","identifiers":[{"identifier":"2510.05609","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junwen","familyName":"Chen","name":"Chen, Junwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peilin","familyName":"Xiong","name":"Xiong, Peilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keiji","familyName":"Yanai","name":"Yanai, Keiji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HOI-R1: Exploring the Potential of Multimodal Large Language Models for Human-Object Interaction Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T06:16:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:27:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-01T03:07:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:59:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent human-object interaction detection (HOID) methods highly require prior knowledge from vision-language models (VLMs) to enhance the interaction recognition capabilities. The training strategies and model architectures for connecting the knowledge from VLMs to the HOI instance representations from the object detector are challenging, and the whole framework is complex for further development or application. On the other hand, the inherent reasoning abilities of multimodal large language models (MLLMs) on human-object interaction detection are under-explored. Inspired by the recent success of training MLLMs with reinforcement learning (RL) methods, we propose HOI-R1 and first explore the potential of the language model on the HOID task without any additional detection modules. We introduce an HOI reasoning process and HOID reward functions to solve the HOID task by pure text. Experiments on HICO-DET across multiple open-source MLLMs, including the Qwen-VL family (Qwen2.5-VL and Qwen3-VL) and Rex-Omni, show consistent improvements. Especially, HOI-R1 boosts Qwen2.5-VL-3B 2$\\times$ accuracy with great generalization ability. The source code is available at https://github.com/cjw2021/HOI-R1."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05609","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:52:52Z","registered":"2025-10-08T01:52:52Z","published":null,"updated":"2026-02-03T05:41:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.09665","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.09665","identifiers":[{"identifier":"2510.09665","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhan","familyName":"Liu","name":"Liu, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihua","familyName":"Cheng","name":"Cheng, Yihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Yao","name":"Yao, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuwei","familyName":"An","name":"An, Yuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaokun","familyName":"Chen","name":"Chen, Xiaokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoting","familyName":"Feng","name":"Feng, Shaoting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Huang","name":"Huang, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samuel","familyName":"Shen","name":"Shen, Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhang","name":"Zhang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuntai","familyName":"Du","name":"Du, Kuntai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junchen","familyName":"Jiang","name":"Jiang, Junchen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LMCache: An Efficient KV Cache Layer for Enterprise-Scale LLM Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T00:15:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T00:01:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-05T04:52:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-08T01:17:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"KV cache has traditionally been stored in GPU memory to accelerate the decoding phase of large language model (LLM) inference. However, it is increasingly necessary to move KV caches outside GPU devices, to enable cache reuse across different queries and inference engines. Our real-world usage statistics confirm this trend: over time, the total KV cache stored by users has grown rapidly, far exceeding the capacity of GPU memory. Despite this need, there lacks an efficient solution for offloading and transferring KV caches. We present LMCACHE, the first and so far the most efficient open-source KV caching solution, which extracts and stores KV caches generated by modern LLM engines (vLLM and SGLang) out of the GPU memory and shares them across engines and queries. LMCACHE supports both cache offloading (prefix reuse across queries) and prefill-decode (PD) disaggregation (cross-engine/GPU cache transfer). LMCACHE's high performance and wide adoption stem from the following contributions: (1) highly optimized KV cache data movement powered by batched data movement operations, compute and I/O pipelining; (2) a modular KV cache connector component, decoupling LMCACHE from the rapid evolution of inference engines; (3) a first-class control API for flexible cache orchestration across GPU, CPU, storage, and network layers. Our evaluation shows that combining LMCACHE with vLLM achieves up to 15x improvement in throughput across workloads such as multi-round question answering and document analysis. Large-scale adoption of LMCACHE in enterprise settings provides us valuable insights, for example, fetching KV cache from remote storage has unsurprisingly benefits to prefill delay, and that context truncation, which is a widely applied technique in industry, can greatly reduce prefix cache hit ratio by half. The source code of LMCACHE is at: https://github.com/LMCache/LMCache."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.09665","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-14T03:10:44Z","registered":"2025-10-14T03:10:45Z","published":null,"updated":"2025-12-08T02:47:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06783","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06783","identifiers":[{"identifier":"2510.06783","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akshit","familyName":"Singh","name":"Singh, Akshit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shyam","familyName":"Marjit","name":"Marjit, Shyam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Lin","name":"Lin, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Gavrikov","name":"Gavrikov, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Serena","familyName":"Yeung-Levy","name":"Yeung-Levy, Serena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hilde","familyName":"Kuehne","name":"Kuehne, Hilde","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rogerio","familyName":"Feris","name":"Feris, Rogerio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sivan","familyName":"Doveh","name":"Doveh, Sivan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Glass","name":"Glass, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. Jehanzeb","familyName":"Mirza","name":"Mirza, M. Jehanzeb","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TTRV: Test-Time Reinforcement Learning for Vision Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T09:10:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:35:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-04T13:17:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-05T01:41:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing methods for extracting reward signals in Reinforcement Learning typically rely on labeled data and dedicated training splits, a setup that contrasts with how humans learn directly from their environment. In this work, we propose TTRV to enhance vision language understanding by adapting the model on the fly at inference time, without the need for any labeled data. Concretely, we enhance the Group Relative Policy Optimization (GRPO) framework by designing rewards based on the frequency of the base model's output, while inferring on each test sample multiple times. Further, we also propose to control the diversity of the model's output by simultaneously rewarding the model for obtaining low entropy of the output empirical distribution. Our approach delivers consistent gains across both object recognition and visual question answering (VQA), with improvements of up to 52.4% and 29.8%, respectively, and average boosts of 24.6% and 10.0% across 16 datasets. Remarkably, on image recognition, TTRV applied to InternVL 8B surpasses GPT-4o by an average of 2.3% over 8 benchmarks, while remaining highly competitive on VQA, demonstrating that test-time reinforcement learning can match or exceed the strongest proprietary models. Finally, we find many interesting properties of test-time RL for VLMs: for example, even in extremely data-constrained scenarios, where adaptation is performed on a single randomly chosen unlabeled test example, TTRV still yields non-trivial improvements of up to 5.5% in recognition tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06783","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:54:20Z","registered":"2025-10-09T01:54:21Z","published":null,"updated":"2025-12-05T03:07:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06067","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06067","identifiers":[{"identifier":"2510.06067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Python","familyName":"Song","name":"Song, Python","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luke Tenyi","familyName":"Chang","name":"Chang, Luke Tenyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun-Yun","familyName":"Tsai","name":"Tsai, Yun-Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Penghui","familyName":"Li","name":"Li, Penghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfeng","familyName":"Yang","name":"Yang, Junfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reasoning under Vision: Understanding Visual-Spatial Cognition in Vision-Language Models for CAPTCHA"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T15:56:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:56:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-16T00:34:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T01:48:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"CAPTCHA, originally designed to distinguish humans from robots, has evolved into a real-world benchmark for assessing the spatial reasoning capabilities of vision-language models. In this work, we first show that step-by-step reasoning is crucial for vision-language models (VLMs) to solve CAPTCHAs, which represent high-difficulty spatial reasoning tasks, and that current commercial vision-language models still struggle with such reasoning. In particular, we observe that most commercial VLMs (e.g., Gemini, Claude, GPT, etc.) fail to effectively solve CAPTCHAs and thus achieve low accuracy (around 21.9 percent). However, our findings indicate that requiring the model to perform step-by-step reasoning before generating the final coordinates can significantly enhance its solving accuracy, underscoring the severity of the gap. To systematically study this issue, we introduce CAPTCHA-X, the first real-world CAPTCHA benchmark with reasoning, covering seven categories of CAPTCHAs (such as Gobang, hCaptcha, etc.) with step-by-step action solutions and grounding annotations. We further define five reasoning-oriented metrics that enable a comprehensive evaluation of models reasoning capabilities. To validate the effectiveness of reasoning, we also propose a general agentic VLM-based framework that incorporates the models inherent reasoning abilities. Our method achieves state-of-the-art performance across five high-difficulty CAPTCHA types, with an average solving accuracy of 83.9 percent, substantially surpassing existing baselines. These results reveal the limitations of current models and highlight the importance of reasoning in advancing visual-spatial challenges in the future."},{"descriptionType":"Other","description":"14pages, 11figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06067","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:03:36Z","registered":"2025-10-08T02:03:37Z","published":null,"updated":"2025-11-18T05:15:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05702","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05702","identifiers":[{"identifier":"2510.05702","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabrizio","familyName":"Dimino","name":"Dimino, Fabrizio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krati","familyName":"Saxena","name":"Saxena, Krati","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bhaskarjit","familyName":"Sarmah","name":"Sarmah, Bhaskarjit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Pasquali","name":"Pasquali, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncovering Representation Bias for Investment Decisions in Open-Source Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Finance (q-fin.CP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T09:10:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:34:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-03T01:00:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T02:09:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models are increasingly adopted in financial applications to support investment workflows. However, prior studies have seldom examined how these models reflect biases related to firm size, sector, or financial characteristics, which can significantly impact decision-making. This paper addresses this gap by focusing on representation bias in open-source Qwen models. We propose a balanced round-robin prompting method over approximately 150 U.S. equities, applying constrained decoding and token-logit aggregation to derive firm-level confidence scores across financial contexts. Using statistical tests and variance analysis, we find that firm size and valuation consistently increase model confidence, while risk factors tend to decrease it. Confidence varies significantly across sectors, with the Technology sector showing the greatest variability. When models are prompted for specific financial categories, their confidence rankings best align with fundamental data, moderately with technical signals, and least with growth indicators. These results highlight representation bias in Qwen models and motivate sector-aware calibration and category-conditioned evaluation protocols for safe and fair financial LLM deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05702","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:55:01Z","registered":"2025-10-08T01:55:02Z","published":null,"updated":"2025-11-04T04:57:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07230","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07230","identifiers":[{"identifier":"2510.07230","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyi","familyName":"Wang","name":"Wang, Ziyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Lu","name":"Lu, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yimeng","familyName":"Zhang","name":"Zhang, Yimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Huang","name":"Huang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dakuo","familyName":"Wang","name":"Wang, Dakuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Customer-R1: Personalized Simulation of Human Behaviors via RL-based LLM Agent in Online Shopping"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T17:00:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T01:00:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-18T04:00:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-21T00:19:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Simulating step-wise human behavior with Large Language Models (LLMs) has become an emerging research direction, enabling applications in various practical domains. While prior methods, including prompting, supervised fine-tuning (SFT), and reinforcement learning (RL), have shown promise in modeling step-wise behavior, they primarily learn a population-level policy without conditioning on a user's persona, yielding generic rather than personalized simulations. In this work, we pose a critical question: how can LLM agents better simulate personalized user behavior? We introduce Customer-R1, an RL-based method for personalized, step-wise user behavior simulation in online shopping environments. Our policy is conditioned on an explicit persona, and we optimize next-step rationale and action generation via action correctness reward signals. Experiments on the OPeRA dataset emonstrate that Customer-R1 not only significantly outperforms prompting and SFT-based baselines in next-action prediction tasks, but also better matches users' action distribution, indicating higher fidelity in personalized behavior simulation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07230","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:04:57Z","registered":"2025-10-09T02:04:58Z","published":null,"updated":"2025-10-21T03:42:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.14992","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.14992","identifiers":[{"identifier":"2510.14992","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leela","familyName":"Krishna","name":"Krishna, Leela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengyang","familyName":"Zhao","name":"Zhao, Mengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saicharithreddy","familyName":"Pasula","name":"Pasula, Saicharithreddy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshit","familyName":"Rajgarhia","name":"Rajgarhia, Harshit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Mukherji","name":"Mukherji, Abhishek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GAZE:Governance-Aware pre-annotation for Zero-shot World Model Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T21:13:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-20T00:00:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training robust world models requires large-scale, precisely labeled multimodal datasets, a process historically bottlenecked by slow and expensive manual annotation. We present a production-tested GAZE pipeline that automates the conversion of raw, long-form video into rich, task-ready supervision for world-model training. Our system (i) normalizes proprietary 360-degree formats into standard views and shards them for parallel processing; (ii) applies a suite of AI models (scene understanding, object tracking, audio transcription, PII/NSFW/minor detection) for dense, multimodal pre-annotation; and (iii) consolidates signals into a structured output specification for rapid human validation.\n The GAZE workflow demonstrably yields efficiency gains (~19 minutes saved per review hour) and reduces human review volume by \u0026gt;80% through conservative auto-skipping of low-salience segments. By increasing label density and consistency while integrating privacy safeguards and chain-of-custody metadata, our method generates high-fidelity, privacy-aware datasets directly consumable for learning cross-modal dynamics and action-conditioned prediction. We detail our orchestration, model choices, and data dictionary to provide a scalable blueprint for generating high-quality world model training data without sacrificing throughput or governance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.14992","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-20T01:31:47Z","registered":"2025-10-20T01:31:48Z","published":null,"updated":"2025-10-20T01:31:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.08625","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.08625","identifiers":[{"identifier":"2510.08625","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeonggeun","familyName":"Han","name":"Han, Hyeonggeun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sehwan","familyName":"Kim","name":"Kim, Sehwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyungjun","familyName":"Joo","name":"Joo, Hyungjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangwoo","familyName":"Hong","name":"Hong, Sangwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwoo","familyName":"Lee","name":"Lee, Jungwoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adjusting Initial Noise to Mitigate Memorization in Text-to-Image Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T10:37:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-13T00:01:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite their impressive generative capabilities, text-to-image diffusion models often memorize and replicate training data, prompting serious concerns over privacy and copyright. Recent work has attributed this memorization to an attraction basin-a region where applying classifier-free guidance (CFG) steers the denoising trajectory toward memorized outputs-and has proposed deferring CFG application until the denoising trajectory escapes this basin. However, such delays often result in non-memorized images that are poorly aligned with the input prompts, highlighting the need to promote earlier escape so that CFG can be applied sooner in the denoising process. In this work, we show that the initial noise sample plays a crucial role in determining when this escape occurs. We empirically observe that different initial samples lead to varying escape times. Building on this insight, we propose two mitigation strategies that adjust the initial noise-either collectively or individually-to find and utilize initial samples that encourage earlier basin escape. These approaches significantly reduce memorization while preserving image-text alignment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.08625","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-13T01:40:49Z","registered":"2025-10-13T01:40:50Z","published":null,"updated":"2025-10-13T01:40:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07737","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07737","identifiers":[{"identifier":"2510.07737","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fu","familyName":"Chen","name":"Chen, Fu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyin","familyName":"Li","name":"Li, Xiyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wen","familyName":"Li","name":"Li, Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shichi","familyName":"Lei","name":"Lei, Shichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongdong","familyName":"Xiang","name":"Xiang, Dongdong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ToolExpander: Extending the Frontiers of Tool-Using Reinforcement Learning to Weak LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-09T03:20:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-10T00:25:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training Large Language Models (LLMs) with Group Relative Policy Optimization (GRPO) encounters a significant challenge: models often fail to produce accurate responses, particularly in small-scale architectures. This limitation not only diminishes performance improvements and undermines the potential of GRPO but also frequently leads to mid-training collapse, adversely affecting stability and final efficacy. To address these issues, we propose ToolExpander, a novel framework that advances tool-oriented reinforcement learning for resource-constrained LLMs through two key innovations:(1) Dynamic Multi-Round Hard Sampling, which dynamically substitutes challenging samples(those without correct outputs over 10 rollouts) with high-quality few-shot demonstrations during training, coupled with an exponential learning rate decay strategy to mitigate oscillations;(2) Self-Exemplifying Thinking, an enhanced GRPO framework that eliminates KL divergence and incorporates adjusted clipping coefficients, encouraging models to autonomously generate and analyze few-shot examples via a minimal additional reward (0.01).Experimental results demonstrate that ToolExpander significantly enhances tool-using capabilities in LLMs, especially in weaker small-scale models, improving both training stability and overall performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07737","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-10T02:04:50Z","registered":"2025-10-10T02:04:50Z","published":null,"updated":"2025-10-10T02:04:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07567","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07567","identifiers":[{"identifier":"2510.07567","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Karuna","familyName":"Bhaila","name":"Bhaila, Karuna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aneesh","familyName":"Komanduri","name":"Komanduri, Aneesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minh-Hao","familyName":"Van","name":"Van, Minh-Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xintao","familyName":"Wu","name":"Wu, Xintao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cross-Modal Attention Guided Unlearning in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T21:21:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-10T00:11:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) have demonstrated immense capabilities in multi-modal understanding and inference tasks such as Visual Question Answering (VQA), which requires models to infer outputs based on visual and textual context simultaneously. Such inference abilities of large-scale pretrained models are often attributed to the massive scale of pre-training data collected across several domains. However, the models may memorize private and/or sensitive information during training and regurgitate it in inference. Recently, machine unlearning has been leveraged to address the leakage of private data in LLMs. VLMs add a layer of complexity to this process, as the visual context in the query may also contain sensitive information in addition to the text. To address this issue, we explore unlearning for vision-language models, specifically for the VQA task. We explore the role of visual tokens for output generation in VLMs using cross-modal attention and utilize it to formulate Cross-Modal Attention Guided Unlearning (CAGUL), a lightweight and efficient VLM unlearning framework. In contrast to computationally expensive model finetuning methods, CAGUL utilizes external modules to encode unlearning information in visual tokens of low importance for relevant queries. We find that the transformed visual tokens not only prevent leakage but also retain reference model behavior. Experimental results show that our method performs better or on par with finetuning-based baselines without altering the pre-trained model parameters or incurring retraining costs, making it a practical and effective unlearning solution for VLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07567","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-10T02:00:44Z","registered":"2025-10-10T02:00:45Z","published":null,"updated":"2025-10-10T02:00:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07345","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07345","identifiers":[{"identifier":"2510.07345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Danush Kumar","familyName":"Venkatesh","name":"Venkatesh, Danush Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Schmidt","name":"Schmidt, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Abdullah","familyName":"Jamal","name":"Jamal, Muhammad Abdullah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omid","familyName":"Mohareri","name":"Mohareri, Omid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Surgical Data Imbalance with Dual-Prediction Video Diffusion Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T20:29:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-10T00:00:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Surgical video datasets are essential for scene understanding, enabling procedural modeling and intra-operative support. However, these datasets are often heavily imbalanced, with rare actions and tools under-represented, which limits the robustness of downstream models. We address this challenge with $SurgiFlowVid$, a sparse and controllable video diffusion framework for generating surgical videos of under-represented classes. Our approach introduces a dual-prediction diffusion module that jointly denoises RGB frames and optical flow, providing temporal inductive biases to improve motion modeling from limited samples. In addition, a sparse visual encoder conditions the generation process on lightweight signals (e.g., sparse segmentation masks or RGB frames), enabling controllability without dense annotations. We validate our approach on three surgical datasets across tasks including action recognition, tool presence detection, and laparoscope motion prediction. Synthetic data generated by our method yields consistent gains of 10-20% over competitive baselines, establishing $SurgiFlowVid$ as a promising strategy to mitigate data imbalance and advance surgical video understanding methods."},{"descriptionType":"Other","description":"29 pages, 16 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-10T01:55:18Z","registered":"2025-10-10T01:55:21Z","published":null,"updated":"2025-10-10T01:55:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07313","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07313","identifiers":[{"identifier":"2510.07313","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zezhong","familyName":"Qian","name":"Qian, Zezhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowei","familyName":"Chi","name":"Chi, Xiaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuming","familyName":"Li","name":"Li, Yuming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shizun","familyName":"Wang","name":"Wang, Shizun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Qin","name":"Qin, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaozhu","familyName":"Ju","name":"Ju, Xiaozhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirui","familyName":"Han","name":"Han, Sirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanghang","familyName":"Zhang","name":"Zhang, Shanghang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WristWorld: Generating Wrist-Views via 4D World Models for Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T17:59:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T01:04:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Wrist-view observations are crucial for VLA models as they capture fine-grained hand-object interactions that directly enhance manipulation performance. Yet large-scale datasets rarely include such recordings, resulting in a substantial gap between abundant anchor views and scarce wrist views. Existing world models cannot bridge this gap, as they require a wrist-view first frame and thus fail to generate wrist-view videos from anchor views alone. Amid this gap, recent visual geometry models such as VGGT emerge with geometric and cross-view priors that make it possible to address extreme viewpoint shifts. Inspired by these insights, we propose WristWorld, the first 4D world model that generates wrist-view videos solely from anchor views. WristWorld operates in two stages: (i) Reconstruction, which extends VGGT and incorporates our Spatial Projection Consistency (SPC) Loss to estimate geometrically consistent wrist-view poses and 4D point clouds; (ii) Generation, which employs our video generation model to synthesize temporally coherent wrist-view videos from the reconstructed perspective. Experiments on Droid, Calvin, and Franka Panda demonstrate state-of-the-art video generation with superior spatial consistency, while also improving VLA performance, raising the average task completion length on Calvin by 3.81% and closing 42.4% of the anchor-wrist view gap."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07313","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:06:56Z","registered":"2025-10-09T02:06:57Z","published":null,"updated":"2025-10-09T02:06:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07206","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07206","identifiers":[{"identifier":"2510.07206","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shirin","familyName":"Shoushtari","name":"Shoushtari, Shirin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wang","name":"Wang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Shi","name":"Shi, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. Salman","familyName":"Asif","name":"Asif, M. Salman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ulugbek S.","familyName":"Kamilov","name":"Kamilov, Ulugbek S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EigenScore: OOD Detection using Covariance in Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T16:42:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:59:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Out-of-distribution (OOD) detection is critical for the safe deployment of machine learning systems in safety-sensitive domains. Diffusion models have recently emerged as powerful generative models, capable of capturing complex data distributions through iterative denoising. Building on this progress, recent work has explored their potential for OOD detection. We propose EigenScore, a new OOD detection method that leverages the eigenvalue spectrum of the posterior covariance induced by a diffusion model. We argue that posterior covariance provides a consistent signal of distribution shift, leading to larger trace and leading eigenvalues on OOD inputs, yielding a clear spectral signature. We further provide analysis explicitly linking posterior covariance to distribution mismatch, establishing it as a reliable signal for OOD detection. To ensure tractability, we adopt a Jacobian-free subspace iteration method to estimate the leading eigenvalues using only forward evaluations of the denoiser. Empirically, EigenScore achieves SOTA performance, with up to 5% AUROC improvement over the best baseline. Notably, it remains robust in near-OOD settings such as CIFAR-10 vs CIFAR-100, where existing diffusion-based methods often fail."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07206","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:04:23Z","registered":"2025-10-09T02:04:23Z","published":null,"updated":"2025-10-09T02:04:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07190","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07190","identifiers":[{"identifier":"2510.07190","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yihao","familyName":"Zhi","name":"Zhi, Yihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenghong","familyName":"Li","name":"Li, Chenghong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjie","familyName":"Liao","name":"Liao, Hongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xihe","familyName":"Yang","name":"Yang, Xihe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengwentai","familyName":"Sun","name":"Sun, Zhengwentai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahao","familyName":"Chang","name":"Chang, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Cun","name":"Cun, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wensen","familyName":"Feng","name":"Feng, Wensen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoguang","familyName":"Han","name":"Han, Xiaoguang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MV-Performer: Taming Video Diffusion Model for Faithful and Synchronized Multi-view Performer Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T16:24:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:58:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent breakthroughs in video generation, powered by large-scale datasets and diffusion techniques, have shown that video diffusion models can function as implicit 4D novel view synthesizers. Nevertheless, current methods primarily concentrate on redirecting camera trajectory within the front view while struggling to generate 360-degree viewpoint changes. In this paper, we focus on human-centric subdomain and present MV-Performer, an innovative framework for creating synchronized novel view videos from monocular full-body captures. To achieve a 360-degree synthesis, we extensively leverage the MVHumanNet dataset and incorporate an informative condition signal. Specifically, we use the camera-dependent normal maps rendered from oriented partial point clouds, which effectively alleviate the ambiguity between seen and unseen observations. To maintain synchronization in the generated videos, we propose a multi-view human-centric video diffusion model that fuses information from the reference video, partial rendering, and different viewpoints. Additionally, we provide a robust inference procedure for in-the-wild video cases, which greatly mitigates the artifacts induced by imperfect monocular depth estimation. Extensive experiments on three datasets demonstrate our MV-Performer's state-of-the-art effectiveness and robustness, setting a strong model for human-centric 4D novel view synthesis."},{"descriptionType":"Other","description":"Accepted by SIGGRAPH Asia 2025 conference track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07190","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:04:00Z","registered":"2025-10-09T02:04:01Z","published":null,"updated":"2025-10-09T02:04:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07176","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07176","identifiers":[{"identifier":"2510.07176","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yixiang","familyName":"Zhang","name":"Zhang, Yixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinhao","familyName":"Deng","name":"Deng, Xinhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyi","familyName":"Gu","name":"Gu, Zhongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihao","familyName":"Chen","name":"Chen, Yihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ke","familyName":"Xu","name":"Xu, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Li","name":"Li, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianping","familyName":"Wu","name":"Wu, Jianping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exposing LLM User Privacy via Traffic Fingerprint Analysis: A Study of Privacy Risks in LLM Agent Interactions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T16:16:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:57:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly deployed as agents that orchestrate tasks and integrate external tools to execute complex workflows. We demonstrate that these interactive behaviors leave distinctive fingerprints in encrypted traffic exchanged between users and LLM agents. By analyzing traffic patterns associated with agent workflows and tool invocations, adversaries can infer agent activities, distinguish specific agents, and even profile sensitive user attributes. To highlight this risk, we develop AgentPrint, which achieves an F1-score of 0.866 in agent identification and attains 73.9% and 69.1% top-3 accuracy in user attribute inference for simulated- and real-user settings, respectively. These results uncover an overlooked risk: the very interactivity that empowers LLM agents also exposes user privacy, underscoring the urgent need for technical countermeasures alongside regulatory and policy safeguards."},{"descriptionType":"Other","description":"26 pages with 11 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07176","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:03:40Z","registered":"2025-10-09T02:03:41Z","published":null,"updated":"2025-10-09T02:03:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07134","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07134","identifiers":[{"identifier":"2510.07134","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahang","familyName":"Liu","name":"Liu, Jiahang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunpeng","familyName":"Qi","name":"Qi, Yunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiazhao","familyName":"Zhang","name":"Zhang, Jiazhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghan","familyName":"Li","name":"Li, Minghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoan","familyName":"Wang","name":"Wang, Shaoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kui","familyName":"Wu","name":"Wu, Kui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanjing","familyName":"Ye","name":"Ye, Hanjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Zhang","name":"Zhang, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibo","familyName":"Chen","name":"Chen, Zhibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fangwei","familyName":"Zhong","name":"Zhong, Fangwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizheng","familyName":"Zhang","name":"Zhang, Zhizheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Wang","name":"Wang, He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TrackVLA++: Unleashing Reasoning and Memory Capabilities in VLA Models for Embodied Visual Tracking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T15:29:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:55:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Embodied Visual Tracking (EVT) is a fundamental ability that underpins practical applications, such as companion robots, guidance robots and service assistants, where continuously following moving targets is essential. Recent advances have enabled language-guided tracking in complex and unstructured scenes. However, existing approaches lack explicit spatial reasoning and effective temporal memory, causing failures under severe occlusions or in the presence of similar-looking distractors. To address these challenges, we present TrackVLA++, a novel Vision-Language-Action (VLA) model that enhances embodied visual tracking with two key modules, a spatial reasoning mechanism and a Target Identification Memory (TIM). The reasoning module introduces a Chain-of-Thought paradigm, termed Polar-CoT, which infers the target's relative position and encodes it as a compact polar-coordinate token for action prediction. Guided by these spatial priors, the TIM employs a gated update strategy to preserve long-horizon target memory, ensuring spatiotemporal consistency and mitigating target loss during extended occlusions. Extensive experiments show that TrackVLA++ achieves state-of-the-art performance on public benchmarks across both egocentric and multi-camera settings. On the challenging EVT-Bench DT split, TrackVLA++ surpasses the previous leading approach by 5.1 and 12, respectively. Furthermore, TrackVLA++ exhibits strong zero-shot generalization, enabling robust real-world tracking in dynamic and occluded scenarios."},{"descriptionType":"Other","description":"Project page: https://pku-epic.github.io/TrackVLA-plus-plus-Web/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07134","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:02:40Z","registered":"2025-10-09T02:02:41Z","published":null,"updated":"2025-10-09T02:02:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07081","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07081","identifiers":[{"identifier":"2510.07081","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fanheng","familyName":"Kong","name":"Kong, Fanheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyuan","familyName":"Zhang","name":"Zhang, Jingyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yahui","familyName":"Liu","name":"Liu, Yahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zirui","familyName":"Wu","name":"Wu, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Tian","name":"Tian, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victoria","familyName":"W.","name":"W., Victoria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guorui","familyName":"Zhou","name":"Zhou, Guorui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating Diffusion LLM Inference via Local Determinism Propagation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T14:39:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:51:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion large language models (dLLMs) represent a significant advancement in text generation, offering parallel token decoding capabilities. However, existing open-source implementations suffer from quality-speed trade-offs that impede their practical deployment. Conservative sampling strategies typically decode only the most confident token per step to ensure quality (i.e., greedy decoding), at the cost of inference efficiency due to repeated redundant refinement iterations--a phenomenon we term delayed decoding. Through systematic analysis of dLLM decoding dynamics, we characterize this delayed decoding behavior and propose a training-free adaptive parallel decoding strategy, named LocalLeap, to address these inefficiencies. LocalLeap is built on two fundamental empirical principles: local determinism propagation centered on high-confidence anchors and progressive spatial consistency decay. By applying these principles, LocalLeap identifies anchors and performs localized relaxed parallel decoding within bounded neighborhoods, achieving substantial inference step reduction through early commitment of already-determined tokens without compromising output quality. Comprehensive evaluation on various benchmarks demonstrates that LocalLeap achieves 6.94$\\times$ throughput improvements and reduces decoding steps to just 14.2\\% of the original requirement, achieving these gains with negligible performance impact. The source codes are available at: https://github.com/friedrichor/LocalLeap."},{"descriptionType":"Other","description":"21 pages, 4 figures. Under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07081","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:01:25Z","registered":"2025-10-09T02:01:26Z","published":null,"updated":"2025-10-09T02:01:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.07067","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.07067","identifiers":[{"identifier":"2510.07067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daria","familyName":"Pugacheva","name":"Pugacheva, Daria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrey","familyName":"Moskalenko","name":"Moskalenko, Andrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Denis","familyName":"Shepelev","name":"Shepelev, Denis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrey","familyName":"Kuznetsov","name":"Kuznetsov, Andrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vlad","familyName":"Shakhuro","name":"Shakhuro, Vlad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elena","familyName":"Tutubalina","name":"Tutubalina, Elena","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bring the Apple, Not the Sofa: Impact of Irrelevant Context in Embodied AI Commands on VLA Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T14:31:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:51:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision Language Action (VLA) models are widely used in Embodied AI, enabling robots to interpret and execute language instructions. However, their robustness to natural language variability in real-world scenarios has not been thoroughly investigated. In this work, we present a novel systematic study of the robustness of state-of-the-art VLA models under linguistic perturbations. Specifically, we evaluate model performance under two types of instruction noise: (1) human-generated paraphrasing and (2) the addition of irrelevant context. We further categorize irrelevant contexts into two groups according to their length and their semantic and lexical proximity to robot commands. In this study, we observe consistent performance degradation as context size expands. We also demonstrate that the model can exhibit relative robustness to random context, with a performance drop within 10%, while semantically and lexically similar context of the same length can trigger a quality decline of around 50%. Human paraphrases of instructions lead to a drop of nearly 20%. To mitigate this, we propose an LLM-based filtering framework that extracts core commands from noisy inputs. Incorporating our filtering step allows models to recover up to 98.5% of their original performance under noisy conditions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.07067","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T02:01:05Z","registered":"2025-10-09T02:01:06Z","published":null,"updated":"2025-10-09T02:01:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06699","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06699","identifiers":[{"identifier":"2510.06699","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gal","familyName":"Fadlon","name":"Fadlon, Gal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Idan","familyName":"Arbiv","name":"Arbiv, Idan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nimrod","familyName":"Berman","name":"Berman, Nimrod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omri","familyName":"Azencot","name":"Azencot, Omri","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Diffusion Model for Regular Time Series Generation from Irregular Data with Completion and Masking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T06:47:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:28:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating realistic time series data is critical for applications in healthcare, finance, and science. However, irregular sampling and missing values present significant challenges. While prior methods address these irregularities, they often yield suboptimal results and incur high computational costs. Recent advances in regular time series generation, such as the diffusion-based ImagenTime model, demonstrate strong, fast, and scalable generative capabilities by transforming time series into image representations, making them a promising solution. However, extending ImagenTime to irregular sequences using simple masking introduces \"unnatural\" neighborhoods, where missing values replaced by zeros disrupt the learning process. To overcome this, we propose a novel two-step framework: first, a Time Series Transformer completes irregular sequences, creating natural neighborhoods; second, a vision-based diffusion model with masking minimizes dependence on the completed values. This approach leverages the strengths of both completion and masking, enabling robust and efficient generation of realistic time series. Our method achieves state-of-the-art performance, achieving a relative improvement in discriminative score by $70\\%$ and in computational cost by $85\\%$. Code is at https://github.com/azencot-group/ImagenI2R."},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025; The first two authors contributed equally and are co-leading authors"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06699","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:52:23Z","registered":"2025-10-09T01:52:23Z","published":null,"updated":"2025-10-09T01:52:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06680","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06680","identifiers":[{"identifier":"2510.06680","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhipeng","familyName":"Liu","name":"Liu, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peibo","familyName":"Duan","name":"Duan, Peibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Tang","name":"Tang, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baixin","familyName":"Li","name":"Li, Baixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongsheng","familyName":"Huang","name":"Huang, Yongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyang","familyName":"Geng","name":"Geng, Mingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changsheng","familyName":"Zhang","name":"Zhang, Changsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zhang","name":"Zhang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binwu","familyName":"Wang","name":"Wang, Binwu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TimeFormer: Transformer with Attention Modulation Empowered by Temporal Characteristics for Time Series Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T06:07:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:26:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Although Transformers excel in natural language processing, their extension to time series forecasting remains challenging due to insufficient consideration of the differences between textual and temporal modalities. In this paper, we develop a novel Transformer architecture designed for time series data, aiming to maximize its representational capacity. We identify two key but often overlooked characteristics of time series: (1) unidirectional influence from the past to the future, and (2) the phenomenon of decaying influence over time. These characteristics are introduced to enhance the attention mechanism of Transformers. We propose TimeFormer, whose core innovation is a self-attention mechanism with two modulation terms (MoSA), designed to capture these temporal priors of time series under the constraints of the Hawkes process and causal masking. Additionally, TimeFormer introduces a framework based on multi-scale and subsequence analysis to capture semantic dependencies at different temporal scales, enriching the temporal dependencies. Extensive experiments conducted on multiple real-world datasets show that TimeFormer significantly outperforms state-of-the-art methods, achieving up to a 7.45% reduction in MSE compared to the best baseline and setting new benchmarks on 94.04\\% of evaluation metrics. Moreover, we demonstrate that the MoSA mechanism can be broadly applied to enhance the performance of other Transformer-based models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06680","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:51:56Z","registered":"2025-10-09T01:51:56Z","published":null,"updated":"2025-10-09T01:51:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06673","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06673","identifiers":[{"identifier":"2510.06673","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongxin","familyName":"Zhu","name":"Zhu, Yongxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Chen","name":"Chen, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanzhe","familyName":"Chen","name":"Chen, Yuanzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuo","familyName":"Chen","name":"Chen, Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongya","familyName":"Jia","name":"Jia, Dongya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Cong","name":"Cong, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobin","familyName":"Zhuang","name":"Zhuang, Xiaobin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuping","familyName":"Wang","name":"Wang, Yuping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wang","name":"Wang, Yuxuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Heptapod: Language Modeling on Visual Signals"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T05:54:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:26:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Heptapod, an image autoregressive model that adheres to the foundational principles of language modeling. Heptapod employs \\textbf{causal attention}, \\textbf{eliminates reliance on CFG}, and \\textbf{eschews the trend of semantic tokenizers}. Our key innovation is \\textit{next 2D distribution prediction}: a causal Transformer with reconstruction-focused visual tokenizer, learns to predict the distribution over the entire 2D spatial grid of images at each timestep. This learning objective unifies the sequential modeling of autoregressive framework with the holistic self-supervised learning of masked autoencoding, enabling the model to capture comprehensive image semantics via generative training. On the ImageNet generation benchmark, Heptapod achieves an FID of $2.70$, significantly outperforming previous causal autoregressive approaches. We hope our work inspires a principled rethinking of language modeling on visual signals and beyond."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06673","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:51:46Z","registered":"2025-10-09T01:51:47Z","published":null,"updated":"2025-10-09T01:51:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06652","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06652","identifiers":[{"identifier":"2510.06652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shangjian","familyName":"Yin","name":"Yin, Shangjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhepei","familyName":"Wei","name":"Wei, Zhepei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Zhu","name":"Zhu, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei-Lin","familyName":"Chen","name":"Chen, Wei-Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Meng","name":"Meng, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aligning Large Language Models via Fully Self-Synthetic Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-08T05:07:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:25:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Traditional reinforcement learning from human feedback (RLHF) for large language models (LLMs) relies on expensive human-annotated datasets, while Reinforcement Learning from AI Feedback (RLAIF) also incurs significant costs, requiring the collection of diverse prompts and corresponding responses, often necessitating external reward models or proprietary models like GPT-4 to annotate preference pairs. In this work, we introduce Self-Alignment Optimization (SAO), a fully self-synthetic framework for LLM alignment, where all training data, including prompts (i.e., user queries), responses, and preferences, are generated by the model itself. Specifically, SAO first instructs the LLM to engage in persona role-play and generate diverse prompts and responses, which are then self-evaluated for preference optimization. Extensive experiments demonstrate that SAO effectively enhances the model's chat capabilities on standard benchmarks like AlpacaEval~2.0, while maintaining strong performance on downstream objective tasks (e.g., question-answering, math reasoning). Our work provides a practical solution for self-improvement in aligning LLMs, and the code for reproducing our results is available at: https://github.com/SJY8460/SAO."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06652","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:51:17Z","registered":"2025-10-09T01:51:18Z","published":null,"updated":"2025-10-09T01:51:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06475","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06475","identifiers":[{"identifier":"2510.06475","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yitao","familyName":"Long","name":"Long, Yitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuru","familyName":"Jiang","name":"Jiang, Yuru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjun","familyName":"Liu","name":"Liu, Hongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilun","familyName":"Zhao","name":"Zhao, Yilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingchen","familyName":"Sun","name":"Sun, Jingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiqiu","familyName":"Shen","name":"Shen, Yiqiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Zhao","name":"Zhao, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arman","familyName":"Cohan","name":"Cohan, Arman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dennis","familyName":"Shasha","name":"Shasha, Dennis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PuzzlePlex: Benchmarking Foundation Models on Reasoning and Planning with Puzzles"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T21:24:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:10:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This work investigates the reasoning and planning capabilities of foundation models and their scalability in complex, dynamic environments. We introduce PuzzlePlex, a benchmark designed to assess these capabilities through a diverse set of puzzles. PuzzlePlex consists of 15 types of puzzles, including deterministic and stochastic games of varying difficulty, as well as single-player and two-player scenarios. The PuzzlePlex framework provides a comprehensive environment for each game, and supports extensibility to generate more challenging instances as foundation models evolve. Additionally, we implement customized game-playing strategies for comparison. Building on this benchmark, we develop fine-grained metrics to measure performance and conduct an in-depth analysis of frontier foundation models across two settings: instruction-based and code-based. Furthermore, we systematically investigate their scaling limits. Our findings show that reasoning models outperform others in instruction-based settings, while code-based execution presents greater challenges but offers a scalable and efficient alternative. PuzzlePlex enables targeted evaluation and guides future improvements in reasoning, planning, and generalization for foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06475","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:47:09Z","registered":"2025-10-09T01:47:10Z","published":null,"updated":"2025-10-09T01:47:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06430","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06430","identifiers":[{"identifier":"2510.06430","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Neeraja","familyName":"Kirtane","name":"Kirtane, Neeraja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuvraj","familyName":"Khanna","name":"Khanna, Yuvraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Relan","name":"Relan, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MathRobust-LV: Evaluation of Large Language Models' Robustness to Linguistic Variations in Mathematical Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T20:09:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:07:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models excel on math benchmarks, but their math reasoning robustness to linguistic variation is underexplored. While recent work increasingly treats high-difficulty competitions like the IMO as the gold standard for evaluating reasoning, we believe in comprehensive benchmarking of high school-level math problems in real educational settings. We introduce MathRobust-LV, a test set and evaluation methodology that mirrors how instructors rephrase problems across assessments while keeping difficulty constant: we change surface details (names, contexts, variables) while preserving numerical structure and answers. In contrast to prior efforts that alter problem content or emphasize IMO-level tasks, we focus on high-school-level dataset problems at the difficulty level where models are currently deployed in educational settings: tutoring and assessment systems. In these applications, instructors rephrase identical concepts in varied ways, making linguistic robustness essential for reliable deployment. Although MATH data benchmarking is often regarded as saturated, our experiment on 34 models reveals that accuracy declines when moving from the baseline to the variants. These drops are severe for smaller models (9-11%) while stronger models also show measurable degradation. Frontier models like GPT-5, Gemini-2.5pro remain comparatively stable. Our results highlight that robustness to linguistic variation is a fundamental challenge, exposing reasoning vulnerabilities in models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06430","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:46:06Z","registered":"2025-10-09T01:46:06Z","published":null,"updated":"2025-10-09T01:46:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06308","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06308","identifiers":[{"identifier":"2510.06308","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi","familyName":"Xin","name":"Xin, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Qin","name":"Qin, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Luo","name":"Luo, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiwen","familyName":"Zhu","name":"Zhu, Kaiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juncheng","familyName":"Yan","name":"Yan, Juncheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Tai","name":"Tai, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Lei","name":"Lei, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuewen","familyName":"Cao","name":"Cao, Yuewen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keqi","familyName":"Wang","name":"Wang, Keqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yibin","familyName":"Wang","name":"Wang, Yibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinbin","familyName":"Bai","name":"Bai, Jinbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Yu","name":"Yu, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dengyang","familyName":"Jiang","name":"Jiang, Dengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuandong","familyName":"Pu","name":"Pu, Yuandong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxing","familyName":"Chen","name":"Chen, Haoxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Zhuo","name":"Zhuo, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjun","familyName":"He","name":"He, Junjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gen","familyName":"Luo","name":"Luo, Gen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianbin","familyName":"Li","name":"Li, Tianbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Hu","name":"Hu, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Ye","name":"Ye, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenglong","familyName":"Ye","name":"Ye, Shenglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zhang","name":"Zhang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Xu","name":"Xu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhai","familyName":"Wang","name":"Wang, Wenhai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongsheng","familyName":"Li","name":"Li, Hongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangtao","familyName":"Zhai","name":"Zhai, Guangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianfan","familyName":"Xue","name":"Xue, Tianfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Fu","name":"Fu, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohong","familyName":"Liu","name":"Liu, Xiaohong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Qiao","name":"Qiao, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihao","familyName":"Liu","name":"Liu, Yihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lumina-DiMOO: An Omni Diffusion Large Language Model for Multi-Modal Generation and Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:59:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-09T00:02:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Lumina-DiMOO, an open-source foundational model for seamless multi-modal generation and understanding. Lumina-DiMOO sets itself apart from prior unified models by utilizing a fully discrete diffusion modeling to handle inputs and outputs across various modalities. This innovative approach allows Lumina-DiMOO to achieve higher sampling efficiency compared to previous autoregressive (AR) or hybrid AR-Diffusion paradigms and adeptly support a broad spectrum of multi-modal tasks, including text-to-image generation, image-to-image generation (e.g., image editing, subject-driven generation, and image inpainting, etc.), as well as image understanding. Lumina-DiMOO achieves state-of-the-art performance on multiple benchmarks, surpassing existing open-source unified multi-modal models. To foster further advancements in multi-modal and discrete diffusion model research, we release our code and checkpoints to the community. Project Page: https://synbol.github.io/Lumina-DiMOO."},{"descriptionType":"Other","description":"33 pages, 13 figures, 10 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06308","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-09T01:43:16Z","registered":"2025-10-09T01:43:17Z","published":null,"updated":"2025-10-09T01:43:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06209","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06209","identifiers":[{"identifier":"2510.06209","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahao","familyName":"Wang","name":"Wang, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenpei","familyName":"Yang","name":"Yang, Zhenpei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijing","familyName":"Bai","name":"Bai, Yijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingwei","familyName":"Li","name":"Li, Yingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuliang","familyName":"Zou","name":"Zou, Yuliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Sun","name":"Sun, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhijit","familyName":"Kundu","name":"Kundu, Abhijit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose","familyName":"Lezama","name":"Lezama, Jose","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luna Yue","familyName":"Huang","name":"Huang, Luna Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehao","familyName":"Zhu","name":"Zhu, Zehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jyh-Jing","familyName":"Hwang","name":"Hwang, Jyh-Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dragomir","familyName":"Anguelov","name":"Anguelov, Dragomir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingxing","familyName":"Tan","name":"Tan, Mingxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chiyu Max","familyName":"Jiang","name":"Jiang, Chiyu Max","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Drive\u0026amp;Gen: Co-Evaluating End-to-End Driving and Video Generation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:58:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:03:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in generative models have sparked exciting new possibilities in the field of autonomous vehicles. Specifically, video generation models are now being explored as controllable virtual testing environments. Simultaneously, end-to-end (E2E) driving models have emerged as a streamlined alternative to conventional modular autonomous driving systems, gaining popularity for their simplicity and scalability. However, the application of these techniques to simulation and planning raises important questions. First, while video generation models can generate increasingly realistic videos, can these videos faithfully adhere to the specified conditions and be realistic enough for E2E autonomous planner evaluation? Second, given that data is crucial for understanding and controlling E2E planners, how can we gain deeper insights into their biases and improve their ability to generalize to out-of-distribution scenarios? In this work, we bridge the gap between the driving models and generative world models (Drive\u0026amp;Gen) to address these questions. We propose novel statistical measures leveraging E2E drivers to evaluate the realism of generated videos. By exploiting the controllability of the video generation model, we conduct targeted experiments to investigate distribution gaps affecting E2E planner performance. Finally, we show that synthetic data produced by the video generation model offers a cost-effective alternative to real-world data collection. This synthetic data effectively improves E2E model generalization beyond existing Operational Design Domains, facilitating the expansion of autonomous vehicle services into new operational contexts."},{"descriptionType":"Other","description":"Accepted by IROS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06209","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:06:56Z","registered":"2025-10-08T02:06:57Z","published":null,"updated":"2025-10-08T02:06:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06175","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06175","identifiers":[{"identifier":"2510.06175","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dingyu","familyName":"Yao","name":"Yao, Dingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxu","familyName":"Yang","name":"Yang, Chenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengyang","familyName":"Tong","name":"Tong, Zhengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Lin","name":"Lin, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Liu","name":"Liu, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Luan","name":"Luan, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiping","familyName":"Wang","name":"Wang, Weiping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VecInfer: Efficient LLM Inference with Low-Bit KV Cache via Outlier-Suppressed Vector Quantization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:35:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Key-Value (KV) cache introduces substantial memory overhead during large language model (LLM) inference. Although existing vector quantization (VQ) methods reduce KV cache usage and provide flexible representational capacity across bit-widths, they suffer severe performance degradation at ultra-low bit-widths due to key cache outliers that hinder effective codebook utilization. To address this challenge, we propose VecInfer, a novel VQ method for aggressive KV cache compression while enabling efficient inference. By applying smooth and Hadamard transformations, VecInfer suppresses outliers in the key cache, enabling the codebook to comprehensively cover the original data distribution and thereby reducing quantization difficulty. To facilitate efficient deployment, we design an optimized CUDA kernel that fuses computation with dequantization to minimize memory access overhead. Extensive evaluations demonstrate that VecInfer consistently outperforms existing quantization baselines across both long-context understanding and mathematical reasoning tasks. With only 2-bit quantization, VecInfer achieves performance comparable to full precision, while delivering up to $\\mathbf{2.7\\times}$ speedup in large-batch self-attention computation and $\\mathbf{8.3\\times}$ reduction in single-batch end-to-end latency on Llama-3.1-8B with a 196k sequence length."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06175","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:06:07Z","registered":"2025-10-08T02:06:08Z","published":null,"updated":"2025-10-08T02:06:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06174","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06174","identifiers":[{"identifier":"2510.06174","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nathan X.","familyName":"Kodama","name":"Kodama, Nathan X.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Hinczewski","name":"Hinczewski, Michael","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Thermodynamic Performance Limits for Score-Based Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistical Mechanics (cond-mat.stat-mech)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:35:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:01:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We establish a fundamental connection between score-based diffusion models and non-equilibrium thermodynamics by deriving performance limits based on entropy rates. Our main theoretical contribution is a lower bound on the negative log-likelihood of the data that relates model performance to entropy rates of diffusion processes. We numerically validate this bound on a synthetic dataset and investigate its tightness. By building a bridge to entropy rates - system, intrinsic, and exchange entropy - we provide new insights into the thermodynamic operation of these models, drawing parallels to Maxwell's demon and implications for thermodynamic computing hardware. Our framework connects generative modeling performance to fundamental physical principles through stochastic thermodynamics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06174","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:06:06Z","registered":"2025-10-08T02:06:07Z","published":null,"updated":"2025-10-08T02:06:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06131","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06131","identifiers":[{"identifier":"2510.06131","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiawei","familyName":"Mao","name":"Mao, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Wang","name":"Wang, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifeng","familyName":"Chen","name":"Chen, Lifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Zhao","name":"Zhao, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yucheng","familyName":"Tang","name":"Tang, Yucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yang","name":"Yang, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangqiong","familyName":"Qu","name":"Qu, Liangqiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daguang","familyName":"Xu","name":"Xu, Daguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyin","familyName":"Zhou","name":"Zhou, Yuyin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discrete Diffusion Models with MLLMs for Unified Medical Multimodal Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:06:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T01:00:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in generative medical models are constrained by modality-specific scenarios that hinder the integration of complementary evidence from imaging, pathology, and clinical notes. This fragmentation limits their evolution into foundation models that can learn and reason across the full spectrum of biomedical data. We propose MeDiM, the first medical discrete diffusion model that learns shared distributions across modalities without modality-specific components. MeDiM unifies multiple generative tasks: translating between images and text, and jointly producing image-report pairs across domains in response to prompts. Built on a discrete diffusion framework, MeDiM bridges vision and language representations through a shared probabilistic space. To enable unified and flexible medical generation, we employ a multimodal large language model (MLLM) as the diffusion backbone, leveraging its prior knowledge and cross-modal reasoning. Two key designs are introduced: (1) removing the causal attention mask for bidirectional context, and (2) injecting continuous timestep embeddings for diffusion awareness. Experiments demonstrate high-fidelity medical generation (FID 16.60 on MIMIC-CXR and FID 24.19 on PathGen) and accurate report generation (METEOR 0.2650 and 0.2580). Jointly generated image-report pairs further enhance downstream performance (plus6.43 percent BLEU-1, plus18.57 percent BLEU-2, plus31.58 percent BLEU-3, plus4.80 percent METEOR), showing that MeDiM supports coherent and clinically grounded multimodal outputs."},{"descriptionType":"Other","description":"16 pages,6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06131","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:05:05Z","registered":"2025-10-08T02:05:05Z","published":null,"updated":"2025-10-08T02:05:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06126","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06126","identifiers":[{"identifier":"2510.06126","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoxin","familyName":"Wang","name":"Wang, Haoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolong","familyName":"Tu","name":"Tu, Xiaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Ke","name":"Ke, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huirong","familyName":"Chai","name":"Chai, Huirong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Chen","name":"Chen, Dawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyungtae","familyName":"Han","name":"Han, Kyungtae","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"lm-Meter: Unveiling Runtime Inference Latency for On-Device Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Performance (cs.PF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T17:05:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:59:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3769012.3770614","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly integrated into everyday applications, but their prevalent cloud-based deployment raises growing concerns around data privacy and long-term sustainability. Running LLMs locally on mobile and edge devices (on-device LLMs) offers the promise of enhanced privacy, reliability, and reduced communication costs. However, realizing this vision remains challenging due to substantial memory and compute demands, as well as limited visibility into performance-efficiency trade-offs on resource-constrained hardware. We propose lm-Meter, the first lightweight, online latency profiler tailored for on-device LLM inference. lm-Meter captures fine-grained, real-time latency at both phase (e.g., embedding, prefill, decode, softmax, sampling) and kernel levels without auxiliary devices. We implement lm-Meter on commercial mobile platforms and demonstrate its high profiling accuracy with minimal system overhead, e.g., only 2.58% throughput reduction in prefill and 0.99% in decode under the most constrained Powersave governor. Leveraging lm-Meter, we conduct comprehensive empirical studies revealing phase- and kernel-level bottlenecks in on-device LLM inference, quantifying accuracy-efficiency trade-offs, and identifying systematic optimization opportunities. lm-Meter provides unprecedented visibility into the runtime behavior of LLMs on constrained platforms, laying the foundation for informed optimization and accelerating the democratization of on-device LLM systems. Code and tutorials are available at https://github.com/amai-gsu/LM-Meter."},{"descriptionType":"Other","description":"This is the preprint version of the paper accepted to The 10th ACM/IEEE Symposium on Edge Computing (SEC 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06126","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-08T02:04:58Z","registered":"2025-10-08T02:04:58Z","published":null,"updated":"2025-10-08T02:04:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06101","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06101","identifiers":[{"identifier":"2510.06101","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Muyu","familyName":"He","name":"He, Muyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Ali","familyName":"Shafique","name":"Shafique, Muhammad Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anand","familyName":"Kumar","name":"Kumar, Anand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsach","familyName":"Mackey","name":"Mackey, Tsach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nazneen","familyName":"Rajani","name":"Rajani, Nazneen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Valley of Code Reasoning: Scaling Knowledge Distillation of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T16:32:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:58:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Distilling the thinking traces of a Large Language Model (LLM) with reasoning capabilities into a smaller model has been proven effective. Yet, there is a scarcity of work done on how model performances scale with the quantity of distillation data. In this work, we study the scaling trend of distilling competitive coding skills on two small non-reasoning LLMs. We validate the hypothesis that there is a $\\textit{valley of code reasoning}$: downstream performance on competitive coding first drops as data quantity increases, then it steadily increases in a sharper-than-log-linear fashion. Having identified the trend, we further fine-tune the models at two different distillation stages on the same data to ground conclusions on their respective learning phases. We learn that across stages in the low and medium-low data regimes, small models benefit significantly from easier coding questions than from harder ones. We also find that, surprisingly, the correctness of outputs in training data makes no difference to distillation outcomes. Our work represents a step forward in understanding the training dynamics of code reasoning distillation outside intuition"},{"descriptionType":"Other","description":"NeurIPS 2025 Workshop on Deep Learning for Code (DL4C), Project page: https://collinear.ai/valley-of-reasoning"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06101","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:04:24Z","registered":"2025-10-08T02:04:24Z","published":null,"updated":"2025-10-08T02:04:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06070","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06070","identifiers":[{"identifier":"2510.06070","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Meghna P","familyName":"Ayyar","name":"Ayyar, Meghna P","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jenny","familyName":"Benois-Pineau","name":"Benois-Pineau, Jenny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akka","familyName":"Zemmari","name":"Zemmari, Akka","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"There is More to Attention: Statistical Filtering Enhances Explanations in Vision Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T15:59:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:56:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Explainable AI (XAI) has become increasingly important with the rise of large transformer models, yet many explanation methods designed for CNNs transfer poorly to Vision Transformers (ViTs). Existing ViT explanations often rely on attention weights, which tend to yield noisy maps as they capture token-to-token interactions within each layer.While attribution methods incorporating MLP blocks have been proposed, we argue that attention remains a valuable and interpretable signal when properly filtered. We propose a method that combines attention maps with a statistical filtering, initially proposed for CNNs, to remove noisy or uninformative patterns and produce more faithful explanations. We further extend our approach with a class-specific variant that yields discriminative explanations. Evaluation against popular state-of-the-art methods demonstrates that our approach produces sharper and more interpretable maps. In addition to perturbation-based faithfulness metrics, we incorporate human gaze data to assess alignment with human perception, arguing that human interpretability remains essential for XAI. Across multiple datasets, our approach consistently outperforms or is comparable to the SOTA methods while remaining efficient and human plausible."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06070","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":6,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:03:41Z","registered":"2025-10-08T02:03:42Z","published":null,"updated":"2025-10-08T02:03:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.06035","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.06035","identifiers":[{"identifier":"2510.06035","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ondřej","familyName":"Týbl","name":"Týbl, Ondřej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukáš","familyName":"Neumann","name":"Neumann, Lukáš","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Universal Neural Architecture Space: Covering ConvNets, Transformers and Everything in Between"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T15:31:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:55:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Universal Neural Architecture Space (UniNAS), a generic search space for neural architecture search (NAS) which unifies convolutional networks, transformers, and their hybrid architectures under a single, flexible framework. Our approach enables discovery of novel architectures as well as analyzing existing architectures in a common framework. We also propose a new search algorithm that allows traversing the proposed search space, and demonstrate that the space contains interesting architectures, which, when using identical training setup, outperform state-of-the-art hand-crafted architectures. Finally, a unified toolkit including a standardized training and evaluation protocol is introduced to foster reproducibility and enable fair comparison in NAS research. Overall, this work opens a pathway towards systematically exploring the full spectrum of neural architectures with a unified graph-based NAS perspective."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.06035","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:02:51Z","registered":"2025-10-08T02:02:52Z","published":null,"updated":"2025-10-08T02:02:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05943","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05943","identifiers":[{"identifier":"2510.05943","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zheyue","familyName":"Tan","name":"Tan, Zheyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mustapha","familyName":"Abdullahi","name":"Abdullahi, Mustapha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tuo","familyName":"Shi","name":"Shi, Tuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huining","familyName":"Yuan","name":"Yuan, Huining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zelai","familyName":"Xu","name":"Xu, Zelai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Yu","name":"Yu, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boxun","familyName":"Li","name":"Li, Boxun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zhao","name":"Zhao, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EARL: Efficient Agentic Reinforcement Learning Systems for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T13:52:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:49:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) has become a pivotal component of large language model (LLM) post-training, and agentic RL extends this paradigm to operate as agents through multi-turn interaction and tool use. Scaling such systems exposes two practical bottlenecks: (1) context length grows rapidly during training, inflating memory usage and latency, and triggering out-of-memory (OOM) failures; and (2) intermediate tensors accumulate with context length, making cross-device data movement a major system bottleneck.\n We present EARL, a scalable system for efficient agentic RL. EARL designs a parallelism selector that dynamically adapts model and training parallelism across RL stages based on sequence length and system load, and a data dispatcher that performs layout-aware, decentralized exchange of intermediate data batches. Together, these components increase throughput, reduce long-context failures, and enable stable large-scale training of agentic LLMs without relying on hard limits or penalties of context length."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05943","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T02:00:41Z","registered":"2025-10-08T02:00:42Z","published":null,"updated":"2025-10-08T02:00:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05865","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05865","identifiers":[{"identifier":"2510.05865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lorenzo","familyName":"Baraldi","name":"Baraldi, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zifan","familyName":"Zeng","name":"Zeng, Zifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chongzhe","familyName":"Zhang","name":"Zhang, Chongzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aradhana","familyName":"Nayak","name":"Nayak, Aradhana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbo","familyName":"Zhu","name":"Zhu, Hongbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Liu","name":"Liu, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qunli","familyName":"Zhang","name":"Zhang, Qunli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiming","familyName":"Liu","name":"Liu, Shiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Hu","name":"Hu, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angelo","familyName":"Cangelosi","name":"Cangelosi, Angelo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo","familyName":"Baraldi","name":"Baraldi, Lorenzo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Safety Challenge of World Models for Embodied AI Agents: A Review"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T12:35:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:44:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid progress in embodied artificial intelligence has highlighted the necessity for more advanced and integrated models that can perceive, interpret, and predict environmental dynamics. In this context, World Models (WMs) have been introduced to provide embodied agents with the abilities to anticipate future environmental states and fill in knowledge gaps, thereby enhancing agents' ability to plan and execute actions. However, when dealing with embodied agents it is fundamental to ensure that predictions are safe for both the agent and the environment. In this article, we conduct a comprehensive literature review of World Models in the domains of autonomous driving and robotics, with a specific focus on the safety implications of scene and control generation tasks. Our review is complemented by an empirical analysis, wherein we collect and examine predictions from state-of-the-art models, identify and categorize common faults (herein referred to as pathologies), and provide a quantitative evaluation of the results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05865","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:58:49Z","registered":"2025-10-08T01:58:50Z","published":null,"updated":"2025-10-08T01:58:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05827","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05827","identifiers":[{"identifier":"2510.05827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoran","familyName":"Zhang","name":"Zhang, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuanghao","familyName":"Bai","name":"Bai, Shuanghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanqi","familyName":"Zhou","name":"Zhou, Wanqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuedi","familyName":"Zhang","name":"Zhang, Yuedi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhang","name":"Zhang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Ding","name":"Ding, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Chi","name":"Chi, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donglin","familyName":"Wang","name":"Wang, Donglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Badong","familyName":"Chen","name":"Chen, Badong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VCoT-Grasp: Grasp Foundation Models with Visual Chain-of-Thought Reasoning for Language-driven Grasp Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T11:50:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:42:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Robotic grasping is one of the most fundamental tasks in robotic manipulation, and grasp detection/generation has long been the subject of extensive research. Recently, language-driven grasp generation has emerged as a promising direction due to its practical interaction capabilities. However, most existing approaches either lack sufficient reasoning and generalization capabilities or depend on complex modular pipelines. Moreover, current grasp foundation models tend to overemphasize dialog and object semantics, resulting in inferior performance and restriction to single-object grasping. To maintain strong reasoning ability and generalization in cluttered environments, we propose VCoT-Grasp, an end-to-end grasp foundation model that incorporates visual chain-of-thought reasoning to enhance visual understanding for grasp generation. VCoT-Grasp adopts a multi-turn processing paradigm that dynamically focuses on visual inputs while providing interpretable reasoning traces. For training, we refine and introduce a large-scale dataset, VCoT-GraspSet, comprising 167K synthetic images with over 1.36M grasps, as well as 400+ real-world images with more than 1.2K grasps, annotated with intermediate bounding boxes. Extensive experiments on both VCoT-GraspSet and real robot demonstrate that our method significantly improves grasp success rates and generalizes effectively to unseen objects, backgrounds, and distractors. More details can be found at https://zhanghr2001.github.io/VCoT-Grasp.github.io."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05827","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:57:55Z","registered":"2025-10-08T01:57:56Z","published":null,"updated":"2025-10-08T01:57:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05715","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05715","identifiers":[{"identifier":"2510.05715","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shihao","familyName":"Zhu","name":"Zhu, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bohan","familyName":"Cao","name":"Cao, Bohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziheng","familyName":"Ouyang","name":"Ouyang, Ziheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Li","name":"Li, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng-Tao","familyName":"Jiang","name":"Jiang, Peng-Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qibin","familyName":"Hou","name":"Hou, Qibin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgeBooth: Controllable Facial Aging and Rejuvenation via Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T09:25:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:35:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent diffusion model research focuses on generating identity-consistent images from a reference photo, but they struggle to accurately control age while preserving identity, and fine-tuning such models often requires costly paired images across ages. In this paper, we propose AgeBooth, a novel age-specific finetuning approach that can effectively enhance the age control capability of adapterbased identity personalization models without the need for expensive age-varied datasets. To reduce dependence on a large amount of age-labeled data, we exploit the linear nature of aging by introducing age-conditioned prompt blending and an age-specific LoRA fusion strategy that leverages SVDMix, a matrix fusion technique. These techniques enable high-quality generation of intermediate-age portraits. Our AgeBooth produces realistic and identity-consistent face images across different ages from a single reference image. Experiments show that AgeBooth achieves superior age control and visual quality compared to previous state-of-the-art editing-based methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05715","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:55:19Z","registered":"2025-10-08T01:55:20Z","published":null,"updated":"2025-10-08T01:55:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05691","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05691","identifiers":[{"identifier":"2510.05691","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongqi","familyName":"Leng","name":"Leng, Yongqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikun","familyName":"Lei","name":"Lei, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xikai","familyName":"Liu","name":"Liu, Xikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meizhi","familyName":"Zhong","name":"Zhong, Meizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojian","familyName":"Xiong","name":"Xiong, Bojian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yurong","familyName":"Zhang","name":"Zhang, Yurong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Gao","name":"Gao, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wu","name":"Wu, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Hu","name":"Hu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deyi","familyName":"Xiong","name":"Xiong, Deyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DecEx-RAG: Boosting Agentic Retrieval-Augmented Generation with Decision and Execution Optimization via Process Supervision"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T08:49:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:34:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Agentic Retrieval-Augmented Generation (Agentic RAG) enhances the processing capability for complex tasks through dynamic retrieval and adaptive workflows. Recent advances (e.g., Search-R1) have shown that outcome-supervised reinforcement learning demonstrate strong performance. However, this approach still suffers from inefficient exploration, sparse reward signals, and ambiguous global reward feedback. To address these challenges, we propose DecEx-RAG, which models RAG as a Markov Decision Process (MDP) incorporating decision-making and execution, while introducing an efficient pruning strategy to optimize data expansion. Through comprehensive process-level policy optimization, DecEx-RAG significantly enhances the autonomous task decomposition, dynamic retrieval, and high-quality answer generation capabilities of large language models (LLMs). Experiments show that DecEx-RAG achieves an average absolute performance improvement of $6.2\\%$ across six datasets, significantly outperforming existing baselines. Moreover, the pruning strategy improves data construction efficiency by nearly $6 \\times$, providing an efficient solution for process-supervised RAG training. The code is available at https://github.com/sdsxdxl/DecEx-RAG."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05691","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:54:45Z","registered":"2025-10-08T01:54:46Z","published":null,"updated":"2025-10-08T01:54:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.05605","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05605","identifiers":[{"identifier":"2510.05605","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yasod","familyName":"Ginige","name":"Ginige, Yasod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akila","familyName":"Niroshan","name":"Niroshan, Akila","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sajal","familyName":"Jain","name":"Jain, Sajal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suranga","familyName":"Seneviratne","name":"Seneviratne, Suranga","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoPentester: An LLM Agent-based Framework for Automated Pentesting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-07T06:02:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:26:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Penetration testing and vulnerability assessment are essential industry practices for safeguarding computer systems. As cyber threats grow in scale and complexity, the demand for pentesting has surged, surpassing the capacity of human professionals to meet it effectively. With advances in AI, particularly Large Language Models (LLMs), there have been attempts to automate the pentesting process. However, existing tools such as PentestGPT are still semi-manual, requiring significant professional human interaction to conduct pentests. To this end, we propose a novel LLM agent-based framework, AutoPentester, which automates the pentesting process. Given a target IP, AutoPentester automatically conducts pentesting steps using common security tools in an iterative process. It can dynamically generate attack strategies based on the tool outputs from the previous iteration, mimicking the human pentester approach. We evaluate AutoPentester using Hack The Box and custom-made VMs, comparing the results with the state-of-the-art PentestGPT. Results show that AutoPentester achieves a 27.0% better subtask completion rate and 39.5% more vulnerability coverage with fewer steps. Most importantly, it requires significantly fewer human interactions and interventions compared to PentestGPT. Furthermore, we recruit a group of security industry professional volunteers for a user survey and perform a qualitative analysis to evaluate AutoPentester against industry practices and compare it with PentestGPT. On average, AutoPentester received a score of 3.93 out of 5 based on user reviews, which was 19.8% higher than PentestGPT."},{"descriptionType":"Other","description":"IEEE TrustCom 2025 10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.05605","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:52:46Z","registered":"2025-10-08T01:52:46Z","published":null,"updated":"2025-10-08T01:52:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":74,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=%28doi%3A%2210.48550%2Farxiv.2510.05592%22+OR+doi%3A%2210.48550%2Farxiv.2510.05605%22+OR+doi%3A%2210.48550%2Farxiv.2510.05609%22+OR+doi%3A%2210.48550%2Farxiv.2510.05681%22+OR+doi%3A%2210.48550%2Farxiv.2510.05691%22+OR+doi%3A%2210.48550%2Farxiv.2510.05715%22+OR+doi%3A%2210.48550%2Farxiv.2510.05748%22+OR+doi%3A%2210.48550%2Farxiv.2510.05865%22+OR+doi%3A%2210.48550%2Farxiv.2510.05921%22+OR+doi%3A%2210.48550%2Farxiv.2510.05942%22+OR+doi%3A%2210.48550%2Farxiv.2510.05950%22+OR+doi%3A%2210.48550%2Farxiv.2510.06067%22+OR+doi%3A%2210.48550%2Farxiv.2510.06101%22+OR+doi%3A%2210.48550%2Farxiv.2510.06126%22+OR+doi%3A%2210.48550%2Farxiv.2510.06131%22+OR+doi%3A%2210.48550%2Farxiv.2510.06174%22+OR+doi%3A%2210.48550%2Farxiv.2510.06182%22+OR+doi%3A%2210.48550%2Farxiv.2510.06430%22+OR+doi%3A%2210.48550%2Farxiv.2510.06492%22+OR+doi%3A%2210.48550%2Farxiv.2510.06552%22+OR+doi%3A%2210.48550%2Farxiv.2510.06640%22+OR+doi%3A%2210.48550%2Farxiv.2510.06662%22+OR+doi%3A%2210.48550%2Farxiv.2510.06680%22+OR+doi%3A%2210.48550%2Farxiv.2510.06699%22+OR+doi%3A%2210.48550%2Farxiv.2510.06700%22+OR+doi%3A%2210.48550%2Farxiv.2510.06710%22+OR+doi%3A%2210.48550%2Farxiv.2510.06719%22+OR+doi%3A%2210.48550%2Farxiv.2510.06751%22+OR+doi%3A%2210.48550%2Farxiv.2510.06783%22+OR+doi%3A%2210.48550%2Farxiv.2510.06820%22+OR+doi%3A%2210.48550%2Farxiv.2510.07043%22+OR+doi%3A%2210.48550%2Farxiv.2510.07067%22+OR+doi%3A%2210.48550%2Farxiv.2510.07134%22+OR+doi%3A%2210.48550%2Farxiv.2510.07181%22+OR+doi%3A%2210.48550%2Farxiv.2510.07190%22+OR+doi%3A%2210.48550%2Farxiv.2510.07206%22+OR+doi%3A%2210.48550%2Farxiv.2510.07230%22+OR+doi%3A%2210.48550%2Farxiv.2510.07313%22+OR+doi%3A%2210.48550%2Farxiv.2510.08625%22+OR+doi%3A%2210.48550%2Farxiv.2510.09665%22+OR+doi%3A%2210.48550%2Farxiv.2510.14992%22+OR+doi%3A%2210.48550%2Farxiv.2510.07135%22+OR+doi%3A%2210.48550%2Farxiv.2510.05684%22+OR+doi%3A%2210.48550%2Farxiv.2510.05699%22+OR+doi%3A%2210.48550%2Farxiv.2510.06048%22+OR+doi%3A%2210.48550%2Farxiv.2510.06133%22+OR+doi%3A%2210.48550%2Farxiv.2510.06175%22+OR+doi%3A%2210.48550%2Farxiv.2510.06308%22+OR+doi%3A%2210.48550%2Farxiv.2510.06673%22+OR+doi%3A%2210.48550%2Farxiv.2510.07081%22+OR+doi%3A%2210.48550%2Farxiv.2510.07651%22+OR+doi%3A%2210.48550%2Farxiv.2510.07737%22+OR+doi%3A%2210.48550%2Fa