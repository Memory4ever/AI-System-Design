<td id="S3.T1.3.1.2.3" class="ltx_td ltx_align_right ltx_border_t">24</td>
<td id="S3.T1.3.1.2.4" class="ltx_td ltx_align_right ltx_border_t">48</td>
<td id="S3.T1.3.1.2.5" class="ltx_td ltx_align_right ltx_border_t">12</td>
<td id="S3.T1.3.1.2.6" class="ltx_td ltx_align_right ltx_border_t">24</td></tr>
<tr id="S3.T1.3.1.3" class="ltx_tr">
<td id="S3.T1.3.1.3.1" class="ltx_td ltx_align_left">2:1</td>
<td id="S3.T1.3.1.3.2" class="ltx_td ltx_align_right">32</td>
<td id="S3.T1.3.1.3.3" class="ltx_td ltx_align_right">16</td>
<td id="S3.T1.3.1.3.4" class="ltx_td ltx_align_right">48</td>
<td id="S3.T1.3.1.3.5" class="ltx_td ltx_align_right">12</td>
