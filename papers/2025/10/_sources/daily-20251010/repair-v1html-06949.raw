<td id="S3.T1.3.1.4.3" class="ltx_td ltx_align_right">12</td>
<td id="S3.T1.3.1.4.4" class="ltx_td ltx_align_right">48</td>
<td id="S3.T1.3.1.4.5" class="ltx_td ltx_align_right">12</td>
<td id="S3.T1.3.1.4.6" class="ltx_td ltx_align_right">24</td></tr>
