</div>
<div id="lstnumberx87" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">15</span>
                
                
                
              <span id="lstnumberx87.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#008000;">"Weighted<span id="lstnumberx87.2.1" class="ltx_text ltx_lst_space"> </span>scoring<span id="lstnumberx87.2.2" class="ltx_text ltx_lst_space"> </span>(SAFE<span id="lstnumberx87.2.3" class="ltx_text ltx_lst_space"> </span>cases<span id="lstnumberx87.2.4" class="ltx_text ltx_lst_space"> </span>only):\n"</span>
