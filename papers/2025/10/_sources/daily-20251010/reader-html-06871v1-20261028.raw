<tr id="A1.T3.2.21" class="ltx_tr">
<td id="A1.T3.2.21.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m35" class="ltx_Math" alttext="R_{i,k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">R_{i,k}</annotation></semantics></math></td>
<td id="A1.T3.2.21.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Reward</td>
<td id="A1.T3.2.21.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A1.T3.2.21.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.21.3.1.1" class="ltx_p"><math id="A1.T3.m36" class="ltx_Math" alttext="r^{\star}_{i,k}+a^{\star}_{i,k}+\lambda_{f}f^{\star}_{i,k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mo>⋆</mo></msubsup><mo>+</mo><msubsup><mi>a</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mo>⋆</mo></msubsup><mo>+</mo><mrow><msub><mi>λ</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mo>⋆</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">r^{\star}_{i,k}+a^{\star}_{i,k}+\lambda_{f}f^{\star}_{i,k}</annotation></semantics></math></span>
</span></td></tr>
<tr id="A1.T3.2.22" class="ltx_tr">
<td id="A1.T3.2.22.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m37" class="ltx_Math" alttext="f_{i,k}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">f_{i,k}</annotation></semantics></math></td>
<td id="A1.T3.2.22.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Format score</td>
<td id="A1.T3.2.22.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A1.T3.2.22.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.22.3.1.1" class="ltx_p">Checks presence of <span id="A1.T3.2.22.3.1.1.1" class="ltx_text ltx_font_typewriter">&lt;think&gt;</span> and <span id="A1.T3.2.22.3.1.1.2" class="ltx_text ltx_font_typewriter">&lt;answer&gt;</span> tags</span>
</span></td></tr>
<tr id="A1.T3.2.23" class="ltx_tr">
<td id="A1.T3.2.23.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m38" class="ltx_Math" alttext="\lambda_{f}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\lambda_{f}</annotation></semantics></math></td>
<td id="A1.T3.2.23.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Format weight</td>
<td id="A1.T3.2.23.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A1.T3.2.23.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.23.3.1.1" class="ltx_p">Weight assigned to format score (<math id="A1.T3.m39" class="ltx_Math" alttext="\lambda_{f}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>f</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{f}\geq 0</annotation></semantics></math>)</span>
</span></td></tr>
<tr id="A1.T3.2.24" class="ltx_tr">
<td id="A1.T3.2.24.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m40" class="ltx_Math" alttext="\hat{A}_{i,k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\hat{A}_{i,k}</annotation></semantics></math></td>
<td id="A1.T3.2.24.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Normalized advantage</td>
<td id="A1.T3.2.24.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A1.T3.2.24.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.24.3.1.1" class="ltx_p"><math id="A1.T3.m41" class="ltx_Math" alttext="\tfrac{R_{i,k}-\mu_{i}}{\sigma_{i}}" display="inline" intent=":literal"><semantics><mfrac><mrow><msub><mi>R</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><msub><mi>σ</mi><mi>i</mi></msub></mfrac><annotation encoding="application/x-tex">\tfrac{R_{i,k}-\mu_{i}}{\sigma_{i}}</annotation></semantics></math>, normalized within <math id="A1.T3.m42" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> rollouts</span>
</span></td></tr>
<tr id="A1.T3.2.25" class="ltx_tr">
<td id="A1.T3.2.25.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m43" class="ltx_Math" alttext="\tau_{i,k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{i,k}</annotation></semantics></math></td>
<td id="A1.T3.2.25.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Trajectory</td>
<td id="A1.T3.2.25.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A1.T3.2.25.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.25.3.1.1" class="ltx_p">Safe: <math id="A1.T3.m44" class="ltx_Math" alttext="[y_{i,k}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[y_{i,k}]</annotation></semantics></math>; Unsafe: <math id="A1.T3.m45" class="ltx_Math" alttext="[\tilde{c}_{i,k},\tilde{y}_{i,k}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>c</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\tilde{c}_{i,k},\tilde{y}_{i,k}]</annotation></semantics></math></span>
</span></td></tr>
<tr id="A1.T3.2.26" class="ltx_tr">
<td id="A1.T3.2.26.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m46" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math></td>
