<span id="A1.T3.2.26.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.26.3.1.1" class="ltx_p">Multimodal policy parameterized by <math id="A1.T3.m47" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></span>
</span></td></tr>
<tr id="A1.T3.2.27" class="ltx_tr">
<td id="A1.T3.2.27.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m48" class="ltx_Math" alttext="\pi_{\mathrm{old}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>old</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{old}}</annotation></semantics></math></td>
<td id="A1.T3.2.27.2" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">Reference policy</td>
<td id="A1.T3.2.27.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="A1.T3.2.27.3.1" class="ltx_inline-block ltx_align_top" style="width:261.8pt;">
<span id="A1.T3.2.27.3.1.1" class="ltx_p">Policy used for data collection</span>
</span></td></tr>
<tr id="A1.T3.2.28" class="ltx_tr">
<td id="A1.T3.2.28.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;"><math id="A1.T3.m49" class="ltx_Math" alttext="\rho_{i,k}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{i,k}(\theta)</annotation></semantics></math></td>
