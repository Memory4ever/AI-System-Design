<td id="S4.T2.2.1.4.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">26.33</td>
<td id="S4.T2.2.1.4.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">61.64</td>
