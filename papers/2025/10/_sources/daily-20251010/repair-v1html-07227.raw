               Evaluate <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathsf{ppl}(s)" display="inline" intent=":literal"><semantics><mrow><mi>𝗉𝗉𝗅</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{ppl}(s)</annotation></semantics></math> for <math id="alg1.l8.m2" class="ltx_Math" alttext="s\in\mathcal{P}^{(t)}_{b}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">s\in\mathcal{P}^{(t)}_{b}</annotation></semantics></math>

