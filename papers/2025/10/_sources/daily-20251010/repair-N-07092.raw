<tr id="S2.T2.7.1.3" class="ltx_tr">
<th id="S2.T2.7.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="S2.T2.7.1.3.1.1" class="ltx_text ltx_font_smallcaps">20</span></th>
<th id="S2.T2.7.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="S2.T2.7.1.3.2.1" class="ltx_text ltx_font_smallcaps">1</span></th>
<td id="S2.T2.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T2.7.1.3.3.1" class="ltx_text ltx_font_smallcaps">–</span></td>
<td id="S2.T2.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T2.7.1.3.4.1" class="ltx_text ltx_font_smallcaps">22.63</span></td>
<td id="S2.T2.7.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T2.7.1.3.5.1" class="ltx_text ltx_font_smallcaps">21.05</span></td>
<td id="S2.T2.7.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T2.7.1.3.6.1" class="ltx_text ltx_font_smallcaps">0.707</span></td>
<td id="S2.T2.7.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S2.T2.7.1.3.7.1" class="ltx_text ltx_font_bold">0.137</span></td>
