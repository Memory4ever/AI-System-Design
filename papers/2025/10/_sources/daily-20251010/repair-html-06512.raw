            <span id="alg2.l6.3" class="ltx_text" style="font-size:80%;">   </span><math id="alg2.l6.m1" class="ltx_Math" alttext="T\leftarrow X_{i}{.length()}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">T</mi><mo mathsize="0.800em" stretchy="false">←</mo><msub><mi mathsize="0.800em">X</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo lspace="0em" mathsize="0.800em" rspace="0.167em">.</mo><mrow><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T\leftarrow X_{i}{.length()}</annotation></semantics></math><span id="alg2.l6.4" class="ltx_text" style="font-size:80%;">
