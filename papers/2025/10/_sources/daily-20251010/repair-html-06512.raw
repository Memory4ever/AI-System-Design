<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> LogSTOP <math id="alg1.m2" class="ltx_Math" alttext="\hat{y}(X,\varphi,t_{s},t_{e},w)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>φ</mi><mo>,</mo><msub><mi>t</mi><mi>s</mi></msub><mo>,</mo><msub><mi>t</mi><mi>e</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{y}(X,\varphi,t_{s},t_{e},w)</annotation></semantics></math></figcaption>
