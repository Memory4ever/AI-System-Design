<th id="S4.T1.2.1.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="S4.T1.m3" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="\lambda-" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">λ</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">−</mo></mrow><annotation encoding="application/x-tex">\lambda-</annotation></semantics></math><span id="S4.T1.2.1.16.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">GRPO</span></th>
<td id="S4.T1.2.1.16.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.16.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">92.0</span></td>
<td id="S4.T1.2.1.16.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.16.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">75.8</span></td>
<td id="S4.T1.2.1.16.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.16.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">40.1</span></td>
<td id="S4.T1.2.1.16.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.16.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">66.2</span></td>
