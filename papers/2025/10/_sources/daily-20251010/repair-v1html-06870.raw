<td id="S4.T1.2.1.16.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.16.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">41.4</span></td>
