<td id="S4.T1.2.1.15.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.15.4.1" class="ltx_text ltx_font_bold">40.1</span></td>
<td id="S4.T1.2.1.15.5" class="ltx_td ltx_align_center">62.6</td>
<td id="S4.T1.2.1.15.6" class="ltx_td ltx_align_center">35.6</td>
<td id="S4.T1.2.1.15.7" class="ltx_td ltx_align_center">38.6</td>
<td id="S4.T1.2.1.15.8" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.15.8.1" class="ltx_text ltx_font_bold">17.2</span></td>
<td id="S4.T1.2.1.15.9" class="ltx_td ltx_align_center ltx_border_r">52.6</td>
<td id="S4.T1.2.1.15.10" class="ltx_td ltx_align_center">51.8</td></tr>
