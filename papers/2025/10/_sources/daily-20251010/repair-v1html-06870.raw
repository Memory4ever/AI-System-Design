<td id="S4.T1.2.1.14.8" class="ltx_td ltx_align_center">14.2</td>
<td id="S4.T1.2.1.14.9" class="ltx_td ltx_align_center ltx_border_r">54.1</td>
<td id="S4.T1.2.1.14.10" class="ltx_td ltx_align_center">51.9</td></tr>
