<span id="S4.T7.p2.1.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_tt">45.33</span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_tt">67.35</span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_tt">71.33</span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_tt">90.08</span></span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.3" class="ltx_tr" style="--ltx-bg-color:#DCF0FF;">
<span id="S4.T7.p2.1.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T7.p2.1.1.1.1.1.1.1.3.1.1" class="ltx_text" style="--ltx-bg-color:#DCF0FF;">w/ TTRV</span></span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center"><span id="S4.T7.p2.1.1.1.1.1.1.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#DCF0FF;">48.71</span></span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.3.3" class="ltx_td ltx_align_center"><span id="S4.T7.p2.1.1.1.1.1.1.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#DCF0FF;">71.48</span></span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center"><span id="S4.T7.p2.1.1.1.1.1.1.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#DCF0FF;">75.25</span></span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.3.5" class="ltx_td ltx_align_center"><span id="S4.T7.p2.1.1.1.1.1.1.1.3.5.1" class="ltx_text" style="--ltx-bg-color:#DCF0FF;">92.71</span></span></span>
