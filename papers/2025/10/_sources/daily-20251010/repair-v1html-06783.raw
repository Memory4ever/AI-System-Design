<span id="S4.T7.p2.1.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T7.p2.1.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Capture</span></span>
<span id="S4.T7.p2.1.1.1.1.1.1.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T7.p2.1.1.1.1.1.1.1.1.5.1" class="ltx_text ltx_font_bold">Resisc45</span></span></span>
</span>
<span class="ltx_tbody">
<span id="S4.T7.p2.1.1.1.1.1.1.1.2" class="ltx_tr">
