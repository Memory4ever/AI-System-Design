<td id="S4.T2.44.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.8pt 3.0pt;"><span id="S4.T2.44.1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">MathV<math id="S4.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
