<td id="S4.T2.44.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.8pt 3.0pt;"><span id="S4.T2.44.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:70%;">AI2D<math id="S4.T2.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S4.T2.44.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.8pt 3.0pt;"><span id="S4.T2.44.1.1.8.1" class="ltx_text ltx_font_bold" style="font-size:70%;">MM-Vet<math id="S4.T2.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S4.T2.44.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.8pt 3.0pt;"><span id="S4.T2.44.1.1.9.1" class="ltx_text ltx_font_bold" style="font-size:70%;">OCRBench<math id="S4.T2.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S4.T2.44.1.1.10" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.8pt 3.0pt;"><span id="S4.T2.44.1.1.10.1" class="ltx_text ltx_font_bold" style="font-size:70%;">MME<math id="S4.T2.m9" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
<tr id="S4.T2.44.1.2" class="ltx_tr">
<td id="S4.T2.44.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.8pt 3.0pt;" colspan="9"><span id="S4.T2.44.1.2.1.1" class="ltx_text ltx_font_italic" style="font-size:70%;">Understanding Only</span></td>
