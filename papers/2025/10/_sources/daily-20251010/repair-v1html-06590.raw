<td id="S4.T5.fig1.10.8.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T5.fig1.10.8.2.1" class="ltx_text" style="font-size:70%;">512</span></td>
