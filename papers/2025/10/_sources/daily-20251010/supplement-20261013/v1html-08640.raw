<div id="lstnumberx30" class="ltx_listingline"><span id="lstnumberx30.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">*</span><span id="lstnumberx30.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx30.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">What</span><span id="lstnumberx30.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx30.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">went</span><span id="lstnumberx30.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx30.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">wrong:</span>
</div>
<div id="lstnumberx31" class="ltx_listingline"><span id="lstnumberx31.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">Execution</span><span id="lstnumberx31.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx31.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">failed</span><span id="lstnumberx31.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx31.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">for</span><span id="lstnumberx31.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx31.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">task</span><span id="lstnumberx31.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx31.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">’</span><span id="lstnumberx31.10" class="ltx_text ltx_font_typewriter">:<span id="lstnumberx31.10.1" class="ltx_text ltx_lst_identifier">app</span>:<span id="lstnumberx31.10.2" class="ltx_text ltx_lst_identifier">kaptDebugKotlin</span><span id="lstnumberx31.10.3" class="ltx_text ltx_lst_string" style="--ltx-fg-color:#BF0040;">’.</span></span>
</div>
<div id="lstnumberx32" class="ltx_listingline"><span id="lstnumberx32.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">&gt;</span><span id="lstnumberx32.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx32.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">A</span><span id="lstnumberx32.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx32.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">failure</span><span id="lstnumberx32.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx32.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">occurred</span><span id="lstnumberx32.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx32.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">while</span><span id="lstnumberx32.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx32.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">executing</span><span id="lstnumberx32.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx32.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">org.jetbrains.kotlin.gradle.internal.KaptWithoutKotlincTask$KaptExecutionWorkAction</span>
</div>
