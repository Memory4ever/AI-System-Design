</div>
<div id="lstnumberx35" class="ltx_listingline"><span id="lstnumberx35.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">&gt;</span><span id="lstnumberx35.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">Run</span><span id="lstnumberx35.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">with</span><span id="lstnumberx35.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">--stacktrace</span><span id="lstnumberx35.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">option</span><span id="lstnumberx35.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">to</span><span id="lstnumberx35.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">get</span><span id="lstnumberx35.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">the</span><span id="lstnumberx35.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.17" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">stack</span><span id="lstnumberx35.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx35.19" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">trace.’</span>
</div>
