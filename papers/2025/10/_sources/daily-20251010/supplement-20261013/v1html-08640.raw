</div>
<div id="lstnumberx25" class="ltx_listingline">
</div>
<div id="lstnumberx26" class="ltx_listingline"><span id="lstnumberx26.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">&gt;</span><span id="lstnumberx26.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx26.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">Task</span><span id="lstnumberx26.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx26.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">:app:kaptDebugKotlin</span><span id="lstnumberx26.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#BF0040;"> </span><span id="lstnumberx26.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#BF0040;">FAILED</span>
