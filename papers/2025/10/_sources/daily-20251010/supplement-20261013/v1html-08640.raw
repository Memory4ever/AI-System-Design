<td id="S4.T5.4.2.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;">49.2%</td></tr>
<tr id="S4.T5.4.3" class="ltx_tr">
<td id="S4.T5.4.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S4.T5.4.3.1.1" class="ltx_text ltx_font_bold">Individual Tools (w/ Incr. Specificity)</span></td></tr>
<tr id="S4.T5.4.4" class="ltx_tr">
