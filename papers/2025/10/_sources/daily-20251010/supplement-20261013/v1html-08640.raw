<td id="S4.T5.4.4.2" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">54.3%</td></tr>
<tr id="S4.T5.4.5" class="ltx_tr">
<td id="S4.T5.4.5.1" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;">  Only <span id="S4.T5.4.5.1.1" class="ltx_text ltx_font_typewriter">TOOL_B</span></td>
<td id="S4.T5.4.5.2" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">55.8%</td></tr>
<tr id="S4.T5.4.6" class="ltx_tr">
<td id="S4.T5.4.6.1" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;">  Only <span id="S4.T5.4.6.1.1" class="ltx_text ltx_font_typewriter">TOOL_A</span></td>
<td id="S4.T5.4.6.2" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">63.4%</td></tr>
<tr id="S4.T5.4.7" class="ltx_tr">
<td id="S4.T5.4.7.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S4.T5.4.7.1.1" class="ltx_text ltx_font_bold">Tool Combinations</span></td></tr>
