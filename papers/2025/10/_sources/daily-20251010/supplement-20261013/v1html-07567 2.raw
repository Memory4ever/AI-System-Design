<td id="S7.T3.1.1.5.2" class="ltx_td ltx_align_center"><math id="S7.T3.m24" class="ltx_Math" alttext="57.33" display="inline" intent=":literal"><semantics><mn>57.33</mn><annotation encoding="application/x-tex">57.33</annotation></semantics></math></td>
