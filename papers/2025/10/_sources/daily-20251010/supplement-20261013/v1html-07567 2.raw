<td id="S7.T3.1.1.5.4" class="ltx_td ltx_align_center"><math id="S7.T3.m26" class="ltx_Math" alttext="24.59" display="inline" intent=":literal"><semantics><mn>24.59</mn><annotation encoding="application/x-tex">24.59</annotation></semantics></math></td>
<td id="S7.T3.1.1.5.5" class="ltx_td ltx_align_center ltx_border_r"><math id="S7.T3.m27" class="ltx_Math" alttext="43.32" display="inline" intent=":literal"><semantics><mn>43.32</mn><annotation encoding="application/x-tex">43.32</annotation></semantics></math></td>
<td id="S7.T3.1.1.5.6" class="ltx_td ltx_align_center ltx_border_r"><math id="S7.T3.m28" class="ltx_Math" alttext="84.55" display="inline" intent=":literal"><semantics><mn>84.55</mn><annotation encoding="application/x-tex">84.55</annotation></semantics></math></td>
<td id="S7.T3.1.1.5.7" class="ltx_td ltx_align_center"><math id="S7.T3.m29" class="ltx_Math" alttext="66.88" display="inline" intent=":literal"><semantics><mn>66.88</mn><annotation encoding="application/x-tex">66.88</annotation></semantics></math></td>
