<tr id="S3.T1.2.1.7" class="ltx_tr">
<th id="S3.T1.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-4-Turbo-04-09</th>
<td id="S3.T1.2.1.7.2" class="ltx_td ltx_align_center">55.0</td>
