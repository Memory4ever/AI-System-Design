<tr id="S3.T1.2.1.6" class="ltx_tr">
<th id="S3.T1.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Yi-34B-Chat</th>
<td id="S3.T1.2.1.6.2" class="ltx_td ltx_align_center">27.2</td>
