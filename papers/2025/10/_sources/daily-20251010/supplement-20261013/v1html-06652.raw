<td id="S4.T4.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">39.25</td></tr>
<tr id="S4.T4.2.1.3" class="ltx_tr">
<th id="S4.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;">DPO</th>
