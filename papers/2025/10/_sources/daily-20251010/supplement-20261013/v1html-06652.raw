<td id="S3.T1.2.1.7.6" class="ltx_td ltx_align_center">39.1</td>
<td id="S3.T1.2.1.7.7" class="ltx_td ltx_align_center">1.7</td></tr>
<tr id="S3.T1.2.1.8" class="ltx_tr">
<th id="S3.T1.2.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gemma-2-9B-it</th>
<td id="S3.T1.2.1.8.2" class="ltx_td ltx_align_center">51.1</td>
<td id="S3.T1.2.1.8.3" class="ltx_td ltx_align_center">38.1</td>
<td id="S3.T1.2.1.8.4" class="ltx_td ltx_align_center">-</td>
<td id="S3.T1.2.1.8.5" class="ltx_td ltx_align_center">56.5</td>
<td id="S3.T1.2.1.8.6" class="ltx_td ltx_align_center">39.3</td>
<td id="S3.T1.2.1.8.7" class="ltx_td ltx_align_center">1.7</td></tr>
<tr id="S3.T1.2.1.9" class="ltx_tr">
<th id="S3.T1.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Claude-3.5-Sonnet</th>
