</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T13.2.1.2" class="ltx_tr">
<td id="A5.T13.2.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">
