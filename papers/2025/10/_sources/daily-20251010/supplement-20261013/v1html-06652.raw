<td id="S3.T1.2.1.9.5" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.9.5.1" class="ltx_text ltx_font_bold">56.8</span></td>
<td id="S3.T1.2.1.9.6" class="ltx_td ltx_align_center">40.5</td>
<td id="S3.T1.2.1.9.7" class="ltx_td ltx_align_center">1.7</td></tr>
<tr id="S3.T1.2.1.10" class="ltx_tr">
<th id="S3.T1.2.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-4o-05-13</th>
<td id="S3.T1.2.1.10.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.10.2.1" class="ltx_text ltx_font_bold">57.5</span></td>
<td id="S3.T1.2.1.10.3" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.10.3.1" class="ltx_text ltx_font_bold">51.3</span></td>
<td id="S3.T1.2.1.10.4" class="ltx_td ltx_align_center">1.5</td>
<td id="S3.T1.2.1.10.5" class="ltx_td ltx_align_center">51.8</td>
<td id="S3.T1.2.1.10.6" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.10.6.1" class="ltx_text ltx_font_bold">44.7</span></td>
<td id="S3.T1.2.1.10.7" class="ltx_td ltx_align_center">1.8</td></tr>
<tr id="S3.T1.2.1.11" class="ltx_tr">
