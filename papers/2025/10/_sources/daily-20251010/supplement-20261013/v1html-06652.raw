<td id="S3.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">STD</td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<th id="S3.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="7"><span id="S3.T1.2.1.4.1.1" class="ltx_text ltx_font_italic">Off-the-shelf Models</span></th></tr>
<tr id="S3.T1.2.1.5" class="ltx_tr">
<th id="S3.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Llama-3-8B-Instruct</th>
<td id="S3.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t">22.9</td>
<td id="S3.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t">22.6</td>
