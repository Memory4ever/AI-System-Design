                    </Math></foreignObject></g></g><g transform="translate(0,0)"><g transform="translate(0,172.02) scale(1,-1)"><foreignObject width="458.28" height="172.02" overflow="visible"><object type="image/svg+xml" data="2510.06717v1/x13.svg" id="S2.F2.pic1.g5" class="ltx_graphics ltx_img_landscape" width="476" height="180" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.07,0.18)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="13.28" height="11.16" overflow="visible"><Math mode="inline" tex="d" text="d" xml:id="S2.F2.pic1.m4">
