                    </Math></foreignObject></g></g><g transform="translate(1.11,0.11)"><g transform="scale(1,-1)"><text fontsize="80%" xml:id="S2.F2.pic1.7.1.1.1">Lane </text></g><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="57.78" height="11.16" overflow="visible"><Math mode="inline" tex="L_{\mathrm{cur}}" text="L _ cur" xml:id="S2.F2.pic1.m3">
