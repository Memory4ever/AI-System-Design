        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.07067">pdf</a>, <a href="https://arxiv.org/ps/2510.07067">ps</a>, <a href="https://arxiv.org/format/2510.07067">other</a>]&nbsp;</span>
