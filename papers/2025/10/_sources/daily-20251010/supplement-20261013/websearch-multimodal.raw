        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.07567">pdf</a>, <a href="https://arxiv.org/ps/2510.07567">ps</a>, <a href="https://arxiv.org/format/2510.07567">other</a>]&nbsp;</span>
