        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.06492">pdf</a>, <a href="https://arxiv.org/ps/2510.06492">ps</a>, <a href="https://arxiv.org/format/2510.06492">other</a>]&nbsp;</span>
