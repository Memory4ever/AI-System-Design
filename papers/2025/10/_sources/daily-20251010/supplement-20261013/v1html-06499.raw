<th id="A2.T3.8.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:1.5pt 15.0pt;"><span id="A2.T3.8.1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><span id="A2.T3.8.1.2.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;"># of Converted QA Pairs</span></th></tr>
</thead>
<tbody class="ltx_tbody">
