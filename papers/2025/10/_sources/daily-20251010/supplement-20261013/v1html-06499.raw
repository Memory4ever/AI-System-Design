<td id="S5.T2.11.1.7.3" class="ltx_td ltx_align_center" style="padding:2pt 8.0pt;"><span id="S5.T2.11.1.7.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">46.0</span></td>
