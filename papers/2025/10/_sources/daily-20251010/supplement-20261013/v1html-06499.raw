<td id="A2.T3.8.3.2" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 15.0pt;"><span id="A2.T3.8.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="A2.T3.m4" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="A2.T3.8.3.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">350K</span></td></tr>
<tr id="A2.T3.8.4" class="ltx_tr" style="--ltx-bg-color:#F7F7F7;">
<th id="A2.T3.8.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:1.5pt 15.0pt;"><span id="A2.T3.8.4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F7F7F7;">  MegaMath</span></th>
<td id="A2.T3.8.4.2" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 15.0pt;"><span id="A2.T3.8.4.2.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F7F7F7;">  <math id="A2.T3.m5" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F7F7F7;" mathbackground="#F7F7F7" mathcolor="#000000">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>100K</span></td></tr>
