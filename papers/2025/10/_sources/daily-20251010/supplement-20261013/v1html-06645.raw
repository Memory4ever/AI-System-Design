<td id="S4.T2.2.2.3" class="ltx_td ltx_align_right ltx_border_t">8B</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<td id="S4.T2.2.3.1" class="ltx_td ltx_align_left">LLaMA</td>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_left">3.2-3B-Instruct</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_right">3B</td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<td id="S4.T2.2.4.1" class="ltx_td ltx_align_left">LLaMA</td>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_left">3.2-1B-Instruct</td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_right">1B</td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
<td id="S4.T2.2.5.1" class="ltx_td ltx_align_left">Qwen</td>
<td id="S4.T2.2.5.2" class="ltx_td ltx_align_left">2.5-7B-Instruct</td>
<td id="S4.T2.2.5.3" class="ltx_td ltx_align_right">7B</td></tr>
<tr id="S4.T2.2.6" class="ltx_tr">
<td id="S4.T2.2.6.1" class="ltx_td ltx_align_left">Mistral</td>
<td id="S4.T2.2.6.2" class="ltx_td ltx_align_left">7B-Instruct</td>
<td id="S4.T2.2.6.3" class="ltx_td ltx_align_right">7B</td></tr>
<tr id="S4.T2.2.7" class="ltx_tr">
<td id="S4.T2.2.7.1" class="ltx_td ltx_align_left">DeepSeek</td>
<td id="S4.T2.2.7.2" class="ltx_td ltx_align_left">R1</td>
<td id="S4.T2.2.7.3" class="ltx_td ltx_align_right">236B (MoE)</td></tr>
<tr id="S4.T2.2.8" class="ltx_tr">
<td id="S4.T2.2.8.1" class="ltx_td ltx_align_left ltx_border_bb">GPT</td>
