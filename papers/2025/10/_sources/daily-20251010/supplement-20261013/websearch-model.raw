      <a href="/search/?searchtype=author&amp;query=Long%2C+D+X">Do Xuan Long</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Nguyen%2C+C">Cong-Duy Nguyen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kan%2C+M">Min-Yen Kan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tuan%2C+L+A">Luu Anh Tuan</a>
      
