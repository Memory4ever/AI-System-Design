      <a href="/search/?searchtype=author&amp;query=Choi%2C+S">Suhwan Choi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jung%2C+J">Jaeyoon Jung</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Seong%2C+H">Haebin Seong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+M">Minchan Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+M">Minyeong Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cho%2C+Y">Yongjun Cho</a>, 
      
