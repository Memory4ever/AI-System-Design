    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=He%2C+M">Muyu He</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shafique%2C+M+A">Muhammad Ali Shafique</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kumar%2C+A">Anand Kumar</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Mackey%2C+T">Tsach Mackey</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Rajani%2C+N">Nazneen Rajani</a>
      
