      <a href="/search/?searchtype=author&amp;query=Park%2C+Y">Yubeen Park</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+Y">Youngjae Yu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+Y">Yunsung Lee</a>
      
