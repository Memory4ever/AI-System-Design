<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proof for <a href="#S4.Ex1" title="Proposition 1. ‣ 4.2 A Formal Motivation for OnlineRubrics ‣ 4 Online Rubric Elicitation ‣ Online Rubrics Elicitation from Pairwise Comparisons" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.p1" class="ltx_para">
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex2.m1" class="ltx_Math" alttext="\displaystyle g_{U}-g_{R_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>U</mi></msub><mo>−</mo><msub><mi>g</mi><msub><mi>R</mi><mi>t</mi></msub></msub></mrow><annotation encoding="application/x-tex">\displaystyle g_{U}-g_{R_{t}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex2.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{(x,o)}\Big[\nabla_{\theta}\log\pi_{\theta}(o|x)\big(U-R_{t}\big)\Big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>U</mi><mo>−</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{(x,o)}\Big[\nabla_{\theta}\log\pi_{\theta}(o|x)\big(U-R_{t}\big)\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex3.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{(x,o)}\Big[\nabla_{\theta}\log\pi_{\theta}(o|x)\big(Y-\mathbb{E}_{(x,o)}\big[Y\big]\Big]\qquad\text{where }Y=U-R_{t}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>o</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>Y</mi><mo>−</mo><msub><mi>𝔼</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>Y</mi><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mtext>where </mtext><mi>Y</mi><mo>=</mo><mi>U</mi><mo>−</mo><msub><mi>R</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{(x,o)}\Big[\nabla_{\theta}\log\pi_{\theta}(o|x)\big(Y-\mathbb{E}_{(x,o)}\big[Y\big]\Big]\qquad\text{where }Y=U-R_{t}</annotation></semantics></math></td>
