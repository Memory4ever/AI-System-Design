<figure id="A4.F22.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06700v1/figures/bias/qwen3-14b_bias.png" id="A4.F22.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/126;" width="381" height="126" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(c) </span><span id="A4.F22.sf3.3" class="ltx_text ltx_font_typewriter">Qwen3-14B</span></figcaption>
