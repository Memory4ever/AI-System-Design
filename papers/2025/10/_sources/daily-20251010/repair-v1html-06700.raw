</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:16.91em;--ltx-fo-depth:0em;font-size:10pt;" height="233.93" overflow="visible" transform="matrix(1 0 0 -1 0 233.93)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A4.F5.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
<span id="A4.F5.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.F5.pic1.p1.pic1" class="ltx_picture" color="#000000" height="107.97" overflow="visible" version="1.1" viewBox="0 0 609.84 107.97" width="609.84"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,107.97) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#8080FF;" fill="#8080FF" fill-opacity="1.0"><path style="stroke:none" d="M 0 9.84 L 0 98.13 C 0 103.56 4.41 107.97 9.84 107.97 L 600 107.97 C 605.44 107.97 609.84 103.56 609.84 98.13 L 609.84 9.84 C 609.84 4.41 605.44 0 600 0 L 9.84 0 C 4.41 0 0 4.41 0 9.84 Z"></path></g><g style="--ltx-fill-color:#E6E6FF;" fill="#E6E6FF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 9.84 L 1.97 83.86 L 607.87 83.86 L 607.87 9.84 C 607.87 5.49 604.35 1.97 600 1.97 L 9.84 1.97 C 5.49 1.97 1.97 5.49 1.97 9.84 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 92.46)"><foreignObject style="--ltx-fo-width:35.6em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="492.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
