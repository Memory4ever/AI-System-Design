<figure id="A4.F21.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.06700v1/figures/bias/qwen2.5-14b_bias.png" id="A4.F21.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/126;" width="381" height="126" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span><span id="A4.F21.sf2.3" class="ltx_text ltx_font_typewriter">Qwen2.5-14B-Instruct</span></figcaption>
