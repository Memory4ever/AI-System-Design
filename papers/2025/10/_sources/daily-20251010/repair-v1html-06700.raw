<th id="A4.T3.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">Std.Err.</th>
<th id="A4.T3.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="A4.T3.m1" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math></th>
<th id="A4.T3.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><math id="A4.T3.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></th>
<th id="A4.T3.2.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">95% CI</th></tr>
