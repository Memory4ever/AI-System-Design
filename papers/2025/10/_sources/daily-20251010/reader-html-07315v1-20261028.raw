</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Correlation Analysis</h3>

<figure id="A5.F15" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A5.F15.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.07315v1/Figure/bigvibebench_w_sc.png" id="A5.F15.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/141;" width="476" height="141" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F15.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A5.F15.sf1.4" class="ltx_text" style="font-size:90%;">BigVibeBench w/ Style Control</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A5.F15.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.07315v1/Figure/livevibebench_w_sc.png" id="A5.F15.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/141;" width="476" height="141" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F15.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="A5.F15.sf2.4" class="ltx_text" style="font-size:90%;">LiveVibeBench w/ Style Control</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A5.F15.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.07315v1/Figure/bigvibebench_wo_sc.png" id="A5.F15.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/141;" width="476" height="141" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A5.F15.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="A5.F15.sf3.4" class="ltx_text" style="font-size:90%;">BigVibeBench w/o Style Control</span></figcaption>
