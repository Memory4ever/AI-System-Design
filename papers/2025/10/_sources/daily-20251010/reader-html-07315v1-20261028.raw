<td id="S4.T3.3.18.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.2pt 8.7pt;"><span id="S4.T3.3.18.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-fg-color:#B00020;">11.94</span></td>
<td id="S4.T3.3.18.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.2pt 8.7pt;"><span id="S4.T3.3.18.7.1" class="ltx_text" style="font-size:70%;">76.97</span></td>
<td id="S4.T3.3.18.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.2pt 8.7pt;"><span id="S4.T3.3.18.8.1" class="ltx_text" style="font-size:70%;">57.35</span></td>
<td id="S4.T3.3.18.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.2pt 8.7pt;"><span id="S4.T3.3.18.9.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#D55C5A;">44.17</span></td>
<td id="S4.T3.3.18.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1.2pt 8.7pt;"><span id="S4.T3.3.18.10.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#D55C5A;">35.73</span></td>
