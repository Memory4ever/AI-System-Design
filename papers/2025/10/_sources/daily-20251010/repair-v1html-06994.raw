<div id="A9.SS3.p10" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A9.SS3.p10.pic1" class="ltx_picture" height="202.09" overflow="visible" version="1.1" viewBox="0 0 550 202.09" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,202.09) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#FFEBEB;" fill="#FFEBEB" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 197.46 C 0 200.01 2.07 202.09 4.63 202.09 L 545.37 202.09 C 547.93 202.09 550 200.01 550 197.46 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFEBEB;" fill="#FFEBEB" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 178.99 L 549.31 178.99 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 187.08)"><foreignObject style="--ltx-fo-width:32em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="442.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
