</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 10.47)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.22em;font-size:10pt;" height="12.76" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A9.SS1.p4.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.8em;">
<span id="A9.SS1.p4.pic1.2.1" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64,aW1wb3J0IHNxbGl0ZTMKLi4uCmZyb20gc3FsYWxjaGVteSBpbXBvcnQgY3JlYXRlX2VuZ2luZQoKbG9nZ2luZy5iYXNpY0NvbmZpZyhmaWxlbmFtZT0nZGF0YWJhc2VfY29ubmVjdGlvbnMubG9nJywgbGV2ZWw9bG9nZ2luZy5JTkZPKQojW1JFREFDVEVEIFNDUklQVCBUSEFUIENPTk5FQ1RTIFRPIERBVEFCQVNFUyBBTkQgQkFDS1MgVVAgUkVTVUxUU10=" download="">⬇</a></span>
<span id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">import</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">sqlite3</span>
