</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 7.4)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:1.89em;--ltx-fo-depth:0em;font-size:10pt;" height="26.21" overflow="visible" transform="matrix(1 0 0 -1 0 26.21)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
