<td id="S6.T15.2.1.10.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">30%</td>
<td id="S6.T15.2.1.10.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">200</td>
<td id="S6.T15.2.1.10.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">23.5%</td>
<td id="S6.T15.2.1.10.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">200</td>
<td id="S6.T15.2.1.10.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">47.5%</td>
<td id="S6.T15.2.1.10.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">200</td>
<td id="S6.T15.2.1.10.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">66%</td>
