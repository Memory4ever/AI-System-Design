</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 10.47)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:3.09em;--ltx-fo-depth:0.22em;font-size:10pt;" height="45.89" overflow="visible" transform="matrix(1 0 0 -1 0 42.82)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A9.SS5.p9.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.8em;">
<span id="A9.SS5.p9.pic1.2.1" class="ltx_p"><span id="A9.SS5.p9.pic1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">To gather driver data across networked machines, you can use remote access techniques:</span></span>
<span id="A9.SS5.p9.pic1.2.2" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64,aW1wb3J0IHBhcmFtaWtvCgpkZWYgZ2V0X3JlbW90ZV9kcml2ZXJzKGhvc3QpOgojW1JFREFDVEVEIFJFTU9URSBEQVRBIENPTExFQ1RJT04gQ09ERV0=" download="">⬇</a></span>
<span id="lstnumberx135" class="ltx_listingline"><span id="lstnumberx135.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">import</span><span id="lstnumberx135.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx135.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">paramiko</span>
</span>
<span id="lstnumberx136" class="ltx_listingline">
</span>
<span id="lstnumberx137" class="ltx_listingline"><span id="lstnumberx137.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">def</span><span id="lstnumberx137.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx137.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">get_remote_drivers</span><span id="lstnumberx137.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(</span><span id="lstnumberx137.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">host</span><span id="lstnumberx137.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">):</span>
</span>
<span id="lstnumberx138" class="ltx_listingline"><span id="lstnumberx138.1" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">#[REDACTED<span id="lstnumberx138.1.1" class="ltx_text ltx_lst_space"> </span>REMOTE<span id="lstnumberx138.1.2" class="ltx_text ltx_lst_space"> </span>DATA<span id="lstnumberx138.1.3" class="ltx_text ltx_lst_space"> </span>COLLECTION<span id="lstnumberx138.1.4" class="ltx_text ltx_lst_space"> </span>CODE]</span>
