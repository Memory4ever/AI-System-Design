</span>
<span id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">from</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">sqlalchemy</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">import</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">create_engine</span>
</span>
<span id="lstnumberx4" class="ltx_listingline">
</span>
<span id="lstnumberx5" class="ltx_listingline"><span id="lstnumberx5.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">logging</span><span id="lstnumberx5.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="lstnumberx5.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">basicConfig</span><span id="lstnumberx5.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(</span><span id="lstnumberx5.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">filename</span><span id="lstnumberx5.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">=</span><span id="lstnumberx5.7" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF8000;">’database_connections.log’</span><span id="lstnumberx5.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span><span id="lstnumberx5.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">level</span><span id="lstnumberx5.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">=</span><span id="lstnumberx5.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">logging</span><span id="lstnumberx5.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="lstnumberx5.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">INFO</span><span id="lstnumberx5.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">)</span>
</span>
<span id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">#[REDACTED<span id="lstnumberx6.1.1" class="ltx_text ltx_lst_space"> </span>SCRIPT<span id="lstnumberx6.1.2" class="ltx_text ltx_lst_space"> </span>THAT<span id="lstnumberx6.1.3" class="ltx_text ltx_lst_space"> </span>CONNECTS<span id="lstnumberx6.1.4" class="ltx_text ltx_lst_space"> </span>TO<span id="lstnumberx6.1.5" class="ltx_text ltx_lst_space"> </span>DATABASES<span id="lstnumberx6.1.6" class="ltx_text ltx_lst_space"> </span>AND<span id="lstnumberx6.1.7" class="ltx_text ltx_lst_space"> </span>BACKS<span id="lstnumberx6.1.8" class="ltx_text ltx_lst_space"> </span>UP<span id="lstnumberx6.1.9" class="ltx_text ltx_lst_space"> </span>RESULTS]</span>
</span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A9.SS1.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A9.SS1.p5.pic1" class="ltx_picture" height="182.41" overflow="visible" version="1.1" viewBox="0 0 550 182.41" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,182.41) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#FFEBEB;" fill="#FFEBEB" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 177.78 C 0 180.33 2.07 182.41 4.63 182.41 L 545.37 182.41 C 547.93 182.41 550 180.33 550 177.78 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFEBEB;" fill="#FFEBEB" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 159.31 L 549.31 159.31 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 167.4)"><foreignObject style="--ltx-fo-width:32em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="442.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
