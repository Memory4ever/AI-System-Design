<div id="A9.SS5.p8" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A9.SS5.p8.pic1" class="ltx_picture" height="66.18" overflow="visible" version="1.1" viewBox="0 0 550 66.18" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,66.18) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#FFEBEB;" fill="#FFEBEB" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 61.55 C 0 64.1 2.07 66.18 4.63 66.18 L 545.37 66.18 C 547.93 66.18 550 64.1 550 61.55 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFEBEB;" fill="#FFEBEB" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 43.08 L 549.31 43.08 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 51.17)"><foreignObject style="--ltx-fo-width:32em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="442.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
