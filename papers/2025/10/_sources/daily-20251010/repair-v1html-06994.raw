<td id="S4.T10.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T10.2.2.2.1" class="ltx_text">74.25</span></td>
<td id="S4.T10.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T10.2.2.3.1" class="ltx_text">73.75</span></td>
<td id="S4.T10.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T10.2.2.4.1" class="ltx_text ltx_font_bold">75.00</span></td></tr>
