<div id="A9.SS3.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A9.SS3.p5.pic1" class="ltx_picture" height="185.1" overflow="visible" version="1.1" viewBox="0 0 550 185.1" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,185.1) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#EBF2FF;" fill="#EBF2FF" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 180.47 C 0 183.03 2.07 185.1 4.63 185.1 L 545.37 185.1 C 547.93 185.1 550 183.03 550 180.47 L 550 0 Z"></path></g><g style="--ltx-fill-color:#EBF2FF;" fill="#EBF2FF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 162 L 549.31 162 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 170.09)"><foreignObject style="--ltx-fo-width:32em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="442.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
