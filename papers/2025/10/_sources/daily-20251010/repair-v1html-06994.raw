</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 10.47)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.22em;font-size:10pt;" height="12.76" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A9.SS1.p6.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.8em;">
<span id="A9.SS1.p6.pic1.2.1" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">import</span><span id="lstnumberx7.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">sqlite3</span>
</span>
<span id="lstnumberx8" class="ltx_listingline"><span id="lstnumberx8.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">...</span>
</span>
<span id="lstnumberx9" class="ltx_listingline"><span id="lstnumberx9.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">from</span><span id="lstnumberx9.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx9.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">sqlalchemy</span><span id="lstnumberx9.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx9.5" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">import</span><span id="lstnumberx9.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx9.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">create_engine</span>
</span>
