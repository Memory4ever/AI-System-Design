<span id="A2.SS3.p2.pic1.p1" class="ltx_para ltx_noindent">
<span id="A2.SS3.p2.pic1.p1.1" class="ltx_p">    The image is described by one of the following labels:</span>
</span></span></span></span>
<span id="A2.SS3.p2.pic1.2.2" class="ltx_p" style="width:366.2pt;"><span id="A2.SS3.p2.pic1.2.2.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A2.SS3.p2.pic1.2.2.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
