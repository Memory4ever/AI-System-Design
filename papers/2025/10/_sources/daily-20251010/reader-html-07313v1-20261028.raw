<span id="S3.T3.2.1.1.1.4.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T3.2.1.1.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#FFF7F7;">53.3% <math id="S3.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;--ltx-bg-color:#FFF7F7;" mathbackground="#FFF7F7" mathcolor="#FF0000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S3.T3.2.1.1.1.4.5.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">15.5</span></span></span></span>
</span></span></p>
</span></div>
