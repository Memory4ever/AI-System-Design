<td id="A1.T7.2.10.2" class="ltx_td ltx_align_left">8 <math id="A1.T7.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> A800 GPUs</td></tr>
<tr id="A1.T7.2.11" class="ltx_tr">
