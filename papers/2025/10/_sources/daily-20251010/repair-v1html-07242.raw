<span id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">If</span><span id="lstnumberx16.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx16.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">question</span><span id="lstnumberx16.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">does</span><span id="lstnumberx16.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">not</span><span id="lstnumberx16.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">meet</span><span id="lstnumberx16.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx16.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">criteria</span><span id="lstnumberx16.16" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx16.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">briefly</span><span id="lstnumberx16.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">explain</span><span id="lstnumberx16.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx16.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">why</span><span id="lstnumberx16.23" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">."</span>
