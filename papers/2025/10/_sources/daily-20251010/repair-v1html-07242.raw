</span>
<span id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">1.</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">question</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">must</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">be</span><span id="lstnumberx3.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">clear</span><span id="lstnumberx3.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx3.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">unambiguous</span><span id="lstnumberx3.16" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">.</span>
</span>
<span id="lstnumberx4" class="ltx_listingline">
</span>
<span id="lstnumberx5" class="ltx_listingline"><span id="lstnumberx5.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">2.</span><span id="lstnumberx5.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx5.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">question</span><span id="lstnumberx5.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">must</span><span id="lstnumberx5.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">have</span><span id="lstnumberx5.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">a</span><span id="lstnumberx5.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">specific</span><span id="lstnumberx5.14" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx5.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">factual</span><span id="lstnumberx5.17" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx5.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx5.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">answerable</span><span id="lstnumberx5.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">solution</span><span id="lstnumberx5.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.25" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx5.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">not</span><span id="lstnumberx5.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">open</span><span id="lstnumberx5.29" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">-</span><span id="lstnumberx5.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">ended</span><span id="lstnumberx5.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">or</span><span id="lstnumberx5.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx5.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">subjective</span><span id="lstnumberx5.35" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">).</span>
</span>
<span id="lstnumberx6" class="ltx_listingline">
</span>
<span id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">3.</span><span id="lstnumberx7.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx7.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">question</span><span id="lstnumberx7.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">must</span><span id="lstnumberx7.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">NOT</span><span id="lstnumberx7.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">require</span><span id="lstnumberx7.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">a</span><span id="lstnumberx7.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx7.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="fo