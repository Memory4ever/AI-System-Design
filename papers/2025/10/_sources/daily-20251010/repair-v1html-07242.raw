<td id="S4.T2.9.1.6.6" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#E6E6E6;padding:0.7pt 9.0pt;"><span id="S4.T2.9.1.6.6.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E6E6E6;">56.4</span></td>
