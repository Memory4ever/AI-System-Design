<span id="A4.T8.2.7.7.2.1.2" class="ltx_tr">
<span id="A4.T8.2.7.7.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A4.T8.2.7.7.2.1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#005959;">(+5.3%)</span></span></span>
</span></span><span id="A4.T8.2.7.7.3" class="ltx_text"></span></td>
