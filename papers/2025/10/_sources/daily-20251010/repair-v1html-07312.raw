nobject_content"><math id="A1.F6.pic1.m3" class="ltx_Math" alttext="32+16=\mathbf{48}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>32</mn><mo>+</mo><mn>16</mn></mrow><mo>=</mo><mn>𝟒𝟖</mn></mrow><annotation encoding="application/x-tex">32+16=\mathbf{48}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9"><path d="M 115.94 187.43 L -33.18 187.43 C -34.7 187.43 -35.94 186.2 -35.94 184.67 L -35.94 69.97 C -35.94 68.44 -34.7 67.21 -33.18 67.21 L 115.94 67.21 C 117.46 67.21 118.7 68.44 118.7 69.97 L 118.7 184.67 C 118.7 186.2 117.46 187.43 115.94 187.43 Z M -35.94 67.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -31.79 123.86)"><foreignObject style="--ltx-fo-width:10.24em;--ltx-fo-height:4.29em;--ltx-fo-depth:3.79em;font-size:10pt;" height="111.93" overflow="visible" transform="matrix(1 0 0 -1 0 59.42)" width="141.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
