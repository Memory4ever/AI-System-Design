<td id="A3.T4.2.1.5.8" class="ltx_td ltx_align_left ltx_border_t"><math id="A3.T4.m5" class="ltx_Math" alttext="415\,940" display="inline" intent=":literal"><semantics><mn>415 940</mn><annotation encoding="application/x-tex">415\,940</annotation></semantics></math></td></tr>
