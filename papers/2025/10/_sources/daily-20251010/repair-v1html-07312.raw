<td id="A4.T5.2.9.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">Loss Type</td>
<td id="A4.T5.2.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
