<td id="A4.T8.2.7.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A4.T8.2.7.6.1" class="ltx_text"></span> <span id="A4.T8.2.7.6.2" class="ltx_text">
<span id="A4.T8.2.7.6.2.1" class="ltx_tabular ltx_align_middle">
