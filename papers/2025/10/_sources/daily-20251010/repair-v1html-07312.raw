<span id="A4.T5.2.9.2.1.1" class="ltx_p ltx_align_center">Dr. GRPO</span>
</span></td>
<td id="A4.T5.2.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="A4.T5.2.9.3.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="A4.T5.2.9.3.1.1" class="ltx_p ltx_align_center">Dr. GRPO</span>
</span></td>
<td id="A4.T5.2.9.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">
<span id="A4.T5.2.9.4.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
