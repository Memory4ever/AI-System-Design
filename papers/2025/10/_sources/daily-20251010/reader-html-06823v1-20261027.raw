</div>
<div id="lstnumberx26" class="ltx_listingline">
</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx27.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">output</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">should</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ONLY</span><span id="lstnumberx27.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">be</span><span id="lstnumberx27.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx27.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">label</span><span id="lstnumberx27.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx27.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx27.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">other</span><span id="lstnumberx27.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">information</span><span id="lstnumberx27.22" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Domain</span><span id="lstnumberx28.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx28.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">URL</span><span id="lstnumberx28.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx28.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx28.6" class="ltx_text ltx_font_typewriter">\{</span><span id="lstnumberx28.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">url</span><span id="lstnumberx28.8" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx28.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">c</span><span id="lstnumberx28.10" class="ltx_text ltx_font_typewriter">)\}</span>
</div>
<div id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Whois</span><span id="lstnumberx29.2" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx29.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.4" class="ltx_text ltx_font_typewriter">\{</span><span id="lstnumberx29.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">whois</span><span id="lstnumberx29.6" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx29.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">c</span><span id="lstnumberx29.8" class="ltx_text ltx_font_typewriter">)\}</span>
</div>
