<td id="A4.T2.5.4.2" class="ltx_td ltx_align_center"><span id="A4.T2.5.4.2.1" class="ltx_text" style="font-size:90%;">3.7 (4.0) <math id="A4.T2.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3.2</span></td>
<td id="A4.T2.5.4.3" class="ltx_td ltx_align_center"><span id="A4.T2.5.4.3.1" class="ltx_text" style="font-size:90%;">3.0 (3.0) <math id="A4.T2.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.5</span></td>
