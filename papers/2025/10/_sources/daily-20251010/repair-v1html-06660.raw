<th id="S5.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Params</th>
<th id="S5.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Speed</th></tr>
</thead>
<tbody class="ltx_tbody">
