<th id="S5.T2.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column">Cifar</th>
<th id="S5.T2.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column">Cifar</th></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_left ltx_border_t">CNN</td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_t">28 586</td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_t">209 098</td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_t">3ms/step</td></tr>
<tr id="S5.T2.2.4" class="ltx_tr">
