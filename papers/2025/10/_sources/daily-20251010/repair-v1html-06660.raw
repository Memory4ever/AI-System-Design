<tr id="S5.T4.2.4" class="ltx_tr">
<th id="S5.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T4.2.4.1.1" class="ltx_text ltx_font_bold">AE+GMNM</span></th>
<td id="S5.T4.2.4.2" class="ltx_td ltx_align_center"><span id="S5.T4.2.4.2.1" class="ltx_text ltx_font_bold">2 778 723</span></td>
<td id="S5.T4.2.4.3" class="ltx_td ltx_align_center"><span id="S5.T4.2.4.3.1" class="ltx_text ltx_font_bold">17ms/step</span></td></tr>
<tr id="S5.T4.2.5" class="ltx_tr">
<th id="S5.T4.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">AE+ATT+GMNM</th>
<td id="S5.T4.2.5.2" class="ltx_td ltx_align_center ltx_border_bb">3 190 243</td>
