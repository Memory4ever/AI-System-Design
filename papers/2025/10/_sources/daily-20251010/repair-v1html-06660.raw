<td id="S5.T3.2.23.3" class="ltx_td ltx_align_left"><span id="S5.T3.2.23.3.1" class="ltx_text ltx_font_bold">Test</span></td>
<td id="S5.T3.2.23.4" class="ltx_td ltx_align_center"><span id="S5.T3.2.23.4.1" class="ltx_text ltx_font_bold">0.033</span></td></tr>
<tr id="S5.T3.2.24" class="ltx_tr">
<td id="S5.T3.2.24.1" class="ltx_td"></td>
<td id="S5.T3.2.24.2" class="ltx_td ltx_align_left">CNN + Attention</td>
