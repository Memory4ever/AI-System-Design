<th id="S5.T5.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Cifar 10</th>
<th id="S5.T5.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Cifar 100</th></tr>
<tr id="S5.T5.2.2" class="ltx_tr">
<th id="S5.T5.2.2.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="S5.T5.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column">Train/Test</th>
<th id="S5.T5.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column">Train/Test</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T5.2.3" class="ltx_tr">
<th id="S5.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">AE</th>
<td id="S5.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_t">(0.0187)/(0.0190)</td>
