<th id="A4.T7.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A4.T7.m4" class="ltx_Math" alttext="\alpha_{2}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\alpha_{2}</annotation></semantics></math></th>
