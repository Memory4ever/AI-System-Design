<th id="S4.T1.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.6.1.2.1" class="ltx_text ltx_font_bold">Mul.</span></th>
<th id="S4.T1.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.6.1.3.1" class="ltx_text ltx_font_bold">Mul. (<math id="S4.T1.m6" class="ltx_Math" alttext="\alpha_{3}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>𝟑</mn></msub><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\alpha_{3}=0</annotation></semantics></math>)</span></th>
