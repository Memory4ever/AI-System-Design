" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx1.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">initial</span><span id="lstnumberx1.69" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx1.70" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">solution</span><span id="lstnumberx1.71" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx1.72" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">through</span><span id="lstnumberx1.73" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx1.74" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">the</span><span id="lstnumberx1.75" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx1.76" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">following</span><span id="lstnumberx1.77" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx1.78" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">steps</span><span id="lstnumberx1.79" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">:</span>
</div>
<div id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">1.</span><span id="lstnumberx2.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">**</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">Customer</span><span id="lstnumberx2.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">Removal</span><span id="lstnumberx2.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">**:</span><span id="lstnumberx2.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">Select</span><span id="lstnumberx2.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">a</span><span id="lstnumberx2.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">subset</span><span id="lstnumberx2.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">of</span><span id="lstnumberx2.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">customers</span><span id="lstnumberx2.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">to</span><span id="lstnumberx2.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">remove</span><span id="lstnumberx2.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">using</span><span id="lstnumberx2.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">a</span><span id="lstnumberx2.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">specified</span><span id="lstnumberx2.28" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;"> </span><span id="lstnumberx2.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">heuristic</span><span id="lstnumberx2.30" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#1A1A1A;">.</span>
