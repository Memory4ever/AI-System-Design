rx123.m3" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math></span>
</span>
<span id="lstnumberx124" class="ltx_listingline"><span id="lstnumberx124.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;">    </span><span id="lstnumberx124.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">s1</span><span id="lstnumberx124.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx124.4" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx124.m1" class="ltx_Math" alttext="\cap" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∩</mo><annotation encoding="application/x-tex">\cap</annotation></semantics></math></span><span id="lstnumberx124.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx124.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">s2</span><span id="lstnumberx124.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx124.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">=</span><span id="lstnumberx124.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx124.10" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx124.m2" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math></span><span id="lstnumberx124.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx124.12" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="l