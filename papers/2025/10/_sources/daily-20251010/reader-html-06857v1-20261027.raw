<span id="lstnumberx125" class="ltx_listingline"><span id="lstnumberx125.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;">    </span><span id="lstnumberx125.2" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx125.m1" class="ltx_Math" alttext="\forall" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∀</mo><annotation encoding="application/x-tex">\forall</annotation></semantics></math></span><span id="lstnumberx125.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">i</span><span id="lstnumberx125.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx125.m2" class="ltx_Math" alttext="\in" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><annotation encoding="application/x-tex">\in</annotation></semantics></math></span><span id="lstnumberx125.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">s1</span><span id="lstnumberx125.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span><span id="lstnumberx125.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.11" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx125.m3" class="ltx_Math" alttext="\forall" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∀</mo><annotation encoding="application/x-tex">\forall</annotation></semantics></math></span><span id="lstnumberx125.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">j</span><span id="lstnumberx125.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.15" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx125.m4" class="ltx_Math" alttext="\in" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><annotation encoding="application/x-tex">\in</annotation></semantics></math></span><span id="lstnumberx125.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">s1</span><span id="lstnumberx125.18" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span><span id="lstnumberx125.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">tea</span><span id="lstnumberx125.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">i</span><span id="lstnumberx125.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">j</span><span id="lstnumberx125.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx125.26" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx125.m5" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math></span>
</span>
<span id="lstnumberx126" class="ltx_listingline"><span id="lstnumberx126.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;">    </span><span id="lstnumberx126.2" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx126.m1" class="ltx_Math" alttext="\forall" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∀</mo><annotation encoding="application/x-tex">\forall</annotation></semantics></math></span><span id="lstnumberx126.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">i</span><span id="lstnumberx126.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.6" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx126.m2" class="ltx_Math" alttext="\in" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><annotation encoding="application/x-tex">\in</annotation></semantics></math></span><span id="lstnumberx126.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">s2</span><span id="lstnumberx126.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">,</span><span id="lstnumberx126.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.11" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="--ltx-fg-color:#000000;"><math id="lstnumberx126.m3" class="ltx_Math" alttext="\forall" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#0