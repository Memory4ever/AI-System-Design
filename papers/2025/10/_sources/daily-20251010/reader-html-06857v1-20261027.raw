<td id="S4.T4.2.2.4" class="ltx_td ltx_align_center ltx_border_t">SC</td>
<td id="S4.T4.2.2.5" class="ltx_td ltx_align_center ltx_border_t">CC</td>
<td id="S4.T4.2.2.6" class="ltx_td ltx_align_center ltx_border_t">SC</td>
<td id="S4.T4.2.2.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">CC</td></tr>
<tr id="S4.T4.2.3" class="ltx_tr">
