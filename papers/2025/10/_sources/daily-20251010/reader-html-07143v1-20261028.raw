<td id="S4.T4.2.1.24.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;">32.8</td>
<td id="S4.T4.2.1.24.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;">42.1</td>
<td id="S4.T4.2.1.24.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;">24.7</td></tr>
