<td id="S4.T4.2.1.25.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;">28.5</td>
<td id="S4.T4.2.1.25.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;">40.4</td>
<td id="S4.T4.2.1.25.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;">25.2</td></tr>
