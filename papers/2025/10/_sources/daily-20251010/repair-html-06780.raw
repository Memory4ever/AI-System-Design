<th id="S5.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><math id="S5.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S5.T3.2.1.4.1" class="ltx_text ltx_font_bold">SS1</span></th>
<th id="S5.T3.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.25pt 3.0pt;"><math id="S5.T3.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="S5.T3.2.1.5.1" class="ltx_text ltx_font_bold">SS2</span></th></tr>
<tr id="S5.T3.2.2" class="ltx_tr">
<th id="S5.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="S5.T3.2.2.1.1" class="ltx_text ltx_font_italic">Base setting</span></th>
<th id="S5.T3.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 3.0pt;">0.12</th>
<th id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 3.0pt;">0.33</th>
<th id="S5.T3.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 3.0pt;">0.89</th>
<th id="S5.T3.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:0.25pt 3.0pt;">58.3%</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T3.2.3" class="ltx_tr">
<th id="S5.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.25pt 3.0pt;">Seed</th>
<td id="S5.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;">0.10</td>
<td id="S5.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;">0.33</td>
<td id="S5.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;">0.89</td>
