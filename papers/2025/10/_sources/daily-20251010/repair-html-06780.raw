<td id="A4.T5.2.1.4.3" class="ltx_td ltx_align_right" style="--ltx-bg-color:#FFFFFF;"><span id="A4.T5.2.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">11</span></td>
