<div id="A7.T7.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:104.1pt;vertical-align:-50.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-147.4pt,38.6pt) scale(0.57416530159675,0.57416530159675) ;">
