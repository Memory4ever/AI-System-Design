</figcaption>
</figure>
<figure id="A7.F12" class="ltx_figure"><object type="image/svg+xml" data="2510.06419v1/amortized_ttc_best_from_scratch.svg" id="A7.F12.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/268;" width="548" height="268"></object>
