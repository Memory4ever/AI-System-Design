<p id="A1.SS2.p3.4" class="ltx_p"><span id="A1.SS2.p3.4.1" class="ltx_text">and</span></p>
<table id="A1.Ex20" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex20X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex20X.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\left\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\left\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right\rangle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20X.m3" class="ltx_Math" alttext="\displaystyle=\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},i}^{2}+\frac{1}{{\bm{W}}_{\bm{v},j}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},i}^{2}+\frac{1}{{\bm{W}}_{\bm{v},j}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex20Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20Xa.m2" class="ltx_Math" alttext="\displaystyle+\left({\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},j}^{2}+\frac{1}{{\bm{W}}_{\bm{v},i}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left({\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},j}^{2}+\frac{1}{{\bm{W}}_{\bm{v},i}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p3.5" class="ltx_p"><span id="A1.SS2.p3.5.1" class="ltx_text">By Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we know the above equations are larger than <math id="A1.SS2.p3.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. So <math id="A1.SS2.p3.m2" class="ltx_Math" alttext="\left\langle{\bm{W}}^{[2]}_{i}{\bm{W}}^{[1],i},{\bm{W}}^{[2]}_{j}{\bm{W}}^{[1],j}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>⟨</mo><mrow><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup></mrow><mo>,</mo><mrow><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup></mrow></mrow><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\left\langle{\bm{W}}^{[2]}_{i}{\bm{W}}^{[1],i},{\bm{W}}^{[2]}_{j}{\bm{W}}^{[1],j}\right\rangle</annotation></semantics></math> and <math id="A1.SS2.p3.m3" class="ltx_Math" alttext="\left\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mo>⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>⟩</mo></mrow><annotation encoding="application/x-tex">\left\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right\rangle</annotation></semantics></math> will be monotonically increasing since <math id="A1.SS2.p3.m4" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p4" class="ltx_para">
<p id="A1.SS2.p4.1" class="ltx_p"><span id="A1.SS2.p4.1.1" class="ltx_text">Calculating the derivative of left hand side of first condition, we have</span></p>
<table id="A1.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}{\bm{W}}^{[2]}_{i}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],i}=\dot{{\bm{W}}}_{\bm{v},i}^{2}+\sum_{j=1}^{d_{m}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{{\bm{W}}^{[1],j}}^{\intercal}{\bm{W}}^{[1],i}+\left({\bm{W}}^{[2]}_{i}\right)^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>m</mi></msub></munderover><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}{\bm{W}}^{[2]}_{i}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],i}=\dot{{\bm{W}}}_{\bm{v},i}^{2}+\sum_{j=1}^{d_{m}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{{\bm{W}}^{[1],j}}^{\intercal}{\bm{W}}^{[1],i}+\left({\bm{W}}^{[2]}_{i}\right)^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p4.2" class="ltx_p"><span id="A1.SS2.p4.2.1" class="ltx_text">and</span></p>
<table id="A1.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}=\dot{{\bm{W}}}_{{\bm{v},i}}^{2}+\sum_{j=1}^{d_{m}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}+\left({\bm{W}}_{\bm{v},i}\right)^{2}\|{\bm{W}}^{[2]}\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>m</mi></msub></munderover><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}=\dot{{\bm{W}}}_{{\bm{v},i}}^{2}+\sum_{j=1}^{d_{m}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}+\left({\bm{W}}_{\bm{v},i}\right)^{2}\|{\bm{W}}^{[2]}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p4.3" class="ltx_p"><span id="A1.SS2.p4.3.1" class="ltx_text">Hence, <math id="A1.SS2.p4.m1" class="ltx_Math" alttext="{\bm{W}}^{[2]}_{i}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[2]}_{i}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],i}</annotation></semantics></math> and <math id="A1.SS2.p4.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}</annotation></semantics></math> will also increase monotonically since <math id="A1.SS2.p4.m3" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math>. Therefore the condensation condition will hold until <math id="A1.SS2.p4.m4" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p5" class="ltx_para">
<p id="A1.SS2.p5.1" class="ltx_p">Next, we analyze the angle relation between <math id="A1.SS2.p5.m1" class="ltx_Math" alttext="{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[2]}</annotation></semantics></math> and its derivative <math id="A1.SS2.p5.m2" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}</annotation></semantics></math>. For the simplicity of proof and description, we adopt a standardized notation to represent angles between distinct vectors throughout the ensuing discussion.</p>
</div>
<div id="Thmdefi5" class="ltx_theorem ltx_theorem_defi">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefi5.2" class="ltx_text ltx_font_bold">Definition 5</span></span><span id="Thmdefi5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefi5.p1" class="ltx_para">
<p id="Thmdefi5.p1.1" class="ltx_p"><span id="Thmdefi5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmdefi5.p1.m1" class="ltx_Math" alttext="\xi_{ij}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\xi_{ij}(t)</annotation></semantics></math> denote the angle between the vectors <math id="Thmdefi5.p1.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>𝐯</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)</annotation></semantics></math> and <math id="Thmdefi5.p1.m3" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},j}(t){\bm{W}}^{[1]}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>𝐯</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},j}(t){\bm{W}}^{[1]}_{i}(t)</annotation></semantics></math>, and <math id="Thmdefi5.p1.m4" class="ltx_Math" alttext="\psi_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{i}(t)</annotation></semantics></math> denote the angle between the vectors <math id="Thmdefi5.p1.m5" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}(t)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐖</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}(t)</annotation></semantics></math> and <math id="Thmdefi5.p1.m6" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>𝐯</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)</annotation></semantics></math>. Let <math id="Thmdefi5.p1.m7" class="ltx_Math" alttext="\varphi_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{i}(t)</annotation></semantics></math> denote the angle between <math id="Thmdefi5.p1.m8" class="ltx_Math" alttext="{\bm{W}}^{[2]}(t)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐖</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[2]}(t)</annotation></semantics></math> and <math id="Thmdefi5.p1.m9" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>𝐯</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)</annotation></semantics></math>, while <math id="Thmdefi5.p1.m10" class="ltx_Math" alttext="\zeta(t)" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta(t)</annotation></semantics></math> denote the angle between <math id="Thmdefi5.p1.m11" class="ltx_Math" alttext="{\bm{W}}^{[2]}(t)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐖</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[2]}(t)</annotation></semantics></math> and <math id="Thmdefi5.p1.m12" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}(t)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐖</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}(t)</annotation></semantics></math>. In subsequent expressions, the variable <math id="Thmdefi5.p1.m13" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> will be omitted unless there is a specific emphasis on the temporal change of angles.</span></p>
</div>
</div>
<div id="A1.SS2.p6" class="ltx_para">
<p id="A1.SS2.p6.1" class="ltx_p">We divide the entries of vector <math id="A1.SS2.p6.m1" class="ltx_Math" alttext="{\bm{W}}_{\bm{v}}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>𝒗</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v}}</annotation></semantics></math> into two classes according to whether their limit is finite.</p>
</div>
<div id="Thmprop5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop5.2" class="ltx_text ltx_font_bold">Proposition 5</span></span><span id="Thmprop5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop5.p1" class="ltx_para">
<p id="Thmprop5.p1.1" class="ltx_p"><span id="Thmprop5.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Consider the effective dynamics Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>). The indices <math id="Thmprop5.p1.m1" class="ltx_Math" alttext="[d_{m}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mi>m</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[d_{m}]</annotation></semantics></math> can be partitioned into two disjoint classes, denoted by <math id="Thmprop5.p1.m2" class="ltx_Math" alttext="C_{1}=\{i_{1},\dots,i_{k}\}\neq\varnothing" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>i</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">C_{1}=\{i_{1},\dots,i_{k}\}\neq\varnothing</annotation></semantics></math> and <math id="Thmprop5.p1.m3" class="ltx_Math" alttext="C_{2}=[d_{m}]\setminus C_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mi>m</mi></msub><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">C_{2}=[d_{m}]\setminus C_{1}</annotation></semantics></math>. The partition satisfies the following properties:</span></p>
</div>
<div id="Thmprop5.p2" class="ltx_para">
<ol id="A1.I1" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p"><span id="A1.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="i\in[m]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[m]</annotation></semantics></math><span id="A1.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">, the limits of </span><math id="A1.I1.i1.p1.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}</annotation></semantics></math><span id="A1.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> exist. In particular,</span></p>
<table id="A1.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E20.m1" class="ltx_math_unparsed" alttext="\lim_{t\rightarrow T^{*}}{\bm{W}}_{\bm{v},i}=\left\{\begin{aligned} &amp;\pm\infty,\quad&amp;i\in C_{1},\\
&{\bm{W}}_{\bm{v},i}^{*},\quad&amp;i\in C_{2}.\\
\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mi mathvariant="normal">∞</mi><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mo>∗</mo></msup><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}{\bm{W}}_{\bm{v},i}=\left\{\begin{aligned} &amp;\pm\infty,\quad&amp;i\in C_{1},\\
&amp;{\bm{W}}_{\bm{v},i}^{*},\quad&amp;i\in C_{2}.\\
\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p"><span id="A1.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The angle </span><math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\xi_{ij}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\xi_{ij}</annotation></semantics></math><span id="A1.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> between the vectors </span><math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}(t){\bm{W}}^{[1]}_{i}(t)</annotation></semantics></math><span id="A1.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="A1.I1.i2.p1.m3" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},j}(t){\bm{W}}^{[1]}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},j}(t){\bm{W}}^{[1]}_{i}(t)</annotation></semantics></math><span id="A1.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">, as defined in Definition </span><a href="#Thmdefi5" title="Definition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">5</span></a><span id="A1.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">, fulfills the condition:</span></p>
<table id="A1.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E21.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\cos\xi_{ij}=1,\quad\text{for }i,j\in C_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ξ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\cos\xi_{ij}=1,\quad\text{for }i,j\in C_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div></li>
<li id="A1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A1.I1.i3.p1" class="ltx_para">
<p id="A1.I1.i3.p1.1" class="ltx_p"><span id="A1.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">The following limits exist</span></p>
<table id="A1.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E22.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}_{\bm{v}}\rVert_{2}^{2}}=\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}^{[2]}\rVert_{2}^{2}}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}_{\bm{v}}\rVert_{2}^{2}}=\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}^{[2]}\rVert_{2}^{2}}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="A1.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p7" class="ltx_para">
<p id="A1.SS2.p7.1" class="ltx_p"><span id="A1.SS2.p7.1.1" class="ltx_text">1.
First, we find that for every index <math id="A1.SS2.p7.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> the <math id="A1.SS2.p7.m2" class="ltx_Math" alttext="\left({\bm{W}}_{\bm{v},i}\right)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\left({\bm{W}}_{\bm{v},i}\right)^{2}</annotation></semantics></math> increases monotonically. So their limits exist. We define the index set of the parameters that tend to infinity as <math id="A1.SS2.p7.m3" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> and the others as <math id="A1.SS2.p7.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math>. Based on Theorem <a href="#Thmthm1" title="Theorem 1 (Blow-up in finite time). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and conservation laws, we know that <math id="A1.SS2.p7.m5" class="ltx_Math" alttext="C_{1}\neq\varnothing" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">C_{1}\neq\varnothing</annotation></semantics></math>. Property 1 is automatically satisfied due to our partition.</span></p>
</div>
<div id="A1.SS2.p8" class="ltx_para">
<p id="A1.SS2.p8.1" class="ltx_p"><span id="A1.SS2.p8.1.1" class="ltx_text">2. We introduce new variables</span></p>
<table id="A1.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex23.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} &amp;p=\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle,\\
&amp;q={\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>p</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>q</mi><mo>=</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} &amp;p=\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle,\\
&amp;q={\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p9" class="ltx_para">
<p id="A1.SS2.p9.2" class="ltx_p"><span id="A1.SS2.p9.2.1" class="ltx_text">According to the proof of Proposition <a href="#Thmprop4" title="Proposition 4 (induction). ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we find that</span></p>
<table id="A1.E23" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E23X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E23X.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}p}{\mathrm{d}t}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}p}{\mathrm{d}t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23X.m3" class="ltx_Math" alttext="\displaystyle=\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},i}^{2}+\frac{1}{{\bm{W}}_{\bm{v},j}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},i}^{2}+\frac{1}{{\bm{W}}_{\bm{v},j}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(23)</span></td></tr>
<tr id="A1.E23Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23Xa.m2" class="ltx_Math" alttext="\displaystyle+\left({\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},j}^{2}+\frac{1}{{\bm{W}}_{\bm{v},i}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left({\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\right)\left({\bm{W}}_{\bm{v},j}^{2}+\frac{1}{{\bm{W}}_{\bm{v},i}^{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{i}{{\bm{W}}^{[1]}_{j}}^{\intercal}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E23Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23Xb.m2" class="ltx_Math" alttext="\displaystyle=\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},i}^{2}+{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},j}^{2}\right)\left(1+\frac{p}{q}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>p</mi><mi>q</mi></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},i}^{2}+{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},j}^{2}\right)\left(1+\frac{p}{q}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p10" class="ltx_para">
<p id="A1.SS2.p10.1" class="ltx_p"><span id="A1.SS2.p10.1.1" class="ltx_text">Thanks to Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>), we obtain</span></p>
<table id="A1.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E24.m1" class="ltx_Math" alttext="\frac{\mathrm{d}q}{\mathrm{d}t}=2\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},i}^{2}+{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},j}^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}q}{\mathrm{d}t}=2\left({\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},i}^{2}+{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v},j}^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p10.2" class="ltx_p"><span id="A1.SS2.p10.2.1" class="ltx_text">Combining Eq. (<a href="#A1.E23" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) and Eq. (<a href="#A1.E24" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), we obtain</span></p>
<table id="A1.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E25.m1" class="ltx_Math" alttext="\frac{\mathrm{d}p}{\mathrm{d}q}=\frac{1}{2}\frac{p}{q}+\frac{1}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mfrac><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>p</mi><mi>q</mi></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}p}{\mathrm{d}q}=\frac{1}{2}\frac{p}{q}+\frac{1}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p11" class="ltx_para">
<p id="A1.SS2.p11.1" class="ltx_p"><span id="A1.SS2.p11.1.1" class="ltx_text">Let <math id="A1.SS2.p11.m1" class="ltx_Math" alttext="u=p/q" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><mi>p</mi><mo>/</mo><mi>q</mi></mrow></mrow><annotation encoding="application/x-tex">u=p/q</annotation></semantics></math>. Note that <math id="A1.SS2.p11.m2" class="ltx_Math" alttext="\frac{\mathrm{d}p}{\mathrm{d}q}=\frac{\mathrm{d}}{\mathrm{d}q}(uq)=q\frac{\mathrm{d}u}{\mathrm{d}q}+u" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mfrac><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mfrac></mrow><mo>+</mo><mi>u</mi></mrow></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}p}{\mathrm{d}q}=\frac{\mathrm{d}}{\mathrm{d}q}(uq)=q\frac{\mathrm{d}u}{\mathrm{d}q}+u</annotation></semantics></math>.
Combining this with the right hand of Eq. (<a href="#A1.E25" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>), we get</span></p>
<table id="A1.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E26.m1" class="ltx_Math" alttext="\frac{\mathrm{d}q}{q}=\frac{2\mathrm{d}u}{1-u}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>q</mi></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}q}{q}=\frac{2\mathrm{d}u}{1-u}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p12" class="ltx_para">
<p id="A1.SS2.p12.1" class="ltx_p"><span id="A1.SS2.p12.1.1" class="ltx_text">The Eq. (<a href="#A1.E26" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) can be solved explicitly.</span></p>
<table id="A1.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E27.m1" class="ltx_Math" alttext="\ln|q(t)|-\ln|q(t_{0})|=-2\ln|u(t)-1|+2\ln|u(t_{0})-1|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mi>ln</mi></mrow><mo fence="false">|</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mi>ln</mi></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ln|q(t)|-\ln|q(t_{0})|=-2\ln|u(t)-1|+2\ln|u(t_{0})-1|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p12.2" class="ltx_p"><span id="A1.SS2.p12.2.1" class="ltx_text">For <math id="A1.SS2.p12.m1" class="ltx_Math" alttext="i,j\in C_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">i,j\in C_{1}</annotation></semantics></math>, we have <math id="A1.SS2.p12.m2" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}u(t)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}u(t)=1</annotation></semantics></math> since <math id="A1.SS2.p12.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> tends to infinite as <math id="A1.SS2.p12.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> tends to <math id="A1.SS2.p12.m5" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p13" class="ltx_para">
<p id="A1.SS2.p13.1" class="ltx_p"><span id="A1.SS2.p13.1.1" class="ltx_text">By definition,</span></p>
<table id="A1.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E28.m1" class="ltx_math_unparsed" alttext="u=\frac{p}{q}=\frac{\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle}{{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}}=\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}||{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}." display="block" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mfrac><mi>p</mi><mi>q</mi></mfrac><mo>=</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub></mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u=\frac{p}{q}=\frac{\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle}{{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}}=\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}||{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p13.2" class="ltx_p"><span id="A1.SS2.p13.2.1" class="ltx_text">Using the conservation laws, we have</span></p>
<table id="A1.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}(t)-\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}(0)={\bm{W}}_{\bm{v},i}^{2}(t)-{\bm{W}}_{\bm{v},i}^{2}(0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}(t)-\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}(0)={\bm{W}}_{\bm{v},i}^{2}(t)-{\bm{W}}_{\bm{v},i}^{2}(0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p13.3" class="ltx_p"><span id="A1.SS2.p13.3.1" class="ltx_text">For <math id="A1.SS2.p13.m1" class="ltx_Math" alttext="i\in C_{1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">i\in C_{1}</annotation></semantics></math>, we have</span></p>
<table id="A1.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E29.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}}{{\bm{W}}_{\bm{v},i}^{2}}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}}{{\bm{W}}_{\bm{v},i}^{2}}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p13.4" class="ltx_p"><span id="A1.SS2.p13.4.1" class="ltx_text">Combining Equations (<a href="#A1.E28" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) and (<a href="#A1.E29" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>), we get</span></p>
<table id="A1.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E30.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\cos\xi_{ij}=1,\ i,j\in C_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ξ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="0.667em">,</mo><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\cos\xi_{ij}=1,\ i,j\in C_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p13.5" class="ltx_p"><span id="A1.SS2.p13.5.1" class="ltx_text">This finishes the proof of statement (ii).</span></p>
</div>
<div id="A1.SS2.p14" class="ltx_para">
<p id="A1.SS2.p14.1" class="ltx_p"><span id="A1.SS2.p14.1.1" class="ltx_text">3.
Finally, we calculate the norm <math id="A1.SS2.p14.m1" class="ltx_Math" alttext="\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}^{2}</annotation></semantics></math>. By definition, we obtain</span></p>
<table id="A1.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex25.m1" class="ltx_Math" alttext="\langle\dot{{\bm{W}}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle=\sum_{i=1}^{d_{m}}\sum_{j=1}^{d_{m}}\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>m</mi></msub></munderover><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>m</mi></msub></munderover><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\langle\dot{{\bm{W}}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle=\sum_{i=1}^{d_{m}}\sum_{j=1}^{d_{m}}\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p14.2" class="ltx_p"><span id="A1.SS2.p14.2.1" class="ltx_text">We divide the sum into three parts due to the boundedness of entries of <math id="A1.SS2.p14.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v}}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>𝒗</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v}}</annotation></semantics></math>.</span></p>
<table id="A1.Ex26" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex26X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26X.m2" class="ltx_Math" alttext="\displaystyle\sum_{i\in C_{1}}\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}|}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}+2\sum_{i\in C_{1}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i\in C_{1}}\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}|}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}+2\sum_{i\in C_{1}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26Xa.m2" class="ltx_Math" alttext="\displaystyle+\sum_{i\in C_{2}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{i\in C_{2}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i\in C_{1}}\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}+\sum_{i\in C_{1}}\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}\left(\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}|}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}-1\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>−</mo><mn>1</mn><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i\in C_{1}}\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}+\sum_{i\in C_{1}}\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}{\bm{W}}_{\bm{v},j}^{2}\left(\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}|}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}-1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26Xc.m2" class="ltx_Math" alttext="\displaystyle+2\sum_{i\in C_{1}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}+\sum_{i\in C_{2}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\sum_{i\in C_{1}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}+\sum_{i\in C_{2}}\sum_{j\in C_{2}}{\bm{W}}_{\bm{v},i}{\bm{W}}_{\bm{v},j}\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p14.3" class="ltx_p"><span id="A1.SS2.p14.3.1" class="ltx_text">Since <math id="A1.SS2.p14.m3" class="ltx_math_unparsed" alttext="\lim_{t\rightarrow T^{*}}\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}|}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}=1" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">lim</mo><msub><mrow></mrow><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}}{|{\bm{W}}_{\bm{v},i}|}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}=1</annotation></semantics></math>, we have</span></p>
<table id="A1.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E31.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\langle\dot{{\bm{W}}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle}{\left(\sum_{i\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}\right)^{2}}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\langle\dot{{\bm{W}}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle}{\left(\sum_{i\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}\right)^{2}}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p14.4" class="ltx_p"><span id="A1.SS2.p14.4.1" class="ltx_text">Based on statement (i), we obtain</span></p>
<table id="A1.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E32.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\sum_{i\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}}{\lVert{\bm{W}}_{\bm{v}}\rVert_{2}^{2}}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mrow><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\sum_{i\in C_{1}}{\bm{W}}_{\bm{v},i}^{2}}{\lVert{\bm{W}}_{\bm{v}}\rVert_{2}^{2}}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p14.5" class="ltx_p"><span id="A1.SS2.p14.5.1" class="ltx_text">Combining Equations (<a href="#A1.E31" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>), (<a href="#A1.E32" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) and conservation law, we have</span></p>
<table id="A1.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E33.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}_{\bm{v}}\rVert_{2}^{2}}=\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}^{[2]}\rVert_{2}^{2}}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}_{\bm{v}}\rVert_{2}^{2}}=\lim_{t\rightarrow T^{*}}\frac{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}{\lVert{\bm{W}}^{[2]}\rVert_{2}^{2}}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p14.6" class="ltx_p"><span id="A1.SS2.p14.6.1" class="ltx_text">This finishes the proof of statement (iii).
∎</span></p>
</div>
</div>
<div id="A1.SS2.p15" class="ltx_para">
<p id="A1.SS2.p15.1" class="ltx_p">Proposition <a href="#Thmprop5" title="Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> describes the angle between <math id="A1.SS2.p15.m1" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}</annotation></semantics></math> and <math id="A1.SS2.p15.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}</annotation></semantics></math>. Since <math id="A1.SS2.p15.m3" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}</annotation></semantics></math> is a linear combination of <math id="A1.SS2.p15.m4" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}</annotation></semantics></math>, we immediately have following corollary.</p>
</div>
<div id="Thmcor1" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcor1.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcor1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcor1.p1" class="ltx_para">
<p id="Thmcor1.p1.1" class="ltx_p"><span id="Thmcor1.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Consider the effective dynamics Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and recall index class defined in Proposition <a href="#Thmprop5" title="Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. The angle <math id="Thmcor1.p1.m1" class="ltx_Math" alttext="\psi_{i}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\psi_{i}</annotation></semantics></math> between the vectors <math id="Thmcor1.p1.m2" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝐖</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}</annotation></semantics></math> and <math id="Thmcor1.p1.m3" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>𝐯</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}</annotation></semantics></math>, as defined in Definition <a href="#Thmdefi5" title="Definition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, satisfies:</span></p>
<table id="A1.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E34.m1" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\cos\psi_{i}=1,\quad i\in C_{1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></munder><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\cos\psi_{i}=1,\quad i\in C_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p16" class="ltx_para">
<p id="A1.SS2.p16.1" class="ltx_p"><span id="A1.SS2.p16.1.1" class="ltx_text">By definition,</span></p>
<table id="A1.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\cos\psi_{i}=\frac{\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},\sum_{j=1}^{m}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle}{\lVert{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow><mo>=</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo rspace="0em">,</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\psi_{i}=\frac{\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},\sum_{j=1}^{m}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\rangle}{\lVert{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p16.2" class="ltx_p"><span id="A1.SS2.p16.2.1" class="ltx_text">Recall the definition of <math id="A1.SS2.p16.m1" class="ltx_Math" alttext="\xi_{ij}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\xi_{ij}</annotation></semantics></math>, the above equation can be
reformulated as follows:</span></p>
<table id="A1.Ex28" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex28X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex28X.m2" class="ltx_Math" alttext="\displaystyle\cos\psi_{i}" display="inline" intent=":literal"><semantics><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\cos\psi_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{j=1}^{m}|{\bm{W}}_{\bm{v},i}||{\bm{W}}_{\bm{v},j}|\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}}{\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo fence="true" lspace="0.167em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{j=1}^{m}|{\bm{W}}_{\bm{v},i}||{\bm{W}}_{\bm{v},j}|\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}}{\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex28Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{j=1}^{m}|{\bm{W}}_{\bm{v},j}|\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}}{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo fence="true" lspace="0.167em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{j=1}^{m}|{\bm{W}}_{\bm{v},j}|\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}}{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex28Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex28Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},j}^{2}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}+\sum_{j\in C_{2}}|{\bm{W}}_{\bm{v},j}|\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}}{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo rspace="0.055em">+</mo><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>∈</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo fence="false" stretchy="false">|</mo><mo fence="true" lspace="0.167em" rspace="0em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="true" lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mi>cos</mi><mi>ξ</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{j\in C_{1}}{\bm{W}}_{\bm{v},j}^{2}\frac{\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}}{|{\bm{W}}_{\bm{v},j}|}\cos\xi_{ij}+\sum_{j\in C_{2}}|{\bm{W}}_{\bm{v},j}|\lVert{\bm{W}}^{[1]}_{j}\rVert_{2}\cos\xi_{ij}}{\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p16.3" class="ltx_p"><span id="A1.SS2.p16.3.1" class="ltx_text">According to Equations (<a href="#A1.E21" title="In item (ii) ‣ Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) and (<a href="#A1.E22" title="In item (iii) ‣ Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), we have <math id="A1.SS2.p16.m2" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\cos\psi_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\cos\psi_{i}=1</annotation></semantics></math>. This completes the proof.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p17" class="ltx_para">
<p id="A1.SS2.p17.1" class="ltx_p">So far, we have characterized some properties of <math id="A1.SS2.p17.m1" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}</annotation></semantics></math> which is component of <math id="A1.SS2.p17.m2" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}</annotation></semantics></math>. We have shown that some of them will have the same direction when <math id="A1.SS2.p17.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> tends to <math id="A1.SS2.p17.m4" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math>. However, it is not enough for our seek for a upper bound for energy <math id="A1.SS2.p17.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. Luckily, based on Corollary <a href="#Thmcor1" title="Corollary 1. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we can analyze the angle between <math id="A1.SS2.p17.m6" class="ltx_Math" alttext="{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[2]}</annotation></semantics></math> and <math id="A1.SS2.p17.m7" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}</annotation></semantics></math> which provides an upper bound. Before this, we give the following proposition. The subsequent proposition demonstrates an extension of statement 1 of Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, going beyond the condition of <math id="A1.SS2.p17.m8" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}</annotation></semantics></math> being greater than zero to include additional angle-related information.</p>
</div>
<div id="Thmprop6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop6.2" class="ltx_text ltx_font_bold">Proposition 6</span></span><span id="Thmprop6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop6.p1" class="ltx_para">
<p id="Thmprop6.p1.1" class="ltx_p"><span id="Thmprop6.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Consider the effective dynamics Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and recall index class defined in Proposition <a href="#Thmprop5" title="Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.
There exists constants <math id="Thmprop6.p1.m1" class="ltx_Math" alttext="T_{1}\in(t_{0},T^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{1}\in(t_{0},T^{*})</annotation></semantics></math> and <math id="Thmprop6.p1.m2" class="ltx_Math" alttext="\Theta_{1}\in[0,\frac{\pi}{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta_{1}\in[0,\frac{\pi}{2})</annotation></semantics></math> such that for each index <math id="Thmprop6.p1.m3" class="ltx_Math" alttext="i\in C_{1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">i\in C_{1}</annotation></semantics></math>, the follow inequality holds:</span></p>
<table id="A1.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex29.m1" class="ltx_Math" alttext="\cos\varphi_{i}\geq\cos\Theta_{1},\quad t\in(T_{1},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>≥</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\varphi_{i}\geq\cos\Theta_{1},\quad t\in(T_{1},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p18" class="ltx_para">
<p id="A1.SS2.p18.1" class="ltx_p"><span id="A1.SS2.p18.1.1" class="ltx_text">It is sufficient to prove the statement for any fixed <math id="A1.SS2.p18.m1" class="ltx_Math" alttext="i\in C_{1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">i\in C_{1}</annotation></semantics></math> due to the finiteness of <math id="A1.SS2.p18.m2" class="ltx_Math" alttext="|C_{1}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|C_{1}|</annotation></semantics></math>.
In Proposition <a href="#Thmprop4" title="Proposition 4 (induction). ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we have shown that <math id="A1.SS2.p18.m3" class="ltx_Math" alttext="\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}^{[2]}\rangle&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}^{[2]}\rangle&gt;0</annotation></semantics></math> for <math id="A1.SS2.p18.m4" class="ltx_Math" alttext="t\in(t_{0},T^{*})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(t_{0},T^{*})</annotation></semantics></math>, which implies</span></p>
<table id="A1.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E35.m1" class="ltx_Math" alttext="\cos\varphi_{i}&gt;0,\quad t\in(t_{0},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\varphi_{i}&gt;0,\quad t\in(t_{0},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p18.2" class="ltx_p"><span id="A1.SS2.p18.2.1" class="ltx_text">Hence we can focus on its square, i.e., <math id="A1.SS2.p18.m5" class="ltx_Math" alttext="\cos^{2}\varphi_{i}=\frac{\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle^{2}}{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\cos^{2}\varphi_{i}=\frac{\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle^{2}}{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}}</annotation></semantics></math>.
By direct calculation, the derivation of <math id="A1.SS2.p18.m6" class="ltx_Math" alttext="\cos^{2}\varphi_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\cos^{2}\varphi_{i}</annotation></semantics></math> is</span></p>
<table id="A1.Ex30" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex30X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30X.m2" class="ltx_Math" alttext="\displaystyle\frac{2}{(\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2})^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle(\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle+\langle{\bm{W}}^{[2]},\dot{{\bm{b}}}^{i}\rangle)\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mi>𝒃</mi><mo>˙</mo></mover><mi>i</mi></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{(\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2})^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle(\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle+\langle{\bm{W}}^{[2]},\dot{{\bm{b}}}^{i}\rangle)\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex30Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex30Xa.m2" class="ltx_Math" alttext="\displaystyle-\frac{2}{(\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2})^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle^{2}(\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}+\|{\bm{W}}^{[2]}\|_{2}^{2}\langle\dot{{\bm{b}}}^{i},{\bm{W}}^{[1]}_{i}\rangle)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝒃</mi><mo>˙</mo></mover><mi>i</mi></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{2}{(\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2})^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle^{2}(\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}+\|{\bm{W}}^{[2]}\|_{2}^{2}\langle\dot{{\bm{b}}}^{i},{\bm{W}}^{[1]}_{i}\rangle)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.3" class="ltx_p"><span id="A1.SS2.p18.3.1" class="ltx_text">We can rewrite the numerator as</span></p>
<table id="A1.Ex31" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex31X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31X.m2" class="ltx_Math" alttext="\displaystyle 2\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle\left[\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle\|{\bm{W}}^{[2]}\|_{2}^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\lVert{\bm{W}}^{[1]}_{i}\rVert_{2}^{2}\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle\left[\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle\|{\bm{W}}^{[2]}\|_{2}^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex31Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex31Xa.m2" class="ltx_Math" alttext="\displaystyle+2\lVert{\bm{W}}^{[2]}\rVert_{2}^{2}\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\left[\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\lVert{\bm{W}}^{[2]}\rVert_{2}^{2}\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\left[\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}^{[1]}_{i}\rangle^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.4" class="ltx_p"><span id="A1.SS2.p18.4.1" class="ltx_text">The second term of above expression is obviously greater than zero by inequality of arithmetic and geometric means. Also we can rewrite the first term as</span></p>
<table id="A1.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex32.m1" class="ltx_Math" alttext="\frac{2\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}}{{\bm{W}}_{\bm{v},i}^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\left[\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\|{\bm{W}}^{[2]}\|_{2}^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\right]." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{2\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}}{{\bm{W}}_{\bm{v},i}^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\left[\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\|{\bm{W}}^{[2]}\|_{2}^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.5" class="ltx_p"><span id="A1.SS2.p18.5.1" class="ltx_text">We find that the first two factors <math id="A1.SS2.p18.m7" class="ltx_Math" alttext="\frac{2\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}}{{\bm{W}}_{\bm{v},i}^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{2\|{\bm{W}}^{[1]}_{i}\|_{2}^{2}}{{\bm{W}}_{\bm{v},i}^{2}}\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle</annotation></semantics></math> of above expression are positive. According to Definition <a href="#Thmdefi5" title="Definition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, the difference term can be reformulated as</span></p>
<table id="A1.Ex33" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex33X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex33X.m2" class="ltx_Math" alttext="\displaystyle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\|{\bm{W}}^{[2]}\|^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\|{\bm{W}}^{[2]}\|^{2}-\langle{\bm{W}}^{[2]},{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\rangle\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex33Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex33Xa.m2" class="ltx_Math" alttext="\displaystyle=\|{\bm{W}}^{[2]}\|_{2}^{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}(\cos\psi_{i}-\cos\zeta\cos\varphi_{i})." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.0835em" rspace="0.167em">∥</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mi>cos</mi><mi>ψ</mi><msub><mrow></mrow><mi>i</mi></msub><mo>−</mo><mi>cos</mi><mi>ζ</mi><mi>cos</mi><mi>φ</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\|{\bm{W}}^{[2]}\|_{2}^{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}(\cos\psi_{i}-\cos\zeta\cos\varphi_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.6" class="ltx_p"><span id="A1.SS2.p18.6.1" class="ltx_text">Note that <math id="A1.SS2.p18.m8" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\cos\psi_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\cos\psi_{i}=1</annotation></semantics></math> for <math id="A1.SS2.p18.m9" class="ltx_Math" alttext="i\in C_{1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">i\in C_{1}</annotation></semantics></math>. So for every <math id="A1.SS2.p18.m10" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>, there exists <math id="A1.SS2.p18.m11" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> such that</span></p>
<table id="A1.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex34.m1" class="ltx_Math" alttext="1-\varepsilon\leq\cos\psi_{i}\leq 1,\quad t\in(T^{*}-\delta,T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo>≤</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>ψ</mi><mi>i</mi></msub></mrow><mo>≤</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>−</mo><mi>δ</mi></mrow><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1-\varepsilon\leq\cos\psi_{i}\leq 1,\quad t\in(T^{*}-\delta,T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.7" class="ltx_p"><span id="A1.SS2.p18.7.1" class="ltx_text">Set <math id="A1.SS2.p18.m12" class="ltx_Math" alttext="\bar{t}_{i}=T^{*}-\delta" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">\bar{t}_{i}=T^{*}-\delta</annotation></semantics></math> and <math id="A1.SS2.p18.m13" class="ltx_Math" alttext="\bar{\theta}_{i}=\arccos(1-\varepsilon)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><mi>arccos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\theta}_{i}=\arccos(1-\varepsilon)</annotation></semantics></math>. Then we have either <math id="A1.SS2.p18.m14" class="ltx_Math" alttext="\cos\varphi_{i}\geq\cos\bar{\theta}_{i},\ t\in(\bar{t}_{i},T^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>≥</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\cos\varphi_{i}\geq\cos\bar{\theta}_{i},\ t\in(\bar{t}_{i},T^{*})</annotation></semantics></math>, or there exists <math id="A1.SS2.p18.m15" class="ltx_Math" alttext="t\in(\bar{t}_{i},T^{*})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(\bar{t}_{i},T^{*})</annotation></semantics></math> such that <math id="A1.SS2.p18.m16" class="ltx_Math" alttext="\cos\varphi_{i}\leq\cos\bar{\theta}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>≤</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\cos\varphi_{i}\leq\cos\bar{\theta}_{i}</annotation></semantics></math>, then it will increase monotonically until it goes up to <math id="A1.SS2.p18.m17" class="ltx_Math" alttext="\bar{\theta}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\bar{\theta}_{i}</annotation></semantics></math>. No matter in which case, we can find <math id="A1.SS2.p18.m18" class="ltx_Math" alttext="\tilde{\theta}_{i}\in[0,\frac{\pi}{2})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>i</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\theta}_{i}\in[0,\frac{\pi}{2})</annotation></semantics></math> such that <math id="A1.SS2.p18.m19" class="ltx_Math" alttext="\cos\varphi_{i}\geq\cos\tilde{\theta}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>≥</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\cos\varphi_{i}\geq\cos\tilde{\theta}_{i}</annotation></semantics></math>. Let <math id="A1.SS2.p18.m20" class="ltx_Math" alttext="T_{1}=\max_{i\in C_{1}}\bar{t}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>t</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">T_{1}=\max_{i\in C_{1}}\bar{t}_{i}</annotation></semantics></math> and <math id="A1.SS2.p18.m21" class="ltx_Math" alttext="\Theta_{1}=\max_{i\in C_{1}}\tilde{\theta}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Theta_{1}=\max_{i\in C_{1}}\tilde{\theta}_{i}</annotation></semantics></math>. Thus, for each <math id="A1.SS2.p18.m22" class="ltx_Math" alttext="i\in C_{1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">i\in C_{1}</annotation></semantics></math>, the following inequality holds</span></p>
<table id="A1.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex35.m1" class="ltx_Math" alttext="\cos\varphi_{i}\geq\cos\Theta_{1},\quad t\in(T_{1},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi>φ</mi><mi>i</mi></msub></mrow><mo>≥</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\varphi_{i}\geq\cos\Theta_{1},\quad t\in(T_{1},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.8" class="ltx_p"><span id="A1.SS2.p18.8.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p19" class="ltx_para">
<p id="A1.SS2.p19.1" class="ltx_p">In fact, Proposition <a href="#Thmprop6" title="Proposition 6. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> provides the angular relationship between
<math id="A1.SS2.p19.m1" class="ltx_Math" alttext="{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[2]}</annotation></semantics></math> and its derivative <math id="A1.SS2.p19.m2" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[2]}</annotation></semantics></math>. We summarize it as follows.</p>
</div>
<div id="Thmprop7" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop7.2" class="ltx_text ltx_font_bold">Proposition 7</span></span><span id="Thmprop7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop7.p1" class="ltx_para">
<p id="Thmprop7.p1.1" class="ltx_p"><span id="Thmprop7.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Consider the effective dynamics Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>).
There exists <math id="Thmprop7.p1.m1" class="ltx_Math" alttext="T_{2}\in(T_{1},T^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{2}\in(T_{1},T^{*})</annotation></semantics></math> and <math id="Thmprop7.p1.m2" class="ltx_Math" alttext="\Theta_{2}\in[0,\frac{\pi}{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta_{2}\in[0,\frac{\pi}{2})</annotation></semantics></math> such that</span></p>
<table id="A1.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E36.m1" class="ltx_Math" alttext="\cos\zeta\geq\cos\Theta_{2},\quad t\in(T_{2},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ζ</mi></mrow><mo>≥</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>2</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\zeta\geq\cos\Theta_{2},\quad t\in(T_{2},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="Thmprop7.p1.2" class="ltx_p"><span id="Thmprop7.p1.2.1" class="ltx_text ltx_font_italic">Moreover, recall the definition of energy <math id="Thmprop7.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, the following inequality holds</span></p>
<table id="A1.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E37.m1" class="ltx_Math" alttext="E=\langle{\bm{W}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle\geq\cos\Theta_{2}\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2},\quad t\in(T_{2},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo>≥</mo><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>2</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E=\langle{\bm{W}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle\geq\cos\Theta_{2}\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2},\quad t\in(T_{2},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p20" class="ltx_para">
<p id="A1.SS2.p20.1" class="ltx_p"><span id="A1.SS2.p20.1.1" class="ltx_text">By definition of <math id="A1.SS2.p20.m1" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math>, we obtain</span></p>
<table id="A1.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex36.m1" class="ltx_Math" alttext="\cos\zeta=\frac{\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle}{\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}}=\frac{\langle\sum_{j=1}^{m}{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}^{[2]}\rangle}{\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ζ</mi></mrow><mo>=</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\zeta=\frac{\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle}{\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}}=\frac{\langle\sum_{j=1}^{m}{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i},{\bm{W}}^{[2]}\rangle}{\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p20.2" class="ltx_p"><span id="A1.SS2.p20.2.1" class="ltx_text">According to Proposition <a href="#Thmprop6" title="Proposition 6. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we have</span></p>
<table id="A1.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex37.m1" class="ltx_math_unparsed" alttext="\cos\zeta\geq\cos\Theta_{1}\frac{\sum_{i\in C_{1}}\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}},\quad t\in(T_{1},T^{*})." display="block" intent=":literal"><semantics><mrow><mi>cos</mi><mi>ζ</mi><mo>≥</mo><mi>cos</mi><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mfrac><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo rspace="1.167em">,</mo><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\zeta\geq\cos\Theta_{1}\frac{\sum_{i\in C_{1}}\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}},\quad t\in(T_{1},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p20.3" class="ltx_p"><span id="A1.SS2.p20.3.1" class="ltx_text">Since we have shown that <math id="A1.SS2.p20.m2" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\sum_{i\in C_{1}}\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mfrac><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></msub></mstyle><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\sum_{i\in C_{1}}\|{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}\|_{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}}=1</annotation></semantics></math> according to the proof of Proposition <a href="#Thmprop5" title="Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, there exists <math id="A1.SS2.p20.m3" class="ltx_Math" alttext="T_{2}\in(T_{1},T^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{2}\in(T_{1},T^{*})</annotation></semantics></math> and <math id="A1.SS2.p20.m4" class="ltx_Math" alttext="\Theta_{2}\in[0,\frac{\pi}{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta_{2}\in[0,\frac{\pi}{2})</annotation></semantics></math> such that</span></p>
<table id="A1.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex38.m1" class="ltx_Math" alttext="\cos\zeta\geq\cos\Theta_{2},\quad t\in(T_{2},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><mi>ζ</mi></mrow><mo>≥</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>2</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\cos\zeta\geq\cos\Theta_{2},\quad t\in(T_{2},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p20.4" class="ltx_p"><span id="A1.SS2.p20.4.1" class="ltx_text">Recall the definition of energy <math id="A1.SS2.p20.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, we have</span></p>
<table id="A1.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex39.m1" class="ltx_Math" alttext="E=\langle{\bm{W}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle\geq\left(\cos\Theta_{2}\right)\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2},\quad t\in(T_{2},T^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo>≥</mo><mrow><mrow><mo>(</mo><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>2</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E=\langle{\bm{W}}^{[2]},\dot{{\bm{W}}}^{[2]}\rangle\geq\left(\cos\Theta_{2}\right)\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2},\quad t\in(T_{2},T^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p20.5" class="ltx_p"><span id="A1.SS2.p20.5.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p21" class="ltx_para">
<p id="A1.SS2.p21.1" class="ltx_p">Now we prove the proposition with all preparations above.</p>
</div>
<div id="Thmprop8" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop8.2" class="ltx_text ltx_font_bold">Proposition 8</span></span><span id="Thmprop8.3" class="ltx_text ltx_font_bold"> </span>(energy upper bound and blow up estimate)<span id="Thmprop8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop8.p1" class="ltx_para">
<p id="Thmprop8.p1.1" class="ltx_p"><span id="Thmprop8.p1.1.1" class="ltx_text ltx_font_italic">Suppose that Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Consider the effective dynamics Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>). There exist <math id="Thmprop8.p1.m1" class="ltx_Math" alttext="T_{3}\in(T_{2},T^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>2</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{3}\in(T_{2},T^{*})</annotation></semantics></math> and <math id="Thmprop8.p1.m2" class="ltx_Math" alttext="C\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C\geq 1</annotation></semantics></math> such that the following upper bound of Energy <math id="Thmprop8.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> holds</span></p>
<table id="A1.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E38.m1" class="ltx_Math" alttext="E(t)\leq\frac{1}{\left(E(s)^{-\frac{1}{3}}-C(t-s)\right)^{3}},\quad T_{3}\leq s&lt;t&lt;T^{*}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msup><mrow><mo>(</mo><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>3</mn></msup></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>≤</mo><mi>s</mi><mo>&lt;</mo><mi>t</mi><mo>&lt;</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E(t)\leq\frac{1}{\left(E(s)^{-\frac{1}{3}}-C(t-s)\right)^{3}},\quad T_{3}\leq s&lt;t&lt;T^{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="Thmprop8.p1.2" class="ltx_p"><span id="Thmprop8.p1.2.1" class="ltx_text ltx_font_italic">Moreover, the blow up time <math id="Thmprop8.p1.m4" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math> is bounded below by</span></p>
<table id="A1.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E39.m1" class="ltx_Math" alttext="T^{*}\geq t+\frac{E(t)^{-\frac{1}{3}}}{C},\quad t&lt;T^{*}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>≥</mo><mrow><mi>t</mi><mo>+</mo><mfrac><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mi>C</mi></mfrac></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>t</mi><mo>&lt;</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{*}\geq t+\frac{E(t)^{-\frac{1}{3}}}{C},\quad t&lt;T^{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS2.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p22" class="ltx_para">
<p id="A1.SS2.p22.1" class="ltx_p"><span id="A1.SS2.p22.1.1" class="ltx_text">First, by calculating the derivative of energy <math id="A1.SS2.p22.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, we have</span></p>
<table id="A1.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex40.m1" class="ltx_Math" alttext="\dot{E}=\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}+\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}+\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{E}=\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}+\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}+\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p22.2" class="ltx_p"><span id="A1.SS2.p22.2.1" class="ltx_text">We rewrite the derivative of energy <math id="A1.SS2.p22.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> as</span></p>
<table id="A1.Ex41" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex41X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex41X.m2" class="ltx_Math" alttext="\displaystyle\dot{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>˙</mo></mover><annotation encoding="application/x-tex">\displaystyle\dot{E}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41X.m3" class="ltx_Math" alttext="\displaystyle=\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}\left(1+\frac{\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}+\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}\left(1+\frac{\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}+\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex41Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex41Xa.m2" class="ltx_Math" alttext="\displaystyle=\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{4}{3}}\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}}\frac{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{2}{3}}}{\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}}}\left(1+\frac{\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}+\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>4</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>4</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>4</mn><mn>3</mn></mfrac></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{4}{3}}\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}}\frac{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{2}{3}}}{\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}}}\left(1+\frac{\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}+\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p22.3" class="ltx_p"><span id="A1.SS2.p22.3.1" class="ltx_text">According to conservation laws and Equation (<a href="#A1.E22" title="In item (iii) ‣ Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), there exists <math id="A1.SS2.p22.m3" class="ltx_Math" alttext="T_{3}&gt;T_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>&gt;</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">T_{3}&gt;T_{2}</annotation></semantics></math> such that</span></p>
<table id="A1.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex42.m1" class="ltx_Math" alttext="\frac{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{2}{3}}}{\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}}}\left(1+\frac{\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}+\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}\right)\leq 4." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msubsup><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>4</mn><mn>3</mn></mfrac></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac><mo>+</mo><mfrac><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mfrac></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mn>4</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{2}{3}}}{\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}}}\left(1+\frac{\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}+\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}}\right)\leq 4.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p22.4" class="ltx_p"><span id="A1.SS2.p22.4.1" class="ltx_text">Then we have</span></p>
<table id="A1.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex43.m1" class="ltx_Math" alttext="\dot{E}\leq 4\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{4}{3}}\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}},\quad\forall t&gt;T_{3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>4</mn><mn>3</mn></mfrac></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mfrac><mn>4</mn><mn>3</mn></mfrac></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>&gt;</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{E}\leq 4\|\dot{{\bm{W}}}^{[2]}\|_{2}^{\frac{4}{3}}\|{\bm{W}}^{[2]}\|_{2}^{\frac{4}{3}},\quad\forall t&gt;T_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p22.5" class="ltx_p"><span id="A1.SS2.p22.5.1" class="ltx_text">Based on Proposition <a href="#Thmprop7" title="Proposition 7. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we have</span></p>
<table id="A1.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex44.m1" class="ltx_Math" alttext="\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}\leq\frac{1}{\cos\Theta_{2}}E,\quad\forall t&gt;T_{3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>&gt;</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|{\bm{W}}^{[2]}\|_{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}\leq\frac{1}{\cos\Theta_{2}}E,\quad\forall t&gt;T_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p22.6" class="ltx_p"><span id="A1.SS2.p22.6.1" class="ltx_text">Thus we obtain</span></p>
<table id="A1.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex45.m1" class="ltx_Math" alttext="\dot{E}\leq 4(\frac{1}{\cos\Theta_{2}})^{\frac{4}{3}}E,\quad\forall t&gt;T_{3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow></mfrac><mo stretchy="false">)</mo></mrow><mfrac><mn>4</mn><mn>3</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>&gt;</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{E}\leq 4(\frac{1}{\cos\Theta_{2}})^{\frac{4}{3}}E,\quad\forall t&gt;T_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p22.7" class="ltx_p"><span id="A1.SS2.p22.7.1" class="ltx_text">We denote <math id="A1.SS2.p22.m4" class="ltx_Math" alttext="4(\frac{1}{\cos\Theta_{2}})^{\frac{4}{3}}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mrow><mi>cos</mi><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub></mrow></mfrac><mo stretchy="false">)</mo></mrow><mfrac><mn>4</mn><mn>3</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">4(\frac{1}{\cos\Theta_{2}})^{\frac{4}{3}}</annotation></semantics></math> as <math id="A1.SS2.p22.m5" class="ltx_Math" alttext="C_{0}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>0</mn></msub><annotation encoding="application/x-tex">C_{0}</annotation></semantics></math>. Then we have <math id="A1.SS2.p22.m6" class="ltx_Math" alttext="C_{0}\geq 4" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">C_{0}\geq 4</annotation></semantics></math> and</span></p>
<table id="A1.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex46.m1" class="ltx_Math" alttext="\dot{E}\leq C_{0}E^{\frac{4}{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo>≤</mo><mrow><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mfrac><mn>4</mn><mn>3</mn></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{E}\leq C_{0}E^{\frac{4}{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p23" class="ltx_para">
<p id="A1.SS2.p23.1" class="ltx_p"><span id="A1.SS2.p23.1.1" class="ltx_text">Opposite to proof of Theorem <a href="#Thmthm1" title="Theorem 1 (Blow-up in finite time). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we obtain</span></p>
<table id="A1.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex47.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}E^{-\frac{1}{3}}\geq-\frac{1}{3}C_{0},\quad\forall t&gt;T_{3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>≥</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>&gt;</mo><msub><mi>T</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}E^{-\frac{1}{3}}\geq-\frac{1}{3}C_{0},\quad\forall t&gt;T_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p23.2" class="ltx_p"><span id="A1.SS2.p23.2.1" class="ltx_text">We denote <math id="A1.SS2.p23.m1" class="ltx_Math" alttext="\frac{C_{0}}{3}" display="inline" intent=":literal"><semantics><mfrac><msub><mi>C</mi><mn>0</mn></msub><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{C_{0}}{3}</annotation></semantics></math> as <math id="A1.SS2.p23.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. Thus <math id="A1.SS2.p23.m3" class="ltx_Math" alttext="C\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C\geq 1</annotation></semantics></math> and we have</span></p>
<table id="A1.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E40.m1" class="ltx_Math" alttext="E(t)\leq\frac{1}{\left({E(s)}^{-\frac{1}{3}}-C(t-s)\right)^{3}},\quad T_{3}&lt;s&lt;t&lt;T^{*}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msup><mrow><mo>(</mo><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>3</mn></msup></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>T</mi><mn>3</mn></msub><mo>&lt;</mo><mi>s</mi><mo>&lt;</mo><mi>t</mi><mo>&lt;</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E(t)\leq\frac{1}{\left({E(s)}^{-\frac{1}{3}}-C(t-s)\right)^{3}},\quad T_{3}&lt;s&lt;t&lt;T^{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p23.3" class="ltx_p"><span id="A1.SS2.p23.3.1" class="ltx_text">Hence, for each time <math id="A1.SS2.p23.m4" class="ltx_Math" alttext="t&lt;T^{*}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">t&lt;T^{*}</annotation></semantics></math>, the time of blow up is bounded below by</span></p>
<table id="A1.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E41.m1" class="ltx_Math" alttext="T^{*}\geq t+\frac{E(t)^{-\frac{1}{3}}}{C}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>≥</mo><mrow><mi>t</mi><mo>+</mo><mfrac><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mi>C</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{*}\geq t+\frac{E(t)^{-\frac{1}{3}}}{C}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p23.4" class="ltx_p"><span id="A1.SS2.p23.4.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p24" class="ltx_para">
<p id="A1.SS2.p24.1" class="ltx_p">Now we begin the proof for Theorem <a href="#Thmthm2" title="Theorem 2 (Condensation). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="A1.SS2.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p25" class="ltx_para">
<p id="A1.SS2.p25.1" class="ltx_p"><span id="A1.SS2.p25.1.1" class="ltx_text">We just prove the case for <math id="A1.SS2.p25.m1" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}&gt;0</annotation></semantics></math>. And the case for <math id="A1.SS2.p25.m2" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}&lt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}&lt;0</annotation></semantics></math> follows by similar argument. Because the derivative of <math id="A1.SS2.p25.m3" class="ltx_Math" alttext="{\bm{W}}_{\bm{v},i}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v},i}</annotation></semantics></math> is <math id="A1.SS2.p25.m4" class="ltx_Math" alttext="{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}</annotation></semantics></math>, we only need to show that</span></p>
<table id="A1.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E42.m1" class="ltx_Math" alttext="\int_{T_{3}}^{T^{*}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}~\mathrm{d}t=+\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><msub><mi>T</mi><mn>3</mn></msub><msup><mi>T</mi><mo>∗</mo></msup></msubsup><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{T_{3}}^{T^{*}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}~\mathrm{d}t=+\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p25.2" class="ltx_p"><span id="A1.SS2.p25.2.1" class="ltx_text">Since <math id="A1.SS2.p25.m5" class="ltx_Math" alttext="\lim_{t\rightarrow T^{*}}\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow T^{*}}\frac{\|{\bm{W}}^{[2]}\|_{2}^{2}}{\|\dot{{\bm{W}}}^{[2]}\|_{2}}=1</annotation></semantics></math> due to the statement (iii) of Proposition <a href="#Thmprop5" title="Proposition 5. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, there exists <math id="A1.SS2.p25.m6" class="ltx_Math" alttext="T_{4}&gt;T_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>4</mn></msub><mo>&gt;</mo><msub><mi>T</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">T_{4}&gt;T_{3}</annotation></semantics></math> such that <math id="A1.SS2.p25.m7" class="ltx_Math" alttext="\|\dot{{\bm{W}}}^{[2]}\|_{2}\leq 2\sqrt{2}\|{\bm{W}}^{[2]}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\|\dot{{\bm{W}}}^{[2]}\|_{2}\leq 2\sqrt{2}\|{\bm{W}}^{[2]}\|_{2}^{2}</annotation></semantics></math>, which implies</span></p>
<table id="A1.E43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E43.m1" class="ltx_Math" alttext="E=\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\leq\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}\lVert{\bm{W}}^{[2]}\rVert_{2}\leq 2\sqrt{2}\lVert{\bm{W}}^{[2]}\rVert_{2}^{3}." display="block" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo rspace="0.1389em">≤</mo><mrow><msub><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mn>2</mn></msub></mrow><mo lspace="0.1389em">≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn><mn>3</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E=\langle\dot{{\bm{W}}}^{[2]},{\bm{W}}^{[2]}\rangle\leq\lVert\dot{{\bm{W}}}^{[2]}\rVert_{2}\lVert{\bm{W}}^{[2]}\rVert_{2}\leq 2\sqrt{2}\lVert{\bm{W}}^{[2]}\rVert_{2}^{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.p26" class="ltx_para">
<p id="A1.SS2.p26.1" class="ltx_p"><span id="A1.SS2.p26.1.1" class="ltx_text">The idea is we can find a infinite division of <math id="A1.SS2.p26.m1" class="ltx_Math" alttext="(T_{4},T^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>4</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T_{4},T^{*})</annotation></semantics></math> such that the integral of <math id="A1.SS2.p26.m2" class="ltx_Math" alttext="{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}</annotation></semantics></math> on each sub-interval is larger than positive constant which is an independent constant.
Then we consider the integral <math id="A1.SS2.p26.m3" class="ltx_Math" alttext="\int_{t_{1}}^{t_{2}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub></msubsup><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\int_{t_{1}}^{t_{2}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\mathrm{d}t</annotation></semantics></math>. By direct calculation of the derivative of <math id="A1.SS2.p26.m4" class="ltx_Math" alttext="{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}</annotation></semantics></math>, we have</span></p>
<table id="A1.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex48.m1" class="ltx_Math" alttext="\dot{({\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]})}={\bm{W}}_{\bm{v},i}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}+{\bm{W}}^{[1]}_{i}\left(\sum_{j}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo>˙</mo></mover><mo>=</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>+</mo><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>j</mi></munder><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{({\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]})}={\bm{W}}_{\bm{v},i}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}+{\bm{W}}^{[1]}_{i}\left(\sum_{j}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p26.2" class="ltx_p"><span id="A1.SS2.p26.2.1" class="ltx_text">Integrating both sides of the equality, we have</span></p>
<table id="A1.Ex49" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex49X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex49X.m2" class="ltx_Math" alttext="\displaystyle({\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]})(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]})(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex49X.m3" class="ltx_Math" alttext="\displaystyle=({\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]})(t_{1})+\int_{t_{1}}^{t}{\bm{W}}_{\bm{v},i}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}+{\bm{W}}^{[1]}_{i}\left(\sum_{j}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right)\mathrm{d}s" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><mi>t</mi></msubsup></mstyle><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder></mstyle><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]})(t_{1})+\int_{t_{1}}^{t}{\bm{W}}_{\bm{v},i}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}+{\bm{W}}^{[1]}_{i}\left(\sum_{j}{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1]}_{j}\right)\mathrm{d}s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex49Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex49Xa.m2" class="ltx_Math" alttext="\displaystyle\geq{\bm{W}}_{\bm{v},i}(T_{4})\int_{t_{1}}^{t}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}\mathrm{d}s." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><mi>t</mi></msubsup></mstyle><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq{\bm{W}}_{\bm{v},i}(T_{4})\int_{t_{1}}^{t}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}\mathrm{d}s.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p26.3" class="ltx_p"><span id="A1.SS2.p26.3.1" class="ltx_text">Note that Eq. (<a href="#A1.E43" title="In Proof. ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>) implies</span></p>
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex50.m1" class="ltx_Math" alttext="\displaystyle\int_{t_{1}}^{t}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}\mathrm{d}s" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><mi>t</mi></msubsup></mstyle><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{t_{1}}^{t}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}\mathrm{d}s</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex50.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\int_{t_{1}}^{t}E^{\frac{2}{3}}(s)\mathrm{d}s" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><mi>t</mi></msubsup></mstyle><mrow><msup><mi>E</mi><mfrac><mn>2</mn><mn>3</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\int_{t_{1}}^{t}E^{\frac{2}{3}}(s)\mathrm{d}s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex51.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{2}\int_{t_{1}}^{t}\frac{1}{(E(t_{1})^{-\frac{1}{3}}-(s-t_{1}))^{2}}\mathrm{d}s" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><mi>t</mi></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo>−</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{2}\int_{t_{1}}^{t}\frac{1}{(E(t_{1})^{-\frac{1}{3}}-(s-t_{1}))^{2}}\mathrm{d}s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex52.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2}\left[\frac{1}{E(t_{1})^{-{\frac{1}{3}}}-(t-t_{1})}-\frac{1}{E(t_{1})^{-\frac{1}{3}}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2}\left[\frac{1}{E(t_{1})^{-{\frac{1}{3}}}-(t-t_{1})}-\frac{1}{E(t_{1})^{-\frac{1}{3}}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p26.4" class="ltx_p"><span id="A1.SS2.p26.4.1" class="ltx_text">Thus the integral satisfies</span></p>
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex53.m1" class="ltx_Math" alttext="\displaystyle\int_{t_{1}}^{t_{2}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub></msubsup></mstyle><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{t_{1}}^{t_{2}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex53.m2" class="ltx_Math" alttext="\displaystyle\geq{\bm{W}}_{\bm{v},i}(T_{4})\frac{1}{2}\int_{t_{1}}^{t_{2}}\frac{1}{E(t_{1})^{-{\frac{1}{3}}}-(t-t_{1})}-\frac{1}{E(t_{1})^{-\frac{1}{3}}}\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq{\bm{W}}_{\bm{v},i}(T_{4})\frac{1}{2}\int_{t_{1}}^{t_{2}}\frac{1}{E(t_{1})^{-{\frac{1}{3}}}-(t-t_{1})}-\frac{1}{E(t_{1})^{-\frac{1}{3}}}\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex54.m1" class="ltx_Math" alttext="\displaystyle={\bm{W}}_{\bm{v},i}(T_{4})\frac{1}{2}\left[-\ln(E(t_{1})^{-\frac{1}{3}}-(t_{2}-t_{1}))+\ln(E(t_{1})^{-\frac{1}{3}})-\frac{t_{2}-t_{1}}{E(t_{1})^{-\frac{1}{3}}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>−</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>−</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{W}}_{\bm{v},i}(T_{4})\frac{1}{2}\left[-\ln(E(t_{1})^{-\frac{1}{3}}-(t_{2}-t_{1}))+\ln(E(t_{1})^{-\frac{1}{3}})-\frac{t_{2}-t_{1}}{E(t_{1})^{-\frac{1}{3}}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p26.5" class="ltx_p"><span id="A1.SS2.p26.5.1" class="ltx_text">According to Theorem <a href="#Thmprop8" title="Proposition 8 (energy upper bound and blow up estimate). ‣ A.2 Theory Details for Condensation ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, we can choose <math id="A1.SS2.p26.m5" class="ltx_Math" alttext="t_{2}-t_{1}=\frac{E(t_{1})^{-\frac{1}{3}}}{2C}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>−</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mo>=</mo><mfrac><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">t_{2}-t_{1}=\frac{E(t_{1})^{-\frac{1}{3}}}{2C}</annotation></semantics></math>. Thus we obtain</span></p>
<table id="A1.E44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E44.m1" class="ltx_Math" alttext="\int_{t_{1}}^{t_{2}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\mathrm{d}t\geq{\bm{W}}_{\bm{v},i}(T_{4})\frac{1}{2}\left[\ln\frac{1}{1-\frac{1}{2C}}-\frac{1}{2C}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub></msubsup><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mrow></mfrac></mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{t_{1}}^{t_{2}}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}\mathrm{d}t\geq{\bm{W}}_{\bm{v},i}(T_{4})\frac{1}{2}\left[\ln\frac{1}{1-\frac{1}{2C}}-\frac{1}{2C}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p26.6" class="ltx_p"><span id="A1.SS2.p26.6.1" class="ltx_text">Then we introduce auxiliary function</span></p>
<table id="A1.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex55.m1" class="ltx_Math" alttext="\displaystyle f(t)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex55.m2" class="ltx_Math" alttext="\displaystyle=\ln\frac{1}{1-t}-t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><mo>−</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ln\frac{1}{1-t}-t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex56.m1" class="ltx_Math" alttext="\displaystyle=-\ln(1-t)-t." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>t</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\ln(1-t)-t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p26.7" class="ltx_p"><span id="A1.SS2.p26.7.1" class="ltx_text">We have <math id="A1.SS2.p26.m6" class="ltx_Math" alttext="f(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(0)=0</annotation></semantics></math> and <math id="A1.SS2.p26.m7" class="ltx_Math" alttext="\dot{f}(t)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\dot{f}(t)&gt;0</annotation></semantics></math>. Then we have <math id="A1.SS2.p26.m8" class="ltx_Math" alttext="\ln\frac{1}{1-\frac{1}{2C}}-\frac{1}{2C}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mrow></mfrac></mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mfrac></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ln\frac{1}{1-\frac{1}{2C}}-\frac{1}{2C}&gt;0</annotation></semantics></math>. Since there are infinitely many such sub-intervals, the proof of the theorem is completed.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Theory details for Key-Query Dynamics</h3>

<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p">This appendix provides the detailed derivations for Proposition <a href="#Thmprop3" title="Proposition 3 (Effective dynamics during dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and Theorem <a href="#Thmthm3" title="Theorem 3 (Asymptotic rank collapse). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, assuming a linear activation function and holding to Assumption <a href="#Thmassump2" title="Assumption 2 (Dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (or its empirical variant, Assumption <a href="#Thmassump3" title="Assumption 2*. ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2*</span></a>). Our approach begins with a standard asymptotic analysis to decompose the loss function, as shown in Eq. (<a href="#S4.E13" title="In 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>).</p>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.2" class="ltx_p">Starting from the definition of the empirical risk, we have:</p>
<table id="A1.E45" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E45X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E45X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}({\bm{\theta}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}({\bm{\theta}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}e^{-y_{i}f_{{\bm{\theta}}}({\bm{X}}_{i})_{s}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>s</mi></msub></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}e^{-y_{i}f_{{\bm{\theta}}}({\bm{X}}_{i})_{s}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(45)</span></td></tr>
<tr id="A1.E45Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\exp\left({-y_{i}\left(\sum_{j=1}^{s}\frac{\exp\left(\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}\right)}{\sum_{l=1}^{s}\exp\left(\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}\right)}{\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac><mo>)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\exp\left({-y_{i}\left(\sum_{j=1}^{s}\frac{\exp\left(\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}\right)}{\sum_{l=1}^{s}\exp\left(\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}\right)}{\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E45Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\exp\Biggl(-y_{i}\sum_{j=1}^{s}\Biggl[\Biggl(\frac{1}{s}+\frac{1}{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>exp</mi><mo maxsize="2.600em" minsize="2.600em">(</mo><mo lspace="0em">−</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>s</mi></msup><mo maxsize="2.600em" minsize="2.600em">[</mo><mo maxsize="2.600em" minsize="2.600em">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\exp\Biggl(-y_{i}\sum_{j=1}^{s}\Biggl[\Biggl(\frac{1}{s}+\frac{1}{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E45Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45Xc.m2" class="ltx_Math" alttext="\displaystyle-\frac{1}{s^{2}}\sum_{l=1}^{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}+\mathcal{O}(\delta^{4})\Biggr){\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\Biggr]\Biggr)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>s</mi><mn>2</mn></msup></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>s</mi></msup><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac></mstyle><mo>+</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="false">(</mo><mi>δ</mi><msup><mrow></mrow><mn>4</mn></msup><mo stretchy="false">)</mo><mo maxsize="2.600em" minsize="2.600em">)</mo><mi>𝑿</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mi>𝑾</mi><msub><mrow></mrow><mi>V</mi></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo maxsize="2.600em" minsize="2.600em">]</mo><mo maxsize="2.600em" minsize="2.600em">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{s^{2}}\sum_{l=1}^{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}+\mathcal{O}(\delta^{4})\Biggr){\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\Biggr]\Biggr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.2" class="ltx_p">The third equality results from applying a Taylor expansion to the softmax function, which is justified by Assumption <a href="#Thmassump2" title="Assumption 2 (Dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. The higher-order term, <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="\mathcal{O}(\delta^{4})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>4</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta^{4})</annotation></semantics></math>, is subsequently omitted as it does not affect the leading-order training dynamics. Given the property of the exponential loss function, <math id="A1.SS3.p3.m2" class="ltx_Math" alttext="\ell(q)=e^{-q}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\ell(q)=e^{-q}</annotation></semantics></math>, the empirical loss can be decomposed as follows:</p>
<table id="A1.E46" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E46X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E46X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}({\bm{\theta}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}({\bm{\theta}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\exp\left({-y_{i}\left(\sum_{j=1}^{s}\frac{1}{s}{\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\exp\left({-y_{i}\left(\sum_{j=1}^{s}\frac{1}{s}{\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(46)</span></td></tr>
<tr id="A1.E46Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46Xa.m2" class="ltx_Math" alttext="\displaystyle\cdot\exp\left({-y_{i}\left(\sum_{j=1}^{s}\left(\frac{1}{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}-\frac{1}{s^{2}}\sum_{l=1}^{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}\right){\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.882em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>s</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\exp\left({-y_{i}\left(\sum_{j=1}^{s}\left(\frac{1}{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}-\frac{1}{s^{2}}\sum_{l=1}^{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}\right){\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E46Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p3.3" class="ltx_p">where <math id="A1.SS3.p3.m3" class="ltx_Math" alttext="\mathcal{L}_{1,i}({\bm{\theta}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{1,i}({\bm{\theta}})</annotation></semantics></math> and <math id="A1.SS3.p3.m4" class="ltx_Math" alttext="\mathcal{L}_{2,i}({\bm{\theta}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{2,i}({\bm{\theta}})</annotation></semantics></math> correspond to the two exponential factors in the preceding expression.</p>
</div>
<section id="A1.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.3.1 </span>Proof for Proposition <a href="#Thmprop3" title="Proposition 3 (Effective dynamics during dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> under Assumption <a href="#Thmassump2" title="Assumption 2 (Dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h4>

<div id="A1.SS3.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.SSS1.p1" class="ltx_para">
<p id="A1.SS3.SSS1.p1.1" class="ltx_p"><span id="A1.SS3.SSS1.p1.1.1" class="ltx_text">The proof is structured in two parts. First, we demonstrate the separation of dynamics by showing that the gradients with respect to different sets of weights have different orders of magnitude. Second, we derive the specific dynamics for the key and query matrices.</span></p>
</div>
<div id="A1.SS3.SSS1.p2" class="ltx_para">
<p id="A1.SS3.SSS1.p2.1" class="ltx_p"><span id="A1.SS3.SSS1.p2.1.1" class="ltx_text ltx_font_bold">Dynamics Separation<span id="A1.SS3.SSS1.p2.1.1.1" class="ltx_text ltx_font_medium">: By symmetry, we will detail the calculations for the partial derivatives with respect to <math id="A1.SS3.SSS1.p2.m1" class="ltx_Math" alttext="{\bm{W}}_{V}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>V</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{V}</annotation></semantics></math> and <math id="A1.SS3.SSS1.p2.m2" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math>. The derivations for the other weight matrices follow a similar procedure.</span></span></p>
</div>
<div id="A1.SS3.SSS1.p3" class="ltx_para">
<p id="A1.SS3.SSS1.p3.1" class="ltx_p"><span id="A1.SS3.SSS1.p3.1.1" class="ltx_text">We begin by computing the partial derivative of the loss <math id="A1.SS3.SSS1.p3.m1" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> with respect to <math id="A1.SS3.SSS1.p3.m2" class="ltx_Math" alttext="{\bm{W}}_{V}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>V</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{V}</annotation></semantics></math>. Applying the product rule to the decomposed loss from Eq. (<a href="#A1.E46" title="In A.3 Theory details for Key-Query Dynamics ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a>), we obtain:</span></p>
<table id="A1.E47" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E47X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E47X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\partial}{\partial{\bm{W}}_{V}}\left(\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial}{\partial{\bm{W}}_{V}}\left(\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(47)</span></td></tr>
<tr id="A1.E47Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\mathcal{L}_{2,i}+\mathcal{L}_{1,i}\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{V}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\mathcal{L}_{2,i}+\mathcal{L}_{1,i}\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{V}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E47Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\left(1+\mathcal{O}(\delta^{2})\right)+\mathcal{L}_{1,i}\cdot\mathcal{O}(\delta^{2})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\left(1+\mathcal{O}(\delta^{2})\right)+\mathcal{L}_{1,i}\cdot\mathcal{O}(\delta^{2})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS1.p3.2" class="ltx_p"><span id="A1.SS3.SSS1.p3.2.1" class="ltx_text">The third equality holds based on Assumption <a href="#Thmassump2" title="Assumption 2 (Dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, which implies that <math id="A1.SS3.SSS1.p3.m3" class="ltx_Math" alttext="\mathcal{L}_{2,i}=1+\mathcal{O}(\delta^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{2,i}=1+\mathcal{O}(\delta^{2})</annotation></semantics></math> and its derivative <math id="A1.SS3.SSS1.p3.m4" class="ltx_Math" alttext="\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{V}}</annotation></semantics></math> is also of order <math id="A1.SS3.SSS1.p3.m5" class="ltx_Math" alttext="\mathcal{O}(\delta^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta^{2})</annotation></semantics></math>. Furthermore, Assumption <a href="#Thmassump2" title="Assumption 2 (Dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> states that the leading-order term of the loss, <math id="A1.SS3.SSS1.p3.m6" class="ltx_Math" alttext="\mathcal{L}_{1,i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{1,i}</annotation></semantics></math>, is independent of the attention mechanism weights at initialization. Consequently, the term <math id="A1.SS3.SSS1.p3.m7" class="ltx_Math" alttext="\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}</annotation></semantics></math> is of order <math id="A1.SS3.SSS1.p3.m8" class="ltx_Math" alttext="\mathcal{O}(\delta^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta^{2})</annotation></semantics></math>. This implies that the entire gradient <math id="A1.SS3.SSS1.p3.m9" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}</annotation></semantics></math> is dominated by terms of order <math id="A1.SS3.SSS1.p3.m10" class="ltx_Math" alttext="\mathcal{O}(\delta^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta^{2})</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.SSS1.p4" class="ltx_para">
<p id="A1.SS3.SSS1.p4.1" class="ltx_p"><span id="A1.SS3.SSS1.p4.1.1" class="ltx_text">Next, we consider the partial derivative with respect to <math id="A1.SS3.SSS1.p4.m1" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math>:</span></p>
<table id="A1.E48" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E48X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E48X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{Q}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{Q}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\partial}{\partial{\bm{W}}_{Q}}\left(\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial}{\partial{\bm{W}}_{Q}}\left(\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(48)</span></td></tr>
<tr id="A1.E48Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{Q}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{Q}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS1.p4.2" class="ltx_p"><span id="A1.SS3.SSS1.p4.2.1" class="ltx_text">since <math id="A1.SS3.SSS1.p4.m2" class="ltx_Math" alttext="\mathcal{L}_{1,i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{1,i}</annotation></semantics></math> is independent of <math id="A1.SS3.SSS1.p4.m3" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math>. Based on Assumption <a href="#Thmassump2" title="Assumption 2 (Dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, the term <math id="A1.SS3.SSS1.p4.m4" class="ltx_Math" alttext="\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{Q}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{Q}}</annotation></semantics></math> is of order <math id="A1.SS3.SSS1.p4.m5" class="ltx_Math" alttext="\mathcal{O}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta)</annotation></semantics></math>, which establishes that the overall gradient <math id="A1.SS3.SSS1.p4.m6" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{Q}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{Q}}</annotation></semantics></math> is also of order <math id="A1.SS3.SSS1.p4.m7" class="ltx_Math" alttext="\mathcal{O}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta)</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.SSS1.p5" class="ltx_para">
<p id="A1.SS3.SSS1.p5.1" class="ltx_p"><span id="A1.SS3.SSS1.p5.1.1" class="ltx_text ltx_font_bold">Key-Query Dynamics<span id="A1.SS3.SSS1.p5.1.1.1" class="ltx_text ltx_font_medium">: The principle of dynamics separation, established above, shows that the gradients with respect to <math id="A1.SS3.SSS1.p5.m1" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math> and <math id="A1.SS3.SSS1.p5.m2" class="ltx_Math" alttext="{\bm{W}}_{K}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>K</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{K}</annotation></semantics></math> (order <math id="A1.SS3.SSS1.p5.m3" class="ltx_Math" alttext="\mathcal{O}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta)</annotation></semantics></math>) are significantly larger than those for <math id="A1.SS3.SSS1.p5.m4" class="ltx_Math" alttext="{\bm{W}}_{V},{\bm{W}}^{[1]}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑾</mi><mi>V</mi></msub><mo>,</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{W}}_{V},{\bm{W}}^{[1]},</annotation></semantics></math> and <math id="A1.SS3.SSS1.p5.m5" class="ltx_Math" alttext="{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[2]}</annotation></semantics></math> (order <math id="A1.SS3.SSS1.p5.m6" class="ltx_Math" alttext="\mathcal{O}(\delta^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta^{2})</annotation></semantics></math>). Therefore, during the initial phase of training, the dynamics are dominated by the updates to <math id="A1.SS3.SSS1.p5.m7" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math> and <math id="A1.SS3.SSS1.p5.m8" class="ltx_Math" alttext="{\bm{W}}_{K}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>K</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{K}</annotation></semantics></math>. We can thus analyze their leading-order dynamics by treating the other weight matrices as effectively constant.</span></span></p>
</div>
<div id="A1.SS3.SSS1.p6" class="ltx_para">
<p id="A1.SS3.SSS1.p6.1" class="ltx_p"><span id="A1.SS3.SSS1.p6.1.1" class="ltx_text">To derive these dynamics, we employ matrix calculus with differentials. For a scalar function <math id="A1.SS3.SSS1.p6.m1" class="ltx_Math" alttext="f(\mathbf{X})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\mathbf{X})</annotation></semantics></math> of a matrix variable <math id="A1.SS3.SSS1.p6.m2" class="ltx_Math" alttext="\mathbf{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\mathbf{X}</annotation></semantics></math>, the differential is given by <math id="A1.SS3.SSS1.p6.m3" class="ltx_Math" alttext="\mathrm{d}f=\operatorname{tr}\left(\left(\frac{\partial f}{\partial\mathbf{X}}\right)^{\intercal}\mathrm{d}\mathbf{X}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>=</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mfrac><mrow><mo>∂</mo><mi>f</mi></mrow><mrow><mo>∂</mo><mi>𝐗</mi></mrow></mfrac><mo>)</mo></mrow><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐗</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{d}f=\operatorname{tr}\left(\left(\frac{\partial f}{\partial\mathbf{X}}\right)^{\intercal}\mathrm{d}\mathbf{X}\right)</annotation></semantics></math>. We apply this to the argument of the exponential in <math id="A1.SS3.SSS1.p6.m4" class="ltx_Math" alttext="\mathcal{L}_{2,i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{2,i}</annotation></semantics></math>, which we denote as <math id="A1.SS3.SSS1.p6.m5" class="ltx_Math" alttext="A_{i}({\bm{\theta}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{i}({\bm{\theta}})</annotation></semantics></math>. The differential of <math id="A1.SS3.SSS1.p6.m6" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> with respect to <math id="A1.SS3.SSS1.p6.m7" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math> is:</span></p>
<table id="A1.E49" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E49X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{d}\left(-y_{i}\left(\sum_{j=1}^{s}\left(\frac{1}{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}-\frac{1}{s^{2}}\sum_{l=1}^{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}\right){\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>s</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mo>⊺</mo></msubsup></mrow><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mfrac></mstyle></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{d}\left(-y_{i}\left(\sum_{j=1}^{s}\left(\frac{1}{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,j}^{\intercal}}{\sqrt{d_{m}}}-\frac{1}{s^{2}}\sum_{l=1}^{s}\frac{{\bm{X}}_{i,s}{\bm{W}}_{Q}{\bm{W}}_{K}^{\intercal}{\bm{X}}_{i,l}^{\intercal}}{\sqrt{d_{m}}}\right){\bm{X}}_{i,j}{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(49)</span></td></tr>
<tr id="A1.E49Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E49Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49Xa.m3" class="ltx_Math" alttext="\displaystyle-\frac{y_{i}}{s\sqrt{d_{m}}}{\bm{X}}_{i,s}(\mathrm{d}{\bm{W}}_{Q}){\bm{W}}_{K}^{\intercal}\left[\sum_{j=1}^{s}\left({\bm{X}}_{i,j}^{\intercal}-\frac{1}{s}\sum_{l=1}^{s}{\bm{X}}_{i,l}^{\intercal}\right){\bm{X}}_{i,j}\right]{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>y</mi><mi>i</mi></msub><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>K</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow><mo>⊺</mo></msubsup></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{y_{i}}{s\sqrt{d_{m}}}{\bm{X}}_{i,s}(\mathrm{d}{\bm{W}}_{Q}){\bm{W}}_{K}^{\intercal}\left[\sum_{j=1}^{s}\left({\bm{X}}_{i,j}^{\intercal}-\frac{1}{s}\sum_{l=1}^{s}{\bm{X}}_{i,l}^{\intercal}\right){\bm{X}}_{i,j}\right]{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E49Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E49Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49Xb.m3" class="ltx_Math" alttext="\displaystyle\operatorname{tr}\left(-\frac{y_{i}}{s\sqrt{d_{m}}}{\bm{W}}_{K}\left[\sum_{j=1}^{s}{\bm{X}}_{i,j}^{\intercal}\left({\bm{X}}_{i,j}-\frac{1}{s}\sum_{l=1}^{s}{\bm{X}}_{i,l}\right)\right]{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}{\bm{X}}_{i,s}^{\intercal}(\mathrm{d}{\bm{W}}_{Q})^{\intercal}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>y</mi><mi>i</mi></msub><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><mrow><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>s</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover></mstyle><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊺</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{tr}\left(-\frac{y_{i}}{s\sqrt{d_{m}}}{\bm{W}}_{K}\left[\sum_{j=1}^{s}{\bm{X}}_{i,j}^{\intercal}\left({\bm{X}}_{i,j}-\frac{1}{s}\sum_{l=1}^{s}{\bm{X}}_{i,l}\right)\right]{\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}{\bm{X}}_{i,s}^{\intercal}(\mathrm{d}{\bm{W}}_{Q})^{\intercal}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS1.p6.2" class="ltx_p"><span id="A1.SS3.SSS1.p6.2.1" class="ltx_text">By identifying the coefficient of <math id="A1.SS3.SSS1.p6.m8" class="ltx_Math" alttext="\mathrm{d}{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{d}{\bm{W}}_{Q}</annotation></semantics></math> from the trace form, we obtain the gradient. Consequently, after neglecting higher-order terms, the leading-order dynamics for <math id="A1.SS3.SSS1.p6.m9" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math> under the gradient flow <math id="A1.SS3.SSS1.p6.m10" class="ltx_Math" alttext="\frac{\mathrm{d}{\bm{W}}_{Q}}{\mathrm{d}t}=-\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{Q}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}{\bm{W}}_{Q}}{\mathrm{d}t}=-\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{Q}}</annotation></semantics></math> are given by:</span></p>
<table id="A1.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E50.m1" class="ltx_Math" alttext="\frac{\mathrm{d}{\bm{W}}_{Q}}{\mathrm{d}t}=\frac{1}{s\sqrt{d_{m}}}\sum_{i=1}^{n}y_{i}\mathcal{L}_{1,i}{\bm{X}}_{i,s}^{\intercal}\left({\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)^{\intercal}\left[\sum_{j=1}^{s}{\bm{X}}_{i,j}^{\intercal}\left({\bm{X}}_{i,j}-\frac{1}{s}\sum_{l=1}^{s}{\bm{X}}_{i,l}\right)\right]^{\intercal}{\bm{W}}_{K}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mi>m</mi></msub></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>𝑾</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>)</mo></mrow><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover><mrow><msubsup><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mi>s</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover><msub><mi>𝑿</mi><mrow><mi>i</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>K</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}{\bm{W}}_{Q}}{\mathrm{d}t}=\frac{1}{s\sqrt{d_{m}}}\sum_{i=1}^{n}y_{i}\mathcal{L}_{1,i}{\bm{X}}_{i,s}^{\intercal}\left({\bm{W}}_{V}{\bm{W}}^{[1]}{\bm{W}}^{[2]}\right)^{\intercal}\left[\sum_{j=1}^{s}{\bm{X}}_{i,j}^{\intercal}\left({\bm{X}}_{i,j}-\frac{1}{s}\sum_{l=1}^{s}{\bm{X}}_{i,l}\right)\right]^{\intercal}{\bm{W}}_{K}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A1.SS3.SSS1.p6.3" class="ltx_p"><span id="A1.SS3.SSS1.p6.3.1" class="ltx_text">A symmetric argument yields the corresponding dynamics for <math id="A1.SS3.SSS1.p6.m11" class="ltx_Math" alttext="{\bm{W}}_{K}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>K</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{K}</annotation></semantics></math>. This completes the proof.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Proof for Proposition <a href="#Thmprop3" title="Proposition 3 (Effective dynamics during dynamics separation stage). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> under Assumption <a href="#Thmassump3" title="Assumption 2*. ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2*</span></a></h3>

<div id="A1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p1" class="ltx_para">
<p id="A1.SS4.p1.1" class="ltx_p"><span id="A1.SS4.p1.1.1" class="ltx_text ltx_font_bold">Dynamics Separation<span id="A1.SS4.p1.1.1.1" class="ltx_text ltx_font_medium">: We use another scheme to estimate the gradient. Consider</span></span></p>
<table id="A1.E51" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A1.E51X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E51X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\partial}{\partial{\bm{W}}_{V}}\left(\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\partial}{\partial{\bm{W}}_{V}}\left(\frac{1}{n}\sum_{i=1}^{n}\mathcal{L}_{1,i}({\bm{\theta}})\mathcal{L}_{2,i}({\bm{\theta}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(51)</span></td></tr>
<tr id="A1.E51Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\mathcal{L}_{2,i}+\mathcal{L}_{1,i}\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{V}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\mathcal{L}_{2,i}+\mathcal{L}_{1,i}\frac{\partial\mathcal{L}_{2,i}}{\partial{\bm{W}}_{V}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E51Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\left(1+\mathcal{O}(\delta^{2})\right)+\mathcal{L}_{1,i}\cdot\mathcal{O}(\delta^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\left(\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}\left(1+\mathcal{O}(\delta^{2})\right)+\mathcal{L}_{1,i}\cdot\mathcal{O}(\delta^{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A1.E51Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51Xc.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}+\mathcal{O}(\delta^{2})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}}+\mathcal{O}(\delta^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p"><span id="A1.SS4.p1.2.1" class="ltx_text">Take the inner product of both sides of the equation with <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}</annotation></semantics></math>, we have</span></p>
<table id="A1.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E52.m1" class="ltx_Math" alttext="\left\langle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}\right\rangle=\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}\right\rangle+\mathcal{O}(\delta^{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>⟨</mo><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mrow><mo>⟩</mo></mrow><mo>=</mo><mrow><mrow><mo>⟨</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mrow></mrow><mo>,</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mrow><mo>⟩</mo></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\langle\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}\right\rangle=\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}\right\rangle+\mathcal{O}(\delta^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.3" class="ltx_p"><span id="A1.SS4.p1.3.1" class="ltx_text">However, note that</span></p>
<table id="A1.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E53.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}\widetilde{\mathcal{L}}_{1}=-\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}\right\rangle-\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}^{[1]}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}^{[1]}}\right\rangle-\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}^{[2]}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}^{[2]}}\right\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mn>1</mn></msub></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mrow></mrow><mo>,</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac></mrow><mo>⟩</mo></mrow></mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mfrac></mrow></mrow><mo>,</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mfrac></mrow><mo>⟩</mo></mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mfrac></mrow></mrow><mo>,</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mfrac></mrow><mo>⟩</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}\widetilde{\mathcal{L}}_{1}=-\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}_{V}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}\right\rangle-\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}^{[1]}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}^{[1]}}\right\rangle-\left\langle\frac{1}{n}\sum_{i=1}^{n}\frac{\partial\mathcal{L}_{1,i}}{\partial{\bm{W}}^{[2]}},\frac{\partial\mathcal{L}}{\partial{\bm{W}}^{[2]}}\right\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p1.4" class="ltx_p"><span id="A1.SS4.p1.4.1" class="ltx_text">Based on Assumption <a href="#Thmassump3" title="Assumption 2*. ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2*</span></a>, we have <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝑾</mi><mi>V</mi></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial{\bm{W}}_{V}}</annotation></semantics></math> is <math id="A1.SS4.p1.m3" class="ltx_Math" alttext="\mathcal{O}(\delta^{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\delta^{2})</annotation></semantics></math>. The rest of the proof is similar to the previous one.</span></p>
</div>
<div id="A1.SS4.p2" class="ltx_para">
<p id="A1.SS4.p2.1" class="ltx_p"><span id="A1.SS4.p2.1.1" class="ltx_text ltx_font_bold">Key-Query Dynamics<span id="A1.SS4.p2.1.1.1" class="ltx_text ltx_font_medium">: This part is almost the same. Just need to note that the condition <math id="A1.SS4.p2.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}\!\left(\frac{{\bm{W}}_{V}}{\|{\bm{W}}_{V}\|}\right)=\frac{\mathrm{d}}{\mathrm{d}t}\!\left(\frac{{\bm{W}}^{[1]}}{\|{\bm{W}}^{[1]}\|}\right)=\frac{\mathrm{d}}{\mathrm{d}t}\!\left(\frac{{\bm{W}}^{[2]}}{\|{\bm{W}}^{[2]}\|}\right)\!\approx\!\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi mathvariant="normal">d</mi><mrow><mi mathvariant="normal">d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><msub><mi>𝑾</mi><mi>V</mi></msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>V</mi></msub><mo stretchy="false">‖</mo></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi mathvariant="normal">d</mi><mrow><mi mathvariant="normal">d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi mathvariant="normal">d</mi><mrow><mi mathvariant="normal">d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow></mfrac><mo>)</mo></mrow></mrow><mo lspace="0.108em">≈</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}\!\left(\frac{{\bm{W}}_{V}}{\|{\bm{W}}_{V}\|}\right)=\frac{\mathrm{d}}{\mathrm{d}t}\!\left(\frac{{\bm{W}}^{[1]}}{\|{\bm{W}}^{[1]}\|}\right)=\frac{\mathrm{d}}{\mathrm{d}t}\!\left(\frac{{\bm{W}}^{[2]}}{\|{\bm{W}}^{[2]}\|}\right)\!\approx\!\mathbf{0}</annotation></semantics></math> gives the same <math id="A1.SS4.p2.m2" class="ltx_Math" alttext="{\bm{F}}" display="inline" intent=":literal"><semantics><mi>𝑭</mi><annotation encoding="application/x-tex">{\bm{F}}</annotation></semantics></math> after normalization.</span></span></p>
</div>
<div id="A1.SS4.p3" class="ltx_para">
<p id="A1.SS4.p3.1" class="ltx_p"><span id="A1.SS4.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Proof for Theorem <a href="#Thmthm3" title="Theorem 3 (Asymptotic rank collapse). ‣ 4.4 Key-Query Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A1.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.p1" class="ltx_para">
<p id="A1.SS5.p1.1" class="ltx_p"><span id="A1.SS5.p1.1.1" class="ltx_text">Based on the leading-order dynamics of key-query matrices, we prove the theorem for <math id="A1.SS5.p1.m1" class="ltx_Math" alttext="{\bm{W}}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{Q}</annotation></semantics></math> and the technique for <math id="A1.SS5.p1.m2" class="ltx_Math" alttext="{\bm{W}}_{K}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>K</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{K}</annotation></semantics></math> is similar. Differentiating the dynamics again, we obtain:</span></p>
<table id="A1.E54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E54.m1" class="ltx_Math" alttext="\frac{\mathrm{d}^{2}}{\mathrm{d}t^{2}}{\bm{W}}_{Q}={\bm{F}}{\bm{F}}^{\intercal}{\bm{W}}_{Q}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mi>d</mi><mn>2</mn></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mo>=</mo><mrow><mi>𝑭</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑭</mi><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}^{2}}{\mathrm{d}t^{2}}{\bm{W}}_{Q}={\bm{F}}{\bm{F}}^{\intercal}{\bm{W}}_{Q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.2" class="ltx_p"><span id="A1.SS5.p1.2.1" class="ltx_text">Let the singular value decomposition of <math id="A1.SS5.p1.m3" class="ltx_Math" alttext="{\bm{F}}" display="inline" intent=":literal"><semantics><mi>𝑭</mi><annotation encoding="application/x-tex">{\bm{F}}</annotation></semantics></math> be <math id="A1.SS5.p1.m4" class="ltx_Math" alttext="{\bm{F}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\intercal}" display="inline" intent=":literal"><semantics><mrow><mi>𝑭</mi><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑽</mi><mo>⊺</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{F}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\intercal}</annotation></semantics></math>, then the dynamics can be rewritten as</span></p>
<table id="A1.E55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E55.m1" class="ltx_Math" alttext="\frac{\mathrm{d}^{2}}{\mathrm{d}t^{2}}{\bm{W}}_{Q}={\bm{U}}{\bm{\Sigma}}^{2}{\bm{U}}^{\intercal}{\bm{W}}_{Q}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mi>d</mi><mn>2</mn></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}^{2}}{\mathrm{d}t^{2}}{\bm{W}}_{Q}={\bm{U}}{\bm{\Sigma}}^{2}{\bm{U}}^{\intercal}{\bm{W}}_{Q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.3" class="ltx_p"><span id="A1.SS5.p1.3.1" class="ltx_text">Let <math id="A1.SS5.p1.m5" class="ltx_Math" alttext="\tilde{{\bm{W}}}_{Q}={\bm{U}}^{\intercal}{\bm{W}}_{Q}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>Q</mi></msub><mo>=</mo><mrow><msup><mi>𝑼</mi><mo>⊺</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{{\bm{W}}}_{Q}={\bm{U}}^{\intercal}{\bm{W}}_{Q}{\bm{U}}</annotation></semantics></math>, we have</span></p>
<table id="A1.E56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E56.m1" class="ltx_Math" alttext="\frac{\mathrm{d}^{2}}{\mathrm{d}t^{2}}\tilde{{\bm{W}}}_{Q}={\bm{\Sigma}}^{2}\tilde{{\bm{W}}}_{Q}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mi>d</mi><mn>2</mn></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>Q</mi></msub></mrow><mo>=</mo><mrow><msup><mi>𝚺</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mi>Q</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}^{2}}{\mathrm{d}t^{2}}\tilde{{\bm{W}}}_{Q}={\bm{\Sigma}}^{2}\tilde{{\bm{W}}}_{Q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.4" class="ltx_p"><span id="A1.SS5.p1.4.1" class="ltx_text">The evolutions of entries are</span></p>
<table id="A1.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E57.m1" class="ltx_Math" alttext="\tilde{{\bm{W}}}_{Q,ij}(t)=C_{1,ij}\operatorname{e}^{\lambda_{i}t}+C_{2,ij}\operatorname{e}^{-\lambda_{i}t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>~</mo></mover><mrow><mi>Q</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>C</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>e</mi><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mo lspace="0em">+</mo><mrow><msub><mi>C</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{{\bm{W}}}_{Q,ij}(t)=C_{1,ij}\operatorname{e}^{\lambda_{i}t}+C_{2,ij}\operatorname{e}^{-\lambda_{i}t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.5" class="ltx_p"><span id="A1.SS5.p1.5.1" class="ltx_text">As a result,</span></p>
<table id="A1.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E58.m1" class="ltx_Math" alttext="\operatorname{rank}\left(\lim_{t\rightarrow\infty}\frac{{\bm{W}}_{Q}}{\lVert{\bm{W}}_{Q}\rVert_{\operatorname{F}}}\right)\leq k," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>rank</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><msub><mi>𝑾</mi><mi>Q</mi></msub><msub><mrow><mo fence="true" rspace="0em">∥</mo><msub><mi>𝑾</mi><mi>Q</mi></msub><mo fence="true" lspace="0em">∥</mo></mrow><mi>F</mi></msub></mfrac></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mi>k</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{rank}\left(\lim_{t\rightarrow\infty}\frac{{\bm{W}}_{Q}}{\lVert{\bm{W}}_{Q}\rVert_{\operatorname{F}}}\right)\leq k,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p1.6" class="ltx_p"><span id="A1.SS5.p1.6.1" class="ltx_text">where <math id="A1.SS5.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is the multiplicity of the largest singular value. This result finishes the proof.</span></p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Experimental Details</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">In this section, we present more experimental details to supplement the main text.</p>
</div>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Experimental Setting of Synthetic Dataset</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p">We introduce the dataset construction method and training hyperparameters used to train the synthetic dataset.</p>
</div>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p">First, we give some calculation methods for experimental pictures.</p>
</div>
<div id="A2.SS1.p3" class="ltx_para">
<p id="A2.SS1.p3.1" class="ltx_p"><span id="A2.SS1.p3.1.1" class="ltx_text ltx_font_bold">Satisfaction rate.</span> We denote the conditions in Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> as follows:</p>
<table id="A2.Ex57" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex57X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex57X.m2" class="ltx_Math" alttext="\displaystyle A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle A_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex57X.m3" class="ltx_Math" alttext="\displaystyle=\left\{i\in[d_{m}]\;\middle|\;\bm{W}^{[2]}_{i}\bm{W}_{\bm{v}}\bm{W}^{[1],i}&gt;0,{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}&gt;0\right\}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo>{</mo><mi>i</mi><mo>∈</mo><mo stretchy="false">[</mo><mi>d</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">]</mo><mo stretchy="true">|</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mi>𝑾</mi><msub><mrow></mrow><mi>𝒗</mi></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup><mo>&gt;</mo><mn>0</mn><mo>,</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo>&gt;</mo><mn>0</mn><mo>}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{i\in[d_{m}]\;\middle|\;\bm{W}^{[2]}_{i}\bm{W}_{\bm{v}}\bm{W}^{[1],i}&gt;0,{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1]}_{i}{\bm{W}}^{[2]}&gt;0\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex57Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex57Xa.m2" class="ltx_Math" alttext="\displaystyle A_{2}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle A_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex57Xa.m3" class="ltx_Math" alttext="\displaystyle=\left\{(i,j)\in[d_{m}]\times[d_{m}]\;\middle|\;\langle\bm{W}^{[2]}_{i}\bm{W}^{[1],i},\,\bm{W}^{[2]}_{j}\bm{W}^{[1],j}\rangle&gt;0,\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1],i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1],j}\rangle&gt;0\right\}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo>{</mo><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo><mo>∈</mo><mo stretchy="false">[</mo><mi>d</mi><msub><mrow></mrow><mi>m</mi></msub><mo rspace="0.055em" stretchy="false">]</mo><mo rspace="0.222em">×</mo><mo stretchy="false">[</mo><mi>d</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">]</mo><mo stretchy="true">|</mo><mo stretchy="false">⟨</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup><mo rspace="0.337em">,</mo><mi>𝑾</mi><msup><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><msub><mrow></mrow><mi>j</mi></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup><mo stretchy="false">⟩</mo><mo>&gt;</mo><mn>0</mn><mo>,</mo><mo stretchy="false">⟨</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>i</mi></mrow></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup><mo>,</mo><mi>𝑾</mi><msub><mrow></mrow><mrow><mi>𝒗</mi><mo>,</mo><mi>j</mi></mrow></msub><mi>𝑾</mi><msup><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup><mo stretchy="false">⟩</mo><mo>&gt;</mo><mn>0</mn><mo>}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{(i,j)\in[d_{m}]\times[d_{m}]\;\middle|\;\langle\bm{W}^{[2]}_{i}\bm{W}^{[1],i},\,\bm{W}^{[2]}_{j}\bm{W}^{[1],j}\rangle&gt;0,\langle{\bm{W}}_{\bm{v},i}{\bm{W}}^{[1],i},{\bm{W}}_{\bm{v},j}{\bm{W}}^{[1],j}\rangle&gt;0\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p4" class="ltx_para">
<p id="A2.SS1.p4.1" class="ltx_p"><span id="A2.SS1.p4.1.1" class="ltx_text ltx_font_bold">Cosine similarity.</span> To visualize the internal structure of a weight matrix <math id="A2.SS1.p4.m1" class="ltx_Math" alttext="\mathbf{W}" display="inline" intent=":literal"><semantics><mi>𝐖</mi><annotation encoding="application/x-tex">\mathbf{W}</annotation></semantics></math>, we generate a heatmap of its reordered row-wise cosine similarity matrix. The procedure is as follows: first, the row-wise cosine similarity matrix <math id="A2.SS1.p4.m2" class="ltx_Math" alttext="\mathbf{S}" display="inline" intent=":literal"><semantics><mi>𝐒</mi><annotation encoding="application/x-tex">\mathbf{S}</annotation></semantics></math> is computed, where each entry <math id="A2.SS1.p4.m3" class="ltx_Math" alttext="S_{ij}=\cos(\mathbf{w}_{i},\mathbf{w}_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐰</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐰</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{ij}=\cos(\mathbf{w}_{i},\mathbf{w}_{j})</annotation></semantics></math> measures the similarity between row vectors <math id="A2.SS1.p4.m4" class="ltx_Math" alttext="\mathbf{w}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{w}_{i}</annotation></semantics></math> and <math id="A2.SS1.p4.m5" class="ltx_Math" alttext="\mathbf{w}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mathbf{w}_{j}</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.p5" class="ltx_para">
<p id="A2.SS1.p5.1" class="ltx_p">To reveal underlying block structures, we then employ a spectral reordering technique. This involves finding the principal eigenvector <math id="A2.SS1.p5.m1" class="ltx_Math" alttext="\mathbf{v}_{\max}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mi>max</mi></msub><annotation encoding="application/x-tex">\mathbf{v}_{\max}</annotation></semantics></math> (the one corresponding to the largest eigenvalue) of the similarity matrix <math id="A2.SS1.p5.m2" class="ltx_Math" alttext="\mathbf{S}" display="inline" intent=":literal"><semantics><mi>𝐒</mi><annotation encoding="application/x-tex">\mathbf{S}</annotation></semantics></math>. The sorted order of this eigenvector’s components, <math id="A2.SS1.p5.m3" class="ltx_Math" alttext="\mathcal{P}=\text{argsort}(\mathbf{v}_{\max})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>=</mo><mrow><mtext>argsort</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐯</mi><mi>max</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}=\text{argsort}(\mathbf{v}_{\max})</annotation></semantics></math>, provides a permutation index. By applying this permutation to both the rows and columns of <math id="A2.SS1.p5.m4" class="ltx_Math" alttext="\mathbf{S}" display="inline" intent=":literal"><semantics><mi>𝐒</mi><annotation encoding="application/x-tex">\mathbf{S}</annotation></semantics></math>, we group highly correlated row vectors together, making low-rank patterns visually apparent in the final heatmap.</p>
</div>
<div id="A2.SS1.p6" class="ltx_para">
<p id="A2.SS1.p6.1" class="ltx_p"><span id="A2.SS1.p6.1.1" class="ltx_text ltx_font_bold">Dataset Construction.</span>
We construct synthetic datasets using the concept of the anchor function <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib51" title="" class="ltx_ref">Zhang et al. [2024c]</a></cite>, which enables controlled simulation of linguistic relationships.
Let the set of prompt anchors be <math id="A2.SS1.p6.m1" class="ltx_Math" alttext="\mathcal{A}=\{a\in\mathbb{N}^{+}\mid\alpha_{\min}\leq a\leq\alpha_{\max}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>a</mi><mo>∈</mo><msup><mi>ℕ</mi><mo>+</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>α</mi><mi>min</mi></msub><mo>≤</mo><mi>a</mi><mo>≤</mo><msub><mi>α</mi><mi>max</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}=\{a\in\mathbb{N}^{+}\mid\alpha_{\min}\leq a\leq\alpha_{\max}\}</annotation></semantics></math> and the set of keys be <math id="A2.SS1.p6.m2" class="ltx_Math" alttext="\mathcal{Z}=\{z\in\mathbb{N}^{+}\mid\zeta_{\min}\leq z\leq\zeta_{\max}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>z</mi><mo>∈</mo><msup><mi>ℕ</mi><mo>+</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>ζ</mi><mi>min</mi></msub><mo>≤</mo><mi>z</mi><mo>≤</mo><msub><mi>ζ</mi><mi>max</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}=\{z\in\mathbb{N}^{+}\mid\zeta_{\min}\leq z\leq\zeta_{\max}\}</annotation></semantics></math>, where <math id="A2.SS1.p6.m3" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> and <math id="A2.SS1.p6.m4" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math> are disjoint, i.e., <math id="A2.SS1.p6.m5" class="ltx_Math" alttext="\mathcal{A}\cap\mathcal{Z}=\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>∩</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{A}\cap\mathcal{Z}=\emptyset</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.p7" class="ltx_para">
<p id="A2.SS1.p7.1" class="ltx_p">We define an anchor function <math id="A2.SS1.p7.m1" class="ltx_Math" alttext="\mathcal{F}({\bm{X}}):\mathbb{N}^{s}\rightarrow\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>ℕ</mi><mi>s</mi></msup><mo stretchy="false">→</mo><mi>ℕ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}({\bm{X}}):\mathbb{N}^{s}\rightarrow\mathbb{N}</annotation></semantics></math>, where <math id="A2.SS1.p7.m2" class="ltx_Math" alttext="{\bm{X}}=(x_{1},x_{2},\dots,x_{s})" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{X}}=(x_{1},x_{2},\dots,x_{s})</annotation></semantics></math> is a sequence of length <math id="A2.SS1.p7.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
Each sequence contains exactly one anchor token <math id="A2.SS1.p7.m4" class="ltx_Math" alttext="a\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}</annotation></semantics></math> among the first <math id="A2.SS1.p7.m5" class="ltx_Math" alttext="s-1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s-1</annotation></semantics></math> positions, and the function outputs the token immediately following the anchor, shifted by <math id="A2.SS1.p7.m6" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>:</p>
<table id="A2.E59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E59.m1" class="ltx_Math" alttext="\mathcal{F}(x_{1},\dots,x_{s})=x_{i+1}+a,\quad\text{where }x_{i}=a." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mi>a</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>a</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{F}(x_{1},\dots,x_{s})=x_{i+1}+a,\quad\text{where }x_{i}=a.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p8" class="ltx_para">
<p id="A2.SS1.p8.1" class="ltx_p">In our experiments, we set <math id="A2.SS1.p8.m1" class="ltx_Math" alttext="\mathcal{A}=\{1,2,3,4\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}=\{1,2,3,4\}</annotation></semantics></math>, <math id="A2.SS1.p8.m2" class="ltx_Math" alttext="\mathcal{Z}=\{5,\dots,100\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>100</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}=\{5,\dots,100\}</annotation></semantics></math>, and <math id="A2.SS1.p8.m3" class="ltx_Math" alttext="s=10" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">s=10</annotation></semantics></math>.
To introduce synonymy among anchors, we modify the mapping as</p>
<table id="A2.E60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E60.m1" class="ltx_Math" alttext="\mathcal{F}(x_{1},\dots,x_{s})=x_{i+1}+(a\bmod 2),\quad\text{where }x_{i}=a," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>s</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>a</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{F}(x_{1},\dots,x_{s})=x_{i+1}+(a\bmod 2),\quad\text{where }x_{i}=a,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
<p id="A2.SS1.p8.2" class="ltx_p">so that anchors <math id="A2.SS1.p8.m4" class="ltx_Math" alttext="\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2\}</annotation></semantics></math> and <math id="A2.SS1.p8.m5" class="ltx_Math" alttext="\{3,4\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{3,4\}</annotation></semantics></math> produce equivalent outputs, mimicking synonymous relationships observed in natural language.</p>
</div>
<div id="A2.SS1.p9" class="ltx_para">
<p id="A2.SS1.p9.1" class="ltx_p"><span id="A2.SS1.p9.1.1" class="ltx_text ltx_font_bold">Model and training hyperparameters.</span>
Our model is a decoder-only Transformer with a single layer and a single attention head. The architecture follows the standard GPT design, consisting of a multi-head self-attention block and a position-wise feed-forward network. The Tanh activation function is used in the feed-forward network. A key aspect of our experimental setup is that both the token embedding layer and the final output projection layer are fixed and not updated during training. This allows us to isolate the learning dynamics exclusively within the Transformer’s attention and feed-forward weights.</p>
</div>
<div id="A2.SS1.p10" class="ltx_para">
<p id="A2.SS1.p10.1" class="ltx_p">All trainable weights in the model are initialized from a normal distribution with a mean of 0. The standard deviation for different components is set based on the model dimension <math id="A2.SS1.p10.m1" class="ltx_Math" alttext="d_{\text{model}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>model</mtext></msub><annotation encoding="application/x-tex">d_{\text{model}}</annotation></semantics></math> as <math id="A2.SS1.p10.m2" class="ltx_Math" alttext="\sigma=d_{\text{model}}^{-0.85}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><msubsup><mi>d</mi><mtext>model</mtext><mrow><mo>−</mo><mn>0.85</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\sigma=d_{\text{model}}^{-0.85}</annotation></semantics></math>. The loss is computed only on the prediction of the last token in the sequence.</p>
</div>
<div id="A2.SS1.p11" class="ltx_para">
<p id="A2.SS1.p11.1" class="ltx_p">The model was trained for 30 epochs using the AdamW optimizer. We employed a learning rate scheduler that combines a gradual warmup phase for the first 10 epochs followed by a cosine annealing schedule. The specific hyperparameters are detailed in Table <a href="#A2.T1" title="Table 1 ‣ B.1 Experimental Setting of Synthetic Dataset ‣ Appendix B Experimental Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<figure id="A2.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A2.T1.3" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="A2.T1.4" class="ltx_text" style="font-size:90%;">Model and Training Hyperparameters</span></figcaption>
<table id="A2.T1.5" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A2.T1.5.1" class="ltx_tr">
<td id="A2.T1.5.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T1.5.1.1.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="A2.T1.5.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T1.5.1.2.1" class="ltx_text ltx_font_bold">Value</span></td>
<td id="A2.T1.5.1.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_tt"><span id="A2.T1.5.1.3.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="A2.T1.5.1.4" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T1.5.1.4.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="A2.T1.5.2" class="ltx_tr">
<td id="A2.T1.5.2.1" class="ltx_td ltx_align_left ltx_border_t">Model Architecture</td>
<td id="A2.T1.5.2.2" class="ltx_td ltx_border_t"></td>
<td id="A2.T1.5.2.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t">Training Settings</td>
<td id="A2.T1.5.2.4" class="ltx_td ltx_border_t"></td></tr>
<tr id="A2.T1.5.3" class="ltx_tr">
<td id="A2.T1.5.3.1" class="ltx_td ltx_align_left">Vocabulary Size</td>
<td id="A2.T1.5.3.2" class="ltx_td ltx_align_left">201</td>
<td id="A2.T1.5.3.3" class="ltx_td ltx_nopad_l ltx_align_left">Optimizer</td>
<td id="A2.T1.5.3.4" class="ltx_td ltx_align_left">AdamW</td></tr>
<tr id="A2.T1.5.4" class="ltx_tr">
<td id="A2.T1.5.4.1" class="ltx_td ltx_align_left">Model Dimension (<math id="A2.T1.m1" class="ltx_Math" alttext="d_{\text{model}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>model</mtext></msub><annotation encoding="application/x-tex">d_{\text{model}}</annotation></semantics></math>)</td>
<td id="A2.T1.5.4.2" class="ltx_td ltx_align_left">640</td>
<td id="A2.T1.5.4.3" class="ltx_td ltx_nopad_l ltx_align_left">Batch Size</td>
<td id="A2.T1.5.4.4" class="ltx_td ltx_align_left">1000</td></tr>
<tr id="A2.T1.5.5" class="ltx_tr">
<td id="A2.T1.5.5.1" class="ltx_td ltx_align_left">Feed-Forward Dim. (<math id="A2.T1.m2" class="ltx_Math" alttext="d_{\text{ff}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>ff</mtext></msub><annotation encoding="application/x-tex">d_{\text{ff}}</annotation></semantics></math>)</td>
<td id="A2.T1.5.5.2" class="ltx_td ltx_align_left">1280</td>
<td id="A2.T1.5.5.3" class="ltx_td ltx_nopad_l ltx_align_left">Epochs</td>
<td id="A2.T1.5.5.4" class="ltx_td ltx_align_left">20</td></tr>
<tr id="A2.T1.5.6" class="ltx_tr">
<td id="A2.T1.5.6.1" class="ltx_td ltx_align_left">Key/Value Dim. (<math id="A2.T1.m3" class="ltx_Math" alttext="d_{k},d_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>k</mi></msub><mo>,</mo><msub><mi>d</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">d_{k},d_{v}</annotation></semantics></math>)</td>
<td id="A2.T1.5.6.2" class="ltx_td ltx_align_left">640</td>
<td id="A2.T1.5.6.3" class="ltx_td ltx_nopad_l ltx_align_left">Weight Decay</td>
<td id="A2.T1.5.6.4" class="ltx_td ltx_align_left">0.0</td></tr>
<tr id="A2.T1.5.7" class="ltx_tr">
<td id="A2.T1.5.7.1" class="ltx_td ltx_align_left">Number of Layers</td>
<td id="A2.T1.5.7.2" class="ltx_td ltx_align_left">1</td>
<td id="A2.T1.5.7.3" class="ltx_td ltx_nopad_l ltx_align_left">Gradient Clipping</td>
<td id="A2.T1.5.7.4" class="ltx_td ltx_align_left">1.0</td></tr>
<tr id="A2.T1.5.8" class="ltx_tr">
<td id="A2.T1.5.8.1" class="ltx_td ltx_align_left">Number of Heads</td>
<td id="A2.T1.5.8.2" class="ltx_td ltx_align_left">1</td>
<td id="A2.T1.5.8.3" class="ltx_td ltx_nopad_l ltx_align_left">AdamW <math id="A2.T1.m4" class="ltx_Math" alttext="\beta_{1},\beta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}</annotation></semantics></math></td>
<td id="A2.T1.5.8.4" class="ltx_td ltx_align_left">0.9, 0.999</td></tr>
<tr id="A2.T1.5.9" class="ltx_tr">
<td id="A2.T1.5.9.1" class="ltx_td ltx_align_left">Activation Function</td>
<td id="A2.T1.5.9.2" class="ltx_td ltx_align_left">Tanh</td>
<td id="A2.T1.5.9.3" class="ltx_td ltx_nopad_l"></td>
<td id="A2.T1.5.9.4" class="ltx_td"></td></tr>
<tr id="A2.T1.5.10" class="ltx_tr">
<td id="A2.T1.5.10.1" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><span id="A2.T1.5.10.1.1" class="ltx_text ltx_font_italic">Learning Rate Scheduler (Warmup + CosineAnnealing)</span></td></tr>
<tr id="A2.T1.5.11" class="ltx_tr">
<td id="A2.T1.5.11.1" class="ltx_td ltx_align_left ltx_border_t">Initial LR / <math id="A2.T1.m5" class="ltx_Math" alttext="\eta_{\min}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\eta_{\min}</annotation></semantics></math></td>
<td id="A2.T1.5.11.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A2.T1.m6" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math></td>
<td id="A2.T1.5.11.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t">Warmup Epochs</td>
<td id="A2.T1.5.11.4" class="ltx_td ltx_align_left ltx_border_t">10</td></tr>
<tr id="A2.T1.5.12" class="ltx_tr">
<td id="A2.T1.5.12.1" class="ltx_td ltx_align_left ltx_border_bb">Warmup Multiplier</td>
<td id="A2.T1.5.12.2" class="ltx_td ltx_align_left ltx_border_bb">15.0</td>
<td id="A2.T1.5.12.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_bb">Cosine Annealing <math id="A2.T1.m7" class="ltx_Math" alttext="T_{\max}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>max</mi></msub><annotation encoding="application/x-tex">T_{\max}</annotation></semantics></math></td>
<td id="A2.T1.5.12.4" class="ltx_td ltx_align_left ltx_border_bb">200</td></tr>
</tbody>
</table>
</figure>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Synthetic Dataset without activation function</h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p">In this section, we show similar result for model without activation function, as a supplement to the synthetic data experiments. This shows that it is reasonable to ignore activation in our analysis</p>
</div>
<figure id="A2.F4" class="ltx_figure"><img src="2510.06954v1/id_loss.png" id="A2.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/124;" width="476" height="124" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F4.3" class="ltx_text" style="font-size:90%;">Figure 4</span>: </span><span id="A2.F4.4" class="ltx_text" style="font-size:90%;">(a) Evolution of cosine similarity matrices for outer and attention parameters. The training process is partitioned into three stages: Condensation (Stage 1), Key-Query rank collapse (Stage 2), and a further training stage. Stage transitions are identified by plateaus in the loss curve and structural shifts in these matrices. (b) The relative change of norms between attention and outer parameters. The gray dashed line marks the onset of Stage 2, where updates to the attention parameters begin to dominate. (c) Evolution of the effective rank for both parameter groups, tracking the change in their intrinsic dimensionality throughout training.</span></figcaption>
</figure>
<figure id="A2.F5" class="ltx_figure"><object type="image/svg+xml" data="2510.06954v1/x1.svg" id="A2.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/147;" width="476" height="147"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F5.3" class="ltx_text" style="font-size:90%;">Figure 5</span>: </span><span id="A2.F5.4" class="ltx_text" style="font-size:90%;">(a) Proportion of satisfied conditions in Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, measured as <math id="A2.F5.m3" class="ltx_Math" alttext="\frac{|A_{1}|}{d_{m}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><msub><mi>d</mi><mi>m</mi></msub></mfrac><annotation encoding="application/x-tex">\frac{|A_{1}|}{d_{m}}</annotation></semantics></math> and <math id="A2.F5.m4" class="ltx_Math" alttext="\frac{|A_{2}|}{d_{m}^{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><msubsup><mi>d</mi><mi>m</mi><mn>2</mn></msubsup></mfrac><annotation encoding="application/x-tex">\frac{|A_{2}|}{d_{m}^{2}}</annotation></semantics></math>.
(b) Similarity between singular vectors of two adjacent time steps.
(c) Frobenius norms of parameter groups.</span></figcaption>
</figure>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Experimental Setting of Real Task</h3>

<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p">To validate that our theoretical insights generalize beyond simplified settings, we conducted experiments on the WikiText dataset, a standard benchmark for language modeling. This experimental setup intentionally incorporates more complex and commonly used architectural features.</p>
</div>
<div id="A2.SS3.p2" class="ltx_para">
<p id="A2.SS3.p2.1" class="ltx_p"><span id="A2.SS3.p2.1.1" class="ltx_text ltx_font_bold">Dataset and Task.</span> We use the WikiText dataset, which consists of high-quality articles from Wikipedia. The task is next-token prediction, where the model is trained to predict the next word in a sequence. Consistent with our synthetic experiments, the training objective is calculated exclusively based on the prediction loss for the final token of each input sequence. The sequence length is set to 2048.</p>
</div>
<div id="A2.SS3.p3" class="ltx_para">
<p id="A2.SS3.p3.1" class="ltx_p"><span id="A2.SS3.p3.1.1" class="ltx_text ltx_font_bold">Model and Training Hyperparameters.</span> We use a 2-layer decoder-only Transformer. To test the robustness of our findings, this model’s architecture includes standard components that were abstracted away in the synthetic setup. Specifically, it incorporates residual connections after both the self-attention and feed-forward sub-layers, and it utilizes the GeLU activation function in the feed-forward network. This more realistic configuration allows us to demonstrate that our theory holds even in the presence of such non-linearities and standard architectural features.</p>
</div>
<div id="A2.SS3.p4" class="ltx_para">
<p id="A2.SS3.p4.1" class="ltx_p">All model weights are initialized from a normal distribution with a standard deviation of <math id="A2.SS3.p4.m1" class="ltx_Math" alttext="\sigma=d_{\text{model}}^{-1.2}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><msubsup><mi>d</mi><mtext>model</mtext><mrow><mo>−</mo><mn>1.2</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\sigma=d_{\text{model}}^{-1.2}</annotation></semantics></math>. The model was trained for 5 epochs using the AdamW optimizer with an initial learning rate of <math id="A2.SS3.p4.m2" class="ltx_Math" alttext="2\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\times 10^{-4}</annotation></semantics></math>, which was managed by a cosine decay schedule with a warmup phase. The detailed hyperparameters for this experiment are listed in Table <a href="#A2.T2" title="Table 2 ‣ B.3 Experimental Setting of Real Task ‣ Appendix B Experimental Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<figure id="A2.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A2.T2.3" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="A2.T2.4" class="ltx_text" style="font-size:90%;">Model and Training Hyperparameters for WikiText</span></figcaption>
<table id="A2.T2.5" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A2.T2.5.1" class="ltx_tr">
<td id="A2.T2.5.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T2.5.1.1.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="A2.T2.5.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T2.5.1.2.1" class="ltx_text ltx_font_bold">Value</span></td>
<td id="A2.T2.5.1.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_tt"><span id="A2.T2.5.1.3.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="A2.T2.5.1.4" class="ltx_td ltx_align_left ltx_border_tt"><span id="A2.T2.5.1.4.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="A2.T2.5.2" class="ltx_tr">
<td id="A2.T2.5.2.1" class="ltx_td ltx_align_left ltx_border_t">Model Architecture</td>
<td id="A2.T2.5.2.2" class="ltx_td ltx_border_t"></td>
<td id="A2.T2.5.2.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t">Training Settings</td>
<td id="A2.T2.5.2.4" class="ltx_td ltx_border_t"></td></tr>
<tr id="A2.T2.5.3" class="ltx_tr">
<td id="A2.T2.5.3.1" class="ltx_td ltx_align_left">Vocabulary Size</td>
<td id="A2.T2.5.3.2" class="ltx_td ltx_align_left">31,999</td>
<td id="A2.T2.5.3.3" class="ltx_td ltx_nopad_l ltx_align_left">Dataset</td>
<td id="A2.T2.5.3.4" class="ltx_td ltx_align_left">WikiText</td></tr>
<tr id="A2.T2.5.4" class="ltx_tr">
<td id="A2.T2.5.4.1" class="ltx_td ltx_align_left">Model Dimension (<math id="A2.T2.m1" class="ltx_Math" alttext="d_{\text{model}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>model</mtext></msub><annotation encoding="application/x-tex">d_{\text{model}}</annotation></semantics></math>)</td>
<td id="A2.T2.5.4.2" class="ltx_td ltx_align_left">64</td>
<td id="A2.T2.5.4.3" class="ltx_td ltx_nopad_l ltx_align_left">Sequence Length</td>
<td id="A2.T2.5.4.4" class="ltx_td ltx_align_left">2048</td></tr>
<tr id="A2.T2.5.5" class="ltx_tr">
<td id="A2.T2.5.5.1" class="ltx_td ltx_align_left">Feed-Forward Dim. (<math id="A2.T2.m2" class="ltx_Math" alttext="d_{\text{ff}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>ff</mtext></msub><annotation encoding="application/x-tex">d_{\text{ff}}</annotation></semantics></math>)</td>
<td id="A2.T2.5.5.2" class="ltx_td ltx_align_left">800</td>
<td id="A2.T2.5.5.3" class="ltx_td ltx_nopad_l ltx_align_left">Optimizer</td>
<td id="A2.T2.5.5.4" class="ltx_td ltx_align_left">AdamW</td></tr>
<tr id="A2.T2.5.6" class="ltx_tr">
<td id="A2.T2.5.6.1" class="ltx_td ltx_align_left">Key/Value Dim. (<math id="A2.T2.m3" class="ltx_Math" alttext="d_{k},d_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>k</mi></msub><mo>,</mo><msub><mi>d</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">d_{k},d_{v}</annotation></semantics></math>)</td>
<td id="A2.T2.5.6.2" class="ltx_td ltx_align_left">64</td>
<td id="A2.T2.5.6.3" class="ltx_td ltx_nopad_l ltx_align_left">Batch Size</td>
<td id="A2.T2.5.6.4" class="ltx_td ltx_align_left">500</td></tr>
<tr id="A2.T2.5.7" class="ltx_tr">
<td id="A2.T2.5.7.1" class="ltx_td ltx_align_left">Number of Layers</td>
<td id="A2.T2.5.7.2" class="ltx_td ltx_align_left">2</td>
<td id="A2.T2.5.7.3" class="ltx_td ltx_nopad_l ltx_align_left">Epochs</td>
<td id="A2.T2.5.7.4" class="ltx_td ltx_align_left">5</td></tr>
<tr id="A2.T2.5.8" class="ltx_tr">
<td id="A2.T2.5.8.1" class="ltx_td ltx_align_left">Number of Heads</td>
<td id="A2.T2.5.8.2" class="ltx_td ltx_align_left">1</td>
<td id="A2.T2.5.8.3" class="ltx_td ltx_nopad_l ltx_align_left">Learning Rate</td>
<td id="A2.T2.5.8.4" class="ltx_td ltx_align_left"><math id="A2.T2.m4" class="ltx_Math" alttext="2\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\times 10^{-4}</annotation></semantics></math></td></tr>
<tr id="A2.T2.5.9" class="ltx_tr">
<td id="A2.T2.5.9.1" class="ltx_td ltx_align_left">Activation Function</td>
<td id="A2.T2.5.9.2" class="ltx_td ltx_align_left">GeLU</td>
<td id="A2.T2.5.9.3" class="ltx_td ltx_nopad_l ltx_align_left">AdamW <math id="A2.T2.m5" class="ltx_Math" alttext="\beta_{1},\beta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{1},\beta_{2}</annotation></semantics></math></td>
<td id="A2.T2.5.9.4" class="ltx_td ltx_align_left">0.9, 0.999</td></tr>
<tr id="A2.T2.5.10" class="ltx_tr">
<td id="A2.T2.5.10.1" class="ltx_td ltx_align_left">Pos. Emb. Length</td>
