<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Theory Details</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Theory Details for Blow up Dynamics</h3>

<section id="A1.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.1.1 </span>Proof for Proposition 2</h4>

<div id="A1.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS1.SSS1.p1" class="ltx_para">
<p id="A1.SS1.SSS1.p1.1" class="ltx_p"><span id="A1.SS1.SSS1.p1.1.1" class="ltx_text">Taking advantage of the inherent symmetry of the system, the proof focuses on analyzing the coupled dynamics of <math id="A1.SS1.SSS1.p1.m1" class="ltx_Math" alttext="{\bm{W}}_{\bm{v}}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>𝒗</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v}}</annotation></semantics></math> and <math id="A1.SS1.SSS1.p1.m2" class="ltx_Math" alttext="{\bm{W}}^{[1]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[1]}</annotation></semantics></math>:</span></p>
<table id="A1.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}\left({\bm{W}}_{\bm{v},k}\right)^{2}=2\sum_{k^{\prime}}{\bm{W}}_{\bm{v},k}{\bm{W}}^{[1]}_{kk^{\prime}}{\bm{W}}^{[2]}_{k^{\prime}}=\frac{\mathrm{d}}{\mathrm{d}t}\sum_{k^{\prime}}\left({\bm{W}}^{[1]}_{kk^{\prime}}\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><msup><mi>k</mi><mo>′</mo></msup></munder><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><msup><mi>k</mi><mo>′</mo></msup></munder><msup><mrow><mo>(</mo><msubsup><mi>𝑾</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}\left({\bm{W}}_{\bm{v},k}\right)^{2}=2\sum_{k^{\prime}}{\bm{W}}_{\bm{v},k}{\bm{W}}^{[1]}_{kk^{\prime}}{\bm{W}}^{[2]}_{k^{\prime}}=\frac{\mathrm{d}}{\mathrm{d}t}\sum_{k^{\prime}}\left({\bm{W}}^{[1]}_{kk^{\prime}}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS1.p1.2" class="ltx_p"><span id="A1.SS1.SSS1.p1.2.1" class="ltx_text">This finished the proof of the first two equations. We also derive the relation between energy <math id="A1.SS1.SSS1.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and the evolution of parameters</span></p>
<table id="A1.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}=\frac{\mathrm{d}}{\mathrm{d}t}\sum_{k}{\bm{W}}_{\bm{v},k}^{2}=2\sum_{k,k^{\prime}}{\bm{W}}_{\bm{v},k}{\bm{W}}^{[1]}_{kk^{\prime}}{\bm{W}}^{[2]}_{k^{\prime}}=2E." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder><mrow><msub><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}=\frac{\mathrm{d}}{\mathrm{d}t}\sum_{k}{\bm{W}}_{\bm{v},k}^{2}=2\sum_{k,k^{\prime}}{\bm{W}}_{\bm{v},k}{\bm{W}}^{[1]}_{kk^{\prime}}{\bm{W}}^{[2]}_{k^{\prime}}=2E.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS1.p1.3" class="ltx_p"><span id="A1.SS1.SSS1.p1.3.1" class="ltx_text">This is just the third equation.
∎</span></p>
</div>
</div>
</section>
<section id="A1.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.1.2 </span>Proof for Theorem 1</h4>

<div id="A1.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS1.SSS2.p1" class="ltx_para">
<p id="A1.SS1.SSS2.p1.2" class="ltx_p"><span id="A1.SS1.SSS2.p1.2.1" class="ltx_text">Since we use Gaussian random initialization, the initialization satisfies Definition <a href="#Thmdefi4" title="Definition 4 (Non-degenerate initialization). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> almost surely. Therefore, we establish our results under the assumptions specified in Definition <a href="#Thmdefi4" title="Definition 4 (Non-degenerate initialization). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. By local Lipshcitz condition on the right hand side of dynamical system Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>), it has a solution for <math id="A1.SS1.SSS2.p1.m1" class="ltx_Math" alttext="t\in(0,T^{*})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(0,T^{*})</annotation></semantics></math> where <math id="A1.SS1.SSS2.p1.m2" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math> is maximum existence time of solution and can be infinity. Taking derivative of <math id="A1.SS1.SSS2.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, we obtain</span></p>
<table id="A1.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E16.m1" class="ltx_Math" alttext="\dot{E}=\frac{\mathrm{d}}{\mathrm{d}t}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}=\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}+\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}+\|{\bm{W}}_{\bm{v}}\|_{2}^{2}\|{\bm{W}}^{[2]}\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dot{E}=\frac{\mathrm{d}}{\mathrm{d}t}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}=\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}+\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}+\|{\bm{W}}_{\bm{v}}\|_{2}^{2}\|{\bm{W}}^{[2]}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p1.3" class="ltx_p"><span id="A1.SS1.SSS2.p1.3.1" class="ltx_text">The inequality of arithmetic and geometric means leads to</span></p>
<table id="A1.Ex8" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex8X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex8X.m2" class="ltx_Math" alttext="\displaystyle\dot{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>˙</mo></mover><annotation encoding="application/x-tex">\displaystyle\dot{E}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8X.m3" class="ltx_Math" alttext="\displaystyle\geq 3(\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}\|{\bm{W}}^{[2]}\|_{2}^{2})^{\frac{1}{3}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 3(\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}\|{\bm{W}}_{\bm{v}}\|_{2}^{2}\|{\bm{W}}^{[2]}\|_{2}^{2})^{\frac{1}{3}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex8Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8Xa.m2" class="ltx_Math" alttext="\displaystyle\geq[\langle\dot{{\bm{W}}}_{\bm{v}}{\bm{W}}_{\bm{v}}\rangle^{2}\langle\dot{{\bm{W}}}^{[2]}{\bm{W}}^{[2]}\rangle^{2}]^{\frac{1}{3}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">⟨</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\geq[\langle\dot{{\bm{W}}}_{\bm{v}}{\bm{W}}_{\bm{v}}\rangle^{2}\langle\dot{{\bm{W}}}^{[2]}{\bm{W}}^{[2]}\rangle^{2}]^{\frac{1}{3}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex8Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8Xb.m2" class="ltx_Math" alttext="\displaystyle=3E^{\frac{4}{3}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mfrac><mn>4</mn><mn>3</mn></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3E^{\frac{4}{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p1.4" class="ltx_p"><span id="A1.SS1.SSS2.p1.4.1" class="ltx_text">This implies that energy <math id="A1.SS1.SSS2.p1.m4" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> increase monotonically. If <math id="A1.SS1.SSS2.p1.m5" class="ltx_Math" alttext="E(0)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(0)&gt;0</annotation></semantics></math>,</span></p>
<table id="A1.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}E^{-\frac{1}{3}}\leq-1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>≤</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}E^{-\frac{1}{3}}\leq-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p1.5" class="ltx_p"><span id="A1.SS1.SSS2.p1.5.1" class="ltx_text">Integrating both sides of the inequality yields a lower bound for the energy <math id="A1.SS1.SSS2.p1.m6" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math></span></p>
<table id="A1.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E17.m1" class="ltx_Math" alttext="E(t)\geq\frac{1}{(E(0)^{-\frac{1}{3}}-t)^{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E(t)\geq\frac{1}{(E(0)^{-\frac{1}{3}}-t)^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p1.6" class="ltx_p"><span id="A1.SS1.SSS2.p1.6.1" class="ltx_text">Thus, in the case where <math id="A1.SS1.SSS2.p1.m7" class="ltx_Math" alttext="E(0)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(0)&gt;0</annotation></semantics></math>, the dynamical system explodes before <math id="A1.SS1.SSS2.p1.m8" class="ltx_Math" alttext="T^{*}\leq E(0)^{-\frac{1}{3}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>≤</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">T^{*}\leq E(0)^{-\frac{1}{3}}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS1.SSS2.p2" class="ltx_para">
<p id="A1.SS1.SSS2.p2.1" class="ltx_p"><span id="A1.SS1.SSS2.p2.1.1" class="ltx_text">In the case where <math id="A1.SS1.SSS2.p2.m1" class="ltx_Math" alttext="E(0)\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(0)\leq 0</annotation></semantics></math>, we consider <math id="A1.SS1.SSS2.p2.m2" class="ltx_Math" alttext="-E(t)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-E(t)</annotation></semantics></math> instead, and obtain</span></p>
<table id="A1.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E18.m1" class="ltx_Math" alttext="E(t)\geq-\frac{1}{(t+(-E(0))^{-\frac{1}{3}})^{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mo>−</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E(t)\geq-\frac{1}{(t+(-E(0))^{-\frac{1}{3}})^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS2.p3" class="ltx_para">
<p id="A1.SS1.SSS2.p3.1" class="ltx_p"><span id="A1.SS1.SSS2.p3.1.1" class="ltx_text">We claim that there exists some time <math id="A1.SS1.SSS2.p3.m1" class="ltx_Math" alttext="t_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t_{0}&gt;0</annotation></semantics></math>, such that <math id="A1.SS1.SSS2.p3.m2" class="ltx_Math" alttext="E(t_{0})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(t_{0})&gt;0</annotation></semantics></math>. This claim can be proved by contradiction.</span></p>
</div>
<div id="A1.SS1.SSS2.p4" class="ltx_para">
<p id="A1.SS1.SSS2.p4.1" class="ltx_p"><span id="A1.SS1.SSS2.p4.1.1" class="ltx_text">Suppose that <math id="A1.SS1.SSS2.p4.m1" class="ltx_Math" alttext="E(t)\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(t)\leq 0</annotation></semantics></math> for all <math id="A1.SS1.SSS2.p4.m2" class="ltx_Math" alttext="0&lt;t&lt;T^{*}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>t</mi><mo>&lt;</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">0&lt;t&lt;T^{*}</annotation></semantics></math>. Recall that <math id="A1.SS1.SSS2.p4.m3" class="ltx_Math" alttext="\dot{E}(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\dot{E}(t)\geq 0</annotation></semantics></math> throughout this interval. The boundedness of <math id="A1.SS1.SSS2.p4.m4" class="ltx_Math" alttext="{\bm{W}}_{\bm{v}}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>𝒗</mi></msub><annotation encoding="application/x-tex">{\bm{W}}_{\bm{v}}</annotation></semantics></math>, <math id="A1.SS1.SSS2.p4.m5" class="ltx_Math" alttext="{\bm{W}}^{[1]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[1]}</annotation></semantics></math>, and <math id="A1.SS1.SSS2.p4.m6" class="ltx_Math" alttext="{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><annotation encoding="application/x-tex">{\bm{W}}^{[2]}</annotation></semantics></math>, together with the monotonicity of energy <math id="A1.SS1.SSS2.p4.m7" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, implies that <math id="A1.SS1.SSS2.p4.m8" class="ltx_Math" alttext="E(T^{*})=\lim_{t\rightarrow T^{*}}E(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow></msub><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E(T^{*})=\lim_{t\rightarrow T^{*}}E(t)</annotation></semantics></math> exists and satisfies <math id="A1.SS1.SSS2.p4.m9" class="ltx_Math" alttext="-\infty&lt;E(T^{*})\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mo>&lt;</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-\infty&lt;E(T^{*})\leq 0</annotation></semantics></math>. We now consider different cases separately.</span></p>
</div>
<div id="A1.SS1.SSS2.p5" class="ltx_para">
<p id="A1.SS1.SSS2.p5.1" class="ltx_p"><span id="A1.SS1.SSS2.p5.1.1" class="ltx_text">(i) The case of <math id="A1.SS1.SSS2.p5.m1" class="ltx_Math" alttext="T^{*}&lt;+\infty" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">T^{*}&lt;+\infty</annotation></semantics></math>. The solutions can be extended to a time larger than <math id="A1.SS1.SSS2.p5.m2" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math> since <math id="A1.SS1.SSS2.p5.m3" class="ltx_Math" alttext="\|{\bm{W}}_{\bm{v}}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|{\bm{W}}_{\bm{v}}\|_{2}</annotation></semantics></math>, <math id="A1.SS1.SSS2.p5.m4" class="ltx_Math" alttext="\|{\bm{W}}^{[1]}\|_{\text{F}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mtext>F</mtext></msub><annotation encoding="application/x-tex">\|{\bm{W}}^{[1]}\|_{\text{F}}</annotation></semantics></math> , <math id="A1.SS1.SSS2.p5.m5" class="ltx_Math" alttext="\|{\bm{W}}^{[2]}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|{\bm{W}}^{[2]}\|_{2}</annotation></semantics></math> are bounded due to the conservation law. This contradicts the definition of <math id="A1.SS1.SSS2.p5.m6" class="ltx_Math" alttext="T^{*}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">T^{*}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS1.SSS2.p6" class="ltx_para">
<p id="A1.SS1.SSS2.p6.1" class="ltx_p"><span id="A1.SS1.SSS2.p6.1.1" class="ltx_text">(ii) The case of <math id="A1.SS1.SSS2.p6.m1" class="ltx_Math" alttext="T^{*}=+\infty" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">T^{*}=+\infty</annotation></semantics></math> and <math id="A1.SS1.SSS2.p6.m2" class="ltx_Math" alttext="E(T^{*})&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(T^{*})&lt;0</annotation></semantics></math>. That is <math id="A1.SS1.SSS2.p6.m3" class="ltx_Math" alttext="\lim_{t\rightarrow+\infty}E(t)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow></msub><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow+\infty}E(t)&lt;0</annotation></semantics></math>. However, this contradicts Equation equation <a href="#A1.E18" title="In Proof. ‣ A.1.2 Proof for Theorem 1 ‣ A.1 Theory Details for Blow up Dynamics ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>.</span></p>
</div>
<div id="A1.SS1.SSS2.p7" class="ltx_para">
<p id="A1.SS1.SSS2.p7.1" class="ltx_p"><span id="A1.SS1.SSS2.p7.1.1" class="ltx_text">(iii) The case of <math id="A1.SS1.SSS2.p7.m1" class="ltx_Math" alttext="T^{*}=+\infty" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">T^{*}=+\infty</annotation></semantics></math> and <math id="A1.SS1.SSS2.p7.m2" class="ltx_Math" alttext="E(T^{*})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(T^{*})=0</annotation></semantics></math>. That is <math id="A1.SS1.SSS2.p7.m3" class="ltx_Math" alttext="\lim_{t\rightarrow+\infty}E(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow></msub><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow+\infty}E(t)=0</annotation></semantics></math>. We prove this case in three steps.</span></p>
</div>
<div id="A1.SS1.SSS2.p8" class="ltx_para">
<p id="A1.SS1.SSS2.p8.1" class="ltx_p"><span id="A1.SS1.SSS2.p8.1.1" class="ltx_text ltx_font_bold">Step 1<span id="A1.SS1.SSS2.p8.1.1.1" class="ltx_text ltx_font_medium">: We show that <math id="A1.SS1.SSS2.p8.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0</annotation></semantics></math>. Since <math id="A1.SS1.SSS2.p8.m2" class="ltx_Math" alttext="E(t)\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E(t)\leq 0</annotation></semantics></math> for all <math id="A1.SS1.SSS2.p8.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the quantities <math id="A1.SS1.SSS2.p8.m4" class="ltx_Math" alttext="\|{\bm{W}}_{\bm{v}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|{\bm{W}}_{\bm{v}}\|_{2}^{2}</annotation></semantics></math>, <math id="A1.SS1.SSS2.p8.m5" class="ltx_Math" alttext="\|{\bm{W}}^{[1]}\|_{\mathrm{F}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">F</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|{\bm{W}}^{[1]}\|_{\mathrm{F}}^{2}</annotation></semantics></math>, <math id="A1.SS1.SSS2.p8.m6" class="ltx_Math" alttext="\|{\bm{W}}^{[2]}\|_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\|{\bm{W}}^{[2]}\|_{2}^{2}</annotation></semantics></math> are monotonically decreasing. However, each of them is bounded below by zero, and hence they all converge to finite limits and remain uniformly bounded.</span></span></p>
</div>
<div id="A1.SS1.SSS2.p9" class="ltx_para">
<p id="A1.SS1.SSS2.p9.1" class="ltx_p"><span id="A1.SS1.SSS2.p9.1.1" class="ltx_text">Moreover, note that <math id="A1.SS1.SSS2.p9.m1" class="ltx_Math" alttext="\dot{E}\geq 0" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\dot{E}\geq 0</annotation></semantics></math> for all <math id="A1.SS1.SSS2.p9.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. If <math id="A1.SS1.SSS2.p9.m3" class="ltx_Math" alttext="\liminf_{t\rightarrow\infty}\dot{E}(t)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim inf</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\liminf_{t\rightarrow\infty}\dot{E}(t)&gt;0</annotation></semantics></math>, it contradicts the fact that <math id="A1.SS1.SSS2.p9.m4" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}E(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}E(t)=0</annotation></semantics></math>. Therefore, it must hold that</span></p>
<table id="A1.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p9.2" class="ltx_p"><span id="A1.SS1.SSS2.p9.2.1" class="ltx_text">This implies that either <math id="A1.SS1.SSS2.p9.m5" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}=0</annotation></semantics></math> or <math id="A1.SS1.SSS2.p9.m6" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0</annotation></semantics></math>.
We can also obtain <math id="A1.SS1.SSS2.p9.m7" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}^{[1]}(t)\|_{\mathrm{F}}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}^{[1]}(t)\|_{\mathrm{F}}^{2}=0</annotation></semantics></math> since <math id="A1.SS1.SSS2.p9.m8" class="ltx_Math" alttext="\dot{{\bm{W}}}^{[1]}={\bm{W}}_{\bm{v}}^{\intercal}{{\bm{W}}^{[2]}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo>=</mo><mrow><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\dot{{\bm{W}}}^{[1]}={\bm{W}}_{\bm{v}}^{\intercal}{{\bm{W}}^{[2]}}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS1.SSS2.p10" class="ltx_para">
<p id="A1.SS1.SSS2.p10.1" class="ltx_p"><span id="A1.SS1.SSS2.p10.1.1" class="ltx_text ltx_font_bold">Step 2<span id="A1.SS1.SSS2.p10.1.1.1" class="ltx_text ltx_font_medium">: We show <math id="A1.SS1.SSS2.p10.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\dot{E}(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\dot{E}(t)=0</annotation></semantics></math>. Without loss of generality, we assume that <math id="A1.SS1.SSS2.p10.m2" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}=0</annotation></semantics></math>. The case of <math id="A1.SS1.SSS2.p10.m3" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}=0</annotation></semantics></math> is similar. That is <math id="A1.SS1.SSS2.p10.m4" class="ltx_Math" alttext="\|{\bm{W}}_{\bm{v}}(0)\|_{2}&gt;\lVert{\bm{W}}^{[2]}\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.1389em">&gt;</mo><msub><mrow><mo fence="true" lspace="0.1389em" rspace="0em">∥</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|{\bm{W}}_{\bm{v}}(0)\|_{2}&gt;\lVert{\bm{W}}^{[2]}\rVert_{2}</annotation></semantics></math>. By conservation law, we have <math id="A1.SS1.SSS2.p10.m5" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}=0.</annotation></semantics></math></span></span></p>
</div>
<div id="A1.SS1.SSS2.p11" class="ltx_para">
<p id="A1.SS1.SSS2.p11.1" class="ltx_p"><span id="A1.SS1.SSS2.p11.1.1" class="ltx_text">Considering the second derivative of <math id="A1.SS1.SSS2.p11.m1" class="ltx_Math" alttext="{\bm{W}}^{[2]}_{k^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑾</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><annotation encoding="application/x-tex">{\bm{W}}^{[2]}_{k^{\prime}}</annotation></semantics></math>, we obtain</span></p>
<table id="A1.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\ddot{{\bm{W}}}^{[2]}_{k^{\prime}}=\sum_{k}\left(\sum_{l}{\bm{W}}^{[1]}_{kl}{\bm{W}}^{[2]}_{l}{\bm{W}}^{[1]}_{kk^{\prime}}+{\bm{W}}_{\bm{v},k}^{2}{\bm{W}}^{[1]}_{k^{\prime}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>¨</mo></mover><msup><mi>k</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>k</mi></munder><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>l</mi></munder><mrow><msubsup><mi>𝑾</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>l</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>𝑾</mi><mrow><mi>𝒗</mi><mo>,</mo><mi>k</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ddot{{\bm{W}}}^{[2]}_{k^{\prime}}=\sum_{k}\left(\sum_{l}{\bm{W}}^{[1]}_{kl}{\bm{W}}^{[2]}_{l}{\bm{W}}^{[1]}_{kk^{\prime}}+{\bm{W}}_{\bm{v},k}^{2}{\bm{W}}^{[1]}_{k^{\prime}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p11.2" class="ltx_p"><span id="A1.SS1.SSS2.p11.2.1" class="ltx_text">Thus <math id="A1.SS1.SSS2.p11.m2" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\ddot{{\bm{W}}}^{[1]}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>¨</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\ddot{{\bm{W}}}^{[1]}(t)\|_{2}^{2}=0</annotation></semantics></math> since <math id="A1.SS1.SSS2.p11.m3" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\lVert{\bm{W}}^{[1]}(t)\rVert_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo lspace="0.1389em">=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\lVert{\bm{W}}^{[1]}(t)\rVert_{2}^{2}=0</annotation></semantics></math>. Note that <math id="A1.SS1.SSS2.p11.m4" class="ltx_Math" alttext="\dot{E}(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\dot{E}(t)\geq 0</annotation></semantics></math> and <math id="A1.SS1.SSS2.p11.m5" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}E(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}E(t)=0</annotation></semantics></math>. Recall that <math id="A1.SS1.SSS2.p11.m6" class="ltx_Math" alttext="\liminf_{t\rightarrow\infty}\dot{E}(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim inf</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\liminf_{t\rightarrow\infty}\dot{E}(t)=0</annotation></semantics></math> and <math id="A1.SS1.SSS2.p11.m7" class="ltx_Math" alttext="\dot{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>˙</mo></mover><annotation encoding="application/x-tex">\dot{E}</annotation></semantics></math> are bounded. And we also have <math id="A1.SS1.SSS2.p11.m8" class="ltx_Math" alttext="\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}\leq M" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}\leq M</annotation></semantics></math>. We claim that <math id="A1.SS1.SSS2.p11.m9" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}^{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}^{2}=0</annotation></semantics></math>, which implies</span></p>
<table id="A1.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E19.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\dot{E}(t)=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\dot{E}(t)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS2.p12" class="ltx_para">
<p id="A1.SS1.SSS2.p12.1" class="ltx_p"><span id="A1.SS1.SSS2.p12.1.1" class="ltx_text">Since <math id="A1.SS1.SSS2.p12.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|{\bm{W}}^{[2]}(t)\|_{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|{\bm{W}}^{[2]}(t)\|_{2}=0</annotation></semantics></math> and <math id="A1.SS1.SSS2.p12.m2" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\ddot{{\bm{W}}}^{[2]}(t)\|_{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>¨</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\ddot{{\bm{W}}}^{[2]}(t)\|_{2}=0</annotation></semantics></math>. Using Taylor expansion, we have for some <math id="A1.SS1.SSS2.p12.m3" class="ltx_Math" alttext="\varphi\in[t,t+1]" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi\in[t,t+1]</annotation></semantics></math></span></p>
<table id="A1.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex12.m1" class="ltx_Math" alttext="{\bm{W}}^{[2]}_{k}(t+1)={\bm{W}}^{[2]}_{k}(t)+\dot{{\bm{W}}}^{[2]}_{k}(t)+\frac{1}{2}\ddot{{\bm{W}}}^{[2]}_{k}(\varphi),\forall k," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>𝑾</mi><mi>k</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>𝑾</mi><mi>k</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>k</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>¨</mo></mover><mi>k</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo><mrow><mo rspace="0.167em">∀</mo><mi>k</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{W}}^{[2]}_{k}(t+1)={\bm{W}}^{[2]}_{k}(t)+\dot{{\bm{W}}}^{[2]}_{k}(t)+\frac{1}{2}\ddot{{\bm{W}}}^{[2]}_{k}(\varphi),\forall k,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p12.2" class="ltx_p"><span id="A1.SS1.SSS2.p12.2.1" class="ltx_text">which implies <math id="A1.SS1.SSS2.p12.m4" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}=0</annotation></semantics></math>. Therefore, the assertion holds.</span></p>
</div>
<div id="A1.SS1.SSS2.p13" class="ltx_para">
<p id="A1.SS1.SSS2.p13.1" class="ltx_p"><span id="A1.SS1.SSS2.p13.1.1" class="ltx_text ltx_font_bold">Step 3<span id="A1.SS1.SSS2.p13.1.1.1" class="ltx_text ltx_font_medium">: We show that Eq. (<a href="#A1.E19" title="In Proof. ‣ A.1.2 Proof for Theorem 1 ‣ A.1 Theory Details for Blow up Dynamics ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) contradicts the condition in Definition <a href="#Thmdefi4" title="Definition 4 (Non-degenerate initialization). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. By direct calculation, we obtain</span></span></p>
<table id="A1.Ex13" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex13X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex13X.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\mathrm{d}}{\mathrm{d}t}({{\bm{W}}^{[2]}}^{\intercal}{{\bm{W}}^{[1]}}^{\intercal}{\bm{W}}^{[1]}{\bm{W}}^{[2]})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝑾</mi><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mrow></mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathrm{d}}{\mathrm{d}t}({{\bm{W}}^{[2]}}^{\intercal}{{\bm{W}}^{[1]}}^{\intercal}{\bm{W}}^{[1]}{\bm{W}}^{[2]})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13Xa.m2" class="ltx_Math" alttext="\displaystyle=\dot{{\bm{W}}}^{{[2]}^{\intercal}}{{\bm{W}}}^{{[1]}^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}+{{\bm{W}}}^{{[2]}^{\intercal}}\dot{{\bm{W}}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>+</mo><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dot{{\bm{W}}}^{{[2]}^{\intercal}}{{\bm{W}}}^{{[1]}^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}+{{\bm{W}}}^{{[2]}^{\intercal}}\dot{{\bm{W}}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13Xb.m2" class="ltx_Math" alttext="\displaystyle+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}\dot{{\bm{W}}}^{[1]}{\bm{W}}^{[2]}+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>+</mo><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}\dot{{\bm{W}}}^{[1]}{\bm{W}}^{[2]}+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[2]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13Xc.m2" class="ltx_Math" alttext="\displaystyle={\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo>+</mo><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13Xd.m2" class="ltx_Math" alttext="\displaystyle+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><mo>+</mo><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[2]}+{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex13Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13Xe.m2" class="ltx_Math" alttext="\displaystyle=2E\|{\bm{W}}^{[1]}\|_{2}^{2}+2\dot{{\bm{W}}}_{\bm{v}}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2E\|{\bm{W}}^{[1]}\|_{2}^{2}+2\dot{{\bm{W}}}_{\bm{v}}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[2]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p13.2" class="ltx_p"><span id="A1.SS1.SSS2.p13.2.1" class="ltx_text">and</span></p>
<table id="A1.Ex14" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex14X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex14X.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14X.m3" class="ltx_Math" alttext="\displaystyle=\frac{\mathrm{d}}{\mathrm{d}t}({\bm{W}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑾</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathrm{d}}{\mathrm{d}t}({\bm{W}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14Xa.m2" class="ltx_Math" alttext="\displaystyle=\dot{{\bm{W}}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}\dot{{\bm{W}}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\dot{{\bm{W}}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}\dot{{\bm{W}}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14Xb.m2" class="ltx_Math" alttext="\displaystyle+{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}^{\intercal}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}\dot{{\bm{W}}}_{\bm{v}}^{\intercal}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow></mrow><mo>+</mo><mrow><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}^{\intercal}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}\dot{{\bm{W}}}_{\bm{v}}^{\intercal}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14Xc.m2" class="ltx_Math" alttext="\displaystyle={\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}{\bm{W}}_{\bm{v}}^{\intercal}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}{\bm{W}}_{\bm{v}}^{\intercal}{\bm{W}}^{[2]^{\intercal}}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}_{\bm{v}}^{\intercal}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14Xd.m2" class="ltx_Math" alttext="\displaystyle+{\bm{W}}_{\bm{v}}{\bm{b}}{\bm{W}}_{\bm{v}}{\bm{W}}_{\bm{v}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>𝒗</mi><mo>⊺</mo></msubsup></mrow></mrow><mo>+</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><msup><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>⊺</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+{\bm{W}}_{\bm{v}}{\bm{b}}{\bm{W}}_{\bm{v}}{\bm{W}}_{\bm{v}}{\bm{W}}_{\bm{v}}^{\intercal}+{\bm{W}}_{\bm{v}}{\bm{W}}^{[1]}{\bm{W}}^{[1]^{\intercal}}{\bm{W}}^{[1]}{\bm{W}}^{[2]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14Xe.m2" class="ltx_Math" alttext="\displaystyle=2E\|{\bm{W}}_{\bm{v}}\|_{2}^{2}+2\dot{{\bm{W}}}_{\bm{v}}^{\intercal}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[2]}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi><mo>⊺</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2E\|{\bm{W}}_{\bm{v}}\|_{2}^{2}+2\dot{{\bm{W}}}_{\bm{v}}^{\intercal}{\bm{W}}^{[1]}\dot{{\bm{W}}}^{[2]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p13.3" class="ltx_p"><span id="A1.SS1.SSS2.p13.3.1" class="ltx_text">Therefore,</span></p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}-\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}=2E(\|{\bm{W}}^{[2]}(0)\|_{2}^{2}-\|{\bm{W}}_{\bm{v}}(0)\|_{2}^{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}_{\bm{v}}\|_{2}^{2}-\frac{\mathrm{d}}{\mathrm{d}t}\|\dot{{\bm{W}}}^{[2]}\|_{2}^{2}=2E(\|{\bm{W}}^{[2]}(0)\|_{2}^{2}-\|{\bm{W}}_{\bm{v}}(0)\|_{2}^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p13.4" class="ltx_p"><span id="A1.SS1.SSS2.p13.4.1" class="ltx_text">Integrating both sides of the equality, we obtain</span></p>
<table id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}-\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}^{2}=\|\dot{{\bm{W}}}_{\bm{v}}(0)\|_{2}^{2}-\|\dot{{\bm{W}}}^{[2]}(0)\|_{2}^{2}-\|{\bm{W}}^{[2]}(0)\|_{2}^{2}(\|{\bm{W}}^{[2]}(0)\|_{2}^{2}-\|{\bm{W}}_{\bm{v}}(0)\|_{2}^{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}-\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}^{2}=\|\dot{{\bm{W}}}_{\bm{v}}(0)\|_{2}^{2}-\|\dot{{\bm{W}}}^{[2]}(0)\|_{2}^{2}-\|{\bm{W}}^{[2]}(0)\|_{2}^{2}(\|{\bm{W}}^{[2]}(0)\|_{2}^{2}-\|{\bm{W}}_{\bm{v}}(0)\|_{2}^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p13.5" class="ltx_p"><span id="A1.SS1.SSS2.p13.5.1" class="ltx_text">However, according to Definition <a href="#Thmdefi4" title="Definition 4 (Non-degenerate initialization). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> and the fact that <math id="A1.SS1.SSS2.p13.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}=0</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}\neq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msubsup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≠</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}\neq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p13.6" class="ltx_p"><span id="A1.SS1.SSS2.p13.6.1" class="ltx_text">Based on Eq. (<a href="#A1.E16" title="In Proof. ‣ A.1.2 Proof for Theorem 1 ‣ A.1 Theory Details for Blow up Dynamics ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), we have</span></p>
<table id="A1.Ex18" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex18X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex18X.m2" class="ltx_Math" alttext="\displaystyle\lim_{t\rightarrow\infty}\dot{E}(t)" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{t\rightarrow\infty}\dot{E}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18X.m3" class="ltx_Math" alttext="\displaystyle=\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}+\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}^{2}+\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝑾</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}+\|\dot{{\bm{W}}}^{[2]}(t)\|_{2}^{2}+\|{\bm{W}}_{\bm{v}}(t)\|_{2}^{2}\|{\bm{W}}^{[2]}(t)\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18Xa.m2" class="ltx_Math" alttext="\displaystyle=\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}\neq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝑾</mi><mo>˙</mo></mover><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≠</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{t\rightarrow\infty}\|\dot{{\bm{W}}}_{\bm{v}}(t)\|_{2}^{2}\neq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS2.p13.7" class="ltx_p"><span id="A1.SS1.SSS2.p13.7.1" class="ltx_text">It contradicts with Eq. (<a href="#A1.E19" title="In Proof. ‣ A.1.2 Proof for Theorem 1 ‣ A.1 Theory Details for Blow up Dynamics ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) which claims <math id="A1.SS1.SSS2.p13.m2" class="ltx_Math" alttext="\lim_{t\rightarrow\infty}\dot{E}(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mover accent="true"><mi>E</mi><mo>˙</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{t\rightarrow\infty}\dot{E}(t)=0</annotation></semantics></math>. This completes the proof.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Theory Details for Condensation</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p">In this section, we prove the main theorems which characterize the condensation. In retrospect of the proof of Theorem <a href="#Thmthm1" title="Theorem 1 (Blow-up in finite time). ‣ 4.2 Blow Up Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, Eq. (<a href="#A1.E17" title="In Proof. ‣ A.1.2 Proof for Theorem 1 ‣ A.1 Theory Details for Blow up Dynamics ‣ Appendix A Theory Details ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) provides a lower bound that leads to the presence of explosion. However, this inequality leaves the precise growth rate of energy <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> undetermined.
The key idea here is that Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> can give us an upper limit on how fast the energy can grow. Once we understand this growth rate, we can then move forward with proving the main theorems.</p>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p">We begin our proof by the following proposition.</p>
</div>
<div id="Thmprop4" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop4.2" class="ltx_text ltx_font_bold">Proposition 4</span></span><span id="Thmprop4.3" class="ltx_text ltx_font_bold"> </span>(induction)<span id="Thmprop4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop4.p1" class="ltx_para">
<p id="Thmprop4.p1.1" class="ltx_p"><span id="Thmprop4.p1.1.1" class="ltx_text ltx_font_italic">Consider dynamical system Eq. (<a href="#S4.E7" title="In Proposition 1 (Effective training dynamics). ‣ 4.1 Problem Formulation ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>). If Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds at some time <math id="Thmprop4.p1.m1" class="ltx_Math" alttext="t_{0}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>0</mn></msub><annotation encoding="application/x-tex">t_{0}</annotation></semantics></math> with <math id="Thmprop4.p1.m2" class="ltx_Math" alttext="t_{0}&lt;T^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mn>0</mn></msub><mo>&lt;</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">t_{0}&lt;T^{*}</annotation></semantics></math>, then Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> will hold at <math id="Thmprop4.p1.m3" class="ltx_Math" alttext="t\in(t_{0},T^{*})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo>,</mo><msup><mi>T</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in(t_{0},T^{*})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p3" class="ltx_para">
<p id="A1.SS2.p3.3" class="ltx_p"><span id="A1.SS2.p3.3.1" class="ltx_text">First, we consider the second condition in Assumption <a href="#Thmassump1" title="Assumption 1 (Condensation condition). ‣ 4.3 Condensation Dynamics ‣ 4 Theoretical Results ‣ From Condensation to Rank Collapse: A Two-Stage Analysis of Transformer Training Dynamics" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. By direct calculation, we have</span></p>
<table id="A1.Ex19" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex19X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex19X.m2" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\left\langle{\bm{W}}^{[2]}_{i}{\bm{W}}^{[1],i},{\bm{W}}^{[2]}_{j}{\bm{W}}^{[1],j}\right\rangle" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup></mrow><mo>,</mo><mrow><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup></mrow></mrow><mo>⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\left\langle{\bm{W}}^{[2]}_{i}{\bm{W}}^{[1],i},{\bm{W}}^{[2]}_{j}{\bm{W}}^{[1],j}\right\rangle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19X.m3" class="ltx_Math" alttext="\displaystyle=\left({\bm{W}}^{[2]}_{j}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],j}\right)\left(\left({\bm{W}}^{[2]}_{i}\right)^{2}+\frac{1}{\left({\bm{W}}^{[2]}_{j}\right)^{2}}{\bm{W}}^{[2]}_{i}{\bm{W}}^{[2]}_{j}{{\bm{W}}^{[1],i}}^{\intercal}{\bm{W}}^{[1],j}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo>(</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left({\bm{W}}^{[2]}_{j}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],j}\right)\left(\left({\bm{W}}^{[2]}_{i}\right)^{2}+\frac{1}{\left({\bm{W}}^{[2]}_{j}\right)^{2}}{\bm{W}}^{[2]}_{i}{\bm{W}}^{[2]}_{j}{{\bm{W}}^{[1],i}}^{\intercal}{\bm{W}}^{[1],j}\right)</annotation></semantics></math></td>
