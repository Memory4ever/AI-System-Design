<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19Xa.m2" class="ltx_Math" alttext="\displaystyle+\left({\bm{W}}^{[2]}_{i}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],i}\right)\left(\left({\bm{W}}^{[2]}_{j}\right)^{2}+\frac{1}{\left({\bm{W}}^{[2]}_{i}\right)^{2}}{\bm{W}}^{[2]}_{i}{\bm{W}}^{[2]}_{j}{{\bm{W}}^{[1],i}}^{\intercal}{\bm{W}}^{[1],j}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑾</mi><mi>𝒗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo>(</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑾</mi><mi>j</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝑾</mi><mrow></mrow><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>i</mi></mrow><mrow></mrow><mo>⊺</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑾</mi><mrow><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left({\bm{W}}^{[2]}_{i}{\bm{W}}_{\bm{v}}{\bm{W}}^{[1],i}\right)\left(\left({\bm{W}}^{[2]}_{j}\right)^{2}+\frac{1}{\left({\bm{W}}^{[2]}_{i}\right)^{2}}{\bm{W}}^{[2]}_{i}{\bm{W}}^{[2]}_{j}{{\bm{W}}^{[1],i}}^{\intercal}{\bm{W}}^{[1],j}\right),</annotation></semantics></math></td>
