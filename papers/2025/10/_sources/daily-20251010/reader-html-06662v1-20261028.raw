<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E35.m2" class="ltx_Math" alttext="\displaystyle\frac{\epsilon^{k+1}}{2}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\epsilon^{k+1}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS2.Px9.p1.7" class="ltx_p">Thus</p>
<table id="A1.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E36.m1" class="ltx_Math" alttext="\displaystyle\|\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}-\frac{Q_{2,i}V_{2,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}-\frac{Q_{2,i}V_{2,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
<tbody id="A1.E37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E37.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E37.m2" class="ltx_Math" alttext="\displaystyle\|\frac{Q_{4,i}(Q_{2,i}-Q_{1,i})(V_{4,i}-V_{2,i})}{(Q_{1,i}+Q_{4,i})(Q_{2,i}+Q_{4,i})}\|+\|\frac{Q_{1,i}}{Q_{1,i}+Q_{4,i}}(V_{1,i}-V_{2,i})\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">‖</mo></mrow><mo>+</mo><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\frac{Q_{4,i}(Q_{2,i}-Q_{1,i})(V_{4,i}-V_{2,i})}{(Q_{1,i}+Q_{4,i})(Q_{2,i}+Q_{4,i})}\|+\|\frac{Q_{1,i}}{Q_{1,i}+Q_{4,i}}(V_{1,i}-V_{2,i})\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
<tbody id="A1.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E38.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E38.m2" class="ltx_Math" alttext="\displaystyle\frac{\epsilon^{k+1}}{6T_{0}}+\frac{\epsilon^{k+1}}{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>0</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\epsilon^{k+1}}{6T_{0}}+\frac{\epsilon^{k+1}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
<tbody id="A1.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E39.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E39.m2" class="ltx_Math" alttext="\displaystyle\epsilon^{k+1}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\epsilon^{k+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2.SSS2.Px10" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Case 2</h5>

<div id="A1.SS2.SSS2.Px10.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.Px10.p1.1" class="ltx_p">Case 2 can be rewritten as follows:</p>
<ul id="A1.I12" class="ltx_itemize">
<li id="A1.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I12.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I12.i1.p1.1" class="ltx_p"><math id="A1.I12.i1.p1.m1" class="ltx_Math" alttext="\|\frac{Q_{1,i}V_{1,i}+Q_{3,i}V_{3,i}}{Q_{1,i}+Q_{3,i}}-\frac{Q_{2,i}V_{2,i}+Q_{3,i}V_{3,i}}{Q_{2,i}+Q_{3,i}}\|_{2}\leq\frac{\epsilon^{k+1}}{3T_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac><mo>−</mo><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>0</mn></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\|\frac{Q_{1,i}V_{1,i}+Q_{3,i}V_{3,i}}{Q_{1,i}+Q_{3,i}}-\frac{Q_{2,i}V_{2,i}+Q_{3,i}V_{3,i}}{Q_{2,i}+Q_{3,i}}\|_{2}\leq\frac{\epsilon^{k+1}}{3T_{0}}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I12.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I12.i2.p1" class="ltx_para ltx_noindent">
<p id="A1.I12.i2.p1.1" class="ltx_p"><math id="A1.I12.i2.p1.m1" class="ltx_Math" alttext="Q_{1,i}+Q_{3,i}\leq\frac{\epsilon^{k+1}}{4}\sum_{w=1}^{s}\lambda_{i}(y_{w},t_{w})\leq\frac{\epsilon^{k+1}}{4}Q_{4,i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>≤</mo><mrow><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></msubsup><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>w</mi></msub><mo>,</mo><msub><mi>t</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">Q_{1,i}+Q_{3,i}\leq\frac{\epsilon^{k+1}}{4}\sum_{w=1}^{s}\lambda_{i}(y_{w},t_{w})\leq\frac{\epsilon^{k+1}}{4}Q_{4,i}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I12.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I12.i3.p1" class="ltx_para">
<p id="A1.I12.i3.p1.1" class="ltx_p"><math id="A1.I12.i3.p1.m1" class="ltx_Math" alttext="Q_{2,i}+Q_{3,i}\leq\frac{\epsilon^{k+1}}{4}\sum_{w=1}^{s}\lambda_{i}(y_{w},t_{w})\leq\frac{\epsilon^{k+1}}{4}Q_{4,i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>3</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>≤</mo><mrow><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></msubsup><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>w</mi></msub><mo>,</mo><msub><mi>t</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">Q_{2,i}+Q_{3,i}\leq\frac{\epsilon^{k+1}}{4}\sum_{w=1}^{s}\lambda_{i}(y_{w},t_{w})\leq\frac{\epsilon^{k+1}}{4}Q_{4,i}</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A1.SS2.SSS2.Px10.p1.2" class="ltx_p">Thus</p>
<table id="A1.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E40.m1" class="ltx_Math" alttext="\displaystyle\|\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}-\frac{Q_{2,i}V_{2,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}-\frac{Q_{2,i}V_{2,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
<tbody id="A1.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E41.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41.m2" class="ltx_Math" alttext="\displaystyle\|\frac{Q_{4,i}(Q_{2,i}-Q_{1,i})(V_{4,i}-V_{2,i})}{(Q_{1,i}+Q_{4,i})(Q_{2,i}+Q_{4,i})}\|+\|\frac{Q_{1,i}}{Q_{1,i}+Q_{4,i}}(V_{1,i}-V_{2,i})\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">‖</mo></mrow><mo>+</mo><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\frac{Q_{4,i}(Q_{2,i}-Q_{1,i})(V_{4,i}-V_{2,i})}{(Q_{1,i}+Q_{4,i})(Q_{2,i}+Q_{4,i})}\|+\|\frac{Q_{1,i}}{Q_{1,i}+Q_{4,i}}(V_{1,i}-V_{2,i})\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
<tbody id="A1.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E42.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E42.m2" class="ltx_Math" alttext="\displaystyle\|\frac{(Q_{2,i}-Q_{1,i})(V_{4,i}-V_{2,i})}{(Q_{2,i}+Q_{4,i})}\|+\|\frac{Q_{1,i}}{Q_{1,i}+Q_{4,i}}(V_{1,i}-V_{2,i})\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo stretchy="false">‖</mo></mrow><mo>+</mo><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\frac{(Q_{2,i}-Q_{1,i})(V_{4,i}-V_{2,i})}{(Q_{2,i}+Q_{4,i})}\|+\|\frac{Q_{1,i}}{Q_{1,i}+Q_{4,i}}(V_{1,i}-V_{2,i})\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
<tbody id="A1.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E43.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43.m2" class="ltx_Math" alttext="\displaystyle\|\frac{\epsilon^{k+1}(V_{4,i}-V_{2,i})}{4}\|+\|\frac{\epsilon^{k+1}}{4}(V_{1,i}-V_{2,i})\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle><mo stretchy="false">‖</mo></mrow><mo>+</mo><mrow><mo stretchy="false">‖</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\frac{\epsilon^{k+1}(V_{4,i}-V_{2,i})}{4}\|+\|\frac{\epsilon^{k+1}}{4}(V_{1,i}-V_{2,i})\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
<tbody id="A1.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E44.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E44.m2" class="ltx_Math" alttext="\displaystyle\epsilon^{k+1}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\epsilon^{k+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS2.SSS2.Px10.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.Px10.p2.1" class="ltx_p">And it can be seen from definition that</p>
<ul id="A1.I13" class="ltx_itemize">
<li id="A1.I13.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I13.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I13.i1.p1.1" class="ltx_p"><math id="A1.I13.i1.p1.m1" class="ltx_Math" alttext="\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}</annotation></semantics></math> is the output of the <math id="A1.I13.i1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th head of the attention layer with input sequence <math id="A1.I13.i1.p1.m3" class="ltx_Math" alttext="W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">W_{1}</annotation></semantics></math>. (which means <math id="A1.I13.i1.p1.m4" class="ltx_Math" alttext="\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}=\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{1}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{1}}(t)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mrow><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mrow><mi>K</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>1</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>1</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{Q_{1,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{1,i}+Q_{4,i}}=\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{1}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{1}}(t)</annotation></semantics></math>).</p>
</div></li>
<li id="A1.I13.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I13.i2.p1" class="ltx_para">
<p id="A1.I13.i2.p1.1" class="ltx_p"><math id="A1.I13.i2.p1.m1" class="ltx_Math" alttext="\frac{Q_{2,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>1</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac><annotation encoding="application/x-tex">\frac{Q_{2,i}V_{1,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}</annotation></semantics></math> is the output of the <math id="A1.I13.i2.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th head of the attention layer with input sequence <math id="A1.I13.i2.p1.m3" class="ltx_Math" alttext="W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">W_{2}</annotation></semantics></math>. (which means <math id="A1.I13.i2.p1.m4" class="ltx_Math" alttext="\frac{Q_{2,i}V_{2,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}=\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{2}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{2}}(t)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mrow><mrow><msub><mi>Q</mi><mrow><mn>2</mn><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>Q</mi><mrow><mn>4</mn><mo>,</mo><mi>i</mi></mrow></msub></mrow></mfrac><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mrow><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mrow><mi>K</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>2</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>2</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{Q_{2,i}V_{2,i}+Q_{4,i}V_{4,i}}{Q_{2,i}+Q_{4,i}}=\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{2}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{2}}(t)</annotation></semantics></math>).</p>
</div></li>
</ul>
<p id="A1.SS2.SSS2.Px10.p2.2" class="ltx_p">Then for each <math id="A1.SS2.SSS2.Px10.p2.m1" class="ltx_Math" alttext="i=1,\dots,s" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,s</annotation></semantics></math>, we have that</p>
<table id="A1.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E45.m1" class="ltx_Math" alttext="\displaystyle\|\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{1}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{1}}(t)-\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{2}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{2}}(t)\|\leq\epsilon^{k+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mrow><mi>K</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>1</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>1</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mrow><mi>K</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>2</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><msub><mi>w</mi><mn>2</mn></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\|\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{1}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{1}}(t)-\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{2}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{2}}(t)\|\leq\epsilon^{k+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS2.Px10.p2.3" class="ltx_p">Therefore, as <math id="A1.SS2.SSS2.Px10.p2.m2" class="ltx_Math" alttext="W_{O}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>O</mi></msub><annotation encoding="application/x-tex">W_{O}</annotation></semantics></math> have entries bounded by <math id="A1.SS2.SSS2.Px10.p2.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, we have</p>
<table id="A1.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46.m1" class="ltx_math_unparsed" alttext="\displaystyle\|\Bigl[\hat{c}_{0}+W_{O}\operatorname{Concat}_{i=1}^{h}\Bigl(\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{1}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{1}}(t)\Bigr)\Bigr]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub><mo>+</mo><msub><mi>W</mi><mi>O</mi></msub><msubsup><mi>Concat</mi><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></msubsup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>K</mi><mo>,</mo><mi>i</mi></mrow></msub><mover accent="true"><msub><mi>w</mi><mn>1</mn></msub><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mi>W</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow></msub><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub><mo>]</mo></mrow><msub><mi>W</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow></msub><mover accent="true"><msub><mi>w</mi><mn>1</mn></msub><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\|\Bigl[\hat{c}_{0}+W_{O}\operatorname{Concat}_{i=1}^{h}\Bigl(\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{1}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{1}}(t)\Bigr)\Bigr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
<tbody id="A1.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E47.m1" class="ltx_Math" alttext="\displaystyle-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">\displaystyle-</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47.m2" class="ltx_math_unparsed" alttext="\displaystyle\Bigl[\hat{c}_{0}+W_{O}\operatorname{Concat}_{i=1}^{h}\Bigl(\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{2}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{2}}(t)\Bigr)\Bigr]\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub><mo>+</mo><msub><mi>W</mi><mi>O</mi></msub><msubsup><mi>Concat</mi><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></msubsup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>K</mi><mo>,</mo><mi>i</mi></mrow></msub><mover accent="true"><msub><mi>w</mi><mn>2</mn></msub><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msub><mi>W</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow></msub><msub><mover accent="true"><mi>c</mi><mo>^</mo></mover><mn>0</mn></msub><mo>]</mo></mrow><msub><mi>W</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow></msub><mover accent="true"><msub><mi>w</mi><mn>2</mn></msub><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0em">∥</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigl[\hat{c}_{0}+W_{O}\operatorname{Concat}_{i=1}^{h}\Bigl(\sum_{t=1}^{T}\sigma\!\left[(W_{K,i}\hat{w_{2}}(t))^{\top}W_{Q,i}\hat{c}_{0}\right]W_{V,i}\hat{w_{2}}(t)\Bigr)\Bigr]\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
<tbody id="A1.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E48.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48.m2" class="ltx_Math" alttext="\displaystyle s\epsilon^{k+1}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle s\epsilon^{k+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<p id="A1.SS2.SSS2.Px10.p2.4" class="ltx_p">However, it has been proven above that we need <math id="A1.SS2.SSS2.Px10.p2.m4" class="ltx_Math" alttext="|Model(W_{1})-Model(W_{2})|\geq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">|Model(W_{1})-Model(W_{2})|\geq\epsilon</annotation></semantics></math> to achieve <math id="A1.SS2.SSS2.Px10.p2.m5" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-approximation of the target function. According to lemma <a href="#Thmlemma4" title="Lemma 4. ‣ Proof Sketch. ‣ A.2.2 Proof of Theorem ‣ A.2 Proof of Theorem ‣ Appendix A Proofs of Main Theorems ‣ The Effect of Attention Head Count on Transformer Approximation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, the required parameter count of the FFN <math id="A1.SS2.SSS2.Px10.p2.m6" class="ltx_Math" alttext="\hat{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{F}</annotation></semantics></math> is of order <math id="A1.SS2.SSS2.Px10.p2.m7" class="ltx_Math" alttext="\Omega(\epsilon/\epsilon^{k+1})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϵ</mi><mo>/</mo><msup><mi>ϵ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\epsilon/\epsilon^{k+1})</annotation></semantics></math>.
Thus the parameter count required to achieve <math id="A1.SS2.SSS2.Px10.p2.m8" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-approximation is <math id="A1.SS2.SSS2.Px10.p2.m9" class="ltx_Math" alttext="\Omega(1/\epsilon^{k})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>ϵ</mi><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(1/\epsilon^{k})</annotation></semantics></math>.</p>
</div>
<div id="A1.SS2.SSS2.Px10.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS2.Px10.p3.1" class="ltx_p">∎</p>
</div>
</section>
</section>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proof of Theorem <a href="#S5.I1.i3" title="item 2 (3) ‣ Theorem 2 (Approximation rates of transformers). ‣ 5 Approximation rate of Generalized 𝐷-Retrieval Tasks ‣ The Effect of Attention Head Count on Transformer Approximation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2 (3)</span></a></h3>

<section id="A1.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Proof Sketch.</h5>

<div id="A1.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p1.1" class="ltx_p">The argument is based on an explicit construction.
We begin with trivial attention, so that the post-attention output is simply the
averaged concatenation <math id="A1.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\tfrac{1}{T}(x(1),\dots,x(T))\in\mathbb{R}^{Td}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tfrac{1}{T}(x(1),\dots,x(T))\in\mathbb{R}^{Td}</annotation></semantics></math>.
The feed-forward block can then be used to compute the transformations
<math id="A1.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="f_{i}(x(t))" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{i}(x(t))</annotation></semantics></math>, perform the necessary comparisons, and approximate <math id="A1.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="F_{0}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>0</mn></msub><annotation encoding="application/x-tex">F_{0}</annotation></semantics></math>,
as ensured by Lemmas <a href="#Thmlemma9" title="Lemma 9 (Approximating max with a shallow ReLU network). ‣ Proof Sketch. ‣ A.3 Proof of Theorem ‣ Appendix A Proofs of Main Theorems ‣ The Effect of Attention Head Count on Transformer Approximation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> and <a href="#Thmlemma8" title="Lemma 8. ‣ Proof Sketch. ‣ A.3 Proof of Theorem ‣ Appendix A Proofs of Main Theorems ‣ The Effect of Attention Head Count on Transformer Approximation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>.</p>
</div>
<div id="A1.SS3.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p2.1" class="ltx_p">Having outlined the main idea, we now proceed to the detailed proof.
As a first step, we introduce several auxiliary lemmas that will be used in the argument.</p>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma8.p1.1" class="ltx_p"><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">Fix a pointwise activation <math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> (e.g., ReLU or any activation used in this paper).
Let <math id="Thmlemma8.p1.m2" class="ltx_Math" alttext="F_{1}:\mathbb{R}^{m_{1}}\to\mathbb{R}^{m_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">F_{1}:\mathbb{R}^{m_{1}}\to\mathbb{R}^{m_{2}}</annotation></semantics></math> be a <math id="Thmlemma8.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-layer fully connected network,
<math id="Thmlemma8.p1.m4" class="ltx_Math" alttext="F_{2}:\mathbb{R}^{m_{2}}\to\mathbb{R}^{m_{3}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>m</mi><mn>2</mn></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>3</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">F_{2}:\mathbb{R}^{m_{2}}\to\mathbb{R}^{m_{3}}</annotation></semantics></math> a <math id="Thmlemma8.p1.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-layer fully connected network,
and <math id="Thmlemma8.p1.m6" class="ltx_Math" alttext="F_{3}:\mathbb{R}^{m_{3}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>3</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>m</mi><mn>3</mn></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">F_{3}:\mathbb{R}^{m_{3}}\to\mathbb{R}</annotation></semantics></math> a <math id="Thmlemma8.p1.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-layer fully connected network.
Let <math id="Thmlemma8.p1.m8" class="ltx_Math" alttext="W_{1},W_{2},W_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><msub><mi>W</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">W_{1},W_{2},W_{3}</annotation></semantics></math> denote their respective (maximum) hidden widths, and set
<math id="Thmlemma8.p1.m9" class="ltx_Math" alttext="W:=\max\{W_{1},W_{2},W_{3}\}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>:=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><msub><mi>W</mi><mn>3</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W:=\max\{W_{1},W_{2},W_{3}\}</annotation></semantics></math>.
Then there exists a <math id="Thmlemma8.p1.m10" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-layer fully connected network
<math id="Thmlemma8.p1.m11" class="ltx_Math" alttext="G:\mathbb{R}^{m_{1}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">G:\mathbb{R}^{m_{1}}\to\mathbb{R}</annotation></semantics></math> with activation <math id="Thmlemma8.p1.m12" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> and hidden width at most <math id="Thmlemma8.p1.m13" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>
such that</span></p>
<table id="A1.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex91.m1" class="ltx_Math" alttext="G(x)\;=\;F_{3}\!\bigl(F_{2}\!\bigl(F_{1}(x)\bigr)\bigr)\qquad\text{for all }x\in\mathbb{R}^{m_{1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msub><mi>F</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>F</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>F</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G(x)\;=\;F_{3}\!\bigl(F_{2}\!\bigl(F_{1}(x)\bigr)\bigr)\qquad\text{for all }x\in\mathbb{R}^{m_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS3.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p3.1" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p3.1.1" class="ltx_text">Proof of Lemma <a href="#Thmlemma8" title="Lemma 8. ‣ Proof Sketch. ‣ A.3 Proof of Theorem ‣ Appendix A Proofs of Main Theorems ‣ The Effect of Attention Head Count on Transformer Approximation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>
Write the three networks in affine–nonlinearity form (with a pointwise activation <math id="A1.SS3.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>):</span></p>
<table id="A1.Ex92" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex92X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex92X.m2" class="ltx_Math" alttext="\displaystyle F_{1}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F_{1}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92X.m3" class="ltx_Math" alttext="\displaystyle=A_{1}\,\sigma(B_{1}x+b_{1})+a_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>B</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>a</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=A_{1}\,\sigma(B_{1}x+b_{1})+a_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92X.m5" class="ltx_Math" alttext="\displaystyle x\in\mathbb{R}^{m_{1}},\;F_{1}(x)\in\mathbb{R}^{m_{2}}," display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>m</mi><mn>1</mn></msub></msup><mo rspace="0.447em">,</mo><mi>F</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>m</mi><mn>2</mn></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle x\in\mathbb{R}^{m_{1}},\;F_{1}(x)\in\mathbb{R}^{m_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex92Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex92Xa.m2" class="ltx_Math" alttext="\displaystyle F_{2}(u)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F_{2}(u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92Xa.m3" class="ltx_Math" alttext="\displaystyle=C_{2}\,\sigma\!\bigl(D_{2}\,\sigma(E_{2}u+e_{2})+d_{2}\bigr)+c_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.437em;" width="0.437em"><mi>σ</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>D</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>E</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=C_{2}\,\sigma\!\bigl(D_{2}\,\sigma(E_{2}u+e_{2})+d_{2}\bigr)+c_{2},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92Xa.m5" class="ltx_Math" alttext="\displaystyle u\in\mathbb{R}^{m_{2}},\;F_{2}(u)\in\mathbb{R}^{m_{3}}," display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>m</mi><mn>2</mn></msub></msup><mo rspace="0.447em">,</mo><mi>F</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>m</mi><mn>3</mn></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle u\in\mathbb{R}^{m_{2}},\;F_{2}(u)\in\mathbb{R}^{m_{3}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex92Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex92Xb.m2" class="ltx_Math" alttext="\displaystyle F_{3}(v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle F_{3}(v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92Xb.m3" class="ltx_Math" alttext="\displaystyle=p_{3}\,\sigma(Q_{3}v+q_{3})+r_{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>p</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Q</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><msub><mi>q</mi><mn>3</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>r</mi><mn>3</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=p_{3}\,\sigma(Q_{3}v+q_{3})+r_{3},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex92Xb.m5" class="ltx_Math" alttext="\displaystyle v\in\mathbb{R}^{m_{3}},\;F_{3}(v)\in\mathbb{R}." display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>ℝ</mi><msup><mrow></mrow><msub><mi>m</mi><mn>3</mn></msub></msup><mo rspace="0.447em">,</mo><mi>F</mi><msub><mrow></mrow><mn>3</mn></msub><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo>∈</mo><mi>ℝ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle v\in\mathbb{R}^{m_{3}},\;F_{3}(v)\in\mathbb{R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.SSS0.Px1.p3.2" class="ltx_p"><span id="A1.SS3.SSS0.Px1.p3.2.1" class="ltx_text">Define a <math id="A1.SS3.SSS0.Px1.p3.m2" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>-layer fully connected network <math id="A1.SS3.SSS0.Px1.p3.m3" class="ltx_Math" alttext="G:\mathbb{R}^{m_{1}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>m</mi><mn>1</mn></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">G:\mathbb{R}^{m_{1}}\to\mathbb{R}</annotation></semantics></math> by stacking the
hidden layers of <math id="A1.SS3.SSS0.Px1.p3.m4" class="ltx_Math" alttext="F_{1}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>1</mn></msub><annotation encoding="application/x-tex">F_{1}</annotation></semantics></math> (one), <math id="A1.SS3.SSS0.Px1.p3.m5" class="ltx_Math" alttext="F_{2}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>2</mn></msub><annotation encoding="application/x-tex">F_{2}</annotation></semantics></math> (two), and <math id="A1.SS3.SSS0.Px1.p3.m6" class="ltx_Math" alttext="F_{3}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>3</mn></msub><annotation encoding="application/x-tex">F_{3}</annotation></semantics></math> (one), keeping their original widths:</span></p>
<table id="A1.Ex93" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex93X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex93X.m2" class="ltx_Math" alttext="\displaystyle h_{1}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{1}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex93X.m3" class="ltx_Math" alttext="\displaystyle:=\sigma(B_{1}x+b_{1})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>B</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\sigma(B_{1}x+b_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
