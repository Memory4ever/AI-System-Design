             Rewrite the original statement and qualify it

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             <span id="alg1.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l2.m1" class="ltx_Math" alttext="(x_{i},y_{i})\in D" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">(x_{i},y_{i})\in D</annotation></semantics></math> <span id="alg1.l2.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              <math id="alg1.l3.m1" class="ltx_Math" alttext="r_{i}=F_{task}(x_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}=F_{task}(x_{i})</annotation></semantics></math> or <math id="alg1.l3.m2" class="ltx_Math" alttext="r_{i}=F_{task}(x_{i},y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}=F_{task}(x_{i},y_{i})</annotation></semantics></math>;

</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <math id="alg1.l4.m1" class="ltx_Math" alttext="sim_{score}=metric(r_{i},x_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><mo>=</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">sim_{score}=metric(r_{i},x_{i})</annotation></semantics></math>;

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <span id="alg1.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="sim_{score}&lt;\gamma" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><mo>&lt;</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">sim_{score}&lt;\gamma</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
               <math id="alg1.l6.m1" class="ltx_Math" alttext="R_{i}=x_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>=</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">R_{i}=x_{i}</annotation></semantics></math>;

</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <span id="alg1.l7.3" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
               <math id="alg1.l8.m1" class="ltx_Math" alttext="R_{i}=r_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>=</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">R_{i}=r_{i}</annotation></semantics></math>;

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <span id="alg1.l9.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
             <span id="alg1.l10.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
             <span id="alg1.l11.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>;

