<section id="A4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.1.1 </span>Exact match accuracy</h4>

<figure id="A4.T6" class="ltx_table">
