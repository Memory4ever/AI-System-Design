<th id="A4.T6.2.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<th id="A4.T6.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Metric</th>
<th id="A4.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Subword</th>
