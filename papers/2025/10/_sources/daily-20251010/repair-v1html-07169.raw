<span id="S4.T3.2.1.1.1.3.3.1.1" class="ltx_p ltx_align_center">–0.46</span>
</span></span></span>
<span id="S4.T3.2.1.1.1.4" class="ltx_tr">
<span id="S4.T3.2.1.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">MMLU-Pro</span>
<span id="S4.T3.2.1.1.1.4.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S4.T3.2.1.1.1.4.2.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S4.T3.2.1.1.1.4.2.1.1" class="ltx_p ltx_align_center">14.58</span>
</span></span>
<span id="S4.T3.2.1.1.1.4.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S4.T3.2.1.1.1.4.3.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
