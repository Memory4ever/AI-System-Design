<th id="S4.T1.st2.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt"><span id="S4.T1.st2.5.1.1.1" class="ltx_text ltx_font_bold">Method</span></th>
<td id="S4.T1.st2.5.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.st2.5.1.2.1" class="ltx_text ltx_font_bold">R@1 ↑</span></td>
<td id="S4.T1.st2.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.st2.5.1.3.1" class="ltx_text ltx_font_bold">R@2 ↑</span></td>
<td id="S4.T1.st2.5.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.st2.5.1.4.1" class="ltx_text ltx_font_bold">R@3 ↑</span></td>
