<td id="S4.F2.3.1.2.1" class="ltx_td ltx_align_left ltx_align_middle" style="padding:1.5pt 4.0pt;">
<div id="S4.F2.3.1.2.1.1" class="ltx_inline-block ltx_align_center ltx_align_middle ltx_transformed_outer" style="width:5.7pt;height:53.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:53.9pt;transform:translate(-23.5pt,-23.5pt) rotate(-90deg) ;">
<p id="S4.F2.3.1.2.1.1.1" class="ltx_p"><span id="S4.F2.3.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Pretrained</span></p>
</span></div></td>
<td id="S4.F2.3.1.2.2" class="ltx_td ltx_align_left ltx_align_middle" style="padding:1.5pt 4.0pt;">
<span id="S4.F2.3.1.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:99.6pt;"><img src="2510.06988v1/images/75_pre_mesh.png" id="S4.F2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:617/617;" width="617" height="617" alt="Refer to caption">
