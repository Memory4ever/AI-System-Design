<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex347.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\left|\gamma_{i,j}^{(2)}(0)\right|^{-1}-\frac{18}{b_{i}^{2}}\left(c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)T\left(\frac{m^{\frac{3}{2}}}{d^{\frac{1}{4}}}\right)\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mrow><msup><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>18</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><msup><mi>d</mi><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\left|\gamma_{i,j}^{(2)}(0)\right|^{-1}-\frac{18}{b_{i}^{2}}\left(c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)T\left(\frac{m^{\frac{3}{2}}}{d^{\frac{1}{4}}}\right)\right)^{-1}</annotation></semantics></math></td>
