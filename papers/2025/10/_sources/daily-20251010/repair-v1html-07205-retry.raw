<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex403.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{1}{a_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\right|\left(\left|\gamma_{i,j_{\ell}^{\star}}^{(1)}(t)\right|+\left|\gamma_{j,j_{\ell}^{\star}}^{(1)}(t)\right|\right)-\frac{1}{a_{i}^{2}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\left|I_{i,j}^{(1)}(t)\right|\mathbb{I}\left\{i=i_{\ell}^{\star}\vee j=i_{\ell}^{\star}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo fence="false" rspace="0.167em">|</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mo>(</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>γ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mo>)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>∨</mo><mi>j</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{a_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\right|\left(\left|\gamma_{i,j_{\ell}^{\star}}^{(1)}(t)\right|+\left|\gamma_{j,j_{\ell}^{\star}}^{(1)}(t)\right|\right)-\frac{1}{a_{i}^{2}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\left|I_{i,j}^{(1)}(t)\right|\mathbb{I}\left\{i=i_{\ell}^{\star}\vee j=i_{\ell}^{\star}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
