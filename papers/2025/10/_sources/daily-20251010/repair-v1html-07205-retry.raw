<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex134.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad-\frac{3}{b_{i}}\sum_{r=1}^{m}\left(\lambda_{i,r,2}I_{i,i}^{(3)}+\lambda_{i,r,3}I_{r,i}^{(3)}+3\lambda_{i,r,5}I_{r,i}^{(2)}\right)\bar{{\mathbf{w}}}_{i}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>3</mn></mrow></msub><msubsup><mi>I</mi><mrow><mi>r</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mn>3</mn><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>5</mn></mrow></msub><msubsup><mi>I</mi><mrow><mi>r</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad-\frac{3}{b_{i}}\sum_{r=1}^{m}\left(\lambda_{i,r,2}I_{i,i}^{(3)}+\lambda_{i,r,3}I_{r,i}^{(3)}+3\lambda_{i,r,5}I_{r,i}^{(2)}\right)\bar{{\mathbf{w}}}_{i}</annotation></semantics></math></td>
