<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex285.m2" class="ltx_math_unparsed" alttext="\displaystyle=\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\zeta_{j,j_{\ell}^{\star}}^{(2)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow><mo>±</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mi>m</mi><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\zeta_{j,j_{\ell}^{\star}}^{(2)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
