<p id="A1.SS5.p16.6" class="ltx_p"><span id="A1.SS5.p16.6.1" class="ltx_text">Recalling that <math id="A1.SS5.p16.m8" class="ltx_Math" alttext="\lambda_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\geq 0</annotation></semantics></math> for all <math id="A1.SS5.p16.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we have that</span></p>
<table id="A1.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex460"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex460.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\left|I_{i,i}^{(3)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\left|I_{i,i}^{(3)}(t)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex460.m2" class="ltx_Math" alttext="\displaystyle\leq-\left(36C_{S,2}\left(\frac{1}{a_{i}^{2}}+\frac{1}{b_{i}^{2}}\right)-\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)\left|I_{i,i}^{(3)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mrow><mn>36</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>S</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\left(36C_{S,2}\left(\frac{1}{a_{i}^{2}}+\frac{1}{b_{i}^{2}}\right)-\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)\left|I_{i,i}^{(3)}(t)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex461"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex461.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex462"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex462.m1" class="ltx_Math" alttext="\displaystyle\leq-35C_{S,2}\left(\frac{1}{a_{i}^{2}}+\frac{1}{b_{i}^{2}}\right)\left|I_{i,i}^{(3)}(t)\right|+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mn>35</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mi>S</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-35C_{S,2}\left(\frac{1}{a_{i}^{2}}+\frac{1}{b_{i}^{2}}\right)\left|I_{i,i}^{(3)}(t)\right|+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p16.7" class="ltx_p"><span id="A1.SS5.p16.7.1" class="ltx_text">Since <math id="A1.SS5.p16.m10" class="ltx_Math" alttext="\varepsilon_{\mathcal{A},\ell}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{A},\ell}^{(2)}(t)</annotation></semantics></math> is monotonically non-decreasing, we must have that <math id="A1.SS5.p16.m11" class="ltx_Math" alttext="I_{i,i}^{(3)}\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{i,i}^{(3)}\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math> for all <math id="A1.SS5.p16.m12" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A1.SS5.p17" class="ltx_para ltx_noindent">
<p id="A1.SS5.p17.1" class="ltx_p">With the above preparation work, we are ready to derive the result for phase 1 convergence.</p>
</div>
<div id="Thmlemma13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma13.2" class="ltx_text ltx_font_bold">Lemma 13</span></span><span id="Thmlemma13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma13.p1" class="ltx_para">
<p id="Thmlemma13.p1.1" class="ltx_p"><span id="Thmlemma13.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the inductive hypothesis in Condition <a href="#Thmcond2" title="Condition 2 (Inductive Hypothesis). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and the initialization condition in Condition <a href="#Thmcond1" title="Condition 1 (Initialization). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Let <math id="Thmlemma13.p1.m1" class="ltx_Math" alttext="T_{c}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>c</mi></msub><annotation encoding="application/x-tex">T_{c}</annotation></semantics></math> be defined in (<a href="#A1.E14" title="In A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and <math id="Thmlemma13.p1.m2" class="ltx_Math" alttext="T(\xi)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\xi)</annotation></semantics></math> be defined in Definition <a href="#Thmdefin2" title="Definition 2 (Recovery Time). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Then there exists constant <math id="Thmlemma13.p1.m3" class="ltx_Math" alttext="\beta_{7}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>7</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{7}\geq 0</annotation></semantics></math> such that for all <math id="Thmlemma13.p1.m4" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> satisfying <math id="Thmlemma13.p1.m5" class="ltx_Math" alttext="(1-\xi^{2})^{-1}\leq\mathcal{O}\left(1\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\xi^{2})^{-1}\leq\mathcal{O}\left(1\right)</annotation></semantics></math> and all constant <math id="Thmlemma13.p1.m6" class="ltx_Math" alttext="\beta_{8}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>8</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{8}\geq 0</annotation></semantics></math>, it holds that <math id="Thmlemma13.p1.m7" class="ltx_Math" alttext="T_{c}\geq\min\left\{T\left(\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m^{2}},T\left(\xi\right)\right\}+\beta_{8}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>≥</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mi>β</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><msup><mi>m</mi><mn>2</mn></msup></mfrac></mrow><mo>,</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">T_{c}\geq\min\left\{T\left(\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m^{2}},T\left(\xi\right)\right\}+\beta_{8}</annotation></semantics></math>, and there exists <math id="Thmlemma13.p1.m8" class="ltx_Math" alttext="T_{1}\leq\min\left\{T_{c},\mathcal{O}\left(\sqrt{d}\right)\right\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><msub><mi>T</mi><mi>c</mi></msub><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mi>d</mi></msqrt><mo>)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{1}\leq\min\left\{T_{c},\mathcal{O}\left(\sqrt{d}\right)\right\}</annotation></semantics></math> such that for all <math id="Thmlemma13.p1.m9" class="ltx_Math" alttext="T_{1}\leq t\leq T_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≤</mo><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">T_{1}\leq t\leq T_{c}</annotation></semantics></math> we have that <math id="Thmlemma13.p1.m10" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t),\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0.9</mn></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t),\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9</annotation></semantics></math>.</span></p>
</div>
<div id="Thmlemma13.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Thmlemma13.p2" class="ltx_para ltx_noindent">
<p id="Thmlemma13.p2.1" class="ltx_p"><span id="Thmlemma13.p2.1.1" class="ltx_text">By Lemma <a href="#Thmlemma10" title="Lemma 10. ‣ A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, Lemma <a href="#Thmlemma11" title="Lemma 11. ‣ A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a> and Lemma <a href="#Thmlemma12" title="Lemma 12. ‣ A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>, we have that <math id="Thmlemma13.p2.m1" class="ltx_Math" alttext="T_{c}\geq\min\left\{T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m},T\left(\xi\right)\right\}+\beta_{8}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>≥</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msub><mi>δ</mi><mi>ℙ</mi></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mi>β</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>m</mi></mfrac></mrow><mo>,</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">T_{c}\geq\min\left\{T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m},T\left(\xi\right)\right\}+\beta_{8}</annotation></semantics></math>. Thus, it remains to show that there exists some <math id="Thmlemma13.p2.m2" class="ltx_Math" alttext="T_{1}\leq T_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≤</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">T_{1}\leq T_{c}</annotation></semantics></math> such that <math id="Thmlemma13.p2.m3" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t),\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0.9</mn></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t),\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9</annotation></semantics></math>. To start, we choose <math id="Thmlemma13.p2.m4" class="ltx_Math" alttext="\xi=\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\xi=\frac{1}{2}</annotation></semantics></math>. By Lemma <a href="#Thmlemma8" title="Lemma 8. ‣ A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> we have that</span></p>
<table id="A1.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex463"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex463.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{2}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex463.m2" class="ltx_Math" alttext="\displaystyle=\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T\left(\frac{1}{2}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T\left(\frac{1}{2}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex464"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex464.m1" class="ltx_Math" alttext="\displaystyle\geq\left(\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)\right)^{-1}-\frac{18}{b_{i_{\ell}^{\star}}}\left(c_{0}^{2}\left(1-\frac{1}{4}\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)\left(T\left(\frac{1}{2}\right)-T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)\right)\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><msup><mrow><mo>(</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><mi>ℙ</mi></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>18</mn><msub><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><mi>ℙ</mi></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left(\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)\right)^{-1}-\frac{18}{b_{i_{\ell}^{\star}}}\left(c_{0}^{2}\left(1-\frac{1}{4}\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)\left(T\left(\frac{1}{2}\right)-T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)\right)\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p2.2" class="ltx_p"><span id="Thmlemma13.p2.2.1" class="ltx_text">This gives that</span></p>
<table id="A1.Ex465" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex465.m1" class="ltx_Math" alttext="T\left(\frac{1}{2}\right)\leq\mathcal{O}\left(\frac{d^{\frac{2}{5}}}{\delta_{\mathbb{P}}^{2}}\right)+T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)\leq T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m}" display="block" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msub><mi>δ</mi><mi>ℙ</mi></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msub><mi>δ</mi><mi>ℙ</mi></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mi>β</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>m</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">T\left(\frac{1}{2}\right)\leq\mathcal{O}\left(\frac{d^{\frac{2}{5}}}{\delta_{\mathbb{P}}^{2}}\right)+T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)\leq T\left(\frac{\delta_{\mathbb{P}}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p2.3" class="ltx_p"><span id="Thmlemma13.p2.3.1" class="ltx_text">when <math id="Thmlemma13.p2.m5" class="ltx_Math" alttext="d\geq\delta_{\mathbb{P}}^{10}m^{5}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>10</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>5</mn></msup></mrow></mrow><annotation encoding="application/x-tex">d\geq\delta_{\mathbb{P}}^{10}m^{5}</annotation></semantics></math>.
Thus, it suffice to show that a <math id="Thmlemma13.p2.m6" class="ltx_Math" alttext="T_{1}\leq T\left(\frac{1}{2}\right)+\beta_{8}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">T_{1}\leq T\left(\frac{1}{2}\right)+\beta_{8}</annotation></semantics></math> achieves <math id="Thmlemma13.p2.m7" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t),\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0.9</mn></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t),\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9</annotation></semantics></math> for some constant <math id="Thmlemma13.p2.m8" class="ltx_Math" alttext="\beta_{8}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>8</mn></msub><annotation encoding="application/x-tex">\beta_{8}</annotation></semantics></math>. Notice that this choice of <math id="Thmlemma13.p2.m9" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math> satisfies <math id="Thmlemma13.p2.m10" class="ltx_Math" alttext="T_{1}\leq\mathcal{O}\left(\sqrt{d}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mi>d</mi></msqrt><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{1}\leq\mathcal{O}\left(\sqrt{d}\right)</annotation></semantics></math> That is, if we define</span></p>
<table id="A1.Ex466" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex466.m1" class="ltx_Math" alttext="T_{1,1}=\min\left\{t\geq 0:\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\geq 0.9\right\};\;T_{1,2}=\min\left\{t\geq 0:\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9\right\}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0.9</mn></mrow><mo>}</mo></mrow></mrow></mrow><mo rspace="0.447em">;</mo><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0.9</mn></mrow><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{1,1}=\min\left\{t\geq 0:\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\geq 0.9\right\};\;T_{1,2}=\min\left\{t\geq 0:\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0.9\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p2.4" class="ltx_p"><span id="Thmlemma13.p2.4.1" class="ltx_text">Then it suffice to show that <math id="Thmlemma13.p2.m11" class="ltx_Math" alttext="T_{1,1},T_{1,2}\leq T\left(\frac{1}{2}\right)+\beta_{8}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{1,1},T_{1,2}\leq T\left(\frac{1}{2}\right)+\beta_{8}</annotation></semantics></math>. By Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we have that for <math id="Thmlemma13.p2.m12" class="ltx_Math" alttext="T\left(\frac{1}{2}\right)\leq t\leq\min\left\{T_{1,2},T\left(\frac{1}{2}\right)+\beta_{8}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>,</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T\left(\frac{1}{2}\right)\leq t\leq\min\left\{T_{1,2},T\left(\frac{1}{2}\right)+\beta_{8}\right\}</annotation></semantics></math>, it holds that</span></p>
<table id="A1.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex467"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex467.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex467.m2" class="ltx_Math" alttext="\displaystyle\geq\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}-\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}-\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex468"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex468.m1" class="ltx_Math" alttext="\displaystyle\geq\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\left(c_{0}^{2}-\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\left(c_{0}^{2}-\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex469"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex469.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{c_{0}^{2}}{2}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{c_{0}^{2}}{2}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p2.5" class="ltx_p"><span id="Thmlemma13.p2.5.1" class="ltx_text">This shows that <math id="Thmlemma13.p2.m13" class="ltx_Math" alttext="\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0</annotation></semantics></math> as long as <math id="Thmlemma13.p2.m14" class="ltx_Math" alttext="1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\geq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≥</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\geq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math>. Thus, we can conclude that <math id="Thmlemma13.p2.m15" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq\frac{1}{2}</annotation></semantics></math> for all <math id="Thmlemma13.p2.m16" class="ltx_Math" alttext="T\left(\frac{1}{2}\right)\leq t\leq\min\left\{T_{1,2},T\left(\frac{1}{2}\right)+\beta_{8}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>,</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T\left(\frac{1}{2}\right)\leq t\leq\min\left\{T_{1,2},T\left(\frac{1}{2}\right)+\beta_{8}\right\}</annotation></semantics></math>. For the dynamic of <math id="Thmlemma13.p2.m17" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math>, this implies that for <math id="Thmlemma13.p2.m18" class="ltx_Math" alttext="T\left(\frac{1}{2}\right)\leq t\leq\min\left\{T_{1,2},T\left(\frac{1}{2}\right)+\beta_{8}\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>,</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T\left(\frac{1}{2}\right)\leq t\leq\min\left\{T_{1,2},T\left(\frac{1}{2}\right)+\beta_{8}\right\}</annotation></semantics></math></span></p>
<table id="A1.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex470"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex470.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq\frac{c_{0}^{2}}{42}-\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\geq\frac{c_{0}^{2}}{50}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mn>42</mn></mfrac></mstyle><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mn>50</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq\frac{c_{0}^{2}}{42}-\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\geq\frac{c_{0}^{2}}{50}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p2.6" class="ltx_p"><span id="Thmlemma13.p2.6.1" class="ltx_text">Thus <math id="Thmlemma13.p2.m19" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(t+T\left(\frac{1}{2}\right)\right)\geq\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T\left(\frac{1}{2}\right)\right)+\frac{c_{0}^{2}}{50}\cdot t" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>t</mi><mo>+</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mn>50</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(t+T\left(\frac{1}{2}\right)\right)\geq\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T\left(\frac{1}{2}\right)\right)+\frac{c_{0}^{2}}{50}\cdot t</annotation></semantics></math>, which implies that <math id="Thmlemma13.p2.m20" class="ltx_Math" alttext="T_{1,2}\leq T\left(\frac{1}{2}\right)+\frac{20}{c_{0}^{2}}\leq T\left(\frac{1}{2}\right)+\beta_{8}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow></msub><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mn>20</mn><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mrow><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">T_{1,2}\leq T\left(\frac{1}{2}\right)+\frac{20}{c_{0}^{2}}\leq T\left(\frac{1}{2}\right)+\beta_{8}</annotation></semantics></math> for some <math id="Thmlemma13.p2.m21" class="ltx_Math" alttext="\beta_{8}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>8</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{8}\geq 0</annotation></semantics></math>. Next, for the dynamic of <math id="Thmlemma13.p2.m22" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math>, we have that</span></p>
<table id="A1.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex471"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex471.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex471.m2" class="ltx_Math" alttext="\displaystyle\geq 6\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{3}\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq 6\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{3}\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex472"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex472.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{3}{4}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{2}\right)\left(c_{1}^{2}-\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{3}{4}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{2}\right)\left(c_{1}^{2}-\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)-\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
