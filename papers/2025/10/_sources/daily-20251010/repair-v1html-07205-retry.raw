><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}=-\frac{1}{a_{i}}\cdot\begin{cases}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\begin{aligned} &amp;-\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\gamma_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(1)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j\in[m^{\star}]\setminus\mathcal{C}_{\ell}\\
\begin{aligned} &amp;\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{2})\right)\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(1)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j=j_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
