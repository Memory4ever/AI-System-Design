">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\left|\gamma_{i,j}^{(2)}(0)\right|^{-1}-\frac{b_{i_{\ell}^{\star}}^{2}}{b_{i}^{2}}\left(c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)\left(c_{0}^{2}\left(1-\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}\sqrt{d}}\right)\right)^{-1}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}\right)^{-1}</annotation></semantics></math></td>
