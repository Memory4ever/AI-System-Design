<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex408.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex409"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex409.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p12.10" class="ltx_p"><span id="A1.SS5.p12.10.1" class="ltx_text">Therefore, we have that</span></p>
<table id="A1.Ex410" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex410.m1" class="ltx_Math" alttext="\frac{d}{dt}\left|I_{i,j}^{(1)}(t)\right|\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\left|I_{i,j}^{(1)}(t)\right|\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p12.11" class="ltx_p"><span id="A1.SS5.p12.11.1" class="ltx_text">For <math id="A1.SS5.p12.m16" class="ltx_Math" alttext="I_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I_{i,j}^{(2)}(t)</annotation></semantics></math>, we have that</span></p>
<table id="A1.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex411"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex411.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\left|I_{i,j}^{(2)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\left|I_{i,j}^{(2)}(t)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex411.m2" class="ltx_Math" alttext="\displaystyle=-\text{sign}\left(I_{i,j}^{(2)}(t)\right)\left(\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}+\frac{1}{b_{j}}\nabla_{{\mathbf{w}}_{j}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>b</mi><mi>j</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐰</mi><mi>j</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\text{sign}\left(I_{i,j}^{(2)}(t)\right)\left(\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}+\frac{1}{b_{j}}\nabla_{{\mathbf{w}}_{j}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex412"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex412.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{9}{b_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\right|\left(\left|\gamma_{i,j_{\ell}^{\star}}^{(2)}(t)\right|+\left|\gamma_{j,j_{\ell}^{\star}}^{(2)}(t)\right|\right)-\frac{9}{b_{i}^{2}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\left|I_{i,j}^{(2)}(t)\right|\mathbb{I}\left\{i=i_{\ell}^{\star}\vee j=i_{\ell}^{\star}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo fence="false" rspace="0.167em">|</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mo>(</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>γ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mo>)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>∨</mo><mi>j</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{9}{b_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\right|\left(\left|\gamma_{i,j_{\ell}^{\star}}^{(2)}(t)\right|+\left|\gamma_{j,j_{\ell}^{\star}}^{(2)}(t)\right|\right)-\frac{9}{b_{i}^{2}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\left|I_{i,j}^{(2)}(t)\right|\mathbb{I}\left\{i=i_{\ell}^{\star}\vee j=i_{\ell}^{\star}\right\}</annotation></semantics></math></td>
