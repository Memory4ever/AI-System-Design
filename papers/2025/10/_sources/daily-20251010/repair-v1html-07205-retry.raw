<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex190.m1" class="ltx_Math" alttext="\displaystyle\lambda_{i,j,1}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{i,j,1}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex190.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}\pm\mathcal{O}\left(\delta_{r}^{3}\right)&amp;\text{ if }i\neq j\\
6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{2}\right)&amp;\text{ if }i=j\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≠</mo><mi>j</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>p</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mi>j</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\pm\mathcal{O}\left(\delta_{r}^{3}\right)&amp;\text{ if }i\neq j\\
6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{2}\right)&amp;\text{ if }i=j\end{cases}</annotation></semantics></math></td>
