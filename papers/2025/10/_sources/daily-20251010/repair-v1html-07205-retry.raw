<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E10X.m3" class="ltx_Math" alttext="\displaystyle=\frac{{\mathbf{I}}-\bar{{\mathbf{v}}}_{i}\bar{{\mathbf{v}}}_{i}^{\top}}{\left\|{\mathbf{v}}_{i}\right\|_{2}}\left(\sum_{r=1}^{m}\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\mathcal{C}_{k,\ell,3,3}^{i,r}\bar{{\mathbf{v}}}_{r}-\sum_{r=1}^{m^{\star}}\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\hat{\mathcal{C}}_{k,\ell,3,3}^{i,r}\bar{{\mathbf{v}}}_{r}^{\star}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><msub><mrow><mo>‖</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mn>3</mn><mo>,</mo><mn>3</mn></mrow><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>r</mi></msub></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mn>3</mn><mo>,</mo><mn>3</mn></mrow><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>r</mi><mo>⋆</mo></msubsup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{{\mathbf{I}}-\bar{{\mathbf{v}}}_{i}\bar{{\mathbf{v}}}_{i}^{\top}}{\left\|{\mathbf{v}}_{i}\right\|_{2}}\left(\sum_{r=1}^{m}\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\mathcal{C}_{k,\ell,3,3}^{i,r}\bar{{\mathbf{v}}}_{r}-\sum_{r=1}^{m^{\star}}\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\hat{\mathcal{C}}_{k,\ell,3,3}^{i,r}\bar{{\mathbf{v}}}_{r}^{\star}\right)</annotation></semantics></math></td>
