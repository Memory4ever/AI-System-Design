<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex368.m1" class="ltx_Math" alttext="\displaystyle\leq 2\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left|\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\left(\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><msup><mrow><mo>(</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left|\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\left(\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right)^{2}</annotation></semantics></math></td>
