</table>
<p id="Thmlemma6.p1.2" class="ltx_p"><span id="Thmlemma6.p1.2.1" class="ltx_text ltx_font_italic">Here <math id="Thmlemma6.p1.m6" class="ltx_Math" alttext="C_{S,2}=\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}+c_{k}c_{k+2}}{k!}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>S</mi><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mfrac><mrow><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">C_{S,2}=\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}+c_{k}c_{k+2}}{k!}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p3" class="ltx_para ltx_noindent">
<p id="A1.SS4.p3.1" class="ltx_p"><span id="A1.SS4.p3.1.1" class="ltx_text">We are going to use Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p3.m1" class="ltx_Math" alttext="{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}(t)</annotation></semantics></math> and <math id="A1.SS4.p3.m2" class="ltx_Math" alttext="{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{i}(t),{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{j}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐰</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐰</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{i}(t),{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{j}(t)</annotation></semantics></math>. In this case, we have that <math id="A1.SS4.p3.m3" class="ltx_Math" alttext="{\mathbf{v}}_{1}^{\top}{\mathbf{v}}_{2}=I_{i,j}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}^{\top}{\mathbf{v}}_{2}=I_{i,j}^{(1)}(t)</annotation></semantics></math>, <math id="A1.SS4.p3.m4" class="ltx_Math" alttext="{\mathbf{w}}_{1}^{\top}{\mathbf{w}}_{2}=I_{i,j}^{(2}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐰</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo fence="true" lspace="0em">CLOSE</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{1}^{\top}{\mathbf{w}}_{2}=I_{i,j}^{(2}(t)</annotation></semantics></math>, and <math id="A1.SS4.p3.m5" class="ltx_Math" alttext="{\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{2}=I_{i,j}^{(3)}(t),{\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{1}=I_{j,i}^{(3)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{2}=I_{i,j}^{(3)}(t),{\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{1}=I_{j,i}^{(3)}(t)</annotation></semantics></math>. Now, for <math id="A1.SS4.p3.m6" class="ltx_Math" alttext="\lambda_{i,j,1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,1}</annotation></semantics></math>, by definition, we have that</span></p>
<table id="A1.Ex195" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex195.m1" class="ltx_Math" alttext="\lambda_{i,j,1}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,1}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.2" class="ltx_p"><span id="A1.SS4.p3.2.1" class="ltx_text">Invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p3.m7" class="ltx_Math" alttext="h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell+1}</annotation></semantics></math> gives</span></p>
<table id="A1.Ex196" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex196.m1" class="ltx_Math" alttext="\lambda_{i,j,1}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{3}\pm\mathcal{O}\left(\delta_{r}\right)I_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{4}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>δ</mi><mi>r</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>4</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,1}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{3}\pm\mathcal{O}\left(\delta_{r}\right)I_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{4}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.3" class="ltx_p"><span id="A1.SS4.p3.3.1" class="ltx_text">Since <math id="A1.SS4.p3.m8" class="ltx_Math" alttext="\left|I_{i,j}^{(2)}\right|\leq\delta_{r}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">\left|I_{i,j}^{(2)}\right|\leq\delta_{r}</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex197" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex197.m1" class="ltx_Math" alttext="\lambda_{i,j,1}(t)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,1}(t)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.4" class="ltx_p"><span id="A1.SS4.p3.4.1" class="ltx_text">In the special case where <math id="A1.SS4.p3.m9" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>, we have that <math id="A1.SS4.p3.m10" class="ltx_Math" alttext="I_{i,j}^{(1)}=I_{i,j}^{(2)}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">I_{i,j}^{(1)}=I_{i,j}^{(2)}=1</annotation></semantics></math>, and <math id="A1.SS4.p3.m11" class="ltx_Math" alttext="{\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{1}={\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{2}={\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{1}={\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{2}=I_{i,i}^{(3)}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{1}={\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{2}={\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{1}={\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{2}=I_{i,i}^{(3)}</annotation></semantics></math>. Therefore</span></p>
<table id="A1.Ex198" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex198.m1" class="ltx_Math" alttext="\lambda_{i,j,1}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{2}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>p</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,1}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.5" class="ltx_p"><span id="A1.SS4.p3.5.1" class="ltx_text">For <math id="A1.SS4.p3.m12" class="ltx_Math" alttext="\lambda_{i,j,5}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,5}</annotation></semantics></math>, by definition, we have that</span></p>
<table id="A1.Ex199" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex199.m1" class="ltx_Math" alttext="\lambda_{i,j,5}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,5}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.6" class="ltx_p"><span id="A1.SS4.p3.6.1" class="ltx_text">Invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p3.m13" class="ltx_Math" alttext="h_{k}=c_{k},h_{\ell}^{\prime}=c_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k},h_{\ell}^{\prime}=c_{k}</annotation></semantics></math> gives</span></p>
<table id="A1.Ex200" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex200.m1" class="ltx_Math" alttext="\lambda_{i,j,5}(t)=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{2}\right)=\pm\mathcal{O}\left(\delta_{r}^{2}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,5}(t)=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{2}\right)=\pm\mathcal{O}\left(\delta_{r}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.7" class="ltx_p"><span id="A1.SS4.p3.7.1" class="ltx_text">In the case where <math id="A1.SS4.p3.m14" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex201" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex201.m1" class="ltx_Math" alttext="\lambda_{i,j,5}(t)=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{2}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>p</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,5}(t)=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.8" class="ltx_p"><span id="A1.SS4.p3.8.1" class="ltx_text">For <math id="A1.SS4.p3.m15" class="ltx_Math" alttext="\lambda_{i,j,2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,2}</annotation></semantics></math>, by definition, we have that</span></p>
<table id="A1.Ex202" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex202.m1" class="ltx_Math" alttext="\lambda_{i,j,2}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,2}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
