<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex354.m1" class="ltx_Math" alttext="\displaystyle\leq 1+\frac{1}{2}\delta_{s}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1+\frac{1}{2}\delta_{s}</annotation></semantics></math></td>
