<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex374.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{5}{4}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>5</mn><mn>4</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{5}{4}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p9.5" class="ltx_p"><span id="A1.SS5.p9.5.1" class="ltx_text">where the last inequality follows from Lemma <a href="#Thmlemma8" title="Lemma 8. ‣ A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. This gives that</span></p>
