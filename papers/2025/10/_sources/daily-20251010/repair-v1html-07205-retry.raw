<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex367.m2" class="ltx_Math" alttext="\displaystyle=\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)+I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>|</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)+I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|</annotation></semantics></math></td>
