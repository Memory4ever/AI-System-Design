<tbody id="A1.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad+\frac{18\left({\mathbf{I}}-\bar{{\mathbf{w}}}_{i}\bar{{\mathbf{w}}}_{i}^{\top}\right)}{\left\|{\mathbf{w}}_{i}\right\|_{2}}\sum_{j=1}^{m^{\star}}\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right.}{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\boldsymbol{\left.\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right]}\bar{{\mathbf{w}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>18</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><msub><mrow><mo>‖</mo><msub><mi>𝐰</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mstyle displaystyle="true"><mu