</table>
<p id="A1.SS3.p1.11" class="ltx_p">This gives that</p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex118.m1" class="ltx_Math" alttext="\displaystyle\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right.}{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right]}^{\top}{\mathbf{v}}_{i}=\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right.}{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right]}^{\top}{\mathbf{v}}_{i}=0" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝐯</mi><mi>i</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝜽</mi><mo>,</mo><mi>𝐱</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝜽</mi><mo>⋆</mo></msup><mo>,</mo><mi>𝐱</mi><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝐯</mi><mi>i</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mi>𝜽</mi><mo>,</mo><mi>𝐱</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right.}{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right]}^{\top}{\mathbf{v}}_{i}=\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right.}{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{v}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right]}^{\top}{\mathbf{v}}_{i}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex119.m1" class="ltx_Math" alttext="\displaystyle\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right.}{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right]}^{\top}{\mathbf{w}}_{i}=\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right.}{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right]}^{\top}{\mathbf{w}}_{i}=0" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝐰</mi><mi>i</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝜽</mi><mo>,</mo><mi>𝐱</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>𝜽</mi><mo>⋆</mo></msup><mo>,</mo><mi>𝐱</mi><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>𝐰</mi><mi>i</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mi>𝜽</mi><mo>,</mo><mi>𝐱</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right.}{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)f\left(\bm{\theta}^{\star},{\mathbf{x}}\right)}\right]}^{\top}{\mathbf{w}}_{i}=\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right.}{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\boldsymbol{\left.\vphantom{\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}}\right]}^{\top}{\mathbf{w}}_{i}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.12" class="ltx_p">According to the gradient flow dynamics, we can conclude that</p>
<table id="A1.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex120.m1" class="ltx_Math" alttext="\frac{d}{dt}\left\|{\mathbf{v}}_{i}(t)\right\|_{2}^{2}=\frac{d}{dt}\left\|{\mathbf{w}}_{i}(t)\right\|_{2}^{2}=0" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>𝐯</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>𝐰</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\left\|{\mathbf{v}}_{i}(t)\right\|_{2}^{2}=\frac{d}{dt}\left\|{\mathbf{w}}_{i}(t)\right\|_{2}^{2}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.13" class="ltx_p">which implies that the norm of each <math id="A1.SS3.p1.m6" class="ltx_Math" alttext="{\mathbf{v}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbf{v}}_{i}</annotation></semantics></math> and <math id="A1.SS3.p1.m7" class="ltx_Math" alttext="{\mathbf{w}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbf{w}}_{i}</annotation></semantics></math> are fixed at initialization. For the convenience of the analysis, we shall denote</p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex121.m1" class="ltx_Math" alttext="\displaystyle\mathcal{C}_{k,\ell,a,b}^{i,j}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle\mathcal{C}_{k,\ell,a,b}^{i,j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex121.m2" class="ltx_Math" alttext="\displaystyle=\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{a}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{b}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)}\right.}{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{a}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{b}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)}\boldsymbol{\left.\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{a}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{b}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)}\right]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>b</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{a}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{b}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)}\right.}{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{a}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{b}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)}\boldsymbol{\left.\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{a}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{b}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
