<p id="A1.SS3.p1.17" class="ltx_p">This allows us to rewrite the gradient as</p>
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex128.m1" class="ltx_Math" alttext="\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>𝜽</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex128.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{a_{i}}\left({\mathbf{I}}-\bar{{\mathbf{v}}}_{i}\bar{{\mathbf{v}}}_{i}^{\top}\right)\left(\sum_{r=1}^{m}\left(\lambda_{i,r,1}\bar{{\mathbf{v}}}_{r}+3\lambda_{i,r,2}\bar{{\mathbf{w}}}_{i}+3\lambda_{i,r,4}\bar{{\mathbf{w}}}_{r}\right)-\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,1}\bar{{\mathbf{v}}}_{r}^{\star}+3\hat{\lambda}_{i,r,2}\bar{{\mathbf{w}}}_{i}+3\hat{\lambda}_{i,r,4}\bar{{\mathbf{w}}}_{r}^{\star}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>r</mi></msub></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>r</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>r</mi><mo>⋆</mo></msubsup></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>r</mi><mo>⋆</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{a_{i}}\left({\mathbf{I}}-\bar{{\mathbf{v}}}_{i}\bar{{\mathbf{v}}}_{i}^{\top}\right)\left(\sum_{r=1}^{m}\left(\lambda_{i,r,1}\bar{{\mathbf{v}}}_{r}+3\lambda_{i,r,2}\bar{{\mathbf{w}}}_{i}+3\lambda_{i,r,4}\bar{{\mathbf{w}}}_{r}\right)-\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,1}\bar{{\mathbf{v}}}_{r}^{\star}+3\hat{\lambda}_{i,r,2}\bar{{\mathbf{w}}}_{i}+3\hat{\lambda}_{i,r,4}\bar{{\mathbf{w}}}_{r}^{\star}\right)\right)</annotation></semantics></math></td>
