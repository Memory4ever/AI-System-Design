<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex404.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p12.8" class="ltx_p"><span id="A1.SS5.p12.8.1" class="ltx_text">Since <math id="A1.SS5.p12.m15" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, for the first term we have that</span></p>
