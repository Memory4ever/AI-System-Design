</table>
<p id="A1.SS5.p7.6" class="ltx_p"><span id="A1.SS5.p7.6.1" class="ltx_text">where the second inequality is due to <math id="A1.SS5.p7.m14" class="ltx_Math" alttext="d\geq\beta_{5}m^{16}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mrow><msub><mi>β</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>16</mn></msup></mrow></mrow><annotation encoding="application/x-tex">d\geq\beta_{5}m^{16}</annotation></semantics></math> and the last inequality due to <math id="A1.SS5.p7.m15" class="ltx_Math" alttext="\beta_{2}\leq o(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>≤</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{2}\leq o(1)</annotation></semantics></math>. Therefore</span></p>
<table id="A1.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex355"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex355.m1" class="ltx_Math" alttext="\displaystyle\left|\gamma_{i,j}^{(2)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\gamma_{i,j}^{(2)}(t)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex355.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{b_{i_{\ell}^{\star}}}{b_{i}}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)\cdot\frac{2}{\delta_{s}}\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msub><mi>δ</mi><mi>s</mi></msub></mfrac></mstyle></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{b_{i_{\ell}^{\star}}}{b_{i}}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)\cdot\frac{2}{\delta_{s}}\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p7.7" class="ltx_p"><span id="A1.SS5.p7.7.1" class="ltx_text">Let <math id="A1.SS5.p7.m16" class="ltx_Math" alttext="T_{1}=T\left(\frac{m^{\frac{3}{2}}}{d^{\frac{1}{4}}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><msup><mi>d</mi><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{1}=T\left(\frac{m^{\frac{3}{2}}}{d^{\frac{1}{4}}}\right)</annotation></semantics></math>. Then for <math id="A1.SS5.p7.m17" class="ltx_Math" alttext="t\geq T_{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t\geq T_{1}</annotation></semantics></math>, the dynamic of <math id="A1.SS5.p7.m18" class="ltx_Math" alttext="\gamma_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i,j}^{(2)}(t)</annotation></semantics></math> is upper bounded by</span></p>
<table id="A1.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex356"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex356.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\hat{\gamma}_{i,j}^{(2)}(t)\leq\frac{18}{b_{i}^{2}}\left(c_{0}^{2}+\mathcal{O}\left(\frac{m^{2}}{\sqrt{d}}\right)\right)\left|\gamma_{i,j}^{(2)}(t)\right|^{2}+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>18</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\hat{\gamma}_{i,j}^{(2)}(t)\leq\frac{18}{b_{i}^{2}}\left(c_{0}^{2}+\mathcal{O}\left(\frac{m^{2}}{\sqrt{d}}\right)\right)\left|\gamma_{i,j}^{(2)}(t)\right|^{2}+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p7.8" class="ltx_p"><span id="A1.SS5.p7.8.1" class="ltx_text">Let <math id="A1.SS5.p7.m19" class="ltx_Math" alttext="T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">T_{2}</annotation></semantics></math> be the smallest <math id="A1.SS5.p7.m20" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math> such that <math id="A1.SS5.p7.m21" class="ltx_Math" alttext="\hat{\gamma}_{i,j}^{(2)}(t)\geq 2\hat{\gamma}_{i,j}^{(2)}(T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\gamma}_{i,j}^{(2)}(t)\geq 2\hat{\gamma}_{i,j}^{(2)}(T_{1})</annotation></semantics></math>. Then for all <math id="A1.SS5.p7.m22" class="ltx_Math" alttext="t\leq T_{2}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">t\leq T_{2}</annotation></semantics></math>, we have <math id="A1.SS5.p7.m23" class="ltx_Math" alttext="\frac{d}{dt}\hat{\gamma}_{i,j}^{(2)}(t)\leq\mathcal{O}\left(\frac{m^{4}}{d}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>4</mn></msup><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\hat{\gamma}_{i,j}^{(2)}(t)\leq\mathcal{O}\left(\frac{m^{4}}{d}\right)</annotation></semantics></math>. Therefore</span></p>
<table id="A1.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex357"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex357.m1" class="ltx_Math" alttext="\displaystyle\hat{\gamma}_{i,j}^{(2)}(t+T_{1})\leq\hat{\gamma}_{i,j}^{(2)}(T_{1})+t\cdot\max_{t\leq T_{2}}\frac{d}{dt}\hat{\gamma}_{i,j}^{(2)}(t)\leq\hat{\gamma}_{i,j}^{(2)}(T_{1})+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)t" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>t</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>max</mi><mrow><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mn>2</mn></msub></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mover accent="true"><mi>γ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\gamma}_{i,j}^{(2)}(t+T_{1})\leq\hat{\gamma}_{i,j}^{(2)}(T_{1})+t\cdot\max_{t\leq T_{2}}\frac{d}{dt}\hat{\gamma}_{i,j}^{(2)}(t)\leq\hat{\gamma}_{i,j}^{(2)}(T_{1})+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p7.9" class="ltx_p"><span id="A1.SS5.p7.9.1" class="ltx_text">Thus, we must have that <math id="A1.SS5.p7.m24" class="ltx_Math" alttext="T_{2}\geq\mathcal{O}\left(\frac{\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}\right)+T_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>≥</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><msup><mi>m</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><msub><mi>T</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">T_{2}\geq\mathcal{O}\left(\frac{\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}\right)+T_{1}</annotation></semantics></math>. Therefore, we can conclude that there exists some constant <math id="A1.SS5.p7.m25" class="ltx_Math" alttext="\beta_{7}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>7</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{7}&gt;0</annotation></semantics></math> such that for all <math id="A1.SS5.p7.m26" class="ltx_Math" alttext="t\leq T\left(\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mi>β</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><msup><mi>m</mi><mn>2</mn></msup></mfrac></mrow></mrow><annotation encoding="application/x-tex">t\leq T\left(\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}</annotation></semantics></math> and <math id="A1.SS5.p7.m27" class="ltx_Math" alttext="t\leq T_{c}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">t\leq T_{c}</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex358" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex358.m1" class="ltx_Math" alttext="\left|\gamma_{i,j}^{(2)}(t)\right|\leq O\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\gamma_{i,j}^{(2)}(t)\right|\leq O\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p7.10" class="ltx_p"><span id="A1.SS5.p7.10.1" class="ltx_text">for all <math id="A1.SS5.p7.m28" class="ltx_Math" alttext="(i,j)\neq(i_{\ell}^{\star},j_{\ell}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(i,j)\neq(i_{\ell}^{\star},j_{\ell}^{\star})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A1.SS5.p8" class="ltx_para ltx_noindent">
<p id="A1.SS5.p8.1" class="ltx_p"><span id="A1.SS5.p8.1.1" class="ltx_text ltx_font_bold">Upper bounding <math id="A1.SS5.p8.m1" class="ltx_Math" alttext="\gamma_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i,j}^{(2)}(t)</annotation></semantics></math> for <math id="A1.SS5.p8.m2" class="ltx_Math" alttext="i\in[m]\setminus\mathcal{R}_{\ell-1},j\in\mathcal{C}_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">i\in[m]\setminus\mathcal{R}_{\ell-1},j\in\mathcal{C}_{\ell-1}</annotation></semantics></math>.</span> In this section, we show that the alignment of <math id="A1.SS5.p8.m3" class="ltx_Math" alttext="\bar{{\mathbf{w}}}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\bar{{\mathbf{w}}}_{i}</annotation></semantics></math> with previously recovered components <math id="A1.SS5.p8.m4" class="ltx_Math" alttext="\bar{{\mathbf{w}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\bar{{\mathbf{w}}}_{j}^{\star}</annotation></semantics></math> must be small.</p>
</div>
<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para ltx_noindent">
<p id="Thmlemma10.p1.1" class="ltx_p"><span id="Thmlemma10.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the inductive hypothesis in Condition <a href="#Thmcond2" title="Condition 2 (Inductive Hypothesis). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and the initialization condition in Condition <a href="#Thmcond1" title="Condition 1 (Initialization). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Let <math id="Thmlemma10.p1.m1" class="ltx_Math" alttext="T_{c}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>c</mi></msub><annotation encoding="application/x-tex">T_{c}</annotation></semantics></math> be defined in (<a href="#A1.E14" title="In A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and <math id="Thmlemma10.p1.m2" class="ltx_Math" alttext="T_{\ell}(\xi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{\ell}(\xi)</annotation></semantics></math> in Definition <a href="#Thmdefin2" title="Definition 2 (Recovery Time). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Then we have that for all <math id="Thmlemma10.p1.m3" class="ltx_Math" alttext="t\leq\min\left\{T_{c},T_{\ell}\left(\xi\right)+\mathcal{O}\left(\frac{\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}\right),\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}{m^{5}}\right)\right\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>,</mo><mrow><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><msup><mi>m</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>4</mn></mfrac></msup></mrow><msup><mi>m</mi><mn>5</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\leq\min\left\{T_{c},T_{\ell}\left(\xi\right)+\mathcal{O}\left(\frac{\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}\right),\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}{m^{5}}\right)\right\}</annotation></semantics></math> for any <math id="Thmlemma10.p1.m4" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> such that <math id="Thmlemma10.p1.m5" class="ltx_Math" alttext="(1-\xi)^{-1}\leq\mathcal{O}\left(1\right)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\xi)^{-1}\leq\mathcal{O}\left(1\right)</annotation></semantics></math>, it holds that</span></p>
<table id="A1.Ex359" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex359.m1" class="ltx_Math" alttext="\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right);\;\forall i\in[m]\setminus\mathcal{R}_{\ell-1},\ell^{\prime}&lt;\ell" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>,</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>&lt;</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><annotation encoding="application/x-tex">\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right);\;\forall i\in[m]\setminus\mathcal{R}_{\ell-1},\ell^{\prime}&lt;\ell</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.p9" class="ltx_para ltx_noindent">
<p id="A1.SS5.p9.1" class="ltx_p"><span id="A1.SS5.p9.1.1" class="ltx_text">By the inductive hypothesis, we have that <math id="A1.SS5.p9.m1" class="ltx_Math" alttext="\gamma^{(2)}_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}(t)\geq 1-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma^{(2)}_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}(t)\geq 1-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)</annotation></semantics></math>.
Fix any <math id="A1.SS5.p9.m2" class="ltx_Math" alttext="i\in[m]\setminus\mathcal{R}_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">i\in[m]\setminus\mathcal{R}_{\ell-1}</annotation></semantics></math>. By Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we have that</span></p>
<table id="A1.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex360"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex360.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\gamma_{i,j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\gamma_{i,j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex360.m2" class="ltx_Math" alttext="\displaystyle=-\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j_{\ell^{\prime}}^{\star}}^{\star}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j_{\ell^{\prime}}^{\star}}^{\star}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex361"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex361.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{9}{b_{i}^{2}}\left(\hat{\lambda}_{i,j_{\ell^{\prime}}^{\star},5}(t)-\lambda_{i,i_{\ell^{\prime}}^{\star},5}(t)\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right)-\frac{9}{b_{i}^{2}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mrow><mo>(</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{9}{b_{i}^{2}}\left(\hat{\lambda}_{i,j_{\ell^{\prime}}^{\star},5}(t)-\lambda_{i,i_{\ell^{\prime}}^{\star},5}(t)\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right)-\frac{9}{b_{i}^{2}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex362"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex362.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p9.2" class="ltx_p"><span id="A1.SS5.p9.2.1" class="ltx_text">Due to the same reasoning as in the previous lemma, we have that <math id="A1.SS5.p9.m3" class="ltx_Math" alttext="\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0</annotation></semantics></math>. Therefore, for all <math id="A1.SS5.p9.m4" class="ltx_Math" alttext="t\leq T_{c}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">t\leq T_{c}</annotation></semantics></math>, we have that</span></p>
