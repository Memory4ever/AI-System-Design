<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex351.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{b_{i_{\ell}^{\star}}}{b_{i}}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)\left(1+\delta_{s}-\frac{b_{i_{\ell}^{\star}}^{3}}{b_{i}^{3}}\cdot\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mn>3</mn></msubsup><msubsup><mi>b</mi><mi>i</mi><mn>3</mn></msubsup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>m</mi><mn>4</mn></msup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msub><mi>δ</mi><msup><mi>ℙ</mi><mn>2</mn></msup></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{b_{i_{\ell}^{\star}}}{b_{i}}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)\left(1+\delta_{s}-\frac{b_{i_{\ell}^{\star}}^{3}}{b_{i}^{3}}\cdot\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p7.5" class="ltx_p"><span id="A1.SS5.p7.5.1" class="ltx_text">By the initialization property, we have that <math id="A1.SS5.p7.m12" class="ltx_Math" alttext="b_{i},b_{i_{\ell}^{\star}}\in[1-\beta_{2}\delta_{s},1+\beta_{2}\delta_{s}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{i},b_{i_{\ell}^{\star}}\in[1-\beta_{2}\delta_{s},1+\beta_{2}\delta_{s}]</annotation></semantics></math> for <math id="A1.SS5.p7.m13" class="ltx_Math" alttext="\beta_{2}\leq o(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>≤</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{2}\leq o(1)</annotation></semantics></math>. Therefore, we have that</span></p>
<table id="A1.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex352"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex352.m1" class="ltx_Math" alttext="\displaystyle\frac{b_{i_{\ell}^{\star}}^{3}}{b_{i}^{3}}\cdot\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mn>3</mn></msubsup><msubsup><mi>b</mi><mi>i</mi><mn>3</mn></msubsup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>m</mi><mn>4</mn></msup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msub><mi>δ</mi><msup><mi>ℙ</mi><mn>2</mn></msup></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{b_{i_{\ell}^{\star}}^{3}}{b_{i}^{3}}\cdot\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex352.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{1+\beta_{2}\delta_{s}}{1-\beta_{2}\delta_{s}}\right)^{3}\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>m</mi><mn>4</mn></msup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msub><mi>δ</mi><msup><mi>ℙ</mi><mn>2</mn></msup></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{1+\beta_{2}\delta_{s}}{1-\beta_{2}\delta_{s}}\right)^{3}\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex353"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex353.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{1+\beta_{2}\delta_{s}}{1-\beta_{2}\delta_{s}}\right)^{4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{1+\beta_{2}\delta_{s}}{1-\beta_{2}\delta_{s}}\right)^{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex354"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
