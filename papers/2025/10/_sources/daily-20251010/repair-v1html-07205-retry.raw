<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex291.m1" class="ltx_Math" alttext="\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex291.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{1}{a_{i}}\left(\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\zeta_{j,j_{\ell}^{\star}}^{(2)}(t)+3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)+3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},4}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\right)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><mrow><mo>(</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>3</mn><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>3</mn><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>4</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{1}{a_{i}}\left(\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\zeta_{j,j_{\ell}^{\star}}^{(2)}(t)+3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)+3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},4}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\right)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex292"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex292.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad-\frac{1}{a_{i}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}-\frac{36}{a_{i}}C_{S,2}I_{i,i}^{(3)}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>36</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><msub><mi>C</mi><mrow><mi>S</mi><mo>,</mo><mn>2</mn></mrow></msub><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>±</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mi>m</mi><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad-\frac{1}{a_{i}}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}-\frac{36}{a_{i}}C_{S,2}I_{i,i}^{(3)}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p10.4" class="ltx_p"><span id="A1.SS4.p10.4.1" class="ltx_text">Now, for the case <math id="A1.SS4.p10.m7" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, we can compute that</span></p>
<table id="A1.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
