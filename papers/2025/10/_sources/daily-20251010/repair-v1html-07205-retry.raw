mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>𝐱</mi><msub><mrow><mo>‖</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mfrac></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial}{\partial{\mathbf{w}}_{i}}f\left(\bm{\theta},{\mathbf{x}}\right)^{2}=6\sum_{j=1}^{m}\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell}}{k!\ell!}He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}\right)\left({\mathbf{I}}-\bar{{\mathbf{w}}}_{i}\bar{{\mathbf{w}}}_{i}^{\top}\right)\frac{{\mathbf{x}}}{\left\|\bar{{\mathbf{w}}}_{i}\right\|_{2}}</annotation></semantics></math></td>
