<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex350.m1" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{b_{i}}{b_{i_{\ell}^{\star}}}(1+\delta_{s})\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}-\frac{b_{i_{\ell}^{\star}}^{2}}{b_{i}^{2}}\cdot\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>b</mi><mi>i</mi></msub><msub><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mn>2</mn></msubsup><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>m</mi><mn>4</mn></msup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msub><mi>δ</mi><msup><mi>ℙ</mi><mn>2</mn></msup></msub><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>+</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{b_{i}}{b_{i_{\ell}^{\star}}}(1+\delta_{s})\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}-\frac{b_{i_{\ell}^{\star}}^{2}}{b_{i}^{2}}\cdot\frac{c_{0}^{2}+\mathcal{O}\left(\frac{m^{4}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}{c_{0}^{2}-\mathcal{O}\left(\frac{\delta_{\mathbb{P}^{2}}}{d^{\frac{2}{5}}}+\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex351"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
