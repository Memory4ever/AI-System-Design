<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex369.m1" class="ltx_Math" alttext="\displaystyle\leq 2\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left|\bar{{\mathbf{v}}}_{i}^{\top}\left(\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right)\right|+\left(\bar{{\mathbf{v}}}_{i}^{\top}\left(\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>|</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup><mo>−</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></msub></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><msup><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup><mo>−</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></msub></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left|\bar{{\mathbf{v}}}_{i}^{\top}\left(\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right)\right|+\left(\bar{{\mathbf{v}}}_{i}^{\top}\left(\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex370"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex370.m1" class="ltx_Math" alttext="\displaystyle\leq 2\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left\|\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right\|_{2}+\left\|\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup><mo>−</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>+</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup><mo>−</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></msub></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\cdot\left\|\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right\|_{2}+\left\|\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}-\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex371"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex371.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}\right)\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>4</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}\right)\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p9.4" class="ltx_p"><span id="A1.SS5.p9.4.1" class="ltx_text">Moreover, since <math id="A1.SS5.p9.m7" class="ltx_Math" alttext="\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\geq 1-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\geq 1-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)</annotation></semantics></math>, for <math id="A1.SS5.p9.m8" class="ltx_Math" alttext="T_{p,\ell-1}\leq t\leq T_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>≤</mo><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">T_{p,\ell-1}\leq t\leq T_{c}</annotation></semantics></math>, we must have that</span></p>
<table id="A1.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex372"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex372.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex372.m2" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}\right)\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>4</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}\right)\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)</annotation></semantics></math></td>
