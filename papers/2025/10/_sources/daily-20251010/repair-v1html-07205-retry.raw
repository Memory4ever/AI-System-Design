&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\varepsilon_{\mathcal{A},\ell}^{(2)}(t)+\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j=j_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
