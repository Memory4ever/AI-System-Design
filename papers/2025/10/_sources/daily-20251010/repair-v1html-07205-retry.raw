<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex364.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{9c_{0}^{2}}{b_{i}^{2}}\left|\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)^{2}-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)^{2}\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup></mrow><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{9c_{0}^{2}}{b_{i}^{2}}\left|\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)^{2}-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)^{2}\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)</annotation></semantics></math></td>
