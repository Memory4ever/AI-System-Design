ormal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6\left|I_{i_{\ell}^{\star},i_{\ell}^{\star}}^{(3)}(t)\right|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}\left|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|^{k}</annotation></semantics></math></td>
