<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex389.m2" class="ltx_Math" alttext="\displaystyle\leq 6\left|\zeta_{i,j}^{(1)}(t)\right|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{3}\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\left|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|^{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6\left|\zeta_{i,j}^{(1)}(t)\right|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{3}\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\left|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|^{k}</annotation></semantics></math></td>
