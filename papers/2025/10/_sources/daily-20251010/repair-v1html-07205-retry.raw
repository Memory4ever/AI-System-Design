<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex214.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad-\frac{9}{b_{i}}\cdot\begin{cases}\hat{\lambda}_{i,j,5}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
