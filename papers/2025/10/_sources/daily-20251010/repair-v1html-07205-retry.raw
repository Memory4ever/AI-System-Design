<tbody id="A1.Ex309"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex309.m1" class="ltx_Math" alttext="\displaystyle\sum_{r=1}^{m}\lambda_{i,r,3}(t)I_{j,r}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>j</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{r=1}^{m}\lambda_{i,r,3}(t)I_{j,r}^{(1)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex309.m2" class="ltx_Math" alttext="\displaystyle=\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)\pm\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>±</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)\pm\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p11.5" class="ltx_p"><span id="A1.SS4.p11.5.1" class="ltx_text">Therefore, combining with (<a href="#A1.E12" title="In Proof. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) and (<a href="#A1.E13" title="In Proof. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) gives</span></p>
<table id="A1.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex310"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex310.m1" class="ltx_Math" alttext="\displaystyle\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex310.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{9}{b_{i}}\cdot\begin{cases}\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\left(\zeta_{j,j_{\ell}^{\star}}^{(1)}(t)-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)I_{i,j}^{(3)}(t)\right)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star}\\
\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{9}{b_{i}}\cdot\begin{cases}\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\left(\zeta_{j,j_{\ell}^{\star}}^{(1)}(t)-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)I_{i,j}^{(3)}(t)\right)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star}\\
\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p11.6" class="ltx_p"><span id="A1.SS4.p11.6.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Establishing the Inductive Hypothesis: Phase 1</h3>

<div id="A1.SS5.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.p1.1" class="ltx_p">Starting from this section, we assume that for a fixed <math id="A1.SS5.p1.m1" class="ltx_Math" alttext="\ell\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\ell\in[m^{\star}]</annotation></semantics></math>, the inductive hypothesis holds. That is, the condition of Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> holds. Then we shall analyze the convergence for that <math id="A1.SS5.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> to prove the inductive hypothesis and establish convergence. Notice that, by the statement of the inductive hypothesis, the case <math id="A1.SS5.p1.m3" class="ltx_Math" alttext="\ell=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell=1</annotation></semantics></math> naturally satisfies it, thus requiring no additional proof. Therefore, we focus on the case of a general fixed <math id="A1.SS5.p1.m4" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, and the proof will be divided into two phase. Phase 1 (this section) show that there exist some <math id="A1.SS5.p1.m5" class="ltx_Math" alttext="T^{\star}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">T^{\star}</annotation></semantics></math> such that <math id="A1.SS5.p1.m6" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}\left(T^{\star}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>T</mi><mo>⋆</mo></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}\left(T^{\star}\right)</annotation></semantics></math> and <math id="A1.SS5.p1.m7" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T^{\star}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>T</mi><mo>⋆</mo></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\left(T^{\star}\right)</annotation></semantics></math> are some constant close to 1, while <math id="A1.SS5.p1.m8" class="ltx_Math" alttext="\varepsilon_{\mathcal{A},\ell}^{(2)}(t),\varepsilon_{\mathcal{B},\ell}^{(3)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{A},\ell}^{(2)}(t),\varepsilon_{\mathcal{B},\ell}^{(3)}(t)</annotation></semantics></math>, and <math id="A1.SS5.p1.m9" class="ltx_Math" alttext="\varepsilon_{5,\ell}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{5,\ell}(t)</annotation></semantics></math> are <math id="A1.SS5.p1.m10" class="ltx_Math" alttext="\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math>.</p>
</div>
<div id="A1.SS5.p2" class="ltx_para ltx_noindent">
<p id="A1.SS5.p2.1" class="ltx_p">We denote the following time</p>
<table id="A1.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E14.m1" class="ltx_Math" alttext="\begin{gathered}T_{c}:=\min\left\{t\geq 0:A_{1}(t)\wedge A_{2}(t)\wedge A_{3}(t)\right\}\\
A_{1}(t)=\left\{\min\left\{\varepsilon_{\mathcal{B},\ell}^{(2)}(t),\varepsilon_{3,\ell}(t),\varepsilon_{4,\ell}(t)\right\}&gt;\frac{\beta_{6}m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right\};\quad A_{2}(t)=\left\{\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\geq\beta_{6}m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right\}\\
A_{3}(t)=\left\{\varepsilon_{5,\ell}(t)\geq\beta_{6}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{B},\ell}^{(1)}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\right\}\end{gathered}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>:=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>A</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∧</mo><mrow><msub><mi>A</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∧</mo><mrow><msub><mi>A</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>A</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><mo>{</mo><mi>min</mi><mo>{</mo><mi>ε</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>ε</mi><msub><mrow></mrow><mrow><mn>3</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>ε</mi><msub><mrow></mrow><mrow><mn>4</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>}</mo><mo>&gt;</mo><mfrac><mrow><msub><mi>β</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>}</mo><mo rspace="2.167em">;</mo><mi>A</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><mo>{</mo><mi>ε</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>≥</mo><mi>β</mi><msub><mrow></mrow><mn>6</mn></msub><mi>m</mi><mi>ε</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mn>3</mn></msup><mo>}</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>A</mi><msub><mrow></mrow><mn>3</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><mo>{</mo><mi>ε</mi><msub><mrow></mrow><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>≥</mo><mi>β</mi><msub><mrow></mrow><mn>6</mn></msub><mo>(</mo><mi>m</mi><mi>ε</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mn>3</mn></msup><mo>+</mo><mi>ε</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mi>γ</mi><msub><mrow></mrow><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>)</mo><mo>}</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{gathered}T_{c}:=\min\left\{t\geq 0:A_{1}(t)\wedge A_{2}(t)\wedge A_{3}(t)\right\}\\
A_{1}(t)=\left\{\min\left\{\varepsilon_{\mathcal{B},\ell}^{(2)}(t),\varepsilon_{3,\ell}(t),\varepsilon_{4,\ell}(t)\right\}&gt;\frac{\beta_{6}m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right\};\quad A_{2}(t)=\left\{\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\geq\beta_{6}m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right\}\\
A_{3}(t)=\left\{\varepsilon_{5,\ell}(t)\geq\beta_{6}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{B},\ell}^{(1)}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\right\}\end{gathered}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A1.SS5.p2.2" class="ltx_p">By the initialization property, we have that</p>
<table id="A1.Ex311" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex311.m1" class="ltx_Math" alttext="\varepsilon_{\mathcal{B},\ell}^{(1)}(t),\varepsilon_{3,\ell}(t),\varepsilon_{4,\ell}(t)\leq\frac{\beta_{3}}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}};\quad\varepsilon_{\mathcal{B},\ell}^{(3)}(0)=\varepsilon_{5,\ell}(0)=0" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>ε</mi><mrow><mn>3</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>ε</mi><mrow><mn>4</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><msub><mi>β</mi><mn>3</mn></msub><msqrt><mi>d</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><mo rspace="1.167em">;</mo><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{B},\ell}^{(1)}(t),\varepsilon_{3,\ell}(t),\varepsilon_{4,\ell}(t)\leq\frac{\beta_{3}}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}};\quad\varepsilon_{\mathcal{B},\ell}^{(3)}(0)=\varepsilon_{5,\ell}(0)=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p2.3" class="ltx_p">Therefore, <math id="A1.SS5.p2.m1" class="ltx_Math" alttext="T_{c}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T_{c}&gt;0</annotation></semantics></math>. Moreover, for all <math id="A1.SS5.p2.m2" class="ltx_Math" alttext="t\leq T_{c}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">t\leq T_{c}</annotation></semantics></math>, by the inductive hypothesis, we have that</p>
<table id="A1.Ex312" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex312.m1" class="ltx_Math" alttext="\varepsilon_{\mathcal{B},\ell}^{(1)}(t),\varepsilon_{3,\ell}(t),\varepsilon_{4,\ell}(t)\leq\frac{\beta_{6}m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\;\Rightarrow\varepsilon_{\mathcal{F},\ell}(t)\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>ε</mi><mrow><mn>3</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>ε</mi><mrow><mn>4</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><msub><mi>β</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo lspace="0.558em" stretchy="false">⇒</mo><mrow><msub><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{B},\ell}^{(1)}(t),\varepsilon_{3,\ell}(t),\varepsilon_{4,\ell}(t)\leq\frac{\beta_{6}m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\;\Rightarrow\varepsilon_{\mathcal{F},\ell}(t)\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p2.4" class="ltx_p">which implies that <math id="A1.SS5.p2.m3" class="ltx_Math" alttext="\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math>. Also, by definition we have that <math id="A1.SS5.p2.m4" class="ltx_Math" alttext="\varepsilon_{\mathcal{A},\ell}^{(1)}(t)\leq\varepsilon_{\mathcal{A},\ell}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{A},\ell}^{(1)}(t)\leq\varepsilon_{\mathcal{A},\ell}^{(2)}(t)</annotation></semantics></math>.</p>
</div>
<div id="A1.SS5.p3" class="ltx_para ltx_noindent">
<p id="A1.SS5.p3.1" class="ltx_p"><span id="A1.SS5.p3.1.1" class="ltx_text ltx_font_bold">Growth of <math id="A1.SS5.p3.m1" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math>.</span> We will start with analyzing <math id="A1.SS5.p3.m2" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math>. For any <math id="A1.SS5.p3.m3" class="ltx_Math" alttext="\xi\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\xi\in(0,1)</annotation></semantics></math>, recall the definition of <math id="A1.SS5.p3.m4" class="ltx_Math" alttext="T_{\ell}\left(\xi\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{\ell}\left(\xi\right)</annotation></semantics></math> in Definition <a href="#Thmdefin2" title="Definition 2 (Recovery Time). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
We should notice that, although by definition we have <math id="A1.SS5.p3.m5" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)&gt;0</annotation></semantics></math>, it is not always the case that <math id="A1.SS5.p3.m6" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(0)</annotation></semantics></math> will also be positive. Therefore, we also need to control the "negativeness" of <math id="A1.SS5.p3.m7" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(0)</annotation></semantics></math> when analyzing the growth of <math id="A1.SS5.p3.m8" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math>. To do this, we present the following lemma.</p>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p"><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the inductive hypothesis in Condition <a href="#Thmcond2" title="Condition 2 (Inductive Hypothesis). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and the initialization condition in Condition <a href="#Thmcond1" title="Condition 1 (Initialization). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Let <math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="T_{c}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>c</mi></msub><annotation encoding="application/x-tex">T_{c}</annotation></semantics></math> be defined in (<a href="#A1.E14" title="In A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and <math id="Thmlemma8.p1.m2" class="ltx_Math" alttext="T(\xi)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\xi)</annotation></semantics></math> in Definition <a href="#Thmdefin2" title="Definition 2 (Recovery Time). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. If <math id="Thmlemma8.p1.m3" class="ltx_Math" alttext="T_{c}\geq T_{\ell}\left(\frac{1}{2}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>≥</mo><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{c}\geq T_{\ell}\left(\frac{1}{2}\right)</annotation></semantics></math>, then we have that</span></p>
<table id="A1.EGx69" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.Ex313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex313.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0;\;\lambda_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\geq 0;\;\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\geq-\frac{\beta_{6}}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}};\;\forall t\leq\min\{T_{c},T(\xi)\}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.447em">;</mo><mrow><mrow><msub><mi>λ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.447em">;</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mo>−</mo><mrow><mfrac><msub><mi>β</mi><mn>6</mn></msub><msqrt><mi>d</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>t</mi></mrow><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>c</mi></msub><mo>,</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0;\;\lambda_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\geq 0;\;\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\geq-\frac{\beta_{6}}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}};\;\forall t\leq\min\{T_{c},T(\xi)\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex314"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex314.m1" class="ltx_Math" alttext="\displaystyle\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t+T_{0})\geq\left(\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(T_{0})^{-1}-\frac{18}{b_{i_{\ell}^{\star}}^{2}}\left(c_{0}^{2}\left(1-\xi^{2}\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)t\right)^{-1}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>T</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo>(</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mfrac><mn>18</mn><msubsup><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t+T_{0})\geq\left(\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(T_{0})^{-1}-\frac{18}{b_{i_{\ell}^{\star}}^{2}}\left(c_{0}^{2}\left(1-\xi^{2}\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)t\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex315"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex315.m1" class="ltx_Math" alttext="\displaystyle T_{\ell}\left(\xi\right)\leq\frac{b_{i_{\ell}^{\star}}^{2}}{18}\left(c_{0}^{2}\left(1-\xi\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)^{-1}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><msubsup><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mn>2</mn></msubsup><mn>18</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>ξ</mi></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{\ell}\left(\xi\right)\leq\frac{b_{i_{\ell}^{\star}}^{2}}{18}\left(c_{0}^{2}\left(1-\xi\right)-\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}\sqrt{d}}\right)\right)^{-1}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(0)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma8.p1.2" class="ltx_p"><span id="Thmlemma8.p1.2.1" class="ltx_text ltx_font_italic">for all <math id="Thmlemma8.p1.m4" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> such that <math id="Thmlemma8.p1.m5" class="ltx_Math" alttext="(1-\xi^{2})^{-1}\leq\mathcal{O}(1)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(1-\xi^{2})^{-1}\leq\mathcal{O}(1)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS5.p4" class="ltx_para ltx_noindent">
<p id="A1.SS5.p4.3" class="ltx_p"><span id="A1.SS5.p4.3.1" class="ltx_text">To start, we lower bound the time-derivative of <math id="A1.SS5.p4.m1" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math>. Let <math id="A1.SS5.p4.m2" class="ltx_Math" alttext="T_{c}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mi>c</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">T_{c}^{\prime}</annotation></semantics></math> be defined as</span></p>
<table id="A1.Ex316" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex316.m1" class="ltx_Math" alttext="T_{c}^{\prime}=\min\left\{t\geq 0:\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)&lt;-\frac{\beta_{6}}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right\}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>c</mi><mo>′</mo></msubsup><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>−</mo><mrow><mfrac><msub><mi>β</mi><mn>6</mn></msub><msqrt><mi>d</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{c}^{\prime}=\min\left\{t\geq 0:\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)&lt;-\frac{\beta_{6}}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p4.4" class="ltx_p"><span id="A1.SS5.p4.4.1" class="ltx_text">Since <math id="A1.SS5.p4.m3" class="ltx_Math" alttext="\left({\mathbf{v}}_{i_{\ell}^{\star}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)\leq\frac{\beta_{3}}{d}\log\frac{m}{\delta_{\mathbb{P}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msubsup><mi>𝐯</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><mo>)</mo></mrow><mo>≤</mo><mrow><mfrac><msub><mi>β</mi><mn>3</mn></msub><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\left({\mathbf{v}}_{i_{\ell}^{\star}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)\leq\frac{\beta_{3}}{d}\log\frac{m}{\delta_{\mathbb{P}}}</annotation></semantics></math> and <math id="A1.SS5.p4.m4" class="ltx_Math" alttext="\left\|{\mathbf{v}}_{i_{\ell}^{\star}}\right\|_{2}\geq 1-\beta_{2}\delta_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>𝐯</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|{\mathbf{v}}_{i_{\ell}^{\star}}\right\|_{2}\geq 1-\beta_{2}\delta_{s}</annotation></semantics></math> for some <math id="A1.SS5.p4.m5" class="ltx_Math" alttext="\beta_{3}&gt;0,\beta_{2}\leq o(1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mn>3</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>≤</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{3}&gt;0,\beta_{2}\leq o(1)</annotation></semantics></math> and <math id="A1.SS5.p4.m6" class="ltx_Math" alttext="\delta_{s}\leq\mathcal{O}\left(\frac{1}{m^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>s</mi></msub><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>m</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{s}\leq\mathcal{O}\left(\frac{1}{m^{2}}\right)</annotation></semantics></math>, we have that <math id="A1.SS5.p4.m7" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(0)^{2}\leq\frac{2\beta_{3}}{d}\log\frac{m}{\delta_{\mathbb{P}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mn>3</mn></msub></mrow><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(0)^{2}\leq\frac{2\beta_{3}}{d}\log\frac{m}{\delta_{\mathbb{P}}}</annotation></semantics></math>. For <math id="A1.SS5.p4.m8" class="ltx_Math" alttext="\beta_{6}\geq 4\sqrt{\beta_{3}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>6</mn></msub><mo>≥</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>β</mi><mn>3</mn></msub></msqrt></mrow></mrow><annotation encoding="application/x-tex">\beta_{6}\geq 4\sqrt{\beta_{3}}</annotation></semantics></math>, we must have that <math id="A1.SS5.p4.m9" class="ltx_Math" alttext="T_{c}^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>c</mi><mo>′</mo></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T_{c}^{\prime}&gt;0</annotation></semantics></math>.
By Lemma <a href="#Thmlemma30" title="Lemma 30. ‣ D.2 Other Auxiliary Results ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>, we have that for all <math id="A1.SS5.p4.m10" class="ltx_Math" alttext="t\leq T_{c}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msubsup><mi>T</mi><mi>c</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">t\leq T_{c}^{\prime}</annotation></semantics></math>, it holds that</span></p>
<table id="A1.Ex317" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex317.m1" class="ltx_Math" alttext="\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}\in c_{0}^{2}\pm\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right);\quad\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}\in c_{1}^{2}\pm\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo rspace="1.000em">;</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup></mrow></mrow><mo>∈</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mn>2</mn></msubsup><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mi>m</mi><msub><mi>δ</mi><mi>ℙ</mi></msub></mfrac></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}\in c_{0}^{2}\pm\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right);\quad\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{k}\in c_{1}^{2}\pm\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p4.5" class="ltx_p"><span id="A1.SS5.p4.5.1" class="ltx_text">By Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we have that</span></p>
<table id="A1.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex318.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex318.m2" class="ltx_Math" alttext="\displaystyle=-\frac{1}{b_{i_{\ell}^{\star}}}\nabla_{{\mathbf{w}}_{i_{\ell}}^{\star}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j_{\ell}^{\star}}^{\star}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msubsup><mi>𝐰</mi><msub><mi>i</mi><mi mathvariant="normal">ℓ</mi></msub><mo>⋆</mo></msubsup></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{1}{b_{i_{\ell}^{\star}}}\nabla_{{\mathbf{w}}_{i_{\ell}}^{\star}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j_{\ell}^{\star}}^{\star}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex319"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex319.m1" class="ltx_Math" alttext="\displaystyle=\frac{9}{b_{i_{\ell}^{\star}}^{2}}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>9</mn><msubsup><mi>b</mi><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{9}{b_{i_{\ell}^{\star}}^{2}}\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p4.6" class="ltx_p"><span id="A1.SS5.p4.6.1" class="ltx_text">Therefore, with the form of <math id="A1.SS5.p4.m11" class="ltx_Math" alttext="\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><annotation encoding="application/x-tex">\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}</annotation></semantics></math> from Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, we have that</span></p>
<table id="A1.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
