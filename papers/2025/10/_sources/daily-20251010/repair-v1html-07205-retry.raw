mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)\gamma_{i,j}^{(1)}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
