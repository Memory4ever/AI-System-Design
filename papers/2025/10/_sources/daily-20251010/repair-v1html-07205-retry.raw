hy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mo>,</mo><mrow><mi>j</mi><mo>=</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}=\frac{3}{b_{i}}\cdot\begin{cases}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)\gamma_{i,j}^{(1)}(t)-3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\zeta_{i,j}^{(2)}(t)\\
&amp;\quad\quad\quad-12C_{S,2}\gamma_{i,j}^{(2)}(t)I_{i,i}^{(3)}(t)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\varepsilon_{\mathcal{A},\ell}^{(2)}(t)+\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j\neq j_{\ell}^{\star}\\
\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)+\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)-3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\zeta_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\\
&amp;\quad\quad\quad-12C_{S,2}\gamma_{i,j}^{(2)}(t)I_{i,i}^{(3)}(t)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\varepsilon_{\mathcal{A},\ell}^{(2)}(t)+\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j=j_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
