<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex376.m1" class="ltx_Math" alttext="\displaystyle\leq\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(T_{p,\ell-1})\right|+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}+\frac{m^{7}t}{\delta_{\mathbb{P}}^{3}d^{\frac{5}{4}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mrow><mi>p</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>m</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>5</mn><mn>4</mn></mfrac></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(T_{p,\ell-1})\right|+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}+\frac{m^{7}t}{\delta_{\mathbb{P}}^{3}d^{\frac{5}{4}}}\right)</annotation></semantics></math></td>
