&amp;\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad-\frac{9}{b_{i}}\cdot\begin{cases}\hat{\lambda}_{i,j,5}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\begin{aligned} &amp;\hat{\lambda}_{i,j,5}(t)-\lambda_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\gamma_{i,j}^{(2)}(t)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma7.p1.3" class="ltx_p"><span id="Thmlemma7.p1.3.1" class="ltx_text ltx_font_italic">Further more, the mis-alignment terms <math id="Thmlemma7.p1.m7" class="ltx_Math" alttext="\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{w}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝛉</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{w}}}_{j}^{\star}</annotation></semantics></math> and <math id="Thmlemma7.p1.m8" class="ltx_Math" alttext="\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝛉</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}</annotation></semantics></math> satisfies</span></p>
