<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E18X.m3" class="ltx_Math" alttext="\displaystyle=\left|\bar{{\mathbf{w}}}_{j}(t)^{\top}\bar{{\mathbf{w}}}_{j_{\ell^{\prime}}^{\star}}^{\star}+\bar{{\mathbf{w}}}_{j}(t)^{\top}\left(\bar{{\mathbf{w}}}_{i_{\ell^{\prime}}^{\star}}(t)-\bar{{\mathbf{w}}}_{j_{\ell^{\prime}}^{\star}}^{\star}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\bar{{\mathbf{w}}}_{j}(t)^{\top}\bar{{\mathbf{w}}}_{j_{\ell^{\prime}}^{\star}}^{\star}+\bar{{\mathbf{w}}}_{j}(t)^{\top}\left(\bar{{\mathbf{w}}}_{i_{\ell^{\prime}}^{\star}}(t)-\bar{{\mathbf{w}}}_{j_{\ell^{\prime}}^{\star}}^{\star}\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(18)</span></td></tr>
<tr id="A1.E18Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
