}_{j}^{\star}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right.}{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\boldsymbol{\left.\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right]}\bar{{\mathbf{w}}}_{j}^{\star}</annotation></semantics></math></td>
