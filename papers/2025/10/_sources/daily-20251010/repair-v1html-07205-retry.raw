<tbody id="A1.Ex377"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex377.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}+\frac{m^{7}t}{\delta_{\mathbb{P}}^{3}d^{\frac{5}{4}}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>m</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>5</mn><mn>4</mn></mfrac></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}+\frac{m^{7}t}{\delta_{\mathbb{P}}^{3}d^{\frac{5}{4}}}\right)</annotation></semantics></math></td>
