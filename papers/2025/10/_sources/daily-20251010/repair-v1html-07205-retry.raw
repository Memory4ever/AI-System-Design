=-6\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{3}\left(c_{1}^{2}\pm\mathcal{O}\left(\frac{1}{\sqrt{d}}\left(\log\frac{m}{\delta_{\mathbb{P}}}\right)^{\frac{1}{2}}\right)\right)</annotation></semantics></math></td>
