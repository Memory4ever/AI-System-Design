<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex135.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad+\frac{3}{b_{i}}\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,2}I_{i,i}^{(3)}+\hat{\lambda}_{i,r,3}\zeta_{i,r}^{(2)}+3\hat{\lambda}_{i,r,5}\gamma_{i,r}^{(2)}\right)\bar{{\mathbf{w}}}_{i}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><mo>(</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>3</mn></mrow></msub><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mn>3</mn><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>5</mn></mrow></msub><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\frac{3}{b_{i}}\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,2}I_{i,i}^{(3)}+\hat{\lambda}_{i,r,3}\zeta_{i,r}^{(2)}+3\hat{\lambda}_{i,r,5}\gamma_{i,r}^{(2)}\right)\bar{{\mathbf{w}}}_{i}</annotation></semantics></math></td>
