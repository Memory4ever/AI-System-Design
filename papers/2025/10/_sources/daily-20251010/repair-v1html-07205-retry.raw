<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12Xa.m2" class="ltx_Math" alttext="\displaystyle=\lambda_{i,i,1}\pm\begin{cases}\mathcal{O}\left(\varepsilon_{5,\ell}(t)^{2}+m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}\right)&amp;\text{ if }i=i_{\ell}^{\star}\\
\mathcal{O}\left(\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}+m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="3.278em">=</mo><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>±</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda_{i,i,1}\pm\begin{cases}\mathcal{O}\left(\varepsilon_{5,\ell}(t)^{2}+m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}\right)&amp;\text{ if }i=i_{\ell}^{\star}\\
\mathcal{O}\left(\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}+m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}</annotation></semantics></math></td>
