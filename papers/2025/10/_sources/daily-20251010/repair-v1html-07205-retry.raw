<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex390.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
