</table>
<p id="A1.SS5.p9.6" class="ltx_p"><span id="A1.SS5.p9.6.1" class="ltx_text">where the last step follows from the inductive hypothesis. Further requiring that <math id="A1.SS5.p9.m9" class="ltx_Math" alttext="t\leq\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}{m^{5}}\right)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>4</mn></mfrac></msup></mrow><msup><mi>m</mi><mn>5</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\leq\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}{m^{5}}\right)</annotation></semantics></math> keeps <math id="A1.SS5.p9.m10" class="ltx_Math" alttext="\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t+T_{p,\ell-1})\right|\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>T</mi><mrow><mi>p</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t+T_{p,\ell-1})\right|\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math>. When <math id="A1.SS5.p9.m11" class="ltx_Math" alttext="\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq\xi" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>ξ</mi></mrow><annotation encoding="application/x-tex">\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq\xi</annotation></semantics></math>, we can still obtain that</span></p>
<table id="A1.Ex378" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex378.m1" class="ltx_Math" alttext="\frac{d}{dt}\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{d}{dt}\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right|\leq\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p9.7" class="ltx_p"><span id="A1.SS5.p9.7.1" class="ltx_text">Thus, for all <math id="A1.SS5.p9.m12" class="ltx_Math" alttext="t\leq\min\left\{T_{\ell}\left(\xi\right)+\mathcal{O}\left(\frac{\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}\right),\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}{m^{5}}\right)\right\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mrow><mrow><msub><mi>T</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><msup><mi>m</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>4</mn></mfrac></msup></mrow><msup><mi>m</mi><mn>5</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\leq\min\left\{T_{\ell}\left(\xi\right)+\mathcal{O}\left(\frac{\delta_{\mathbb{P}}\sqrt{d}}{m^{2}}\right),\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d^{\frac{3}{4}}}{m^{5}}\right)\right\}</annotation></semantics></math> we can guarantee that <math id="A1.SS5.p9.m13" class="ltx_Math" alttext="\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t+T_{p,\ell-1})\right|\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>T</mi><mrow><mi>p</mi><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t+T_{p,\ell-1})\right|\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A1.SS5.p10" class="ltx_para ltx_noindent">
<p id="A1.SS5.p10.1" class="ltx_p"><span id="A1.SS5.p10.1.1" class="ltx_text ltx_font_bold">Bounding <math id="A1.SS5.p10.m1" class="ltx_Math" alttext="\varepsilon_{1,\ell}(t),\varepsilon_{2,\ell}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ε</mi><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>ε</mi><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{1,\ell}(t),\varepsilon_{2,\ell}(t)</annotation></semantics></math>, and <math id="A1.SS5.p10.m2" class="ltx_Math" alttext="\varepsilon_{\mathcal{B},\ell}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{B},\ell}^{(1)}(t)</annotation></semantics></math>.</span> Here we are going to upper bound <math id="A1.SS5.p10.m3" class="ltx_Math" alttext="\varepsilon_{1,\ell}(t),\varepsilon_{2,\ell}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ε</mi><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>ε</mi><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{1,\ell}(t),\varepsilon_{2,\ell}(t)</annotation></semantics></math> and <math id="A1.SS5.p10.m4" class="ltx_Math" alttext="\varepsilon_{\mathcal{B},\ell}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{B},\ell}^{(1)}(t)</annotation></semantics></math>. In particular, we are going to analyze <math id="A1.SS5.p10.m5" class="ltx_Math" alttext="\gamma_{i,j}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i,j}^{(1)}(t)</annotation></semantics></math> for <math id="A1.SS5.p10.m6" class="ltx_Math" alttext="i\in[m]\setminus\mathcal{R}_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">i\in[m]\setminus\mathcal{R}_{\ell-1}</annotation></semantics></math> and <math id="A1.SS5.p10.m7" class="ltx_Math" alttext="j\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[m^{\star}]</annotation></semantics></math> where <math id="A1.SS5.p10.m8" class="ltx_Math" alttext="(i,j)\neq i_{\ell}^{\star},j_{\ell}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">(i,j)\neq i_{\ell}^{\star},j_{\ell}^{\star}</annotation></semantics></math>, <math id="A1.SS5.p10.m9" class="ltx_Math" alttext="\zeta_{i,j}^{(1)},\zeta_{i,j}^{(2)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\zeta_{i,j}^{(1)},\zeta_{i,j}^{(2)}</annotation></semantics></math> for <math id="A1.SS5.p10.m10" class="ltx_Math" alttext="i\in[m]\setminus\mathcal{R}_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">i\in[m]\setminus\mathcal{R}_{\ell-1}</annotation></semantics></math> and <math id="A1.SS5.p10.m11" class="ltx_Math" alttext="j\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[m^{\star}]</annotation></semantics></math>, and also <math id="A1.SS5.p10.m12" class="ltx_Math" alttext="I_{i,j}^{(1)},I_{i,j}^{(2)},I_{i,j}^{(3)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">I_{i,j}^{(1)},I_{i,j}^{(2)},I_{i,j}^{(3)}</annotation></semantics></math> for <math id="A1.SS5.p10.m13" class="ltx_Math" alttext="i,j\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[m]</annotation></semantics></math> and <math id="A1.SS5.p10.m14" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>.</p>
</div>
<div id="Thmlemma11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma11.2" class="ltx_text ltx_font_bold">Lemma 11</span></span><span id="Thmlemma11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma11.p1" class="ltx_para">
<p id="Thmlemma11.p1.1" class="ltx_p"><span id="Thmlemma11.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the inductive hypothesis in Condition <a href="#Thmcond2" title="Condition 2 (Inductive Hypothesis). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and the initialization condition in Condition <a href="#Thmcond1" title="Condition 1 (Initialization). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> holds. Let <math id="Thmlemma11.p1.m1" class="ltx_Math" alttext="T_{c}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>c</mi></msub><annotation encoding="application/x-tex">T_{c}</annotation></semantics></math> be defined in (<a href="#A1.E14" title="In A.5 Establishing the Inductive Hypothesis: Phase 1 ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) and <math id="Thmlemma11.p1.m2" class="ltx_Math" alttext="T(\xi)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\xi)</annotation></semantics></math> in Definition <a href="#Thmdefin2" title="Definition 2 (Recovery Time). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Then there exists some constant <math id="Thmlemma11.p1.m3" class="ltx_Math" alttext="\beta_{7}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>7</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{7}&gt;0</annotation></semantics></math> such that for all <math id="Thmlemma11.p1.m4" class="ltx_Math" alttext="\beta_{8}\leq\mathcal{O}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>8</mn></msub><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{8}\leq\mathcal{O}(1)</annotation></semantics></math>, for all <math id="Thmlemma11.p1.m5" class="ltx_Math" alttext="t\leq\min\left\{T_{c},T\left(\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m},T\left(\xi\right)\right\}+\beta_{8}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>T</mi><mi>c</mi></msub><mo>,</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><msup><mi>d</mi><mfrac><mn>2</mn><mn>5</mn></mfrac></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mi>β</mi><mn>7</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mi>m</mi></mfrac></mrow><mo>,</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo>(</mo><mi>ξ</mi><mo>)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>+</mo><msub><mi>β</mi><mn>8</mn></msub></mrow></mrow><annotation encoding="application/x-tex">t\leq\min\left\{T_{c},T\left(\frac{\delta_{\mathbb{P}}^{2}}{d^{\frac{2}{5}}}\right)+\frac{\beta_{7}\delta_{\mathbb{P}}\sqrt{d}}{m},T\left(\xi\right)\right\}+\beta_{8}</annotation></semantics></math>, we have that <math id="Thmlemma11.p1.m6" class="ltx_Math" alttext="\varepsilon_{\mathcal{A},\ell}^{(2)}\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{A},\ell}^{(2)}\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right)</annotation></semantics></math>. Moreover, for all <math id="Thmlemma11.p1.m7" class="ltx_Math" alttext="t\leq\min\left\{\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d}{m^{5}}\right),T_{c}\right\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><msup><mi>m</mi><mn>5</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>,</mo><msub><mi>T</mi><mi>c</mi></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\leq\min\left\{\mathcal{O}\left(\frac{\delta_{\mathbb{P}}^{2}d}{m^{5}}\right),T_{c}\right\}</annotation></semantics></math> we shall have that</span></p>
<table id="A1.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex379"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex379.m1" class="ltx_Math" alttext="\displaystyle\max\left\{\left|\gamma_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(2)}(t)\right|\right\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max\left\{\left|\gamma_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(2)}(t)\right|\right\}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex379.m2" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right);\;\forall i\in[m]\setminus\mathcal{R}_{\ell},j\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right);\;\forall i\in[m]\setminus\mathcal{R}_{\ell},j\in[m^{\star}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex380"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex380.m1" class="ltx_Math" alttext="\displaystyle\max\left\{\left|I_{i,j}^{(1)}(t)\right|,\left|I_{i,j}^{(2)}(t)\right|,\left|I_{i,j}^{(3)}(t)\right|\right\}" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max\left\{\left|I_{i,j}^{(1)}(t)\right|,\left|I_{i,j}^{(2)}(t)\right|,\left|I_{i,j}^{(3)}(t)\right|\right\}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex380.m2" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right);\;\forall i,j\in[m]\setminus\mathcal{R}_{\ell},i\neq j" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>2</mn></msup><mrow><msub><mi>δ</mi><mi>ℙ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\frac{m^{2}}{\delta_{\mathbb{P}}\sqrt{d}}\right);\;\forall i,j\in[m]\setminus\mathcal{R}_{\ell},i\neq j</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
