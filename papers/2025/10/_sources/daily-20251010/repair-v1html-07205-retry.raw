<p id="A1.SS3.p1.16" class="ltx_p">Recall that our goal is to study the dynamics of the following alignment scores</p>
<table id="A1.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E11.m1" class="ltx_Math" alttext="\begin{gathered}\gamma_{i,j}^{(1)}(t)=\bar{{\mathbf{v}}}_{i}(t)^{\top}\bar{{\mathbf{v}}}_{j}^{\star};\quad\gamma_{i,j}^{(2)}(t)=\bar{{\mathbf{w}}}_{i}(t)^{\top}\bar{{\mathbf{w}}}_{j}^{\star};\quad\zeta_{i,j}^{(1)}(t)=\bar{{\mathbf{v}}}_{i}(t)^{\top}\bar{{\mathbf{w}}}_{j}^{\star};\quad\zeta_{i,j}^{(2)}(t)=\bar{{\mathbf{w}}}_{i}(t)^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\\
I_{i,j}^{(1)}(t)=\bar{{\mathbf{v}}}_{i}(t)^{\top}\bar{{\mathbf{v}}}_{j}(t);\quad I_{i,j}^{(2)}(t)=\bar{{\mathbf{w}}}_{i}(t)^{\top}\bar{{\mathbf{w}}}_{j}(t);\quad I_{i,j}^{(3)}(t)=\bar{{\mathbf{v}}}_{i}(t)^{\top}\bar{{\mathbf{w}}}_{j}(t)\end{gathered}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow></mrow><mo rspace="2.167em">;</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow></mrow><mo rspace="2.167em">;</mo><mrow><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub