<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex446.m2" class="ltx_Math" alttext="\displaystyle=-\text{sign}\left(I_{i,i}^{(3)}(t)\right)\left(\frac{1}{a_{i}}\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}+\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\text{sign}\left(I_{i,i}^{(3)}(t)\right)\left(\frac{1}{a_{i}}\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}+\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}\right)</annotation></semantics></math></td>
