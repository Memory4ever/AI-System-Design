row><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>r</mi><mo>⋆</mo></msubsup></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>r</mi><mo>⋆</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{3}{b_{i}}\left({\mathbf{I}}-\bar{{\mathbf{w}}}_{i}\bar{{\mathbf{w}}}_{i}^{\top}\right)\left(\sum_{r=1}^{m}\left(\lambda_{i,r,2}\bar{{\mathbf{v}}}_{i}+\lambda_{i,r,3}\bar{{\mathbf{v}}}_{r}+3\lambda_{i,r,5}\bar{{\mathbf{w}}}_{r}\right)-\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,2}\bar{{\mathbf{v}}}_{i}+\hat{\lambda}_{i,r,3}\bar{{\mathbf{v}}}_{r}^{\star}+3\hat{\lambda}_{i,r,5}\bar{{\mathbf{w}}}_{r}^{\star}\right)\right)</annotation></semantics></math></td>
