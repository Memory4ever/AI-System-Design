</table>
<p id="A1.SS5.p12.4" class="ltx_p"><span id="A1.SS5.p12.4.1" class="ltx_text">Similarly, for <math id="A1.SS5.p12.m6" class="ltx_Math" alttext="\zeta_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{i,j}^{(2)}(t)</annotation></semantics></math>, by Lemma <a href="#Thmlemma7" title="Lemma 7. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, we have that</span></p>
<table id="A1.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex394"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex394.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{dt}\left|\zeta_{i,j}^{(2)}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{dt}\left|\zeta_{i,j}^{(2)}(t)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex394.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\cdot\text{sign}\left(\zeta_{i,j}^{(2)}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msup><mrow><mo>(</mo><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>sign</mtext><mrow><mo>(</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{1}{b_{i}}\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\cdot\text{sign}\left(\zeta_{i,j}^{(2)}(t)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex395"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex395.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{3}{b_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)\right|+\frac{3}{b_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|-3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\left|\zeta_{i,j}^{(2)}(t)\right|\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo fence="false" rspace="0.167em">|</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo fence="false" rspace="0.167em">|</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0em">−</mo><mn>3</mn><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{3}{b_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)\right|+\frac{3}{b_{i}^{2}}\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|-3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\left|\zeta_{i,j}^{(2)}(t)\right|\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex396"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex396.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\frac{36}{b_{i}^{2}}\left|C_{S,2}\gamma_{i,j}^{(1)}(t)I_{i,i}^{(3)}(t)\right|+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}+\varepsilon_{5,\ell}(t)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>36</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msub><mi>C</mi><mrow><mi>S</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\frac{36}{b_{i}^{2}}\left|C_{S,2}\gamma_{i,j}^{(1)}(t)I_{i,i}^{(3)}(t)\right|+\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{B},\ell}^{(3)}(t)^{2}+\varepsilon_{5,\ell}(t)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p12.5" class="ltx_p"><span id="A1.SS5.p12.5.1" class="ltx_text">The third term is apparently negative due to the fact that <math id="A1.SS5.p12.m7" class="ltx_Math" alttext="\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\geq 0,\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo>,</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\geq 0,\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\geq 0</annotation></semantics></math>. For the first two, we have that</span></p>
<table id="A1.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex397"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex397.m1" class="ltx_Math" alttext="\displaystyle\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex397.m2" class="ltx_Math" alttext="\displaystyle\leq 6\left|\zeta_{i,j}^{(1)}(t)\right|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\left|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|^{k}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mi>k</mi></msup></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 6\left|\zeta_{i,j}^{(1)}(t)\right|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\left|\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right|^{k}+\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
