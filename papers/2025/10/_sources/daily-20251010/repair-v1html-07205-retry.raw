<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex171.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad+\frac{3}{b_{i}^{2}}\sum_{r=1}^{m}\left(\lambda_{i,r,2}(t)I_{i,i}^{(3)}(t)+\lambda_{i,r,3}(t)I_{r,i}^{(3)}(t)+3\lambda_{i,r,5}(t)I_{r,i}^{(2)}(t)\right)I_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>I</mi><mrow><mi>r</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>3</mn><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>I</mi><mrow><mi>r</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\frac{3}{b_{i}^{2}}\sum_{r=1}^{m}\left(\lambda_{i,r,2}(t)I_{i,i}^{(3)}(t)+\lambda_{i,r,3}(t)I_{r,i}^{(3)}(t)+3\lambda_{i,r,5}(t)I_{r,i}^{(2)}(t)\right)I_{i,j}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex172.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad-\frac{3}{b_{i}^{2}}\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,2}(t)I_{i,i}^{(3)}(t)+\hat{\lambda}_{i,r,3}(t)\zeta_{i,r}^{(2)}(t)+3\hat{\lambda}_{i,r,5}(t)\gamma_{i,r}^{(2)}(t)\right)I_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><mo>(</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>3</mn><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad-\frac{3}{b_{i}^{2}}\sum_{r=1}^{m^{\star}}\left(\hat{\lambda}_{i,r,2}(t)I_{i,i}^{(3)}(t)+\hat{\lambda}_{i,r,3}(t)\zeta_{i,r}^{(2)}(t)+3\hat{\lambda}_{i,r,5}(t)\gamma_{i,r}^{(2)}(t)\right)I_{i,j}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Approximating the Gradient Flow Dynamics</h3>

<div id="A1.SS4.p1" class="ltx_para ltx_noindent">
<p id="A1.SS4.p1.1" class="ltx_p">In order to understand the property of the GF induced dynamics given in the previous section, we need to first compute <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="\lambda_{i,j,\ell}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,\ell}</annotation></semantics></math>s and <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="\hat{\lambda}_{i,j,\ell}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,\ell}</annotation></semantics></math>s. The following lemma provides such property.</p>
</div>
<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="i\in[m],j\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\in[m],j\in[m^{\star}]</annotation></semantics></math> and <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>. If for any <math id="Thmlemma5.p1.m3" class="ltx_Math" alttext="\left|\zeta_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(1)}(t)\right|,\left|I_{i,i}^{(3)}(t)\right|\leq\delta_{r}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mi>r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\left|\zeta_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(1)}(t)\right|,\left|I_{i,i}^{(3)}(t)\right|\leq\delta_{r}</annotation></semantics></math> for some <math id="Thmlemma5.p1.m4" class="ltx_Math" alttext="\delta_{r}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>r</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{r}&gt;0</annotation></semantics></math>, then we have that</span></p>
<table id="A1.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex173.m1" class="ltx_Math" alttext="\displaystyle\hat{\lambda}_{i,j,1}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\lambda}_{i,j,1}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex173.m2" class="ltx_Math" alttext="\displaystyle=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{3}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{4}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>4</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{3}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{4}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex174.m1" class="ltx_Math" alttext="\displaystyle\hat{\lambda}_{i,j,2}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\lambda}_{i,j,2}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex174.m2" class="ltx_Math" alttext="\displaystyle=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex175.m1" class="ltx_Math" alttext="\displaystyle\hat{\lambda}_{i,j,3}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\lambda}_{i,j,3}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex175.m2" class="ltx_Math" alttext="\displaystyle=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex176"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex176.m1" class="ltx_Math" alttext="\displaystyle\hat{\lambda}_{i,j,4}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\lambda}_{i,j,4}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex176.m2" class="ltx_Math" alttext="\displaystyle=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}I_{i,i}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}I_{i,i}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex177.m1" class="ltx_Math" alttext="\displaystyle\hat{\lambda}_{i,j,5}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\lambda}_{i,j,5}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex177.m2" class="ltx_Math" alttext="\displaystyle=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{4}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>4</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{4}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p2" class="ltx_para ltx_noindent">
<p id="A1.SS4.p2.1" class="ltx_p"><span id="A1.SS4.p2.1.1" class="ltx_text">We are going to Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p2.m1" class="ltx_Math" alttext="{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>=</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}^{\star}</annotation></semantics></math> and <math id="A1.SS4.p2.m2" class="ltx_Math" alttext="{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{i}(t),{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐰</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐰</mi><mn>2</mn></msub><mo>=</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{i}(t),{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{j}^{\star}</annotation></semantics></math>. In this case, we have that <math id="A1.SS4.p2.m3" class="ltx_Math" alttext="{\mathbf{v}}_{1}^{\top}{\mathbf{v}}_{2}=\gamma_{i,j}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}^{\top}{\mathbf{v}}_{2}=\gamma_{i,j}^{(1)}(t)</annotation></semantics></math> and <math id="A1.SS4.p2.m4" class="ltx_Math" alttext="{\mathbf{w}}_{1}^{\top}{\mathbf{w}}_{2}=\gamma_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐰</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{1}^{\top}{\mathbf{w}}_{2}=\gamma_{i,j}^{(2)}(t)</annotation></semantics></math>. We start with <math id="A1.SS4.p2.m5" class="ltx_Math" alttext="\hat{\lambda}_{i,j,1}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,1}(t)</annotation></semantics></math>. By definition, we have that</span></p>
<table id="A1.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex178.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,1}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,1}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.2" class="ltx_p"><span id="A1.SS4.p2.2.1" class="ltx_text">Here, invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p2.m6" class="ltx_Math" alttext="h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell+1}</annotation></semantics></math> gives</span></p>
<table id="A1.Ex179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex179.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,1}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{3}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{4}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>4</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,1}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{3}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{4}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.3" class="ltx_p"><span id="A1.SS4.p2.3.1" class="ltx_text">For <math id="A1.SS4.p2.m7" class="ltx_Math" alttext="\hat{\lambda}_{i,j,5}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,5}(t)</annotation></semantics></math>, by definition we have</span></p>
<table id="A1.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex180.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,5}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,5}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.4" class="ltx_p"><span id="A1.SS4.p2.4.1" class="ltx_text">Invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p2.m8" class="ltx_Math" alttext="h_{k}=c_{k},h_{\ell}^{\prime}=c_{\ell}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k},h_{\ell}^{\prime}=c_{\ell}</annotation></semantics></math> gives</span></p>
<table id="A1.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex181.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,5}(t)=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{4}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mi>k</mi><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>2</mn></msubsup><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>4</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,5}(t)=2\sum_{k=0}^{\infty}\frac{c_{k}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\pm\mathcal{O}\left(\delta_{r}^{2}\right)\gamma_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{4}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.5" class="ltx_p"><span id="A1.SS4.p2.5.1" class="ltx_text">For <math id="A1.SS4.p2.m9" class="ltx_Math" alttext="\hat{\lambda}_{i,j,2}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,2}(t)</annotation></semantics></math>, by definition we have</span></p>
<table id="A1.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex182.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,2}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,2}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.6" class="ltx_p"><span id="A1.SS4.p2.6.1" class="ltx_text">Here, invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p2.m10" class="ltx_Math" alttext="h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell}</annotation></semantics></math>, and noticing that <math id="A1.SS4.p2.m11" class="ltx_Math" alttext="\bar{{\mathbf{v}}}_{j}^{\star\top}\bar{{\mathbf{w}}}_{j}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{{\mathbf{v}}}_{j}^{\star\top}\bar{{\mathbf{w}}}_{j}=0</annotation></semantics></math>, gives</span></p>
<table id="A1.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex183.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,2}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,2}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.7" class="ltx_p"><span id="A1.SS4.p2.7.1" class="ltx_text">Noticing that <math id="A1.SS4.p2.m12" class="ltx_Math" alttext="c_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{2}=0</annotation></semantics></math> gives that</span></p>
<table id="A1.Ex184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex184.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,2}(t)=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,2}(t)=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.8" class="ltx_p"><span id="A1.SS4.p2.8.1" class="ltx_text">For <math id="A1.SS4.p2.m13" class="ltx_Math" alttext="\hat{\lambda}_{i,j,3}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,3}(t)</annotation></semantics></math>, by definition, we have that</span></p>
<table id="A1.Ex185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex185.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,3}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,3}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.9" class="ltx_p"><span id="A1.SS4.p2.9.1" class="ltx_text">Invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p2.m14" class="ltx_Math" alttext="h_{k}=c_{k},h_{\ell}^{\prime}=c_{\ell+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k},h_{\ell}^{\prime}=c_{\ell+1}</annotation></semantics></math>, and noticing that <math id="A1.SS4.p2.m15" class="ltx_Math" alttext="\bar{{\mathbf{v}}}_{j}^{\star\top}\bar{{\mathbf{w}}}_{j}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{{\mathbf{v}}}_{j}^{\star\top}\bar{{\mathbf{w}}}_{j}=0</annotation></semantics></math>, gives</span></p>
<table id="A1.Ex186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex186.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,3}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,3}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.10" class="ltx_p"><span id="A1.SS4.p2.10.1" class="ltx_text">Lastly, for <math id="A1.SS4.p2.m16" class="ltx_Math" alttext="\hat{\lambda}_{4}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mn>4</mn></msub><annotation encoding="application/x-tex">\hat{\lambda}_{4}</annotation></semantics></math>, by definition we have</span></p>
<table id="A1.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex187.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,4}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mrow><mo>⋆</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,4}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}^{\star\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}^{\star\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.11" class="ltx_p"><span id="A1.SS4.p2.11.1" class="ltx_text">Therefore, we need to consider <math id="A1.SS4.p2.m17" class="ltx_Math" alttext="{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>=</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}^{\star}</annotation></semantics></math> and <math id="A1.SS4.p2.m18" class="ltx_Math" alttext="{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{j}^{\star},{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐰</mi><mn>1</mn></msub><mo>=</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><mo>,</mo><mrow><msub><mi>𝐰</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{j}^{\star},{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{i}(t)</annotation></semantics></math>. Moreover, we need to set <math id="A1.SS4.p2.m19" class="ltx_Math" alttext="h_{k}=c_{k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">h_{k}=c_{k+1}</annotation></semantics></math> and <math id="A1.SS4.p2.m20" class="ltx_Math" alttext="h_{\ell}^{\prime}=c_{\ell}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">h_{\ell}^{\prime}=c_{\ell}</annotation></semantics></math>. In this case, <math id="A1.SS4.p2.m21" class="ltx_Math" alttext="{\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{2}=I_{i,i}^{(3)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}^{\top}{\mathbf{w}}_{2}=I_{i,i}^{(3)}(t)</annotation></semantics></math> and <math id="A1.SS4.p2.m22" class="ltx_Math" alttext="{\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{2}=\zeta_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐯</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐰</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{2}^{\top}{\mathbf{w}}_{2}=\zeta_{i,j}^{(2)}(t)</annotation></semantics></math>. Therefore</span></p>
<table id="A1.Ex188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex188.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,4}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}I_{i,i}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,4}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}I_{i,i}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.12" class="ltx_p"><span id="A1.SS4.p2.12.1" class="ltx_text">Noticing that <math id="A1.SS4.p2.m23" class="ltx_Math" alttext="c_{2}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{2}=0</annotation></semantics></math> gives that</span></p>
<table id="A1.Ex189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex189.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,4}(t)=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}I_{i,i}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,4}(t)=6\sum_{k=1}^{\infty}\frac{c_{k+2}c_{k}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}I_{i,i}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}\gamma_{i,j}^{(1)}(t)^{k}\gamma_{i,j}^{(2)}(t)^{2}\zeta_{i,j}^{(2)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.13" class="ltx_p"><span id="A1.SS4.p2.13.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="i,j\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[m]</annotation></semantics></math> and <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math>. If for any <math id="Thmlemma6.p1.m3" class="ltx_Math" alttext="\left|I_{i,j}^{(1)}(t)\right|,\left|I_{i,j}^{(2)}(t)\right|,\left|I_{i,j}^{(3)}(t)\right|\leq\delta_{r}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mi>r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\left|I_{i,j}^{(1)}(t)\right|,\left|I_{i,j}^{(2)}(t)\right|,\left|I_{i,j}^{(3)}(t)\right|\leq\delta_{r}</annotation></semantics></math> when <math id="Thmlemma6.p1.m4" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, and <math id="Thmlemma6.p1.m5" class="ltx_Math" alttext="\left|I_{i,i}^{(3)}(t)\right|\leq\delta_{p}\leq\mathcal{O}\left(\delta_{r}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mi>δ</mi><mi>p</mi></msub><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>δ</mi><mi>r</mi></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|I_{i,i}^{(3)}(t)\right|\leq\delta_{p}\leq\mathcal{O}\left(\delta_{r}\right)</annotation></semantics></math>, then we have that</span></p>
<table id="A1.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

