\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{j,j_{\ell}^{\star}}^{(1)}(t)-\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)I_{i,j}^{(1)}(t)\\
