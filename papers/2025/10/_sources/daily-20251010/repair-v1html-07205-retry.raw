<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex295.m1" class="ltx_Math" alttext="\displaystyle\sum_{r=1}^{m}\lambda_{i,r,2}(t)I_{i,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{r=1}^{m}\lambda_{i,r,2}(t)I_{i,j}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex295.m2" class="ltx_Math" alttext="\displaystyle=\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)\pm\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>±</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)\pm\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex296.m1" class="ltx_Math" alttext="\displaystyle\sum_{r=1}^{m}\lambda_{i,r,4}(t)I_{r,j}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>r</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{r=1}^{m}\lambda_{i,r,4}(t)I_{r,j}^{(2)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex296.m2" class="ltx_Math" alttext="\displaystyle=\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)\pm\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>±</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)\pm\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p10.5" class="ltx_p"><span id="A1.SS4.p10.5.1" class="ltx_text">Therefore, combining with (<a href="#A1.E12" title="In Proof. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) gives</span></p>
<table id="A1.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex297.m1" class="ltx_Math" alttext="\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{w}}}_{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex297.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{1}{a_{i}}\cdot\begin{cases}\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\left(\zeta_{j,j_{\ell}^{\star}}^{(2)}(t)-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)I_{i,j}^{(3)}(t)\right)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star}\\
\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{1}{a_{i}}\cdot\begin{cases}\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\left(\zeta_{j,j_{\ell}^{\star}}^{(2)}(t)-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)I_{i,j}^{(3)}(t)\right)\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star}\\
\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS4.p11" class="ltx_para">
<p id="A1.SS4.p11.1" class="ltx_p"><span id="A1.SS4.p11.1.1" class="ltx_text ltx_font_bold">Analysis of <math id="A1.SS4.p11.m1" class="ltx_Math" alttext="\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}</annotation></semantics></math>.<span id="A1.SS4.p11.1.1.1" class="ltx_text ltx_font_medium"> The analysis of <math id="A1.SS4.p11.m2" class="ltx_Math" alttext="\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}</annotation></semantics></math> will also be separated into two cases. First, regardless of the cases, we have that</span></span></p>
<table id="A1.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex298.m1" class="ltx_Math" alttext="\displaystyle\sum_{r=1}^{m^{\star}}\hat{\lambda}_{i,r,5}(t)\zeta_{j,r}^{(1)}(t)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>r</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><mi>r</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{r=1}^{m^{\star}}\hat{\lambda}_{i,r,5}(t)\zeta_{j,r}^{(1)}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex298.m2" class="ltx_math_unparsed" alttext="\displaystyle=\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\zeta_{j,j_{\ell}^{\star}}^{(1)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow><mo>±</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mi>m</mi><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\zeta_{j,j_{\ell}^{\star}}^{(1)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
