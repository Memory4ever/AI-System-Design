<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex108.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad+\frac{6\left({\mathbf{I}}-\bar{{\mathbf{v}}}_{i}\bar{{\mathbf{v}}}_{i}^{\top}\right)}{\left\|{\mathbf{v}}_{i}\right\|_{2}}\sum_{j=1}^{m^{\star}}\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right.}{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\boldsymbol{\left.\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right]}\bar{{\mathbf{w}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><msub><mrow><mo>‖</mo><msub><mi>𝐯</mi><mi>i</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>m</mi><mo>⋆</mo></msup></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac></mstyle><msub><mi>𝔼</mi><mi>𝐱</mi></msub><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mi>H</mi><msub><mi>e</mi><mi>k</mi></msub><mrow><mo>(</mo><msup><mi>𝐱</mi><mo>⊤</mo></msup><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>)</mo></mrow><mi>H</mi><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mrow><mo>(</mo><msup><mi>𝐱</mi><mo>⊤</mo></msup><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup><mo>)</mo></mrow><mi>H</mi><msub><mi>e</mi><mn>3</mn></msub><mrow><mo>(</mo><msup><mi>𝐱</mi><mo>⊤</mo></msup><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>)</mo></mrow><mi>H</mi><msub><mi>e</mi><mn>2</mn></msub><mrow><mo>(</mo><msup><mi>𝐱</mi><mo>⊤</mo></msup><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup><mo>)</mo></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad+\frac{6\left({\mathbf{I}}-\bar{{\mathbf{v}}}_{i}\bar{{\mathbf{v}}}_{i}^{\top}\right)}{\left\|{\mathbf{v}}_{i}\right\|_{2}}\sum_{j=1}^{m^{\star}}\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}_{{\mathbf{x}}}\boldsymbol{\left[\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right.}{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\boldsymbol{\left.\vphantom{He_{k}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{i}\right)He_{\ell}\left({\mathbf{x}}^{\top}\bar{{\mathbf{v}}}_{j}^{\star}\right)He_{3}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{i}\right)He_{2}\left({\mathbf{x}}^{\top}\bar{{\mathbf{w}}}_{j}^{\star}\right)}\right]}\bar{{\mathbf{w}}}_{j}^{\star}</annotation></semantics></math></td>
