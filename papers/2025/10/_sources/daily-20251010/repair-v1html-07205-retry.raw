<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex223.m1" class="ltx_Math" alttext="\displaystyle\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)^{\top}\bar{{\mathbf{v}}}_{j}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex223.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\frac{3}{b_{i}}\cdot\left(3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\zeta_{j,j_{\ell}^{\star}}^{(1)}(t)+\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)+\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>3</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mn>3</mn><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>ζ</mi><mrow><mi>j</mi><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{3}{b_{i}}\cdot\left(3\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\zeta_{j,j_{\ell}^{\star}}^{(1)}(t)+\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)+\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},3}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\right)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex224.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad-\frac{9}{b_{i}}\cdot\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}-36C_{S,2}I_{i,i}^{(3)}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝕀</mi><mrow><mo>{</mo><mi>i</mi><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>}</mo></mrow><mo>−</mo><mn>36</mn><msub><mi>C</mi><mrow><mi>S</mi><mo>,</mo><mn>2</mn></mrow></msub><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>±</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo>(</mo><mi>m</mi><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad-\frac{9}{b_{i}}\cdot\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},5}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)\mathbb{I}\left\{i=i_{\ell}^{\star}\right\}-36C_{S,2}I_{i,i}^{(3)}(t)\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS4.p5" class="ltx_para ltx_noindent">
<p id="A1.SS4.p5.1" class="ltx_p"><span id="A1.SS4.p5.1.1" class="ltx_text">In the following of the proof we will assume that <math id="A1.SS4.p5.m1" class="ltx_Math" alttext="i\in[m]\setminus\mathcal{R}_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">i\in[m]\setminus\mathcal{R}_{\ell-1}</annotation></semantics></math> and <math id="A1.SS4.p5.m2" class="ltx_Math" alttext="j\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[m^{\star}]</annotation></semantics></math>.
For <math id="A1.SS4.p5.m3" class="ltx_Math" alttext="\hat{\lambda}_{i,j,1},\dots\hat{\lambda}_{i,j,5}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,1},\dots\hat{\lambda}_{i,j,5}</annotation></semantics></math>, we apply Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ A.4 Approximating the Gradient Flow Dynamics ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> with</span></p>
<table id="A1.Ex225" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex225.m1" class="ltx_Math" alttext="\delta_{r}=\varepsilon_{\mathcal{B},\ell}^{(1)}(t);\;\text{ for }i\in[m]\setminus\mathcal{R}_{\ell-1},j\in[m^{\star}];" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>δ</mi><mi>r</mi></msub><mo>=</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mrow><mtext> for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\delta_{r}=\varepsilon_{\mathcal{B},\ell}^{(1)}(t);\;\text{ for }i\in[m]\setminus\mathcal{R}_{\ell-1},j\in[m^{\star}];</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p5.2" class="ltx_p"><span id="A1.SS4.p5.2.1" class="ltx_text">For <math id="A1.SS4.p5.m4" class="ltx_Math" alttext="\lambda_{i,j,1},\dots,\lambda_{i,j,5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\lambda_{i,j,1},\dots,\lambda_{i,j,5}</annotation></semantics></math>, we apply</span></p>
<table id="A1.Ex226" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex226.m1" class="ltx_Math" alttext="\delta_{r}=\begin{cases}\varepsilon_{\mathcal{B},\ell}^{(1)}(t);\;\text{ if }i,j\in[m]\setminus\mathcal{R}_{\ell-1},\;i\neq j\\
\varepsilon_{\mathcal{F},\ell}(t);\;\text{ if }i\in\mathcal{R}_{\ell-1}\vee j\in\mathcal{R}_{\ell-1},\;i\neq j\end{cases}\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\quad\delta_{p}=\begin{cases}\varepsilon_{\mathcal{B},\ell}^{(3)}(t)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\varepsilon_{5,\ell}(t)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>δ</mi><mi>r</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∨</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.447em">,</mo><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow><mo>≤</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">;</mo><mrow><msub><mi>δ</mi><mi>p</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{r}=\begin{cases}\varepsilon_{\mathcal{B},\ell}^{(1)}(t);\;\text{ if }i,j\in[m]\setminus\mathcal{R}_{\ell-1},\;i\neq j\\
\varepsilon_{\mathcal{F},\ell}(t);\;\text{ if }i\in\mathcal{R}_{\ell-1}\vee j\in\mathcal{R}_{\ell-1},\;i\neq j\end{cases}\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\quad\delta_{p}=\begin{cases}\varepsilon_{\mathcal{B},\ell}^{(3)}(t)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\varepsilon_{5,\ell}(t)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p5.3" class="ltx_p"><span id="A1.SS4.p5.3.1" class="ltx_text">For <math id="A1.SS4.p5.m5" class="ltx_Math" alttext="\hat{\lambda}_{i_{\ell^{\prime}}^{\star},j,1},\dots,\hat{\lambda}_{i_{\ell^{\prime}}^{\star},j,5}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i_{\ell^{\prime}}^{\star},j,1},\dots,\hat{\lambda}_{i_{\ell^{\prime}}^{\star},j,5}</annotation></semantics></math> for <math id="A1.SS4.p5.m6" class="ltx_Math" alttext="\ell^{\prime}&lt;\ell" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>&lt;</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">\ell^{\prime}&lt;\ell</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex227" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex227.m1" class="ltx_Math" alttext="\delta_{r}=\varepsilon_{\mathcal{F},\ell}(t)\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\quad" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>δ</mi><mi>r</mi></msub><mo>=</mo><mrow><msub><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\delta_{r}=\varepsilon_{\mathcal{F},\ell}(t)\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\quad</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p5.4" class="ltx_p"><span id="A1.SS4.p5.4.1" class="ltx_text">For <math id="A1.SS4.p5.m7" class="ltx_Math" alttext="\lambda_{i_{\ell^{\prime}}^{\star},i_{\ell^{\prime}}^{\star},1},\dots,\lambda_{i_{\ell^{\prime}}^{\star},i_{\ell^{\prime}}^{\star},5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\lambda_{i_{\ell^{\prime}}^{\star},i_{\ell^{\prime}}^{\star},1},\dots,\lambda_{i_{\ell^{\prime}}^{\star},i_{\ell^{\prime}}^{\star},5}</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex228" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex228.m1" class="ltx_Math" alttext="\delta_{r}=\delta_{p}=\varepsilon_{\mathcal{F},\ell}(t)\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t)" display="block" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>r</mi></msub><mo>=</mo><msub><mi>δ</mi><mi>p</mi></msub><mo>=</mo><mrow><msub><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{r}=\delta_{p}=\varepsilon_{\mathcal{F},\ell}(t)\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p5.5" class="ltx_p"><span id="A1.SS4.p5.5.1" class="ltx_text">Moreover, we also have that</span></p>
<table id="A1.EGx43" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.Ex229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex229.m1" class="ltx_Math" alttext="\displaystyle\left|\gamma_{i,j}^{(1)}(t)\right|,\left|\gamma_{i,j}^{(2)}(t)\right|\leq\begin{cases}\varepsilon_{\mathcal{A},\ell}^{(2)}(t)&amp;\text{ if }i\neq i_{\ell}^{\star}\\
\varepsilon_{\mathcal{A},\ell}^{(1)}(t)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}\;\forall j\in[m^{\star}],(i,j)\neq(i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star})\;\forall\ell^{\prime}\leq\ell" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≠</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0.447em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow></mrow><mo>≤</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|\gamma_{i,j}^{(1)}(t)\right|,\left|\gamma_{i,j}^{(2)}(t)\right|\leq\begin{cases}\varepsilon_{\mathcal{A},\ell}^{(2)}(t)&amp;\text{ if }i\neq i_{\ell}^{\star}\\
\varepsilon_{\mathcal{A},\ell}^{(1)}(t)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}\;\forall j\in[m^{\star}],(i,j)\neq(i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star})\;\forall\ell^{\prime}\leq\ell</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex230.m1" class="ltx_Math" alttext="\displaystyle\left|\zeta_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(2)}(t)\right|\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\forall i\in[m],j\in[m^{\star}]" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|\zeta_{i,j}^{(1)}(t)\right|,\left|\zeta_{i,j}^{(2)}(t)\right|\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\forall i\in[m],j\in[m^{\star}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex231.m1" class="ltx_Math" alttext="\displaystyle\left|I_{i,j}^{(1)}(t)\right|,\left|I_{i,j}^{(2)}(t)\right|,\left|I_{i,j}^{(3)}(t)\right|\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\forall i,j\in[m],i\neq j" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>,</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|I_{i,j}^{(1)}(t)\right|,\left|I_{i,j}^{(2)}(t)\right|,\left|I_{i,j}^{(3)}(t)\right|\leq\varepsilon_{\mathcal{A},\ell}^{(1)}(t);\forall i,j\in[m],i\neq j</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex232.m1" class="ltx_Math" alttext="\displaystyle\left|I_{i,i}^{(3)}(t)\right|\leq\begin{cases}\varepsilon_{\mathcal{F},\ell}(t)&amp;\text{ if }i\in\mathcal{R}_{\ell-1}\\
\varepsilon_{5,\ell}(t)&amp;\text{ if }i=i_{\ell}^{\star}\\
\varepsilon_{\mathcal{B},\ell}^{(3)}(t)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left|I_{i,i}^{(3)}(t)\right|\leq\begin{cases}\varepsilon_{\mathcal{F},\ell}(t)&amp;\text{ if }i\in\mathcal{R}_{\ell-1}\\
\varepsilon_{5,\ell}(t)&amp;\text{ if }i=i_{\ell}^{\star}\\
\varepsilon_{\mathcal{B},\ell}^{(3)}(t)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p5.6" class="ltx_p"><span id="A1.SS4.p5.6.1" class="ltx_text">This gives that for all <math id="A1.SS4.p5.m8" class="ltx_Math" alttext="j\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[m^{\star}]</annotation></semantics></math> and such that <math id="A1.SS4.p5.m9" class="ltx_Math" alttext="(i,j)\neq(i_{\ell}^{\star},j_{\ell}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(i,j)\neq(i_{\ell}^{\star},j_{\ell}^{\star})</annotation></semantics></math></span></p>
<table id="A1.Ex233" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex233.m1" class="ltx_Math" alttext="\hat{\lambda}_{i,j,1}(t)\leq\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)&amp;\text{ if }i\neq i_{\ell}^{\star}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases};\;\hat{\lambda}_{i,j,5}(t)\leq\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)&amp;\text{ if }i\neq i_{\ell}^{\star}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≠</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow><mo rspace="0.447em">;</mo><mrow><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>≠</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,1}(t)\leq\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}\right)&amp;\text{ if }i\neq i_{\ell}^{\star}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases};\;\hat{\lambda}_{i,j,5}(t)\leq\begin{cases}\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{2}\right)&amp;\text{ if }i\neq i_{\ell}^{\star}\\
\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)&amp;\text{ if }i=i_{\ell}^{\star}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p5.7" class="ltx_p"><span id="A1.SS4.p5.7.1" class="ltx_text">We will analyze each dynamic separately. However, we should notice some common terms that appears in the dynamics.</span></p>
</div>
<div id="A1.SS4.p6" class="ltx_para ltx_noindent">
<p id="A1.SS4.p6.3" class="ltx_p"><span id="A1.SS4.p6.3.1" class="ltx_text ltx_font_bold">Common terms.<span id="A1.SS4.p6.3.1.1" class="ltx_text ltx_font_medium"> To start, let’s tackle some common terms in the dynamics we are interest in. In particular, we have that for <math id="A1.SS4.p6.m1" class="ltx_Math" alttext="i\in[m]\setminus\mathcal{R}_{\ell-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">i\in[m]\setminus\mathcal{R}_{\ell-1}</annotation></semantics></math>,</span></span></p>
