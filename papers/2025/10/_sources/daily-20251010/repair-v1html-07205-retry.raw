</table>
<p id="A1.SS4.p3.9" class="ltx_p"><span id="A1.SS4.p3.9.1" class="ltx_text">Invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p3.m16" class="ltx_Math" alttext="h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell}</annotation></semantics></math> gives</span></p>
<table id="A1.Ex203" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex203.m1" class="ltx_Math" alttext="\lambda_{i,j,2}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{i,j}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{j,j}^{(3)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>j</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,2}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{i,j}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{j,j}^{(3)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.10" class="ltx_p"><span id="A1.SS4.p3.10.1" class="ltx_text">In the case where <math id="A1.SS4.p3.m17" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>, we have that <math id="A1.SS4.p3.m18" class="ltx_Math" alttext="I_{i,j}^{(1)}(t)=I_{i,j}^{(2)}(t)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">I_{i,j}^{(1)}(t)=I_{i,j}^{(2)}(t)=1</annotation></semantics></math>. Therefore</span></p>
<table id="A1.Ex204" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex204.m1" class="ltx_Math" alttext="\lambda_{i,j,2}(t)=6I_{i,i}^{(3)}(t)\sum_{k=0}^{\infty}\frac{c_{k}c_{k+2}+c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><mrow><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>p</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,2}(t)=6I_{i,i}^{(3)}(t)\sum_{k=0}^{\infty}\frac{c_{k}c_{k+2}+c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.11" class="ltx_p"><span id="A1.SS4.p3.11.1" class="ltx_text">For <math id="A1.SS4.p3.m19" class="ltx_Math" alttext="\lambda_{i,j,3}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,3}</annotation></semantics></math>, by definition, we have that</span></p>
<table id="A1.Ex205" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex205.m1" class="ltx_Math" alttext="\lambda_{i,j,3}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,3}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k}c_{\ell+1}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.12" class="ltx_p"><span id="A1.SS4.p3.12.1" class="ltx_text">Invoking Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p3.m20" class="ltx_Math" alttext="h_{k}=c_{k},h_{\ell}^{\prime}=c_{\ell+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k},h_{\ell}^{\prime}=c_{\ell+1}</annotation></semantics></math> gives</span></p>
<table id="A1.Ex206" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex206.m1" class="ltx_Math" alttext="\lambda_{i,j,3}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{i,j}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{j,j}^{(3)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>j</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,3}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{i,j}^{(3)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{j,j}^{(3)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.13" class="ltx_p"><span id="A1.SS4.p3.13.1" class="ltx_text">In the case where <math id="A1.SS4.p3.m21" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>, we have that <math id="A1.SS4.p3.m22" class="ltx_Math" alttext="I_{i,j}^{(1)}(t)=I_{i,j}^{(2)}(t)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">I_{i,j}^{(1)}(t)=I_{i,j}^{(2)}(t)=1</annotation></semantics></math>. Therefore</span></p>
<table id="A1.Ex207" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex207.m1" class="ltx_Math" alttext="\lambda_{i,j,3}(t)=6I_{i,i}^{(3)}(t)\sum_{k=0}^{\infty}\frac{c_{k}c_{k+2}+c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><mrow><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>p</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,3}(t)=6I_{i,i}^{(3)}(t)\sum_{k=0}^{\infty}\frac{c_{k}c_{k+2}+c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.14" class="ltx_p"><span id="A1.SS4.p3.14.1" class="ltx_text">Lastly, for <math id="A1.SS4.p3.m23" class="ltx_Math" alttext="\lambda_{i,j,4}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,4}</annotation></semantics></math>, we have that</span></p>
<table id="A1.Ex208" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex208.m1" class="ltx_Math" alttext="\lambda_{i,j,4}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mrow><mrow><mrow><mi>k</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">[</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>)</mo></mrow></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,4}(t)=\sum_{k,\ell=0}^{\infty}\frac{c_{k+1}c_{\ell}}{k!\ell!}\mathrm{\mathbb{E}}\boldsymbol{\left[\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right.}{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\boldsymbol{\left.\vphantom{He_{k}\left(\bar{{\mathbf{v}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{\ell}\left(\bar{{\mathbf{v}}}_{j}(t)^{\top}{\mathbf{x}}\right)He_{3}\left(\bar{{\mathbf{w}}}_{i}(t)^{\top}{\mathbf{x}}\right)He_{2}\left(\bar{{\mathbf{w}}}_{j}(t)^{\top}{\mathbf{x}}\right)}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.15" class="ltx_p"><span id="A1.SS4.p3.15.1" class="ltx_text">Here we need to apply Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.1 Hermite Polynomials ‣ Appendix D Auxiliary Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> with <math id="A1.SS4.p3.m24" class="ltx_Math" alttext="{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}(t),{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{j}(t),{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{i}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐯</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐰</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝐰</mi><mn>2</mn></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{v}}_{1}=\bar{{\mathbf{v}}}_{i}(t),{\mathbf{v}}_{2}=\bar{{\mathbf{v}}}_{j}(t),{\mathbf{w}}_{1}=\bar{{\mathbf{w}}}_{j}(t),{\mathbf{w}}_{2}=\bar{{\mathbf{w}}}_{i}(t)</annotation></semantics></math> and <math id="A1.SS4.p3.m25" class="ltx_Math" alttext="h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><mi mathvariant="normal">ℓ</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>c</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">h_{k}=c_{k+1},h_{\ell}^{\prime}=c_{\ell}</annotation></semantics></math>. This gives that</span></p>
<table id="A1.Ex209" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex209.m1" class="ltx_Math" alttext="\lambda_{i,j,4}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{i,i}^{(1)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{j,i}^{(3)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><mrow><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mfrac><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><mi>k</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>j</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>r</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,4}(t)=6\sum_{k=0}^{\infty}\frac{c_{k+2}c_{k}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{i,i}^{(1)}(t)+6\sum_{k=0}^{\infty}\frac{c_{k+1}^{2}}{k!}I_{i,j}^{(1)}(t)^{k}I_{i,j}^{(2)}(t)^{2}I_{j,i}^{(3)}(t)\pm\mathcal{O}\left(\delta_{r}^{3}\right)=\pm\mathcal{O}\left(\delta_{r}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.16" class="ltx_p"><span id="A1.SS4.p3.16.1" class="ltx_text">In the case where <math id="A1.SS4.p3.m26" class="ltx_Math" alttext="i=j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i=j</annotation></semantics></math>, we have that <math id="A1.SS4.p3.m27" class="ltx_Math" alttext="I_{i,j}^{(1)}(t)=I_{i,j}^{(2)}(t)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">I_{i,j}^{(1)}(t)=I_{i,j}^{(2)}(t)=1</annotation></semantics></math>. Therefore</span></p>
<table id="A1.Ex210" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex210.m1" class="ltx_Math" alttext="\lambda_{i,j,4}(t)=6I_{i,i}^{(3)}(t)\sum_{k=0}^{\infty}\frac{c_{k}c_{k+2}+c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{3}\right)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mfrac><mrow><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><msubsup><mi>c</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>δ</mi><mi>p</mi><mn>3</mn></msubsup><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,j,4}(t)=6I_{i,i}^{(3)}(t)\sum_{k=0}^{\infty}\frac{c_{k}c_{k+2}+c_{k+1}^{2}}{k!}\pm\mathcal{O}\left(\delta_{p}^{3}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p3.17" class="ltx_p"><span id="A1.SS4.p3.17.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.SS4.p4" class="ltx_para ltx_noindent">
<p id="A1.SS4.p4.1" class="ltx_p">With the above lemmas that studies <math id="A1.SS4.p4.m1" class="ltx_Math" alttext="\lambda_{i,j,\ell}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><annotation encoding="application/x-tex">\lambda_{i,j,\ell}</annotation></semantics></math>s and <math id="A1.SS4.p4.m2" class="ltx_Math" alttext="\hat{\lambda}_{i,j,\ell}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\lambda}_{i,j,\ell}</annotation></semantics></math>s, we are ready to analyze the dynamics of <math id="A1.SS4.p4.m3" class="ltx_Math" alttext="\gamma_{i,j}^{(1)},\gamma_{i,j}^{(2)},\zeta_{i,j}^{(1)},\zeta_{i,j}^{(2)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>ζ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\gamma_{i,j}^{(1)},\gamma_{i,j}^{(2)},\zeta_{i,j}^{(1)},\zeta_{i,j}^{(2)}</annotation></semantics></math>, and <math id="A1.SS4.p4.m4" class="ltx_Math" alttext="I_{i,j}^{(1)},I_{i,j}^{(2)},I_{i,j}^{(3)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">I_{i,j}^{(1)},I_{i,j}^{(2)},I_{i,j}^{(3)}</annotation></semantics></math>. In particular, we will fix any <math id="A1.SS4.p4.m5" class="ltx_Math" alttext="\ell\in[m^{\star}]" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\ell\in[m^{\star}]</annotation></semantics></math>, and assumes the inductive hypothesis.</p>
</div>
<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="\varepsilon_{\mathcal{A},\ell}^{(2)}(t),\varepsilon_{\mathcal{B},\ell}^{(3)}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathcal{A},\ell}^{(2)}(t),\varepsilon_{\mathcal{B},\ell}^{(3)}(t)</annotation></semantics></math>, and <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="\varepsilon_{5,\ell}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{5,\ell}(t)</annotation></semantics></math> be defined in Definition <a href="#Thmdefin1" title="Definition 1 (Error Bounds). ‣ A.1 Proof Outline ‣ Appendix A Proof of Theorem" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> with <math id="Thmlemma7.p1.m3" class="ltx_Math" alttext="\varepsilon_{5,\ell}(t)\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{5,\ell}(t)\leq\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\right)</annotation></semantics></math>. Then the gradient alignment <math id="Thmlemma7.p1.m4" class="ltx_Math" alttext="\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝛉</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}</annotation></semantics></math> and <math id="Thmlemma7.p1.m5" class="ltx_Math" alttext="\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{w}}}_{j}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><msub><mi>𝐰</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝛉</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐰</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup></mrow><annotation encoding="application/x-tex">\nabla_{{\mathbf{w}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{w}}}_{j}^{\star}</annotation></semantics></math> satisfies</span></p>
<table id="A1.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex211"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex211.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{{\mathbf{v}}_{i}}{\mathcal{L}}\left(\bm{\theta}(t)\right)\bar{{\mathbf{v}}}_{j}^{\star}=-\frac{1}{a_{i}}\cdot\begin{cases}\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(2)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(2)}(t)\varepsilon_{\mathcal{B},\ell}^{(3)}(t)\right)&amp;\text{ if }i\in[m]\setminus\mathcal{R}_{\ell}\\
\begin{aligned} &amp;-\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\gamma_{i,j}^{(1)}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(1)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j\in[m^{\star}]\setminus\mathcal{C}_{\ell}\\
\begin{aligned} &amp;\left(1-\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)^{2})\right)\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\pm\mathcal{O}\left(\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{2}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}\\
&amp;\quad\quad\quad\pm\mathcal{O}\left(m\varepsilon_{\mathcal{A},\ell}^{(1)}(t)^{3}+\varepsilon_{\mathcal{A},\ell}^{(1)}(t)\varepsilon_{5,\ell}(t)\right)\end{aligned}&amp;\text{ if }i=i_{\ell}^{\star},j=j_{\ell}^{\star}\end{cases}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>𝐯</mi><mi>i</mi></msub></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo>(</mo><mi>𝜽</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>j</mi><mo>⋆</mo></msubsup><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>a</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>±</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mrow><mn>5</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">[</mo><msup><mi>m</mi><mo>⋆</mo></msup><mo stretchy="false">]</mo></mrow><mo>∖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>±</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>ε</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></