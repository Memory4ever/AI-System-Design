<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex213.m2" class="ltx_Math" alttext="\displaystyle=\frac{9}{b_{i}}\lambda_{i,i_{\ell^{\prime}}^{\star},5}(t)\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>9</mn><msub><mi>b</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{9}{b_{i}}\lambda_{i,i_{\ell^{\prime}}^{\star},5}(t)\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)</annotation></semantics></math></td>
