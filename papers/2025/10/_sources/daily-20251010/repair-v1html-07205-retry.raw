<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex365.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{9c_{0}^{2}}{b_{i}^{2}}\left(1-\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right)\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)^{2}+\frac{9c_{0}^{2}}{b_{i}^{2}}\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\left|\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)^{2}-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)^{2}\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup></mrow><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>0</mn><mn>2</mn></msubsup></mrow><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><msubsup><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{9c_{0}^{2}}{b_{i}^{2}}\left(1-\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\right)\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)^{2}+\frac{9c_{0}^{2}}{b_{i}^{2}}\gamma_{i_{\ell^{\prime}}^{\star},j_{\ell^{\prime}}^{\star}}^{(2)}(t)\left|\gamma_{i,j_{\ell^{\prime}}}^{(2)}(t)^{2}-I_{i,i_{\ell^{\prime}}^{\star}}^{(2)}(t)^{2}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex366"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex366.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>4</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>γ</mi><mrow><msubsup><mi>i</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup><mo>,</mo><msubsup><mi>j</mi><mi mathvariant="normal">ℓ</mi><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>m</mi><mn>7</mn></msup><mrow><msubsup><mi>δ</mi><mi>ℙ</mi><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\mathcal{O}\left(\frac{m^{4}}{\delta_{\mathbb{P}}^{2}d}\right)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(2)}(t)^{2}+\mathcal{O}\left(\frac{m^{7}}{\delta_{\mathbb{P}}^{3}d^{\frac{3}{2}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p9.3" class="ltx_p"><span id="A1.SS5.p9.3.1" class="ltx_text">Recall that <math id="A1.SS5.p9.m5" class="ltx_Math" alttext="\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)=\bar{{\mathbf{v}}}_{i}^{\top}\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>γ</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>j</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup><mo>⋆</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\gamma_{i,j_{\ell^{\prime}}^{\star}}^{(2)}(t)=\bar{{\mathbf{v}}}_{i}^{\top}\bar{{\mathbf{v}}}_{j_{\ell^{\prime}}^{\star}}^{\star}</annotation></semantics></math> and <math id="A1.SS5.p9.m6" class="ltx_Math" alttext="I_{i,i_{\ell^{\prime}}^{\star}}=\bar{{\mathbf{v}}}_{i}^{\top}\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>i</mi><mo>,</mo><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></mrow></msub><mo>=</mo><mrow><msubsup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msubsup><mi>i</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>⋆</mo></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">I_{i,i_{\ell^{\prime}}^{\star}}=\bar{{\mathbf{v}}}_{i}^{\top}\bar{{\mathbf{v}}}_{i_{\ell^{\prime}}^{\star}}</annotation></semantics></math>. Therefore,</span></p>
<table id="A1.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex367"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
