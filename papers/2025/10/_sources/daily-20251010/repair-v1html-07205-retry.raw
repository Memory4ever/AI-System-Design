\begin{aligned} &amp;\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},2}(t)\gamma_{i,j}^{(2)}(t)-\hat{\lambda}_{i_{\ell}^{\star},j_{\ell}^{\star},1}(t)\gamma_{i_{\ell}^{\star},j_{\ell}^{\star}}^{(1)}(t)\zeta_{i,j}^{(1)}(t)\\
