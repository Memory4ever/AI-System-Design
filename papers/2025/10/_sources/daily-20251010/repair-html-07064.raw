<td id="S3.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m6" class="ltx_Math" alttext="\mathcal{O}\!\big(M\cdot|\mathcal{H}|\cdot(|\mathcal{T}|\cdot|\mathcal{H}|)^{K}\big)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>K</mi></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\big(M\cdot|\mathcal{H}|\cdot(|\mathcal{T}|\cdot|\mathcal{H}|)^{K}\big)</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.1.6" class="ltx_tr">
