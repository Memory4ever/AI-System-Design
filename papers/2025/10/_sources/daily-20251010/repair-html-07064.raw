<td id="A3.T5.2.2.2" class="ltx_td ltx_align_center ltx_border_t">0.71</td></tr>
<tr id="A3.T5.2.3" class="ltx_tr">
<th id="A3.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A3.T5.2.3.1.1" class="ltx_text ltx_font_smallcaps">Random</span></th>
<td id="A3.T5.2.3.2" class="ltx_td ltx_align_center">0.69</td></tr>
