<figure id="A3.F13" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A3.F13.fig1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.07064v1/legend.svg" id="A3.F13.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:466/46;" width="466" height="46"></object>
