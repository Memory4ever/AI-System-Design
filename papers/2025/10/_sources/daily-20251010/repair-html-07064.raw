<td id="S3.T1.2.1.8.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m11" class="ltx_Math" alttext="(1-1/e)\cdot(\gamma\cdot f(L^{\text{opt}})-\rho)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>e</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mtext>opt</mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1-1/e)\cdot(\gamma\cdot f(L^{\text{opt}})-\rho)</annotation></semantics></math></td>
<td id="S3.T1.2.1.8.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m12" class="ltx_Math" alttext="\mathcal{O}\!\big(K\cdot|\mathcal{H}|+M\cdot|\mathcal{H}|^{2}\big)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\big(K\cdot|\mathcal{H}|+M\cdot|\mathcal{H}|^{2}\big)</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.1.9" class="ltx_tr">
<th id="S3.T1.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m13" class="ltx_Math" alttext="\textsc{RepPop}_{\text{mapped-2}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_font_smallcaps">RepPop</mtext><mtext>mapped-2</mtext></msub><annotation encoding="application/x-tex">\textsc{RepPop}_{\text{mapped-2}}</annotation></semantics></math> (ours)</th>
<td id="S3.T1.2.1.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m14" class="ltx_Math" alttext="(1-1/e)\cdot(\gamma\cdot f(L^{\text{opt}})-\rho)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>e</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>L</mi><mtext>opt</mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1-1/e)\cdot(\gamma\cdot f(L^{\text{opt}})-\rho)</annotation></semantics></math></td>
<td id="S3.T1.2.1.9.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m15" class="ltx_Math" alttext="\mathcal{O}\!\big(K\cdot|\mathcal{T}|\cdot|\mathcal{H}|+M\cdot|\mathcal{H}|^{2}\big)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.654em;" width="0.654em"><mi class="ltx_font_mathcaligraphic">𝒪</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>K</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}\!\big(K\cdot|\mathcal{T}|\cdot|\mathcal{H}|+M\cdot|\mathcal{H}|^{2}\big)</annotation></semantics></math></td></tr>
