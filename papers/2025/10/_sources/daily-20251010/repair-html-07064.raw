<td id="A3.T5.2.6.2" class="ltx_td ltx_align_center"><span id="A3.T5.2.6.2.1" class="ltx_text ltx_font_bold">0.62</span></td></tr>
<tr id="A3.T5.2.7" class="ltx_tr">
