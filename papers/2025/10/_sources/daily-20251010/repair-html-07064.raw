<th id="S3.T1.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T1.m8" class="ltx_Math" alttext="\textsc{RepPop}_{\text{demo}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_font_smallcaps">RepPop</mtext><mtext>demo</mtext></msub><annotation encoding="application/x-tex">\textsc{RepPop}_{\text{demo}}</annotation></semantics></math> (ours)</th>
