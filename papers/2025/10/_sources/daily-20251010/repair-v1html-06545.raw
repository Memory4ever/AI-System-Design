tex">\frac{1}{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 55.6)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic1.m14" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{1}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{1}{4}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 210.06 16.23)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic1.m15" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 -23.14)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic1.m16" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{3}{4}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 -62.51)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F2.pic1.m17" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{3}{4}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>The fixed point of iterated <math id="S4.F2.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-coherence achieved after <math id="S4.F2.m4" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math> iterations.</figcaption>
</figure>
<div id="Thmexample2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample2.2" class="ltx_text ltx_font_bold">Example 2</span></span><span id="Thmexample2.3" class="ltx_text ltx_font_bold"> </span>(Boltzmann-coherent mountain race)<span id="Thmexample2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmexample2.p1" class="ltx_para">
<p id="Thmexample2.p1.1" class="ltx_p"><span id="Thmexample2.p1.1.1" class="ltx_text ltx_font_italic">We revisit the <a href="#Thmexample1" title="Example 1 (Mountain race). ‣ 1 INTRODUCTION" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Example</span> <span class="ltx_text ltx_ref_tag">1</span></a>. We might compute the Boltzmann-coherent policy for <math id="Thmexample2.p1.m1" class="ltx_Math" alttext="\delta=" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\delta=</annotation></semantics></math> by iterating the <math id="Thmexample2.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-coherence from <a href="#S4.Thmtheorem9" title="Definition 4.9 (Iterated 𝑓-coherence). ‣ 4.1 Incoherence ‣ 4 THE THEORY OF INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">4.9</span></a>. After <math id="Thmexample2.p1.m3" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math> iterations, we arrive at the fixpoint in <a href="#S4.F2" title="In 4.1 Incoherence ‣ 4 THE THEORY OF INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2</span></a>.</span></p>
</div>
</div>
<div id="S4.Thmtheorem12" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem12.2" class="ltx_text ltx_font_bold">Definition 4.12</span></span><span id="S4.Thmtheorem12.3" class="ltx_text ltx_font_bold"> </span>(Boltzmann incoherence)<span id="S4.Thmtheorem12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem12.p1" class="ltx_para">
<p id="S4.Thmtheorem12.p1.1" class="ltx_p">Given a policy <math id="S4.Thmtheorem12.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and a parameter <math id="S4.Thmtheorem12.p1.m2" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, denoting <math id="S4.Thmtheorem12.p1.m3" class="ltx_Math" alttext="g(x)=\exp(x/\delta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g(x)=\exp(x/\delta)</annotation></semantics></math>, we define the Boltzmann incoherence (or simply <em id="S4.Thmtheorem12.p1.1.1" class="ltx_emph ltx_font_italic">incoherence</em>) as <math id="S4.Thmtheorem12.p1.m4" class="ltx_Math" alttext="\kappa_{\delta}(\pi)=\kappa_{g}(\pi)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>κ</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>κ</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa_{\delta}(\pi)=\kappa_{g}(\pi)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.SS1.p12" class="ltx_para ltx_noindent">
<p id="S4.SS1.p12.1" class="ltx_p">Unrolling the definition, we have <math id="S4.SS1.p12.m1" class="ltx_math_unparsed" alttext="\kappa_{\delta}(\pi)=\text{KL}(\pi(a|s)||\pi^{\delta}(a|s))" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mi>δ</mi></msub><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mtext>KL</mtext><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>π</mi><mi>δ</mi></msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{\delta}(\pi)=\text{KL}(\pi(a|s)||\pi^{\delta}(a|s))</annotation></semantics></math>.
In other words, a policy <math id="S4.SS1.p12.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is Boltzmann-coherent with parameter <math id="S4.SS1.p12.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>, if it is coherent with respect to its <math id="S4.SS1.p12.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-soft Q policy for <math id="S4.SS1.p12.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, i.e. softmax with the parameter <math id="S4.SS1.p12.m6" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem13" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem13.2" class="ltx_text ltx_font_bold">Proposition 4.13</span></span><span id="S4.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem13.p1" class="ltx_para ltx_noindent">
<p id="S4.Thmtheorem13.p1.1" class="ltx_p"><span id="S4.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">Given any prior <math id="S4.Thmtheorem13.p1.m1" class="ltx_Math" alttext="\pi(a|s)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a|s)</annotation></semantics></math>, there exists a policy <math id="S4.Thmtheorem13.p1.m2" class="ltx_Math" alttext="\pi^{*}(a|s)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}(a|s)</annotation></semantics></math> such that we have convergence in distribution:</span></p>
<table id="S4.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex19.m1" class="ltx_Math" alttext="\lim_{\delta\to 0}\pi^{\delta}\to\pi^{*}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><msup><mi>π</mi><mi>δ</mi></msup></mrow><mo stretchy="false">→</mo><msup><mi>π</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\lim_{\delta\to 0}\pi^{\delta}\to\pi^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem13.p1.2" class="ltx_p"><span id="S4.Thmtheorem13.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem13.p1.m3" class="ltx_Math" alttext="\pi^{\delta}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi>δ</mi></msup><annotation encoding="application/x-tex">\pi^{\delta}</annotation></semantics></math> is defined with respect to the soft Q function induced by the prior <math id="S4.Thmtheorem13.p1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>. Moreover, the policy <math id="S4.Thmtheorem13.p1.m5" class="ltx_Math" alttext="\pi^{*}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\pi^{*}</annotation></semantics></math> can be explicitly characterised as the uniform distribution over <math id="S4.Thmtheorem13.p1.m6" class="ltx_Math" alttext="A^{*}:=\{a^{*}\in A:Q^{\pi}(s,a^{*})=\max_{a\in A}Q^{\pi}(s,a)\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mo>∗</mo></msup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mi>a</mi><mo>∗</mo></msup><mo>∈</mo><mi>A</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>Q</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>a</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>a</mi><mo>∈</mo><mi>A</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msup><mi>Q</mi><mi>π</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A^{*}:=\{a^{*}\in A:Q^{\pi}(s,a^{*})=\max_{a\in A}Q^{\pi}(s,a)\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.p13" class="ltx_para ltx_noindent">
<p id="S4.SS1.p13.1" class="ltx_p">We can now tie together the notions of <em id="S4.SS1.p13.1.1" class="ltx_emph ltx_font_italic">coherence</em> and <em id="S4.SS1.p13.1.2" class="ltx_emph ltx_font_italic">optimality</em>.</p>
</div>
<div id="S4.Thmtheorem14" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem14.2" class="ltx_text ltx_font_bold">Corollary 4.14</span></span><span id="S4.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem14.p1" class="ltx_para">
<p id="S4.Thmtheorem14.p1.1" class="ltx_p"><span id="S4.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">If the prior <math id="S4.Thmtheorem14.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is an optimal policy for the Markov chain, then limiting policy <math id="S4.Thmtheorem14.p1.m2" class="ltx_Math" alttext="\pi^{*}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\pi^{*}</annotation></semantics></math> from <a href="#S4.Thmtheorem13" title="Proposition 4.13. ‣ 4.1 Incoherence ‣ 4 THE THEORY OF INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.13</span></a> is also optimal, which is not necessarily true for non-optimal priors.</span></p>
</div>
</div>
<div id="S4.SS1.p14" class="ltx_para ltx_noindent">
<p id="S4.SS1.p14.1" class="ltx_p">What about other policies? We can still use the limiting distance to the Boltzmann-rational policies to determine the optimality.</p>
</div>
<div id="S4.Thmtheorem15" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem15.2" class="ltx_text ltx_font_bold">Corollary 4.15</span></span><span id="S4.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem15.p1" class="ltx_para ltx_noindent">
<p id="S4.Thmtheorem15.p1.1" class="ltx_p"><span id="S4.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">A necessary condition for policy <math id="S4.Thmtheorem15.p1.m1" class="ltx_Math" alttext="\pi(a|s)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a|s)</annotation></semantics></math> to be optimal is that:</span></p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\lim_{\delta\to 0}\kappa_{\delta}(\pi)&lt;\infty" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><msub><mi>κ</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lim_{\delta\to 0}\kappa_{\delta}(\pi)&lt;\infty</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.p15" class="ltx_para ltx_noindent">
<p id="S4.SS1.p15.1" class="ltx_p">We note that the above <a href="#S4.Thmtheorem15" title="Corollary 4.15. ‣ 4.1 Incoherence ‣ 4 THE THEORY OF INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">4.15</span></a> does not extend to a sufficient condition. To see this, it is enough to consider a case of <math id="S4.SS1.p15.m1" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math> MDP, such as e.g. <a href="#Thmexample3" title="Example 3. ‣ 5.1 Equivalence and corollaries ‣ 5 REMOVING INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Example</span> <span class="ltx_text ltx_ref_tag">3</span></a>. If the prior <math id="S4.SS1.p15.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> puts zero weight on the action <math id="S4.SS1.p15.m3" class="ltx_Math" alttext="\nearrow" display="inline" intent=":literal"><semantics><mo>↗</mo><annotation encoding="application/x-tex">\nearrow</annotation></semantics></math> in the state <math id="S4.SS1.p15.m4" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math>. Then, even though in state 
<span id="S4.SS1.p15.1.1" class="ltx_inline-block ltx_markedasmath ltx_transformed_outer" style="width:0.0pt;height:10.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,-1.7pt) scale(1.5,1.5) ;">
<span id="S4.SS1.p15.1.1.1" class="ltx_p"><span id="S4.SS1.p15.1.1.1.1" class="ltx_text"><img src="" id="S4.SS1.p15.m5.g1" class="ltx_graphics ltx_missing ltx_missing_image" alt="[Uncaptioned image]"></span></span>
</span></span>, <math id="S4.SS1.p15.m6" class="ltx_Math" alttext="Q^{\pi}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>π</mi></msup><annotation encoding="application/x-tex">Q^{\pi}</annotation></semantics></math> is independent of <math id="S4.SS1.p15.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> and therefore being <math id="S4.SS1.p15.m8" class="ltx_Math" alttext="Q^{\pi}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>Q</mi><mi>t</mi><mi>π</mi></msubsup><annotation encoding="application/x-tex">Q^{\pi}_{t}</annotation></semantics></math>-greedy is equivalent to optimality, it does not extend to <math id="S4.SS1.p15.m9" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p16" class="ltx_para ltx_noindent">
<p id="S4.SS1.p16.1" class="ltx_p">We also note that the Boltzmann coherence is a combination of being soft-conditioned and coherent. In the case of MDPs with time horizon <math id="S4.SS1.p16.m1" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math>, the coherence requirement disappears, and the condition comes down to simply optimising a reinforcement learning problem with a KL penalty. We follow <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib20" title="" class="ltx_ref">Korbak et al., (2022)</a></cite> in stating the following.</p>
</div>
<div id="S4.Thmtheorem16" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem16.2" class="ltx_text ltx_font_bold">Proposition 4.16</span></span><span id="S4.Thmtheorem16.3" class="ltx_text ltx_font_bold"> </span>(RL with KL penalties)<span id="S4.Thmtheorem16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem16.p1" class="ltx_para ltx_noindent">
<p id="S4.Thmtheorem16.p1.1" class="ltx_p"><span id="S4.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">Given an MDP with time horizon <math id="S4.Thmtheorem16.p1.m1" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math>, a reward <math id="S4.Thmtheorem16.p1.m2" class="ltx_Math" alttext="r(s,a)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s,a)</annotation></semantics></math> and a prior <math id="S4.Thmtheorem16.p1.m3" class="ltx_Math" alttext="p(a|s)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a|s)</annotation></semantics></math>, the Boltzmann-coherent policy <math id="S4.Thmtheorem16.p1.m4" class="ltx_Math" alttext="\pi(a|s)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a|s)</annotation></semantics></math> can be derived by maximising the KL-regularised return <math id="S4.Thmtheorem16.p1.m5" class="ltx_math_unparsed" alttext="J(\pi)=\mathbb{E}\left[{r(s,a)}\right]-\text{KL}(\pi(a|s)||p(a|s))" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mtext class="ltx_mathvariant_italic">KL</mtext><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\pi)=\mathbb{E}\left[{r(s,a)}\right]-\text{KL}(\pi(a|s)||p(a|s))</annotation></semantics></math>. The resulting policy is of a form:</span></p>
<table id="S4.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex21.m1" class="ltx_Math" alttext="\pi^{*}(a|s)\ \propto\ p(a|s)\exp(r(s,a))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.778em">∝</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}(a|s)\ \propto\ p(a|s)\exp(r(s,a))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>REMOVING INCOHERENCE</h2>

<div id="S5.p1" class="ltx_para ltx_noindent">
<p id="S5.p1.1" class="ltx_p">Having established the notions of incoherence, we now turn to the topic of removing it through the process of fine-tuning policies on their own actions. We first establish the notion of goal-conditioning a prior over actions.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Goal conditioning)<span id="S5.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p">Given transition dynamics <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\tau(s_{t+1}|a_{t},s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(s_{t+1}|a_{t},s_{t})</annotation></semantics></math>, a prior <math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math> and a non-positive reward <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="r(s,a)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s,a)</annotation></semantics></math>, we say that a policy <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is <em id="S5.Thmtheorem1.p1.1.1" class="ltx_emph ltx_font_italic">given by goal conditioning</em>, if we have that:</p>
<table id="S5.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex22.m1" class="ltx_math_unparsed" alttext="\pi(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}_{t:T}=1)" display="block" intent=":literal"><semantics><mrow><mi>π</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}_{t:T}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem1.p1.2" class="ltx_p">where the right-hand side is defined through the joint distribution of <math id="S5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="(\tau,p)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau,p)</annotation></semantics></math> and the auxiliary <em id="S5.Thmtheorem1.p1.2.1" class="ltx_emph ltx_font_italic">optimality variable</em> <math id="S5.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\mathcal{O}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{t}</annotation></semantics></math> has a Bernoulli distribution of:</p>
<table id="S5.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex23.m1" class="ltx_Math" alttext="p(\mathcal{O}_{t}=1|s_{t},a_{t})=e^{r(s_{t},a_{t})}" display="block" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>t</mi></msub><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">p(\mathcal{O}_{t}=1|s_{t},a_{t})=e^{r(s_{t},a_{t})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.p2" class="ltx_para ltx_noindent">
<p id="S5.p2.1" class="ltx_p">Simply conditioning on the optimality does not guarantee coherence.</p>
</div>
<div id="S5.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition 5.2</span></span><span id="S5.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem2.p1" class="ltx_para">
<p id="S5.Thmtheorem2.p1.1" class="ltx_p"><span id="S5.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">A policy given by goal conditioning is not necessarily coherent for any choice of <math id="S5.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.p3" class="ltx_para ltx_noindent">
<p id="S5.p3.1" class="ltx_p">Indeed, the counterexample is given by <a href="#Thmexample1" title="Example 1 (Mountain race). ‣ 1 INTRODUCTION" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Example</span> <span class="ltx_text ltx_ref_tag">1</span></a>. However, we might hope to fix this by iterating the goal conditioning, that is, retraining a policy on its own actions. To formalise this process, we give the following definition.</p>
</div>
<div id="S5.Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition 5.3</span></span><span id="S5.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Control-as-inference)<span id="S5.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem3.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem3.p1.1" class="ltx_p">We define the control-as-inference operator <math id="S5.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> on the space of probability distributions <math id="S5.Thmtheorem3.p1.m2" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math> as</p>
<table id="S5.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex24.m1" class="ltx_math_unparsed" alttext="\mathcal{G}(p)=p(a_{t}|s_{t},\mathcal{O}_{t:T}=1)" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}(p)=p(a_{t}|s_{t},\mathcal{O}_{t:T}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem3.p1.2" class="ltx_p">where the left-hand side is given jointly by <math id="S5.Thmtheorem3.p1.m3" class="ltx_Math" alttext="p,\tau,\mathcal{O}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><mi>τ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi></mrow><annotation encoding="application/x-tex">p,\tau,\mathcal{O}</annotation></semantics></math>. This gives a sequence of policies <math id="S5.Thmtheorem3.p1.m4" class="ltx_Math" alttext="\pi^{\mathcal{G}}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathcal{G}}_{i}</annotation></semantics></math> defined recursively as:</p>
<table id="S5.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex25.m1" class="ltx_Math" alttext="\displaystyle\pi^{\mathcal{G}}_{0}(a_{t}|s_{t})=p(a_{t}|s_{t})\qquad\pi^{\mathcal{G}}_{k+1}=\mathcal{G}(\pi^{\mathcal{G}}_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>π</mi><mn>0</mn><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><msubsup><mi>π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi^{\mathcal{G}}_{0}(a_{t}|s_{t})=p(a_{t}|s_{t})\qquad\pi^{\mathcal{G}}_{k+1}=\mathcal{G}(\pi^{\mathcal{G}}_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.p4" class="ltx_para ltx_noindent">
<p id="S5.p4.1" class="ltx_p">We note that this process does not condition the dynamics <math id="S5.p4.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> of the MDP. In other words, it might be thought to be implemented as iteratively changing the joint by collecting rollouts from the conditioned policy, both those successful and unsuccessful, without rejection sampling (conditioned on optimality). Even still, we have the following property:</p>
</div>
<div id="S5.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Proposition 5.4</span></span><span id="S5.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Strong return improvement lemma)<span id="S5.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem4.p1.1" class="ltx_p"><span id="S5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">The sequence of policies <math id="S5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="(\pi^{\mathcal{G}}_{i})_{i=0,1,\dots}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow></msub><annotation encoding="application/x-tex">(\pi^{\mathcal{G}}_{i})_{i=0,1,\dots}</annotation></semantics></math> given by the control-by-inference improves its return monotonically, that is:</span></p>
<table id="S5.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex26.m1" class="ltx_Math" alttext="J(\pi^{\mathcal{G}}_{i+1})\geq J(\pi^{\mathcal{G}}_{i})" display="block" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">J(\pi^{\mathcal{G}}_{i+1})\geq J(\pi^{\mathcal{G}}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.p5" class="ltx_para ltx_noindent">
<p id="S5.p5.1" class="ltx_p">The fact that the policies monotonically improve gives a reason to suspect that the limiting policy (which exists by a compactness argument) will be an optimal policy for the reward <math id="S5.p5.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. Indeed, we can show the following.</p>
</div>
<div id="S5.Thmtheorem5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem5.2" class="ltx_text ltx_font_bold">Proposition 5.5</span></span><span id="S5.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Douglas et al.,, 2024</a>, Theorem 3.6)</cite>)<span id="S5.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem5.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem5.p1.1" class="ltx_p"><span id="S5.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">There exists some policy <math id="S5.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\pi^{\mathcal{G}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msup><annotation encoding="application/x-tex">\pi^{\mathcal{G}}</annotation></semantics></math> that the sequence <math id="S5.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\pi^{\mathcal{G}}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathcal{G}}_{i}</annotation></semantics></math> converges to. That is, we have:</span></p>
<table id="S5.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex27.m1" class="ltx_math_unparsed" alttext="\lim_{i\to\infty}\text{KL}(\pi^{\mathcal{G}}_{i}||\pi^{\mathcal{G}})=0" display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mtext class="ltx_mathvariant_italic">KL</mtext><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>π</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{i\to\infty}\text{KL}(\pi^{\mathcal{G}}_{i}||\pi^{\mathcal{G}})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem5.p1.2" class="ltx_p"><span id="S5.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">Moreover, if the prior <math id="S5.Thmtheorem5.p1.m3" class="ltx_Math" alttext="p(a|s)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a|s)</annotation></semantics></math> has full support over all actions <math id="S5.Thmtheorem5.p1.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> in all states <math id="S5.Thmtheorem5.p1.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, then <math id="S5.Thmtheorem5.p1.m6" class="ltx_Math" alttext="\pi^{\mathcal{G}}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msup><annotation encoding="application/x-tex">\pi^{\mathcal{G}}</annotation></semantics></math> is optimal.</span></p>
</div>
</div>
<div id="S5.p6" class="ltx_para ltx_noindent">
<p id="S5.p6.1" class="ltx_p">This property is a consequence of the equivalence we develop in <a href="#S5.SS1" title="5.1 Equivalence and corollaries ‣ 5 REMOVING INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>; a direct proof can be found in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Douglas et al.,, 2024</a>, Appendix A)</cite>.</p>
</div>
<div id="S5.p7" class="ltx_para ltx_noindent">
<p id="S5.p7.1" class="ltx_p">Another formulation of the sequence of increasingly improving policies is given by increasing the temperature of the energy distribution of the optimality variable <math id="S5.p7.m1" class="ltx_Math" alttext="\mathcal{O}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒪</mi><annotation encoding="application/x-tex">\mathcal{O}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmtheorem6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem6.2" class="ltx_text ltx_font_bold">Definition 5.6</span></span><span id="S5.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(RL with temperature)<span id="S5.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem6.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem6.p1.1" class="ltx_p">Given a prior <math id="S5.Thmtheorem6.p1.m1" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math>, a reward <math id="S5.Thmtheorem6.p1.m2" class="ltx_Math" alttext="r(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s_{t},a_{t})</annotation></semantics></math> and a <em id="S5.Thmtheorem6.p1.1.1" class="ltx_emph ltx_font_italic">inverse temperature</em> function <math id="S5.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\alpha:\mathbb{N}\to\mathbb{R}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℕ</mi><mo stretchy="false">→</mo><msub><mi>ℝ</mi><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha:\mathbb{N}\to\mathbb{R}_{+}</annotation></semantics></math>, we define a sequence of policies:</p>
<table id="S5.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex28.m1" class="ltx_math_unparsed" alttext="\pi_{\alpha(k)}(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}^{\alpha(k)}_{t:T}=1)" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\alpha(k)}(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}^{\alpha(k)}_{t:T}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem6.p1.2" class="ltx_p">where:</p>
<table id="S5.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex29.m1" class="ltx_Math" alttext="p(\mathcal{O}^{\alpha(k)}_{t}|s_{t},a_{t})=\exp\left({\alpha(k)\cdot{r(s_{t},a_{t})}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>t</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p(\mathcal{O}^{\alpha(k)}_{t}|s_{t},a_{t})=\exp\left({\alpha(k)\cdot{r(s_{t},a_{t})}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.p8" class="ltx_para ltx_noindent">
<p id="S5.p8.1" class="ltx_p">We note that the process of increasing temperature in this way behaves differently from what taking <math id="S5.p8.m1" class="ltx_Math" alttext="\delta\to 0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta\to 0</annotation></semantics></math> in we explored in the last section’s  <a href="#S4.Thmtheorem12" title="Definition 4.12 (Boltzmann incoherence). ‣ 4.1 Incoherence ‣ 4 THE THEORY OF INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">4.12</span></a>. There, we took a fixed <math id="S5.p8.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> function defined by a particular policy <math id="S5.p8.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, and applied softmax. Here, the policy itself is changing, so earlier see progressively more precise <math id="S5.p8.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> functions of a form <math id="S5.p8.m5" class="ltx_Math" alttext="Q^{\pi_{\alpha(k)}}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><msub><mi>π</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub></msup><annotation encoding="application/x-tex">Q^{\pi_{\alpha(k)}}</annotation></semantics></math>, as inverse temperature <math id="S5.p8.m6" class="ltx_Math" alttext="\alpha(k)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(k)</annotation></semantics></math> increases.</p>
</div>
<div id="S5.p9" class="ltx_para ltx_noindent">
<p id="S5.p9.1" class="ltx_p">Finally, we talk about folding the posterior into the reward. <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib23" title="" class="ltx_ref">Levine, (2018)</a></cite> discusses a trick for folding <em id="S5.p9.1.1" class="ltx_emph ltx_font_italic">the prior</em> in into the reward. If soft <math id="S5.p9.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and <math id="S5.p9.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> functions are computed as in <a href="#S4.Thmtheorem1" title="Definition 4.1 (Soft 𝑄 and 𝑉 functions). ‣ 4 THE THEORY OF INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>, one can disregard a prior over actions <math id="S5.p9.m3" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math> by modifying the reward function <math id="S5.p9.m4" class="ltx_Math" alttext="r(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s_{t},a_{t})</annotation></semantics></math> (specifying the Bernoulli distribution of <math id="S5.p9.m5" class="ltx_Math" alttext="\mathcal{O}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{t}</annotation></semantics></math>) to be:</p>
<table id="S5.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex30.m1" class="ltx_Math" alttext="\hat{r}(s_{t},a_{t})=r(s_{t},a_{t})+\log p(a_{t}|s_{t})" display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>r</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{r}(s_{t},a_{t})=r(s_{t},a_{t})+\log p(a_{t}|s_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p9.2" class="ltx_p">This defines an equivalent probabilistic model in which the prior <math id="S5.p9.m6" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math> is uniform over actions, simplifying the calculations. Our point of interest lies in the fact that the coherent definition of the soft <math id="S5.p9.m7" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> function uses <em id="S5.p9.2.1" class="ltx_emph ltx_font_italic">the posterior</em> instead of prior:</p>
<table id="S5.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex31.m1" class="ltx_Math" alttext="V^{\pi}(s_{t})=\log\mathbb{E}_{a_{t}\sim\pi}[\exp Q^{\pi}(a_{t},s_{t})]" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>V</mi><mi>π</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∼</mo><mi>π</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><msup><mi>Q</mi><mi>π</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V^{\pi}(s_{t})=\log\mathbb{E}_{a_{t}\sim\pi}[\exp Q^{\pi}(a_{t},s_{t})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p9.3" class="ltx_p">as we discussed in the introduction, pointing to the difference between Questions (1) and (2).</p>
</div>
<div id="S5.p10" class="ltx_para ltx_noindent">
<p id="S5.p10.1" class="ltx_p">Because the expectation is over the policy <math id="S5.p10.m1" class="ltx_math_unparsed" alttext="\pi(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}_{t:T})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}_{t:T})</annotation></semantics></math> and <em id="S5.p10.1.1" class="ltx_emph ltx_font_italic">not</em> the prior <math id="S5.p10.m2" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math>, it is no longer that simple to fold it into the reward. Since the reward (and therefore, the distributions of <math id="S5.p10.m3" class="ltx_Math" alttext="\mathcal{O}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{O}_{t}</annotation></semantics></math>’s) changed, it has a downstream effect of changing the posterior. Thus, iterative process is needed.</p>
</div>
<div id="S5.Thmtheorem7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem7.2" class="ltx_text ltx_font_bold">Definition 5.7</span></span><span id="S5.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Folded sequence)<span id="S5.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem7.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem7.p1.1" class="ltx_p">For a prior <math id="S5.Thmtheorem7.p1.m1" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math> and a reward <math id="S5.Thmtheorem7.p1.m2" class="ltx_Math" alttext="r(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s_{t},a_{t})</annotation></semantics></math> we define a sequence of policies <math id="S5.Thmtheorem7.p1.m3" class="ltx_Math" alttext="\pi^{\mathcal{F}}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathcal{F}}_{k}</annotation></semantics></math> and rewards <math id="S5.Thmtheorem7.p1.m4" class="ltx_Math" alttext="r_{k}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>k</mi></msub><annotation encoding="application/x-tex">r_{k}</annotation></semantics></math> recursively, to be</p>
<table id="S5.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex32.m1" class="ltx_Math" alttext="r_{0}=r\qquad\pi^{\mathcal{F}}_{0}=p" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>=</mo><mi>r</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><msubsup><mi>π</mi><mn>0</mn><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><mo>=</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">r_{0}=r\qquad\pi^{\mathcal{F}}_{0}=p</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S5.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex33.m1" class="ltx_math_unparsed" alttext="r_{k+1}(s_{t},a_{t})=r_{0}(s_{t},a_{t})+\log p(a_{t}|s_{t},\mathcal{O}^{(k)}_{t:T}=1)" display="block" intent=":literal"><semantics><mrow><msub><mi>r</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>r</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{k+1}(s_{t},a_{t})=r_{0}(s_{t},a_{t})+\log p(a_{t}|s_{t},\mathcal{O}^{(k)}_{t:T}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S5.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex34.m1" class="ltx_math_unparsed" alttext="\pi^{\mathcal{F}}_{k+1}(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}^{(k)}_{t:T}=1)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\mathcal{F}}_{k+1}(a_{t}|s_{t})=p(a_{t}|s_{t},\mathcal{O}^{(k)}_{t:T}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S5.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex35.m1" class="ltx_Math" alttext="p(\mathcal{O}^{(k)}_{t}=1|a_{t},s_{t})=\exp\left(r_{k}(a_{t},s_{t})\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>r</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p(\mathcal{O}^{(k)}_{t}=1|a_{t},s_{t})=\exp\left(r_{k}(a_{t},s_{t})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.p11" class="ltx_para ltx_noindent">
<p id="S5.p11.1" class="ltx_p">It turns out that this iterative process is an equivalent way of formulating the re-training the model on its own output. We can also fold the reward recursively into the previous reward:</p>
</div>
<div id="S5.Thmtheorem8" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem8.2" class="ltx_text ltx_font_bold">Definition 5.8</span></span><span id="S5.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Folded sequence, cumulative)<span id="S5.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem8.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem8.p1.1" class="ltx_p">For a prior <math id="S5.Thmtheorem8.p1.m1" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math> and a reward <math id="S5.Thmtheorem8.p1.m2" class="ltx_Math" alttext="r(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s_{t},a_{t})</annotation></semantics></math> we define a sequence of policies <math id="S5.Thmtheorem8.p1.m3" class="ltx_Math" alttext="\pi^{\mathcal{H}}_{k}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathcal{H}}_{k}</annotation></semantics></math>, the optimality variables <math id="S5.Thmtheorem8.p1.m4" class="ltx_Math" alttext="\mathcal{O}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒪</mi><annotation encoding="application/x-tex">\mathcal{O}</annotation></semantics></math> as in <a href="#S5.Thmtheorem7" title="Definition 5.7 (Folded sequence). ‣ 5 REMOVING INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">5.7</span></a>, with the only change being <math id="S5.Thmtheorem8.p1.m5" class="ltx_Math" alttext="r_{k+1}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">r_{k+1}</annotation></semantics></math>:</p>
<table id="S5.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex36.m1" class="ltx_math_unparsed" alttext="r_{k+1}(s_{t},a_{t})=r_{k}(s_{t},a_{t})+\log p(a_{t}|s_{t},\mathcal{O}^{(k)}_{t:T}=1)" display="block" intent=":literal"><semantics><mrow><msub><mi>r</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>r</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{k+1}(s_{t},a_{t})=r_{k}(s_{t},a_{t})+\log p(a_{t}|s_{t},\mathcal{O}^{(k)}_{t:T}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.p12" class="ltx_para ltx_noindent">
<p id="S5.p12.1" class="ltx_p">This version is, however, is only equivalent to the other modes of retraining under the assumption of deterministic transition dynamics <math id="S5.p12.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, as we prove in the next <a href="#S5.SS1" title="5.1 Equivalence and corollaries ‣ 5 REMOVING INCOHERENCE" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">5.1</span></a>.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1 </span>Equivalence and corollaries</h3>

<div id="S5.SS1.p1" class="ltx_para ltx_noindent">
<p id="S5.SS1.p1.1" class="ltx_p">After introducing the three ways of constructing a sequence of policies: fine-tuning policies on their own actions, folding the posterior into the reward, and conditioning on the reward with an increased temperature, we are now able to connect those dynamics. In case of deterministic dynamics, all three coincide, giving the same policy trajectories. In case of stochastic dynamics, it is only true for the first two.</p>
</div>
<div id="S5.Thmtheorem9" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem9.2" class="ltx_text ltx_font_bold">Theorem 5.9</span></span><span id="S5.Thmtheorem9.3" class="ltx_text ltx_font_bold"> </span>(Optimisation pressure, thrice)<span id="S5.Thmtheorem9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem9.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem9.p1.1" class="ltx_p"><span id="S5.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">For all priors <math id="S5.Thmtheorem9.p1.m1" class="ltx_Math" alttext="p(a|s)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a|s)</annotation></semantics></math>, all non-positive reward functions <math id="S5.Thmtheorem9.p1.m2" class="ltx_Math" alttext="r(s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(s_{t},a_{t})</annotation></semantics></math> and deterministic transition dynamics <math id="S5.Thmtheorem9.p1.m3" class="ltx_Math" alttext="\tau(s_{t+1}|s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(s_{t+1}|s_{t},a_{t})</annotation></semantics></math>, for all <math id="S5.Thmtheorem9.p1.m4" class="ltx_Math" alttext="k\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">k\in\mathbb{N}_{+}</annotation></semantics></math> and for <math id="S5.Thmtheorem9.p1.m5" class="ltx_Math" alttext="\alpha(k)=2^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\alpha(k)=2^{k}</annotation></semantics></math>, we have:</span></p>
<table id="S5.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex37.m1" class="ltx_Math" alttext="\pi_{\alpha(k)}=\pi^{\mathcal{G}}_{2^{k}}=\pi^{\mathcal{F}}_{2^{k}}=\pi^{\mathcal{H}}_{k}" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msubsup><mi>π</mi><msup><mn>2</mn><mi>k</mi></msup><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo>=</mo><msubsup><mi>π</mi><msup><mn>2</mn><mi>k</mi></msup><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><mo>=</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi></msubsup></mrow><annotation encoding="application/x-tex">\pi_{\alpha(k)}=\pi^{\mathcal{G}}_{2^{k}}=\pi^{\mathcal{F}}_{2^{k}}=\pi^{\mathcal{H}}_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem9.p1.2" class="ltx_p"><span id="S5.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">Additionally, for stochastic transition dynamics we have:</span></p>
<table id="S5.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex38.m1" class="ltx_Math" alttext="\pi^{\mathcal{F}}_{k}=\pi^{\mathcal{G}}_{k}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><mo>=</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup></mrow><annotation encoding="application/x-tex">\pi^{\mathcal{F}}_{k}=\pi^{\mathcal{G}}_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmexample3" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmexample3.2" class="ltx_text ltx_font_bold">Example 3</span></span><span id="Thmexample3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmexample3.p1" class="ltx_para ltx_noindent">
<p id="Thmexample3.p1.1" class="ltx_p"><span id="Thmexample3.p1.1.1" class="ltx_text ltx_font_italic">Transition dynamics such that <math id="Thmexample3.p1.m1" class="ltx_Math" alttext="\pi_{\alpha(k)}\neq\pi^{\mathcal{F}}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≠</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup></mrow><annotation encoding="application/x-tex">\pi_{\alpha(k)}\neq\pi^{\mathcal{F}}_{k}</annotation></semantics></math> are simple to construct. For example, take a three-state, two action Markov decision process with initial state <math id="Thmexample3.p1.m2" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math> and a uniform prior policy, with transition dynamics depicted on the diagram below:</span></p>
<table id="S5.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex39.m1.pic1" class="ltx_picture ltx_markedasmath" height="51.26" overflow="visible" style="vertical-align:-22.24px" version="1.1" viewBox="0 0 179.48 51.26" width="179.48"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,51.26) matrix(1 0 0 -1 0 0) translate(89.74,0) translate(0,26.39)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -89.74 -4.15)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 22.58)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(19.56,0) matrix(1.0 0.0 0.0 1.0 -13.6 0)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces{s_{1}}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces{s_{1}}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 39.12 0) translate(50.62,0) matrix(1.0 0.0 0.0 1.0 -10.72 0)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.06em;font-size:10pt;" height="11.15" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\emptyset}" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\emptyset}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 106.42 0) translate(53.51,0) matrix(1.0 0.0 0.0 1.0 -13.6 0)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces{s_{2}}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces{s_{2}}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-stroke-color:#D65C5C;--ltx-fill-color:#D65C5C;--ltx-fg-color:#D65C5C;" color="#D65C5C" fill="#D65C5C" stroke="#D65C5C" stroke-dasharray="2.79985pt,1.59991pt" stroke-dashoffset="0.0pt" stroke-width="0.39998pt"><path style="fill:none" d="M -16.95 10.76 C -24.56 15.91 -45.62 15.91 -58.13 7.46"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.82849 -0.56 0.56 -0.82849 -58.36 7.3)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#D65C5C;--ltx-fill-color:#D65C5C;--ltx-fg-color:#000000;" color="#000000" fill="#D65C5C" stroke="#D65C5C" transform="matrix(1.0 0.0 0.0 1.0 -48.43 17.43)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.32em;--ltx-fo-depth:0em;font-size:10pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\color[rgb]{0.8392,0.3608,0.3608}\lx@inpgf@ignorespaces\frac{3}{4}}" display="inline" intent=":literal"><semantics><mstyle scriptlevel="+1"><mfrac style="--ltx-fg-color:#D65C5C;" mathcolor="#D65C5C"><mn style="--ltx-fg-color:#D65C5C;" mathcolor="#D65C5C">3</mn><mn style="--ltx-fg-color:#D65C5C;" mathcolor="#D65C5C">4</mn></mfrac></mstyle><annotation encoding="application/x-tex">\scriptstyle{\color[rgb]{0.8392,0.3608,0.3608}\lx@inpgf@ignorespaces\frac{3}{4}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -14.15 -10.26 C -24.56 -17.3 -45.62 -17.3 -53.63 -11.88"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.8285 0.55998 -0.55998 -0.8285 -53.86 -11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -39.56 -23.41)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.32em;--ltx-fo-depth:0em;font-size:10pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\frac{1}{2}}" display="inline" intent=":literal"><semantics><mstyle scriptlevel="+1"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\frac{1}{2}}</annotation></semantics></math></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#D65C5C;--ltx-fill-color:#D65C5C;--ltx-fg-color:#D65C5C;" color="#D65C5C" fill="#D65C5C" stroke="#D65C5C" stroke-dasharray="2.79985pt,1.59991pt" stroke-dashoffset="0.0pt" stroke-width="0.39998pt"><path style="fill:none" d="M 16.95 10.76 C 24.56 15.91 45.62 15.91 58.13 7.46"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.82849 -0.56 0.56 0.82849 58.36 7.3)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#D65C5C;--ltx-fill-color:#D65C5C;--ltx-fg-color:#000000;" color="#000000" fill="#D65C5C" stroke="#D65C5C" transform="matrix(1.0 0.0 0.0 1.0 39.02 17.43)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.32em;--ltx-fo-depth:0em;font-size:10pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\color[rgb]{0.8392,0.3608,0.3608}\lx@inpgf@ignorespaces\frac{1}{4}}" display="inline" intent=":literal"><semantics><mstyle scriptlevel="+1"><mfrac style="--ltx-fg-color:#D65C5C;" mathcolor="#D65C5C"><mn style="--ltx-fg-color:#D65C5C;" mathcolor="#D65C5C">1</mn><mn style="--ltx-fg-color:#D65C5C;" mathcolor="#D65C5C">4</mn></mfrac></mstyle><annotation encoding="application/x-tex">\scriptstyle{\color[rgb]{0.8392,0.3608,0.3608}\lx@inpgf@ignorespaces\frac{1}{4}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 14.15 -10.26 C 24.56 -17.3 45.62 -17.3 53.63 -11.88"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.8285 0.55998 -0.55998 0.8285 53.86 -11.72)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 30.14 -23.41)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.32em;--ltx-fo-depth:0em;font-size:10pt;" height="4.46" overflow="visible" transform="matrix(1 0 0 -1 0 4.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex39.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\frac{1}{2}}" display="inline" intent=":literal"><semantics><mstyle scriptlevel="+1"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\frac{1}{2}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample3.p1.2" class="ltx_p"><span id="Thmexample3.p1.2.1" class="ltx_text ltx_font_italic">where red dotted lines correspond to action <math id="Thmexample3.p1.m3" class="ltx_Math" alttext="a_{1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>1</mn></msub><annotation encoding="application/x-tex">a_{1}</annotation></semantics></math>, and solid black lines to action <math id="Thmexample3.p1.m4" class="ltx_Math" alttext="a_{2}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>2</mn></msub><annotation encoding="application/x-tex">a_{2}</annotation></semantics></math>. We also assume that:</span></p>
<table id="S5.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex40.m1" class="ltx_Math" alttext="r(s_{1})=\log\frac{1}{3}\qquad r(s_{2})=\log\frac{2}{3}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">r(s_{1})=\log\frac{1}{3}\qquad r(s_{2})=\log\frac{2}{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmexample3.p1.3" class="ltx_p"><span id="Thmexample3.p1.3.1" class="ltx_text ltx_font_italic">Computing <math id="Thmexample3.p1.m5" class="ltx_math_unparsed" alttext="\pi^{\mathcal{F}}_{1}(\cdot|\emptyset)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi^{\mathcal{F}}_{1}(\cdot|\emptyset)</annotation></semantics></math> and <math id="Thmexample3.p1.m6" class="ltx_math_unparsed" alttext="\pi_{\alpha(2)}(\cdot|\emptyset)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\alpha(2)}(\cdot|\emptyset)</annotation></semantics></math> we get:</span></p>
<table id="S5.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex41.m1" class="ltx_Math" alttext="\frac{25}{61}=\pi^{\mathcal{F}}_{1}(a_{1}|\emptyset)\neq\pi_{\alpha(2)}(a_{1}|\emptyset)=\frac{7}{17}" display="block" intent=":literal"><semantics><mrow><mfrac><mn>25</mn><mn>61</mn></mfrac><mo>=</mo><mrow><msubsup><mi>π</mi><mn>1</mn><mi class="ltx_font_mathcaligraphic">ℱ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><msub><mi>π</mi><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>7</mn><mn>17</mn></mfrac></mrow><annotation encoding="application/x-tex">\frac{25}{61}=\pi^{\mathcal{F}}_{1}(a_{1}|\emptyset)\neq\pi_{\alpha(2)}(a_{1}|\emptyset)=\frac{7}{17}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS1.p2" class="ltx_para ltx_noindent">
<p id="S5.SS1.p2.1" class="ltx_p">From this equivalence, and additional properties of each of the ways of constructing the sequence, we can easily derive results that would require laborious proofs otherwise. For example, we might easily show that the policies converge to an optimal policy, and explicitly calculate the rate of convergence, using the causal entropy regularisation characterisation of <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="\pi_{\alpha}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\alpha}(k)</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmtheorem10" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem10.2" class="ltx_text ltx_font_bold">Corollary 5.10</span></span><span id="S5.Thmtheorem10.3" class="ltx_text ltx_font_bold"> </span>(Return improvement rate)<span id="S5.Thmtheorem10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem10.p1" class="ltx_para ltx_noindent">
<p id="S5.Thmtheorem10.p1.1" class="ltx_p"><span id="S5.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">In case of deterministic dynamics <math id="S5.Thmtheorem10.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, given a sequence of policies <math id="S5.Thmtheorem10.p1.m2" class="ltx_Math" alttext="\pi^{\mathcal{G}}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathcal{G}}_{i}</annotation></semantics></math>, for <math id="S5.Thmtheorem10.p1.m3" class="ltx_Math" alttext="k\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">k\in\mathbb{N}_{+}</annotation></semantics></math> have that:</span></p>
<table id="S5.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex42.m1" class="ltx_Math" alttext="J(\pi^{\mathcal{G}}_{k})-J(\pi^{\mathcal{G}}_{k-1})=\frac{1}{{k}}\cdot\frac{J^{\prime}(\pi^{\mathcal{G}}_{k})\cdot\hat{\mathcal{H}}^{\prime}(\pi^{\mathcal{G}}_{k})}{J^{\prime\prime}(\pi^{\mathcal{G}}_{k})+\frac{1}{{k}}\hat{\mathcal{H}}^{\prime\prime}(\pi^{\mathcal{G}}_{k})}+O\left(\frac{1}{{k}^{2}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>k</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mrow><mrow><msup><mi>J</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>^</mo></mover><mo>′</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><msup><mi>J</mi><mo>′′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>k</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>^</mo></mover><mo>′′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>k</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>k</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">J(\pi^{\mathcal{G}}_{k})-J(\pi^{\mathcal{G}}_{k-1})=\frac{1}{{k}}\cdot\frac{J^{\prime}(\pi^{\mathcal{G}}_{k})\cdot\hat{\mathcal{H}}^{\prime}(\pi^{\mathcal{G}}_{k})}{J^{\prime\prime}(\pi^{\mathcal{G}}_{k})+\frac{1}{{k}}\hat{\mathcal{H}}^{\prime\prime}(\pi^{\mathcal{G}}_{k})}+O\left(\frac{1}{{k}^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem10.p1.2" class="ltx_p"><span id="S5.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S5.Thmtheorem10.p1.m4" class="ltx_Math" alttext="\hat{\mathcal{H}}(\pi)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{H}}(\pi)</annotation></semantics></math> denotes the causal entropy of policy <math id="S5.Thmtheorem10.p1.m5" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, and the derivatives are taken with respect to the temperature <math id="S5.Thmtheorem10.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.p3" class="ltx_para ltx_noindent">
<p id="S5.SS1.p3.1" class="ltx_p">Incoherence disappears at the limit of retraining.</p>
</div>
<div id="S5.Thmtheorem11" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem11.2" class="ltx_text ltx_font_bold">Corollary 5.11</span></span><span id="S5.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem11.p1" class="ltx_para">
<p id="S5.Thmtheorem11.p1.1" class="ltx_p"><span id="S5.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">We have <math id="S5.Thmtheorem11.p1.m1" class="ltx_Math" alttext="\lim_{(\delta,i)\to(0,\infty)}\kappa^{\delta}(\pi^{\mathcal{G}}_{i})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><msup><mi>κ</mi><mi>δ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lim_{(\delta,i)\to(0,\infty)}\kappa^{\delta}(\pi^{\mathcal{G}}_{i})=0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.p4" class="ltx_para ltx_noindent">
<p id="S5.SS1.p4.1" class="ltx_p">The significance of the correspondence should be possible to also be understood through the lenses of training-inference trade-off. Decreasing the temperature in the information-bounded RL can be implemented as top-<math id="S5.SS1.p4.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> rejection-sampling based methods (such as Speculative Rejection <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib41" title="" class="ltx_ref">Sun et al.,, 2024</a>)</cite>). On the other hand, we might want to pay the cost of inference once, during training, by retraining the model on its own outputs. Prior work has empirically verified that aligning language models with RLHF produces a similar behavior to best-of-<math id="S5.SS1.p4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> rejection sampling with respect to the reward model <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib4" title="" class="ltx_ref">Bai et al., 2022a, </a>; <a href="#bib.bib40" title="" class="ltx_ref">Stiennon et al.,, 2022</a>)</cite>. Our results confirm those results, and allow for precise trade-off estimation in the multi-step environment, with no difference on the margin with each phase of re-training equivalent to linearly increasing <math id="S5.SS1.p4.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>DISCUSSION</h2>

<div id="S6.p1" class="ltx_para ltx_noindent">
<p id="S6.p1.1" class="ltx_p"><span id="S6.p1.1.1" class="ltx_text ltx_font_bold">Effective horizon</span> We have started the discussion in <a href="#S1" title="1 INTRODUCTION" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">1</span></a> by pointing out the difference between Questions (1) and (2), with <a href="#Thmexample1" title="Example 1 (Mountain race). ‣ 1 INTRODUCTION" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Example</span> <span class="ltx_text ltx_ref_tag">1</span></a> showing that the autoregressive policy derived by conditioning on the reward answers (1). Concurrently with the development of this work, <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib22" title="" class="ltx_ref">Laidlaw et al., (2023)</a>; <a href="#bib.bib21" title="" class="ltx_ref">Laidlaw et al., (2024)</a></cite> performed extensive experiments to find a reason for which deep RL works in some environments, but not others. They empirically arrived at the notion <em id="S6.p1.1.2" class="ltx_emph ltx_font_italic">Effective Horizon</em>: a quantitative measure of the hardness of a given environment. We quote:</p>
</div>
<div id="S6.p2" class="ltx_para ltx_noindent">
<p id="S6.p2.1" class="ltx_p"><em id="S6.p2.1.1" class="ltx_emph ltx_font_italic">When actions with the highest Q-values under the random policy also have the highest Q-values under the optimal policy (i.e. when it is optimal to be greedy on the random policy’s Q function), deep RL tends to succeed; when they don’t, deep RL tends to fail.</em></p>
</div>
<div id="S6.p3" class="ltx_para ltx_noindent">
<p id="S6.p3.1" class="ltx_p">We note the striking similarity to the setup studied here: we rephrase their finding to state that <em id="S6.p3.1.1" class="ltx_emph ltx_font_italic">deep RL tends to succeed when there is no difference between answers to Questions (1) and (2); it tends to fail otherwise.</em> This suggests that deep RL algorithms approximate naive autoregressive control-as-inference policies, which provides a theoretical justification of the Effective Horizon result. We leave the exact technical and quantitative operationalisation of this equivalence for future work.</p>
</div>
<div id="S6.p4" class="ltx_para ltx_noindent">
<p id="S6.p4.1" class="ltx_p"><span id="S6.p4.1.1" class="ltx_text ltx_font_bold">Limitations and future work</span>
We did not conduct any experiments apart from toy environments implemented in the <a href="https://github.com/jkarwowski/Incoherence-paper" title="" class="ltx_ref ltx_href">code appendix</a>, and instead relied only on the already established experimental results from the prior work. Synthetic data experiments with Decision Transformers are a natural next step; by training a model on a game such as chess and controlling the training dataset, it should be possible to verify to what extent do models such as DTs suffer from incoherence, as answers to Questions <em id="S6.p4.1.2" class="ltx_emph ltx_font_italic">(1)</em> and <em id="S6.p4.1.3" class="ltx_emph ltx_font_italic">(2)</em> can be computed exactly. On the theory side, extending our treatment to the case of infinite time horizon requires handling discount factor which is known to be more involved <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib15" title="" class="ltx_ref">Haarnoja et al.,, 2017</a>; <a href="#bib.bib23" title="" class="ltx_ref">Levine,, 2018</a>)</cite>. We did not propose any methods of regularising models towards coherence during training, without the expensive re-training procedure, for example by including an auxiliary term in the loss, which could confirm that incoherence indeed hurts performance in a non-negligible way.</p>
</div>
