tex">\frac{3}{7}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 96.36 43.77 L 139.32 54.52"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.97012 0.24261 -0.24261 0.97012 139.59 54.59)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 106.3 54.1)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 96.36 34.97 L 139.32 24.22"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.97012 -0.24261 0.24261 0.97012 139.59 24.15)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 106.3 15.72)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m11" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 96.36 -34.97 L 139.32 -24.22"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.97012 0.24261 -0.24261 0.97012 139.59 -24.15)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 102.19 -24.64)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:10pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="11.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m12" class="ltx_Math" alttext="\frac{1}{2}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{2}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 96.36 -43.77 L 139.32 -54.52"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.97012 -0.24261 0.24261 0.97012 139.59 -54.59)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 102.19 -60.34)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:10pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="11.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m13" class="ltx_Math" alttext="\frac{1}{2}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 55.6)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m14" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{1}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{1}{4}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 16.23)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m15" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{3}{4}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 -23.14)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m16" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{3}{4}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 -62.51)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F3.pic3.m17" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{3}{4}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></div></div>
<figcaption class="ltx_caption ltx_centering ltx_font_italic"><span class="ltx_tag ltx_tag_figure"><span id="A3.F3.6" class="ltx_text ltx_font_upright">Figure 3</span>: </span>The fixed point of iterated <math id="A3.F3.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-coherence achieved after <math id="A3.F3.m4" class="ltx_Math" alttext="t=2=T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>2</mn><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=2=T</annotation></semantics></math> iterations.</figcaption>
</figure>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>POLICY STABILITY</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">In search of the sufficient conditions for the autoregressive goal-conditioned policy to be optimal, one point of focus might be the question of how to <em id="A4.p1.1.1" class="ltx_emph ltx_font_italic">extend</em> trajectories: we might hope to stitch the optimal trajectory from actions that are optimal at a k-step-lookahead; optimal policies should then be those that behave consistently, in the sense that it would make the same decisions as if it were allowed to take actions looking <math id="A4.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> steps into the future. Formally, we have the following definition.</p>
</div>
<div id="A4.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition D.1</span></span><span id="A4.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Policy-stable reasoning)<span id="A4.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="A4.Thmtheorem1.p1.1" class="ltx_p">Given deterministic dynamics <math id="A4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> and a prior <math id="A4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="p(a_{t}|s_{t})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a_{t}|s_{t})</annotation></semantics></math>, we say that a policy <math id="A4.Thmtheorem1.p1.m3" class="ltx_math_unparsed" alttext="\pi(a_{t}|s_{t})\propto p(\mathcal{O}_{t:T}|s_{t},a_{t})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>∝</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(a_{t}|s_{t})\propto p(\mathcal{O}_{t:T}|s_{t},a_{t})</annotation></semantics></math> is <em id="A4.Thmtheorem1.p1.1.1" class="ltx_emph ltx_font_italic">(1-)policy-stable</em>, if for any actions <math id="A4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="a^{1}_{t},a^{1}_{t+1},a^{2}_{t},a^{2}_{t+1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mi>t</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">a^{1}_{t},a^{1}_{t+1},a^{2}_{t},a^{2}_{t+1}</annotation></semantics></math>, with <math id="A4.Thmtheorem1.p1.m5" class="ltx_math_unparsed" alttext="a^{i}_{t+1}=\arg\max_{a^{i}_{t+1}}p(\mathcal{O}_{t:T}|a^{1}_{t,t+1},s_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>=</mo><mi>arg</mi><msub><mi>max</mi><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup></msub><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mn>1</mn></msubsup><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a^{i}_{t+1}=\arg\max_{a^{i}_{t+1}}p(\mathcal{O}_{t:T}|a^{1}_{t,t+1},s_{t})</annotation></semantics></math> (where <math id="A4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="s^{i}_{t+1}=\tau(s_{t},a^{i}_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>=</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s^{i}_{t+1}=\tau(s_{t},a^{i}_{t})</annotation></semantics></math>), we have that:</p>
<table id="A4.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex149.m1" class="ltx_math_unparsed" alttext="p(\mathcal{O}_{t:T}|a^{1}_{t,t+1},s_{t})&gt;p(\mathcal{O}_{t:T}|a^{2}_{t,t+1},s_{t})\implies p(\mathcal{O}_{t:T}|a^{1}_{t},s_{t})&gt;p(\mathcal{O}_{t:T}|a^{2}_{t},s_{t})" display="block" intent=":literal"><semantics><mrow><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mn>1</mn></msubsup><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow><mn>2</mn></msubsup><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟹</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>a</mi><mi>t</mi><mn>1</mn></msubsup><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><mo>,</mo><msub><mi>s</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\mathcal{O}_{t:T}|a^{1}_{t,t+1},s_{t})&gt;p(\mathcal{O}_{t:T}|a^{2}_{t,t+1},s_{t})\implies p(\mathcal{O}_{t:T}|a^{1}_{t},s_{t})&gt;p(\mathcal{O}_{t:T}|a^{2}_{t},s_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmtheorem1.p1.2" class="ltx_p">In other words: given that that <math id="A4.Thmtheorem1.p1.m7" class="ltx_Math" alttext="a^{i}_{t+1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><annotation encoding="application/x-tex">a^{i}_{t+1}</annotation></semantics></math> best continues <math id="A4.Thmtheorem1.p1.m8" class="ltx_Math" alttext="a^{i}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mi>t</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">a^{i}_{t}</annotation></semantics></math>, if <math id="A4.Thmtheorem1.p1.m9" class="ltx_Math" alttext="(a^{1}_{t},a^{1}_{t+1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>t</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a^{1}_{t},a^{1}_{t+1})</annotation></semantics></math> is preferred to <math id="A4.Thmtheorem1.p1.m10" class="ltx_Math" alttext="(a^{2}_{t},a^{2}_{t+1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a^{2}_{t},a^{2}_{t+1})</annotation></semantics></math>, then <math id="A4.Thmtheorem1.p1.m11" class="ltx_Math" alttext="a^{1}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">a^{1}_{t}</annotation></semantics></math> should be preferred to <math id="A4.Thmtheorem1.p1.m12" class="ltx_Math" alttext="a^{2}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mi>t</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">a^{2}_{t}</annotation></semantics></math>.</p>
</div>
</div>
