;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m3" class="ltx_Math" alttext="s^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">s^{\prime}_{1}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 111.76 37.43)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m4" class="ltx_Math" alttext="s_{2}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>2</mn></msub><annotation encoding="application/x-tex">s_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 111.76 -43.53)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m5" class="ltx_Math" alttext="s^{\prime}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mn>2</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">s^{\prime}_{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 170.82 37.43)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m6" class="ltx_Math" alttext="s_{3}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>3</mn></msub><annotation encoding="application/x-tex">s_{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 170.82 -23.85)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="12.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m7" class="ltx_Math" alttext="s^{\prime}_{3}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mn>3</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">s^{\prime}_{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 170.39 -63.22)"><foreignObject style="--ltx-fo-width:0.98em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.48" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="13.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m8" class="ltx_Math" alttext="s^{\prime\prime}_{3}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mn>3</mn><mo>′′</mo></msubsup><annotation encoding="application/x-tex">s^{\prime\prime}_{3}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 11.24 7.49 L 47.36 31.58"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.83202 0.55476 -0.55476 0.83202 47.59 31.73)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -26.32 28.03)"><foreignObject style="--ltx-fo-width:3.68em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="50.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m9" class="ltx_Math" alttext="\pi(s_{1}|s_{0})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(s_{1}|s_{0})</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 11.24 -7.49 L 47.36 -31.58"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.83202 -0.55476 0.55476 0.83202 47.59 -31.73)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -26.32 -34.98)"><foreignObject style="--ltx-fo-width:3.68em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.86" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="50.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m10" class="ltx_Math" alttext="\pi(s^{\prime}_{1}|s_{0})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(s^{\prime}_{1}|s_{0})</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 70.29 39.37 L 106.32 39.37"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 106.6 39.37)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 85.12 44.26)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 70.29 -39.37 L 106.32 -39.37"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 106.6 -39.37)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 85.12 -53.18)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m12" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 129.35 39.37 L 165.38 39.37"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 165.65 39.37)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 144.18 44.26)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 129.35 -35.63 L 165.4 -23.6"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.94867 0.31627 -0.31627 0.94867 165.67 -23.52)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 131.72 -24.64)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:10pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="11.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m14" class="ltx_Math" alttext="\frac{2}{3}" display="inline" intent=":literal"><semantics><mfrac><mn>2</mn><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{2}{3}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 129.35 -43.11 L 164.97 -54.99"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.94865 -0.31628 0.31628 0.94865 165.24 -55.08)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 141.91 -60.27)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:10pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="11.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m15" class="ltx_Math" alttext="\frac{1}{3}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{3}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 209.93 35.91)"><foreignObject style="--ltx-fo-width:3.8em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m16" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=\frac{1}{2}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 210.06 -23.14)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m17" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=1</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 210.06 -62.51)"><foreignObject style="--ltx-fo-width:3.78em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="52.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A4.F4.pic1.m18" class="ltx_Math" alttext="\mathbb{P}\left({R}\right)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mi>R</mi><mo>)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}\left({R}\right)=0</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span><math id="A4.F4.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> cannot satisfy both 2-policy-stability and 1-policy-stability.</figcaption>
</figure>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p">Unfortunately, not only this is not a sufficient condition - in some instances, it is even contradicting optimality. This is because it is impossible to properly extend the the policy-stability over an arbitrary number of actions. To show that, we can introduce a notion of <math id="A4.p2.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-policy-stable predictor, which says that for any sequences <math id="A4.p2.m2" class="ltx_math_unparsed" alttext="a_{1:k},a^{\prime}_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo>,</mo><mi>a</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">a_{1:k},a^{\prime}_{1:k}</annotation></semantics></math> and actions <math id="A4.p2.m3" class="ltx_Math" alttext="a,a^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><msup><mi>a</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">a,a^{\prime}</annotation></semantics></math>, such that the sequence <math id="A4.p2.m4" class="ltx_math_unparsed" alttext="a_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">a_{1:k}</annotation></semantics></math> best continues <math id="A4.p2.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and sequence <math id="A4.p2.m6" class="ltx_math_unparsed" alttext="a^{\prime}_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">a^{\prime}_{1:k}</annotation></semantics></math> best continues <math id="A4.p2.m7" class="ltx_Math" alttext="a^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mo>′</mo></msup><annotation encoding="application/x-tex">a^{\prime}</annotation></semantics></math>, we have that <math id="A4.p2.m8" class="ltx_math_unparsed" alttext="(a,a_{1:k})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><msub><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,a_{1:k})</annotation></semantics></math> being preferred over <math id="A4.p2.m9" class="ltx_math_unparsed" alttext="(a^{\prime},a^{\prime}_{1:k})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi>a</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a^{\prime},a^{\prime}_{1:k})</annotation></semantics></math> implies that <math id="A4.p2.m10" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is preferred to <math id="A4.p2.m11" class="ltx_Math" alttext="a^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mo>′</mo></msup><annotation encoding="application/x-tex">a^{\prime}</annotation></semantics></math>.</p>
</div>
<div id="A4.p3" class="ltx_para ltx_noindent">
<p id="A4.p3.1" class="ltx_p">From direct calculation, it can be seen that, if a policy derived by control-as-inference from a prior over the MDP shown in the <a href="#A4.F4" title="In Appendix D POLICY STABILITY" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">4</span></a> is to be 1-policy-stable, then it must be the case that <math id="A4.p3.m1" class="ltx_Math" alttext="\pi(s_{1}|s_{0})\geq\pi(s^{\prime}_{1}|s_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi(s_{1}|s_{0})\geq\pi(s^{\prime}_{1}|s_{0})</annotation></semantics></math>, while considering two actions into the future and then following the prior, moving into <math id="A4.p3.m2" class="ltx_Math" alttext="s_{2}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>2</mn></msub><annotation encoding="application/x-tex">s_{2}</annotation></semantics></math> is a better choice. However, to be 2-policy-stable, it has to satisfy <math id="A4.p3.m3" class="ltx_Math" alttext="\pi(s_{1}|s_{0})&lt;\pi(s^{\prime}_{1}|s_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi(s_{1}|s_{0})&lt;\pi(s^{\prime}_{1}|s_{0})</annotation></semantics></math>, since after considering three moves in the future, moving to <math id="A4.p3.m4" class="ltx_Math" alttext="s^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">s^{\prime}_{1}</annotation></semantics></math> becomes the better choice. Since 1-policy-stable and 2-policy-stable are mutually exclusive for a policy derived by control-as-inference from this prior, one has to make a choice as to which <math id="A4.p3.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-policy-stability to require, which, in practice, requires the knowledge of the time horizon (and for it to be fixed and finite).</p>
</div>
</section>
</article>
</div>
</div>
