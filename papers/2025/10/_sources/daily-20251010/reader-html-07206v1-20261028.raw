<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8.m1" class="ltx_Math" alttext="\displaystyle+2\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\big({\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big)^{\mathsf{T}}\big(\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big)\Big]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+2\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\big({\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big)^{\mathsf{T}}\big(\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big)\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\|_{2}^{2}\Big]+\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\|_{2}^{2}\Big]+\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.4" class="ltx_p"><span id="A1.SS1.p2.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">where in the last equality, we used the fact that</span></p>
<table id="A1.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\big({\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big)\Big]=0,\quad\text{where}\quad{\bm{x}}\sim p({\bm{x}})~~\text{and}~~{\bm{x}}_{t}\sim p({\bm{x}}_{t})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">where</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0.660em" rspace="0em">​</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">and</mtext><mo lspace="0.660em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\big({\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big)\Big]=0,\quad\text{where}\quad{\bm{x}}\sim p({\bm{x}})~~\text{and}~~{\bm{x}}_{t}\sim p({\bm{x}}_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.5" class="ltx_p"><span id="A1.SS1.p2.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">By replacing the result of this equation into Eq. (</span><a href="#A1.Ex5" title="In A.1 Connecting KL divergence with Denoising Error ‣ Appendix A Proofs ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">13</span></a><span id="A1.SS1.p2.5.2" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></p>
<table id="A1.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]-\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]-\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle=\text{MSE}({\mathsf{D}}_{q},t)-\text{MSE}({\mathsf{D}}_{p},t)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">MSE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">MSE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\text{MSE}({\mathsf{D}}_{q},t)-\text{MSE}({\mathsf{D}}_{p},t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Connecting MSE of Denoising to Covariance</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p"><span id="A1.SS2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">We assume that MMSE estimator </span><math id="A1.SS2.p1.m1" class="ltx_Math" alttext="{\mathsf{D}}_{p}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><annotation encoding="application/x-tex">{\mathsf{D}}_{p}</annotation></semantics></math><span id="A1.SS2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is an optimal denoiser trained on images sampled from data distribution </span><math id="A1.SS2.p1.m2" class="ltx_Math" alttext="p({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p({\bm{x}})</annotation></semantics></math><span id="A1.SS2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">. Consequently, the MSE for this operator is defined as</span></p>
<table id="A1.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\displaystyle\text{MSE}({\mathsf{D}}_{p},t)=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\|_{2}^{2}\Big]" display="inline" intent=":literal"><semantics><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">MSE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{MSE}({\mathsf{D}}_{p},t)=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\|_{2}^{2}\Big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}}\Bigg[\mathbb{E}_{{\bm{x}}_{t}}\Big[\tr(\xbm- \E_p[\xbm|\xbm_t])({\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}])^{\mathsf{T}}\big|{\bm{x}}_{t}\Big]\Bigg]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.600em" minsize="2.600em">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup></mrow><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}}\Bigg[\mathbb{E}_{{\bm{x}}_{t}}\Big[\tr(\xbm- \E_p[\xbm|\xbm_t])({\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}])^{\mathsf{T}}\big|{\bm{x}}_{t}\Big]\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\bm{x}}}\Bigg[\tr\mathrm{Cov}_{p}[{\bm{x}}|{\bm{x}}_{t}]\Bigg]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}}}\Bigg[\tr\mathrm{Cov}_{p}[{\bm{x}}|{\bm{x}}_{t}]\Bigg],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p1.2" class="ltx_p"><span id="A1.SS2.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">where the first equality follows from the definition of MSE using the MMSE estimator </span><math id="A1.SS2.p1.m3" class="ltx_Math" alttext="{\mathsf{D}}_{p}({\bm{x}}_{t})=\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{D}}_{p}({\bm{x}}_{t})=\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]</annotation></semantics></math><span id="A1.SS2.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">, and the second equality applies the law of total expectation along with the identity </span><math id="A1.SS2.p1.m4" class="ltx_Math" alttext="\|{\bm{v}}\|_{2}^{2}=\tr(\vbm\vbm^\Tsf)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|{\bm{v}}\|_{2}^{2}=\tr(\vbm\vbm^\Tsf)</annotation></semantics></math><span id="A1.SS2.p1.2.3" class="ltx_text" style="--ltx-fg-color:#000000;">. In the last equality, we used the fact that the inner expectation corresponds to the conditional covariance matrix </span><math id="A1.SS2.p1.m5" class="ltx_Math" alttext="\mathrm{Cov}[{\bm{x}}|{\bm{x}}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Cov}[{\bm{x}}|{\bm{x}}_{t}]</annotation></semantics></math><span id="A1.SS2.p1.2.4" class="ltx_text" style="--ltx-fg-color:#000000;">, whose trace gives the expected squared error. From Theorem 1 of </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite><span id="A1.SS2.p1.2.7" class="ltx_text" style="--ltx-fg-color:#000000;">, we have</span></p>
<table id="A1.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E14.m1" class="ltx_math_unparsed" alttext="\mathrm{Cov}_{p}[{\bm{x}}|{\bm{x}}_{t}]=\sigma_{t}^{2}\nabla{\mathsf{D}}_{p}({\bm{x}}_{t})\approx\sum_{k=1}^{K}\lambda_{k}^{t}({\bm{x}}_{t}){\bm{u}}_{k}{\bm{u}}_{k}^{\mathsf{T}}," display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.167em" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≈</mo><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Cov}_{p}[{\bm{x}}|{\bm{x}}_{t}]=\sigma_{t}^{2}\nabla{\mathsf{D}}_{p}({\bm{x}}_{t})\approx\sum_{k=1}^{K}\lambda_{k}^{t}({\bm{x}}_{t}){\bm{u}}_{k}{\bm{u}}_{k}^{\mathsf{T}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p1.3" class="ltx_p"><span id="A1.SS2.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">where </span><math id="A1.SS2.p1.m6" class="ltx_Math" alttext="\nabla{\mathsf{D}}_{p}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub></mrow><annotation encoding="application/x-tex">\nabla{\mathsf{D}}_{p}</annotation></semantics></math><span id="A1.SS2.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is the Jacobian, assumed to be positive semi-definite and symmetric. We approximate the Jacobian matrix using the top </span><math id="A1.SS2.p1.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A1.SS2.p1.3.3" class="ltx_text" style="--ltx-fg-color:#000000;"> eigenvalues </span><math id="A1.SS2.p1.m8" class="ltx_Math" alttext="\lambda_{1},\cdots,\lambda_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋯</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><annotation encoding="application/x-tex">\lambda_{1},\cdots,\lambda_{K}</annotation></semantics></math><span id="A1.SS2.p1.3.4" class="ltx_text" style="--ltx-fg-color:#000000;">, nd their corresponding eigenvectors </span><math id="A1.SS2.p1.m9" class="ltx_Math" alttext="{\bm{u}}_{1},\cdots,{\bm{u}}_{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋯</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}_{1},\cdots,{\bm{u}}_{K}</annotation></semantics></math><span id="A1.SS2.p1.3.5" class="ltx_text" style="--ltx-fg-color:#000000;">
which is a low-rank approximation of the full covariance matrix based on its spectral decomposition of symmetric positive semi-definite matrices. By retaining only the top </span><math id="A1.SS2.p1.m10" class="ltx_Math" alttext="K&lt;n" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></mrow><annotation encoding="application/x-tex">K&lt;n</annotation></semantics></math><span id="A1.SS2.p1.3.6" class="ltx_text" style="--ltx-fg-color:#000000;"> terms in this expansion, we obtain a rank-</span><math id="A1.SS2.p1.m11" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="A1.SS2.p1.3.7" class="ltx_text" style="--ltx-fg-color:#000000;"> approximation of the covariance, capturing most of its variance while reducing dimensionality and computation. The trace of this approximate covariance is then given by</span></p>
<table id="A1.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E15.m1" class="ltx_Math" alttext="\tr(\Cov_p[\xbm|\xbm_t])\approx\sum_{k=1}^{K}\lambda_{k}^{t}({\bm{x}}_{t})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≈</mo><mrow><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\tr(\Cov_p[\xbm|\xbm_t])\approx\sum_{k=1}^{K}\lambda_{k}^{t}({\bm{x}}_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A1.SS2.p1.4" class="ltx_p"><span id="A1.SS2.p1.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">since each term </span><math id="A1.SS2.p1.m12" class="ltx_Math" alttext="{\bm{u}}_{k}{\bm{u}}_{k}^{\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup></mrow><annotation encoding="application/x-tex">{\bm{u}}_{k}{\bm{u}}_{k}^{\mathsf{T}}</annotation></semantics></math><span id="A1.SS2.p1.4.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is a rank-one projection matrix with unit trace. This expression allows us to estimate the total variance (or the MSE) using only the top eigenvalues, under the assumption that the remaining eigenvalues contribute negligibly. Consequently, we have:</span></p>
<table id="A1.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E16.m1" class="ltx_Math" alttext="\text{MSE}({\mathsf{D}}_{p},t)=\mathbb{E}_{{\bm{x}}}\Bigg[\tr\mathrm{Cov}_{p}[{\bm{x}}|{\bm{x}}_{t}]\Bigg]=\sigma_{t}^{2}\sum_{k=1}^{K}\lambda_{k}^{t}({\bm{x}}_{t})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">MSE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.600em" minsize="2.600em">[</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo lspace="0.167em">⁡</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\text{MSE}({\mathsf{D}}_{p},t)=\mathbb{E}_{{\bm{x}}}\Bigg[\tr\mathrm{Cov}_{p}[{\bm{x}}|{\bm{x}}_{t}]\Bigg]=\sigma_{t}^{2}\sum_{k=1}^{K}\lambda_{k}^{t}({\bm{x}}_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Miyasawa Relationship</h3>

<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p"><span id="A1.SS3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The connection between MMSE estimation under Gaussian noise and the score function was first established in </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite><span id="A1.SS3.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> and later generalized in </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">41</a>]</cite><span id="A1.SS3.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">. For completeness, we provide a derivation here.</span></p>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.1" class="ltx_p"><span id="A1.SS3.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let </span><math id="A1.SS3.p2.m1" class="ltx_Math" alttext="{\bm{x}}_{t}={\bm{x}}+{\bm{z}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t}={\bm{x}}+{\bm{z}}</annotation></semantics></math><span id="A1.SS3.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, denote a noisy observation of </span><math id="A1.SS3.p2.m2" class="ltx_Math" alttext="{\bm{x}}\sim{p({\bm{x}})}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}\sim{p({\bm{x}})}</annotation></semantics></math><span id="A1.SS3.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, where </span><math id="A1.SS3.p2.m3" class="ltx_Math" alttext="{\bm{z}}\sim{\mathcal{N}}(0,\sigma_{t}^{2}{\bm{I}})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{z}}\sim{\mathcal{N}}(0,\sigma_{t}^{2}{\bm{I}})</annotation></semantics></math><span id="A1.SS3.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, and define </span><math id="A1.SS3.p2.m4" class="ltx_Math" alttext="p({\bm{x}}_{t}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p({\bm{x}}_{t}|{\bm{x}})</annotation></semantics></math><span id="A1.SS3.p2.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> as the Gaussian likelihood. The marginal distribution of y is given by:</span></p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="p({\bm{x}}_{t})=\int{p({\bm{x}})}\,p({\bm{x}}_{t}|{\bm{x}})\,\mathrm{d}{\bm{x}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">𝑑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">p({\bm{x}}_{t})=\int{p({\bm{x}})}\,p({\bm{x}}_{t}|{\bm{x}})\,\mathrm{d}{\bm{x}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.2" class="ltx_p"><span id="A1.SS3.p2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">To derive the score function </span><math id="A1.SS3.p2.m5" class="ltx_math_unparsed" alttext="\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})</annotation></semantics></math><span id="A1.SS3.p2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> , we differentiate the log-marginal using the identity </span><math id="A1.SS3.p2.m6" class="ltx_math_unparsed" alttext="\nabla h({\bm{x}}_{t})=h({\bm{x}}_{t})\nabla\log h({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla h({\bm{x}}_{t})=h({\bm{x}}_{t})\nabla\log h({\bm{x}}_{t})</annotation></semantics></math><span id="A1.SS3.p2.2.3" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></p>
<table id="A1.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m2" class="ltx_Math" alttext="\displaystyle=\int p({\bm{x}})p({\bm{x}}_{t}|{\bm{x}})\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mathrm{d}{\bm{x}}\bigg/p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">𝑑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow></mrow></mrow></mstyle><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="2.100em" minsize="2.100em" stretchy="true" symmetric="true">/</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int p({\bm{x}})p({\bm{x}}_{t}|{\bm{x}})\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mathrm{d}{\bm{x}}\bigg/p({\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\int p({\bm{x}}|{\bm{x}}_{t})\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mathrm{d}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mstyle displaystyle="true"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">𝑑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int p({\bm{x}}|{\bm{x}}_{t})\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mathrm{d}{\bm{x}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right]," display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.3" class="ltx_p"><span id="A1.SS3.p2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">which can be interpreted as a chain rule applied to score functions rather than densities.</span></p>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p"><span id="A1.SS3.p3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Next, we compute the Hessian </span><math id="A1.SS3.p3.m1" class="ltx_math_unparsed" alttext="\nabla^{2}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla^{2}\log p({\bm{x}}_{t})</annotation></semantics></math><span id="A1.SS3.p3.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">. Differentiating again:</span></p>
<table id="A1.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex19.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla^{2}\log p({\bm{x}}_{t})=\int p({\bm{x}}|{\bm{x}}_{t})\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}|{\bm{x}}_{t})\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})^{\mathsf{T}}+\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\right)\mathrm{d}{\bm{x}}." display="inline" intent=":literal"><semantics><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo></mstyle><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em" stretchy="false">)</mo></mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla^{2}\log p({\bm{x}}_{t})=\int p({\bm{x}}|{\bm{x}}_{t})\left(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}|{\bm{x}}_{t})\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})^{\mathsf{T}}+\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\right)\mathrm{d}{\bm{x}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p4" class="ltx_para">
<p id="A1.SS3.p4.1" class="ltx_p"><span id="A1.SS3.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Using Bayes’ rule:</span></p>
<table id="A1.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\log p({\bm{x}}|{\bm{x}}_{t})=\log p({\bm{x}}_{t}|{\bm{x}})+\log p({\bm{x}})-\log p({\bm{x}}_{t})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\log p({\bm{x}}|{\bm{x}}_{t})=\log p({\bm{x}}_{t}|{\bm{x}})+\log p({\bm{x}})-\log p({\bm{x}}_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p4.2" class="ltx_p"><span id="A1.SS3.p4.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">and differentiating with respect to y, we obtain:</span></p>
<table id="A1.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex21.m1" class="ltx_math_unparsed" alttext="\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}|{\bm{x}}_{t})=\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})-\nabla\log p({\bm{x}}_{t})." display="block" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}|{\bm{x}}_{t})=\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})-\nabla\log p({\bm{x}}_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p5" class="ltx_para">
<p id="A1.SS3.p5.1" class="ltx_p"><span id="A1.SS3.p5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Substituting this into the previous expression yields:</span></p>
<table id="A1.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla^{2}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla^{2}\log p({\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m2" class="ltx_math_unparsed" alttext="\displaystyle=\int p({\bm{x}}|{\bm{x}}_{t})\left((\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})-\nabla\log p({\bm{x}}_{t}))\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})^{\mathsf{T}}+\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\right)\mathrm{d}{\bm{x}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo></mstyle><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em" stretchy="false">)</mo></mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int p({\bm{x}}|{\bm{x}}_{t})\left((\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})-\nabla\log p({\bm{x}}_{t}))\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})^{\mathsf{T}}+\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\right)\mathrm{d}{\bm{x}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\left[(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})-\nabla\log p({\bm{x}}_{t}))\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})^{\mathsf{T}}\mid{\bm{x}}_{t}\right]+\mathbb{E}\left[\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em" stretchy="false">)</mo></mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[(\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})-\nabla\log p({\bm{x}}_{t}))\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})^{\mathsf{T}}\mid{\bm{x}}_{t}\right]+\mathbb{E}\left[\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathrm{Cov}\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right]+\mathbb{E}\left[\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right]." display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{Cov}\left[\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right]+\mathbb{E}\left[\nabla^{2}_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})\mid{\bm{x}}_{t}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p6" class="ltx_para">
<p id="A1.SS3.p6.1" class="ltx_p"><span id="A1.SS3.p6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now, since </span><math id="A1.SS3.p6.m1" class="ltx_Math" alttext="p({\bm{x}}_{t}|{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p({\bm{x}}_{t}|{\bm{x}})</annotation></semantics></math><span id="A1.SS3.p6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is Gaussian with variance </span><math id="A1.SS3.p6.m2" class="ltx_Math" alttext="\sigma_{t}^{2}{\bm{I}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi></mrow><annotation encoding="application/x-tex">\sigma_{t}^{2}{\bm{I}}</annotation></semantics></math><span id="A1.SS3.p6.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, we have:</span></p>
<table id="A1.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex25.m1" class="ltx_Math" alttext="\displaystyle\log p({\bm{x}}_{t}|{\bm{x}})=-\frac{1}{2\sigma_{t}^{2}}\|{\bm{x}}_{t}-{\bm{x}}\|^{2}+\text{const}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">const</mtext></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log p({\bm{x}}_{t}|{\bm{x}})=-\frac{1}{2\sigma_{t}^{2}}\|{\bm{x}}_{t}-{\bm{x}}\|^{2}+\text{const},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})=-\frac{1}{\sigma_{t}^{2}}({\bm{x}}_{t}-{\bm{x}})," display="inline" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac></mstyle><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})=-\frac{1}{\sigma_{t}^{2}}({\bm{x}}_{t}-{\bm{x}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})=-\frac{1}{\sigma_{t}^{2}}{\bm{I}}." display="inline" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac></mstyle><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{{\bm{x}}_{t}}\log p({\bm{x}}_{t}|{\bm{x}})=-\frac{1}{\sigma_{t}^{2}}{\bm{I}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p7" class="ltx_para">
<p id="A1.SS3.p7.1" class="ltx_p"><span id="A1.SS3.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Plugging into the previous results gives the Miyasawa identities:</span></p>
<table id="A1.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E17.m1" class="ltx_Math" alttext="\displaystyle\nabla\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi></mrow><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\log p({\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E17.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma_{t}^{2}}\left(\mathbb{E}[{\bm{x}}\mid{\bm{x}}_{t}]-{\bm{x}}_{t}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma_{t}^{2}}\left(\mathbb{E}[{\bm{x}}\mid{\bm{x}}_{t}]-{\bm{x}}_{t}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
<tbody id="A1.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E18.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla^{2}\log p({\bm{x}}_{t})" display="inline" intent=":literal"><semantics><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla^{2}\log p({\bm{x}}_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E18.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sigma_{t}^{4}}\mathrm{Cov}[{\bm{x}}\mid{\bm{x}}_{t}]-\frac{1}{\sigma_{t}^{2}}{\bm{I}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sigma_{t}^{4}}\mathrm{Cov}[{\bm{x}}\mid{\bm{x}}_{t}]-\frac{1}{\sigma_{t}^{2}}{\bm{I}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p8" class="ltx_para">
<p id="A1.SS3.p8.1" class="ltx_p"><span id="A1.SS3.p8.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Rearranging, we recover both the posterior mean and posterior covariance in terms of the score and its Hessian:</span></p>
<table id="A1.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E19.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[{\bm{x}}\mid{\bm{x}}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[{\bm{x}}\mid{\bm{x}}_{t}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E19.m2" class="ltx_math_unparsed" alttext="\displaystyle={\bm{x}}_{t}+\sigma_{t}^{2}\nabla\log p({\bm{x}}_{t})," display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.167em" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{x}}_{t}+\sigma_{t}^{2}\nabla\log p({\bm{x}}_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
<tbody id="A1.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E20.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Cov}[{\bm{x}}\mid{\bm{x}}_{t}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Cov}[{\bm{x}}\mid{\bm{x}}_{t}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E20.m2" class="ltx_Math" alttext="\displaystyle=\sigma_{t}^{2}\left({\bm{I}}+\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{t}^{2}\left({\bm{I}}+\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p9" class="ltx_para">
<p id="A1.SS3.p9.1" class="ltx_p"><span id="A1.SS3.p9.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Finally, the optimal denoising error is given by the expected trace of the posterior covariance:</span></p>
<table id="A1.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|{\bm{x}}-\mathbb{E}[{\bm{x}}\mid{\bm{x}}_{t}]\|^{2}\right]=\mathbb{E}\left[\mathrm{tr}\,\mathrm{Cov}[{\bm{x}}\mid{\bm{x}}_{t}]\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo lspace="0.170em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Cov</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|{\bm{x}}-\mathbb{E}[{\bm{x}}\mid{\bm{x}}_{t}]\|^{2}\right]=\mathbb{E}\left[\mathrm{tr}\,\mathrm{Cov}[{\bm{x}}\mid{\bm{x}}_{t}]\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Proof of Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ 3.5 EigenScore vs. MSE: Capturing Structure Instead of Collapse ‣ 3 Diffusion Model for Out-of-Distribution Detection ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</h3>

<div id="A1.SS4.p1" class="ltx_para">
<p id="A1.SS4.p1.1" class="ltx_p"><span id="A1.SS4.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ 3.5 EigenScore vs. MSE: Capturing Structure Instead of Collapse ‣ 3 Diffusion Model for Out-of-Distribution Detection ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></span><span id="A1.SS4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">
</span><span id="A1.SS4.p1.1.3" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Let <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="p({\bm{x}}_{t})=p*\mathcal{N}(0,\sigma_{t}^{2}{\bm{I}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">∗</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐈</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p({\bm{x}}_{t})=p*\mathcal{N}(0,\sigma_{t}^{2}{\bm{I}})</annotation></semantics></math> denotes the noisy marginal distribution in Eq. (<a href="#S2.E3" title="Equation 3 ‣ 2 Background ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and <math id="A1.SS4.p1.m2" class="ltx_Math" alttext="{\bm{\Sigma}}_{t}({\bm{x}}_{t})\;=\;\sigma_{t}^{2}\!\left({\bm{I}}+\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t})\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.558em">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐈</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\Sigma}}_{t}({\bm{x}}_{t})\;=\;\sigma_{t}^{2}\!\left({\bm{I}}+\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t})\right)</annotation></semantics></math> from Miyasawa (Eq. (<a href="#S3.E6" title="Equation 6 ‣ 3.3 Eigenvalue-Based Uncertainty estimation ‣ 3 Diffusion Model for Out-of-Distribution Detection ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)). As <math id="A1.SS4.p1.m3" class="ltx_Math" alttext="\sigma_{t}\to\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sigma_{t}\to\infty</annotation></semantics></math>, <math id="A1.SS4.p1.m4" class="ltx_math_unparsed" alttext="\|\nabla^{2}\log p({\bm{x}}_{t})\|\to 0" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∥</mo><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.0835em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0.0835em" mathcolor="#000000" stretchy="false">→</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\|\nabla^{2}\log p({\bm{x}}_{t})\|\to 0</annotation></semantics></math> uniformly on compact sets. Hence</span></p>
<table id="A1.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex29.m1" class="ltx_Math" alttext="{\bm{\Sigma}}_{t}({\bm{x}}_{t})=\sigma_{t}^{2}{\bm{I}}+o(\sigma_{t}^{2})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">{\bm{\Sigma}}_{t}({\bm{x}}_{t})=\sigma_{t}^{2}{\bm{I}}+o(\sigma_{t}^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p1.2" class="ltx_p"><span id="A1.SS4.p1.2.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">so all eigenvalues satisfy <math id="A1.SS4.p1.m5" class="ltx_Math" alttext="\lambda_{k}^{t}({\bm{x}}_{t})=\sigma_{t}^{2}+o(\sigma_{t}^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{k}^{t}({\bm{x}}_{t})=\sigma_{t}^{2}+o(\sigma_{t}^{2})</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="A1.SS4.p2" class="ltx_para">
<p id="A1.SS4.p2.1" class="ltx_p"><span id="A1.SS4.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let <math id="A1.SS4.p2.m1" class="ltx_Math" alttext="G_{\sigma_{t}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><annotation encoding="application/x-tex">G_{\sigma_{t}}</annotation></semantics></math> denotes the Gaussian density function with standard deviation <math id="A1.SS4.p2.m2" class="ltx_Math" alttext="\sigma_{t}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\sigma_{t}\geq 0</annotation></semantics></math>. Then, we have</span></p>
<table id="A1.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E21.m1" class="ltx_Math" alttext="p({\bm{x}}_{t})=\int p({\bm{x}}_{t}|{\bm{x}}){p({\bm{x}})}{\differential{\bm{x}}}=\int G_{\sigma_{t}}({\bm{x}}_{t}-{\bm{x}})p({\bm{x}}){\differential{\bm{x}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">p({\bm{x}}_{t})=\int p({\bm{x}}_{t}|{\bm{x}}){p({\bm{x}})}{\differential{\bm{x}}}=\int G_{\sigma_{t}}({\bm{x}}_{t}-{\bm{x}})p({\bm{x}}){\differential{\bm{x}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p2.2" class="ltx_p"><span id="A1.SS4.p2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Differentiation under the integral yields</span></p>
<table id="A1.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E22.m1" class="ltx_Math" alttext="\nabla G_{\sigma}({\bm{z}})=-\frac{{\bm{z}}}{\sigma^{2}}G_{\sigma}({\bm{z}}),\qquad\nabla^{2}G_{\sigma}({\bm{z}})=\Big(\frac{{\bm{z}}{\bm{z}}^{\mathsf{T}}}{\sigma^{4}}-\frac{{\bm{I}}}{\sigma^{2}}\Big)\,G_{\sigma}({\bm{z}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="2.167em">,</mo><mrow><mrow><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">(</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup></mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></msup></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒛</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\nabla G_{\sigma}({\bm{z}})=-\frac{{\bm{z}}}{\sigma^{2}}G_{\sigma}({\bm{z}}),\qquad\nabla^{2}G_{\sigma}({\bm{z}})=\Big(\frac{{\bm{z}}{\bm{z}}^{\mathsf{T}}}{\sigma^{4}}-\frac{{\bm{I}}}{\sigma^{2}}\Big)\,G_{\sigma}({\bm{z}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS4.p3" class="ltx_para">
<p id="A1.SS4.p3.1" class="ltx_p"><span id="A1.SS4.p3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Hence</span></p>
<table id="A1.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E23.m1" class="ltx_Math" alttext="\nabla_{{\bm{x}}_{t}}p({\bm{x}}_{t})=\int\nabla G_{\sigma_{t}}({\bm{x}}_{t}-{\bm{x}})\,p({\bm{x}})\,{\differential{\bm{x}}},\qquad\nabla_{{\bm{x}}_{t}}^{2}p({\bm{x}}_{t})=\int\nabla^{2}G_{\sigma_{t}}({\bm{x}}_{t}-{\bm{x}})\,p({\bm{x}})\,{\differential{\bm{x}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="2.167em">,</mo><mrow><mrow><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mrow><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\nabla_{{\bm{x}}_{t}}p({\bm{x}}_{t})=\int\nabla G_{\sigma_{t}}({\bm{x}}_{t}-{\bm{x}})\,p({\bm{x}})\,{\differential{\bm{x}}},\qquad\nabla_{{\bm{x}}_{t}}^{2}p({\bm{x}}_{t})=\int\nabla^{2}G_{\sigma_{t}}({\bm{x}}_{t}-{\bm{x}})\,p({\bm{x}})\,{\differential{\bm{x}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS4.p4" class="ltx_para">
<p id="A1.SS4.p4.1" class="ltx_p"><span id="A1.SS4.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Fix a compact set <math id="A1.SS4.p4.m1" class="ltx_Math" alttext="K\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊂</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">K\subset\mathbb{R}^{d}</annotation></semantics></math>. Using Cauchy–Schwarz and that <math id="A1.SS4.p4.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> has finite second moment, one obtains bounds of the form</span></p>
<table id="A1.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E24.m1" class="ltx_Math" alttext="\frac{\|\nabla p({\bm{x}}_{t})\|}{p({\bm{x}}_{t})}\;\leq\;\frac{C_{1}}{\sigma_{t}},\qquad\frac{\|\nabla^{2}p({\bm{x}}_{t})\|}{p({\bm{x}}_{t})}\;\leq\;\frac{C_{2}}{\sigma_{t}^{2}},\qquad\forall{\bm{x}}\in K," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" rspace="0.558em">≤</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="2.167em">,</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" rspace="0.558em">≤</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="2.167em">,</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∀</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\frac{\|\nabla p({\bm{x}}_{t})\|}{p({\bm{x}}_{t})}\;\leq\;\frac{C_{1}}{\sigma_{t}},\qquad\frac{\|\nabla^{2}p({\bm{x}}_{t})\|}{p({\bm{x}}_{t})}\;\leq\;\frac{C_{2}}{\sigma_{t}^{2}},\qquad\forall{\bm{x}}\in K,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS4.p5" class="ltx_para">
<p id="A1.SS4.p5.1" class="ltx_p"><span id="A1.SS4.p5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">for constants <math id="A1.SS4.p5.m1" class="ltx_Math" alttext="C_{1},C_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">C_{1},C_{2}</annotation></semantics></math> independent of <math id="A1.SS4.p5.m2" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math>. Consequently,</span></p>
<table id="A1.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E25.m1" class="ltx_math_unparsed" alttext="\nabla^{2}\log p({\bm{x}}_{t})=\frac{\nabla^{2}p({\bm{x}}_{t})}{p({\bm{x}}_{t})}-\frac{\nabla p({\bm{x}}_{t})\,\nabla p({\bm{x}}_{t})^{\mathsf{T}}}{p({\bm{x}}_{t})^{2}}" display="block" intent=":literal"><semantics><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.337em" stretchy="false">)</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\nabla^{2}\log p({\bm{x}}_{t})=\frac{\nabla^{2}p({\bm{x}}_{t})}{p({\bm{x}}_{t})}-\frac{\nabla p({\bm{x}}_{t})\,\nabla p({\bm{x}}_{t})^{\mathsf{T}}}{p({\bm{x}}_{t})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p5.2" class="ltx_p"><span id="A1.SS4.p5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">satisfies</span></p>
<table id="A1.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E26.m1" class="ltx_math_unparsed" alttext="\|\nabla^{2}\log p({\bm{x}}_{t})\|\;\leq\;\frac{C_{2}}{\sigma_{t}^{2}}+\frac{C_{1}^{2}}{\sigma_{t}^{2}}\;=\;O\!\Big(\frac{1}{\sigma^{2}}\Big)," display="block" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∥</mo><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.169em">∥</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.558em">≤</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" rspace="0.558em">=</mo><mpadded style="width:0.621em;" width="0.621em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">O</mi></mpadded><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">(</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\|\nabla^{2}\log p({\bm{x}}_{t})\|\;\leq\;\frac{C_{2}}{\sigma_{t}^{2}}+\frac{C_{1}^{2}}{\sigma_{t}^{2}}\;=\;O\!\Big(\frac{1}{\sigma^{2}}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p5.3" class="ltx_p"><span id="A1.SS4.p5.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">uniformly on <math id="A1.SS4.p5.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. Thus <math id="A1.SS4.p5.m4" class="ltx_Math" alttext="\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t})\to 0</annotation></semantics></math> as <math id="A1.SS4.p5.m5" class="ltx_Math" alttext="\sigma_{t}\to\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sigma_{t}\to\infty</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS4.p6" class="ltx_para">
<p id="A1.SS4.p6.1" class="ltx_p"><span id="A1.SS4.p6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Plugging into</span></p>
<table id="A1.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E27.m1" class="ltx_Math" alttext="{\bm{\Sigma}}_{t}({\bm{x}}_{t})=\sigma_{t}^{2}({\bm{I}}+\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t}))" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∇</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\Sigma}}_{t}({\bm{x}}_{t})=\sigma_{t}^{2}({\bm{I}}+\sigma_{t}^{2}\nabla^{2}\log p({\bm{x}}_{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p6.2" class="ltx_p"><span id="A1.SS4.p6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">gives</span></p>
<table id="A1.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E28.m1" class="ltx_Math" alttext="{\bm{\Sigma}}_{t}({\bm{x}}_{t})=\sigma_{t}^{2}{\bm{I}}+o(\sigma_{t}^{2})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">{\bm{\Sigma}}_{t}({\bm{x}}_{t})=\sigma_{t}^{2}{\bm{I}}+o(\sigma_{t}^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A1.SS4.p6.3" class="ltx_p"><span id="A1.SS4.p6.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">and hence <math id="A1.SS4.p6.m1" class="ltx_Math" alttext="\lambda_{k}^{t}({\bm{x}}_{t})=\sigma_{t}^{2}+o(\sigma_{t}^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{k}^{t}({\bm{x}}_{t})=\sigma_{t}^{2}+o(\sigma_{t}^{2})</annotation></semantics></math> for all <math id="A1.SS4.p6.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A1.SS4.p7" class="ltx_para">
<p id="A1.SS4.p7.1" class="ltx_p"><span id="A1.SS4.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">This implies that at large noise, the posterior covariance becomes asymptotically isotropic; the spectrum </span><em id="A1.SS4.p7.1.2" class="ltx_emph ltx_font_italic" style="--ltx-fg-color:#000000;">flattens</em><span id="A1.SS4.p7.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> and “small” eigenvalues are lifted to </span><math id="A1.SS4.p7.m1" class="ltx_Math" alttext="\approx\sigma_{t}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≈</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow><annotation encoding="application/x-tex">\approx\sigma_{t}^{2}</annotation></semantics></math><span id="A1.SS4.p7.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">. Their contribution is therefore indistinguishable from isotropic noise, which explains why including late timesteps or many tail eigenvalues does not improve OOD discrimination.</span></p>
</div>
</section>
<section id="A1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">A.5 </span>Proof of Ky Fan’s Theorem</h3>

<div id="A1.SS5.p1" class="ltx_para">
<p id="A1.SS5.p1.1" class="ltx_p"><span id="A1.SS5.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Prop. <a href="#Thmproposition2" title="Proposition 2 (Ky Fan’s theorem ( ) ). ‣ 3.5 EigenScore vs. MSE: Capturing Structure Instead of Collapse ‣ 3 Diffusion Model for Out-of-Distribution Detection ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</span><span id="A1.SS5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="A1.SS5.p1.1.3" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Let <math id="A1.SS5.p1.m1" class="ltx_Math" alttext="{\bm{\Sigma}}_{t}({\bm{x}}_{t})\succeq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⪰</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">{\bm{\Sigma}}_{t}({\bm{x}}_{t})\succeq 0</annotation></semantics></math> have eigenvalues <math id="A1.SS5.p1.m2" class="ltx_Math" alttext="\lambda^{t}_{1}\geq\cdots\geq\lambda^{t}_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.1389em">≥</mo><mo style="--ltx-fg-color:#000000;" lspace="0.1389em" mathcolor="#000000" rspace="0.1389em">⋯</mo><mo style="--ltx-fg-color:#000000;" lspace="0.1389em" mathcolor="#000000">≥</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow><annotation encoding="application/x-tex">\lambda^{t}_{1}\geq\cdots\geq\lambda^{t}_{n}</annotation></semantics></math> with eigenvectors forming <math id="A1.SS5.p1.m3" class="ltx_Math" alttext="{\bm{U}}_{t}=[{\bm{u}}^{t}_{1},\dots,{\bm{u}}^{t}_{n}]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐮</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐮</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{U}}_{t}=[{\bm{u}}^{t}_{1},\dots,{\bm{u}}^{t}_{n}]</annotation></semantics></math>. For any <math id="A1.SS5.p1.m4" class="ltx_Math" alttext="K\!\in\!\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">K\!\in\!\{1,\dots,n\}</annotation></semantics></math>,</span></p>
<table id="A1.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex30.m1" class="ltx_math_unparsed" alttext="\max_{{\bm{V}}\in\mathbb{R}^{n\times K}:\ {\bm{V}}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}}\ \mathrm{tr}~\big({\bm{V}}^{\mathsf{T}}{\bm{\Sigma}}_{t}({\bm{x}}_{t}){\bm{V}}\big)\;=\;\sum_{k=1}^{K}\lambda_{k}," display="block" intent=":literal"><semantics><mrow><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">max</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msup><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.688em">:</mo><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow></mrow></munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mrow><mo style="--ltx-fg-color:#000000;" lspace="0.330em" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.391em">=</mo><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\max_{{\bm{V}}\in\mathbb{R}^{n\times K}:\ {\bm{V}}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}}\ \mathrm{tr}~\big({\bm{V}}^{\mathsf{T}}{\bm{\Sigma}}_{t}({\bm{x}}_{t}){\bm{V}}\big)\;=\;\sum_{k=1}^{K}\lambda_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p1.2" class="ltx_p"><span id="A1.SS5.p1.2.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">and a maximizer is <math id="A1.SS5.p1.m5" class="ltx_Math" alttext="{\bm{V}}^{\star}=[{\bm{u}}^{t}_{1},\dots,{\bm{u}}^{t}_{K}]" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐕</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋆</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐮</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐮</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{V}}^{\star}=[{\bm{u}}^{t}_{1},\dots,{\bm{u}}^{t}_{K}]</annotation></semantics></math>.
</span></p>
</div>
<div id="A1.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="A1.SS5.p2" class="ltx_para">
<p id="A1.SS5.p2.1" class="ltx_p"><span id="A1.SS5.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let <math id="A1.SS5.p2.m1" class="ltx_Math" alttext="{\bm{V}}\in\mathbb{R}^{n\times K}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{V}}\in\mathbb{R}^{n\times K}</annotation></semantics></math> with <math id="A1.SS5.p2.m2" class="ltx_Math" alttext="{\bm{V}}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{V}}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}</annotation></semantics></math>. Write <math id="A1.SS5.p2.m3" class="ltx_Math" alttext="{\bm{\Sigma}}_{t}({\bm{x}}_{t})={\bm{U}}_{t}\Lambda_{t}{\bm{U}}_{t}^{\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\bm{\Sigma}}_{t}({\bm{x}}_{t})={\bm{U}}_{t}\Lambda_{t}{\bm{U}}_{t}^{\mathsf{T}}</annotation></semantics></math> with <math id="A1.SS5.p2.m4" class="ltx_Math" alttext="{\bm{U}}^{t}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msup><annotation encoding="application/x-tex">{\bm{U}}^{t}</annotation></semantics></math> orthogonal.
Set <math id="A1.SS5.p2.m5" class="ltx_Math" alttext="{\bm{Q}}\coloneqq{\bm{U}}_{t}^{\mathsf{T}}{\bm{V}}\in\mathbb{R}^{n\times K}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≔</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}\coloneqq{\bm{U}}_{t}^{\mathsf{T}}{\bm{V}}\in\mathbb{R}^{n\times K}</annotation></semantics></math>. Since <math id="A1.SS5.p2.m6" class="ltx_Math" alttext="{\bm{U}}_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">{\bm{U}}_{t}</annotation></semantics></math> is orthogonal, <math id="A1.SS5.p2.m7" class="ltx_Math" alttext="{\bm{Q}}^{\mathsf{T}}{\bm{Q}}={\bm{V}}^{\mathsf{T}}{\bm{U}}_{t}{\bm{U}}_{t}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{\mathsf{T}}{\bm{Q}}={\bm{V}}^{\mathsf{T}}{\bm{U}}_{t}{\bm{U}}_{t}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}</annotation></semantics></math>,
so the columns of <math id="A1.SS5.p2.m8" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math> are orthonormal.</span></p>
</div>
<div id="A1.SS5.p3" class="ltx_para">
<p id="A1.SS5.p3.1" class="ltx_p"><span id="A1.SS5.p3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">We have</span></p>
<table id="A1.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex31.m1" class="ltx_Math" alttext="\mathrm{tr}({\bm{V}}^{\mathsf{T}}{\bm{\Sigma}}_{t}({\bm{x}}_{t}){\bm{V}})=\mathrm{tr}\big({\bm{V}}^{\mathsf{T}}{\bm{U}}_{t}\Lambda_{t}{\bm{U}}_{t}^{\mathsf{T}}{\bm{V}}\big)=\mathrm{tr}\big({\bm{Q}}^{\mathsf{T}}\Lambda_{t}{\bm{Q}}\big)=\sum_{i=1}^{n}\lambda^{t}_{i}\,\|q_{i}\|_{2}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></munderover><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\mathrm{tr}({\bm{V}}^{\mathsf{T}}{\bm{\Sigma}}_{t}({\bm{x}}_{t}){\bm{V}})=\mathrm{tr}\big({\bm{V}}^{\mathsf{T}}{\bm{U}}_{t}\Lambda_{t}{\bm{U}}_{t}^{\mathsf{T}}{\bm{V}}\big)=\mathrm{tr}\big({\bm{Q}}^{\mathsf{T}}\Lambda_{t}{\bm{Q}}\big)=\sum_{i=1}^{n}\lambda^{t}_{i}\,\|q_{i}\|_{2}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p3.2" class="ltx_p"><span id="A1.SS5.p3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">where <math id="A1.SS5.p3.m1" class="ltx_Math" alttext="q_{i}^{\mathsf{T}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msubsup><annotation encoding="application/x-tex">q_{i}^{\mathsf{T}}</annotation></semantics></math> denotes the <math id="A1.SS5.p3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th row of <math id="A1.SS5.p3.m3" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math> (so <math id="A1.SS5.p3.m4" class="ltx_Math" alttext="\|q_{i}\|_{2}^{2}\geq 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\|q_{i}\|_{2}^{2}\geq 0</annotation></semantics></math>). Because <math id="A1.SS5.p3.m5" class="ltx_Math" alttext="{\bm{Q}}^{\mathsf{T}}{\bm{Q}}={\bm{I}}_{K}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{Q}}^{\mathsf{T}}{\bm{Q}}={\bm{I}}_{K}</annotation></semantics></math>,</span></p>
<table id="A1.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex32.m1" class="ltx_Math" alttext="\sum_{i=1}^{n}\|q_{i}\|_{2}^{2}=\mathrm{tr}({\bm{Q}}^{\mathsf{T}}{\bm{Q}})=K,\qquad\text{and}\qquad\|q_{i}\|_{2}^{2}\leq 1\ \ \text{for all $i$}\ \ (\text{each row is a subvector of a unit vector})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></munderover><msubsup><mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="2.167em">,</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">and</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">for all </mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">each row is a subvector of a unit vector</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}\|q_{i}\|_{2}^{2}=\mathrm{tr}({\bm{Q}}^{\mathsf{T}}{\bm{Q}})=K,\qquad\text{and}\qquad\|q_{i}\|_{2}^{2}\leq 1\ \ \text{for all $i$}\ \ (\text{each row is a subvector of a unit vector}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS5.p3.3" class="ltx_p"><span id="A1.SS5.p3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Thus the objective is a linear functional of the nonnegative weights <math id="A1.SS5.p3.m6" class="ltx_Math" alttext="w_{i}\coloneqq\|q_{i}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≔</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow><annotation encoding="application/x-tex">w_{i}\coloneqq\|q_{i}\|_{2}^{2}</annotation></semantics></math> subject to
<math id="A1.SS5.p3.m7" class="ltx_Math" alttext="\sum_{i}w_{i}=K" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><annotation encoding="application/x-tex">\sum_{i}w_{i}=K</annotation></semantics></math> and <math id="A1.SS5.p3.m8" class="ltx_Math" alttext="0\leq w_{i}\leq 1" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">0\leq w_{i}\leq 1</annotation></semantics></math>. Since the eigenvalues are ordered
<math id="A1.SS5.p3.m9" class="ltx_Math" alttext="\lambda^{t}_{1}\geq\cdots\geq\lambda^{t}_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.1389em">≥</mo><mo style="--ltx-fg-color:#000000;" lspace="0.1389em" mathcolor="#000000" rspace="0.1389em">⋯</mo><mo style="--ltx-fg-color:#000000;" lspace="0.1389em" mathcolor="#000000">≥</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow><annotation encoding="application/x-tex">\lambda^{t}_{1}\geq\cdots\geq\lambda^{t}_{n}</annotation></semantics></math>, the sum <math id="A1.SS5.p3.m10" class="ltx_Math" alttext="\sum_{i}\lambda_{i}w_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}\lambda_{i}w_{i}</annotation></semantics></math> is maximized by assigning
<math id="A1.SS5.p3.m11" class="ltx_Math" alttext="w_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">w_{i}=1</annotation></semantics></math> for <math id="A1.SS5.p3.m12" class="ltx_Math" alttext="i=1,\ldots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,K</annotation></semantics></math> and <math id="A1.SS5.p3.m13" class="ltx_Math" alttext="w_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">w_{i}=0</annotation></semantics></math> otherwise (rearrangement/greedy argument), which yields</span></p>
<table id="A1.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex33.m1" class="ltx_Math" alttext="\max_{{\bm{V}}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}}\ \mathrm{tr}({\bm{V}}^{\mathsf{T}}{\bm{\Sigma}}{\bm{V}})\;=\;\sum_{i=1}^{K}\lambda^{t}_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">max</mi><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow></munder><mo lspace="0.667em">⁡</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">tr</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.391em">=</mo><mrow><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\max_{{\bm{V}}^{\mathsf{T}}{\bm{V}}={\bm{I}}_{K}}\ \mathrm{tr}({\bm{V}}^{\mathsf{T}}{\bm{\Sigma}}{\bm{V}})\;=\;\sum_{i=1}^{K}\lambda^{t}_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS5.p4" class="ltx_para">
<p id="A1.SS5.p4.1" class="ltx_p"><span id="A1.SS5.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">This maximum is attained by taking <math id="A1.SS5.p4.m1" class="ltx_Math" alttext="{\bm{Q}}=[\,{\bm{e}}_{1},\ldots,{\bm{e}}_{K}\,]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.170em" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒆</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒆</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}=[\,{\bm{e}}_{1},\ldots,{\bm{e}}_{K}\,]</annotation></semantics></math>, i.e., <math id="A1.SS5.p4.m2" class="ltx_Math" alttext="{\bm{V}}={\bm{U}}{\bm{Q}}=[\,{\bm{u}}^{t}_{1},\ldots,{\bm{u}}^{t}_{K}\,]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.170em" stretchy="false">[</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒖</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{V}}={\bm{U}}{\bm{Q}}=[\,{\bm{u}}^{t}_{1},\ldots,{\bm{u}}^{t}_{K}\,]</annotation></semantics></math>,
the matrix of the top-<math id="A1.SS5.p4.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> eigenvectors.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Additional details</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Computations of Eigenvalues</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">To compute the leading eigenvalues of the posterior covariance efficiently, we follow the Jacobian-free subspace iteration method introduced by </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite><span id="A2.SS1.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">. The algorithm approximates Jacobian–vector products using finite differences of the denoiser output, followed by QR orthogonalization to stabilize directions. Iteratively refining these directions yields approximate posterior principal components and their corresponding eigenvalues. This approach avoids the costly explicit Jacobian calculation while still capturing the dominant spectral structure of the denoising uncertainty. Algorithm </span><a href="#alg2" title="Algorithm 2 ‣ B.1 Computations of Eigenvalues ‣ Appendix B Additional details ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">2</span></a><span id="A2.SS1.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> reports the calculations of eigenvalues.</span></p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_float"><span id="alg2.5" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> <span id="alg2.6" class="ltx_text" style="font-size:90%;">Efficient computation of posterior principal components <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite></span></figcaption>
<div id="alg2.7" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <math id="alg2.l1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg2.l1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> (Number of PCs), </span><math id="alg2.l1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="alg2.l1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> (number of iterations), </span><math id="alg2.l1.m3" class="ltx_Math" alttext="{\mathsf{D}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathsf{D}}(\cdot)</annotation></semantics></math><span id="alg2.l1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> (MSE-optimal denoiser) , </span><math id="alg2.l1.m4" class="ltx_Math" alttext="{\bm{y}}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒚</mi><annotation encoding="application/x-tex">{\bm{y}}</annotation></semantics></math><span id="alg2.l1.6" class="ltx_text" style="--ltx-fg-color:#000000;"> (noisy input), </span><math id="alg2.l1.m5" class="ltx_Math" alttext="\sigma_{t}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{t}^{2}</annotation></semantics></math><span id="alg2.l1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> (noise variance), </span><math id="alg2.l1.m6" class="ltx_Math" alttext="c\ll 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≪</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">c\ll 1</annotation></semantics></math><span id="alg2.l1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> (linear approx. constant)
</span>
</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg2.l2.3" class="ltx_text" style="--ltx-fg-color:#000000;">Initialize </span><math id="alg2.l2.m1" class="ltx_Math" alttext="\{{\bm{v}}^{(i)}_{0}\}_{i=1}^{N}\sim\mathcal{N}(0,\sigma_{t}^{2}{\bm{I}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑰</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{{\bm{v}}^{(i)}_{0}\}_{i=1}^{N}\sim\mathcal{N}(0,\sigma_{t}^{2}{\bm{I}})</annotation></semantics></math><span id="alg2.l2.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg2.l3.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">for</span><span id="alg2.l3.4" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l3.m1" class="ltx_Math" alttext="k\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">k\leftarrow 1</annotation></semantics></math><span id="alg2.l3.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l3.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">to</span><span id="alg2.l3.7" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l3.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="alg2.l3.8" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l3.9" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">do</span><span id="alg2.l3.10" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg2.l4.3" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><span id="alg2.l4.4" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">for</span><span id="alg2.l4.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l4.m1" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math><span id="alg2.l4.6" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l4.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">to</span><span id="alg2.l4.8" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="alg2.l4.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="alg2.l4.9" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="alg2.l4.10" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">do</span><span id="alg2.l4.11" class="ltx_text" style="--ltx-fg-color:#000000;">
