<td id="A2.T5.5.1.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 2.0pt;"><span id="A2.T5.5.1.6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">3</span></td>
<td id="A2.T5.5.1.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 2.0pt;"><span id="A2.T5.5.1.6.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">3</span></td>
<td id="A2.T5.5.1.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 2.0pt;"><span id="A2.T5.5.1.6.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">3</span></td>
