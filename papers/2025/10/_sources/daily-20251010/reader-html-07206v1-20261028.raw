alse" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\|_{2}^{2}\Big]+\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]</annotation></semantics></math></td>
