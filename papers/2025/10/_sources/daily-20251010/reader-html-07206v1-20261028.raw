            <math id="alg2.l11.m1" class="ltx_Math" alttext="\lambda^{(i)}\leftarrow\dfrac{\sigma_{t}^{2}}{2c}\,\big\|{\mathsf{D}}\!\big({\bm{y}}+c\,{\bm{v}}^{(i)}_{K-1}\big)-{\mathsf{D}}\!\big({\bm{y}}-c\,{\bm{v}}^{(i)}_{K-1})\big\|" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mpadded style="width:0.580em;" width="0.580em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi></mpadded><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒚</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mpadded style="width:0.580em;" width="0.580em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi></mpadded><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒚</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda^{(i)}\leftarrow\dfrac{\sigma_{t}^{2}}{2c}\,\big\|{\mathsf{D}}\!\big({\bm{y}}+c\,{\bm{v}}^{(i)}_{K-1}\big)-{\mathsf{D}}\!\big({\bm{y}}-c\,{\bm{v}}^{(i)}_{K-1})\big\|</annotation></semantics></math><span id="alg2.l11.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
