<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" mins