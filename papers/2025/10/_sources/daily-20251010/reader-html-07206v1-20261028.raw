            <math id="alg2.l10.m1" class="ltx_Math" alttext="{\bm{v}}^{(i)}\leftarrow{\bm{v}}^{(i)}_{K}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒗</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">{\bm{v}}^{(i)}\leftarrow{\bm{v}}^{(i)}_{K}</annotation></semantics></math><span id="alg2.l10.3" class="ltx_text" style="--ltx-fg-color:#000000;">
