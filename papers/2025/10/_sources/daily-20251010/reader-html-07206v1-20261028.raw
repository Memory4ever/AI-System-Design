<span class="ltx_bibblock"><span id="bib.bib70.5" class="ltx_text" style="--ltx-fg-color:#000000;">“Improved Contrastive Divergence Training of Energy-Based Models”,
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib70.6" class="ltx_text" style="--ltx-fg-color:#000000;">in </span><span id="bib.bib70.7" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Proc. ICML</span><span id="bib.bib70.8" class="ltx_text" style="--ltx-fg-color:#000000;">,
</span>
</span>
<span class="ltx_bibblock"><span id="bib.bib70.9" class="ltx_text" style="--ltx-fg-color:#000000;">2021.
</span>
</span></li>
    
</ul>
</section>
<div class="ltx_pagination ltx_role_newpage"></div>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proofs</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Connecting KL divergence with Denoising Error</h3>

<div id="A1.SS1.p1" class="ltx_para">
<p id="A1.SS1.p1.1" class="ltx_p"><span id="A1.SS1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Eq. (</span><a href="#S3.E4" title="Equation 4 ‣ 3.2 Uncertainty as a Signal of Distribution Shift ‣ 3 Diffusion Model for Out-of-Distribution Detection ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">4</span></a><span id="A1.SS1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">) is inspired from the work of </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite><span id="A1.SS1.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> [Theorem 1] and </span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">61</a>]</cite><span id="A1.SS1.p1.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> [Theorem 1], where KL divergence between two distribution is stated in terms of fisher divergence:</span></p>
</div>
<div id="A1.SS1.p2" class="ltx_para">
<table id="A1.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E12.m1" class="ltx_math_unparsed" alttext="\mathrm{D_{KL}}(p\;\|\;q)=\int_{0}^{\infty}\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\big\|\nabla\log p({\bm{x}}_{t})-\nabla\log q({\bm{x}}_{t})\big\|_{2}^{2}\Big]\sigma_{t}~\differential t." display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">KL</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.447em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msubsup><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="1.200em" rspace="0.167em">∥</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><msubsup><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="1.200em" rspace="0.167em">∥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{D_{KL}}(p\;\|\;q)=\int_{0}^{\infty}\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\big\|\nabla\log p({\bm{x}}_{t})-\nabla\log q({\bm{x}}_{t})\big\|_{2}^{2}\Big]\sigma_{t}~\differential t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p2.1" class="ltx_p"><span id="A1.SS1.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">By using the Tweedie’s formula from Eq. (</span><a href="#S2.E2" title="Equation 2 ‣ 2 Background ‣ EigenScore: OOD Detection using Posterior Covariance in Diffusion Models" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">2</span></a><span id="A1.SS1.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_math_unparsed" alttext="{\mathsf{D}}_{p}({\bm{x}}_{t})=\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]={\bm{x}}_{t}+\sigma_{t}^{2}\nabla\log p({\bm{x}}_{t})," display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝖣</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" lspace="0.167em" mathcolor="#000000" rspace="0.167em">∇</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">{\mathsf{D}}_{p}({\bm{x}}_{t})=\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]={\bm{x}}_{t}+\sigma_{t}^{2}\nabla\log p({\bm{x}}_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.2" class="ltx_p"><span id="A1.SS1.p2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">and replacing the score functions for distributions </span><math id="A1.SS1.p2.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math><span id="A1.SS1.p2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A1.SS1.p2.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math><span id="A1.SS1.p2.2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> with their corresponding MMSE estimators, we have:</span></p>
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex5.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathrm{D_{KL}}(p\;\|\;q)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">KL</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.447em">∥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{D_{KL}}(p\;\|\;q)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5.m2" class="ltx_Math" alttext="\displaystyle=\int_{0}^{\infty}\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]\sigma_{t}^{-3}~\differential t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msubsup></mstyle><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{\infty}\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]\sigma_{t}^{-3}~\differential t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13.m1" class="ltx_Math" alttext="\displaystyle=\int_{0}^{\infty}\Big\{\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]-\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]\Big\}\sigma_{t}^{-3}~\differential t," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∫</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msubsup></mstyle><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">‖</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒙</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{0}^{\infty}\Big\{\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{q}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]-\mathbb{E}_{{\bm{x}},{\bm{x}}_{t}}\Big[\|{\bm{x}}-\mathbb{E}_{p}[{\bm{x}}|{\bm{x}}_{t}]\big\|_{2}^{2}\Big]\Big\}\sigma_{t}^{-3}~\differential t,</annotation></semantics></math></td>
