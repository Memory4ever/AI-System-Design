<thead class="ltx_thead">
<tr id="A1.T5.2.1" class="ltx_tr">
<th id="A1.T5.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="A1.T5.2.1.1.1" class="ltx_text ltx_font_bold">Type</span></th>
<th id="A1.T5.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
