<td id="A6.T6.2.1.4.3" class="ltx_td ltx_align_center">0.96</td></tr>
<tr id="A6.T6.2.1.5" class="ltx_tr">
<td id="A6.T6.2.1.5.1" class="ltx_td ltx_align_left">Formality</td>
<td id="A6.T6.2.1.5.2" class="ltx_td ltx_align_center">0.95</td>
<td id="A6.T6.2.1.5.3" class="ltx_td ltx_align_center">0.94</td></tr>
<tr id="A6.T6.2.1.6" class="ltx_tr">
<td id="A6.T6.2.1.6.1" class="ltx_td ltx_align_left ltx_border_bb">Authorship</td>
<td id="A6.T6.2.1.6.2" class="ltx_td ltx_align_center ltx_border_bb">0.88</td>
<td id="A6.T6.2.1.6.3" class="ltx_td ltx_align_center ltx_border_bb">0.90</td></tr>
</table>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 6: </span>Accuracy of attribute-specific classifiers and their human evaluation consistency.</figcaption>
</figure>
<figure id="A6.T7" class="ltx_table">
<div id="A6.T7.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:162.2pt;height:17pt;vertical-align:-7.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-210.5pt,22.1pt) scale(0.278016659666993,0.278016659666993) ;">
