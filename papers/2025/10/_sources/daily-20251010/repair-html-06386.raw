<span id="S3.T1.2.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T1.2.1.2.1.1" class="ltx_p">Source Texts</span>
</span></td>
<td id="S3.T1.2.1.3" class="ltx_td ltx_align_left ltx_border_tt">
<span id="S3.T1.2.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T1.2.1.3.1.1" class="ltx_p">Target Texts</span>
</span></td></tr>
