<td id="A6.T6.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T6.2.1.1.2.1" class="ltx_text ltx_font_bold">Classifier Accuracy</span></td>
<td id="A6.T6.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T6.2.1.1.3.1" class="ltx_text ltx_font_bold">Human Consistency (500 samples)</span></td></tr>
<tr id="A6.T6.2.1.2" class="ltx_tr">
