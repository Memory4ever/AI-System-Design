            <span id="alg2.l13.3" class="ltx_text ltx_font_bold">for</span> each layer <math id="alg2.l13.m1" class="ltx_Math" alttext="l\in L" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l\in L</annotation></semantics></math> <span id="alg2.l13.4" class="ltx_text ltx_font_bold">do</span>

