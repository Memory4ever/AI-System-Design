ication/x-tex">\rightarrow</annotation></semantics></math> FC3: Linear(<math id="A6.T6.m17" class="ltx_Math" alttext="16\rightarrow 2" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo stretchy="false">→</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">16\rightarrow 2</annotation></semantics></math>).</span>
