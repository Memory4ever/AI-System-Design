<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Cluster path generation pseudocode</h2>

<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Cluster Formation and Path Generation</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <span id="alg2.l1.3" class="ltx_text ltx_font_bold">procedure</span> <span id="alg2.l1.4" class="ltx_text ltx_font_smallcaps">ClusteringAndPathGeneration</span>

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
            <span id="alg2.l2.3" class="ltx_text ltx_font_bold">Input:</span> Training set <math id="alg2.l2.m1" class="ltx_math_unparsed" alttext="X=\{x_{i}\in\mathbb{R}^{D}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>i</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></mrow><annotation encoding="application/x-tex">X=\{x_{i}\in\mathbb{R}^{D}\}_{i=1}^{N}</annotation></semantics></math>, network <math id="alg2.l2.m2" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math> with layer outputs <math id="alg2.l2.m3" class="ltx_Math" alttext="f_{\theta}^{(l)}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\theta}^{(l)}(x)</annotation></semantics></math>, layer set <math id="alg2.l2.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, number of clusters per layer <math id="alg2.l2.m5" class="ltx_Math" alttext="K&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K&gt;1</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
            <span id="alg2.l3.3" class="ltx_text ltx_font_bold">// Phase 1: Cluster Formation</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <span id="alg2.l4.3" class="ltx_text ltx_font_bold">for</span> each layer <math id="alg2.l4.m1" class="ltx_Math" alttext="l\in L" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l\in L</annotation></semantics></math> <span id="alg2.l4.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
             <math id="alg2.l5.m1" class="ltx_Math" alttext="A\leftarrow f_{\theta}^{(l)}(X)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">←</mo><mrow><msubsup><mi>f</mi><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A\leftarrow f_{\theta}^{(l)}(X)</annotation></semantics></math> <span id="alg2.l5.3" class="ltx_text" style="float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Compute activation features
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
             Perform clustering on <math id="alg2.l6.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> using <math id="alg2.l6.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> clusters

</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
             <math id="alg2.l7.m1" class="ltx_Math" alttext="C^{(l)}=\{C^{(l)}_{0},C^{(l)}_{1},\ldots,C^{(l)}_{K-1}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>C</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>C</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>C</mi><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">C^{(l)}=\{C^{(l)}_{0},C^{(l)}_{1},\ldots,C^{(l)}_{K-1}\}</annotation></semantics></math> <span id="alg2.l7.3" class="ltx_text" style="float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Store cluster centers
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
            <span id="alg2.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l8.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
            <span id="alg2.l9.3" class="ltx_text ltx_font_bold">End of Phase 1</span>

</div>
<div id="alg2.l10" class="ltx_listingline">
