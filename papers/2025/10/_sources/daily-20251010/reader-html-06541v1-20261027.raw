<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
            <span id="alg2.l12.3" class="ltx_text ltx_font_bold">Input:</span> A test input <math id="alg2.l12.m1" class="ltx_Math" alttext="x_{\nu}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>ν</mi></msub><annotation encoding="application/x-tex">x_{\nu}</annotation></semantics></math>

