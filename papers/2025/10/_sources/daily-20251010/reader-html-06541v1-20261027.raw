             <math id="alg2.l14.m1" class="ltx_Math" alttext="A\leftarrow f_{\theta}^{(l)}(x_{\nu})" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo stretchy="false">←</mo><mrow><msubsup><mi>f</mi><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>ν</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A\leftarrow f_{\theta}^{(l)}(x_{\nu})</annotation></semantics></math> <span id="alg2.l14.3" class="ltx_text" style="float:right;"><math id="alg2.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Compute activation features
