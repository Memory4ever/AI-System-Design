<th id="S4.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.5.1.2.1" class="ltx_text ltx_font_bold">CelebA</span></th>
<th id="S4.T3.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.5.1.3.1" class="ltx_text ltx_font_bold">SVHN</span></th>
<th id="S4.T3.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.5.1.4.1" class="ltx_text ltx_font_bold">CIFAR-10</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.5.2" class="ltx_tr">
<th id="S4.T3.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T3.5.2.1.1" class="ltx_ERROR undefined">\multirow</span>7*<span id="S4.T3.5.2.1.2" class="ltx_text ltx_font_bold">Outliers</span></th>
<td id="S4.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_t">Random Images</td>
<td id="S4.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_t">Random Images</td>
<td id="S4.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t">Random Images</td></tr>
