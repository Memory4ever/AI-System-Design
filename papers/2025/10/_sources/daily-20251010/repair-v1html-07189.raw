<td id="S5.T5.1.1.48.7" class="ltx_td ltx_align_right" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T5.1.1.48.7.1" class="ltx_text" style="font-size:90%;">8.5</span></td>
