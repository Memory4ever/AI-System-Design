</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 15.7)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:4.3em;--ltx-fo-depth:0.14em;font-size:10pt;" class="ltx_minipage" height="61.42" overflow="visible" transform="matrix(1 0 0 -1 0 59.5)" width="34.88em"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><pre id="A1.SS1.p1.pic1.2" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">Alfworld_Template = [
