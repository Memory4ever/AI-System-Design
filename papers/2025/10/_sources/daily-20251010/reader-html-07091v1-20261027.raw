</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 14.93)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:64.3em;--ltx-fo-depth:0.08em;font-size:10pt;" class="ltx_minipage" height="890.88" overflow="visible" transform="matrix(1 0 0 -1 0 889.73)" width="34.88em"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><pre id="A5.p2.pic1.2" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">ALFWorld_Distractors = [
