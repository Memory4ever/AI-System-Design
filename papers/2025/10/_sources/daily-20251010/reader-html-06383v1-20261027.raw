</span></td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.2.4.4.1" class="ltx_inline-block ltx_align_top" style="width:37.0pt;">
<span id="S4.T1.2.4.4.1.1" class="ltx_p ltx_align_right">0.992</span>
</span></td>
<td id="S4.T1.2.4.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="S4.T1.2.4.5.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S4.T1.2.4.5.1.1" class="ltx_p ltx_align_right">0.979</span>
</span></td>
<td id="S4.T1.2.4.6" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.2.4.6.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
