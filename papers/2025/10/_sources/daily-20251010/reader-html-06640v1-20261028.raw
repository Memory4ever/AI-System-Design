<td id="A3.T2.2.1.14.13" class="ltx_td ltx_align_center ltx_border_bb"><math id="A3.T2.m124" class="ltx_Math" alttext="3.328" display="inline" intent=":literal"><semantics><mn>3.328</mn><annotation encoding="application/x-tex">3.328</annotation></semantics></math></td></tr>
