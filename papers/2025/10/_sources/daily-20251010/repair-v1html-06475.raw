<td id="S1.T1.2.1.10.12" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S1.T1.2.1.10.12.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td></tr>
