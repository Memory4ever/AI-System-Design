<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Breakdown Description of Puzzles</h3>

<figure id="A1.F5" class="ltx_figure"><span class="ltx_inline-block"><svg id="A1.F5.pic1" class="ltx_picture" height="607.26" overflow="visible" version="1.1" viewBox="0 0 653.15 607.26" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,607.26) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 601.35 C 0 604.61 2.64 607.26 5.91 607.26 L 647.24 607.26 C 650.51 607.26 653.15 604.61 653.15 601.35 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 585.84 L 651.18 585.84 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 591.74)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
