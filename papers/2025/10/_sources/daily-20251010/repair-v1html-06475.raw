<td id="S2.T2.2.11.4" class="ltx_td ltx_align_center">0.24 <math id="S2.T2.m43" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.18</td>
<td id="S2.T2.2.11.5" class="ltx_td ltx_align_center">0.28 <math id="S2.T2.m44" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.24</td>
<td id="S2.T2.2.11.6" class="ltx_td ltx_align_center">0.25 <math id="S2.T2.m45" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.09</td></tr>
<tr id="S2.T2.2.12" class="ltx_tr">
<th id="S2.T2.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Llama-3.3-70B</th>
<td id="S2.T2.2.12.2" class="ltx_td ltx_align_center">0.15 <math id="S2.T2.m46" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.37</td>
<td id="S2.T2.2.12.3" class="ltx_td ltx_align_center">0.12 <math id="S2.T2.m47" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.39</td>
<td id="S2.T2.2.12.4" class="ltx_td ltx_align_center">0.31 <math id="S2.T2.m48" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.12</td>
<td id="S2.T2.2.12.5" class="ltx_td ltx_align_center">0.31 <math id="S2.T2.m49" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.12</td>
<td id="S2.T2.2.12.6" class="ltx_td ltx_align_center">0.25 <math id="S2.T2.m50" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.07</td></tr>
<tr id="S2.T2.2.13" class="ltx_tr">
<th id="S2.T2.2.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gemma-3-27B</th>
<td id="S2.T2.2.13.2" class="ltx_td ltx_align_center">0.13 <math id="S2.T2.m51" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.38</td>
<td id="S2.T2.2.13.3" class="ltx_td ltx_align_center">0.12 <math id="S2.T2.m52" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.39</td>
<td id="S2.T2.2.13.4" class="ltx_td ltx_align_center">0.23 <math id="S2.T2.m53" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.12</td>
