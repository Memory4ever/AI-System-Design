<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span><span id="A1.2" class="ltx_text ltx_font_smallcaps">PuzzlePlex</span></h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Dataset Overview</h3>

<figure id="A1.T6" class="ltx_table">
<div id="A1.T6.2" class="ltx_inline-block ltx_transformed_outer" style="width:345.0pt;height:132pt;vertical-align:-64.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-151.1pt,57.8pt) scale(0.533008689581124,0.533008689581124) ;">
<table id="A1.T6.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
