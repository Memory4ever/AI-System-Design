<td id="S2.T2.2.14.5" class="ltx_td ltx_align_center ltx_border_bb">0.17 <math id="S2.T2.m59" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.05</td>
