<th id="S5.T1.2.1.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.10.1" class="ltx_text ltx_font_bold">Overall</span></th>
<th id="S5.T1.2.1.2.11" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.11.1" class="ltx_text ltx_font_bold">Combined</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.2.1.3" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<th id="S5.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.3.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">Gemini-2.5-Pro</span></th>
<td id="S5.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.3.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">1272.0</span></td>
<td id="S5.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.3.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">1187.8</span></td>
