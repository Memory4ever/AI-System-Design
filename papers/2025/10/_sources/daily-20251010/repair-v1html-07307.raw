<th id="S5.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.4.1" class="ltx_text ltx_font_bold">Vision</span></th>
<th id="S5.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.5.1" class="ltx_text ltx_font_bold">Overall</span></th>
<th id="S5.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.6.1" class="ltx_text ltx_font_bold">Vision</span></th>
<th id="S5.T1.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.7.1" class="ltx_text ltx_font_bold">NLP/Tab.</span></th>
<th id="S5.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S5.T1.2.1.2.8.1" class="ltx_text ltx_font_bold">Audio</span></th>
