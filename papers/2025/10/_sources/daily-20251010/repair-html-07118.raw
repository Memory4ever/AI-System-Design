<td id="A4.T5.2.6.1" class="ltx_td ltx_align_left ltx_border_b"><span id="A4.T5.2.6.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-bg-color:#EBEBEB;">Total Corpus</span></td>
<td id="A4.T5.2.6.2" class="ltx_td ltx_align_center ltx_border_b"><math id="A4.T5.m5" class="ltx_Math" style="--ltx-bg-color:#EBEBEB;" alttext="270{,}679" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#EBEBEB;" mathbackground="#EBEBEB">270,679</mn><annotation encoding="application/x-tex">270{,}679</annotation></semantics></math></td>
