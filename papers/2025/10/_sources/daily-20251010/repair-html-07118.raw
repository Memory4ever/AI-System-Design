<tr id="A4.T5.2.4.3.1.2" class="ltx_tr">
<td id="A4.T5.2.4.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">conversations.</td></tr>
</table></td></tr>
<tr id="A4.T5.2.5" class="ltx_tr">
<td id="A4.T5.2.5.1" class="ltx_td ltx_align_left"><span id="A4.T5.2.5.1.1" class="ltx_text ltx_font_smallcaps">Flan_v2</span></td>
<td id="A4.T5.2.5.2" class="ltx_td ltx_align_center"><math id="A4.T5.m4" class="ltx_Math" alttext="100{,}000" display="inline" intent=":literal"><semantics><mn>100,000</mn><annotation encoding="application/x-tex">100{,}000</annotation></semantics></math></td>
<td id="A4.T5.2.5.3" class="ltx_td ltx_align_left">
<table id="A4.T5.2.5.3.1" class="ltx_tabular ltx_align_top">
<tr id="A4.T5.2.5.3.1.1" class="ltx_tr">
<td id="A4.T5.2.5.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Mixture of diverse tasks</td></tr>
<tr id="A4.T5.2.5.3.1.2" class="ltx_tr">
<td id="A4.T5.2.5.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">for instruction finetuning.</td></tr>
</table></td></tr>
