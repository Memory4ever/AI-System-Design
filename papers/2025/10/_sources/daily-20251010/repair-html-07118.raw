<td id="A4.T5.2.4.2" class="ltx_td ltx_align_center"><math id="A4.T5.m3" class="ltx_Math" alttext="55{,}668" display="inline" intent=":literal"><semantics><mn>55,668</mn><annotation encoding="application/x-tex">55{,}668</annotation></semantics></math></td>
<td id="A4.T5.2.4.3" class="ltx_td ltx_align_left">
