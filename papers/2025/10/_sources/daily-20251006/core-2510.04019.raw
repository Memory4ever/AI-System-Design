<p id="A1.I1.i4.p1.1" class="ltx_p"><math id="A1.I1.i4.p1.m1" class="ltx_Math" alttext="\text{temperature}\in\{0.5,0.9\}" display="inline" intent=":literal"><semantics><mrow><mtext>temperature</mtext><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.5</mn><mo>,</mo><mn>0.9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\text{temperature}\in\{0.5,0.9\}</annotation></semantics></math></p>
</div></li>
