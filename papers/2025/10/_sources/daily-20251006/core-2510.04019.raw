<div id="A1.I1.i5.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i5.p1.1" class="ltx_p">learning rate <math id="A1.I1.i5.p1.m1" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math> 5e-6</p>
</div></li>
<li id="A1.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i6.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i6.p1.1" class="ltx_p">LoRA:</p>
<ul id="A1.I1.i6.I1" class="ltx_itemize">
<li id="A1.I1.i6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I1.i6.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
