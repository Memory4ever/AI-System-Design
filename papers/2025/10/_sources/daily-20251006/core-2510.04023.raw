<td id="S5.T2.4.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">
<span id="S5.T2.4.2.1.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;--ltx-bg-color:#FFFFFF;">
