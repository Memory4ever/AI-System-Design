<span id="S6.T3.6.21.1.1.1" class="ltx_p"><span id="S6.T3.6.21.1.1.1.1" class="ltx_text" style="font-size:70%;">ARCADE </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S6.T3.6.21.1.1.1.2" class="ltx_text" style="font-size:70%;">(</span><a href="#bib.bib196" title="" class="ltx_ref">Yin et al., 2022</a><span id="S6.T3.6.21.1.1.1.4" class="ltx_text" style="font-size:70%;">)</span></cite></span>
</span></td>
<td id="S6.T3.6.21.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;">
