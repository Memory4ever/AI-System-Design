<span id="S4.F5.pic1.4.4" class="ltx_p"><span id="S4.F5.pic1.4.4.1" class="ltx_text ltx_font_bold" style="font-size:144%;">Visualization</span></span>
</span></span></span></foreignObject></g><g style="--ltx-fill-color:#D9D9FF;" fill="#D9D9FF"><path d="M 680.72 29.53 L 578.6 29.53 C 577.07 29.53 575.84 28.29 575.84 26.76 L 575.84 -26.76 C 575.84 -28.29 577.07 -29.53 578.6 -29.53 L 680.72 -29.53 C 682.25 -29.53 683.48 -28.29 683.48 -26.76 L 683.48 26.76 C 683.48 28.29 682.25 29.53 680.72 29.53 Z M 575.84 -29.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 580.45 15.28)"><foreignObject style="--ltx-fo-width:4.29em;--ltx-fo-height:0.64em;--ltx-fo-depth:2.85em;font-size:10pt;" height="48.26" overflow="visible" transform="matrix(1 0 0 -1 0 8.86)" width="59.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.F5.pic1.5" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:4.29em;">
<span id="S4.F5.pic1.5.1" class="ltx_p"></span>
<span id="S4.F5.pic1.5.2" class="ltx_inline-block fas fa-cogs" aria-hidden="true">
</span>
