<p id="A3.SS0.SSS0.Px3.p8.1" class="ltx_p"><span id="A3.SS0.SSS0.Px3.p8.1.1" class="ltx_text ltx_break ltx_framed_verbatim ltx_verbatim ltx_font_typewriter ltx_framed ltx_framed_rectangle ltx_inline-block" style="width:345.0pt;border-width:0.4pt;padding:3.0pt;"><span id="A3.SS0.SSS0.Px3.p8.1.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:345.0pt;">
