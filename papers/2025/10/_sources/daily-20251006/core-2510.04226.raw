<th id="S6.T3.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S6.T3.m1" class="ltx_Math" alttext="\widehat{\beta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathsize="0.900em">β</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\beta}</annotation></semantics></math></th>
