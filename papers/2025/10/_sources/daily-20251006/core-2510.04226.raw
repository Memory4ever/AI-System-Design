</span>
</div>
<div id="algorithm1.4.9" class="ltx_listingline"><span id="algorithm1.4.9.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.9.2" class="ltx_text" style="font-size:90%;">  scores = [];
</span>
</div>
<div id="algorithm1.4.10" class="ltx_listingline"><span id="algorithm1.4.10.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.10.2" class="ltx_text" style="font-size:90%;">  </span><span id="algorithm1.4.10.3" class="ltx_text ltx_font_bold" style="font-size:90%;">forall</span><span id="algorithm1.4.10.4" class="ltx_text" style="font-size:90%;"> </span><math id="algorithm1.m11" class="ltx_Math" alttext="c_{k}\in" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">k</mi></msub><mo mathsize="0.900em">∈</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c_{k}\in</annotation></semantics></math><span id="algorithm1.4.10.5" class="ltx_text" style="font-size:90%;"> candidates </span><span id="algorithm1.4.10.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span>
</div>
<div id="algorithm1.4.11" class="ltx_listingline"><span id="algorithm1.4.11.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.11.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.11.3" class="ltx_text" style="font-size:90%;">  </span><span id="algorithm1.4.11.4" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="algorithm1.4.11.5" class="ltx_text" style="font-size:90%;"> entails(</span><math id="algorithm1.m12" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math><span id="algorithm1.4.11.6" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m13" class="ltx_Math" alttext="c_{j}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">j</mi></msub><annotation encoding="application/x-tex">c_{j}</annotation></semantics></math><span id="algorithm1.4.11.7" class="ltx_text" style="font-size:90%;">) &amp; entails(</span><math id="algorithm1.m14" class="ltx_Math" alttext="c_{j}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">j</mi></msub><annotation encoding="application/x-tex">c_{j}</annotation></semantics></math><span id="algorithm1.4.11.8" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m15" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math><span id="algorithm1.4.11.9" class="ltx_text" style="font-size:90%;">) </span><span id="algorithm1.4.11.10" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span>
</div>
<div id="algorithm1.4.12" class="ltx_listingline"><span id="algorithm1.4.12.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.12.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.12.3" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.12.4" class="ltx_text" style="font-size:90%;">  scores.append(entail_prob(</span><math id="algorithm1.m16" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math><span id="algorithm1.4.12.5" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m17" class="ltx_Math" alttext="c_{j}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">j</mi></msub><annotation encoding="application/x-tex">c_{j}</annotation></semantics></math><span id="algorithm1.4.12.6" class="ltx_text" style="font-size:90%;">) * entail_prob(</span><math id="algorithm1.m18" class="ltx_Math" alttext="c_{j}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">j</mi></msub><annotation encoding="application/x-tex">c_{j}</annotation></semantics></math><span id="algorithm1.4.12.7" class="ltx_text" style="font-size:90%;">, </span><math id="algorithm1.m19" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math><span id="algorithm1.4.12.8" class="ltx_text" style="font-size:90%;">));
</span>
</div>
<div id="algorithm1.4.13" class="ltx_listingline"><span id="algorithm1.4.13.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.4.13.2" class="ltx_text" style="font-size:90%;">  </span><span id="algorithm1.4.13.3" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="algorithm1.4.13.4" class="ltx_text" style="font-size:90%;"> len(scores) == 0 </span><span id="algorithm1.4.13.5" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span>
</div>
