<span id="A5.T12.2.1.1.1.1.1.3.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">43.67</span>
<span id="A5.T12.2.1.1.1.1.1.3.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">51.26</span></span>
<span id="A5.T12.2.1.1.1.1.1.4" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<span id="A5.T12.2.1.1.1.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A5.T12.2.1.1.1.1.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Ours</span></span>
<span id="A5.T12.2.1.1.1.1.1.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A5.T12.2.1.1.1.1.1.4.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">55.53</span></span>
