<span id="A5.T12.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:249.9pt;height:49.6pt;vertical-align:-22.3pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
