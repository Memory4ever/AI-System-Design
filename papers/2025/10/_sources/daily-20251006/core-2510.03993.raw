<span id="A5.T11.2.1.1.1.1.1.4.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A5.T11.2.1.1.1.1.1.4.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">77.78</span></span></span>
