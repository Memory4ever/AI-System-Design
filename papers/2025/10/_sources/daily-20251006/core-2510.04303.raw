<td id="S6.T1.2.4.2" class="ltx_td ltx_align_center">1.000</td>
<td id="S6.T1.2.4.3" class="ltx_td ltx_align_center">1.000</td>
<td id="S6.T1.2.4.4" class="ltx_td ltx_align_center">0.000</td></tr>
<tr id="S6.T1.2.5" class="ltx_tr">
