<span id="A1.SS2.p7.pic1.3" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.21em;">
<span id="A1.SS2.p7.pic1.3.1" class="ltx_p"><span id="A1.SS2.p7.pic1.3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">U2 pitches for Apple New iTunes ads airing during</span></span>
<span id="A1.SS2.p7.pic1.3.2" class="ltx_p"><span id="A1.SS2.p7.pic1.3.2.1" class="ltx_text ltx_font_bold ltx_framed ltx_framed_rectangle" style="--ltx-fg-color:#000000;--ltx-bg-color:#E6E6FF;--ltx-border-color:#0000FF;">mn</span><span id="A1.SS2.p7.pic1.3.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">baseball games Tuesday will feature the advertising-shy Irish rockers.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
