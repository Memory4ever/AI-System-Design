</span>
<span id="lstnumberx97" class="ltx_listingline"><span id="lstnumberx97.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx97.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">count</span><span id="lstnumberx97.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx97.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx97.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx97.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">0</span>
</span>
<span id="lstnumberx98" class="ltx_listingline"><span id="lstnumberx98.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">    </span><span id="lstnumberx98.2" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#008000;">#<span id="lstnumberx98.2.1" class="ltx_text ltx_lst_space"> </span>Generate<span id="lstnumberx98.2.2" class="ltx_text ltx_lst_space"> </span>all<span id="lstnumberx98.2.3" class="ltx_text ltx_lst_space"> </span>4-digit<span id="lstnumberx98.2.4" class="ltx_text ltx_lst_space"> </span>combinations<span id="lstnumberx98.2.5" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx98.2.6" class="ltx_text ltx_lst_space"> </span>1<span id="lstnumberx98.2.7" class="ltx_text ltx_lst_space"> </span>and<span id="lstnumberx98.2.8" class="ltx_text ltx_lst_space"> </span>3</span>
</span>
