</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:51.72em;--ltx-fo-height:45.94em;--ltx-fo-depth:0em;font-size:10pt;" height="635.73" overflow="visible" transform="matrix(1 0 0 -1 0 635.73)" width="715.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A7.T5a.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:51.72em;">
<span id="A7.T5a.pic1.2.1" class="ltx_p"><span id="A7.T5a.pic1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000000;">Problem:<span id="A7.T5a.pic1.2.1.1.1" class="ltx_text ltx_font_medium"> 
<br class="ltx_break">Given the line <math id="A7.T5a.pic1.m1" class="ltx_Math" alttext="x-y-1=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">x-y-1=0</annotation></semantics></math> and the parabola <math id="A7.T5a.pic1.m2" class="ltx_Math" alttext="y=ax^{2}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">y=ax^{2}</annotation></semantics></math> are tangent to each other, find the value of <math id="A7.T5a.pic1.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.</span></span></span>
<span id="A7.T5a.pic1.2.2" class="ltx_p"><span id="A7.T5a.pic1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-fg-color:#000000;">Code:<span id="A7.T5a.pic1.2.2.1.1" class="ltx_text"></span></span></span>
<span id="A7.T5a.pic1.2.3" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx126" class="ltx_listingline"><span id="lstnumberx126.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#0000FF;">import</span><span id="lstnumberx126.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">sympy</span><span id="lstnumberx126.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">as</span><span id="lstnumberx126.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx126.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">sp</span>
</span>
<span id="lstnumberx127" class="ltx_listingline">
</span>
