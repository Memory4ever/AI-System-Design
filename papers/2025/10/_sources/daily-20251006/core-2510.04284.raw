<span id="A2.T5.2.1.1.1.2.9.2.1" class="ltx_tabular ltx_align_middle">
<span id="A2.T5.2.1.1.1.2.9.2.1.1" class="ltx_tr">
<span id="A2.T5.2.1.1.1.2.9.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A2.T5.2.1.1.1.2.9.2.1.1.1.1" class="ltx_text ltx_font_bold">Comm.</span></span></span>
