<span id="S4.T2.2.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_2"><span id="S4.T2.2.1.1.1.1.5.1" class="ltx_text ltx_font_bold">Patient Experience</span></span></span>
