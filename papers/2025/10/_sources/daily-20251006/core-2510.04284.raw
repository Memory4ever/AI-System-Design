<div id="S4.T2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:577.9pt;height:194.4pt;vertical-align:-94.7pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<p id="S4.T2.2.1" class="ltx_p"><span id="S4.T2.2.1.1" class="ltx_text">
<span id="S4.T2.2.1.1.1" class="ltx_tabular ltx_align_middle">
