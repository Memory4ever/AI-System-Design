<td id="S6.T3.2.1.6.3" class="ltx_td ltx_align_center ltx_border_t">83.2</td>
<td id="S6.T3.2.1.6.4" class="ltx_td ltx_align_center ltx_border_t">39.7</td>
<td id="S6.T3.2.1.6.5" class="ltx_td ltx_align_center ltx_border_t">52.2</td>
