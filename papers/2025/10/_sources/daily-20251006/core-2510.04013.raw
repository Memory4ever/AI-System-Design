<section id="A3.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Prompting with Answer</h4>

<div id="A3.SS1.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px2.p1.1" class="ltx_p">This format uses a multi-turn chat interaction. In the first turn, the model is provided with context and asked to generate an answer to the question. In the second turn, it is asked to estimate its confidence in the answer it just provided.</p>
</div>
<div id="A3.SS1.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px2.p2.1" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_italic">Turn 1:</span></p>
</div>
<div id="A3.SS1.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<div id="A3.SS1.SSS0.Px2.p3.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64,VXNpbmcgdGhlIGZvbGxvd2luZyBjb250ZXh0LCBhbnN3ZXIgdGhlIHF1ZXN0aW9uIHRoYXQgZm9sbG93cyB3aXRoIGEgc2luZ2xlIHdvcmQgb3IgcGhyYXNlLiBEbyBub3QgcHJvdmlkZSBleHBsYW5hdGlvbnMgb3IgYWRkaXRpb25hbCBjb250ZXh0OgoKPiBDb250ZXh0Ogp7Q29udGV4dH0KCj4gUXVlc3Rpb246CntRdWVzdGlvbn0=" download="">⬇</a></div>
<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Using</span><span id="lstnumberx22.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx22.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">following</span><span id="lstnumberx22.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">context</span><span id="lstnumberx22.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx22.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">answer</span><span id="lstnumberx22.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx22.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">question</span><span id="lstnumberx22.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">that</span><span id="lstnumberx22.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">follows</span><span id="lstnumberx22.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">with</span><span id="lstnumberx22.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">a</span><span id="lstnumberx22.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">single</span><span id="lstnumberx22.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">word</span><span id="lstnumberx22.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx22.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">phrase</span><span id="lstnumberx22.31" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx22.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Do</span><span id="lstnumberx22.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">not</span><span id="lstnumberx22.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">provide</span><span id="lstnumberx22.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">explanations</span><span id="lstnumberx22.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx22.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">additional</span><span id="lstnumberx22.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">context</span><span id="lstnumberx22.46" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx23" class="ltx_listingline">
</div>
<div id="lstnumberx24" class="ltx_listingline"><span id="lstnumberx24.1" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx24.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Context</span><span id="lstnumberx24.4" class="ltx_text ltx_font_typewriter">:</span>
</div>
