<div id="lstnumberx10" class="ltx_listingline"><span id="lstnumberx10.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Please</span><span id="lstnumberx10.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">output</span><span id="lstnumberx10.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">your</span><span id="lstnumberx10.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">confidence</span><span id="lstnumberx10.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">in</span><span id="lstnumberx10.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx10.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">correctness</span><span id="lstnumberx10.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">of</span><span id="lstnumberx10.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx10.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">answer</span><span id="lstnumberx10.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">as</span><span id="lstnumberx10.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">an</span><span id="lstnumberx10.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">integer</span><span id="lstnumberx10.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">between</span><span id="lstnumberx10.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.29" class="ltx_text ltx_font_typewriter">0</span><span id="lstnumberx10.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">and</span><span id="lstnumberx10.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.33" class="ltx_text ltx_font_typewriter">100,</span><span id="lstnumberx10.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">where</span><span id="lstnumberx10.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.37" class="ltx_text ltx_font_typewriter">0</span><span id="lstnumberx10.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">means</span><span id="lstnumberx10.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">complete</span><span id="lstnumberx10.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">uncertainty</span><span id="lstnumberx10.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">and</span><span id="lstnumberx10.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.47" class="ltx_text ltx_font_typewriter">100</span><span id="lstnumberx10.48" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">means</span><span id="lstnumberx10.50" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">complete</span><span id="lstnumberx10.52" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">certainty</span><span id="lstnumberx10.54" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx10.55" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Output</span><span id="lstnumberx10.57" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">only</span><span id="lstnumberx10.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx10.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">confidence</span><span id="lstnumberx10.63" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.64" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">score</span><span id="lstnumberx10.65" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.66" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">with</span><span id="lstnumberx10.67" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">no</span><span id="lstnumberx10.69" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.70" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">explanations</span><span id="lstnumberx10.71" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.72" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx10.73" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.74" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">additional</span><span id="lstnumberx10.75" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.76" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">text</span><span id="lstnumberx10.77" class="ltx_text ltx_font_typewriter">.</span>
</div>
</div>
</div>
</section>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Logit Lens and Tuned Lens</h3>

<section id="A2.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Logit Lens:</h4>

<div id="A2.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px1.p1.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">Logit Lens</span> projects the intermediate hidden states directly into the vocabulary space via the unembedding matrix or final linear layer of the model <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib38" title="" class="ltx_ref">nostalgebraist, 2020</a>)</cite>.
Concretely, given a hidden state <math id="A2.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathbf{h}_{\ell}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mi mathvariant="normal">ℓ</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{h}_{\ell}\in\mathbb{R}^{d}</annotation></semantics></math> at layer <math id="A2.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, and the unembedding matrix <math id="A2.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\mathbf{W}_{U}\in\mathbb{R}^{V\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mi>U</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{W}_{U}\in\mathbb{R}^{V\times d}</annotation></semantics></math> (where <math id="A2.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is the vocabulary size and <math id="A2.SS2.SSS0.Px1.p1.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is the hidden size), the layer-wise logits under the logit lens are computed as: <math id="A2.SS2.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\mathbf{z}_{\ell}^{\text{(LL)}}=\mathbf{W}_{U}\mathbf{h}_{\ell}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL)</mtext></msubsup><mo>=</mo><mrow><msub><mi>𝐖</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐡</mi><mi mathvariant="normal">ℓ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{\ell}^{\text{(LL)}}=\mathbf{W}_{U}\mathbf{h}_{\ell}</annotation></semantics></math>.
For decoding, these logits are passed through a softmax as normal to produce a probability distribution over the vocabulary: <math id="A2.SS2.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\mathbf{p}_{\ell}^{\text{(LL)}}=\text{softmax}(\mathbf{z}_{\ell}^{\text{(LL)}})." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐩</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL)</mtext></msubsup><mo>=</mo><mrow><mtext>softmax</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL)</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{p}_{\ell}^{\text{(LL)}}=\text{softmax}(\mathbf{z}_{\ell}^{\text{(LL)}}).</annotation></semantics></math></p>
</div>
</section>
<section id="A2.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Tuned Lens:</h4>

<div id="A2.SS2.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px2.p1.1" class="ltx_p"><span id="A2.SS2.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_italic">Tuned Lens</span> first learns an affine transformation or <span id="A2.SS2.SSS0.Px2.p1.1.2" class="ltx_text ltx_font_italic">translator</span> for each layer and then projects the transformed hidden state directly to the vocabulary space via the unembedding matrix <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Belrose et al., 2023</a>)</cite>.
Since pretrained language models are typically not trained to project from intermediate hidden states to the unembedding matrix, there is often a mismatch.
<span id="A2.SS2.SSS0.Px2.p1.1.3" class="ltx_text ltx_font_italic">Tuned Lens</span> remediates this by post-hoc training these <span id="A2.SS2.SSS0.Px2.p1.1.4" class="ltx_text ltx_font_italic">translators</span> at each layer, improving intermediate hidden states alignment in both magnitude and direction to the unembedding matrix.
For each layer <math id="A2.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, the learned affine map <math id="A2.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="(\mathbf{A}_{\ell},\mathbf{b}_{\ell})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub><mo>,</mo><msub><mi>𝐛</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{A}_{\ell},\mathbf{b}_{\ell})</annotation></semantics></math> transforms the hidden state <math id="A2.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\mathbf{h}_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>𝐡</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\mathbf{h}_{\ell}</annotation></semantics></math> before multiplying with the unembedding matrix: <math id="A2.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\mathbf{z}_{\ell}^{\text{(TL)}}=\mathbf{W}_{U}(\mathbf{A}_{\ell}\mathbf{h}_{\ell}+\mathbf{b}_{\ell})." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi><mtext>(TL)</mtext></msubsup><mo>=</mo><mrow><msub><mi>𝐖</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝐀</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐡</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo>+</mo><msub><mi>𝐛</mi><mi mathvariant="normal">ℓ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{z}_{\ell}^{\text{(TL)}}=\mathbf{W}_{U}(\mathbf{A}_{\ell}\mathbf{h}_{\ell}+\mathbf{b}_{\ell}).</annotation></semantics></math>
The resulting logits can be passed through a softmax producing a probability distribution over the vocabulary: <math id="A2.SS2.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\mathbf{p}_{\ell}^{\text{(TL)}}=\text{softmax}(\mathbf{z}_{\ell}^{\text{(TL)}})." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐩</mi><mi mathvariant="normal">ℓ</mi><mtext>(TL)</mtext></msubsup><mo>=</mo><mrow><mtext>softmax</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi mathvariant="normal">ℓ</mi><mtext>(TL)</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{p}_{\ell}^{\text{(TL)}}=\text{softmax}(\mathbf{z}_{\ell}^{\text{(TL)}}).</annotation></semantics></math> The <span id="A2.SS2.SSS0.Px2.p1.1.5" class="ltx_text ltx_font_italic">translators</span> are trained to minimize the KL divergence between <math id="A2.SS2.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\mathbf{p}_{\ell}^{\text{(TL)}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐩</mi><mi mathvariant="normal">ℓ</mi><mtext>(TL)</mtext></msubsup><annotation encoding="application/x-tex">\mathbf{p}_{\ell}^{\text{(TL)}}</annotation></semantics></math> and the model’s final output distribution on general-purpose pretraining data.</p>
</div>
</section>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Input Feature Details for Logit Lens and Tuned Lens</h3>

<section id="A2.SS3.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Input Feature 1: Entropy</h4>

<div id="A2.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p1.1" class="ltx_p">Entropy measures the uncertainty in a probability distribution.
For us, entropy estimates how peaky (or uniform) the distribution over the vocabulary is at each token position at each layer.
Given a distribution over the vocabulary using either <span id="A2.SS3.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">Logit Lens</span> (LL) or <span id="A2.SS3.SSS0.Px1.p1.1.2" class="ltx_text ltx_font_italic">Tuned Lens</span> (TL), <math id="A2.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathbf{p}_{\ell}^{\text{(LL|TL)}}=\{p_{\ell}^{\text{(LL|TL)}}(i)\}_{i=1}^{V}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐩</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>p</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>V</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{p}_{\ell}^{\text{(LL|TL)}}=\{p_{\ell}^{\text{(LL|TL)}}(i)\}_{i=1}^{V}</annotation></semantics></math> at layer <math id="A2.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, the entropy <math id="A2.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="H_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">H_{\ell}</annotation></semantics></math> is defined as:</p>
<table id="A2.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E6.m1" class="ltx_math_unparsed" alttext="H_{\ell}=-\sum_{i=1}^{V}p_{\ell}^{\text{(LL|TL)}}(i)\log p_{\ell}^{\text{(LL|TL)}}(i)" display="block" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi mathvariant="normal">ℓ</mi></msub><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>V</mi></munderover><msubsup><mi>p</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup><mrow><mo stretchy="false">(</mo><mi>i</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><msubsup><mi>p</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{\ell}=-\sum_{i=1}^{V}p_{\ell}^{\text{(LL|TL)}}(i)\log p_{\ell}^{\text{(LL|TL)}}(i)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px1.p2.1" class="ltx_p">Note: these estimates are computed independently for each layer and sequence position.</p>
</div>
</section>
<section id="A2.SS3.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Input Feature 2: Rank of Output Token</h4>

<div id="A2.SS3.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p1.1" class="ltx_p">A probability of 0.01 in certain token positions may reflect the highest rank token if the preceding context is ambiguous (e.g. The ¡next_word¿), whereas could reflect a much lower rank token if the context is less ambiguous (e.g. Harriet Tub¡next_word¿)
The rank of the output next token at intermediate layers loosely correlates with the probability, but can offer a more direct signal towards what token a decoding algorithm may likely generate.
At layer <math id="A2.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, we compute either the <span id="A2.SS3.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_italic">Logit Lens</span> (LL) or <span id="A2.SS3.SSS0.Px2.p1.1.2" class="ltx_text ltx_font_italic">Tuned Lens</span> (TL) distribution <math id="A2.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\mathbf{p}_{\ell}^{\text{(LL|TL)}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐩</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup><annotation encoding="application/x-tex">\mathbf{p}_{\ell}^{\text{(LL|TL)}}</annotation></semantics></math>. Let <math id="A2.SS3.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\phi_{\ell}(t):=\log p_{\ell}^{\text{(LL|TL)}}(t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mi>p</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{\ell}(t):=\log p_{\ell}^{\text{(LL|TL)}}(t)</annotation></semantics></math> denote the log-probability of token <math id="A2.SS3.SSS0.Px2.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> under this distribution. We sort the vocabulary tokens by descending log-probability:</p>
</div>
<div id="A2.SS3.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<table id="A2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E7.m1" class="ltx_Math" alttext="\displaystyle\phi_{\ell}\big(\sigma(1)\big)\geq\phi_{\ell}\big(\sigma(2)\big)\geq\cdots\geq\phi_{\ell}\big(\sigma(V)\big)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ϕ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>ϕ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><mrow><msub><mi>ϕ</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi_{\ell}\big(\sigma(1)\big)\geq\phi_{\ell}\big(\sigma(2)\big)\geq\cdots\geq\phi_{\ell}\big(\sigma(V)\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px2.p3.1" class="ltx_p">Then, the <span id="A2.SS3.SSS0.Px2.p3.1.1" class="ltx_text ltx_font_italic">rank</span> <math id="A2.SS3.SSS0.Px2.p3.m1" class="ltx_Math" alttext="r_{\ell}(y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r_{\ell}(y)</annotation></semantics></math> of the target token <math id="A2.SS3.SSS0.Px2.p3.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is the index <math id="A2.SS3.SSS0.Px2.p3.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that <math id="A2.SS3.SSS0.Px2.p3.m4" class="ltx_Math" alttext="\sigma(k)=y" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">\sigma(k)=y</annotation></semantics></math>. A rank of <math id="A2.SS3.SSS0.Px2.p3.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> indicates the model considers <math id="A2.SS3.SSS0.Px2.p3.m6" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> the most likely token at that layer. This is computed per layer and position.</p>
</div>
</section>
<section id="A2.SS3.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Input Feature 3: Top-<math id="A2.SS3.SSS0.Px3.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> Presence</h4>

<div id="A2.SS3.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px3.p1.1" class="ltx_p">Nucleus-sampling is one of the most common decoding algorithms for language models <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib20" title="" class="ltx_ref">Holtzman et al., 2019</a>)</cite>, where rather than considering the entire distribution over the vocabulary, one considers only the highest probability tokens until a top-<math id="A2.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> cumulative probability.
This eliminates the chances of randomly sampling a very low probability token in the long-tail.
Motivated by this, we compute a binary indicator of whether the target token appears within the top-<math id="A2.SS3.SSS0.Px3.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> nucleus set at each layer.
Let <math id="A2.SS3.SSS0.Px3.p1.m3" class="ltx_Math" alttext="\mathbf{p}_{\ell}^{\text{(LL|TL)}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐩</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup><annotation encoding="application/x-tex">\mathbf{p}_{\ell}^{\text{(LL|TL)}}</annotation></semantics></math> be sorted in descending order as <math id="A2.SS3.SSS0.Px3.p1.m4" class="ltx_Math" alttext="p_{(1)}\geq p_{(2)}\geq\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>≥</mo><msub><mi>p</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msub><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">p_{(1)}\geq p_{(2)}\geq\cdots</annotation></semantics></math>. The top-<math id="A2.SS3.SSS0.Px3.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> nucleus set <math id="A2.SS3.SSS0.Px3.p1.m6" class="ltx_Math" alttext="V_{p}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>p</mi></msub><annotation encoding="application/x-tex">V_{p}</annotation></semantics></math> is the smallest set such that:</p>
<table id="A2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E8.m1" class="ltx_Math" alttext="\sum_{i=1}^{k}p_{(i)}\geq p" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>≥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{k}p_{(i)}\geq p</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px3.p1.2" class="ltx_p">The <span id="A2.SS3.SSS0.Px3.p1.2.1" class="ltx_text ltx_font_italic">top-<math id="A2.SS3.SSS0.Px3.p1.m7" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> presence</span> indicator <math id="A2.SS3.SSS0.Px3.p1.m8" class="ltx_Math" alttext="I_{p,\ell}(y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>p</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I_{p,\ell}(y)</annotation></semantics></math> is defined as:</p>
<table id="A2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E9.m1" class="ltx_Math" alttext="I_{p,\ell}(y)=\begin{cases}1&amp;\text{if }y\in V_{p}\\
0&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>I</mi><mrow><mi>p</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>∈</mo><msub><mi>V</mi><mi>p</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">I_{p,\ell}(y)=\begin{cases}1&amp;\text{if }y\in V_{p}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS3.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Input Feature 4: Cross-Entropy</h4>

<div id="A2.SS3.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px4.p1.1" class="ltx_p">Cross-entropy quantifies how well the intermediate predictions match the output next token.
At each layer <math id="A2.SS3.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>, it is computed using the log probability assigned to the target token <math id="A2.SS3.SSS0.Px4.p1.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> under the logit lens or tuned lens distribution:</p>
<table id="A2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E10.m1" class="ltx_Math" alttext="\text{CE}_{\ell}(y)=-\log p_{\ell}^{\text{(LL|TL)}}(y)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>CE</mtext><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mi>p</mi><mi mathvariant="normal">ℓ</mi><mtext>(LL—TL)</mtext></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{CE}_{\ell}(y)=-\log p_{\ell}^{\text{(LL|TL)}}(y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px4.p1.2" class="ltx_p">This value is lower when the model assigns higher confidence to the output token. It is evaluated per layer and token position.</p>
</div>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Methodology Details for RQ2</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Prompting</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">Below are the prompts used for RQ2 to elicit confidence estimates from the model. We explore two prompting formats: <span id="A3.SS1.p1.1.1" class="ltx_text ltx_font_italic">Prompting without Answer</span> and <span id="A3.SS1.p1.1.2" class="ltx_text ltx_font_italic">Prompting with Answer</span>.</p>
</div>
<section id="A3.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Prompting without Answer</h4>

<div id="A3.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p1.1" class="ltx_p">In this setting, the model is provided with context and is asked to estimate its confidence in answering the question correctly, without actually generating an answer. The prompt used is as follows:</p>
</div>
<div id="A3.SS1.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<div id="A3.SS1.SSS0.Px1.p2.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx11" class="ltx_listingline"><span id="lstnumberx11.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">For</span><span id="lstnumberx11.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx11.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">question</span><span id="lstnumberx11.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">below</span><span id="lstnumberx11.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx11.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">output</span><span id="lstnumberx11.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">your</span><span id="lstnumberx11.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">confidence</span><span id="lstnumberx11.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">in</span><span id="lstnumberx11.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">your</span><span id="lstnumberx11.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">ability</span><span id="lstnumberx11.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">to</span><span id="lstnumberx11.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">generate</span><span id="lstnumberx11.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx11.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">correct</span><span id="lstnumberx11.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">answer</span><span id="lstnumberx11.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">as</span><span id="lstnumberx11.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">an</span><span id="lstnumberx11.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">integer</span><span id="lstnumberx11.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">between</span><span id="lstnumberx11.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.40" class="ltx_text ltx_font_typewriter">0</span><span id="lstnumberx11.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">and</span><span id="lstnumberx11.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.44" class="ltx_text ltx_font_typewriter">100,</span><span id="lstnumberx11.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">where</span><span id="lstnumberx11.47" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.48" class="ltx_text ltx_font_typewriter">0</span><span id="lstnumberx11.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">means</span><span id="lstnumberx11.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">complete</span><span id="lstnumberx11.53" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">uncertainty</span><span id="lstnumberx11.55" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">and</span><span id="lstnumberx11.57" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.58" class="ltx_text ltx_font_typewriter">100</span><span id="lstnumberx11.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">means</span><span id="lstnumberx11.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">complete</span><span id="lstnumberx11.63" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.64" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">certainty</span><span id="lstnumberx11.65" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx11.66" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.67" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Provide</span><span id="lstnumberx11.68" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.69" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">only</span><span id="lstnumberx11.70" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx11.72" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">confidence</span><span id="lstnumberx11.74" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">score</span><span id="lstnumberx11.76" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx11.77" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.78" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">without</span><span id="lstnumberx11.79" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.80" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">answering</span><span id="lstnumberx11.81" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.82" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx11.83" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.84" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">question</span><span id="lstnumberx11.85" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.86" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx11.87" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.88" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">including</span><span id="lstnumberx11.89" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.90" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">any</span><span id="lstnumberx11.91" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.92" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">explanations</span><span id="lstnumberx11.93" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.94" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx11.95" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.96" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">additional</span><spa