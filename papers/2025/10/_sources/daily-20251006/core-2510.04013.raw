</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.F10.fig6" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:194.8pt;"><object type="image/svg+xml" data="2510.04013v1/x6.svg" id="A5.F10.g6" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:269/204;" width="269" height="204"></object>
