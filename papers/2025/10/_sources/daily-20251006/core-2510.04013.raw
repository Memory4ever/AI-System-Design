</div>
<div id="lstnumberx26" class="ltx_listingline">
</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx27.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Question</span><span id="lstnumberx27.4" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx28.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Question</span><span id="lstnumberx28.3" class="ltx_text ltx_font_typewriter">}</span>
</div>
</div>
</div>
<div id="A3.SS1.SSS0.Px2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px2.p4.1" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.1.1" class="ltx_text ltx_font_italic">Turn 2:</span></p>
</div>
<div id="A3.SS1.SSS0.Px2.p5" class="ltx_para ltx_noindent">
<div id="A3.SS1.SSS0.Px2.p5.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
