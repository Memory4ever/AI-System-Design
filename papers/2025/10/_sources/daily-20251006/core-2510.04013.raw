<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span>LLaMA 2 13B</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.F9.fig3" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:194.8pt;"><object type="image/svg+xml" data="2510.04013v1/llama2_7b.svg" id="A5.F9.g3" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:269/204;" width="269" height="204"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(c) </span>LLaMA 2 7B</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.F9.fig4" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:194.8pt;"><object type="image/svg+xml" data="2510.04013v1/gemma2_9b.svg" id="A5.F9.g4" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:269/204;" width="269" height="204"></object>
