<td id="S6.T3.2.1.7.3" class="ltx_td ltx_align_center"><span id="S6.T3.2.1.7.3.1" class="ltx_text ltx_font_bold">93.6</span></td>
<td id="S6.T3.2.1.7.4" class="ltx_td ltx_align_center">68.4</td>
