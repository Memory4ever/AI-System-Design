</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.F9.fig5" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:194.8pt;"><object type="image/svg+xml" data="2510.04013v1/qwen25_7b.svg" id="A5.F9.g5" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:269/204;" width="269" height="204"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(e) </span>Qwen 2.5 7B</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.F9.fig6" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:194.8pt;"><object type="image/svg+xml" data="2510.04013v1/qwen25_3b.svg" id="A5.F9.g6" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:269/204;" width="269" height="204"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(f) </span>Qwen 2.5 3B</figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 9: </span>ROC curves comparing classifiers trained on last-layer features (external) versus internal-layer features, across six models on TriviaQA.</figcaption>
</figure>
<figure id="A5.F10" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A5.F10.fig1" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:194.8pt;"><object type="image/svg+xml" data="2510.04013v1/x1.svg" id="A5.F10.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:269/204;" width="269" height="204"></object>
