<td id="S5.T4.fig2.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T4.fig2.1.2.3.1" class="ltx_text" style="font-size:80%;">35</span></td>
<td id="S5.T4.fig2.1.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T4.fig2.1.2.4.1" class="ltx_text" style="font-size:80%;">75</span></td>
