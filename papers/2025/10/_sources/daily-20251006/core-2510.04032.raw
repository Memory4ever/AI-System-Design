<td id="S3.T1.1.19.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T1.1.19.1.1" class="ltx_inline-block ltx_align_top" style="width:156.5pt;">
<span id="S3.T1.1.19.1.1.1" class="ltx_p"><span id="S3.T1.1.19.1.1.1.1" class="ltx_text ltx_font_bold">BERT-medical-NER</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite></span>
</span></td>
<td id="S3.T1.1.19.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T1.1.19.2.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T1.1.19.2.1.1" class="ltx_p">Primarily for Chinese medical entity recognition, included to explore multilingual support in Canadian EDs.</span>
</span></td></tr>
