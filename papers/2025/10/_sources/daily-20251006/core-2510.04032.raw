<span id="S3.T1.1.17.1.1.1" class="ltx_p"><span id="S3.T1.1.17.1.1.1.1" class="ltx_text ltx_font_bold">T5-medical-simplifier</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite></span>
</span></td>
<td id="S3.T1.1.17.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">
