<tr id="S4.T2.1.1.9" class="ltx_tr">
<th id="S4.T2.1.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">GTHUDM GLM-4-9B-chat</th>
<td id="S4.T2.1.1.9.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.5183</td>
<td id="S4.T2.1.1.9.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.6096</td>
