<tr id="S5.T2.3.3" class="ltx_tr">
<td id="S5.T2.3.3.1" class="ltx_td ltx_align_left" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T2.3.3.1.1" class="ltx_text" style="font-size:90%;">PCCSNet <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">57</a>]</cite></span></td>
<td id="S5.T2.3.3.2" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T2.3.3.2.1" class="ltx_text" style="font-size:90%;">107</span></td></tr>
<tr id="S5.T2.3.4" class="ltx_tr">
<td id="S5.T2.3.4.1" class="ltx_td ltx_align_left" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T2.3.4.1.1" class="ltx_text" style="font-size:90%;">BCDiff <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite></span></td>
