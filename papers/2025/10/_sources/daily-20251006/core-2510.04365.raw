<td id="S5.T2.3.5.2" class="ltx_td ltx_align_right" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T2.3.5.2.1" class="ltx_text" style="font-size:90%;">412</span></td></tr>
