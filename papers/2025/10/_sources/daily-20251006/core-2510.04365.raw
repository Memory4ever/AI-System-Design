<td id="S5.T3.3.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 3.8pt;" rowspan="2"><span id="S5.T3.3.1.3.1" class="ltx_text">LANS</span></td>
<td id="S5.T3.3.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 3.8pt;" colspan="2">ETH/UCY</td>
<td id="S5.T3.3.1.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 3.8pt;" colspan="2">SDD</td></tr>
