ub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mi>ln</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p(x_{T})p_{\theta}(x_{0}|x_{1})}{q(x_{1}|x_{0})}+\ln\frac{q(x_{1}|x_{0})}{q(x_{T}|x_{0})}+\ln\prod^{T}_{t=2}\frac{p_{\theta}(x_{t-1}|x_{t})}{q(x_{t-1}|x_{t},x_{0})}\right]</annotation></semantics></math></td>
