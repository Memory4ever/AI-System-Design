<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E41.m1" class="ltx_Math" alttext="\displaystyle\propto\mathcal{N}\left(x_{t-1};\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})x_{0}}{1-\bar{\alpha}_{t}},\frac{(1-\alpha_{t})(1-\bar{\alpha}_{t-1})}{1-\bar{\alpha}_{t}}I\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∝</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\mathcal{N}\left(x_{t-1};\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})x_{0}}{1-\bar{\alpha}_{t}},\frac{(1-\alpha_{t})(1-\bar{\alpha}_{t-1})}{1-\bar{\alpha}_{t}}I\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS2.p6" class="ltx_para">
<p id="A1.SS1.SSS2.p6.1" class="ltx_p">From Eq. <a href="#A1.E41" title="Equation 41 ‣ A.1.2 Proof of Lemma-2 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a> it can be seen that,</p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_Math" alttext="\sigma^{2}_{q}(t)=\frac{(1-\alpha_{t})(1-\bar{\alpha}_{t-1})}{(1-\bar{\alpha}_{t})}\hskip 28.45274pt\mu_{q}(t)=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})x_{0}}{1-\bar{\alpha}_{t}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac></mrow><mspace style="width:2.85em;" width="2.85em"></mspace><mrow><mrow><msub><mi>μ</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}_{q}(t)=\frac{(1-\alpha_{t})(1-\bar{\alpha}_{t-1})}{(1-\bar{\alpha}_{t})}\hskip 28.45274pt\mu_{q}(t)=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})x_{0}}{1-\bar{\alpha}_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS2.p7" class="ltx_para">
<p id="A1.SS1.SSS2.p7.1" class="ltx_p">Now further substituting <math id="A1.SS1.SSS2.p7.m1" class="ltx_Math" alttext="x_{0}=\frac{x_{t}-\sqrt{1-\bar{\alpha}_{t}}\,\epsilon_{0}}{\sqrt{\bar{\alpha}_{t}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>=</mo><mfrac><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt></mfrac></mrow><annotation encoding="application/x-tex">x_{0}=\frac{x_{t}-\sqrt{1-\bar{\alpha}_{t}}\,\epsilon_{0}}{\sqrt{\bar{\alpha}_{t}}}</annotation></semantics></math> from Eq. <a href="#A1.E28" title="Equation 28 ‣ A.1.2 Proof of Lemma-2 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a> in the mean term <math id="A1.SS1.SSS2.p7.m2" class="ltx_Math" alttext="\mu_{q}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{q}(t)</annotation></semantics></math>, we get,</p>
</div>
<div id="A1.SS1.SSS2.p8" class="ltx_para">
<table id="A1.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E42.m1" class="ltx_Math" alttext="\displaystyle\mu_{q}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu_{q}(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E42.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})x_{0}}{1-\bar{\alpha}_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})x_{0}}{1-\bar{\alpha}_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
<tbody id="A1.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E43.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})\left(\frac{x_{t}-\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0}}{\sqrt{\bar{\alpha}_{t}}}\right)}{1-\bar{\alpha}_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt></mfrac><mo>)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+\sqrt{\bar{\alpha}_{t-1}}(1-\alpha_{t})\left(\frac{x_{t}-\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0}}{\sqrt{\bar{\alpha}_{t}}}\right)}{1-\bar{\alpha}_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
<tbody id="A1.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E44.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+(1-\alpha_{t})\left(\frac{x_{t}-\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0}}{\sqrt{\alpha_{t}}}\right)}{1-\bar{\alpha}_{t}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo>)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}+(1-\alpha_{t})\left(\frac{x_{t}-\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0}}{\sqrt{\alpha_{t}}}\right)}{1-\bar{\alpha}_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
<tbody id="A1.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E45.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}}{1-\bar{\alpha}_{t}}+\frac{(1-\alpha_{t})x_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})x_{t}}{1-\bar{\alpha}_{t}}+\frac{(1-\alpha_{t})x_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
<tbody id="A1.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E46.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})}{1-\bar{\alpha}_{t}}+\frac{1-\alpha_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}\right)x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\sqrt{\alpha_{t}}(1-\bar{\alpha}_{t-1})}{1-\bar{\alpha}_{t}}+\frac{1-\alpha_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}\right)x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}\epsilon_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
<tbody id="A1.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E47.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\alpha_{t}(1-\bar{\alpha}_{t-1})}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}+\frac{1-\alpha_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}\right)x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\alpha_{t}(1-\bar{\alpha}_{t-1})}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}+\frac{1-\alpha_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}\right)x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
<tbody id="A1.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E48.m1" class="ltx_Math" alttext="\displaystyle=\frac{\alpha_{t}-\bar{\alpha}_{t}+1-\alpha_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha_{t}-\bar{\alpha}_{t}+1-\alpha_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
<tbody id="A1.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E49.m1" class="ltx_Math" alttext="\displaystyle=\frac{1-\bar{\alpha}_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-\bar{\alpha}_{t}}{(1-\bar{\alpha}_{t})\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
<tbody id="A1.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E50.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS2.p9" class="ltx_para">
<p id="A1.SS1.SSS2.p9.1" class="ltx_p">Along the similar lines we can prove that, <math id="A1.SS1.SSS2.p9.m1" class="ltx_Math" alttext="\mu_{\theta}(t)=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{\theta}(t)=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{(1-\alpha_{t})\sqrt{1-\bar{\alpha}_{t}}}{\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)</annotation></semantics></math></p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A1.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.1.3 </span>Proof of Theorem-1</h4>

<div id="A1.SS1.SSS3.p1" class="ltx_para">
<p id="A1.SS1.SSS3.p1.1" class="ltx_p">The variational divergence term in Eq. <a href="#S3.E1" title="Equation 1 ‣ 3.2 Method Overview ‣ 3 Methodology ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is:</p>
</div>
<div id="A1.SS1.SSS3.p2" class="ltx_para">
<table id="A1.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E51.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{KL}\left(Q(\theta)\bigg\|Z\cdot\frac{P(\theta|D_{f},D_{r})}{P(D_{f}|\theta)}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo>(</mo><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="2.100em" rspace="0.167em">∥</mo><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>f</mi></msub><mo>,</mo><msub><mi>D</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{KL}\left(Q(\theta)\bigg\|Z\cdot\frac{P(\theta|D_{f},D_{r})}{P(D_{f}|\theta)}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E51.m2" class="ltx_Math" alttext="\displaystyle=\underset{Q(\theta)}{\mathds{E}}\left[\ln\frac{Q(\theta)P(D_{f}|\theta)}{Z\cdot P(\theta|D_{f},D_{r})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>f</mi></msub><mo>,</mo><msub><mi>D</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{Q(\theta)}{\mathds{E}}\left[\ln\frac{Q(\theta)P(D_{f}|\theta)}{Z\cdot P(\theta|D_{f},D_{r})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
<tbody id="A1.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E52.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(g)}}{{\equiv}}\underset{Q(\theta)}{\mathds{E}}\left[\ln P(D_{f}|\theta)\right]+\underset{Q(\theta)}{\mathds{E}}\left[\ln\frac{Q(\theta)}{P(\theta|D_{f},D_{r})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>≡</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>f</mi></msub><mo>,</mo><msub><mi>D</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(g)}}{{\equiv}}\underset{Q(\theta)}{\mathds{E}}\left[\ln P(D_{f}|\theta)\right]+\underset{Q(\theta)}{\mathds{E}}\left[\ln\frac{Q(\theta)}{P(\theta|D_{f},D_{r})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
<tbody id="A1.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E53.m1" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle(h)}}{{=}}\underset{Q(\theta)}{\mathds{E}}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta)\right]+\underset{Q(\theta)}{\mathds{E}}\left[\ln\frac{Q(\theta)}{P(\theta|D_{f},D_{r})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mover><mrow><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow></munder></mstyle><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>f</mi></msub><mo>,</mo><msub><mi>D</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(h)}}{{=}}\underset{Q(\theta)}{\mathds{E}}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta)\right]+\underset{Q(\theta)}{\mathds{E}}\left[\ln\frac{Q(\theta)}{P(\theta|D_{f},D_{r})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
<tbody id="A1.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E54.m1" class="ltx_Math" alttext="\displaystyle=\underbrace{\underset{\theta\sim Q(\theta)}{\mathds{E}}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta)\right]}_{\text{\large\textcircled{a}}}+\underbrace{D_{KL}(Q(\theta)||P(\theta|D_{f},D_{r}))}_{\text{\large\textcircled{b}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">θ</mi><mo mathsize="0.700em">∼</mo><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow></munder></mstyle><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext mathsize="1.710em">ⓐ</mtext></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mi>D</mi><msub><mrow></mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mo stretchy="false">(</mo><mi>Q</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>P</mi><mo stretchy="false">(</mo><mi>θ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>D</mi><msub><mrow></mrow><mi>f</mi></msub><mo>,</mo><mi>D</mi><msub><mrow></mrow><mi>r</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext mathsize="1.710em">ⓑ</mtext></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\underset{\theta\sim Q(\theta)}{\mathds{E}}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta)\right]}_{\text{\large\textcircled{a}}}+\underbrace{D_{KL}(Q(\theta)||P(\theta|D_{f},D_{r}))}_{\text{\large\textcircled{b}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A1.SS1.SSS3.p2.1" class="ltx_p"><math id="A1.SS1.SSS3.p2.m1" class="ltx_Math" alttext="(g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g)</annotation></semantics></math> holds as the normalization constant is independent of <math id="A1.SS1.SSS3.p2.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>. <math id="A1.SS1.SSS3.p2.m3" class="ltx_Math" alttext="(h)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h)</annotation></semantics></math> is true because of the i.i.d. assumption on the data. We further derive the terms ⓐ and ⓑ of Eq. <a href="#A1.E54" title="Equation 54 ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">54</span></a> below.</p>
</div>
<div id="A1.SS1.SSS3.p3" class="ltx_para">
<p id="A1.SS1.SSS3.p3.1" class="ltx_p">• <span id="A1.SS1.SSS3.p3.1.1" class="ltx_text ltx_font_bold">Further derivation of term ⓐ:</span>
For further simplification of this term, we would require some more theoretical formulations as follows:</p>
</div>
<div id="A1.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma A.1</span></span><span id="A1.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem1.p1" class="ltx_para">
<p id="A1.Thmtheorem1.p1.1" class="ltx_p"><span id="A1.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The Kullback-Leibler divergence for two multivariate normal distributions is given by:</span></p>
<table id="A1.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_math_unparsed" alttext="D_{KL}(N(x;\mu_{x},\Sigma_{x})\|N(y;\mu_{y},\Sigma_{y}))=\frac{1}{2}\left[\log\frac{|\Sigma_{y}|}{|\Sigma_{x}|}-d+\text{tr}(\Sigma_{y}^{-1}\Sigma_{x})+(\mu_{y}-\mu_{x})^{T}\Sigma_{y}^{-1}(\mu_{y}-\mu_{x})\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>;</mo><msub><mi>μ</mi><mi>x</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>;</mo><msub><mi>μ</mi><mi>y</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>y</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mrow><mo>[</mo><mi>log</mi><mfrac><mrow><mo stretchy="false">|</mo><msub><mi mathvariant="normal">Σ</mi><mi>y</mi></msub><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><msub><mi mathvariant="normal">Σ</mi><mi>x</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><mo>−</mo><mi>d</mi><mo>+</mo><mtext class="ltx_mathvariant_italic">tr</mtext><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>y</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><msub><mi mathvariant="normal">Σ</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>y</mi></msub><mo>−</mo><msub><mi>μ</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><msubsup><mi mathvariant="normal">Σ</mi><mi>y</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>y</mi></msub><mo>−</mo><msub><mi>μ</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">D_{KL}(N(x;\mu_{x},\Sigma_{x})\|N(y;\mu_{y},\Sigma_{y}))=\frac{1}{2}\left[\log\frac{|\Sigma_{y}|}{|\Sigma_{x}|}-d+\text{tr}(\Sigma_{y}^{-1}\Sigma_{x})+(\mu_{y}-\mu_{x})^{T}\Sigma_{y}^{-1}(\mu_{y}-\mu_{x})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS1.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS1.SSS3.p4" class="ltx_para">
<p id="A1.SS1.SSS3.p4.1" class="ltx_p"><span id="A1.SS1.SSS3.p4.1.1" class="ltx_text">Proof of this lemma can be found in any standard information theory textbook and is avoided here.
∎</span></p>
</div>
</div>
<div id="A1.SS1.SSS3.p5" class="ltx_para">
<p id="A1.SS1.SSS3.p5.1" class="ltx_p">From Lemma <a href="#S3.Thmtheorem2" title="Lemma 3.2. ‣ 3.3 Theoretical Outlook ‣ 3 Methodology ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, we know that <math id="A1.SS1.SSS3.p5.m1" class="ltx_Math" alttext="q(x_{t-1}|x_{t},x_{0})=\mathcal{N}(x_{t-1};\mu_{q}(t),\sigma^{2}_{q}(t)I)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi>μ</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q(x_{t-1}|x_{t},x_{0})=\mathcal{N}(x_{t-1};\mu_{q}(t),\sigma^{2}_{q}(t)I)</annotation></semantics></math> with <math id="A1.SS1.SSS3.p5.m2" class="ltx_Math" alttext="\mu_{q}(t)=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}\sqrt{\alpha_{t}}}\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{q}(t)=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}\sqrt{\alpha_{t}}}\epsilon_{0}</annotation></semantics></math> and <math id="A1.SS1.SSS3.p5.m3" class="ltx_Math" alttext="p_{\theta}(x_{t-1}|x_{t})=\mathcal{N}(x_{t-1};\mu_{\theta}(t),\sigma^{2}_{q}(t)I)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi>μ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(x_{t-1}|x_{t})=\mathcal{N}(x_{t-1};\mu_{\theta}(t),\sigma^{2}_{q}(t)I)</annotation></semantics></math> with <math id="A1.SS1.SSS3.p5.m4" class="ltx_Math" alttext="\mu_{\theta}(t)=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{\theta}(t)=\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)</annotation></semantics></math> where <math id="A1.SS1.SSS3.p5.m5" class="ltx_Math" alttext="\sigma^{2}_{q}(t)=\frac{(1-\alpha_{t})(1-\bar{\alpha}_{t-1})}{(1-\bar{\alpha}_{t})}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sigma^{2}_{q}(t)=\frac{(1-\alpha_{t})(1-\bar{\alpha}_{t-1})}{(1-\bar{\alpha}_{t})}</annotation></semantics></math>. Now using this and the above Lemma <a href="#A1.Thmtheorem1" title="Lemma A.1. ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, the KL-divergence in the ELBO term of Lemma <a href="#S3.Thmtheorem1" title="Lemma 3.1. ‣ 3.3 Theoretical Outlook ‣ 3 Methodology ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> can be written as follows:</p>
<table id="A1.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E55.m1" class="ltx_Math" alttext="\displaystyle L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\displaystyle L_{t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E55.m2" class="ltx_math_unparsed" alttext="\displaystyle=D_{KL}(q(x_{t-1}|x_{t},x_{0})\,\big\|\,p_{\theta}(x_{t-1}|x_{t}))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.337em">∥</mo><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=D_{KL}(q(x_{t-1}|x_{t},x_{0})\,\big\|\,p_{\theta}(x_{t-1}|x_{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
<tbody id="A1.E56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E56.m1" class="ltx_math_unparsed" alttext="\displaystyle=D_{KL}\left(N(x_{t-1};\mu_{q},\Sigma_{q}(t))\,\big\|\,N(x_{t-1};\mu_{\theta},\Sigma_{q}(t))\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo>(</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>;</mo><msub><mi>μ</mi><mi>q</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>q</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" mathsize="1.200em" rspace="0.337em">∥</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>;</mo><msub><mi>μ</mi><mi>θ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>q</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=D_{KL}\left(N(x_{t-1};\mu_{q},\Sigma_{q}(t))\,\big\|\,N(x_{t-1};\mu_{\theta},\Sigma_{q}(t))\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
<tbody id="A1.E57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E57.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2\sigma_{q}^{2}(t)}\left\|\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)-\frac{1}{\sqrt{\alpha_{t}}}x_{t}+\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{0}\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mover accent="true"><msub><mi>α</mi><mi>t</mi></msub><mo>¯</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mover accent="true"><msub><mi>α</mi><mi>t</mi></msub><mo>¯</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2\sigma_{q}^{2}(t)}\left\|\frac{1}{\sqrt{\alpha_{t}}}x_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)-\frac{1}{\sqrt{\alpha_{t}}}x_{t}+\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{0}\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
<tbody id="A1.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E58.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2\sigma_{q}^{2}(t)}\left\|\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{0}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mover accent="true"><msub><mi>α</mi><mi>t</mi></msub><mo>¯</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mover accent="true"><msub><mi>α</mi><mi>t</mi></msub><mo>¯</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2\sigma_{q}^{2}(t)}\left\|\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{0}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}\epsilon_{\theta}(x_{t},t)\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
<tbody id="A1.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E59.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{2\sigma_{q}^{2}(t)}\left\|\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}(\epsilon_{0}-\epsilon_{\theta}(x_{t},t))\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mover accent="true"><msub><mi>α</mi><mi>t</mi></msub><mo>¯</mo></mover></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2\sigma_{q}^{2}(t)}\left\|\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha_{t}}}\sqrt{\alpha_{t}}}(\epsilon_{0}-\epsilon_{\theta}(x_{t},t))\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
<tbody id="A1.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E60.m1" class="ltx_Math" alttext="\displaystyle=\frac{(1-\alpha_{t})^{2}}{2\sigma_{q}^{2}(t)(1-\bar{\alpha_{t}})\alpha_{t}}\left\|\epsilon_{0}-\epsilon_{\theta}(x_{t},t)\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mover accent="true"><msub><mi>α</mi><mi>t</mi></msub><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(1-\alpha_{t})^{2}}{2\sigma_{q}^{2}(t)(1-\bar{\alpha_{t}})\alpha_{t}}\left\|\epsilon_{0}-\epsilon_{\theta}(x_{t},t)\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
<tbody id="A1.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E61.m1" class="ltx_Math" alttext="\displaystyle=\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}\left\|\epsilon_{0}-\epsilon_{\theta}(x_{t},t)\right\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}\left\|\epsilon_{0}-\epsilon_{\theta}(x_{t},t)\right\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(61)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS3.p6" class="ltx_para">
<p id="A1.SS1.SSS3.p6.1" class="ltx_p">The first term ⓐ of Eq. <a href="#A1.E54" title="Equation 54 ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">54</span></a> can now be expressed using Monte Carlo estimation as follows:</p>
<table id="A1.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="A1.E62.2.1" class="ltx_text ltx_markedasmath">ⓐ</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E62.m2" class="ltx_Math" alttext="\displaystyle=\underset{\theta\sim Q(\theta)}{\mathds{E}}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">θ</mi><mo mathsize="0.700em">∼</mo><mrow><mi mathsize="0.700em">Q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">θ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow></munder></mstyle><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{\theta\sim Q(\theta)}{\mathds{E}}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
<tbody id="A1.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E63.m1" class="ltx_Math" alttext="\displaystyle\approx\frac{1}{M}\sum_{s=1}^{M}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta^{s})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow></munder></mstyle><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msup><mi>θ</mi><mi>s</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\approx\frac{1}{M}\sum_{s=1}^{M}\left[\sum_{x_{0}\in D_{f}}\ln P(x_{0}|\theta^{s})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
<tbody id="A1.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E64.m1" class="ltx_math_unparsed" alttext="\displaystyle\stackrel{{\scriptstyle(i)}}{{\gtrsim}}\frac{1}{M}\sum_{j=1}^{M}\left[-\sum_{x_{0}\in D_{f}}\sum_{t=2}^{T}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[D_{KL}(q(x_{t-1}|x_{t},x_{0})||p_{\theta^{s}}(x_{t-1}|x_{t}))\right]\right]" display="inline" intent=":literal"><semantics><mrow><mover><mo>≳</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mover><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo>[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow></munder></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></munderover></mstyle><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">x</mi><mi mathsize="0.710em">t</mi></msub><mo lspace="0em" mathsize="0.700em" rspace="0em">|</mo><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mrow><mo>[</mo><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>p</mi><msup><mi>θ</mi><mi>s</mi></msup></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(i)}}{{\gtrsim}}\frac{1}{M}\sum_{j=1}^{M}\left[-\sum_{x_{0}\in D_{f}}\sum_{t=2}^{T}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[D_{KL}(q(x_{t-1}|x_{t},x_{0})||p_{\theta^{s}}(x_{t-1}|x_{t}))\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
<tbody id="A1.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E65.m1" class="ltx_math_unparsed" alttext="\displaystyle\stackrel{{\scriptstyle(j)}}{{\approx}}-\underset{x_{0}\in D_{f}}{\sum}\sum^{T}_{t=2}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}||\epsilon_{0}-\epsilon_{\theta}(x_{t},t)||^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mover><mo>≈</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mover><mo lspace="0em">−</mo><munder accentunder="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mrow><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">∈</mo><msub><mi mathsize="0.700em">D</mi><mi mathsize="0.710em">f</mi></msub></mrow></munder><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></munderover></mstyle><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">x</mi><mi mathsize="0.710em">t</mi></msub><mo lspace="0em" mathsize="0.700em" rspace="0em">|</mo><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(j)}}{{\approx}}-\underset{x_{0}\in D_{f}}{\sum}\sum^{T}_{t=2}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}||\epsilon_{0}-\epsilon_{\theta}(x_{t},t)||^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS3.p7" class="ltx_para">
<p id="A1.SS1.SSS3.p7.1" class="ltx_p"><math id="A1.SS1.SSS3.p7.m1" class="ltx_Math" alttext="(i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i)</annotation></semantics></math> holds as a consequence of Lemma <a href="#S3.Thmtheorem1" title="Lemma 3.1. ‣ 3.3 Theoretical Outlook ‣ 3 Methodology ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>. Now using a crude estimate of <math id="A1.SS1.SSS3.p7.m2" class="ltx_Math" alttext="M=1" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M=1</annotation></semantics></math> (i.e. denoting <math id="A1.SS1.SSS3.p7.m3" class="ltx_Math" alttext="\theta^{1}=\theta" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>1</mn></msup><mo>=</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\theta^{1}=\theta</annotation></semantics></math>) and equation <a href="#A1.E61" title="Equation 61 ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">61</span></a>, <math id="A1.SS1.SSS3.p7.m4" class="ltx_Math" alttext="(j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(j)</annotation></semantics></math> holds.</p>
</div>
<div id="A1.SS1.SSS3.p8" class="ltx_para">
<p id="A1.SS1.SSS3.p8.1" class="ltx_p">• <span id="A1.SS1.SSS3.p8.1.1" class="ltx_text ltx_font_bold">Further Derivation of term ⓑ:</span> Using the above Lemma <a href="#A1.Thmtheorem1" title="Lemma A.1. ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a> with the variational posterior distribution <math id="A1.SS1.SSS3.p8.m1" class="ltx_Math" alttext="Q(\theta)=\prod^{d}_{i=1}\mathcal{N}(\theta_{i},\sigma^{2}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q(\theta)=\prod^{d}_{i=1}\mathcal{N}(\theta_{i},\sigma^{2}_{i})</annotation></semantics></math> and the posterior distribution with full data <math id="A1.SS1.SSS3.p8.m2" class="ltx_Math" alttext="P(\theta|D_{r},D_{f})=\prod^{d}_{i=1}\mathcal{N}(\mu^{*}_{i},\sigma^{*2}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>r</mi></msub><mo>,</mo><msub><mi>D</mi><mi>f</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>μ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P(\theta|D_{r},D_{f})=\prod^{d}_{i=1}\mathcal{N}(\mu^{*}_{i},\sigma^{*2}_{i})</annotation></semantics></math>, this term can be simplified as follows:</p>
</div>
<div id="A1.SS1.SSS3.p9" class="ltx_para">
<table id="A1.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E66.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{KL}(Q(\theta)||P(\theta|D_{f},D_{r}))=\sum^{d}_{i=1}\left[\ln\frac{\sigma^{*}_{i}}{\sigma_{i}}+\frac{\sigma^{2}_{i}+(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}-\frac{1}{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>P</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>D</mi><mi>f</mi></msub><mo>,</mo><msub><mi>D</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>[</mo><mi>ln</mi><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>i</mi><mo>∗</mo></msubsup><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><msubsup><mi>μ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{KL}(Q(\theta)||P(\theta|D_{f},D_{r}))=\sum^{d}_{i=1}\left[\ln\frac{\sigma^{*}_{i}}{\sigma_{i}}+\frac{\sigma^{2}_{i}+(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}-\frac{1}{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS3.p10" class="ltx_para">
<p id="A1.SS1.SSS3.p10.1" class="ltx_p">Finally, incorporating both the terms ⓐ and ⓑ terms of Eq. <a href="#A1.E65" title="Equation 65 ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">65</span></a> and Eq. <a href="#A1.E66" title="Equation 66 ‣ A.1.3 Proof of Theorem-1 ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">66</span></a> respectively we get,</p>
</div>
<div id="A1.SS1.SSS3.p11" class="ltx_para">
<table id="A1.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex6.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{KL}\left(Q(\theta)\bigg|\bigg|Z\cdot\frac{P(\theta|D_{f},D_{r})}{P(D_{f}|\theta)}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mrow><mo>(</mo><mi>Q</mi><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>f</mi></msub><mo>,</mo><msub><mi>D</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle D_{KL}\left(Q(\theta)\bigg|\bigg|Z\cdot\frac{P(\theta|D_{f},D_{r})}{P(D_{f}|\theta)}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex6.m2" class="ltx_Math" alttext="\displaystyle\gtrsim\underbrace{-\underset{x_{0}\in D_{f}}{\sum}\sum^{T}_{t=2}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}||\epsilon_{0}-\epsilon_{\theta}(x_{t},t)||^{2}\right]}_{\text{I}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0em">≳</mo><munder><munder accentunder="true"><mrow><mo lspace="0em">−</mo><munder accentunder="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mrow><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">∈</mo><msub><mi mathsize="0.700em">D</mi><mi mathsize="0.710em">f</mi></msub></mrow></munder><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msup><mrow></mrow><mi>T</mi></msup><msub><mrow></mrow><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow></msub><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">x</mi><mi mathsize="0.710em">t</mi></msub><mo lspace="0em" mathsize="0.700em" rspace="0em">|</mo><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>ϵ</mi><msub><mrow></mrow><mn>0</mn></msub><mo>−</mo><mi>ϵ</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mrow></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext>I</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle\gtrsim\underbrace{-\underset{x_{0}\in D_{f}}{\sum}\sum^{T}_{t=2}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}||\epsilon_{0}-\epsilon_{\theta}(x_{t},t)||^{2}\right]}_{\text{I}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\displaystyle\quad+\underbrace{\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}+\frac{\sigma^{2}_{i}}{2\sigma^{*2}_{i}}+\log\frac{\sigma^{*}_{i}}{\sigma_{i}}-\frac{1}{2}\right]}_{\text{II}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><msubsup><mi>μ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>i</mi><mo>∗</mo></msubsup><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>II</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\underbrace{\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}+\frac{\sigma^{2}_{i}}{2\sigma^{*2}_{i}}+\log\frac{\sigma^{*}_{i}}{\sigma_{i}}-\frac{1}{2}\right]}_{\text{II}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.1.4 </span>Loss function Derivation</h4>

<div id="A1.SS1.SSS4.p1" class="ltx_para">
<p id="A1.SS1.SSS4.p1.1" class="ltx_p">• <span id="A1.SS1.SSS4.p1.1.1" class="ltx_text ltx_font_bold">Adaptation of part-<math id="A1.SS1.SSS4.p1.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> in VDU:</span>
Note that the term <math id="A1.SS1.SSS4.p1.m2" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> of the lower bound above is computationally expensive and memory intensive because for each <math id="A1.SS1.SSS4.p1.m3" class="ltx_Math" alttext="x_{0}\in D_{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow><annotation encoding="application/x-tex">x_{0}\in D_{f}</annotation></semantics></math> we need to add noise for all values of <math id="A1.SS1.SSS4.p1.m4" class="ltx_Math" alttext="t\in\{2,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{2,\ldots,T\}</annotation></semantics></math> and then denoise again for each <math id="A1.SS1.SSS4.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Now, if <math id="A1.SS1.SSS4.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is very large, this essentially increases the sample size to <math id="A1.SS1.SSS4.p1.m7" class="ltx_Math" alttext="\mathcal{O}(T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(T)</annotation></semantics></math>. Thus, to avoid this, if we simply apply the idea from the previous work <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib25" title="" class="ltx_ref">Ho et al.,, 2020</a>)</cite>, this can be written as follows:</p>
</div>
<div id="A1.SS1.SSS4.p2" class="ltx_para">
<table id="A1.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E67.m1" class="ltx_Math" alttext="\displaystyle I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">\displaystyle I</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E67.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\underset{x_{0}\in D_{f}}{\sum}\sum^{T}_{t=2}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}||\epsilon_{0}-\epsilon_{\theta}(x_{t},t)||^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><munder accentunder="true"><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><mrow><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">∈</mo><msub><mi mathsize="0.700em">D</mi><mi mathsize="0.710em">f</mi></msub></mrow></munder><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></munderover></mstyle><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">x</mi><mi mathsize="0.710em">t</mi></msub><mo lspace="0em" mathsize="0.700em" rspace="0em">|</mo><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\underset{x_{0}\in D_{f}}{\sum}\sum^{T}_{t=2}\underset{q(x_{t}|x_{0})}{\mathds{E}}\left[\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}||\epsilon_{0}-\epsilon_{\theta}(x_{t},t)||^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
<tbody id="A1.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E68.m1" class="ltx_Math" alttext="\displaystyle{\cong}-\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}\underset{\begin{subarray}{c}x_{0}\sim D_{f}\\
\epsilon_{0},t\end{subarray}}{\mathds{E}}\left[||\epsilon_{0}-\epsilon_{\theta}(\sqrt{\bar{\alpha}_{t}}x_{0}+\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0},t)||^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≅</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝔼</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">D</mi><mi mathsize="0.710em">f</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi mathsize="0.700em">ϵ</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">t</mi></mrow></mtd></mtr></mtable></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\cong}-\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}\underset{\begin{subarray}{c}x_{0}\sim D_{f}\\
\epsilon_{0},t\end{subarray}}{\mathds{E}}\left[||\epsilon_{0}-\epsilon_{\theta}(\sqrt{\bar{\alpha}_{t}}x_{0}+\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0},t)||^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS4.p3" class="ltx_para">
<p id="A1.SS1.SSS4.p3.1" class="ltx_p">However, we notice that the key difference between Eq. <a href="#A1.E67" title="Equation 67 ‣ A.1.4 Loss function Derivation ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">67</span></a> and Eq. <a href="#A1.E68" title="Equation 68 ‣ A.1.4 Loss function Derivation ‣ A.1 Theoretical Analysis ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">68</span></a> is that for each <math id="A1.SS1.SSS4.p3.m1" class="ltx_Math" alttext="x_{0}\in D_{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>D</mi><mi>f</mi></msub></mrow><annotation encoding="application/x-tex">x_{0}\in D_{f}</annotation></semantics></math> it only takes a single timestep weighted loss rather than taking the loss across the whole path <math id="A1.SS1.SSS4.p3.m2" class="ltx_Math" alttext="t\in\{2,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{2,\ldots,T\}</annotation></semantics></math>. To take this into account, we slightly modify this term to obtain the term <math id="A1.SS1.SSS4.p3.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> as follows:</p>
</div>
<div id="A1.SS1.SSS4.p4" class="ltx_para">
<table id="A1.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex8.m1" class="ltx_Math" alttext="\displaystyle A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\displaystyle A</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\sum^{T}_{t=2}\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}\underset{\begin{subarray}{c}x_{0}\sim D_{f}\\
\epsilon_{0},t\end{subarray}}{\mathds{E}}\left[||\epsilon_{0}-\epsilon_{\theta}(\sqrt{\bar{\alpha}_{t}}x_{0}+\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0},t)||^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><munder accentunder="true"><mi>𝔼</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi mathsize="0.700em">x</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">∼</mo><msub><mi mathsize="0.700em">D</mi><mi mathsize="0.710em">f</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi mathsize="0.700em">ϵ</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">t</mi></mrow></mtd></mtr></mtable></munder><mrow><mo>[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo>−</mo><msub><mi>ϵ</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt><msub><mi>x</mi><mn>0</mn></msub><mo>+</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt><msub><mi>ϵ</mi><mn>0</mn></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\sum^{T}_{t=2}\frac{(1-\alpha_{t})}{\alpha_{t}(1-\bar{\alpha}_{t-1})}\underset{\begin{subarray}{c}x_{0}\sim D_{f}\\
\epsilon_{0},t\end{subarray}}{\mathds{E}}\left[||\epsilon_{0}-\epsilon_{\theta}(\sqrt{\bar{\alpha}_{t}}x_{0}+\sqrt{1-\bar{\alpha}_{t}}\epsilon_{0},t)||^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.SSS4.p5" class="ltx_para">
<p id="A1.SS1.SSS4.p5.1" class="ltx_p">We observe that this term in <math id="A1.SS1.SSS4.p5.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is much closer to the loss computed across the whole path <math id="A1.SS1.SSS4.p5.m2" class="ltx_Math" alttext="t\in\{2,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{2,\ldots,T\}</annotation></semantics></math>, and with this term, the algorithm converges much faster with better empirical performance.</p>
</div>
<div id="A1.SS1.SSS4.p6" class="ltx_para">
<p id="A1.SS1.SSS4.p6.1" class="ltx_p">• <span id="A1.SS1.SSS4.p6.1.1" class="ltx_text ltx_font_bold">Adaptation of part-<math id="A1.SS1.SSS4.p6.m1" class="ltx_Math" alttext="II" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">II</annotation></semantics></math> in VDU:</span>
Assuming <math id="A1.SS1.SSS4.p6.m2" class="ltx_Math" alttext="P(\theta|D_{r})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>D</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\theta|D_{r})</annotation></semantics></math> is mean-shifted version of <math id="A1.SS1.SSS4.p6.m3" class="ltx_Math" alttext="P(\theta|D_{r},D_{f})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>D</mi><mi>r</mi></msub><mo>,</mo><msub><mi>D</mi><mi>f</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\theta|D_{r},D_{f})</annotation></semantics></math> with the same variance factor i.e. with <math id="A1.SS1.SSS4.p6.m4" class="ltx_Math" alttext="\sigma_{i}=\sigma^{*}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>σ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\sigma_{i}=\sigma^{*}_{i}</annotation></semantics></math>, term <math id="A1.SS1.SSS4.p6.m5" class="ltx_Math" alttext="II" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">II</annotation></semantics></math> turns out to be as follows:</p>
<table id="A1.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\displaystyle II" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\displaystyle II</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex9.m2" class="ltx_Math" alttext="\displaystyle=\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}+\frac{\sigma^{2}_{i}}{2\sigma^{*2}_{i}}+\log\frac{\sigma^{*}_{i}}{\sigma_{i}}-\frac{1}{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><msubsup><mi>μ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>σ</mi><mi>i</mi><mo>∗</mo></msubsup><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}+\frac{\sigma^{2}_{i}}{2\sigma^{*2}_{i}}+\log\frac{\sigma^{*}_{i}}{\sigma_{i}}-\frac{1}{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\displaystyle=\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}+\frac{1}{2}+\log 1-\frac{1}{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><msubsup><mi>μ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>1</mn></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}+\frac{1}{2}+\log 1-\frac{1}{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\displaystyle=\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><msubsup><mi>μ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>i</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mn>2</mn></mrow></msubsup></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{d}_{i=1}\left[\frac{(\theta_{i}-\mu^{*}_{i})^{2}}{2\sigma^{*2}_{i}}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.SSS4.p6.2" class="ltx_p">This simplified version is used as the second component of our proposed loss function. The reason for assuming <math id="A1.SS1.SSS4.p6.m6" class="ltx_Math" alttext="\sigma_{i}=\sigma^{*}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>σ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\sigma_{i}=\sigma^{*}_{i}</annotation></semantics></math> is to simplify the optimization process. However, one can remove this assumption and optimize with respect to <math id="A1.SS1.SSS4.p6.m7" class="ltx_Math" alttext="\sigma_{i}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\sigma_{i}</annotation></semantics></math> to find the optimal variance factor of <math id="A1.SS1.SSS4.p6.m8" class="ltx_Math" alttext="P(\theta|D_{r})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>D</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\theta|D_{r})</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Additional Results</h3>

<section id="A1.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.2.1 </span>Quantitative Results using VDU</h4>

<div id="A1.SS2.SSS1.p1" class="ltx_para">
<p id="A1.SS2.SSS1.p1.1" class="ltx_p">Table <a href="#A1.T3" title="Table 3 ‣ A.2.1 Quantitative Results using VDU ‣ A.2 Additional Results ‣ Appendix A Technical Appendices and Supplementary Material ‣ Variational Diffusion Unlearning: A Variational Inference Framework for Unlearning in Diffusion Models under Data Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> presents the unlearning performance of the VDU method across various classes from MNIST, CIFAR-10, and tinyImageNet datasets for different values of the hyperparameter <math id="A1.SS2.SSS1.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. Increasing <math id="A1.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> can improve unlearning efficacy (higher PUL) in some cases but may degrade sample quality (higher u-FID), and vice versa.</p>
</div>
<figure id="A1.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 3: </span>PUL(<math id="A1.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>) and u-FID(<math id="A1.T3.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>) for class unlearning on the MNIST, CIFAR-10, and tinyImageNet datasets for different values of <math id="A1.T3.m6" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>.</figcaption>
<div id="A1.T3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:135.6pt;vertical-align:-66.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-121.1pt,47.6pt) scale(0.587520582132316,0.587520582132316) ;">
<table id="A1.T3.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A1.T3.2.1.1" class="ltx_tr">
<th id="A1.T3.2.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="A1.T3.2.1.1.1.1" class="ltx_text ltx_font_bold">Dataset</span></th>
<td id="A1.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="A1.T3.2.1.1.2.1" class="ltx_text ltx_font_bold">Unlearned Classes</span></td>
<th id="A1.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" colspan="2"><math id="A1.T3.m7" class="ltx_Math" alttext="\gamma=0.1" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\gamma=0.1</annotation></semantics></math></th>
<th id="A1.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" colspan="2"><math id="A1.T3.m8" class="ltx_Math" alttext="\gamma=0.3" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0.3</mn></mrow><annotation encoding="application/x-tex">\gamma=0.3</annotation></semantics></math></th>
<th id="A1.T3.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" colspan="2"><math id="A1.T3.m9" class="ltx_Math" alttext="\gamma=0.6" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0.6</mn></mrow><annotation encoding="application/x-tex">\gamma=0.6</annotation></semantics></math></th>
<th id="A1.T3.2.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="2"><math id="A1.T3.m10" class="ltx_Math" alttext="\gamma=0.8" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mn>0.8</mn></mrow><annotation encoding="application/x-tex">\gamma=0.8</annotation></semantics></math></th></tr>
<tr id="A1.T3.2.1.2" class="ltx_tr">
<th id="A1.T3.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="A1.T3.2.1.2.1.1" class="ltx_text ltx_font_bold">u-FID</span></th>
<td id="A1.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A1.T3.2.1.2.2.1" class="ltx_text ltx_font_bold">PUL(%)</span></td>
<th id="A1.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="A1.T3.2.1.2.3.1" class="ltx_text ltx_font_bold">u-FID</span></th>
<td id="A1.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A1.T3.2.1.2.4.1" class="ltx_text ltx_font_bold">PUL(%)</span></td>
<th id="A1.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="A1.T3.2.1.2.5.1" class="ltx_text ltx_font_bold">u-FID</span></th>
<td id="A1.T3.2.1.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A1.T3.2.1.2.6.1" class="ltx_text ltx_font_bold">PUL(%)</span></td>
<th id="A1.T3.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="A1.T3.2.1.2.7.1" class="ltx_text ltx_font_bold">u-FID</span></th>
<td id="A1.T3.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T3.2.1.2.8.1" class="ltx_text ltx_font_bold">PUL(%)</span></td></tr>
<tr id="A1.T3.2.1.3" class="ltx_tr">
<th id="A1.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="8"><span id="A1.T3.2.1.3.1.1" class="ltx_text ltx_font_bold">MNIST</span></th>
<td id="A1.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Class-0</td>
<th id="A1.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">29.34</th>
<td id="A1.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">61.00%</td>
<th id="A1.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">36.75</th>
<td id="A1.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">65.25%</td>
<th id="A1.T3.2.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">35.13</th>
