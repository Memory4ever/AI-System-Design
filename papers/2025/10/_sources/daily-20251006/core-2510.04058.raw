<tbody id="A1.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E6.m1" class="ltx_math_unparsed" alttext="\displaystyle\stackrel{{\scriptstyle(a)}}{{\geq}}\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p_{\theta}(x_{0:T})}{q(x_{1:T}|x_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><mover><mo>≥</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mover><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mrow><mn mathsize="0.710em">1</mn><mo lspace="0.278em" mathsize="0.710em" rspace="0.278em">:</mo><mi mathsize="0.710em">T</mi></mrow></msub><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mrow><mo>[</mo><mi>ln</mi><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle(a)}}{{\geq}}\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p_{\theta}(x_{0:T})}{q(x_{1:T}|x_{0})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
<tbody id="A1.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E7.m1" class="ltx_math_unparsed" alttext="\displaystyle=\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p(x_{T})\prod^{T}_{t=1}p_{\theta}(x_{t-1}|x_{t})}{\prod^{T}_{t=1}q(x_{t}|x_{t-1})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mrow><mn mathsize="0.710em">1</mn><mo lspace="0.278em" mathsize="0.710em" rspace="0.278em">:</mo><mi mathsize="0.710em">T</mi></mrow></msub><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mrow><mo>[</mo><mi>ln</mi><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><msubsup><mo>∏</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p(x_{T})\prod^{T}_{t=1}p_{\theta}(x_{t-1}|x_{t})}{\prod^{T}_{t=1}q(x_{t}|x_{t-1})}\right]</annotation></semantics></math></td>
