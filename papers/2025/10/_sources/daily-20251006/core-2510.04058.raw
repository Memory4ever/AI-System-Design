<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E32.m1" class="ltx_Math" alttext="\displaystyle=\exp\left\{-\frac{1}{2}\left[\frac{(x_{t}-\sqrt{\alpha_{t}}x_{t-1})^{2}}{1-\alpha_{t}}+\frac{(x_{t-1}-\sqrt{\bar{\alpha}_{t-1}}x_{0})^{2}}{1-\bar{\alpha}_{t-1}}-\frac{(x_{t}-\sqrt{\bar{\alpha}_{t}}x_{0})^{2}}{1-\bar{\alpha}_{t}}\right]\right\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>t</mi></msub><mo>−</mo><mrow><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\exp\left\{-\frac{1}{2}\left[\frac{(x_{t}-\sqrt{\alpha_{t}}x_{t-1})^{2}}{1-\alpha_{t}}+\frac{(x_{t-1}-\sqrt{\bar{\alpha}_{t-1}}x_{0})^{2}}{1-\bar{\alpha}_{t-1}}-\frac{(x_{t}-\sqrt{\bar{\alpha}_{t}}x_{0})^{2}}{1-\bar{\alpha}_{t}}\right]\right\}</annotation></semantics></math></td>
