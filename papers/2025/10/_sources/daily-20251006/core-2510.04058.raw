<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Technical Appendices and Supplementary Material</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Theoretical Analysis</h3>

<section id="A1.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">A.1.1 </span>Proof of Lemma-1</h4>

<div id="A1.SS1.SSS1.p1" class="ltx_para">
<p id="A1.SS1.SSS1.p1.1" class="ltx_p">Let <math id="A1.SS1.SSS1.p1.m1" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math> denote the true data. Thus, to increase the log-likelihood of the data, we maximize the evidence lower bound as follows:</p>
<table id="A1.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E3.m1" class="ltx_Math" alttext="\displaystyle\ln p_{\theta}(x_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ln p_{\theta}(x_{0})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E3.m2" class="ltx_math_unparsed" alttext="\displaystyle=\ln\int p_{\theta}(x_{0:T})\,dx_{1:T}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ln</mi><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\ln\int p_{\theta}(x_{0:T})\,dx_{1:T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
<tbody id="A1.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E4.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ln\int\frac{p_{\theta}(x_{0:T})}{q(x_{1:T}|x_{0})}q(x_{1:T}|x_{0})\,dx_{1:T}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ln</mi><mstyle displaystyle="true"><mo>∫</mo></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mi>q</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\ln\int\frac{p_{\theta}(x_{0:T})}{q(x_{1:T}|x_{0})}q(x_{1:T}|x_{0})\,dx_{1:T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
<tbody id="A1.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E5.m1" class="ltx_math_unparsed" alttext="\displaystyle=\ln\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\frac{p_{\theta}(x_{0:T})}{q(x_{1:T}|x_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ln</mi><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mrow><mn mathsize="0.710em">1</mn><mo lspace="0.278em" mathsize="0.710em" rspace="0.278em">:</mo><mi mathsize="0.710em">T</mi></mrow></msub><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>T</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ln\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\frac{p_{\theta}(x_{0:T})}{q(x_{1:T}|x_{0})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
