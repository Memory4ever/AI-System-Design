row></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∏</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></msubsup><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p(x_{T})p_{\theta}(x_{0}|x_{1})\prod^{T}_{t=2}p_{\theta}(x_{t-1}|x_{t})}{q(x_{1}|x_{0})\prod^{T}_{t=2}q(x_{t}|x_{t-1})}\right]</annotation></semantics></math></td>
