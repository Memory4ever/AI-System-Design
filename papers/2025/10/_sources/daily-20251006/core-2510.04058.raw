<td id="A1.F5.2.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><math id="A1.F5.m2" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="1.200em">γ</mi><mo mathsize="1.200em">=</mo><mn mathsize="1.200em">1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math></td>
<td id="A1.F5.2.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><math id="A1.F5.m3" class="ltx_Math" alttext="\gamma=0" display="inline" intent=":literal"><semantics><mrow><mi mathsize="1.200em">γ</mi><mo mathsize="1.200em">=</mo><mn mathsize="1.200em">0</mn></mrow><annotation encoding="application/x-tex">\gamma=0</annotation></semantics></math></td>
<td id="A1.F5.2.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><math id="A1.F5.m4" class="ltx_Math" alttext="\gamma=1" display="inline" intent=":literal"><semantics><mrow><mi mathsize="1.200em">γ</mi><mo mathsize="1.200em">=</mo><mn mathsize="1.200em">1</mn></mrow><annotation encoding="application/x-tex">\gamma=1</annotation></semantics></math></td></tr>
