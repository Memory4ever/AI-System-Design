t</mi></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\propto\exp\left\{-\left[\frac{(x_{t}-\sqrt{\alpha_{t}}x_{t-1})^{2}}{2(1-\alpha_{t})}+\frac{(x_{t-1}-\sqrt{\bar{\alpha}_{t-1}}x_{0})^{2}}{2(1-\bar{\alpha}_{t-1})}-\frac{(x_{t}-\sqrt{\bar{\alpha}_{t}}x_{0})^{2}}{2(1-\bar{\alpha}_{t})}\right]\right\}</annotation></semantics></math></td>
