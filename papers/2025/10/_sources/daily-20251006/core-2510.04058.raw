<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E10.m1" class="ltx_math_unparsed" alttext="\displaystyle=\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p_{\theta}(x_{T})p_{\theta}(x_{0}|x_{1})}{q(x_{1}|x_{0})}+\ln\prod^{T}_{t=2}\frac{p_{\theta}(x_{t-1}|x_{t})}{q(x_{t}|x_{t-1},x_{0})}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder accentunder="true"><mi>𝔼</mi><mrow><mi mathsize="0.700em">q</mi><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mrow><mn mathsize="0.710em">1</mn><mo lspace="0.278em" mathsize="0.710em" rspace="0.278em">:</mo><mi mathsize="0.710em">T</mi></mrow></msub><mo fence="false" maxsize="0.700em" minsize="0.700em" rspace="0.167em" stretchy="true">|</mo><mi mathsize="0.700em">x</mi><msub><mrow></mrow><mn mathsize="0.710em">0</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></munder><mrow><mo>[</mo><mi>ln</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mi>ln</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{q(x_{1:T}|x_{0})}{\mathds{E}}\left[\ln\frac{p_{\theta}(x_{T})p_{\theta}(x_{0}|x_{1})}{q(x_{1}|x_{0})}+\ln\prod^{T}_{t=2}\frac{p_{\theta}(x_{t-1}|x_{t})}{q(x_{t}|x_{t-1},x_{0})}\right]</annotation></semantics></math></td>
