<td id="S1.F1.2.2.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><img src="2510.04058v1/images/noise_samples/tin_original_125.png" id="S1.F1.g5" class="ltx_graphics ltx_img_square" style="aspect-ratio:72/72;" width="72" height="72" alt="Refer to caption"></td>
