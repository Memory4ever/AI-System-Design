</span></td></tr>
<tr id="A4.T4.2.3" class="ltx_tr">
<td id="A4.T4.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="A4.T4.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:59.6pt;">
