<span id="A4.T4.2.2.1.1" class="ltx_inline-block ltx_align_top" style="width:59.6pt;">
<span id="A4.T4.2.2.1.1.1" class="ltx_p">Standard</span>
</span></td>
<td id="A4.T4.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
