<figure id="A1.F10.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.03399v1/exact_model_accuracy_with_hints_100.svg" id="A1.F10.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/291;" width="548" height="291"></object>
