<td id="S6.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.84</td>
<td id="S6.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.83</td></tr>
