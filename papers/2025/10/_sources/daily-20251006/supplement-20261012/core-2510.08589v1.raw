<td id="S6.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.51</td>
<td id="S6.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.54</td></tr>
<tr id="S6.T2.2.4" class="ltx_tr">
<td id="S6.T2.2.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Pre-trained LLM</td>
<td id="S6.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.66</td>
<td id="S6.T2.2.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.80</td>
<td id="S6.T2.2.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.60</td></tr>
<tr id="S6.T2.2.5" class="ltx_tr">
<td id="S6.T2.2.5.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_l ltx_border_r ltx_border_t">Traditional CNN model</td>
