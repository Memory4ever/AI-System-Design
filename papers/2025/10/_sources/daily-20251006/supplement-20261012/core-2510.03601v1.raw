<td id="S4.T1.1.1.7.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Range of <math id="S4.T1.m43" class="ltx_Math" alttext="a_{x}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>x</mi></msub><annotation encoding="application/x-tex">a_{x}</annotation></semantics></math>, <math id="S4.T1.m44" class="ltx_Math" alttext="a_{y}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>y</mi></msub><annotation encoding="application/x-tex">a_{y}</annotation></semantics></math>, <math id="S4.T1.m45" class="ltx_Math" alttext="a_{z}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>z</mi></msub><annotation encoding="application/x-tex">a_{z}</annotation></semantics></math>, <math id="S4.T1.m46" class="ltx_Math" alttext="a_{norm}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">a_{norm}</annotation></semantics></math>, <math id="S4.T1.m47" class="ltx_Math" alttext="a_{verti}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">a_{verti}</annotation></semantics></math>, <math id="S4.T1.m48" class="ltx_Math" alttext="a_{hori}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">a_{hori}</annotation></semantics></math></td></tr>
<tr id="S4.T1.1.1.8" class="ltx_tr">
<td id="S4.T1.1.1.8.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t"><math id="S4.T1.m49" class="ltx_Math" alttext="f_{37}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>37</mn></msub><annotation encoding="application/x-tex">f_{37}</annotation></semantics></math>-<math id="S4.T1.m50" class="ltx_Math" alttext="f_{42}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>42</mn></msub><annotation encoding="application/x-tex">f_{42}</annotation></semantics></math></td>
<td id="S4.T1.1.1.8.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Kurtosis of <math id="S4.T1.m51" class="ltx_Math" alttext="a_{x}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>x</mi></msub><annotation encoding="application/x-tex">a_{x}</annotation></semantics></math>, <math id="S4.T1.m52" class="ltx_Math" alttext="a_{y}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>y</mi></msub><annotation encoding="application/x-tex">a_{y}</annotation></semantics></math>, <math id="S4.T1.m53" class="ltx_Math" alttext="a_{z}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>z</mi></msub><annotation encoding="application/x-tex">a_{z}</annotation></semantics></math>, <math id="S4.T1.m54" class="ltx_Math" alttext="a_{norm}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">a_{norm}</annotation></semantics></math>, <math id="S4.T1.m55" class="ltx_Math" alttext="a_{verti}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">a_{verti}</annotation></semantics></math>, <math id="S4.T1.m56" class="ltx_Math" alttext="a_{hori}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">a_{hori}</annotation></semantics></math></td></tr>
<tr id="S4.T1.1.1.9" class="ltx_tr">
