668007</mn></mtd></mtr><mtr><mtd class="ltx_border_r"><mtext>Node 6</mtext></mtd><mtd><mn>0.72052484</mn></mtd><mtd><mn>0.01203289</mn></mtd><mtd><mn>0.01298641</mn></mtd><mtd><mn>0.13385736</mn></mtd><mtd><mn>0.03999831</mn></mtd><mtd><mn>0.99906798</mn></mtd><mtd><mn>0.00444744</mn></mtd></mtr><mtr><mtd class="ltx_border_r"><mtext>Node 7</mtext></mtd><mtd><mn>0.47177742</mn></mtd><mtd><mn>0.2015933</mn></mtd><mtd><mn>0.19423189</mn></mtd><mtd><mn>0.18687385</mn></mtd><mtd><mn>0.1637312</mn></mtd><mtd><mn>0.16343586</mn></mtd><mtd><mn>0.99878354</mn></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{array}[]{c|ccccccc}&amp;\text{Node 1}&amp;\text{Node 2}&amp;\text{Node 3}&amp;\text{Node 4}&amp;\text{Node 5}&amp;\text{Node 6}&amp;\text{Node 7}\\
