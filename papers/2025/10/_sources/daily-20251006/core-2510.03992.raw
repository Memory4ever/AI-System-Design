<thead class="ltx_thead">
<tr id="A2.T3.5.1" class="ltx_tr">
<th id="A2.T3.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Retriever Type</th>
<th id="A2.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Robust Accuracy</th></tr>
</thead>
