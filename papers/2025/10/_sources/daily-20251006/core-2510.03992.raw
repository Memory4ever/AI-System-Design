<th id="A2.T2.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Clean Accuracy</th>
<th id="A2.T2.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Robust Accuracy</th></tr>
