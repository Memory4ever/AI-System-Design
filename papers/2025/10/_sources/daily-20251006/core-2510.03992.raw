<th id="A2.T4.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T4.m4" class="ltx_Math" alttext="k=5" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">k=5</annotation></semantics></math></th>
<th id="A2.T4.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T4.m5" class="ltx_Math" alttext="k=10" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">k=10</annotation></semantics></math></th></tr>
