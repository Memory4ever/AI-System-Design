<td id="A4.F13.2.10.3" class="ltx_td ltx_align_center">Nein</td>
<td id="A4.F13.2.10.4" class="ltx_td ltx_align_center">No</td></tr>
<tr id="A4.F13.2.11" class="ltx_tr">
<td id="A4.F13.2.11.1" class="ltx_td ltx_align_left ltx_align_top">
<span id="A4.F13.2.11.1.1" class="ltx_inline-block ltx_align_top" style="width:256.1pt;">
