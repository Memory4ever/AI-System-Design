<td id="A3.T10.2.7.1" class="ltx_td ltx_align_left">Beds</td>
<td id="A3.T10.2.7.2" class="ltx_td ltx_align_left">Foam Mattress</td>
<td id="A3.T10.2.7.3" class="ltx_td ltx_align_left">Water Mattress</td></tr>
