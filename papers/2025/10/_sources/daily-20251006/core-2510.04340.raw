<th id="A7.T13.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">
<span id="A7.T13.2.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="A7.T13.2.1.2.1.1" class="ltx_p">Value</span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A7.T13.2.2" class="ltx_tr">
<th id="A7.T13.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A7.T13.2.2.1.1" class="ltx_text ltx_font_typewriter">No Sys</span></th>
<td id="A7.T13.2.2.2" class="ltx_td ltx_border_t"></td></tr>
<tr id="A7.T13.2.3" class="ltx_tr">
<th id="A7.T13.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A7.T13.2.3.1.1" class="ltx_text ltx_font_typewriter">HHH</span></th>
<td id="A7.T13.2.3.2" class="ltx_td ltx_align_left">
