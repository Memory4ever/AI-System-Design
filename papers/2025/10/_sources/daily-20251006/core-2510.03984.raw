<div id="alg3.l0" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
                
                
               Task description <math id="alg3.l0.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, Sub-task description <math id="alg3.l0.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, Dataset description <math id="alg3.l0.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, Agent <math id="alg3.l0.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, Simulated User <math id="alg3.l0.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, Relevant labels from <span id="alg3.l0.3" class="ltx_text ltx_font_typewriter">Session A</span> <span id="alg3.l0.4" class="ltx_text ltx_markedasmath">Relevant_Labels_A</span>, QA utterances for <span id="alg3.l0.5" class="ltx_text ltx_font_typewriter">Session A</span> <span id="alg3.l0.6" class="ltx_text ltx_markedasmath">QA_utterances</span>, Dataset <math id="alg3.l0.m8" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>

</div>
<div id="alg3.l0a" class="ltx_listingline">
