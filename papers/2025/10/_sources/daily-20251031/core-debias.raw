<td id="A4.T2.2.6.6" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;">101</td>
<td id="A4.T2.2.6.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.6pt;padding-right:3.6pt;">2048</td>
<td id="A4.T2.2.6.8" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;">24</td>
<td id="A4.T2.2.6.9" class="ltx_td ltx_align_center" style="padding-left:3.6pt;padding-right:3.6pt;">1024</td></tr>
<tr id="A4.T2.2.7" class="ltx_tr">
<th id="A4.T2.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:3.6pt;padding-right:3.6pt;">L</th>
<td id="A4.T2.2.7.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.6pt;padding-right:3.6pt;">24</td>
<td id="A4.T2.2.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:3.6pt;padding-right:3.6pt;">1024</td>
<td id="A4.T2.2.7.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.6pt;padding-right:3.6pt;">48</td>
<td id="A4.T2.2.7.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_rr" style="padding-left:3.6pt;padding-right:3.6pt;">1024</td>
<td id="A4.T2.2.7.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.6pt;padding-right:3.6pt;">152</td>
