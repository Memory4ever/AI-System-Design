            <span id="lstnumberx19.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Please</span><span id="lstnumberx19.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">analyze</span><span id="lstnumberx19.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">whether</span><span id="lstnumberx19.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">the</span><span id="lstnumberx19.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">code</span><span id="lstnumberx19.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">meets</span><span id="lstnumberx19.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">the</span><span id="lstnumberx19.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx19.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">rule:</span>
</div>
<div id="lstnumberx20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6</span>
              
              
              
            <span id="lstnumberx20.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Do</span><span id="lstnumberx20.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">not</span><span id="lstnumberx20.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">remain</span><span id="lstnumberx20.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stopped</span><span id="lstnumberx20.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">when</span><span id="lstnumberx20.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">the</span><span id="lstnumberx20.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">road</span><span id="lstnumberx20.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">is</span><span id="lstnumberx20.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx20.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">clear,</span>
</div>
<div id="lstnumberx21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7</span>
              
              
              
            
</div>
<div id="lstnumberx22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8</span>
              
              
              
            <span id="lstnumberx22.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Please</span><span id="lstnumberx22.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">answer</span><span id="lstnumberx22.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">with</span><span id="lstnumberx22.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">a</span><span id="lstnumberx22.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">single</span><span id="lstnumberx22.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">letter</span><span id="lstnumberx22.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.14" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">’</span><span id="lstnumberx22.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Y</span><span id="lstnumberx22.16" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">’</span><span id="lstnumberx22.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">or</span><span id="lstnumberx22.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.20" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">’</span><span id="lstnumberx22.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">N</span><span id="lstnumberx22.22" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">’</span><span id="lstnumberx22.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">,</span><span id="lstnumberx22.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">indicating</span><span id="lstnumberx22.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">yes</span><span id="lstnumberx22.28" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">or</span><span id="lstnumberx22.30" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx22.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">no.</span>
</div>
</div>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Formal Logic Specifications</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">We present the complete list of specifications below.</p>
</div>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p"><math id="A3.SS2.p2.m1" class="ltx_Math" alttext="\phi_{1}=\mathbf{G}\text{ pedestrian }\rightarrow\mathbf{X}\neg\text{ publish velocity }" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>𝐆</mi><mo lspace="0em" rspace="0em">​</mo><mtext> pedestrian </mtext></mrow><mo stretchy="false">→</mo><mrow><mi>𝐗</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">¬</mo><mtext> publish velocity </mtext></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{1}=\mathbf{G}\text{ pedestrian }\rightarrow\mathbf{X}\neg\text{ publish velocity }</annotation></semantics></math>,</p>
</div>
<div id="A3.SS2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.p3.1" class="ltx_p"><math id="A3.SS2.p3.m1" class="ltx_Math" alttext="\phi_{2}=\mathbf{F}\neg(\text{pedestrian}\vee\text{car}\vee\text{red light})\rightarrow\mathbf{X}\text{publish velocity}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>𝐅</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>pedestrian</mtext><mo>∨</mo><mtext>car</mtext><mo>∨</mo><mtext>red light</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐗</mi><mo lspace="0em" rspace="0em">​</mo><mtext>publish velocity</mtext></mrow></mrow><annotation encoding="application/x-tex">\phi_{2}=\mathbf{F}\neg(\text{pedestrian}\vee\text{car}\vee\text{red light})\rightarrow\mathbf{X}\text{publish velocity}</annotation></semantics></math>,</p>
</div>
<div id="A3.SS2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.p4.1" class="ltx_p"><math id="A3.SS2.p4.m1" class="ltx_Math" alttext="\phi_{3}=\mathbf{G}(\text{ stop sign }\wedge\text{ car })\rightarrow\mathbf{X}\neg\text{ publish velocity }" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>3</mn></msub><mo>=</mo><mrow><mi>𝐆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext> stop sign </mtext><mo>∧</mo><mtext> car </mtext></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝐗</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">¬</mo><mtext> publish velocity </mtext></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{3}=\mathbf{G}(\text{ stop sign }\wedge\text{ car })\rightarrow\mathbf{X}\neg\text{ publish velocity }</annotation></semantics></math>,</p>
</div>
<div id="A3.SS2.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.p5.1" class="ltx_p"><math id="A3.SS2.p5.m1" class="ltx_Math" alttext="\phi_{4}=\mathbf{G}\text{ stop sign}\rightarrow\mathbf{F}\text{ stop }" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>4</mn></msub><mo>=</mo><mrow><mi>𝐆</mi><mo lspace="0em" rspace="0em">​</mo><mtext> stop sign</mtext></mrow><mo stretchy="false">→</mo><mrow><mi>𝐅</mi><mo lspace="0em" rspace="0em">​</mo><mtext> stop </mtext></mrow></mrow><annotation encoding="application/x-tex">\phi_{4}=\mathbf{G}\text{ stop sign}\rightarrow\mathbf{F}\text{ stop }</annotation></semantics></math>,</p>
</div>
<div id="A3.SS2.p6" class="ltx_para ltx_noindent">
<p id="A3.SS2.p6.1" class="ltx_p"><math id="A3.SS2.p6.m1" class="ltx_Math" alttext="\phi_{5}=\mathbf{G}\text{ red light}\rightarrow\mathbf{X}(\neg\text{ move forward }\wedge\neg\text{ turn left})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>5</mn></msub><mo>=</mo><mrow><mi>𝐆</mi><mo lspace="0em" rspace="0em">​</mo><mtext> red light</mtext></mrow><mo stretchy="false">→</mo><mrow><mi>𝐗</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">¬</mo><mtext> move forward </mtext></mrow><mo>∧</mo><mrow><mo rspace="0.167em">¬</mo><mtext> turn left</mtext></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{5}=\mathbf{G}\text{ red light}\rightarrow\mathbf{X}(\neg\text{ move forward }\wedge\neg\text{ turn left})</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.p7" class="ltx_para ltx_noindent">
<p id="A3.SS2.p7.1" class="ltx_p">We have APIs for observing stop signs, traffic lights, etc., that correspond to the atomic propositions “red/green light,” “stop sign,” etc. The propositions “turn left/right,” “move forward,” and “stop” correspond to the API <em id="A3.SS2.p7.1.1" class="ltx_emph ltx_font_italic">velocity_publisher</em> with different linear and angular speeds. For example, “move forward” corresponds to <em id="A3.SS2.p7.1.2" class="ltx_emph ltx_font_italic">velocity_publisher(linear=10, angular=0)</em>.</p>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Natural Language Rules</h3>

<div id="A3.SS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS3.p1.1" class="ltx_p">As described in section <a href="#S6" title="6 Demonstration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, we provide 30 natural language rules, from which we sample a subset of rules for training and evaluation. The rules are presented below.</p>
</div>
<figure id="LST2" class="ltx_float ltx_lstlisting">
<div id="LST2.2" class="ltx_listing ltx_lst_numbers_left ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1</span>
              
              
              
            <span id="lstnumberx23.2" class="ltx_text ltx_font_typewriter">============</span><span id="lstnumberx23.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Training</span><span id="lstnumberx23.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx23.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx23.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx23.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Calibration</span><span id="lstnumberx23.8" class="ltx_text ltx_font_typewriter">======</span>
</div>
<div id="lstnumberx24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2</span>
              
              
              
            <span id="lstnumberx24.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Give</span><span id="lstnumberx24.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx24.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">right</span><span id="lstnumberx24.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx24.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">way</span><span id="lstnumberx24.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx24.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">all</span><span id="lstnumberx24.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pedestrians</span><span id="lstnumberx24.17" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3</span>
              
              
              
            <span id="lstnumberx25.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Let</span><span id="lstnumberx25.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pedestrians</span><span id="lstnumberx25.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pass</span><span id="lstnumberx25.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">first</span><span id="lstnumberx25.9" class="ltx_text ltx_font_typewriter">.</span>
</div>
