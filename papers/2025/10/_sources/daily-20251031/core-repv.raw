            <span id="lstnumberx17.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">&lt;</span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Plan</span><span id="lstnumberx17.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx17.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">expressed</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx17.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">in</span><span id="lstnumberx17.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx17.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">Python</span><span id="lstnumberx17.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0000FF;"> </span><span id="lstnumberx17.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">function</span><span id="lstnumberx17.12" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">&gt;</span>
