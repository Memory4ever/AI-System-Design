            <span id="lstnumberx80.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx80.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">there</span><span id="lstnumberx80.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx80.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx80.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">obstacle</span><span id="lstnumberx80.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx80.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx80.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">agent</span><span id="lstnumberx80.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">should</span><span id="lstnumberx80.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">keep</span><span id="lstnumberx80.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx80.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">moving</span><span id="lstnumberx80.22" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx81" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13</span>
              
              
              
            <span id="lstnumberx81.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Whenever</span><span id="lstnumberx81.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx81.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">path</span><span id="lstnumberx81.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx81.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">clear</span><span id="lstnumberx81.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx81.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx81.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">robot</span><span id="lstnumberx81.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx81.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">continue</span><span id="lstnumberx81.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rather</span><span id="lstnumberx81.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">than</span><span id="lstnumberx81.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx81.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">stop</span><span id="lstnumberx81.26" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx82" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14</span>
              
              
              
            <span id="lstnumberx82.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">In</span><span id="lstnumberx82.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx82.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">absence</span><span id="lstnumberx82.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx82.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">obstacles</span><span id="lstnumberx82.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx82.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx82.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">next</span><span id="lstnumberx82.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">action</span><span id="lstnumberx82.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx82.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx82.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">be</span><span id="lstnumberx82.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx82.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx82.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">stop</span><span id="lstnumberx82.28" class="ltx_text ltx_font_typewriter">.</span>
</div>
</div>
</div>
<div id="A4.SS1.p9" class="ltx_para ltx_noindent">
<p id="A4.SS1.p9.1" class="ltx_p"><span id="A4.SS1.p9.1.1" class="ltx_text ltx_font_bold">Aerial Navigation:</span>
We use the <span id="A4.SS1.p9.1.2" class="ltx_text ltx_font_typewriter">PX4 Vision 1.0</span> quadracopter (drone) with the APIs presented below.</p>
<div id="A4.SS1.p9.2" class="ltx_listing ltx_lst_language_Python ltx_lst_numbers_left ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing" style="--ltx-bg-color:#F5F5F5;--ltx-border-color:#C8C8C8;"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx83" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1</span>
              
              
              
            <span id="lstnumberx83.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">set_velocity_ned</span><span id="lstnumberx83.3" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx83.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">north</span><span id="lstnumberx83.5" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx83.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx83.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">east</span><span id="lstnumberx83.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx83.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx83.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">down</span><span id="lstnumberx83.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx83.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx83.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">angle</span><span id="lstnumberx83.14" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx83.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx83.16" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="--ltx-fg-color:#008000;">#<span id="lstnumberx83.16.1" class="ltx_text ltx_lst_space"> </span>set<span id="lstnumberx83.16.2" class="ltx_text ltx_lst_space"> </span>drone<span id="lstnumberx83.16.3" class="ltx_text ltx_lst_space"> </span>velocity<span id="lstnumberx83.16.4" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx83.16.5" class="ltx_text ltx_lst_space"> </span>m/s,<span id="lstnumberx83.16.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx83.16.7" class="ltx_text ltx_lst_space"> </span>drone<span id="lstnumberx83.16.8" class="ltx_text ltx_lst_space"> </span>will<span id="lstnumberx83.16.9" class="ltx_text ltx_lst_space"> </span>keep<span id="lstnumberx83.16.10" class="ltx_text ltx_lst_space"> </span>moving<span id="lstnumberx83.16.11" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx83.16.12" class="ltx_text ltx_lst_space"> </span>this<span id="lstnumberx83.16.13" class="ltx_text ltx_lst_space"> </span>velocity<span id="lstnumberx83.16.14" class="ltx_text ltx_lst_space"> </span>until<span id="lstnumberx83.16.15" class="ltx_text ltx_lst_space"> </span>it<span id="lstnumberx83.16.16" class="ltx_text ltx_lst_space"> </span>receives<span id="lstnumberx83.16.17" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx83.16.18" class="ltx_text ltx_lst_space"> </span>next<span id="lstnumberx83.16.19" class="ltx_text ltx_lst_space"> </span>command</span>
</div>
<div id="lstnumberx84" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2</span>
              
              
              
            <span id="lstnumberx84.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sleep_for</span><span id="lstnumberx84.3" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx84.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">seconds</span><span id="lstnumberx84.5" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx84.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx84.7" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#0000B4;">float</span><span id="lstnumberx84.8" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx84.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx84.10" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="--ltx-fg-color:#008000;">#<span id="lstnumberx84.10.1" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx84.10.2" class="ltx_text ltx_lst_space"> </span>drone<span id="lstnumberx84.10.3" class="ltx_text ltx_lst_space"> </span>will<span id="lstnumberx84.10.4" class="ltx_text ltx_lst_space"> </span>keep<span id="lstnumberx84.10.5" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx84.10.6" class="ltx_text ltx_lst_space"> </span>current<span id="lstnumberx84.10.7" class="ltx_text ltx_lst_space"> </span>action<span id="lstnumberx84.10.8" class="ltx_text ltx_lst_space"> </span>(velocity)<span id="lstnumberx84.10.9" class="ltx_text ltx_lst_space"> </span>during<span id="lstnumberx84.10.10" class="ltx_text ltx_lst_space"> </span>sleep<span id="lstnumberx84.10.11" class="ltx_text ltx_lst_space"> </span>time</span>
</div>
<div id="lstnumberx85" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3</span>
              
              
              
            <span id="lstnumberx85.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">obstacle_in_front</span><span id="lstnumberx85.3" class="ltx_text ltx_font_typewriter">()</span><span id="lstnumberx85.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx85.5" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="--ltx-fg-color:#008000;">#<span id="lstnumberx85.5.1" class="ltx_text ltx_lst_space"> </span>returns<span id="lstnumberx85.5.2" class="ltx_text ltx_lst_space"> </span>a<span id="lstnumberx85.5.3" class="ltx_text ltx_lst_space"> </span>boolean</span>
</div>
<div id="lstnumberx86" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4</span>
              
              
              
            <span id="lstnumberx86.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">attitude_limit</span><span id="lstnumberx86.3" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx86.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">max_meters</span><span id="lstnumberx86.5" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx86.6" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="--ltx-fg-color:#008000;">#<span id="lstnumberx86.6.1" class="ltx_text ltx_lst_space"> </span>returns<span id="lstnumberx86.6.2" class="ltx_text ltx_lst_space"> </span>a<span id="lstnumberx86.6.3" class="ltx_text ltx_lst_space"> </span>boolean,<span id="lstnumberx86.6.4" class="ltx_text ltx_lst_space"> </span>true<span id="lstnumberx86.6.5" class="ltx_text ltx_lst_space"> </span>if<span id="lstnumberx86.6.6" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx86.6.7" class="ltx_text ltx_lst_space"> </span>drone<span id="lstnumberx86.6.8" class="ltx_text ltx_lst_space"> </span>does<span id="lstnumberx86.6.9" class="ltx_text ltx_lst_space"> </span>not<span id="lstnumberx86.6.10" class="ltx_text ltx_lst_space"> </span>exceed<span id="lstnumberx86.6.11" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx86.6.12" class="ltx_text ltx_lst_space"> </span>limit</span>
</div>
</div>
</div>
<div id="A4.SS1.p10" class="ltx_para ltx_noindent">
<p id="A4.SS1.p10.1" class="ltx_p">To obtain ground truth labels for quantitative analysis, we use the following two specifications:</p>
</div>
<div id="A4.SS1.p11" class="ltx_para ltx_noindent">
<p id="A4.SS1.p11.1" class="ltx_p"><math id="A4.SS1.p11.m1" class="ltx_Math" alttext="\phi_{9}=\mathbf{G}(\text{ landing speed }&lt;1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>9</mn></msub><mo>=</mo><mrow><mi>𝐆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext> landing speed </mtext><mo>&lt;</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{9}=\mathbf{G}(\text{ landing speed }&lt;1)</annotation></semantics></math>,</p>
</div>
<div id="A4.SS1.p12" class="ltx_para ltx_noindent">
<p id="A4.SS1.p12.1" class="ltx_p"><math id="A4.SS1.p12.m1" class="ltx_Math" alttext="\phi_{10}=\mathbf{G}(\text{ attitude limit })" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>10</mn></msub><mo>=</mo><mrow><mi>𝐆</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext> attitude limit </mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{10}=\mathbf{G}(\text{ attitude limit })</annotation></semantics></math>,</p>
</div>
<div id="A4.SS1.p13" class="ltx_para ltx_noindent">
<p id="A4.SS1.p13.1" class="ltx_p">where the proposition “landing speed” is captured by the third parameter of set_velocity_ned and “attitude limit” corresponds to the API attitude_limit(max_meters).</p>
</div>
<div id="A4.SS1.p14" class="ltx_para ltx_noindent">
<p id="A4.SS1.p14.1" class="ltx_p">We present their corresponding natural language rules below.</p>
</div>
<div id="A4.SS1.p15" class="ltx_para ltx_noindent">
<div id="A4.SS1.p15.1" class="ltx_listing ltx_lst_numbers_left ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx87" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1</span>
              
              
              
            <span id="lstnumberx87.2" class="ltx_text ltx_font_typewriter">============</span><span id="lstnumberx87.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Corresponding</span><span id="lstnumberx87.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx87.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx87.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx87.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">specification</span><span id="lstnumberx87.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx87.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">phi</span><span id="lstnumberx87.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx87.11" class="ltx_text ltx_font_typewriter">9============</span>
</div>
<div id="lstnumberx88" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2</span>
              
              
              
            <span id="lstnumberx88.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx88.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">landing</span><span id="lstnumberx88.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">speed</span><span id="lstnumberx88.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">must</span><span id="lstnumberx88.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">stay</span><span id="lstnumberx88.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">below</span><span id="lstnumberx88.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.14" class="ltx_text ltx_font_typewriter">1</span><span id="lstnumberx88.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx88.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">m</span><span id="lstnumberx88.17" class="ltx_text ltx_font_typewriter">/</span><span id="lstnumberx88.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx88.19" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx89" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3</span>
              
              
              
