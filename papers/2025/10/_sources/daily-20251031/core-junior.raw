<section id="S5.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.4.1 </span>Acute Leptospirosis in Dogs</h4>

<div id="S5.SS4.SSS1.p1" class="ltx_para">
<ul id="S5.I11" class="ltx_itemize">
<li id="S5.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I11.i1.p1" class="ltx_para">
<p id="S5.I11.i1.p1.1" class="ltx_p">Acute renal failure</p>
</div></li>
<li id="S5.I11.i2" class="ltx_item" style="list-style-type:none;padding-top:0.0pt;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I11.i2.p1" class="ltx_para">
<p id="S5.I11.i2.p1.1" class="ltx_p">Jaundice</p>
</div></li>
</ul>
