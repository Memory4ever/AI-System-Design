</span></td>
<td id="A1.T9.2.4.4" class="ltx_td ltx_align_left ltx_align_top">
<span id="A1.T9.2.4.4.1" class="ltx_inline-block ltx_align_top" style="width:56.6pt;">
<span id="A1.T9.2.4.4.1.1" class="ltx_p ltx_align_left"><span id="A1.T9.2.4.4.1.1.1" class="ltx_text" style="font-size:90%;">-0.6%</span></span>
</span></td>
<td id="A1.T9.2.4.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="A1.T9.2.4.5.1" class="ltx_inline-block ltx_align_top" style="width:67.2pt;">
