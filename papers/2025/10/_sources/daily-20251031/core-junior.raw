<span id="S5.T1.2.2.1.1.1" class="ltx_p ltx_align_left"><span id="S5.T1.2.2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">PRIMARY COMPARISON (n=500, Q1-Q500)</span></span>
</span></td>
<td id="S5.T1.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"></td>
<td id="S5.T1.2.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"></td>
<td id="S5.T1.2.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"></td>
