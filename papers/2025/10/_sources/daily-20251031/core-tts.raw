<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A6" title="In Supplementary Material ‣ Don’t Let It Fade: Preserving Edits in Diffusion Language Models via Token Timestep Allocation" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">F </span>Generated Samples</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A7" title="In Supplementary Material ‣ Don’t Let It Fade: Preserving Edits in Diffusion Language Models via Token Timestep Allocation" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">G </span>Ethics Statement</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A8" title="In Supplementary Material ‣ Don’t Let It Fade: Preserving Edits in Diffusion Language Models via Token Timestep Allocation" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">H </span>Licenses</span></a></li>
