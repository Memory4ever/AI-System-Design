<td id="A1.T2.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T2.2.1.2.1" class="ltx_text ltx_font_bold">Arch.</span></td>
<td id="A1.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T2.2.1.3.1" class="ltx_text ltx_font_bold">Layers</span></td>
<td id="A1.T2.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T2.2.1.4.1" class="ltx_text ltx_font_bold">Hidden</span></td>
<td id="A1.T2.2.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T2.2.1.5.1" class="ltx_text ltx_font_bold">Attn. Heads</span></td>
<td id="A1.T2.2.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T2.2.1.6.1" class="ltx_text ltx_font_bold">RoPE <math id="A1.T2.m1" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math></span></td>
<td id="A1.T2.2.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A1.T2.2.1.7.1" class="ltx_text ltx_font_bold">Vocab</span></td></tr>
<tr id="A1.T2.2.2" class="ltx_tr">
<td id="A1.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A1.T2.m2" class="ltx_Math" alttext="1.1" display="inline" intent=":literal"><semantics><mn>1.1</mn><annotation encoding="application/x-tex">1.1</annotation></semantics></math>B</td>
<td id="A1.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">LLaMA</td>
