<td id="S5.T7.2.3.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="5"><span id="S5.T7.2.3.1.1" class="ltx_text">GPT-4.1</span></td>
<td id="S5.T7.2.3.2" class="ltx_td ltx_align_center ltx_border_t">2</td>
<td id="S5.T7.2.3.3" class="ltx_td ltx_align_center ltx_border_t">62.1</td>
