<li class="ltx_tocentry ltx_tocentry_section"><a href="#S7" title="In Which Way Does Time Flow? A Psychophysics-Grounded Evaluation for Vision–Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">7 </span>Conclusion</span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S8" title="In Which Way Does Time Flow? A Psychophysics-Grounded Evaluation for Vision–Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">8 </span>Limitations</span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In Which Way Does Time Flow? A Psychophysics-Grounded Evaluation for Vision–Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
