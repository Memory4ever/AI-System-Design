<tr id="S6.T1.2.7" class="ltx_tr">
<th id="S6.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Parameters</th>
<td id="S6.T1.2.7.2" class="ltx_td ltx_nopad_r ltx_align_left">provider-default settings unless otherwise stated</td></tr>
