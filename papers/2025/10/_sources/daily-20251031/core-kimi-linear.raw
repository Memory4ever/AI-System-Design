<td id="S5.SS1.SSS0.Px2.p2.1.1.14" class="ltx_td ltx_align_center"><span id="S5.SS1.SSS0.Px2.p2.1.1.14.1" class="ltx_text ltx_font_typewriter ltx_font_smallcaps" style="position:relative; bottom:0.5pt;--ltx-fg-color:#808080;">&lt;sep&gt;</span></td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.15" class="ltx_td ltx_align_center"><span id="S5.SS1.SSS0.Px2.p2.1.1.15.1" class="ltx_text" style="--ltx-fg-color:#B92622;">B</span></td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.16" class="ltx_td ltx_align_center"><span id="S5.SS1.SSS0.Px2.p2.1.1.16.1" class="ltx_text" style="--ltx-fg-color:#005C7F;">G</span></td></tr>
<tr id="S5.SS1.SSS0.Px2.p2.1.2" class="ltx_tr">
<td id="S5.SS1.SSS0.Px2.p2.1.2.1" class="ltx_td ltx_align_right"><span id="S5.SS1.SSS0.Px2.p2.1.2.1.1" class="ltx_text ltx_font_bold">Output</span></td>
<td id="S5.SS1.SSS0.Px2.p2.1.2.2" class="ltx_td ltx_align_center"><math id="S5.SS1.SSS0.Px2.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></td>
<td id="S5.SS1.SSS0.Px2.p2.1.2.3" class="ltx_td ltx_align_center"><math id="S5.SS1.SSS0.Px2.m2" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></td>
<td id="S5.SS1.SSS0.Px2.p2.1.2.4" class="ltx_td ltx_align_center"><math id="S5.SS1.SSS0.Px2.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></td>
<td id="S5.SS1.SSS0.Px2.p2.1.2.5" class="ltx_td ltx_align_center"><math id="S5.SS1.SSS0.Px2.m4" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></td>
<td id="S5.SS1.SSS0.Px2.p2.1.2.6" class="ltx_td ltx_align_center"><math id="S5.SS1.SSS0.Px2.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></td>
