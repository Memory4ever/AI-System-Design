<span id="S7.T7.2.1.1.1.1.1.5.2" class="ltx_td ltx_align_left" style="padding:4pt 18.0pt;">   <math id="S7.T7.m9" class="ltx_Math" alttext="-\left\langle\mathbf{S}_{t-1}^{\top}\bm{k}_{t},\bm{v}_{t}\right\rangle+\frac{1}{2}\left\|\sqrt{{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{1}-\bm{\alpha}_{t}\right)}}\mathbf{S}_{t-1}\right\|_{F}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><msubsup><mi>𝐒</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>t</mi></msub></mrow><mo>,</mo><msub><mi>𝒗</mi><mi>t</mi></msub></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msqrt><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝟏</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">−</mo><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi></msub></mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">-\left\langle\mathbf{S}_{t-1}^{\top}\bm{k}_{t},\bm{v}_{t}\right\rangle+\frac{1}{2}\left\|\sqrt{{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{1}-\bm{\alpha}_{t}\right)}}\mathbf{S}_{t-1}\right\|_{F}^{2}</annotation></semantics></math>   </span>
<span id="S7.T7.2.1.1.1.1.1.5.3" class="ltx_td ltx_align_left" style="padding:4pt 18.0pt;">   <math id="S7.T7.m10" class="ltx_Math" alttext="\mathbf{S}_{t}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{t})}\mathbf{S}_{t-1}+\bm{k}_{t}\bm{v}_{t}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐒</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi></msub><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>𝒌</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{S}_{t}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{t})}\mathbf{S}_{t-1}+\bm{k}_{t}\bm{v}_{t}^{\top}</annotation></semantics></math>   </span></span>
