<td id="S5.SS1.SSS0.Px2.p2.1.1.7" class="ltx_td ltx_align_center"><span id="S5.SS1.SSS0.Px2.p2.1.1.7.1" class="ltx_text" style="--ltx-fg-color:#B92622;">0</span></td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.8" class="ltx_td ltx_align_center">M</td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.9" class="ltx_td ltx_align_center">8</td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.10" class="ltx_td ltx_align_center"><span id="S5.SS1.SSS0.Px2.p2.1.1.10.1" class="ltx_text" style="--ltx-fg-color:#005C7F;">G</span></td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.11" class="ltx_td ltx_align_center"><span id="S5.SS1.SSS0.Px2.p2.1.1.11.1" class="ltx_text" style="--ltx-fg-color:#005C7F;">5</span></td>
<td id="S5.SS1.SSS0.Px2.p2.1.1.12" class="ltx_td ltx_align_center">E</td>
