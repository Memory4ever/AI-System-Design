<td id="S5.SS1.SSS0.Px1.p1.2.2.4" class="ltx_td ltx_align_center"><math id="S5.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math></td>
