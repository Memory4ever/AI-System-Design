mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></munder><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{r-1}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{u}_{[t]}^{i\top}+\bm{k}_{[t]}^{r}\left(\underbrace{\beta_{[t]}^{r}\left(\bm{v}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{u}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)}_{\bm{u}_{[t]}^{r}}\right)^{\top}</annotation></semantics></math></td>
