<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_keyword ltx_font_bold">def</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier">chunk_dplr</span>(<span id="lstnumberx1.4" class="ltx_text ltx_lst_identifier">q</span>,<span id="lstnumberx1.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.6" class="ltx_text ltx_lst_identifier">k</span>,<span id="lstnumberx1.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.8" class="ltx_text ltx_lst_identifier">v</span>,<span id="lstnumberx1.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.10" class="ltx_text ltx_lst_identifier">a</span>,<span id="lstnumberx1.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.12" class="ltx_text ltx_lst_identifier">b</span>,<span id="lstnumberx1.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.14" class="ltx_text ltx_lst_identifier">g</span>,<span id="lstnumberx1.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.16" class="ltx_text ltx_lst_identifier">chunk_size</span>):
