<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Hardware-Efficient Chunkwise Algorithm</h3>

<div id="S3.SS1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.p1.2" class="ltx_p">By partially expanding the recurrence for Eq. <a href="#S3.E1" title="In 3 Kimi Delta Attention: Improving Delta Rule with Fine-grained Gating ‣ Kimi Linear:An Expressive, Efficient Attention Architecture" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> into a chunk-wise formulation, we have:</p>
<table id="S3.E2" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E2X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E2X.m2" class="ltx_Math" alttext="\displaystyle\mathbf{S}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\mathbf{S}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2X.m3" class="ltx_Math" alttext="\displaystyle=\underbrace{\left(\prod_{i=1}^{t}\left(\mathbf{I}-\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{k}_{[t]}^{i\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{i})}\right)}_{:=\mathbf{P}_{[t]}^{r}}\cdot\mathbf{S}_{[t]}^{0}+\underbrace{\sum_{i=1}^{r}\left(\prod_{j=i}^{t}\left(\mathbf{I}-\beta_{[t]}^{j}\bm{k}_{[t]}^{j}\bm{k}_{[t]}^{j\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{j})}\right)\cdot\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{v}_{[t]}^{i\top}}_{:=\mathbf{H}_{[t]}^{r}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder accentunder="true"><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow></mrow></msub><mo rspace="0.222em">⋅</mo><mi>𝐒</mi><msub><mrow></mrow><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><msup><mrow></mrow><mn>0</mn></msup><mo>+</mo><munder accentunder="true"><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>j</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">j</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\left(\prod_{i=1}^{t}\left(\mathbf{I}-\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{k}_{[t]}^{i\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{i})}\right)}_{:=\mathbf{P}_{[t]}^{r}}\cdot\mathbf{S}_{[t]}^{0}+\underbrace{\sum_{i=1}^{r}\left(\prod_{j=i}^{t}\left(\mathbf{I}-\beta_{[t]}^{j}\bm{k}_{[t]}^{j}\bm{k}_{[t]}^{j\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{j})}\right)\cdot\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{v}_{[t]}^{i\top}}_{:=\mathbf{H}_{[t]}^{r}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(2)</span></td></tr></tbody>
</table>
</div>
<section id="S3.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">WY Representation</h5>

<div id="S3.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.SSS0.Px1.p1.1" class="ltx_p">is typically employed to pack a series rank-1 updates into a single compact representation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx11" title="" class="ltx_ref">11</a>]</cite>. We follow the formulation of <math id="S3.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathbf{P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">\mathbf{P}</annotation></semantics></math> in Comba <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">40</a>]</cite> to reduce the need for an additional matrix inversion in subsequent computations.</p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E3.m1" class="ltx_Math" alttext="\displaystyle\mathbf{P}_{[t]}^{r}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}-\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{i\rightarrow r})}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{P}_{[t]}^{r}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}-\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{i\rightarrow r})}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E3.m2" class="ltx_Math" alttext="\displaystyle\mathbf{H}_{[t]}^{r}=\sum_{i=1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{u}_{[t]}^{i\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{H}_{[t]}^{r}=\sum_{i=1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{u}_{[t]}^{i\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px1.p1.2" class="ltx_p">where the auxiliary vector <math id="S3.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\bm{w}_{t}\in\mathbb{R}^{d_{k}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒘</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>k</mi></msub></msup></mrow><annotation encoding="application/x-tex">\bm{w}_{t}\in\mathbb{R}^{d_{k}}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\bm{u}_{t}\in\mathbb{R}^{d_{v}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒖</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>v</mi></msub></msup></mrow><annotation encoding="application/x-tex">\bm{u}_{t}\in\mathbb{R}^{d_{v}}</annotation></semantics></math> are computed via the following recurrence relation:</p>
<table id="S3.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E4.m1" class="ltx_Math" alttext="\displaystyle\bm{w}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\bm{w}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E4.m2" class="ltx_Math" alttext="\displaystyle=\beta_{[t]}^{r}\left({\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}\bm{k}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{w}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\beta_{[t]}^{r}\left({\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}\bm{k}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{w}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
<tbody id="S3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E5.m1" class="ltx_Math" alttext="\displaystyle\bm{u}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\bm{u}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5.m2" class="ltx_Math" alttext="\displaystyle=\beta_{[t]}^{r}\left(\bm{v}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{u}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒗</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\beta_{[t]}^{r}\left(\bm{v}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{u}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S3.SS1.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">UT transform.</h5>

<div id="S3.SS1.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.SSS0.Px2.p1.1" class="ltx_p">We apply the UT transform <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx46" title="" class="ltx_ref">46</a>]</cite> to reduce non-matmul FLOPs, which is crucial to enable better hardware utilization during training.</p>
<table id="S3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E6.m1" class="ltx_Math" alttext="\displaystyle\mathbf{M}_{[t]}" display="inline" intent=":literal"><semantics><msub><mi>𝐌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\displaystyle\mathbf{M}_{[t]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E6.m2" class="ltx_Math" alttext="\displaystyle=\left(\mathbf{I}+\operatorname{StrictTril}\left(\operatorname{Diag}\left(\beta_{[t]}\right)\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{K}_{[t]}\right)\left(\frac{\mathbf{K}_{[t]}}{{\color[rgb]{0.7266,0.1484,0.1328}\bm{\Gamma}_{[t]}^{1\rightarrow C}}}\right)^{\top}\right)\right)^{-1}\operatorname{Diag}\left(\beta_{[t]}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>+</mo><mrow><mi>StrictTril</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>Diag</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐊</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>𝐊</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup></mfrac></mstyle><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Diag</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\mathbf{I}+\operatorname{StrictTril}\left(\operatorname{Diag}\left(\beta_{[t]}\right)\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{K}_{[t]}\right)\left(\frac{\mathbf{K}_{[t]}}{{\color[rgb]{0.7266,0.1484,0.1328}\bm{\Gamma}_{[t]}^{1\rightarrow C}}}\right)^{\top}\right)\right)^{-1}\operatorname{Diag}\left(\beta_{[t]}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
<tbody id="S3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E7.m1" class="ltx_Math" alttext="\displaystyle\mathbf{W}_{[t]}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\displaystyle\mathbf{W}_{[t]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E7.m2" class="ltx_Math" alttext="\displaystyle=\mathbf{M}_{[t]}\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{K}_{[t]}\right),\quad\quad\quad\mathbf{U}_{[t]}=\mathbf{M}_{[t]}\mathbf{V}_{[t]}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝐌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐊</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="3.167em">,</mo><mrow><msub><mi>𝐔</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mrow><msub><mi>𝐌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{M}_{[t]}\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{K}_{[t]}\right),\quad\quad\quad\mathbf{U}_{[t]}=\mathbf{M}_{[t]}\mathbf{V}_{[t]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p1.2" class="ltx_p">The inverse of a lower triangular matrix can be efficiently computed through an iterative row-wise approach by forward substitution in Gaussian elimination <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">28</a>]</cite>.</p>
</div>
<div id="S3.SS1.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.SSS0.Px2.p2.1" class="ltx_p">Equivalently, in matrix form, we can update the state in chunk-wise:</p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="\mathbf{S}_{[t+1]}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{C})}\mathbf{S}_{[t]}+\left({\color[rgb]{0.7266,0.1484,0.1328}\bm{\Gamma}_{[t]}^{i\rightarrow C}}\odot\mathbf{K}_{[t]}\right)^{\top}\left(\mathbf{U}_{[t]}-\mathbf{W}_{[t]}\mathbf{S}_{[t]}\right)\in\mathbb{R}^{d_{k}\times d_{v}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mrow><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐊</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝐔</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo>−</mo><mrow><msub><mi>𝐖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>d</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{S}_{[t+1]}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{C})}\mathbf{S}_{[t]}+\left({\color[rgb]{0.7266,0.1484,0.1328}\bm{\Gamma}_{[t]}^{i\rightarrow C}}\odot\mathbf{K}_{[t]}\right)^{\top}\left(\mathbf{U}_{[t]}-\mathbf{W}_{[t]}\mathbf{S}_{[t]}\right)\in\mathbb{R}^{d_{k}\times d_{v}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<figure id="S3.SS1.SSS0.Px2.fig1" class="ltx_figure">
<p id="S3.SS1.SSS0.Px2.fig1.1" class="ltx_p"><span id="S3.SS1.SSS0.Px2.fig1.1.1" class="ltx_text ltx_inline-block" style="width:345.0pt;">
