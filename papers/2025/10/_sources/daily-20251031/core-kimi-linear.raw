<td id="S5.SS1.SSS0.Px1.p1.2.1.2" class="ltx_td ltx_align_center">O</td>
<td id="S5.SS1.SSS0.Px1.p1.2.1.3" class="ltx_td ltx_align_center">G</td>
<td id="S5.SS1.SSS0.Px1.p1.2.1.4" class="ltx_td ltx_align_center">R</td>
