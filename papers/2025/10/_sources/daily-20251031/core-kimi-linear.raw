<div id="S3.SS1.SSS0.Px2.p3" class="ltx_para ltx_noindent">
<p id="S3.SS1.SSS0.Px2.p3.1" class="ltx_p">During the output stage, we adopt an inter-block recurrent and intra-block parallel strategy to maximize matrix multiplication throughput, thereby fully utilizing the computational potential of Tensor Cores.</p>
<table id="S3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E9.m1" class="ltx_Math" alttext="\mathbf{O}_{[t]}=\underbrace{\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{Q}_{[t]}\right)\mathbf{S}_{[t]}}_{\text{inter chunk}}+\underbrace{\operatorname{Tril}\left(\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{Q}_{[t]}\right)\left(\frac{\mathbf{K}_{[t]}}{{\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}}\right)^{\top}\right)}_{\text{intra chunk}}\underbrace{\left(\mathbf{U}_{[t]}-\mathbf{W}_{[t]}\mathbf{S}_{[t]}\right)}_{\text{``pseudo''-value term}}\in\mathbb{R}^{C\times d_{v}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐎</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><mrow><mo>(</mo><mrow><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐐</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo stretchy="true">⏟</mo></munder><mtext>inter chunk</mtext></munder><mo>+</mo><mrow><munder><munder accentunder="true"><mrow><mi>Tril</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐐</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msub><mi>𝐊</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝚪</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">C</mi></mrow></msubsup></mfrac><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>intra chunk</mtext></munder><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mo>(</mo><mrow><msub><mi>𝐔</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo>−</mo><mrow><msub><mi>𝐖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow><mo>)</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext>“pseudo”-value term</mtext></munder></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>v</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{O}_{[t]}=\underbrace{\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{Q}_{[t]}\right)\mathbf{S}_{[t]}}_{\text{inter chunk}}+\underbrace{\operatorname{Tril}\left(\left({\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}\odot\mathbf{Q}_{[t]}\right)\left(\frac{\mathbf{K}_{[t]}}{{\color[rgb]{0.7266,0.1484,0.1328}{\bm{\Gamma}}_{[t]}^{1\rightarrow C}}}\right)^{\top}\right)}_{\text{intra chunk}}\underbrace{\left(\mathbf{U}_{[t]}-\mathbf{W}_{[t]}\mathbf{S}_{[t]}\right)}_{\text{``pseudo''-value term}}\in\mathbb{R}^{C\times d_{v}}</annotation></semantics></math></td>
