<span id="S6.T6.2.1.1.1.5.2" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m17" class="ltx_Math" alttext="\sum\limits_{j=1}^{t}\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\right)}\bm{k}_{j}\right)\bm{v}_{j}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mo lspace="0em">(</mo><mrow><msubsup><mi>𝒒</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">α</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">s</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{j=1}^{t}\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\right)}\bm{k}_{j}\right)\bm{v}_{j}</annotation></semantics></math></span>
<span id="S6.T6.2.1.1.1.5.3" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m18" class="ltx_Math" alttext="\left(\mathbf{QK^{\top}}\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#B92622;" class="ltx_font_mathcaligraphic" mathcolor="#B92622">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\left(\mathbf{QK^{\top}}\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\mathbf{V}</annotation></semantics></math></span></span>
