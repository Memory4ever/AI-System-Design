<span id="S7.T7.2.1.1.1.1.1.4.3" class="ltx_td ltx_align_left" style="padding:4pt 18.0pt;">   <math id="S7.T7.m8" class="ltx_Math" alttext="\mathbf{S}_{t}={\color[rgb]{0.7266,0.1484,0.1328}\alpha_{t}}\mathbf{S}_{t-1}+{\beta_{t}}\bm{k}_{t}\bm{v}_{t}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐒</mi><mi>t</mi></msub><mo>=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">α</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐒</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{S}_{t}={\color[rgb]{0.7266,0.1484,0.1328}\alpha_{t}}\mathbf{S}_{t-1}+{\beta_{t}}\bm{k}_{t}\bm{v}_{t}^{\top}</annotation></semantics></math>   </span></span>
