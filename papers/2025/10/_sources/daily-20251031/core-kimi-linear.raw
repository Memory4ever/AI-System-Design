roke="#000000" transform="matrix(1.0 0.0 0.0 1.0 401.01 288.78)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F3.pic1.m13" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#D6ECD9;" fill="#D6ECD9" stroke="#000000" stroke-width="1.2pt"><path d="M 390.81 395.46 L 382.51 395.46 C 380.22 395.46 378.36 393.6 378.36 391.31 L 378.36 383.01 C 378.36 380.72 380.22 378.86 382.51 378.86 L 390.81 378.86 C 393.1 378.86 394.96 380.72 394.96 383.01 L 394.96 391.31 C 394.96 393.6 393.1 395.46 390.81 395.46 Z M 378.36 378.86"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#E3E6F3;" fill="#E3E6F3" stroke="#000000" stroke-width="1.2pt"><path d="M 390.81 373.32 L 382.51 373.32 C 380.22 373.32 378.36 371.46 378.36 369.17 L 378.36 360.87 C 378.36 358.58 380.22 356.72 382.51 356.72 L 390.81 356.72 C 393.1 356.72 394.96 358.58 394.96 360.87 L 394.96 369.17 C 394.96 371.46 393.1 373.32 390.81 373.32 Z M 378.36 356.72"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 400.68 382.32)"><foreignObject style="--ltx-fo-width:6.33em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="87.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.17" class="ltx_text">Shared Expert</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform