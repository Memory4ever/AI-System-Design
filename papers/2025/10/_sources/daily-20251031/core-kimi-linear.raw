<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Derivations for Chunkwise Parallelism of KDA</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.2" class="ltx_p">We first recall the recurrent form of KDA:</p>
<table id="A2.Ex12" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex12X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex12X.m2" class="ltx_Math" alttext="\displaystyle\mathbf{S}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\mathbf{S}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12X.m3" class="ltx_Math" alttext="\displaystyle=\underbrace{\left(\prod_{i=1}^{t}\left(\mathbf{I}-\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{k}_{[t]}^{i\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{i})}\right)}_{:=\mathbf{P}_{[t]}^{r}}\cdot\mathbf{S}_{[t]}^{0}+\underbrace{\sum_{i=1}^{r}\left(\prod_{j=i}^{t}\left(\mathbf{I}-\beta_{[t]}^{j}\bm{k}_{[t]}^{j}\bm{k}_{[t]}^{j\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{j})}\right)\cdot\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{v}_{[t]}^{i\top}}_{:=\mathbf{H}_{[t]}^{r}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><munder accentunder="true"><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow></mrow></msub><mo rspace="0.222em">⋅</mo><mi>𝐒</mi><msub><mrow></mrow><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></msub><msup><mrow></mrow><mn>0</mn></msup><mo>+</mo><munder accentunder="true"><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>t</mi></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>j</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">j</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\left(\prod_{i=1}^{t}\left(\mathbf{I}-\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{k}_{[t]}^{i\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{i})}\right)}_{:=\mathbf{P}_{[t]}^{r}}\cdot\mathbf{S}_{[t]}^{0}+\underbrace{\sum_{i=1}^{r}\left(\prod_{j=i}^{t}\left(\mathbf{I}-\beta_{[t]}^{j}\bm{k}_{[t]}^{j}\bm{k}_{[t]}^{j\top}\right){\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{j})}\right)\cdot\beta_{[t]}^{i}\bm{k}_{[t]}^{i}\bm{v}_{[t]}^{i\top}}_{:=\mathbf{H}_{[t]}^{r}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex12Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex12Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbf{P}_{[t]}^{r}\cdot\mathbf{S}_{[t]}^{r}+\mathbf{H}_{[t]}^{r}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐒</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo>+</mo><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{P}_{[t]}^{r}\cdot\mathbf{S}_{[t]}^{r}+\mathbf{H}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p1.3" class="ltx_p">Our goal is to transform <math id="A2.p1.m1" class="ltx_Math" alttext="\mathbf{P}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{P}_{[t]}^{r}</annotation></semantics></math> and <math id="A2.p1.m2" class="ltx_Math" alttext="\mathbf{H}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{H}_{[t]}^{r}</annotation></semantics></math> into matrix forms suitable for parallel computation.</p>
</div>
<div id="A2.p2" class="ltx_para ltx_noindent">
<p id="A2.p2.1" class="ltx_p">We show that <math id="A2.p2.m1" class="ltx_Math" alttext="\mathbf{P}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{P}_{[t]}^{r}</annotation></semantics></math>, which involves the cumulative product of generalized Householder matrices, can be optimized using the classic WY representation.</p>
</div>
<div id="Thmproposition1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition1.2" class="ltx_text ltx_font_bold">Proposition 1</span></span><span id="Thmproposition1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition1.p1" class="ltx_para ltx_noindent">
<p id="Thmproposition1.p1.1" class="ltx_p"><span id="Thmproposition1.p1.1.1" class="ltx_text ltx_font_italic">The matrix <math id="Thmproposition1.p1.m1" class="ltx_Math" alttext="\mathbf{P}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{P}_{[t]}^{r}</annotation></semantics></math> can be expressed as:</span></p>
<table id="A2.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E16.m1" class="ltx_Math" alttext="\mathbf{P}_{[t]}^{r}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}-\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{i\rightarrow r})}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{P}_{[t]}^{r}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}-\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{i\rightarrow r})}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="Thmproposition1.p1.2" class="ltx_p"><span id="Thmproposition1.p1.2.1" class="ltx_text ltx_font_italic">where the auxiliary vector <math id="Thmproposition1.p1.m2" class="ltx_Math" alttext="\bm{w}_{[t]}^{r}\in\mathbb{R}^{d_{k}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐰</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>k</mi></msub></msup></mrow><annotation encoding="application/x-tex">\bm{w}_{[t]}^{r}\in\mathbb{R}^{d_{k}}</annotation></semantics></math> is computed via the following recurrence relation:</span></p>
<table id="A2.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E17.m1" class="ltx_Math" alttext="\bm{w}_{[t]}^{r}=\beta_{[t]}^{r}\left({\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}\bm{k}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{w}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{w}_{[t]}^{r}=\beta_{[t]}^{r}\left({\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}\bm{k}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{w}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p3" class="ltx_para ltx_noindent">
<p id="A2.p3.1" class="ltx_p"><span id="A2.p3.1.1" class="ltx_text">We proceed with a proof by mathematical induction.</span></p>
</div>
<div id="A2.p4" class="ltx_para">
<p id="A2.p4.1" class="ltx_p"><span id="A2.p4.1.1" class="ltx_text ltx_font_bold">Inductive Step:<span id="A2.p4.1.1.1" class="ltx_text ltx_font_medium"> Assume the proposition holds for <math id="A2.p4.m1" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math>, i.e., <math id="A2.p4.m2" class="ltx_Math" alttext="\mathbf{P}_{[t]}^{r-1}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r-1})}-\sum_{i=1}^{r-1}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{i\rightarrow r-1})}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">−</mo><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">−</mo><mn style="--ltx-fg-color:#B92622;" mathcolor="#B92622">1</mn></mrow></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{P}_{[t]}^{r-1}={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r-1})}-\sum_{i=1}^{r-1}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{i\rightarrow r-1})}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}</annotation></semantics></math>.
We now derive:</span></span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex13.m1" class="ltx_Math" alttext="\displaystyle\mathbf{P}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\mathbf{P}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13.m2" class="ltx_Math" alttext="\displaystyle=\left(\mathbf{I}-\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{k}_{[t]}^{r\top}\right){\color[rgb]{0.7266,0.1484,0.1328}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{r})}}\mathbf{P}_{[t]}^{r-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\mathbf{I}-\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{k}_{[t]}^{r\top}\right){\color[rgb]{0.7266,0.1484,0.1328}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{r})}}\mathbf{P}_{[t]}^{r-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex14.m1" class="ltx_Math" alttext="\displaystyle=\left(\mathbf{I}-\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{k}_{[t]}^{r\top}\right){\color[rgb]{0.7266,0.1484,0.1328}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{r})}}\left({\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r-1})}-\sum_{i=1}^{r-1}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r-1}\right)}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo st