<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}-\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\gamma}_{[t]}^{r})}-\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{w}_{[t]}^{i\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.2" class="ltx_p"><span id="A2.p4.2.1" class="ltx_text">The inductive step holds.
∎</span></p>
</div>
</div>
<div id="A2.p5" class="ltx_para ltx_noindent">
<p id="A2.p5.1" class="ltx_p">Similar to <math id="A2.p5.m1" class="ltx_Math" alttext="\mathbf{P}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐏</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{P}_{[t]}^{r}</annotation></semantics></math>, <math id="A2.p5.m2" class="ltx_Math" alttext="\mathbf{H}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{H}_{[t]}^{r}</annotation></semantics></math> can also be expressed in a parallelizable form.</p>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition2.p1" class="ltx_para ltx_noindent">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">The matrix <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="\mathbf{H}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\mathbf{H}_{[t]}^{r}</annotation></semantics></math> can be expressed as:</span></p>
<table id="A2.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E18.m1" class="ltx_Math" alttext="\mathbf{H}_{[t]}^{r}=\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{u}_{[t]}^{i\top}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{H}_{[t]}^{r}=\sum_{i=1}^{r}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{i}\bm{u}_{[t]}^{i\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="Thmproposition2.p1.2" class="ltx_p"><span id="Thmproposition2.p1.2.1" class="ltx_text ltx_font_italic">where the auxiliary vector <math id="Thmproposition2.p1.m2" class="ltx_Math" alttext="\bm{u}_{[t]}^{r}\in\mathbb{R}^{d_{v}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐮</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>v</mi></msub></msup></mrow><annotation encoding="application/x-tex">\bm{u}_{[t]}^{r}\in\mathbb{R}^{d_{v}}</annotation></semantics></math> is computed via the following recurrence relation:</span></p>
<table id="A2.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E19.m1" class="ltx_Math" alttext="\bm{u}_{[t]}^{r}=\beta_{[t]}^{r}\left(\bm{v}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{u}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo>=</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒗</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>𝒖</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜸</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">i</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">→</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></mrow></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{u}_{[t]}^{r}=\beta_{[t]}^{r}\left(\bm{v}_{[t]}^{r}-\sum_{i=1}^{r-1}\bm{u}_{[t]}^{i}\left(\bm{k}_{[t]}^{i\top}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r}\right)}\bm{k}_{[t]}^{r}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p6" class="ltx_para ltx_noindent">
<p id="A2.p6.1" class="ltx_p"><span id="A2.p6.1.1" class="ltx_text">We again use mathematical induction.</span></p>
</div>
<div id="A2.p7" class="ltx_para">
<p id="A2.p7.1" class="ltx_p"><span id="A2.p7.1.1" class="ltx_text ltx_font_bold">Inductive Step:<span id="A2.p7.1.1.1" class="ltx_text ltx_font_medium"> Assume the proposition holds for <math id="A2.p7.m1" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math>.</span></span></p>
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\displaystyle\mathbf{H}_{[t]}^{r}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><annotation encoding="application/x-tex">\displaystyle\mathbf{H}_{[t]}^{r}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\left(\mathbf{I}-\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{k}_{[t]}^{r\top}\right){\color[rgb]{0.7266,0.1484,0.1328}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{r})}}\mathbf{H}_{[t]}^{r-1}+\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{v}_{[t]}^{r\top}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒗</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\mathbf{I}-\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{k}_{[t]}^{r\top}\right){\color[rgb]{0.7266,0.1484,0.1328}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{r})}}\mathbf{H}_{[t]}^{r-1}+\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{v}_{[t]}^{r\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle=\left(\mathbf{I}-\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{k}_{[t]}^{r\top}\right){\color[rgb]{0.7266,0.1484,0.1328}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}(\bm{\alpha}_{[t]}^{r})}}\left(\sum_{i=1}^{r-1}{\color[rgb]{0.7266,0.1484,0.1328}\operatorname{Diag}\left(\bm{\gamma}_{[t]}^{i\rightarrow r-1}\right)}\bm{k}_{[t]}^{i}\bm{u}_{[t]}^{i\top}\right)+\beta_{[t]}^{r}\bm{k}_{[t]}^{r}\bm{v}_{[t]}^{r\top}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mi>r</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mrow><mi>r</mi><mo lspace="0.222em">⊤</mo></mrow></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">Diag</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">𝜶</mi><mrow><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">[</mo><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">t</mi><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">]</mo></mrow><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">r</mi></msubsup><mo style="--ltx-fg-color:#B92622;" mathcolor="#B92622" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>