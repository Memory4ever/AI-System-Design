<span id="S6.T6.2.1.1.1.7.2" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m21" class="ltx_Math" alttext="\sum\limits_{j=1}^{t}\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}\left(\mathbf{I}-\bm{k}_{s}\bm{k}_{s}^{\top}\right)\right)}\bm{k}_{j}\right)\bm{v}_{j}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mo lspace="0em">(</mo><mrow><msubsup><mi>𝒒</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mi>𝒌</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>s</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{j=1}^{t}\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}\left(\mathbf{I}-\bm{k}_{s}\bm{k}_{s}^{\top}\right)\right)}\bm{k}_{j}\right)\bm{v}_{j}</annotation></semantics></math></span>
<span id="S6.T6.2.1.1.1.7.3" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m22" class="ltx_Math" alttext="\left(\mathbf{QK^{\top}}\odot\mathbf{M}\right)\left(\mathbf{I}+\mathbf{KK^{\top}}\odot\mathbf{M}^{-}\right)^{-1}\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>+</mo><mrow><msup><mi>𝐊𝐊</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msup><mi>𝐌</mi><mo>−</mo></msup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\left(\mathbf{QK^{\top}}\odot\mathbf{M}\right)\left(\mathbf{I}+\mathbf{KK^{\top}}\odot\mathbf{M}^{-}\right)^{-1}\mathbf{V}</annotation></semantics></math></span></span>
<span id="S6.T6.2.1.1.1.8" class="ltx_tr">
<span id="S6.T6.2.1.1.1.8.1" class="ltx_td ltx_align_right" style="padding:2pt 4.0pt;">FoX <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx58" title="" class="ltx_ref">58</a>]</cite></span>
<span id="S6.T6.2.1.1.1.8.2" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m23" class="ltx_Math" alttext="\sum\limits_{j=1}^{t}\exp\left(\bm{q}_{t}^{\top}\bm{k}_{j}\right){\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\right)}\bm{v}_{j}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒒</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">α</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">s</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{j=1}^{t}\exp\left(\bm{q}_{t}^{\top}\bm{k}_{j}\right){\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\right)}\bm{v}_{j}</annotation></semantics></math></span>
<span id="S6.T6.2.1.1.1.8.3" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m24" class="ltx_Math" alttext="\left(\exp\left(\mathbf{QK^{\top}}\right)\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#B92622;" class="ltx_font_mathcaligraphic" mathcolor="#B92622">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\left(\exp\left(\mathbf{QK^{\top}}\right)\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\mathbf{V}</annotation></semantics></math></span></span>
<span id="S6.T6.2.1.1.1.9" class="ltx_tr">
<span id="S6.T6.2.1.1.1.9.1" class="ltx_td ltx_align_right" style="padding:2pt 4.0pt;">DeltaFormer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx125" title="" class="ltx_ref">125</a>]</cite></span>
<span id="S6.T6.2.1.1.1.9.2" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m25" class="ltx_Math" alttext="\sum\limits_{j=1}^{t}\left(\phi(\bm{q}_{t})^{\top}{\left(\prod\limits_{s=j+1}^{t}\left(\mathbf{I}-\phi\left(\bm{k}_{s}\right)\phi\left(\bm{w}_{s}\right)^{\top}\right)\right)}\phi\left(\bm{k}_{j}\right)\right)\bm{v}_{j}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mo lspace="0em">(</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒒</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>𝒌</mi><mi>s</mi></msub><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msub><mi>𝒘</mi><mi>s</mi></msub><mo>)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝒌</mi><mi>j</mi></msub><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{j=1}^{t}\left(\phi(\bm{q}_{t})^{\top}{\left(\prod\limits_{s=j+1}^{t}\left(\mathbf{I}-\phi\left(\bm{k}_{s}\right)\phi\left(\bm{w}_{s}\right)^{\top}\right)\right)}\phi\left(\bm{k}_{j}\right)\right)\bm{v}_{j}</annotation></semantics></math></span>
<span id="S6.T6.2.1.1.1.9.3" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m26" class="ltx_Math" alttext="\left(\exp\left(\mathbf{QK^{\top}}\right)\odot\mathbf{M}\right)\left(\mathbf{I}+\exp\left(\mathbf{WK^{\top}}\right)\odot\mathbf{M}^{-}\right)^{-1}\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>+</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mi>𝐖𝐊</mi><mo>⊤</mo></msup><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msup><mi>𝐌</mi><mo>−</mo></msup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\left(\exp\left(\mathbf{QK^{\top}}\right)\odot\mathbf{M}\right)\left(\mathbf{I}+\exp\left(\mathbf{WK^{\top}}\right)\odot\mathbf{M}^{-}\right)^{-1}\mathbf{V}</annotation></semantics></math></span></span>
<span id="S6.T6.2.1.1.1.10" class="ltx_tr">
<span id="S6.T6.2.1.1.1.10.1" class="ltx_td ltx_align_right" style="padding:2pt 4.0pt;">PaTH-FoX <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx115" title="" class="ltx_ref">115</a>]</cite></span>
<span id="S6.T6.2.1.1.1.10.2" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m27" class="ltx_Math" alttext="\sum\limits_{j=1}^{t}\exp\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}\left(\mathbf{I}-\bm{w}_{s}\bm{w}_{s}^{\top}\right)\right)}\bm{k}_{j}\right)\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\right)\bm{v}_{j}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝒒</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mi>𝒘</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒘</mi><mi>s</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">α</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">s</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{j=1}^{t}\exp\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}\left(\mathbf{I}-\bm{w}_{s}\bm{w}_{s}^{\top}\right)\right)}\bm{k}_{j}\right)\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\right)\bm{v}_{j}</annotation></semantics></math></span>
<span id="S6.T6.2.1.1.1.10.3" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m28" class="ltx_Math" alttext="\left(\exp\left(\left(\mathbf{QK^{\top}}\odot\mathbf{M}\right)\left(\mathbf{I}+\mathbf{WW^{\top}}\odot\mathbf{M}^{-}\right)^{-1}\right)\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>+</mo><mrow><msup><mi>𝐖𝐖</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><msup><mi>𝐌</mi><mo>−</mo></msup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#B92622;" class="ltx_font_mathcaligraphic" mathcolor="#B92622">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\left(\exp\left(\left(\mathbf{QK^{\top}}\odot\mathbf{M}\right)\left(\mathbf{I}+\mathbf{WW^{\top}}\odot\mathbf{M}^{-}\right)^{-1}\right)\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\mathbf{V}</annotation></semantics></math></span></span>
<span id="S6.T6.2.1.1.1.11" class="ltx_tr">
<span id="S6.T6.2.1.1.1.11.1" class="ltx_td ltx_align_right" style="padding:2pt 4.0pt;">GDN <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx111" title="" class="ltx_ref">111</a>]</cite></span>
<span id="S6.T6.2.1.1.1.11.2" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m29" class="ltx_Math" alttext="\sum\limits_{j=1}^{t}\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\left(\mathbf{I}-\bm{k}_{s}\bm{k}_{s}^{\top}\right)\right)}\bm{k}_{j}\right)\bm{v}_{j}" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><mrow><mrow><mo lspace="0em">(</mo><mrow><msubsup><mi>𝒒</mi><mi>t</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>t</mi></munderover><mrow><msub><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">α</mi><mi style="--ltx-fg-color:#B92622;" mathcolor="#B92622">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>−</mo><mrow><msub><mi>𝒌</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>s</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒗</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{j=1}^{t}\left(\bm{q}_{t}^{\top}{\left(\prod\limits_{s=j+1}^{t}{\color[rgb]{0.7266,0.1484,0.1328}\alpha_{s}}\left(\mathbf{I}-\bm{k}_{s}\bm{k}_{s}^{\top}\right)\right)}\bm{k}_{j}\right)\bm{v}_{j}</annotation></semantics></math></span>
<span id="S6.T6.2.1.1.1.11.3" class="ltx_td ltx_align_left" style="padding:2pt 4.0pt;"><math id="S6.T6.m30" class="ltx_Math" alttext="\left(\mathbf{QK^{\top}}\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\left(\mathbf{I}+\mathbf{KK^{\top}}\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}^{-}\right)^{-1}\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#B92622;" class="ltx_font_mathcaligraphic" mathcolor="#B92622">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝐈</mi><mo>+</mo><mrow><msup><mi>𝐊𝐊</mi><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi style="--ltx-fg-color:#B92622;" class="ltx_font_mathcaligraphic" mathcolor="#B92622">𝒜</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><msup><mi>𝐌</mi><mo>−</mo></msup></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\left(\mathbf{QK^{\top}}\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}\right)\left(\mathbf{I}+\mathbf{KK^{\top}}\odot{\color[rgb]{0.7266,0.1484,0.1328}\mathcal{A}}\odot\mathbf{M}^{-}\right)^{-1}\mathbf{V}</annotation></semantics></math></span></span>
<span id="S6.T6.2.1.1.1.12" class="ltx_tr">
