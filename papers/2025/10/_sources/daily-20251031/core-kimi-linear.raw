an class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F7.sf2.pic1.9" class="ltx_text">Decoding Length</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 451.36 109.77)"><foreignObject style="--ltx-fo-width:5.24em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="72.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F7.sf2.pic1.10" class="ltx_text">TPOT (ms)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M 476.1 235.06 h 113.07 v 56.73 h -113.07 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 480.25 246.36)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 51.19)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.53)"><g style="--ltx-stroke-color:#008B8B;--ltx-fill-color:#008B8B;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#008B8B" stroke="#008B8B" stroke-dasharray="4.0pt,4.0pt" stroke-dashoffset="0.0pt" stroke-width="1.5pt" transform="matrix(1 0 0 -1 0 0) translate(1.04,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path style="fill:none" d="M 11.81 0 L 11.81 2.77 M 11.81 0 L 14.44 0.86 M 11.81 0 L 13.44 -2.24 M 11.81 0 L 10.18 -2.24 M 11.81 0 L 9.18 0.86"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.7 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.69)"><foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="31.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F7.sf2.pic1.11" class="ltx_text">MLA</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 25.6)"><g style="--ltx-stroke-color:#FFA64D;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#FFA64D" stroke-width="1.5pt" transform="matrix(1 0 0 -1 0 0) translate(1.04,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path><path style="fill:none" d="M 11.81 -2.77 L 11.81 2.77 M 9.18 -0.86 L 14.44 0.86 M 10.18 2.24 L 13.44 -2.24 M 13.44 2.24 L 10.18 -2.24 M 14.44 -0.86 L 9.18 0.86"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.7 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.69)"><foreignObject style="--ltx-fo-width:3.38em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="46.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F7.sf2.pic1.12" class="ltx_text">GDN-H</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 42.66)"><g style="--ltx-stroke-color:#6666FF;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#6666FF" stroke-opacity="1.0" stroke-width="1.5pt" transform="matrix(1 0 0 -1 0 0) translate(1.04,0)"><g fill-opacity="1.0"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-fill-color:#6666FF;" fill="#6666FF" fill-opacity="1.0" stroke-dasharray="none" stroke-dashoffset="0.0pt"><path d="M 11.81 2.08 L 13.78 0.64 L 13.03 -1.68 L 10.59 -1.68 L 9.84 0.64 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 25.7 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -3.69)"><foreignObject style="--ltx-fo-width:5.29em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="73.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F7.sf2.pic1.13" class="ltx_text">Kimi Linear</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
</span></div>
