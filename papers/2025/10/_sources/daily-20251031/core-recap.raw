<th id="S5.T1.5.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T1.5.1.1.6.1" class="ltx_text ltx_font_bold">Avg.</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.5.1.2" class="ltx_tr">
<th id="S5.T1.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Prefix-Probing</th>
<td id="S5.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.040<sub id="S5.T1.5.1.2.2.1" class="ltx_sub"><span id="S5.T1.5.1.2.2.1.1" class="ltx_text ltx_font_italic">0.004</span></sub></td>
<td id="S5.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.176<sub id="S5.T1.5.1.2.3.1" class="ltx_sub"><span id="S5.T1.5.1.2.3.1.1" class="ltx_text ltx_font_italic">0.004</span></sub></td>
<td id="S5.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">0.180<sub id="S5.T1.5.1.2.4.1" class="ltx_sub"><span id="S5.T1.5.1.2.4.1.1" class="ltx_text ltx_font_italic">0.011</span></sub></td>
<td id="S5.T1.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.291<sub id="S5.T1.5.1.2.5.1" class="ltx_sub"><span id="S5.T1.5.1.2.5.1.1" class="ltx_text ltx_font_italic">0.039</span></sub></td>
<td id="S5.T1.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.172</td></tr>
