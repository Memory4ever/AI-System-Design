<td id="S5.T1.5.1.3.3" class="ltx_td ltx_align_center">0.362<sub id="S5.T1.5.1.3.3.1" class="ltx_sub"><span id="S5.T1.5.1.3.3.1.1" class="ltx_text ltx_font_italic">0.031</span></sub></td>
<td id="S5.T1.5.1.3.4" class="ltx_td ltx_align_center">0.298<sub id="S5.T1.5.1.3.4.1" class="ltx_sub"><span id="S5.T1.5.1.3.4.1.1" class="ltx_text ltx_font_italic">0.034</span></sub></td>
<td id="S5.T1.5.1.3.5" class="ltx_td ltx_align_center">0.423<sub id="S5.T1.5.1.3.5.1" class="ltx_sub"><span id="S5.T1.5.1.3.5.1.1" class="ltx_text ltx_font_italic">0.042</span></sub></td>
