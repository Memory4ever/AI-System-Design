<tr id="A3.T7.9.7" class="ltx_tr">
<td id="A3.T7.9.7.1" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FCF1F1;" colspan="5"><span id="A3.T7.9.7.1.1" class="ltx_text" style="--ltx-bg-color:#FCF1F1;"><span id="A3.T7.9.7.1.1.1" class="ltx_text ltx_font_bold">LRS3 Dataset</span></span></td></tr>
<tr id="A3.T7.9.8" class="ltx_tr">
<td id="A3.T7.9.8.1" class="ltx_td ltx_align_left">MoME-15/3-LAYER</td>
<td id="A3.T7.9.8.2" class="ltx_td ltx_align_center">1.8</td>
<td id="A3.T7.9.8.3" class="ltx_td ltx_align_center">1.9</td>
