<td id="S4.T1.8.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_t">Llama-AVSR <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite><sup id="S4.T1.8.1.3.1.1" class="ltx_sup">‡</sup></td>
<td id="S4.T1.8.1.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">27.5M</td>
<td id="S4.T1.8.1.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">4.1</td>
<td id="S4.T1.8.1.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">4.5</td>
<td id="S4.T1.8.1.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">5.3</td>
<td id="S4.T1.8.1.3.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">8.1</td>
<td id="S4.T1.8.1.3.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">6.8M</td>
<td id="S4.T1.8.1.3.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">2.4</td>
<td id="S4.T1.8.1.3.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">2.8</td>
<td id="S4.T1.8.1.3.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">3.3</td>
