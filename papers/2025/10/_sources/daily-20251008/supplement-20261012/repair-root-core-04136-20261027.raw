<td id="S4.T1.8.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt"><span id="S4.T1.8.1.1.2.1" class="ltx_text ltx_font_bold">Active</span></td>
<td id="S4.T1.8.1.1.3" class="ltx_td ltx_nopad_l ltx_align_center ltx_border_tt" style="--ltx-bg-color:#EBEBEB;" colspan="4"><span id="S4.T1.8.1.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EBEBEB;">LRS2 Dataset</span></td>
