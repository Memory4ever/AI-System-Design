<tr id="A3.T7.9.6" class="ltx_tr">
<td id="A3.T7.9.6.1" class="ltx_td ltx_align_left"><span id="A3.T7.9.6.1.1" class="ltx_text ltx_font_typewriter">NUW</span></td>
