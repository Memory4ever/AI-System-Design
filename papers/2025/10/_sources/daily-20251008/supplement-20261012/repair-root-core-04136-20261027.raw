<td id="A3.T7.9.4.4" class="ltx_td ltx_align_center">4.0</td>
<td id="A3.T7.9.4.5" class="ltx_td ltx_align_center">4.8</td></tr>
<tr id="A3.T7.9.5" class="ltx_tr">
<td id="A3.T7.9.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A3.T7.9.5.1.1" class="ltx_text ltx_font_typewriter">DR</span></td>
<td id="A3.T7.9.5.2" class="ltx_td ltx_align_center ltx_border_t">2.9</td>
<td id="A3.T7.9.5.3" class="ltx_td ltx_align_center ltx_border_t">2.9</td>
