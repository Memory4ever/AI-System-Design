<td id="A3.T6.8.1.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt" style="--ltx-bg-color:#FCF1F1;" colspan="4"><span id="A3.T6.8.1.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FCF1F1;">LRS3 Dataset</span></td></tr>
