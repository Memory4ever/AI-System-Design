<span id="A1.T7.2.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center"><math id="A1.T7.m7" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math>, <math id="A1.T7.m8" class="ltx_Math" alttext="\beta_{2}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\beta_{2}</annotation></semantics></math> = 0.95, 0.999</span></span>
