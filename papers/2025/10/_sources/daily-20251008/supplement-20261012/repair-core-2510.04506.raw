<td id="S4.T1.2.1.2.6" class="ltx_td ltx_align_center">12</td>
<td id="S4.T1.2.1.2.7" class="ltx_td ltx_align_center">10</td>
<td id="S4.T1.2.1.2.8" class="ltx_td ltx_align_center">1</td>
<td id="S4.T1.2.1.2.9" class="ltx_td ltx_align_center">56</td></tr>
<tr id="S4.T1.2.1.3" class="ltx_tr">
<th id="S4.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="9"><span id="S4.T1.2.1.3.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">Qwen2.5-1.5B-Instruct</span></th></tr>
<tr id="S4.T1.2.1.4" class="ltx_tr">
<th id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Base</th>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_right ltx_border_t">22.15</td>
<td id="S4.T1.2.1.4.3" class="ltx_td ltx_align_right ltx_border_t">29.32</td>
<td id="S4.T1.2.1.4.4" class="ltx_td ltx_align_right ltx_border_t">25.44</td>
<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_right ltx_border_t">36.18</td>
<td id="S4.T1.2.1.4.6" class="ltx_td ltx_align_right ltx_border_t">35.77</td>
<td id="S4.T1.2.1.4.7" class="ltx_td ltx_align_right ltx_border_t">44.11</td>
