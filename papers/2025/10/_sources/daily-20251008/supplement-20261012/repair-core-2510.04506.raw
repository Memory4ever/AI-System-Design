<td id="S4.T1.2.1.6.2" class="ltx_td ltx_align_right">38.95</td>
<td id="S4.T1.2.1.6.3" class="ltx_td ltx_align_right">43.88</td>
<td id="S4.T1.2.1.6.4" class="ltx_td ltx_align_right">36.21</td>
