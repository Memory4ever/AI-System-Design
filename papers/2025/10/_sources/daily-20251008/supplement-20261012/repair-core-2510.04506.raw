<span id="S5.T7.2.1.1.1" class="ltx_inline-block ltx_align_top" style="width:186.8pt;">
<span id="S5.T7.2.1.1.1.1" class="ltx_p"><span id="S5.T7.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Doc Case (Belt and Road Initiative)</span></span>
</span></th>
<th id="S5.T7.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S5.T7.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:186.8pt;">
