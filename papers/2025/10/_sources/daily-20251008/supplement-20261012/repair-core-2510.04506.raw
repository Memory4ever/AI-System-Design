<td id="S4.T1.2.1.1.6" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T1.2.1.1.6.1" class="ltx_text ltx_font_bold">Class.</span></td>
<td id="S4.T1.2.1.1.7" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T1.2.1.1.7.1" class="ltx_text ltx_font_bold">STS</span></td>
<td id="S4.T1.2.1.1.8" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T1.2.1.1.8.1" class="ltx_text ltx_font_bold">Summ.</span></td>
<td id="S4.T1.2.1.1.9" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T1.2.1.1.9.1" class="ltx_text ltx_font_bold">Avg.</span></td></tr>
<tr id="S4.T1.2.1.2" class="ltx_tr">
<th id="S4.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T1.2.1.2.1.1" class="ltx_text ltx_font_bold"># of datasets</span> <math id="S4.T1.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math></th>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_center">15</td>
<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_center">4</td>
<td id="S4.T1.2.1.2.4" class="ltx_td ltx_align_center">11</td>
