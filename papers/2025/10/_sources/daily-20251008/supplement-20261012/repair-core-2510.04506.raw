<td id="S4.T1.2.1.6.6" class="ltx_td ltx_align_right">53.87</td>
<td id="S4.T1.2.1.6.7" class="ltx_td ltx_align_right">56.39</td>
<td id="S4.T1.2.1.6.8" class="ltx_td ltx_align_right">28.43</td>
<td id="S4.T1.2.1.6.9" class="ltx_td ltx_align_right">43.21</td></tr>
