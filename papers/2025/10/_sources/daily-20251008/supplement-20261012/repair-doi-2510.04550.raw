{"data":{"id":"10.48550/arxiv.2510.04550","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04550","prefix":"10.48550","suffix":"arxiv.2510.04550","identifiers":[{"identifier":"2510.04550","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.04550"}],"creators":[{"name":"He, Pengfei","nameType":"Personal","givenName":"Pengfei","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Dai, Zhenwei","nameType":"Personal","givenName":"Zhenwei","familyName":"Dai","affiliation":[],"nameIdentifiers":[]},{"name":"He, Bing","nameType":"Personal","givenName":"Bing","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Hui","nameType":"Personal","givenName":"Hui","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Xianfeng","nameType":"Personal","givenName":"Xianfeng","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Hanqing","nameType":"Personal","givenName":"Hanqing","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Juanhui","nameType":"Personal","givenName":"Juanhui","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Jiayuan","nameType":"Personal","givenName":"Jiayuan","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Mukherjee, Subhabrata","nameType":"Personal","givenName":"Subhabrata","familyName":"Mukherjee","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Suhang","nameType":"Personal","givenName":"Suhang","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Xing, Yue","nameType":"Personal","givenName":"Yue","familyName":"Xing","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jiliang","nameType":"Personal","givenName":"Jiliang","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Dumoulin, Benoit","nameType":"Personal","givenName":"Benoit","familyName":"Dumoulin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TRAJECT-Bench:A Trajectory-Aware Benchmark for Evaluating Agentic Tool Use"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T07:30:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:18:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T09:19:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:31:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language model (LLM)-based agents increasingly rely on tool use to complete real-world tasks. While existing works evaluate the LLMs' tool use capability, they largely focus on the final answers yet overlook the detailed tool usage trajectory, i.e., whether tools are selected, parameterized, and ordered correctly. We introduce TRAJECT-Bench, a trajectory-aware benchmark to comprehensively evaluate LLMs' tool use capability through diverse tasks with fine-grained evaluation metrics. TRAJECT-Bench pairs high-fidelity, executable tools across practical domains with tasks grounded in production-style APIs, and synthesizes trajectories that vary in breadth (parallel calls) and depth (interdependent chains). Besides final accuracy, TRAJECT-Bench also reports trajectory-level diagnostics, including tool selection and argument correctness, and dependency/order satisfaction. Analyses reveal failure modes such as similar tool confusion and parameter-blind selection, and scaling behavior with tool diversity and trajectory length where the bottleneck of transiting from short to mid-length trajectories is revealed, offering actionable guidance for LLMs' tool use.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.04550","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:17:15.000Z","registered":"2025-10-07T03:17:16.000Z","published":"2025","updated":"2025-10-14T04:23:29.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.04550","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}