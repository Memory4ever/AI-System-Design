<li class="ltx_tocentry ltx_tocentry_section"><a href="#S6" title="In FoleyGRAM: Video-to-Audio Generation with GRAM-Aligned Multimodal Encoders" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VI </span><span class="ltx_text ltx_font_smallcaps">Conclusion</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S7" title="In FoleyGRAM: Video-to-Audio Generation with GRAM-Aligned Multimodal Encoders" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VII </span><span class="ltx_text ltx_font_smallcaps">Acknowledgements</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In FoleyGRAM: Video-to-Audio Generation with GRAM-Aligned Multimodal Encoders" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
</ol></nav>
