<td id="S2.T1.3.1.5.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">S-VideoXum <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite></td></tr>
<tr id="S2.T1.3.1.5.1.1.2" class="ltx_tr">
<td id="S2.T1.3.1.5.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S2.T1.3.1.5.1.1.2.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">(ACM MM’25)</span></td></tr>
</table></td>
<td id="S2.T1.3.1.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">open domain</td>
<td id="S2.T1.3.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">11,908</td>
<td id="S2.T1.3.1.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">
