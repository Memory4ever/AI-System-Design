<td id="S4.T2.3.1.8.2" class="ltx_td ltx_align_center ltx_border_b">X</td>
<td id="S4.T2.3.1.8.3" class="ltx_td ltx_align_center ltx_border_b">✓</td>
<td id="S4.T2.3.1.8.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">X</td>
<td id="S4.T2.3.1.8.5" class="ltx_td ltx_align_center ltx_border_b">22.0</td>
<td id="S4.T2.3.1.8.6" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T2.3.1.8.6.1" class="ltx_text ltx_ulem_uline">0</span>.153</td>
<td id="S4.T2.3.1.8.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S4.T2.3.1.8.7.1" class="ltx_text ltx_ulem_uline">0</span>.203</td>
<td id="S4.T2.3.1.8.8" class="ltx_td ltx_align_center ltx_border_b">55.7</td>
