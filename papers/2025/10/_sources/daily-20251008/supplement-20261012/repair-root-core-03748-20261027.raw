<th id="S5.T1.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_l ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;"><span id="S5.T1.2.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="S5.T1.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;"><span id="S5.T1.2.1.2.1" class="ltx_text ltx_font_bold">Random Examples</span></th>
<th id="S5.T1.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;"><span id="S5.T1.2.1.3.1" class="ltx_text ltx_font_bold">n-neighboor</span></th>
<th id="S5.T1.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;"><span id="S5.T1.2.1.4.1" class="ltx_text ltx_font_bold">K-NN</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.2.2" class="ltx_tr">
<th id="S5.T1.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;">GPT-4o</th>
