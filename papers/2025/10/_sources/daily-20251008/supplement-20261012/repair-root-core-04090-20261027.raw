<td id="S4.T4.2.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">96</td></tr>
<tr id="S4.T4.2.3" class="ltx_tr">
<td id="S4.T4.2.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">2</td>
<td id="S4.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">CEembs</td>
<td id="S4.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">3</td>
