<th id="S6.T9.4.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><em id="S6.T9.4.1.6.1" class="ltx_emph ltx_font_italic">n<sub id="S6.T9.4.1.6.1.1" class="ltx_sub">param</sub></em></th>
<th id="S6.T9.4.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">Emb size</th>
<th id="S6.T9.4.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">Out size</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T9.4.2" class="ltx_tr">
<td id="S6.T9.4.2.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">1</td>
