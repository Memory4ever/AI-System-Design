<td id="S6.T9.4.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">22m</td>
<td id="S6.T9.4.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">[<em id="S6.T9.4.2.7.1" class="ltx_emph ltx_font_italic">b<sub id="S6.T9.4.2.7.1.1" class="ltx_sub">s</sub></em>, 384]</td>
<td id="S6.T9.4.2.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">[<em id="S6.T9.4.2.8.1" class="ltx_emph ltx_font_italic">b<sub id="S6.T9.4.2.8.1.1" class="ltx_sub">s</sub></em>, 384]</td></tr>
<tr id="S6.T9.4.3" class="ltx_tr">
<td id="S6.T9.4.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">2</td>
<td id="S6.T9.4.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">LSC</td>
<td id="S6.T9.4.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">ViT-S</td>
<td id="S6.T9.4.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">cos</td>
