<td id="S5.T5.4.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">9</td>
<td id="S5.T5.4.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">84</td>
<td id="S5.T5.4.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">dist (<a href="#S3.E6" title="In 3.3 Metric choice, loss and label functions ‣ 3 Latent space configuration methodology ‣ Using predefined vector systems as latent space configuration for neural network supervised training on data with arbitrarily large number of classes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)</td>
<td id="S5.T5.4.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">86.7</td></tr>
<tr id="S5.T5.4.3" class="ltx_tr">
<td id="S5.T5.4.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">2</td>
