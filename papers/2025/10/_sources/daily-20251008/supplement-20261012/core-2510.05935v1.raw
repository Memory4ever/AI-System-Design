<div id="S3.F8.3.1" class="ltx_logical-block ltx_minipage ltx_align_center ltx_align_top" style="width:327.8pt;">
            
<figure id="S3.F8.sf7" class="ltx_figure"><object type="image/svg+xml" data="2510.05935v1/best_method_per_model_auroc_n5.svg" id="S3.F8.sf7.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:452/377;" width="452" height="377"></object>
