</figure>
            
<figure id="S3.F8.sf9" class="ltx_figure"><object type="image/svg+xml" data="2510.05935v1/best_method_per_model_auroc_n20.svg" id="S3.F8.sf9.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:452/377;" width="452" height="377"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">((i)) </span><math id="S3.F8.sf9.m2" class="ltx_Math" alttext="n=20" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">n=20</annotation></semantics></math></figcaption>
</figure>
            
<figure id="S3.F8.sf10" class="ltx_figure"><object type="image/svg+xml" data="2510.05935v1/best_method_per_model_auroc_n30.svg" id="S3.F8.sf10.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:452/377;" width="452" height="377"></object>
