<div id="S3.F8.p2.1" class="ltx_inline-block ltx_minipage ltx_align_center ltx_align_middle ltx_transformed_outer" style="width:13.8pt;height:25.5pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:25.5pt;transform:translate(-9.3pt,-9.3pt) rotate(-90deg) ;">
