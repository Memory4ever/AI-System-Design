<th id="S2.T2.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T2.5.1.1.2.1" class="ltx_text ltx_font_bold">ONNX (ML Models)</span></th>
<th id="S2.T2.5.1.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T2.5.1.1.3.1" class="ltx_text ltx_font_bold">Agent Spec (AI Agents)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T2.5.1.2" class="ltx_tr">
<th id="S2.T2.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">Scope</th>
<td id="S2.T2.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">
<table id="S2.T2.5.1.2.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S2.T2.5.1.2.2.1.1" class="ltx_tr">
<td id="S2.T2.5.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Unified representation of</td></tr>
<tr id="S2.T2.5.1.2.2.1.2" class="ltx_tr">
<td id="S2.T2.5.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">ML models, allowing portability</td></tr>
<tr id="S2.T2.5.1.2.2.1.3" class="ltx_tr">
<td id="S2.T2.5.1.2.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center">across different deep learning</td></tr>
<tr id="S2.T2.5.1.2.2.1.4" class="ltx_tr">
<td id="S2.T2.5.1.2.2.1.4.1" class="ltx_td ltx_nopad_r ltx_align_center">frameworks.</td></tr>
</table></td>
<td id="S2.T2.5.1.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">
<table id="S2.T2.5.1.2.3.1" class="ltx_tabular ltx_align_middle">
<tr id="S2.T2.5.1.2.3.1.1" class="ltx_tr">
<td id="S2.T2.5.1.2.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Unified representation of AI agents</td></tr>
<tr id="S2.T2.5.1.2.3.1.2" class="ltx_tr">
<td id="S2.T2.5.1.2.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">and workflows, enabling them to</td></tr>
<tr id="S2.T2.5.1.2.3.1.3" class="ltx_tr">
<td id="S2.T2.5.1.2.3.1.3.1" class="ltx_td ltx_nopad_r ltx_align_center">run across diverse agentic frameworks.</td></tr>
</table></td></tr>
<tr id="S2.T2.5.1.3" class="ltx_tr">
<th id="S2.T2.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">Portability</th>
<td id="S2.T2.5.1.3.2" class="ltx_td ltx_align_center ltx_border_t">
<table id="S2.T2.5.1.3.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S2.T2.5.1.3.2.1.1" class="ltx_tr">
<td id="S2.T2.5.1.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">ONNX allows ML models to be</td></tr>
<tr id="S2.T2.5.1.3.2.1.2" class="ltx_tr">
<td id="S2.T2.5.1.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">trained in one framework (e.g.,</td></tr>
