<th id="S1.T1.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S1.T1.5.1.1.2.1" class="ltx_text ltx_font_bold">Objective</span></th>
<th id="S1.T1.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S1.T1.5.1.1.3.1" class="ltx_text ltx_font_bold">Open Agent Specification</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S1.T1.5.1.2" class="ltx_tr">
<th id="S1.T1.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">Agents</th>
<td id="S1.T1.5.1.2.2" class="ltx_td ltx_align_left ltx_border_t">
