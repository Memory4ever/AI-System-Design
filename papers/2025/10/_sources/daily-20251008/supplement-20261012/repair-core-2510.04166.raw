<td id="S4.T6.8.1.39.10" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#CCCCCC;"><span id="S4.T6.8.1.39.10.1" class="ltx_text ltx_font_bold" style="font-size:50%;--ltx-bg-color:#CCCCCC;">97.04</span></td>
