<span id="S2.T1.4.4.2.1.1" class="ltx_p ltx_align_left"><span id="S2.T1.4.4.2.1.1.1" class="ltx_text" style="font-size:90%;">Stage-to-stage per microbatch</span></span>
</span></td>
<td id="S2.T1.4.4.3" class="ltx_td ltx_align_left" style="padding-bottom: 2.77501pt;padding-left:10.0pt;padding-right:10.0pt;">
<span id="S2.T1.4.4.3.1" class="ltx_inline-block ltx_align_top">
<span id="S2.T1.4.4.3.1.1" class="ltx_p ltx_align_left"><span id="S2.T1.4.4.3.1.1.1" class="ltx_text" style="font-size:90%;">Bubble overhead from slowest stage</span></span>
</span></td>
<td id="S2.T1.4.4.4" class="ltx_td ltx_align_left" style="padding-bottom: 2.77501pt;padding-left:10.0pt;padding-right:10.0pt;">
