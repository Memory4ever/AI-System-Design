<th id="S5.T8.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.5pt;padding-right:8.5pt;">gIoU</th>
<th id="S5.T8.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.5pt;padding-right:8.5pt;">cIoU</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T8.2.1.2" class="ltx_tr">
<th id="S5.T8.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:8.5pt;padding-right:8.5pt;">1</th>
<td id="S5.T8.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.5pt;padding-right:8.5pt;">✓</td>
