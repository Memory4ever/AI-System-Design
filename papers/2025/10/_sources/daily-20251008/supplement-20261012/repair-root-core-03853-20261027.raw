<td id="S5.T8.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.5pt;padding-right:8.5pt;">69.53</td></tr>
<tr id="S5.T8.2.1.3" class="ltx_tr">
<th id="S5.T8.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:8.5pt;padding-right:8.5pt;">2</th>
<td id="S5.T8.2.1.3.2" class="ltx_td" style="padding-left:8.5pt;padding-right:8.5pt;"></td>
