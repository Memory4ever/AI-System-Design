<th id="S5.T8.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:8.5pt;padding-right:8.5pt;">3</th>
<td id="S5.T8.2.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.5pt;padding-right:8.5pt;">✓</td>
<td id="S5.T8.2.1.4.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:8.5pt;padding-right:8.5pt;">✓</td>
<td id="S5.T8.2.1.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.5pt;padding-right:8.5pt;"><span id="S5.T8.2.1.4.4.1" class="ltx_text ltx_font_bold">66.13</span></td>
<td id="S5.T8.2.1.4.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.5pt;padding-right:8.5pt;"><span id="S5.T8.2.1.4.5.1" class="ltx_text ltx_font_bold">72.07</span></td></tr>
