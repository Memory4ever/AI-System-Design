<tbody id="A5.E99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E99.m1" class="ltx_Math" alttext="\displaystyle\hat{q}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>q</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{q}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E99.m2" class="ltx_Math" alttext="\displaystyle=\gamma\frac{1}{1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>χ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>¯</mo></mover></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\frac{1}{1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(99)</span></td></tr></tbody>
<tbody id="A5.E100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E100.m1" class="ltx_Math" alttext="\displaystyle\hat{\bar{q}}" display="inline" intent=":literal"><semantics><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{\bar{q}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E100.m2" class="ltx_Math" alttext="\displaystyle=\gamma\frac{\frac{1}{\alpha}\ab(1+\sigma^{2})}{1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mi>χ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>¯</mo></mover></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\frac{\frac{1}{\alpha}\ab(1+\sigma^{2})}{1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(100)</span></td></tr></tbody>
<tbody id="A5.E101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E101.m1" class="ltx_Math" alttext="\displaystyle\hat{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E101.m2" class="ltx_Math" alttext="\displaystyle=\gamma\frac{1}{1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>χ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>¯</mo></mover></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\frac{1}{1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(101)</span></td></tr></tbody>
<tbody id="A5.E102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E102.m1" class="ltx_Math" alttext="\displaystyle\hat{\chi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>χ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{\chi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E102.m2" class="ltx_Math" alttext="\displaystyle=\gamma\frac{\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{q}+q-2m+1+\sigma^{2}}{\ab(1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi})^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover></mrow><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo>+</mo><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>χ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>¯</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\frac{\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{q}+q-2m+1+\sigma^{2}}{\ab(1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi})^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(102)</span></td></tr></tbody>
<tbody id="A5.E103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E103.m1" class="ltx_Math" alttext="\displaystyle\hat{\bar{\chi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{\bar{\chi}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E103.m2" class="ltx_Math" alttext="\displaystyle=\gamma\frac{1}{\alpha}\ab(1+\sigma^{2})\frac{\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{q}+q-2m+1+\sigma^{2}}{\ab(1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi})^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover></mrow><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo>+</mo><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>χ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>¯</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\frac{1}{\alpha}\ab(1+\sigma^{2})\frac{\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{q}+q-2m+1+\sigma^{2}}{\ab(1+\chi+\frac{1}{\alpha}\ab(1+\sigma^{2})\bar{\chi})^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(103)</span></td></tr></tbody>
</table>
<p id="A5.Thmtheorem2.p1.3" class="ltx_p"><span id="A5.Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">Here, we define <math id="A5.Thmtheorem2.p1.m5" class="ltx_Math" alttext="z=-\frac{\hat{\bar{q}}+\lambda}{\hat{q}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover><mo>+</mo><mi>λ</mi></mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover></mfrac></mrow></mrow><annotation encoding="application/x-tex">z=-\frac{\hat{\bar{q}}+\lambda}{\hat{q}}</annotation></semantics></math> and the resolvents <math id="A5.Thmtheorem2.p1.m6" class="ltx_Math" alttext="g_{S}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{S}(z)</annotation></semantics></math> and <math id="A5.Thmtheorem2.p1.m7" class="ltx_Math" alttext="g_{\tilde{S}}(z)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mover accent="true"><mi>S</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{\tilde{S}}(z)</annotation></semantics></math> are defined in Lemma <a href="#A4.Thmtheorem1" title="Lemma D.1. ‣ D.1 Resolvent Functions for Wishart-Type Matrices ‣ Appendix D Preliminary Lemmas in Random Matrix Theory" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a>.</span></p>
</div>
</div>
<div id="A5.Thmtheorem3" class="ltx_theorem ltx_theorem_result">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem3.2" class="ltx_text ltx_font_bold">Result E.3</span></span><span id="A5.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem3.p1" class="ltx_para">
<p id="A5.Thmtheorem3.p1.1" class="ltx_p"><span id="A5.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">(Complete Statement of Generalization Error)
There exist non-negative scalar constants <math id="A5.Thmtheorem3.p1.m1" class="ltx_Math" alttext="q,m,q_{0},m_{0},\bar{q},\bar{m}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>,</mo><mi>m</mi><mo>,</mo><msub><mi>q</mi><mn>0</mn></msub><mo>,</mo><msub><mi>m</mi><mn>0</mn></msub><mo>,</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>,</mo><mover accent="true"><mi>m</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">q,m,q_{0},m_{0},\bar{q},\bar{m}</annotation></semantics></math> such that the generalization error of the optimal parameter matrix <math id="A5.Thmtheorem3.p1.m2" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math> is given by:</span></p>
<table id="A5.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E104.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{TM}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>TM</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{TM}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E104.m2" class="ltx_Math" alttext="\displaystyle=1-2m+q+\frac{\bar{q}}{\tilde{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo>+</mo><mi>q</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mover accent="true"><mi>α</mi><mo>~</mo></mover></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-2m+q+\frac{\bar{q}}{\tilde{\alpha}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(104)</span></td></tr></tbody>
<tbody id="A5.E105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E105.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{IDG}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>IDG</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{IDG}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E105.m2" class="ltx_Math" alttext="\displaystyle=1-2{m}_{0}+{q}_{0}+\frac{\bar{q}}{\tilde{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow></mrow><mo>+</mo><msub><mi>q</mi><mn>0</mn></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mover accent="true"><mi>α</mi><mo>~</mo></mover></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1-2{m}_{0}+{q}_{0}+\frac{\bar{q}}{\tilde{\alpha}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
<tbody id="A5.E106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E106.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{ODG}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>ODG</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{ODG}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E106.m2" class="ltx_Math" alttext="\displaystyle=1-2{\bar{m}}+{\bar{q}}+\frac{\bar{q}}{\tilde{\alpha}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>m</mi><mo>¯</mo></mover></mrow></mrow><mo>+</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>+</mo><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mover accent="true"><mi>α</mi><mo>~</mo></mover></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1-2{\bar{m}}+{\bar{q}}+\frac{\bar{q}}{\tilde{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(106)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Proposition E.4</span></span><span id="A5.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem4.p1" class="ltx_para">
<p id="A5.Thmtheorem4.p1.1" class="ltx_p"><span id="A5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Under the condition that <math id="A5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\kappa\gamma&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\kappa\gamma&gt;1</annotation></semantics></math>, the order parameters in <math id="A5.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\alpha\gg 1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≫</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha\gg 1</annotation></semantics></math> are given by:</span></p>
<table id="A5.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E107.m1" class="ltx_Math" alttext="\displaystyle m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">\displaystyle m</annotation></semantics></math></td>
