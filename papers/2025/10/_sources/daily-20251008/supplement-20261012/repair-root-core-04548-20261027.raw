<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E114.m1" class="ltx_Math" alttext="\displaystyle\hat{\chi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>χ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{\chi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E114.m2" class="ltx_Math" alttext="\displaystyle=\ab(\gamma-\frac{1}{\kappa})\ab(\sigma^{2}+\min\ab(\kappa,\rho)\frac{1+\sigma^{2}}{\alpha})+\mathcal{O}\ab(\frac{1}{\alpha^{2}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>κ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>α</mi></mfrac></mstyle></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>α</mi><mn>2</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ab(\gamma-\frac{1}{\kappa})\ab(\sigma^{2}+\min\ab(\kappa,\rho)\frac{1+\sigma^{2}}{\alpha})+\mathcal{O}\ab(\frac{1}{\alpha^{2}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="3"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
<tbody id="A5.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E115.m1" class="ltx_Math" alttext="\displaystyle\bar{\chi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\displaystyle\bar{\chi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E115.m2" class="ltx_Math" alttext="\displaystyle=\frac{1-\min\ab(\kappa,\rho)}{\kappa\gamma-1}\frac{1}{1+\sigma^{2}}\alpha+\mathcal{O}\ab(1)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-\min\ab(\kappa,\rho)}{\kappa\gamma-1}\frac{1}{1+\sigma^{2}}\alpha+\mathcal{O}\ab(1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="3"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
<tbody id="A5.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E116.m1" class="ltx_Math" alttext="\displaystyle\hat{\bar{\chi}}" display="inline" intent=":literal"><semantics><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{\bar{\chi}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E116.m2" class="ltx_Math" alttext="\displaystyle=\frac{1+\sigma^{2}}{\alpha}\ab(\gamma-\frac{1}{\kappa})\ab(\sigma^{2}+\min\ab(\kappa,\rho)\frac{1+\sigma^{2}}{\alpha})+\mathcal{O}\ab(\frac{1}{\alpha^{3}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>κ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>α</mi></mfrac></mstyle></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>α</mi><mn>3</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1+\sigma^{2}}{\alpha}\ab(\gamma-\frac{1}{\kappa})\ab(\sigma^{2}+\min\ab(\kappa,\rho)\frac{1+\sigma^{2}}{\alpha})+\mathcal{O}\ab(\frac{1}{\alpha^{3}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="3"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.p2" class="ltx_para ltx_noindent">
<p id="A5.SS1.p2.1" class="ltx_p">The key findings in the main paper (Results <a href="#S3.Thmtheorem1" title="Result 3.1 (Decomposition of ICL prediction). ‣ 3 Decomposition of ICL Prediction" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, <a href="#S3.Thmtheorem2" title="Result 3.2 (Asymptotic Characterization of the Components). ‣ 3 Decomposition of ICL Prediction" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, <a href="#S4.Thmtheorem1" title="Result 4.1 (Effective Objective Function). ‣ 4.2 Theoretical Explanation ‣ 4 Finite Pre-training Data Induces Implicit Regularization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, and <a href="#S4.Thmtheorem2" title="Result 4.2 (Asymptotics of Regularization). ‣ 4.2 Theoretical Explanation ‣ 4 Finite Pre-training Data Induces Implicit Regularization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>) are recovered from Result <a href="#A5.Thmtheorem1" title="Result E.1. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a> and Proposition <a href="#A5.Thmtheorem4" title="Proposition E.4. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.4</span></a>. Similarly, Result <a href="#S5.Thmtheorem2" title="Result 5.2. ‣ 5.2 Phase Transition in ICL Capabilities ‣ 5 Trade-offs from Task Difficulty" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> is recovered from Result <a href="#A5.Thmtheorem3" title="Result E.3. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.3</span></a> and Proposition <a href="#A5.Thmtheorem4" title="Proposition E.4. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.4</span></a>. In the following, we provide the detailed replica calculations to sequentially derive these foundational results: Results <a href="#A5.Thmtheorem1" title="Result E.1. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>, <a href="#A5.Thmtheorem2" title="Result E.2. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>, <a href="#A5.Thmtheorem3" title="Result E.3. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.3</span></a>, and Proposition <a href="#A5.Thmtheorem4" title="Proposition E.4. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.4</span></a>.</p>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Replica System and Replicated Partition Function</h3>

<div id="A5.SS2.p1" class="ltx_para ltx_noindent">
<p id="A5.SS2.p1.1" class="ltx_p">In this subsection, we outline the replica formalism for evaluating the moments of the solution <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>, which forms the basis for the statistical characterization of the estimator in the high-dimensional limit.
To derive Result <a href="#A5.Thmtheorem1" title="Result E.1. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>, we first rely on two fundamental assumptions. The first assumption addresses the well-posedness of the statistical problem itself.</p>
</div>
<div id="A5.Thmtheorem5" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem5.2" class="ltx_text ltx_font_bold">Assumption E.5</span></span><span id="A5.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Identifiability from Moments of a Scalar Statistic)<span id="A5.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem5.p1" class="ltx_para ltx_noindent">
<p id="A5.Thmtheorem5.p1.1" class="ltx_p"><span id="A5.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A5.Thmtheorem5.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a random matrix taking values in <math id="A5.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\mathbb{R}^{D\times D}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{D\times D}</annotation></semantics></math>, and let <math id="A5.Thmtheorem5.p1.m3" class="ltx_Math" alttext="g:\mathbb{R}^{D\times D}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">g:\mathbb{R}^{D\times D}\to\mathbb{R}</annotation></semantics></math> be an arbitrary measurable function.
We assume that the probability law of <math id="A5.Thmtheorem5.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is uniquely determined by the sequence of moments of the scalar statistic <math id="A5.Thmtheorem5.p1.m5" class="ltx_Math" alttext="g(X)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(X)</annotation></semantics></math>.
More formally, for any two random matrices <math id="A5.Thmtheorem5.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A5.Thmtheorem5.p1.m7" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math>, the condition</span></p>
<table id="A5.E117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E117.m1" class="ltx_Math" alttext="\mathbb{E}[(g(X))^{n}]=\mathbb{E}[(g(X^{\prime}))^{n}]\quad\text{for all }n\in\mathbb{N}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>∈</mo><mi>ℕ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[(g(X))^{n}]=\mathbb{E}[(g(X^{\prime}))^{n}]\quad\text{for all }n\in\mathbb{N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
</table>
<p id="A5.Thmtheorem5.p1.2" class="ltx_p"><span id="A5.Thmtheorem5.p1.2.1" class="ltx_text ltx_font_italic">implies that <math id="A5.Thmtheorem5.p1.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A5.Thmtheorem5.p1.m9" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> are identically distributed.</span></p>
</div>
</div>
<div id="A5.SS2.p2" class="ltx_para ltx_noindent">
<p id="A5.SS2.p2.1" class="ltx_p">This is a technical assumption, positing that the random variable <math id="A5.SS2.p2.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> does not exhibit pathological behavior (such as that of a log-normal distribution) where its moments fail to uniquely define its distribution. Assuming that <math id="A5.SS2.p2.m2" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math> satisfies this property for a fixed task set <math id="A5.SS2.p2.m3" class="ltx_Math" alttext="\mathcal{W}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{W}_{0}</annotation></semantics></math>,
our goal is to compute its integer moments, <math id="A5.SS2.p2.m4" class="ltx_Math" alttext="\mathbb{E}[g\ab(W^{*})^{p}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[g\ab(W^{*})^{p}]</annotation></semantics></math> for <math id="A5.SS2.p2.m5" class="ltx_Math" alttext="p\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">p\in\mathbb{N}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS2.p3" class="ltx_para ltx_noindent">
<p id="A5.SS2.p3.1" class="ltx_p">Our starting point is to re-interpret the solution of the optimization problem, <math id="A5.SS2.p3.m1" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>, from a statistical mechanics perspective. For a fixed set of training instances <math id="A5.SS2.p3.m2" class="ltx_Math" alttext="\mathcal{D}=\{H^{\mu}\mid 1\leq\mu\leq M\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mi>H</mi><mi>μ</mi></msup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mn>1</mn><mo>≤</mo><mi>μ</mi><mo>≤</mo><mi>M</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{H^{\mu}\mid 1\leq\mu\leq M\}</annotation></semantics></math>, we treat <math id="A5.SS2.p3.m3" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math> as a random variable drawn from a Gibbs-Boltzmann distribution, where the loss function <math id="A5.SS2.p3.m4" class="ltx_Math" alttext="\mathcal{L}(W)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(W)</annotation></semantics></math> acts as the energy function. In the zero-temperature limit (<math id="A5.SS2.p3.m5" class="ltx_Math" alttext="\beta\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\beta\to\infty</annotation></semantics></math>), this distribution concentrates on the global minimum of the loss:</p>
<table id="A5.E118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E118.m1" class="ltx_Math" alttext="W^{*}=\argmin_{W}\mathcal{L}(W)\sim p(W\mid\mathcal{D})=\lim_{\beta\to\infty}\frac{\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D}))}{\int\mathop{}\!\mathrm{d}W\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D}))}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>W</mi><mo>∗</mo></msup><mo rspace="0.1389em">=</mo><mrow><mrow><msub><mo lspace="0.1389em" rspace="0.167em">argmin</mo><mi>W</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo>∫</mo><mphantom></mphantom></mrow><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W^{*}=\argmin_{W}\mathcal{L}(W)\sim p(W\mid\mathcal{D})=\lim_{\beta\to\infty}\frac{\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D}))}{\int\mathop{}\!\mathrm{d}W\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D}))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p3.2" class="ltx_p">Here, <math id="A5.SS2.p3.m6" class="ltx_Math" alttext="\mathcal{L}(W\mid\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(W\mid\mathcal{D})</annotation></semantics></math> is the loss function for the model <math id="A5.SS2.p3.m7" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> on the fixed learning instances <math id="A5.SS2.p3.m8" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>, and <math id="A5.SS2.p3.m9" class="ltx_Math" alttext="\mathop{}\!\mathrm{d}W=\prod_{ij}\mathop{}\!\mathrm{d}W_{ij}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∏</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathop{}\!\mathrm{d}W=\prod_{ij}\mathop{}\!\mathrm{d}W_{ij}</annotation></semantics></math>. The normalization factor of Eq. (<a href="#A5.E118" title="In E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">118</span></a>) is the <span id="A5.SS2.p3.2.1" class="ltx_text ltx_font_bold">partition function</span> <math id="A5.SS2.p3.m10" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> of the system:</p>
<table id="A5.E119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E119.m1" class="ltx_Math" alttext="Z=\int\mathop{}\!\mathrm{d}W\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D}))." display="block" intent=":literal"><semantics><mrow><mrow><mi>Z</mi><mo rspace="0.111em">=</mo><mrow><mrow><mo>∫</mo><mphantom></mphantom></mrow><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z=\int\mathop{}\!\mathrm{d}W\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p3.3" class="ltx_p">Using this notation, the <math id="A5.SS2.p3.m11" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-th moment of <math id="A5.SS2.p3.m12" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>, averaged over the training data, is expressed as:</p>
<table id="A5.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E120.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathcal{D}}[g\ab(W^{*})^{p}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathcal{D}}[g\ab(W^{*})^{p}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E120.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\ab(\frac{1}{Z}\int\mathop{}\!\mathrm{d}W\,g(W)\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})))^{p}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>Z</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mstyle></mrow><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\ab(\frac{1}{Z}\int\mathop{}\!\mathrm{d}W\,g(W)\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})))^{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(120)</span></td></tr></tbody>
<tbody id="A5.E121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E121.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\lim_{n\to 0}Z^{n-p}\ab(\int\mathop{}\!\mathrm{d}W\,g(W)\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})))^{p}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.0835em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><munder><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><msup><mi>Z</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mphantom></mphantom></mrow></mstyle><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\lim_{n\to 0}Z^{n-p}\ab(\int\mathop{}\!\mathrm{d}W\,g(W)\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})))^{p}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(121)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p3.4" class="ltx_p">However, the expression in Eq. (<a href="#A5.E121" title="In E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">121</span></a>) is difficult to average over the data distribution <math id="A5.SS2.p3.m13" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> because the data-dependent partition function <math id="A5.SS2.p3.m14" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> appears in the denominator.</p>
</div>
<div id="A5.SS2.p4" class="ltx_para ltx_noindent">
<p id="A5.SS2.p4.1" class="ltx_p">To circumvent this difficulty, we employ the replica trick. The key insight is to represent the problematic term <math id="A5.SS2.p4.m1" class="ltx_Math" alttext="Z^{n^{\prime}-p}" display="inline" intent=":literal"><semantics><msup><mi>Z</mi><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></msup><annotation encoding="application/x-tex">Z^{n^{\prime}-p}</annotation></semantics></math> as an integral over <math id="A5.SS2.p4.m2" class="ltx_Math" alttext="n^{\prime}-p" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n^{\prime}-p</annotation></semantics></math> independent copies (or ‘replicas’) of the system, which is valid for any integer <math id="A5.SS2.p4.m3" class="ltx_Math" alttext="n^{\prime}&gt;p" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>&gt;</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n^{\prime}&gt;p</annotation></semantics></math>:</p>
<table id="A5.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E122.m1" class="ltx_math_unparsed" alttext="\displaystyle Z^{n^{\prime}-p}=\int\mathop{}\!\mathrm{d}W_{n^{\prime}-p}\,\exp\ab(-\beta\sum_{a=1}^{n^{\prime}-p}\mathcal{L}(W^{a}\mid\mathcal{D}))." display="inline" intent=":literal"><semantics><mrow><msup><mi>Z</mi><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></msup><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></munderover></mstyle><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Z^{n^{\prime}-p}=\int\mathop{}\!\mathrm{d}W_{n^{\prime}-p}\,\exp\ab(-\beta\sum_{a=1}^{n^{\prime}-p}\mathcal{L}(W^{a}\mid\mathcal{D})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(122)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p4.2" class="ltx_p">Here, <math id="A5.SS2.p4.m4" class="ltx_math_unparsed" alttext="\mathop{}\!\mathrm{d}W_{s}=\mathop{}\!\mathrm{d}{W^{1}}\mathop{}\!\mathrm{d}{W^{2}}\cdots\mathop{}\!\mathrm{d}{W^{s}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mi>d</mi><mi>W</mi><msub><mrow></mrow><mi>s</mi></msub><mo>=</mo><mphantom></mphantom><mi>d</mi><mi>W</mi><msup><mrow></mrow><mn>1</mn></msup><mphantom></mphantom><mi>d</mi><mi>W</mi><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">⋯</mo><mphantom></mphantom><mi>d</mi><mi>W</mi><msup><mrow></mrow><mi>s</mi></msup></mrow><annotation encoding="application/x-tex">\mathop{}\!\mathrm{d}W_{s}=\mathop{}\!\mathrm{d}{W^{1}}\mathop{}\!\mathrm{d}{W^{2}}\cdots\mathop{}\!\mathrm{d}{W^{s}}</annotation></semantics></math>. This identity forms the basis for our second key assumption, which involves analytically continuing this expression from the domain of integers <math id="A5.SS2.p4.m5" class="ltx_Math" alttext="n^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mo>′</mo></msup><annotation encoding="application/x-tex">n^{\prime}</annotation></semantics></math> to the limit <math id="A5.SS2.p4.m6" class="ltx_Math" alttext="n^{\prime}\to 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n^{\prime}\to 0</annotation></semantics></math>.</p>
</div>
<div id="A5.Thmtheorem6" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem6.2" class="ltx_text ltx_font_bold">Assumption E.6</span></span><span id="A5.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(Analytic Continuation of the Partition Function)<span id="A5.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem6.p1" class="ltx_para ltx_noindent">
<p id="A5.Thmtheorem6.p1.1" class="ltx_p"><span id="A5.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">The identity in Eq. (<a href="#A5.E122" title="In E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">122</span></a>), which is guaranteed to hold for integers <math id="A5.Thmtheorem6.p1.m1" class="ltx_Math" alttext="n^{\prime}&gt;p" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>&gt;</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">n^{\prime}&gt;p</annotation></semantics></math>, is assumed to remain valid in the limit <math id="A5.Thmtheorem6.p1.m2" class="ltx_Math" alttext="n^{\prime}\to 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n^{\prime}\to 0</annotation></semantics></math>. That is, for any integer <math id="A5.Thmtheorem6.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>,</span></p>
<table id="A5.E123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E123.m1" class="ltx_math_unparsed" alttext="\lim_{n^{\prime}\to 0}Z^{n^{\prime}-p}=\lim_{n^{\prime}\to 0}\int\mathop{}\!\mathrm{d}W_{n^{\prime}-p}\,\exp\ab(-\beta\sum_{a=1}^{n^{\prime}-p}\mathcal{L}(W^{a}\mid\mathcal{D}))." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><msup><mi>Z</mi><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></msup><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><msup><mi>n</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mo>∫</mo><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mrow><msup><mi>n</mi><mo>′</mo></msup><mo>−</mo><mi>p</mi></mrow></munderover><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{n^{\prime}\to 0}Z^{n^{\prime}-p}=\lim_{n^{\prime}\to 0}\int\mathop{}\!\mathrm{d}W_{n^{\prime}-p}\,\exp\ab(-\beta\sum_{a=1}^{n^{\prime}-p}\mathcal{L}(W^{a}\mid\mathcal{D})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(123)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.p5" class="ltx_para ltx_noindent">
<p id="A5.SS2.p5.1" class="ltx_p">While not mathematically rigorous for all systems, this assumption is standard practice in the replica method. With this assumption, Eq. (<a href="#A5.E121" title="In E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">121</span></a>) can be rewritten by combining all terms into a single expectation over <math id="A5.SS2.p5.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> replicas:</p>
<table id="A5.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E124.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathcal{D}}[g\ab(W^{*})^{p}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathcal{D}}[g\ab(W^{*})^{p}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E124.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\lim_{n\to 0}Z^{n-p}\ab(\int\mathop{}\!\mathrm{d}W\,g(W)\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})))^{p}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0.0835em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><munder><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mrow><msup><mi>Z</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mphantom></mphantom></mrow></mstyle><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\lim_{n\to 0}Z^{n-p}\ab(\int\mathop{}\!\mathrm{d}W\,g(W)\exp\ab(-\beta\mathcal{L}(W\mid\mathcal{D})))^{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(124)</span></td></tr></tbody>
<tbody id="A5.E125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E125.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\lim_{n\to 0}Z^{n-p}\int\mathop{}\!\mathrm{d}W_{p}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{p}\mathcal{L}(W^{a}\mid\mathcal{D}))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><munder><mo lspace="0.167em" movablelimits="false" rspace="0.0835em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><munder><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><msup><mi>Z</mi><mrow><mi>n</mi><mo>−</mo><mi>p</mi></mrow></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>p</mi></msub><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{D}}\lim_{\beta\to\infty}\lim_{n\to 0}Z^{n-p}\int\mathop{}\!\mathrm{d}W_{p}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{p}\mathcal{L}(W^{a}\mid\mathcal{D}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(125)</span></td></tr></tbody>
<tbody id="A5.E126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E126.m1" class="ltx_math_unparsed" alttext="\displaystyle=\lim_{\beta\to\infty}\lim_{n\to 0}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.1389em">=</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><munder><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{\beta\to\infty}\lim_{n\to 0}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(126)</span></td></tr></tbody>
<tbody id="A5.E127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E127.m1" class="ltx_Math" alttext="\displaystyle=\lim_{n\to 0}\frac{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))}{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\ab[Z^{n}]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0.167em">lim</mo><msub><mrow></mrow><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo>∫</mo><mphantom></mphantom><mi>d</mi><mi>W</mi><msub><mrow></mrow><mi>n</mi></msub><mtext class="undefined">\ab</mtext><mo stretchy="false">(</mo><mo lspace="0em">∏</mo><msub><mrow></mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>p</mi></msup><mi>g</mi><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mi>exp</mi><mtext class="undefined">\ab</mtext><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mo>∑</mo><msub><mrow></mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mrow><msub><mo>lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{n\to 0}\frac{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))}{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\ab[Z^{n}]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(127)</span></td></tr></tbody>
<tbody id="A5.E128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E128.m1" class="ltx_Math" alttext="\displaystyle=\lim_{n\to 0}\frac{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))}{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0.167em">lim</mo><msub><mrow></mrow><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo>∫</mo><mphantom></mphantom><mi>d</mi><mi>W</mi><msub><mrow></mrow><mi>n</mi></msub><mtext class="undefined">\ab</mtext><mo stretchy="false">(</mo><mo lspace="0em">∏</mo><msub><mrow></mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>p</mi></msup><mi>g</mi><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mo stretchy="false">)</mo><mo rspace="0.167em" stretchy="false">)</mo><mi>exp</mi><mtext class="undefined">\ab</mtext><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mo>∑</mo><msub><mrow></mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0.167em">lim</mo><msub><mrow></mrow><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mi>𝔼</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo>∫</mo><mphantom></mphantom><mi>d</mi><mi>W</mi><msub><mrow></mrow><mi>n</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mo>∑</mo><msub><mrow></mrow><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lim_{n\to 0}\frac{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\ab(\prod_{a=1}^{p}g(W^{a}))\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))}{\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(128)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p5.2" class="ltx_p">The final expression in Eq. (<a href="#A5.E128" title="In E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">128</span></a>) is the central result of this formalism.
It shows that the desired moment, <math id="A5.SS2.p5.m2" class="ltx_Math" alttext="\mathbb{E}_{\mathcal{D}}[g\ab(W^{*})^{p}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{D}}[g\ab(W^{*})^{p}]</annotation></semantics></math>, can be interpreted as a <math id="A5.SS2.p5.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-point correlation function of the replicated variables <math id="A5.SS2.p5.m4" class="ltx_Math" alttext="\{W^{1},\dots,W^{n}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mi>W</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>W</mi><mi>n</mi></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{W^{1},\dots,W^{n}\}</annotation></semantics></math> drawn from an effective probability distribution:</p>
<table id="A5.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E129.m1" class="ltx_math_unparsed" alttext="\displaystyle p(W^{1},\dots,W^{n})\propto\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D}))," display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>W</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">∝</mo><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>β</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle p(W^{1},\dots,W^{n})\propto\lim_{\beta\to\infty}\mathbb{E}_{\mathcal{D}}\exp\ab(-\beta\sum_{a=1}^{n}\mathcal{L}(W^{a}\mid\mathcal{D})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(129)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p5.3" class="ltx_p">in the <math id="A5.SS2.p5.m5" class="ltx_Math" alttext="n\to 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\to 0</annotation></semantics></math> limit.
The main advantage of this approach is that the difficult average over the data distribution <math id="A5.SS2.p5.m6" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> has been absorbed into the structure of a new joint distribution over <math id="A5.SS2.p5.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> replicated systems. We call this new system the <span id="A5.SS2.p5.3.1" class="ltx_text ltx_font_bold">replica system</span>, and its partition function, <math id="A5.SS2.p5.m8" class="ltx_Math" alttext="\mathbb{E}_{\mathcal{D}}\ab[Z^{n}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{D}}\ab[Z^{n}]</annotation></semantics></math>, the data-averaged <span id="A5.SS2.p5.3.2" class="ltx_text ltx_font_bold">replicated partition function</span>.</p>
</div>
<div id="A5.SS2.p6" class="ltx_para ltx_noindent">
<p id="A5.SS2.p6.1" class="ltx_p">In the subsequent sections, we will analyze this replicated system. By calculating the replicated partition function, we will derive the correlations between replicas, which in turn will allow us to derive Result <a href="#A5.Thmtheorem1" title="Result E.1. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>.</p>
</div>
</section>
<section id="A5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Analysis of the Data-Averaged Replicated Partition Function</h3>

<div id="A5.SS3.p1" class="ltx_para ltx_noindent">
<p id="A5.SS3.p1.1" class="ltx_p">In this subsection, we analyze the data-averaged replicated partition function to derive the statistical properties of the optimal solution. Our immediate goal is to compute the partition function of the probability distribution Eq. (<a href="#A5.E129" title="In E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">129</span></a>), which is the data (disorder) average of the replicated partition function:</p>
<table id="A5.E130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E130.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[Z^{n}]=\mathbb{E}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab[ -\frac{\beta}{2}\sum_{\mu=1}^{M}\sum_{a=1}^{n}\ab(\sum_{ij}\ab(\frac{w_{i}^{\mu}w_{j}^{\mu}}{D}-W_{ij}^{a})H_{ij}^{\mu}+\epsilon^{\mu})^{2}-\frac{D\lambda\beta}{2}\sum_{ij}\sum_{a}\ab(W_{ij}^{a})^{2}]." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mo>∫</mo><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mfrac><mi>β</mi><mn>2</mn></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><munderover><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mfrac><mrow><msubsup><mi>w</mi><mi>i</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>j</mi><mi>μ</mi></msubsup></mrow><mi>D</mi></mfrac><mo>−</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo>+</mo><msup><mi>ϵ</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[Z^{n}]=\mathbb{E}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab[ -\frac{\beta}{2}\sum_{\mu=1}^{M}\sum_{a=1}^{n}\ab(\sum_{ij}\ab(\frac{w_{i}^{\mu}w_{j}^{\mu}}{D}-W_{ij}^{a})H_{ij}^{\mu}+\epsilon^{\mu})^{2}-\frac{D\lambda\beta}{2}\sum_{ij}\sum_{a}\ab(W_{ij}^{a})^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(130)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p2" class="ltx_para ltx_noindent">
<p id="A5.SS3.p2.1" class="ltx_p">The overall disorder average <math id="A5.SS3.p2.m1" class="ltx_Math" alttext="\mathbb{E}[\cdots]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋯</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\cdots]</annotation></semantics></math> here is performed over three hierarchical stages of data generation. Each stage introduces a different source of randomness:</p>
<ul id="A5.I1" class="ltx_itemize">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A5.I1.i1.p1.1" class="ltx_p"><math id="A5.I1.i1.p1.m1" class="ltx_Math" alttext="\mathbb{E}_{\mathcal{W}_{0}}" display="inline" intent=":literal"><semantics><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{W}_{0}}</annotation></semantics></math>: This denotes the average over the generation of the base pool of tasks, <math id="A5.I1.i1.p1.m2" class="ltx_Math" alttext="\mathcal{W}_{0}=\{\mathbf{w}^{1},\dots,\mathbf{w}^{M_{0}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mi>𝐰</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝐰</mi><msub><mi>M</mi><mn>0</mn></msub></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{W}_{0}=\{\mathbf{w}^{1},\dots,\mathbf{w}^{M_{0}}\}</annotation></semantics></math>. This expectation accounts for the randomness in the underlying low-dimensional structure from which all tasks are derived (i.e., the shared matrix <math id="A5.I1.i1.p1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and latent vectors <math id="A5.I1.i1.p1.m4" class="ltx_Math" alttext="\{\mathbf{v}^{\mu}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msup><mi>𝐯</mi><mi>μ</mi></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathbf{v}^{\mu}\}</annotation></semantics></math>).</p>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A5.I1.i2.p1.1" class="ltx_p"><math id="A5.I1.i2.p1.m1" class="ltx_Math" alttext="\mathbb{E}_{\mathcal{W}\mid\mathcal{W}_{0}}" display="inline" intent=":literal"><semantics><msub><mi>𝔼</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo fence="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></mrow></msub><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{W}\mid\mathcal{W}_{0}}</annotation></semantics></math>: This denotes the average over the sampling of the final training set <math id="A5.I1.i2.p1.m2" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math>. Specifically, it is the average over the process of drawing <math id="A5.I1.i2.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> tasks uniformly and with replacement from the fixed base pool <math id="A5.I1.i2.p1.m4" class="ltx_Math" alttext="\mathcal{W}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{W}_{0}</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I1.i3.p1" class="ltx_para">
<p id="A5.I1.i3.p1.1" class="ltx_p"><math id="A5.I1.i3.p1.m1" class="ltx_Math" alttext="\mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}" display="inline" intent=":literal"><semantics><msub><mi>𝔼</mi><mrow><msup><mi>H</mi><mi>μ</mi></msup><mo fence="false">|</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></msub><annotation encoding="application/x-tex">\mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}</annotation></semantics></math>: This denotes the average over the generation of the data within a single training instance for a given task <math id="A5.I1.i3.p1.m2" class="ltx_Math" alttext="\mathbf{w}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝐰</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\mathbf{w}^{\mu}</annotation></semantics></math>. This “in-context” randomness comes from sampling the <math id="A5.I1.i3.p1.m3" class="ltx_Math" alttext="L+1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L+1</annotation></semantics></math> input vectors <math id="A5.I1.i3.p1.m4" class="ltx_Math" alttext="\{\mathbf{x}_{l}^{\mu}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mi>l</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathbf{x}_{l}^{\mu}\}</annotation></semantics></math> and the corresponding label noise <math id="A5.I1.i3.p1.m5" class="ltx_Math" alttext="\{\epsilon_{l}^{\mu}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>ϵ</mi><mi>l</mi><mi>μ</mi></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\epsilon_{l}^{\mu}\}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A5.SS3.p3" class="ltx_para ltx_noindent">
<p id="A5.SS3.p3.1" class="ltx_p">Using the above notation, we can isolate the average over the data distribution (<math id="A5.SS3.p3.m1" class="ltx_Math" alttext="H^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">H^{\mu}</annotation></semantics></math> and noise) for a fixed task <math id="A5.SS3.p3.m2" class="ltx_Math" alttext="\mathbf{w}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝐰</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\mathbf{w}^{\mu}</annotation></semantics></math> by defining the function <math id="A5.SS3.p3.m3" class="ltx_Math" alttext="\phi(\mathbf{W},\mathbf{w}^{\mu})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathbf{W},\mathbf{w}^{\mu})</annotation></semantics></math>:</p>
<table id="A5.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E131.m1" class="ltx_math_unparsed" alttext="\displaystyle\phi(\mathbf{W},\mathbf{w}^{\mu})=\mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}\exp\ab[-\frac{\beta}{2}\sum_{a}\ab(\sum_{ij}\ab(\frac{w^{\mu}_{i}w^{\mu}_{j}}{D}-W_{ij}^{a})H^{\mu}_{ij}+\epsilon^{\mu})^{2}]." display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msup><mi>H</mi><mi>μ</mi></msup><mo fence="false">|</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder></mstyle><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>w</mi><mi>i</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>j</mi><mi>μ</mi></msubsup></mrow><mi>D</mi></mfrac></mstyle><mo>−</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo>+</mo><msup><mi>ϵ</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\phi(\mathbf{W},\mathbf{w}^{\mu})=\mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}\exp\ab[-\frac{\beta}{2}\sum_{a}\ab(\sum_{ij}\ab(\frac{w^{\mu}_{i}w^{\mu}_{j}}{D}-W_{ij}^{a})H^{\mu}_{ij}+\epsilon^{\mu})^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(131)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.2" class="ltx_p">With this definition, the replicated partition function becomes:</p>
<table id="A5.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E132.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Z^{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Z^{n}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E132.m2" class="ltx_math_unparsed" alttext="\displaystyle=\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2})\,\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\{\mathbf{w}^{\mu}\}\mid{\cal W}_{0}}\prod_{\mu=1}^{M}\phi(\mathbf{W},\mathbf{w}^{\mu})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.170em" stretchy="false">)</mo></mrow><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">{</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">}</mo></mrow><mo fence="false">|</mo><msub><mi>𝒲</mi><mn>0</mn></msub></mrow></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2})\,\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\{\mathbf{w}^{\mu}\}\mid{\cal W}_{0}}\prod_{\mu=1}^{M}\phi(\mathbf{W},\mathbf{w}^{\mu})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(132)</span></td></tr></tbody>
<tbody id="A5.E133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E133.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2}) \,\prod_{\mu=1}^{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\ab[\phi(\mathbf{W},\mathbf{w}^{\mu})^{\frac{M}{M_{0}}}] " display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.170em" stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mi>ϕ</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mfrac><mi>M</mi><msub><mi>M</mi><mn>0</mn></msub></mfrac></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2}) \,\prod_{\mu=1}^{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\ab[\phi(\mathbf{W},\mathbf{w}^{\mu})^{\frac{M}{M_{0}}}] </annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(133)</span></td></tr></tbody>
<tbody id="A5.E134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E134.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2}) \,\exp\ab[\frac{M}{M_{0}} \sum_{\mu=1}^{M_{0}} \log\phi(\mathbf{W},\mathbf{w}^{\mu})]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.337em" stretchy="false">)</mo></mrow><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><mfrac><mi>M</mi><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mi>log</mi><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2}) \,\exp\ab[\frac{M}{M_{0}} \sum_{\mu=1}^{M_{0}} \log\phi(\mathbf{W},\mathbf{w}^{\mu})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(134)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.3" class="ltx_p">In the last step, we assume self-averaging with respect to the tasks <math id="A5.SS3.p3.m4" class="ltx_Math" alttext="\mathbf{w}^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>𝐰</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">\mathbf{w}^{\mu}</annotation></semantics></math>, allowing us to replace the sum over logarithms with its average value, which simplifies the expression to depend on the average of <math id="A5.SS3.p3.m5" class="ltx_Math" alttext="\log\phi" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\log\phi</annotation></semantics></math>:</p>
<table id="A5.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E135.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Z^{n}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Z^{n}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E135.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2}) \,\exp\ab[M \log\phi(\mathbf{W},\bar{Q},m)]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.337em" stretchy="false">)</mo></mrow><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mi>M</mi><mi>log</mi><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\,\exp\ab(-\frac{D\lambda\beta}{2}\sum_{a}\sum_{ij}\ab(W_{ij}^{a})^{2}) \,\exp\ab[M \log\phi(\mathbf{W},\bar{Q},m)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(135)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS3.p4" class="ltx_para ltx_noindent">
<p id="A5.SS3.p4.1" class="ltx_p">To proceed, we introduce the following order parameters, which describe the macroscopic state of the system.
We define the following order parameters:</p>
<table id="A5.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E136.m1" class="ltx_Math" alttext="\displaystyle Q^{ab}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle Q^{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E136.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\frac{1}{D}({W}^{a}\mathbf{w}^{\mu})^{\top}({W}^{b}\mathbf{w}^{\mu})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mi>b</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\frac{1}{D}({W}^{a}\mathbf{w}^{\mu})^{\top}({W}^{b}\mathbf{w}^{\mu})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(136)</span></td></tr></tbody>
<tbody id="A5.E137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E137.m1" class="ltx_Math" alttext="\displaystyle\bar{Q}^{ab}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle\bar{Q}^{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E137.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\tr\left(({W}^{a})^{\top}{W}^{b}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>b</mi></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\tr\left(({W}^{a})^{\top}{W}^{b}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(137)</span></td></tr></tbody>
<tbody id="A5.E138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E138.m1" class="ltx_Math" alttext="\displaystyle m^{a}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mi>a</mi></msup><annotation encoding="application/x-tex">\displaystyle m^{a}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E138.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\frac{1}{D}{\mathbf{w}^{\mu}}^{\top}{W}^{a}\mathbf{w}^{\mu}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\frac{1}{D}{\mathbf{w}^{\mu}}^{\top}{W}^{a}\mathbf{w}^{\mu},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(138)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p4.2" class="ltx_p">where the index <math id="A5.SS3.p4.m1" class="ltx_Math" alttext="a,b\in\{1,...,n\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a,b\in\{1,...,n\}</annotation></semantics></math> denotes the replica index.
<math id="A5.SS3.p4.m2" class="ltx_Math" alttext="Q^{ab}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">Q^{ab}</annotation></semantics></math> measures the task-conditioned overlap between replicas, <math id="A5.SS3.p4.m3" class="ltx_Math" alttext="\bar{Q}^{ab}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\bar{Q}^{ab}</annotation></semantics></math> measures the direct overlap of the weight matrices, and <math id="A5.SS3.p4.m4" class="ltx_Math" alttext="m^{a}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mi>a</mi></msup><annotation encoding="application/x-tex">m^{a}</annotation></semantics></math> measures the alignment of a replica’s weights to the task structure.</p>
</div>
<div id="A5.SS3.p5" class="ltx_para">
<p id="A5.SS3.p5.1" class="ltx_p">We now re-evaluate the data-averaged term <math id="A5.SS3.p5.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> by performing the Gaussian integral. We define the vectors</p>
<table id="A5.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E139.m1" class="ltx_Math" alttext="\displaystyle\mathbf{v}^{a}=\pmqty{\lx@physics@matrix\endlx@physics@matrix},\qquad\mathbf{h}=\pmqty{\lx@physics@matrix\endlx@physics@matrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝐯</mi><mi>a</mi></msup><mo>=</mo><mrow><mo>(</mo><mphantom></mphantom><mo>)</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>𝐡</mi><mo>=</mo><mrow><mo>(</mo><mphantom></mphantom><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{v}^{a}=\pmqty{\lx@physics@matrix\endlx@physics@matrix},\qquad\mathbf{h}=\pmqty{\lx@physics@matrix\endlx@physics@matrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(139)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p5.2" class="ltx_p">which allows us to write the exponent as a quadratic form. The average over the zero-mean Gaussian vector <math id="A5.SS3.p5.m2" class="ltx_Math" alttext="\mathbf{h}" display="inline" intent=":literal"><semantics><mi>𝐡</mi><annotation encoding="application/x-tex">\mathbf{h}</annotation></semantics></math> yields:</p>
<table id="A5.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E140.m1" class="ltx_Math" alttext="\displaystyle \phi(\mathbf{W},\mathbf{w}^{\mu})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><mo>,</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle \phi(\mathbf{W},\mathbf{w}^{\mu})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E140.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}\exp\ab[-\frac{\beta}{2} \sum_{a}\ab(\sum_{ij}\ab(\frac{w^{\mu}_{i}w^{\mu}_{j}}{D}-W_{ij}^{a})H_{ij}^{\mu}+\epsilon^{\mu})^{2}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msup><mi>H</mi><mi>μ</mi></msup><mo fence="false">|</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></munder></mstyle><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>w</mi><mi>i</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>j</mi><mi>μ</mi></msubsup></mrow><mi>D</mi></mfrac></mstyle><mo>−</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo>+</mo><msup><mi>ϵ</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}\exp\ab[-\frac{\beta}{2} \sum_{a}\ab(\sum_{ij}\ab(\frac{w^{\mu}_{i}w^{\mu}_{j}}{D}-W_{ij}^{a})H_{ij}^{\mu}+\epsilon^{\mu})^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(140)</span></td></tr></tbody>
<tbody id="A5.E141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E141.m1" class="ltx_math_unparsed" alttext="\displaystyle= \mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}\exp\ab(-\frac{\beta}{2} \sum_{a}\ab(\mathbf{v}^{a}\cdot\mathbf{h})^{2})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msup><mi>H</mi><mi>μ</mi></msup><mo fence="false">|</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐯</mi><mi>a</mi></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝐡</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle= \mathbb{E}_{H^{\mu}\mid\mathbf{w}^{\mu}}\exp\ab(-\frac{\beta}{2} \sum_{a}\ab(\mathbf{v}^{a}\cdot\mathbf{h})^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(141)</span></td></tr></tbody>
<tbody id="A5.E142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E142.m1" class="ltx_Math" alttext="\displaystyle=\ab[\det\ab(I_{D^{2}+1}+2\beta C^{H}VV^{\top})]^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>det</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mrow><msup><mi>D</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>H</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mo>⊤</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ab[\det\ab(I_{D^{2}+1}+2\beta C^{H}VV^{\top})]^{-\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(142)</span></td></tr></tbody>
<tbody id="A5.E143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E143.m1" class="ltx_Math" alttext="\displaystyle=\ab[\det\ab(I_{n}+2\beta V^{\top}C^{H}V)]^{-\frac{1}{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>det</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mi>n</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>V</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>H</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\ab[\det\ab(I_{n}+2\beta V^{\top}C^{H}V)]^{-\frac{1}{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(143)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p5.3" class="ltx_p">where <math id="A5.SS3.p5.m3" class="ltx_Math" alttext="V\in\mathbb{R}^{(D^{2}+1)\times n}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>D</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">V\in\mathbb{R}^{(D^{2}+1)\times n}</annotation></semantics></math> is the matrix whose columns are <math id="A5.SS3.p5.m4" class="ltx_Math" alttext="\mathbf{v}^{a}" display="inline" intent=":literal"><semantics><msup><mi>𝐯</mi><mi>a</mi></msup><annotation encoding="application/x-tex">\mathbf{v}^{a}</annotation></semantics></math>, and <math id="A5.SS3.p5.m5" class="ltx_Math" alttext="C^{H}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>H</mi></msup><annotation encoding="application/x-tex">C^{H}</annotation></semantics></math> is the covariance matrix of <math id="A5.SS3.p5.m6" class="ltx_Math" alttext="\mathbf{h}" display="inline" intent=":literal"><semantics><mi>𝐡</mi><annotation encoding="application/x-tex">\mathbf{h}</annotation></semantics></math>. The entries of the matrix <math id="A5.SS3.p5.m7" class="ltx_Math" alttext="V^{\top}C^{H}V" display="inline" intent=":literal"><semantics><mrow><msup><mi>V</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>H</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">V^{\top}C^{H}V</annotation></semantics></math> can be computed as:</p>
<table id="A5.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E144.m1" class="ltx_Math" alttext="\displaystyle\ab(V^{\top}C^{H}V)_{ab}" display="inline" intent=":literal"><semantics><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>V</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>H</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ab(V^{\top}C^{H}V)_{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E144.m2" class="ltx_Math" alttext="\displaystyle=\sum_{(ij),(kl)}^{D^{2}} V_{(ij),a}V_{(kl),b}C^{H}_{(ij)(kl)}+\sigma^{2} " display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>D</mi><mn>2</mn></msup></munderover></mstyle><mrow><msub><mi>V</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>b</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>H</mi></msubsup></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(ij),(kl)}^{D^{2}} V_{(ij),a}V_{(kl),b}C^{H}_{(ij)(kl)}+\sigma^{2} </annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(144)</span></td></tr></tbody>
<tbody id="A5.E145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E145.m1" class="ltx_Math" alttext="\displaystyle=\sum_{(ij),(kl)}^{D^{2}} \ab(\frac{w^{\mu}_{i}w^{\mu}_{j}}{D}-W_{ij}^{a})\ab(\frac{w^{\mu}_{k}w^{\mu}_{l}}{D}-W_{kl}^{b}) \frac{\delta_{ik}}{D}\ab(\frac{D}{L}\delta_{jl}(1+\sigma^{2})+w_{j}w_{l})+\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>D</mi><mn>2</mn></msup></munderover></mstyle><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>w</mi><mi>i</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>j</mi><mi>μ</mi></msubsup></mrow><mi>D</mi></mfrac></mstyle><mo>−</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>a</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>w</mi><mi>k</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>l</mi><mi>μ</mi></msubsup></mrow><mi>D</mi></mfrac></mstyle><mo>−</mo><msubsup><mi>W</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mi>b</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>δ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>D</mi><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>l</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(ij),(kl)}^{D^{2}} \ab(\frac{w^{\mu}_{i}w^{\mu}_{j}}{D}-W_{ij}^{a})\ab(\frac{w^{\mu}_{k}w^{\mu}_{l}}{D}-W_{kl}^{b}) \frac{\delta_{ik}}{D}\ab(\frac{D}{L}\delta_{jl}(1+\sigma^{2})+w_{j}w_{l})+\sigma^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(145)</span></td></tr></tbody>
<tbody id="A5.E146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E146.m1" class="ltx_Math" alttext="\displaystyle=\frac{D}{L}(1+\sigma^{2})\bar{Q}^{ab}+\ab(Q^{ab}-m^{a}-m^{b}+1)+\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>D</mi><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup></mrow><mo>+</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>Q</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo>−</mo><msup><mi>m</mi><mi>a</mi></msup><mo>−</mo><msup><mi>m</mi><mi>b</mi></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{D}{L}(1+\sigma^{2})\bar{Q}^{ab}+\ab(Q^{ab}-m^{a}-m^{b}+1)+\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(146)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p5.4" class="ltx_p">Defining <math id="A5.SS3.p5.m8" class="ltx_Math" alttext="\mathcal{M}\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{M}\in\mathbb{R}^{n\times n}</annotation></semantics></math> as the matrix whose elements are given by the expression above, we finally obtain:</p>
