over><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\ab[\hat{\chi}\mathbb{E}\ab[\tr\ab(S\mathcal{M}^{-2})]+\hat{\bar{\chi}}\mathbb{E}\ab[\tr\ab(\mathcal{M}^{-2})]+\kappa\hat{m}^{2}\mathbb{E}\ab[\tr\ab(S^{2}\mathcal{M}^{-2})]]</annotation></semantics></math></td>
