<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E112.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{\kappa}{\rho}+\frac{\kappa(\rho-\kappa)}{\rho}\frac{1}{\kappa\gamma-1}+\frac{\rho-\kappa}{\rho(\kappa\gamma-1)}\frac{\sigma^{2}}{1+\sigma^{2}}\alpha+\mathcal{O}\ab(\frac{1}{\alpha})&amp;\text{for }\rho&gt;\kappa\\
1+\frac{\sigma^{2}}{\kappa\gamma-1}\frac{\kappa\rho}{\kappa-\rho}+\mathcal{O}\ab(\frac{1}{\alpha})&amp;\text{for }\rho&lt;\kappa\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mi>κ</mi><mi>ρ</mi></mfrac><mo>+</mo><mrow><mfrac><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ρ</mi><mo>−</mo><mi>κ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>ρ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>+</mo><mrow><mfrac><mrow><mi>ρ</mi><mo>−</mo><mi>κ</mi></mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo>&gt;</mo><mi>κ</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mrow><mi>κ</mi><mo>−</mo><mi>ρ</mi></mrow></mfrac></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo>&lt;</mo><mi>κ</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{\kappa}{\rho}+\frac{\kappa(\rho-\kappa)}{\rho}\frac{1}{\kappa\gamma-1}+\frac{\rho-\kappa}{\rho(\kappa\gamma-1)}\frac{\sigma^{2}}{1+\sigma^{2}}\alpha+\mathcal{O}\ab(\frac{1}{\alpha})&amp;\text{for }\rho&gt;\kappa\\
1+\frac{\sigma^{2}}{\kappa\gamma-1}\frac{\kappa\rho}{\kappa-\rho}+\mathcal{O}\ab(\frac{1}{\alpha})&amp;\text{for }\rho&lt;\kappa\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="3"></td>
