<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E185.m1" class="ltx_Math" alttext="m=\frac{1}{D}\mathbb{E}\ab[\tr\ab(S{W^{*}})]=\frac{\hat{m}}{D}\mathbb{E}\ab[\tr\ab(S^{2}\mathcal{M}^{-1})]=\frac{\hat{m}}{\hat{q}}\ab(1+z+z^{2}g_{S}(z))" display="block" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mi>D</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>D</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mover accent="true"><mi>m</mi><mo>^</mo></mover><mover accent="true"><mi>q</mi><mo>^</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>z</mi><mo>+</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m=\frac{1}{D}\mathbb{E}\ab[\tr\ab(S{W^{*}})]=\frac{\hat{m}}{D}\mathbb{E}\ab[\tr\ab(S^{2}\mathcal{M}^{-1})]=\frac{\hat{m}}{\hat{q}}\ab(1+z+z^{2}g_{S}(z))</annotation></semantics></math></td>
