&amp;\qquad\left.+\sum_{\mu}\sum_{a}\hat{m}^{a}{\mathbf{w}^{\mu}}^{\top}W^{a}\mathbf{w}^{\mu}-\frac{\lambda\beta M_{0}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)\right]\\
G_{E}&amp;= \exp\ab[M \log \phi(Q,\bar{Q},m)].\end{aligned}\par\par" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mtable columnspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo stretchy="false">]</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></munder><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>Q</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mi>a</mi></munder><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mi>a</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mphantom></mphantom><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>a</mi></msup></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>G</mi><mi>I</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mi>S</mi></msub></mrow></mrow></mrow></mrow></mrow></mstyle></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mi>G</mi><mi>I</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>exp</mi><mtext class="undefined">\ab</mtext><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mi>Q</mi><msup><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><msup><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><msup><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mover accent="true"><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>^</mo></mover><msup><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo>−</mo><mi>D</mi><mi>M</mi><msub><mrow></mrow><mn>0</mn></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>a</mi></msub><mi>m</mi><msup><mrow></mrow><mi>a</mi></msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><msup><mrow></mrow><mi>a</mi></msup><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mi>G</mi><mi>S</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><msub><mi>𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><mi>W</mi><msup><mrow></mrow><mi>n</mi></msup><mi>exp</mi><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>μ</mi></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><msup><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mo>(</mo><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mi>𝐰</mi><msup><mrow></mrow><mi>μ</mi></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">(</mo><mi>W</mi><msup><mrow></mrow><mi>b</mi></msup><mi>𝐰</mi><msup><mrow></mrow><mi>μ</mi></msup><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>M</mi><mn>0</mn></msub><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mover accent="true"><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>^</mo></mover><msup><mrow></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mi>tr</mi><mo>(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>W</mi><msup><mrow></mrow><mi>b</mi></msup><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>μ</mi></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>a</mi></msub><mover accent="true"><mi>m</mi><mo>^</mo></mover><msup><mrow></mrow><mi>a</mi></msup><mi>𝐰</mi><msup><mrow></mrow><mi>μ</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mi>𝐰</mi><msup><mrow></mrow><mi>μ</mi></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>a</mi></msub><mi>tr</mi><mo>(</mo><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><msup><mrow></mrow><mo>⊤</mo></msup><mi>W</mi><msup><mrow></mrow><mi>a</mi></msup><mo>)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><msub><mi>G</mi><mi>E</mi></msub></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo>,</mo><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">areintroduced.Thisallowsustoexpresstheaveragedreplicatedpartitionfunctionasaproductofthreeterms:\begin{aligned} \mathbb{E}[Z^{n}]&amp;=\int\prod_{ab}\ab(\mathop{}\!\mathrm{d}Q^{ab}\mathop{}\!\mathrm{d}{\hat{Q}^{ab}}\mathop{}\!\mathrm{d}{\bar{Q}^{ab}}\mathop{}\!\mathrm{d}{\hat{\bar{Q}}^{ab}})\prod_{a}\ab(\mathop{}\!\mathrm{d}{m^{a}}\mathop{}\!\mathrm{d}{\hat{m}^{a}})\,G_{I}G_{E}G_{S},\end{aligned}where\begin{aligned} G_{I}&amp;=\exp\ab(-\frac{DM_{0}}{2}\sum_{ab}Q^{ab}\hat{Q}^{ab}-\frac{DM_{0}}{2}\sum_{ab}\bar{Q}^{ab}\hat{\bar{Q}}^{ab}-DM_{0}\sum_{a}m^{a}\hat{m}^{a})\\
G_{S}&amp;=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}{W^{n}}\exp\left[\frac{1}{2}\sum_{\mu}\sum_{ab}\hat{Q}^{ab}\left((W^{a}\mathbf{w}^{\mu})^{\top}(W^{b}\mathbf{w}^{\mu})\right)+\frac{M_{0}}{2}\sum_{ab}\hat{\bar{Q}}^{ab}\tr\left({W^{a}}^{\top}W^{b}\right)\right.\\
&amp;\qquad\left.+\sum_{\mu}\sum_{a}\hat{m}^{a}{\mathbf{w}^{\mu}}^{\top}W^{a}\mathbf{w}^{\mu}-\frac{\lambda\beta M_{0}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)\right]\\
G_{E}&amp;= \exp\ab[M \log \phi(Q,\bar{Q},m)].\end{aligned}\par\par</annotation></semantics></math><span id="footnote5" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">5</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">5</sup>
              <span class="ltx_tag ltx_tag_note">5</span>
              
              
              
            The integration over the conjugate parameters is performed along the imaginary axis to ensure the positivity of the parameters.</span></span></span></p>
</div>
</section>
<section id="A5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.4 </span>Replica-Symmetric (RS) Ansatz</h3>

<div id="A5.SS4.p1" class="ltx_para ltx_noindent">
<p id="A5.SS4.p1.1" class="ltx_p">In this subsection, we now apply the replica-symmetric (RS) ansatz, which is a foundational step in simplifying the replicated system.
The core idea is to assume that all <math id="A5.SS4.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> replicas are statistically equivalent and interchangeable.
It is important to note that the validity of the RS solution is not mathematically guaranteed for all complex systems; its correctness has only been rigorously proven for a limited class of models.
However, particularly for convex optimization problems such as the one considered in this work, the replica method under the Assumption. <a href="#A5.Thmtheorem6" title="Assumption E.6 (Analytic Continuation of the Partition Function). ‣ E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.6</span></a>, <a href="#A5.Thmtheorem5" title="Assumption E.5 (Identifiability from Moments of a Scalar Statistic). ‣ E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.5</span></a>, and <a href="#A5.Thmtheorem7" title="Assumption E.7 (Replica Symmetry). ‣ E.4 Replica-Symmetric (RS) Ansatz ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.7</span></a> has an extensive and successful track record. To date, there are no known instances where the method, when applied to such problems under standard supporting assumptions, has led to physically inconsistent or contradictory results.
Therefore, it serves as a crucial and often surprisingly accurate starting point in the analysis of disordered systems.</p>
</div>
<div id="A5.Thmtheorem7" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem7.2" class="ltx_text ltx_font_bold">Assumption E.7</span></span><span id="A5.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Replica Symmetry)<span id="A5.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem7.p1" class="ltx_para">
<p id="A5.Thmtheorem7.p1.1" class="ltx_p"><span id="A5.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">The RS ansatz parameterizes the order parameter matrices, which depend on pairs of replica indices <math id="A5.Thmtheorem7.p1.m1" class="ltx_Math" alttext="(a,b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,b)</annotation></semantics></math>, in terms of a small number of macroscopic variables. This symmetry is expressed as:</span></p>
<table id="A5.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E149.m1" class="ltx_Math" alttext="\displaystyle Q^{ab}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle Q^{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E149.m2" class="ltx_Math" alttext="\displaystyle=\frac{\chi}{\beta}\delta_{ab}+q," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>χ</mi><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow><mo>+</mo><mi>q</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\chi}{\beta}\delta_{ab}+q,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(149)</span></td></tr></tbody>
<tbody id="A5.E150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E150.m1" class="ltx_Math" alttext="\displaystyle\bar{Q}^{ab}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle\bar{Q}^{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E150.m2" class="ltx_Math" alttext="\displaystyle=\frac{\bar{\chi}}{\beta}\delta_{ab}+\bar{q}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mi>β</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow><mo>+</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\bar{\chi}}{\beta}\delta_{ab}+\bar{q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(150)</span></td></tr></tbody>
<tbody id="A5.E151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E151.m1" class="ltx_Math" alttext="\displaystyle\hat{Q}^{ab}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle\hat{Q}^{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E151.m2" class="ltx_Math" alttext="\displaystyle=-\beta\hat{q}\delta_{ab}+\beta^{2}\hat{\chi}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>^</mo></mover></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\beta\hat{q}\delta_{ab}+\beta^{2}\hat{\chi},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(151)</span></td></tr></tbody>
<tbody id="A5.E152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E152.m1" class="ltx_Math" alttext="\displaystyle\hat{\bar{Q}}^{ab}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><annotation encoding="application/x-tex">\displaystyle\hat{\bar{Q}}^{ab}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E152.m2" class="ltx_Math" alttext="\displaystyle=-\beta\hat{\bar{q}}\delta_{ab}+\beta^{2}\hat{\bar{\chi}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\beta\hat{\bar{q}}\delta_{ab}+\beta^{2}\hat{\bar{\chi}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(152)</span></td></tr></tbody>
<tbody id="A5.E153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E153.m1" class="ltx_Math" alttext="\displaystyle m^{a}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mi>a</mi></msup><annotation encoding="application/x-tex">\displaystyle m^{a}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E153.m2" class="ltx_Math" alttext="\displaystyle=m" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">\displaystyle=m</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(153)</span></td></tr></tbody>
<tbody id="A5.E154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E154.m1" class="ltx_Math" alttext="\displaystyle\hat{m}^{a}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>a</mi></msup><annotation encoding="application/x-tex">\displaystyle\hat{m}^{a}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E154.m2" class="ltx_Math" alttext="\displaystyle=\beta\hat{m}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>m</mi><mo>^</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\beta\hat{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(154)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS4.p2" class="ltx_para ltx_noindent">
<p id="A5.SS4.p2.1" class="ltx_p">This assumption is essential to the replica method for two primary reasons.
First, it drastically simplifies the problem by positing that the complex interactions between <math id="A5.SS4.p2.m1" class="ltx_Math" alttext="n(n-1)/2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n(n-1)/2</annotation></semantics></math> pairs of replicas can be described by a small, fixed number of macroscopic order parameters.
This reduces a problem with a large number of degrees of freedom to one of solving a few self-consistent equations. Second, the symmetric structure imposed by the ansatz is a necessary technical step to analytically continue the expressions from integer <math id="A5.SS4.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> to the <math id="A5.SS4.p2.m3" class="ltx_Math" alttext="n\to 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\to 0</annotation></semantics></math> limit, which is the core of the replica trick.
Without this simplification, the combinatorial structure of the replica indices would prevent a well-defined continuation.</p>
</div>
<div id="A5.SS4.p3" class="ltx_para ltx_noindent">
<p id="A5.SS4.p3.1" class="ltx_p">Upon substituting the RS ansatz into the expression for the replicated partition function, the average over the data distribution <math id="A5.SS4.p3.m1" class="ltx_Math" alttext="\mathbb{E}\left[Z^{n}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Z^{n}\right]</annotation></semantics></math> (Eq. (<a href="#A5.SS3" title="E.3 Analysis of the Data-Averaged Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.3</span></a>)) can be expressed as an integral over the relevant order parameters.
Let the set of these parameters be denoted by <math id="A5.SS4.p3.m2" class="ltx_Math" alttext="\mathbf{x}=\{q,\bar{q},m,\chi,\bar{\chi},\hat{q},\hat{\bar{q}},\hat{m}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>q</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>,</mo><mi>m</mi><mo>,</mo><mi>χ</mi><mo>,</mo><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>,</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo>,</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover><mo>,</mo><mover accent="true"><mi>m</mi><mo>^</mo></mover></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}=\{q,\bar{q},m,\chi,\bar{\chi},\hat{q},\hat{\bar{q}},\hat{m}\}</annotation></semantics></math>. The resulting expression takes the form:</p>
<table id="A5.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E155.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[Z^{n}\right]=\int\left(\prod_{i\in\mathbf{x}}\mathrm{d}x_{i}\right)\exp\left[-\beta DM_{0}f(\mathbf{x})+\mathcal{O}(1)\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Z</mi><mi>n</mi></msup><mo>]</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>𝐱</mi></mrow></munder><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[Z^{n}\right]=\int\left(\prod_{i\in\mathbf{x}}\mathrm{d}x_{i}\right)\exp\left[-\beta DM_{0}f(\mathbf{x})+\mathcal{O}(1)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(155)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p3.2" class="ltx_p">where <math id="A5.SS4.p3.m3" class="ltx_Math" alttext="f(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\mathbf{x})</annotation></semantics></math> is a function of the order parameters.</p>
</div>
<div id="A5.SS4.p4" class="ltx_para ltx_noindent">
<p id="A5.SS4.p4.1" class="ltx_p">In the asymptotic limit where <math id="A5.SS4.p4.m1" class="ltx_Math" alttext="D\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">D\to\infty</annotation></semantics></math>, this integral can be evaluated using the saddle-point method (also known as the method of steepest descent).
Consequently, the values of the order parameters are determined by finding the specific configuration <math id="A5.SS4.p4.m2" class="ltx_Math" alttext="\mathbf{x}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathbf{x}^{*}</annotation></semantics></math> that extremizes the function <math id="A5.SS4.p4.m3" class="ltx_Math" alttext="f(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\mathbf{x})</annotation></semantics></math>.
This procedure yields the saddle-point equations, which require the partial derivative of <math id="A5.SS4.p4.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> with respect to each order parameter <math id="A5.SS4.p4.m5" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> to be zero:</p>
<table id="A5.E156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E156.m1" class="ltx_Math" alttext="\frac{\partial f}{\partial x_{i}}=0,\quad\text{for all }x_{i}\in\mathbf{x}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><mi>f</mi></mrow><mrow><mo>∂</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mfrac><mo>=</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>∈</mo><mi>𝐱</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial f}{\partial x_{i}}=0,\quad\text{for all }x_{i}\in\mathbf{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(156)</span></td></tr></tbody>
</table>
<p id="A5.SS4.p4.2" class="ltx_p">The solution to this system of equations determines the macroscopic state of the system, providing the values of the order parameters that characterize its typical behavior in the asymptotic limit.</p>
</div>
</section>
<section id="A5.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.5 </span>Statistics of the solution <math id="A5.SS5.m1" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math> (derivation of the Result. <a href="#A5.Thmtheorem1" title="Result E.1. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>)</h3>

<div id="A5.SS5.p1" class="ltx_para ltx_noindent">
<p id="A5.SS5.p1.1" class="ltx_p">In this subsection, we derive an equivalent and interpretable expression that characterizes the statistics of <math id="A5.SS5.p1.m1" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>.
Substituting the RS ansatz into the expression for <math id="A5.SS5.p1.m2" class="ltx_Math" alttext="G_{S}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>S</mi></msub><annotation encoding="application/x-tex">G_{S}</annotation></semantics></math> (Eq. (<a href="#A5.SS3" title="E.3 Analysis of the Data-Averaged Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.3</span></a>)) gives:</p>
<table id="A5.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex5.m1" class="ltx_Math" alttext="\displaystyle G_{S}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\displaystyle G_{S}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex5.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\exp\left[\frac{1}{2}\sum_{\mu}\sum_{ab}\hat{Q}^{ab}\left((W^{a}\mathbf{w}^{\mu})^{\top}(W^{b}\mathbf{w}^{\mu})\right)+\frac{M_{0}}{2}\sum_{ab}\hat{\bar{Q}}^{ab}\tr\left({W^{a}}^{\top}W^{b}\right)\right." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi>𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></munder></mstyle><msup><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>b</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>M</mi><mn>0</mn></msub><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></munder></mstyle><msup><mover accent="true"><mover accent="true"><mi>Q</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msup><mi>tr</mi><mrow><mo>(</mo><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>W</mi><mi>b</mi></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\exp\left[\frac{1}{2}\sum_{\mu}\sum_{ab}\hat{Q}^{ab}\left((W^{a}\mathbf{w}^{\mu})^{\top}(W^{b}\mathbf{w}^{\mu})\right)+\frac{M_{0}}{2}\sum_{ab}\hat{\bar{Q}}^{ab}\tr\left({W^{a}}^{\top}W^{b}\right)\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E157.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\left.+\sum_{\mu}\sum_{a}\hat{m}^{a}{\mathbf{w}^{\mu}}^{\top}W^{a}\mathbf{w}^{\mu}-\frac{\lambda\beta M_{0}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mi>a</mi></msup><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mi>tr</mi><mrow><mo>(</mo><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>W</mi><mi>a</mi></msup><mo>)</mo></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\left.+\sum_{\mu}\sum_{a}\hat{m}^{a}{\mathbf{w}^{\mu}}^{\top}W^{a}\mathbf{w}^{\mu}-\frac{\lambda\beta M_{0}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(157)</span></td></tr></tbody>
<tbody id="A5.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex6.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\exp\left[-\frac{\beta\hat{q}}{2}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}(W^{a}\mathbf{w}^{\mu})+\frac{\beta^{2}\hat{\chi}}{2}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}\sum_{b}(W^{b}\mathbf{w}^{\mu})\right." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi>𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>exp</mi><mrow><mo>[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>b</mi></munder></mstyle><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>b</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\exp\left[-\frac{\beta\hat{q}}{2}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}(W^{a}\mathbf{w}^{\mu})+\frac{\beta^{2}\hat{\chi}}{2}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}\sum_{b}(W^{b}\mathbf{w}^{\mu})\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex7.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-\frac{M_{0}\beta\hat{\bar{q}}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)+\frac{M_{0}\beta^{2}\hat{\bar{\chi}}}{2}\tr\left(\sum_{a}{W^{a}}^{\top}\sum_{b}W^{b}\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mi>tr</mi><mrow><mo>(</mo><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>W</mi><mi>a</mi></msup><mo>)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mi>tr</mi><mrow><mo>(</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>b</mi></munder></mstyle><msup><mi>W</mi><mi>b</mi></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-\frac{M_{0}\beta\hat{\bar{q}}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)+\frac{M_{0}\beta^{2}\hat{\bar{\chi}}}{2}\tr\left(\sum_{a}{W^{a}}^{\top}\sum_{b}W^{b}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E158.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\left.+\beta\hat{m}\sum_{\mu}\sum_{a}{\mathbf{w}^{\mu}}^{\top}W^{a}\mathbf{w}^{\mu}-\frac{\lambda\beta M_{0}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>β</mi><mover accent="true"><mi>m</mi><mo>^</mo></mover><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mi>tr</mi><mrow><mo>(</mo><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>W</mi><mi>a</mi></msup><mo>)</mo></mrow><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\left.+\beta\hat{m}\sum_{\mu}\sum_{a}{\mathbf{w}^{\mu}}^{\top}W^{a}\mathbf{w}^{\mu}-\frac{\lambda\beta M_{0}}{2}\sum_{a}\tr\left({W^{a}}^{\top}W^{a}\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(158)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p1.2" class="ltx_p">This allows us to decouple the replicas through the following Hubbard-Stratonovich transformation:</p>
<table id="A5.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E159.m1" class="ltx_Math" alttext="\displaystyle\exp\ab[\frac{\beta^{2}\hat{\chi}}{2}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}\sum_{b}(W^{b}\mathbf{w}^{\mu})]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>χ</mi><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>b</mi></munder></mstyle><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mi>b</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\ab[\frac{\beta^{2}\hat{\chi}}{2}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}\sum_{b}(W^{b}\mathbf{w}^{\mu})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E159.m2" class="ltx_Math" alttext="\displaystyle=\int\mathrm{D}\mathbf{\xi}_{M_{0}}\exp\ab[\beta\sqrt{\hat{\chi}}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}\mathbf{\xi}^{\mu}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><msub><mi>M</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mi>χ</mi><mo>^</mo></mover></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>μ</mi></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>a</mi></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mi>μ</mi></msup></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathrm{D}\mathbf{\xi}_{M_{0}}\exp\ab[\beta\sqrt{\hat{\chi}}\sum_{\mu}\sum_{a}(W^{a}\mathbf{w}^{\mu})^{\top}\mathbf{\xi}^{\mu}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(159)</span></td></tr></tbody>
<tbody id="A5.E160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E160.m1" class="ltx_Math" alttext="\displaystyle\exp\ab[\frac{M_{0}\beta^{2}\hat{\bar{\chi}}}{2}\tr\ab(\sum_{a}{W^{a}}^{\top}\sum_{b}W^{b})]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mrow><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>b</mi></munder></mstyle><msup><mi>W</mi><mi>b</mi></msup></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\ab[\frac{M_{0}\beta^{2}\hat{\bar{\chi}}}{2}\tr\ab(\sum_{a}{W^{a}}^{\top}\sum_{b}W^{b})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E160.m2" class="ltx_Math" alttext="\displaystyle=\int\mathrm{D}\Lambda\exp\ab[\beta\sqrt{M_{0}\hat{\bar{\chi}}}\tr\ab({W^{a}}^{\top}\Lambda)]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int\mathrm{D}\Lambda\exp\ab[\beta\sqrt{M_{0}\hat{\bar{\chi}}}\tr\ab({W^{a}}^{\top}\Lambda)],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(160)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p1.3" class="ltx_p">where <math id="A5.SS5.p1.m3" class="ltx_Math" alttext="\mathbf{\xi}=(\mathbf{\xi}^{\mu}\in\mathbb{R}^{D})_{1\leq\mu\leq M_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ξ</mi><mi>μ</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>≤</mo><mi>μ</mi><mo>≤</mo><msub><mi>M</mi><mn>0</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{\xi}=(\mathbf{\xi}^{\mu}\in\mathbb{R}^{D})_{1\leq\mu\leq M_{0}}</annotation></semantics></math>, <math id="A5.SS5.p1.m4" class="ltx_Math" alttext="\Lambda\in\mathbb{R}^{D\times D}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Lambda\in\mathbb{R}^{D\times D}</annotation></semantics></math>, and <math id="A5.SS5.p1.m5" class="ltx_Math" alttext="\mathrm{D}\mathbf{\xi}_{M_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ξ</mi><msub><mi>M</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\mathrm{D}\mathbf{\xi}_{M_{0}}</annotation></semantics></math> and <math id="A5.SS5.p1.m6" class="ltx_Math" alttext="\mathrm{D}\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\mathrm{D}\Lambda</annotation></semantics></math> are the standard Gaussian measures defined as
<math id="A5.SS5.p1.m7" class="ltx_math_unparsed" alttext="\mathrm{D}\mathbf{\xi}_{M_{0}}=\prod_{\mu=1}^{M_{0}}\exp\ab(-{\mathbf{\xi}^{\mu}}^{\top}\mathbf{\xi}^{\mu}/2)/\sqrt{2\pi}^{D}\mathop{}\!\mathrm{d}{\mathbf{\xi}^{\mu}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><msub><mi>ξ</mi><msub><mi>M</mi><mn>0</mn></msub></msub><mo rspace="0.111em">=</mo><msubsup><mo>∏</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></msubsup><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mmultiscripts><mi>ξ</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><msup><mi>ξ</mi><mi>μ</mi></msup><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>/</mo><msup><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt><mi>D</mi></msup><mphantom></mphantom><mi>d</mi><msup><mi>ξ</mi><mi>μ</mi></msup></mrow><annotation encoding="application/x-tex">\mathrm{D}\mathbf{\xi}_{M_{0}}=\prod_{\mu=1}^{M_{0}}\exp\ab(-{\mathbf{\xi}^{\mu}}^{\top}\mathbf{\xi}^{\mu}/2)/\sqrt{2\pi}^{D}\mathop{}\!\mathrm{d}{\mathbf{\xi}^{\mu}}</annotation></semantics></math>, <math id="A5.SS5.p1.m8" class="ltx_math_unparsed" alttext="\mathrm{D}\Lambda=\prod_{ij}\exp\ab(-\Lambda_{ij}^{2}/2)/\sqrt{2\pi}\mathop{}\!\mathrm{d}\Lambda_{ij}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mi mathvariant="normal">Λ</mi><mo rspace="0.111em">=</mo><msub><mo>∏</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msubsup><mi mathvariant="normal">Λ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>/</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow></msqrt><mphantom></mphantom><mi>d</mi><msub><mi mathvariant="normal">Λ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{D}\Lambda=\prod_{ij}\exp\ab(-\Lambda_{ij}^{2}/2)/\sqrt{2\pi}\mathop{}\!\mathrm{d}\Lambda_{ij}</annotation></semantics></math>.
Using these transformations, we can rewrite the expression for <math id="A5.SS5.p1.m9" class="ltx_Math" alttext="G_{S}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>S</mi></msub><annotation encoding="application/x-tex">G_{S}</annotation></semantics></math> as:</p>
<table id="A5.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex8.m1" class="ltx_Math" alttext="\displaystyle G_{S}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\displaystyle G_{S}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex8.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\mathrm{D}\mathbf{\xi}\mathrm{D}\Lambda\,\exp\left[-\beta\sum_{a}\left[\frac{1}{2}\tr\ab(W^{a}\ab(\hat{q}\sum_{\mu}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D}){W^{a}}^{\top}) \right.\right." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi>𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>D</mi><mi>ξ</mi><mi>D</mi><mi mathvariant="normal">Λ</mi><mi>exp</mi><mrow><mo>[</mo><mo lspace="0em">−</mo><mi>β</mi><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mi>tr</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>q</mi><mo>^</mo></mover><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><msup><mi>𝐰</mi><mi>μ</mi></msup><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><msub><mi>M</mi><mn>0</mn></msub><msub><mi>I</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow><mmultiscripts><mi>W</mi><mrow></mrow><mi>a</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\mathrm{D}\mathbf{\xi}\mathrm{D}\Lambda\,\exp\left[-\beta\sum_{a}\left[\frac{1}{2}\tr\ab(W^{a}\ab(\hat{q}\sum_{\mu}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D}){W^{a}}^{\top}) \right.\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E161.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\left.\left.-\sum_{\mu}\ab(W^{a}\mathbf{w}^{\mu})^{\top}\ab(\sqrt{\hat{\chi}}\mathbf{\xi}^{\mu}+\hat{m}\mathbf{w}^{\mu})-\sqrt{M_{0}}\sqrt{\hat{\bar{\chi}}}\tr\ab(W^{a}\Lambda) \right]\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mtext class="undefined">\ab</mtext><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><msqrt><mover accent="true"><mi>χ</mi><mo>^</mo></mover></msqrt><msup><mi>ξ</mi><mi>μ</mi></msup><mo>+</mo><mover accent="true"><mi>m</mi><mo>^</mo></mover><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><msqrt><msub><mi>M</mi><mn>0</mn></msub></msqrt><msqrt><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></msqrt><mi>tr</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\left.\left.-\sum_{\mu}\ab(W^{a}\mathbf{w}^{\mu})^{\top}\ab(\sqrt{\hat{\chi}}\mathbf{\xi}^{\mu}+\hat{m}\mathbf{w}^{\mu})-\sqrt{M_{0}}\sqrt{\hat{\bar{\chi}}}\tr\ab(W^{a}\Lambda) \right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(161)</span></td></tr></tbody>
<tbody id="A5.E162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E162.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\mathrm{D}\mathbf{\xi}\mathrm{D}\Lambda\, \exp\ab[-\frac{\beta}{2}\sum_{a}f(W^{a})]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><msub><mi>𝒲</mi><mn>0</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><mphantom></mphantom><mi>d</mi><msub><mi>W</mi><mi>n</mi></msub><mi>D</mi><mi>ξ</mi><mi>D</mi><mi mathvariant="normal">Λ</mi><mi>exp</mi><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>a</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\cal W}_{0}}\int\mathop{}\!\mathrm{d}W_{n}\mathrm{D}\mathbf{\xi}\mathrm{D}\Lambda\, \exp\ab[-\frac{\beta}{2}\sum_{a}f(W^{a})],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(162)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p1.4" class="ltx_p">where we have defined</p>
<table id="A5.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E163.m1" class="ltx_Math" alttext="\displaystyle f(W)=\tr\ab[W\ab(\hat{q}\sum_{\mu}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D})W^{\top}]-2\sum_{\mu}\ab(\sqrt{\hat{\chi}}\mathbf{\xi}^{\mu}+\hat{m}\mathbf{w}^{\mu})^{\top}W\mathbf{w}^{\mu}-2\sqrt{M_{0}}\sqrt{\hat{\bar{\chi}}}\tr\ab(W\Lambda^{\top})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mrow><msup><mi>𝐰</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>D</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>μ</mi></munder></mstyle><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mover accent="true"><mi>χ</mi><mo>^</mo></mover></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mi>μ</mi></msup></mrow><mo>+</mo><mrow><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>M</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Λ</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f(W)=\tr\ab[W\ab(\hat{q}\sum_{\mu}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D})W^{\top}]-2\sum_{\mu}\ab(\sqrt{\hat{\chi}}\mathbf{\xi}^{\mu}+\hat{m}\mathbf{w}^{\mu})^{\top}W\mathbf{w}^{\mu}-2\sqrt{M_{0}}\sqrt{\hat{\bar{\chi}}}\tr\ab(W\Lambda^{\top}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(163)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS5.p2" class="ltx_para ltx_noindent">
<p id="A5.SS5.p2.1" class="ltx_p">By extremizing the exponent of the integrand with respect to the order parameters, we obtain the saddle-point equations:</p>
<table id="A5.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E164.m1" class="ltx_Math" alttext="\displaystyle q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">\displaystyle q</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E164.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\ab[\frac{1}{D} \sum_{\mu=1}^{M_{0}}\ab(\hat{W}\mathbf{w}^{\mu})^{\top}\ab(\hat{W}\mathbf{w}^{\mu})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>W</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>W</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\ab[\frac{1}{D} \sum_{\mu=1}^{M_{0}}\ab(\hat{W}\mathbf{w}^{\mu})^{\top}\ab(\hat{W}\mathbf{w}^{\mu})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(164)</span></td></tr></tbody>
<tbody id="A5.E165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E165.m1" class="ltx_Math" alttext="\displaystyle\bar{q}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>q</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\displaystyle\bar{q}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E165.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\tr\ab({\hat{W}}^{\top}\hat{W})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>W</mi><mo>^</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>W</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\tr\ab({\hat{W}}^{\top}\hat{W})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(165)</span></td></tr></tbody>
<tbody id="A5.E166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E166.m1" class="ltx_Math" alttext="\displaystyle m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">\displaystyle m</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E166.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\ab[\frac{1}{D} \sum_{\mu=1}^{M_{0}}{\mathbf{w}^{\mu}}^{\top}\hat{W}\mathbf{w}^{\mu}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>W</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\ab[\frac{1}{D} \sum_{\mu=1}^{M_{0}}{\mathbf{w}^{\mu}}^{\top}\hat{W}\mathbf{w}^{\mu}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(166)</span></td></tr></tbody>
<tbody id="A5.E167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E167.m1" class="ltx_Math" alttext="\displaystyle\chi" display="inline" intent=":literal"><semantics><mi>χ</mi><annotation encoding="application/x-tex">\displaystyle\chi</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E167.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\ab[ \sum_{\mu=1}^{M_{0}} \ab({\mathbf{w}^{\mu}}^{\top}\ab(\hat{q}\sum_{\nu=1}^{M_{0}}\mathbf{w}^{\nu}{\mathbf{w}^{\nu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D})^{-1}\mathbf{w}^{\mu})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>ν</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><msup><mi>𝐰</mi><mi>ν</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>ν</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>D</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐰</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\ab[ \sum_{\mu=1}^{M_{0}} \ab({\mathbf{w}^{\mu}}^{\top}\ab(\hat{q}\sum_{\nu=1}^{M_{0}}\mathbf{w}^{\nu}{\mathbf{w}^{\nu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D})^{-1}\mathbf{w}^{\mu})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(167)</span></td></tr></tbody>
<tbody id="A5.E168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E168.m1" class="ltx_Math" alttext="\displaystyle\bar{\chi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\displaystyle\bar{\chi}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E168.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\tr\ab[\ab(\hat{q}\sum_{\mu=1}^{M_{0}}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D})^{-1}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>ξ</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><msup><mi>𝐰</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>D</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\mathbb{E}_{\mathbf{\xi},\Lambda}\tr\ab[\ab(\hat{q}\sum_{\mu=1}^{M_{0}}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}+(\lambda+\hat{\bar{q}})M_{0}I_{D})^{-1}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(168)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p2.2" class="ltx_p">Here, the optimal weight matrix <math id="A5.SS5.p2.m1" class="ltx_Math" alttext="\hat{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{W}</annotation></semantics></math> that minimizes the effective problem <math id="A5.SS5.p2.m2" class="ltx_Math" alttext="f(W)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(W)</annotation></semantics></math> is given by:</p>
<table id="A5.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E169.m1" class="ltx_Math" alttext="\displaystyle\hat{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\displaystyle\hat{W}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E169.m2" class="ltx_Math" alttext="\displaystyle=\argmin_{W}f(W)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mrow><msub><mo lspace="0.1389em" rspace="0.167em">argmin</mo><mi>W</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\argmin_{W}f(W)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(169)</span></td></tr></tbody>
<tbody id="A5.E170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E170.m1" class="ltx_Math" alttext="\displaystyle=\argmin_{W}\ab[\frac{\lambda+\hat{\bar{q}}}{2}\tr\ab(WW^{\top})+\frac{\hat{q}}{2}\tr\ab(WSW^{\top})-\tr\ab(\ab(\sqrt{\hat{\chi}}T+\sqrt{\hat{\bar{\chi}}}R+\hat{m}S)W^{\top})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><mrow><msub><mo lspace="0.1389em" rspace="0.167em">argmin</mo><mi>W</mi></msub><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mover accent="true"><mi>q</mi><mo>^</mo></mover><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mover accent="true"><mi>χ</mi><mo>^</mo></mover></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><msqrt><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\argmin_{W}\ab[\frac{\lambda+\hat{\bar{q}}}{2}\tr\ab(WW^{\top})+\frac{\hat{q}}{2}\tr\ab(WSW^{\top})-\tr\ab(\ab(\sqrt{\hat{\chi}}T+\sqrt{\hat{\bar{\chi}}}R+\hat{m}S)W^{\top})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(170)</span></td></tr></tbody>
<tbody id="A5.E171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E171.m1" class="ltx_Math" alttext="\displaystyle=\ab(\sqrt{\hat{\chi}}T+\sqrt{\hat{\bar{\chi}}}R+\hat{m}S) \ab(\hat{q}S+\ab(\lambda+\hat{\bar{q}})I_{D})^{-1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mover accent="true"><mi>χ</mi><mo>^</mo></mover></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><msqrt><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mover accent="true"><mi>m</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>+</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>D</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\ab(\sqrt{\hat{\chi}}T+\sqrt{\hat{\bar{\chi}}}R+\hat{m}S) \ab(\hat{q}S+\ab(\lambda+\hat{\bar{q}})I_{D})^{-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(171)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p2.3" class="ltx_p">where we have defined the following matrices:</p>
<table id="A5.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E172.m1" class="ltx_Math" alttext="\displaystyle T=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\mathbf{\xi}^{\mu}{\mathbf{w}^{\mu}}^{\top},\quad R=\ab(R_{ij})_{i,j=1}^{D}\sim\mathcal{N}\ab(0,\frac{1}{M_{0}}),\quad S=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}, " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><msup><mi>ξ</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>R</mi><mo>=</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>D</mi></msubsup></mrow><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>S</mi><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>μ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>M</mi><mn>0</mn></msub></munderover></mstyle><mrow><msup><mi>𝐰</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐰</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\mathbf{\xi}^{\mu}{\mathbf{w}^{\mu}}^{\top},\quad R=\ab(R_{ij})_{i,j=1}^{D}\sim\mathcal{N}\ab(0,\frac{1}{M_{0}}),\quad S=\frac{1}{M_{0}}\sum_{\mu=1}^{M_{0}}\mathbf{w}^{\mu}{\mathbf{w}^{\mu}}^{\top}, </annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(172)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS5.p3" class="ltx_para ltx_noindent">
<p id="A5.SS5.p3.1" class="ltx_p">The crucial insight from Eq. (<a href="#A5.E162" title="In E.5 Statistics of the solution 𝑊^∗ (derivation of the Result. ) ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">162</span></a>) is that the expression for <math id="A5.SS5.p3.m1" class="ltx_Math" alttext="G_{S}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>S</mi></msub><annotation encoding="application/x-tex">G_{S}</annotation></semantics></math> completely decouples over the replica indices <math id="A5.SS5.p3.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.
This implies that the joint probability distribution for the <math id="A5.SS5.p3.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-replica system factorizes into a product of identical and independent distributions for each replica <math id="A5.SS5.p3.m4" class="ltx_Math" alttext="W^{a}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mi>a</mi></msup><annotation encoding="application/x-tex">W^{a}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS5.p4" class="ltx_para ltx_noindent">
<p id="A5.SS5.p4.1" class="ltx_p">Our original goal is to compute the moments of a statistic <math id="A5.SS5.p4.m1" class="ltx_Math" alttext="g(W^{*})" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(W^{*})</annotation></semantics></math>, where <math id="A5.SS5.p4.m2" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math> is the solution to the original optimization problem.
Within the replica framework, as seen in Section <a href="#A5.SS2" title="E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>, the <math id="A5.SS5.p4.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-th moment <math id="A5.SS5.p4.m4" class="ltx_Math" alttext="\mathbb{E}_{\mathcal{D}}[g(W^{*})^{p}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{D}}[g(W^{*})^{p}]</annotation></semantics></math> corresponds to the expectation of a <math id="A5.SS5.p4.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-body correlation, <math id="A5.SS5.p4.m6" class="ltx_math_unparsed" alttext="\mathbb{E}[g(W^{1})g(W^{2})\cdots g(W^{p})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>p</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[g(W^{1})g(W^{2})\cdots g(W^{p})]</annotation></semantics></math>, in the <math id="A5.SS5.p4.m7" class="ltx_Math" alttext="n\to 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\to 0</annotation></semantics></math> limit.
Due to the factorization, this simplifies significantly:</p>
<table id="A5.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E173"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E173.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathcal{D}}\left[g(W^{*})^{p}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathcal{D}}\left[g(W^{*})^{p}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E173.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\{W^{a}\}}\left[g(W^{1})g(W^{2})\cdots g(W^{p})\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mo stretchy="false">{</mo><msup><mi>W</mi><mi>a</mi></msup><mo stretchy="false">}</mo></mrow></msub><mrow><mo>[</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>p</mi></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\{W^{a}\}}\left[g(W^{1})g(W^{2})\cdots g(W^{p})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(173)</span></td></tr></tbody>
<tbody id="A5.E174"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E174.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\int\mathrm{D}\mathbf{\xi}\mathrm{D}\Lambda\,\left[\lim_{\beta\to\infty}\frac{\int\mathop{}\!\mathrm{d}W\,g(W)\exp\left[-\frac{\beta}{2}f(W)\right]}{\int\mathop{}\!\mathrm{d}W\,\exp\left[-\frac{\beta}{2}f(W)\right]}\right]^{p}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>β</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mrow><mrow><mo>∫</mo><mphantom></mphantom></mrow><mo>⁡</mo><mrow><mo rspace="0em">𝑑</mo><mi>W</mi></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>exp</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mfrac><mi>β</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mrow><mrow><mo>∫</mo><mphantom></mphantom></mrow><mo>⁡</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mfrac><mi>β</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mfrac></mrow><mo>]</mo></mrow><mi>p</mi></msup></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{W}_{0}}\int\mathrm{D}\mathbf{\xi}\mathrm{D}\Lambda\,\left[\lim_{\beta\to\infty}\frac{\int\mathop{}\!\mathrm{d}W\,g(W)\exp\left[-\frac{\beta}{2}f(W)\right]}{\int\mathop{}\!\mathrm{d}W\,\exp\left[-\frac{\beta}{2}f(W)\right]}\right]^{p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(174)</span></td></tr></tbody>
<tbody id="A5.E175"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E175.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{W}_{0},\mathbf{\xi},\Lambda}\left[g(\hat{W})^{p}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒲</mi><mn>0</mn></msub><mo>,</mo><mi>ξ</mi><mo>,</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>W</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mi>p</mi></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{W}_{0},\mathbf{\xi},\Lambda}\left[g(\hat{W})^{p}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(175)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p4.2" class="ltx_p">We now invoke our technical assumption, Assumption <a href="#A5.Thmtheorem5" title="Assumption E.5 (Identifiability from Moments of a Scalar Statistic). ‣ E.2 Replica System and Replicated Partition Function ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.5</span></a>, which posits that if the moments of a scalar statistic of two random matrices are identical, then the matrices themselves are identically distributed. This directly leads to our main result:</p>
<table id="A5.E176" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E176.m1" class="ltx_Math" alttext="W^{*}\overset{\mathsf{d}}{=}\hat{W}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>W</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>=</mo><mo mathsize="0.700em">𝖽</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>W</mi><mo>^</mo></mover></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W^{*}\overset{\mathsf{d}}{=}\hat{W}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(176)</span></td></tr></tbody>
</table>
<p id="A5.SS5.p4.3" class="ltx_p">This establishes that the solution to the original, complex optimization problem, <math id="A5.SS5.p4.m8" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>, is distributionally equivalent to <math id="A5.SS5.p4.m9" class="ltx_Math" alttext="\hat{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{W}</annotation></semantics></math>, the solution of the much simpler effective quadratic problem defined by <math id="A5.SS5.p4.m10" class="ltx_Math" alttext="f(W)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(W)</annotation></semantics></math>.
This completes the derivation of Result <a href="#A5.Thmtheorem1" title="Result E.1. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>.</p>
</div>
<section id="A5.SS5.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">E.5.1 </span>Interpretation of the Auxiliary Fields</h4>

<div id="A5.SS5.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS5.SSS1.p1.1" class="ltx_p">It is instructive to provide a physical interpretation of the auxiliary fields, <math id="A5.SS5.SSS1.p1.m1" class="ltx_Math" alttext="\mathbf{\xi}" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\mathbf{\xi}</annotation></semantics></math> and <math id="A5.SS5.SSS1.p1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> in Eq. (<a href="#A5.E162" title="In E.5 Statistics of the solution 𝑊^∗ (derivation of the Result. ) ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">162</span></a>).
The Hubbard-Stratonovich transformation replaced the difficult average over the data distribution with an average over simpler,
data-independent Gaussian fields <math id="A5.SS5.SSS1.p1.m3" class="ltx_Math" alttext="\mathbf{\xi}" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\mathbf{\xi}</annotation></semantics></math> and <math id="A5.SS5.SSS1.p1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>.
Eq. (<a href="#A5.E175" title="In E.5 Statistics of the solution 𝑊^∗ (derivation of the Result. ) ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">175</span></a>) shows that the auxiliary field <math id="A5.SS5.SSS1.p1.m5" class="ltx_Math" alttext="\mathbf{\xi}" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\mathbf{\xi}</annotation></semantics></math> and <math id="A5.SS5.SSS1.p1.m6" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> can be interpreted as an effective random field that embodies the statistical fluctuations of the training data.
The solution <math id="A5.SS5.SSS1.p1.m7" class="ltx_Math" alttext="\hat{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{W}</annotation></semantics></math> is then understood as the optimal response to a particular realization of these effective data fluctuations.</p>
</div>
</section>
</section>
<section id="A5.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.6 </span>Simplified Expressions for the Saddle-Point Equations (derivation of the Result. <a href="#A5.Thmtheorem2" title="Result E.2. ‣ E.1 Results with Complete Statements ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>)</h3>

<div id="A5.SS6.p1" class="ltx_para ltx_noindent">
<p id="A5.SS6.p1.1" class="ltx_p">In this subsection, we derive a set of equations that determine the order parameters and their conjugate variables.
By simplifying the saddle-point equations under the RS assumption, we obtain expressions suitable for numerical computation.</p>
</div>
<section id="A5.SS6.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">E.6.1 </span>Order Parameters</h4>

<div id="A5.SS6.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS6.SSS1.p1.1" class="ltx_p">Next, we derive the simplified expressions for the saddle-point equations in Eqs. (<a href="#A5.E164" title="In E.5 Statistics of the solution 𝑊^∗ (derivation of the Result. ) ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">164</span></a>)-(<a href="#A5.E168" title="In E.5 Statistics of the solution 𝑊^∗ (derivation of the Result. ) ‣ Appendix E Replica Calculation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">168</span></a>).
First, we define <math id="A5.SS6.SSS1.p1.m1" class="ltx_Math" alttext="\mathcal{M}=\hat{q}S+(\lambda+\hat{\bar{q}})I_{D}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>=</mo><mrow><mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>+</mo><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>D</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}=\hat{q}S+(\lambda+\hat{\bar{q}})I_{D}</annotation></semantics></math>.
Noting that <math id="A5.SS6.SSS1.p1.m2" class="ltx_Math" alttext="\mathcal{M}^{-1}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathcal{M}^{-1}</annotation></semantics></math> is commuting with <math id="A5.SS6.SSS1.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, <math id="A5.SS6.SSS1.p1.m4" class="ltx_Math" alttext="T^{\top}T=D/M_{0}S" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>T</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>=</mo><mrow><mrow><mi>D</mi><mo>/</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">T^{\top}T=D/M_{0}S</annotation></semantics></math>, <math id="A5.SS6.SSS1.p1.m5" class="ltx_Math" alttext="AA^{\top}S=S" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>=</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">AA^{\top}S=S</annotation></semantics></math>, and Lemma <a href="#A4.Thmtheorem3" title="Proposition D.3. ‣ D.3 Explicit Expressions for Matrix Moments ‣ Appendix D Preliminary Lemmas in Random Matrix Theory" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a>,
we have the following relations:</p>
</div>
<div id="A5.SS6.SSS1.p2" class="ltx_para ltx_noindent">
<table id="A5.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E177"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E177.m1" class="ltx_Math" alttext="\displaystyle q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">\displaystyle q</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E177.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\mathbb{E}\ab[\tr\ab(S{W^{*}}^{\top}W^{*})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>W</mi><mrow></mrow><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\mathbb{E}\ab[\tr\ab(S{W^{*}}^{\top}W^{*})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(177)</span></td></tr></tbody>
<tbody id="A5.E178"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E178.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\mathbb{E}\ab[\tr\ab(\hat{\chi}S\mathcal{M}^{-1}T^{\top}T\mathcal{M}^{-1}+\hat{\bar{\chi}}S\mathcal{M}^{-1}R^{\top}R\mathcal{M}^{-1}+\hat{m}^{2}S\mathcal{M}^{-1}S^{2}\mathcal{M}^{-1})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi>χ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mrow><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo><mrow><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\mathbb{E}\ab[\tr\ab(\hat{\chi}S\mathcal{M}^{-1}T^{\top}T\mathcal{M}^{-1}+\hat{\bar{\chi}}S\mathcal{M}^{-1}R^{\top}R\mathcal{M}^{-1}+\hat{m}^{2}S\mathcal{M}^{-1}S^{2}\mathcal{M}^{-1})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(178)</span></td></tr></tbody>
<tbody id="A5.E179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E179.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{M_{0}}\ab[\hat{\chi}\mathbb{E}\ab[\tr\ab(S^{2}\mathcal{M}^{-2})]+\hat{\bar{\chi}}\mathbb{E}\ab[\tr\ab(S\mathcal{M}^{-2})]+\kappa\hat{m}^{2}\mathbb{E}\ab[\tr\ab(S^{3}\mathcal{M}^{-2})]]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>M</mi><mn>0</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mover accent="true"><mi>χ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{M_{0}}\ab[\hat{\chi}\mathbb{E}\ab[\tr\ab(S^{2}\mathcal{M}^{-2})]+\hat{\bar{\chi}}\mathbb{E}\ab[\tr\ab(S\mathcal{M}^{-2})]+\kappa\hat{m}^{2}\mathbb{E}\ab[\tr\ab(S^{3}\mathcal{M}^{-2})]]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(179)</span></td></tr></tbody>
<tbody id="A5.E180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E180.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\kappa\hat{q}^{2}}\ab[\hat{\chi}\ab(1+2zg_{S}(z)+z^{2}g_{S}^{\prime}(z))+\hat{\bar{\chi}}\ab(g_{S}(z)+zg_{S}^{\prime}(z))+\kappa\hat{m}^{2}\ab(1+2z+3z^{2}g_{S}(z)+z^{3}g_{S}^{\prime}(z))] " display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mover accent="true"><mi>χ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>S</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mover accent="true"><mover accent="true"><mi>χ</mi><mo>¯</mo></mover><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>g</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>S</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>m</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mi>S</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\kappa\hat{q}^{2}}\ab[\hat{\chi}\ab(1+2zg_{S}(z)+z^{2}g_{S}^{\prime}(z))+\hat{\bar{\chi}}\ab(g_{S}(z)+zg_{S}^{\prime}(z))+\kappa\hat{m}^{2}\ab(1+2z+3z^{2}g_{S}(z)+z^{3}g_{S}^{\prime}(z))] </annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(180)</span></td></tr></tbody>
</table>
<table id="A5.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E181"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E181.m1" class="ltx_Math" alttext="\displaystyle\bar{q}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>q</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\displaystyle\bar{q}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E181.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\mathbb{E}\ab[\tr\ab({W^{*}}^{\top}W^{*})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mmultiscripts><mi>W</mi><mrow></mrow><mo>∗</mo><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\mathbb{E}\ab[\tr\ab({W^{*}}^{\top}W^{*})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(181)</span></td></tr></tbody>
<tbody id="A5.E182"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
