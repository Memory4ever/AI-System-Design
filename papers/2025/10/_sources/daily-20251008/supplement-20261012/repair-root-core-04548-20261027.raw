<p id="A5.Thmtheorem2.p1.2" class="ltx_p"><span id="A5.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A5.Thmtheorem2.p1.m4" class="ltx_Math" alttext="z=-\frac{\hat{\bar{q}}+\lambda}{\hat{q}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>−</mo><mfrac><mrow><mover accent="true"><mover accent="true"><mi>q</mi><mo>¯</mo></mover><mo>^</mo></mover><mo>+</mo><mi>λ</mi></mrow><mover accent="true"><mi>q</mi><mo>^</mo></mover></mfrac></mrow></mrow><annotation encoding="application/x-tex">z=-\frac{\hat{\bar{q}}+\lambda}{\hat{q}}</annotation></semantics></math> and</span></p>
