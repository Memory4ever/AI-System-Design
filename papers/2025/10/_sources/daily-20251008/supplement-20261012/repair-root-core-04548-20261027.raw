<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E111.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sigma^{2}}{1+\sigma^{2}}\frac{1-\min\ab(\kappa,\rho)}{\kappa\gamma-1}\alpha+\min(\kappa,\rho)\ab[1+\frac{1-\min\ab(\kappa,\rho)}{\kappa\gamma-1}]+\mathcal{O}\ab(\frac{1}{\alpha})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>+</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</