</span></td></tr>
<tr id="A1.T1.2.36" class="ltx_tr">
<td id="A1.T1.2.36.1" class="ltx_td ltx_align_left"><math id="A1.T1.m41" class="ltx_Math" alttext="\rho=r/D" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mrow><mi>r</mi><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\rho=r/D</annotation></semantics></math></td>
<td id="A1.T1.2.36.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="A1.T1.2.36.2.1" class="ltx_inline-block ltx_align_top" style="width:341.5pt;">
<span id="A1.T1.2.36.2.1.1" class="ltx_p">Task subspace dimensionality.</span>
</span></td></tr>
<tr id="A1.T1.2.37" class="ltx_tr">
<td id="A1.T1.2.37.1" class="ltx_td ltx_align_left"><math id="A1.T1.m42" class="ltx_Math" alttext="\kappa=M_{0}/D" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>=</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\kappa=M_{0}/D</annotation></semantics></math></td>
<td id="A1.T1.2.37.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="A1.T1.2.37.2.1" class="ltx_inline-block ltx_align_top" style="width:341.5pt;">
<span id="A1.T1.2.37.2.1.1" class="ltx_p">Task diversity.</span>
</span></td></tr>
<tr id="A1.T1.2.38" class="ltx_tr">
<td id="A1.T1.2.38.1" class="ltx_td ltx_align_left ltx_border_bb"><math id="A1.T1.m43" class="ltx_Math" alttext="\gamma=M/(DM_{0})" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mi>M</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=M/(DM_{0})</annotation></semantics></math></td>
<td id="A1.T1.2.38.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_bb">
<span id="A1.T1.2.38.2.1" class="ltx_inline-block ltx_align_top" style="width:341.5pt;">
<span id="A1.T1.2.38.2.1.1" class="ltx_p">Training data density.</span>
</span></td></tr>
</tbody>
</table>
</figure>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Justification of Equivalence of the Linear Attention Model to a Linear Neural Network</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">In this section, we demonstrate that the single-layer linear attention model employed in our study can be mapped to an equivalent single-layer linear neural network.
This equivalence provides a tractable framework for our theoretical analysis.</p>
</div>
<div id="A2.p2" class="ltx_para ltx_noindent">
<p id="A2.p2.1" class="ltx_p">First, from the definition of the attention function <math id="A2.p2.m1" class="ltx_Math" alttext="\mathsf{Atten}_{\Theta}" display="inline" intent=":literal"><semantics><msub><mi>𝖠𝗍𝗍𝖾𝗇</mi><mi mathvariant="normal">Θ</mi></msub><annotation encoding="application/x-tex">\mathsf{Atten}_{\Theta}</annotation></semantics></math>, we have:</p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E23.m1" class="ltx_Math" alttext="\displaystyle\mathsf{Atten}_{\Theta}(C)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖠𝗍𝗍𝖾𝗇</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{Atten}_{\Theta}(C)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E23.m2" class="ltx_Math" alttext="\displaystyle=C+\frac{1}{L}VC(KC)^{\top}(QC)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C+\frac{1}{L}VC(KC)^{\top}(QC)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A2.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24.m1" class="ltx_Math" alttext="\displaystyle=C+\frac{1}{L}VCC^{\top}(K^{\top}Q)C" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=C+\frac{1}{L}VCC^{\top}(K^{\top}Q)C</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A2.p2.2" class="ltx_p">The dependency on the key and query matrices, <math id="A2.p2.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and <math id="A2.p2.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, occurs only through the product <math id="A2.p2.m4" class="ltx_Math" alttext="K^{\top}Q" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">K^{\top}Q</annotation></semantics></math>. We can therefore simplify the parameterization by defining a single matrix <math id="A2.p2.m5" class="ltx_Math" alttext="R=K^{\top}Q\in\mathbb{R}^{(D+1)\times(D+1)}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><msup><mi>K</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">R=K^{\top}Q\in\mathbb{R}^{(D+1)\times(D+1)}</annotation></semantics></math>.</p>
</div>
<div id="A2.p3" class="ltx_para ltx_noindent">
<p id="A2.p3.1" class="ltx_p">To analyze the interaction between features and labels, we partition the parameter matrices <math id="A2.p3.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> and <math id="A2.p3.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> into blocks corresponding to the feature dimensions (<math id="A2.p3.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>) and the label dimension (1):</p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E25.m1" class="ltx_Math" alttext="\displaystyle R=\pmqty{\lx@physics@matrix\endlx@physics@matrix},\quad V=\pmqty{\lx@physics@matrix\endlx@physics@matrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo>=</mo><mrow><mo>(</mo><mphantom></mphantom><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>V</mi><mo>=</mo><mrow><mo>(</mo><mphantom></mphantom><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle R=\pmqty{\lx@physics@matrix\endlx@physics@matrix},\quad V=\pmqty{\lx@physics@matrix\endlx@physics@matrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A2.p3.2" class="ltx_p">where <math id="A2.p3.m4" class="ltx_Math" alttext="R_{11},V_{11}\in\mathbb{R}^{D\times D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>11</mn></msub><mo>,</mo><mrow><msub><mi>V</mi><mn>11</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">R_{11},V_{11}\in\mathbb{R}^{D\times D}</annotation></semantics></math>, <math id="A2.p3.m5" class="ltx_Math" alttext="\mathbf{r}_{12},\mathbf{v}_{12},\mathbf{r}_{21},\mathbf{v}_{21}\in\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐫</mi><mn>12</mn></msub><mo>,</mo><msub><mi>𝐯</mi><mn>12</mn></msub><mo>,</mo><msub><mi>𝐫</mi><mn>21</mn></msub><mo>,</mo><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{r}_{12},\mathbf{v}_{12},\mathbf{r}_{21},\mathbf{v}_{21}\in\mathbb{R}^{D}</annotation></semantics></math> and <math id="A2.p3.m6" class="ltx_Math" alttext="r_{22},v_{22}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>22</mn></msub><mo>,</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo>∈</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">r_{22},v_{22}\in\mathbb{R}</annotation></semantics></math>.</p>
</div>
<div id="A2.p4" class="ltx_para ltx_noindent">
<p id="A2.p4.1" class="ltx_p">In this notation, a direct calculation of the model’s prediction, which is the scalar value at the query position <math id="A2.p4.m1" class="ltx_Math" alttext="\{\dots\}_{D+1,L+1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">…</mi><mo stretchy="false">}</mo></mrow><mrow><mrow><mi>D</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\{\dots\}_{D+1,L+1}</annotation></semantics></math>, yields:</p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E26.m1" class="ltx_Math" alttext="\displaystyle\mathsf{Read}\ab(\mathsf{Atten}_{\Theta}(C^{\mu}))" display="inline" intent=":literal"><semantics><mrow><mi>𝖱𝖾𝖺𝖽</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝖠𝗍𝗍𝖾𝗇</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{Read}\ab(\mathsf{Atten}_{\Theta}(C^{\mu}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E26.m2" class="ltx_Math" alttext="\displaystyle=\ab\{C^{\mu}+\frac{1}{L}VC^{\mu}{C^{\mu}}^{\top}RC^{\mu}\}_{D+1,L+1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>C</mi><mi>μ</mi></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>C</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>μ</mi></msup></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mrow><mi>D</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\ab\{C^{\mu}+\frac{1}{L}VC^{\mu}{C^{\mu}}^{\top}RC^{\mu}\}_{D+1,L+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
<tbody id="A2.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E27.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{L}\ab(\mathbf{v}_{21}^{\top}X^{\mu}{X^{\mu}}^{\top}R_{11}+v_{22}{\mathbf{y}^{\mu}}^{\top}{X^{\mu}}^{\top}R_{11}+\mathbf{v}_{21}^{\top}{X^{\mu}}^{\top}\mathbf{y}^{\mu}\mathbf{r}_{21}+\mathbf{r}_{21}{\mathbf{y}^{\mu}}^{\top}\mathbf{y}^{\mu})\mathbf{x}_{L+1}^{\mu}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>X</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐲</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>X</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>𝐯</mi><mn>21</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>X</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐲</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐫</mi><mn>21</mn></msub></mrow><mo>+</mo><mrow><msub><mi>𝐫</mi><mn>21</mn></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐲</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐲</mi><mi>μ</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{L}\ab(\mathbf{v}_{21}^{\top}X^{\mu}{X^{\mu}}^{\top}R_{11}+v_{22}{\mathbf{y}^{\mu}}^{\top}{X^{\mu}}^{\top}R_{11}+\mathbf{v}_{21}^{\top}{X^{\mu}}^{\top}\mathbf{y}^{\mu}\mathbf{r}_{21}+\mathbf{r}_{21}{\mathbf{y}^{\mu}}^{\top}\mathbf{y}^{\mu})\mathbf{x}_{L+1}^{\mu},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A2.p4.2" class="ltx_p">where <math id="A2.p4.m2" class="ltx_Math" alttext="X^{\mu}=\pmqty{\lx@physics@matrix\endlx@physics@matrix}\in\mathbb{R}^{D\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mi>μ</mi></msup><mo>=</mo><mrow><mo>(</mo><mphantom></mphantom><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X^{\mu}=\pmqty{\lx@physics@matrix\endlx@physics@matrix}\in\mathbb{R}^{D\times L}</annotation></semantics></math> and <math id="A2.p4.m3" class="ltx_Math" alttext="\mathbf{y}^{\mu}=\pmqty{\lx@physics@matrix\endlx@physics@matrix}^{\top}\in\mathbb{R}^{L+1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐲</mi><mi>μ</mi></msup><mo>=</mo><msup><mrow><mo>(</mo><mphantom></mphantom><mo>)</mo></mrow><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{y}^{\mu}=\pmqty{\lx@physics@matrix\endlx@physics@matrix}^{\top}\in\mathbb{R}^{L+1}</annotation></semantics></math>.</p>
</div>
<div id="A2.p5" class="ltx_para ltx_noindent">
<p id="A2.p5.1" class="ltx_p">To make the model analytically tractable, we follow recent works <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Wu et al., 2024</a>, <a href="#bib.bibx10" title="" class="ltx_ref">Frei and Vardi, 2025</a>, <a href="#bib.bibx29" title="" class="ltx_ref">Zhang et al., 2025</a>]</cite> and introduce a key simplification by setting the off-diagonal block matrices to zero: <math id="A2.p5.m1" class="ltx_Math" alttext="\mathbf{v}_{21}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐯</mi><mn>21</mn></msub><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\mathbf{v}_{21}=\mathbf{0}</annotation></semantics></math> and <math id="A2.p5.m2" class="ltx_Math" alttext="\mathbf{r}_{21}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐫</mi><mn>21</mn></msub><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\mathbf{r}_{21}=\mathbf{0}</annotation></semantics></math>.
This simplification is well-founded, as it has been shown that for networks initialized with these parameters at zero, they remain zero throughout training under gradient flow dynamics <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">Zhang et al., 2025</a>]</cite>.
While this reduces complexity, the resulting architecture is still sufficiently rich to exhibit nontrivial in-context learning phenomena.</p>
</div>
<div id="A2.p6" class="ltx_para ltx_noindent">
<p id="A2.p6.1" class="ltx_p">Under this assumption, the prediction formula simplifies dramatically. By defining an effective weight matrix <math id="A2.p6.m1" class="ltx_Math" alttext="W=\ab(v_{22}R_{11})^{\top}\in\mathbb{R}^{D\times D}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>11</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W=\ab(v_{22}R_{11})^{\top}\in\mathbb{R}^{D\times D}</annotation></semantics></math>, the model’s output becomes:</p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_Math" alttext="\mathsf{Read}\ab(\mathsf{Atten}_{\Theta}(C^{\mu}))=\frac{1}{L}v_{22}{\mathbf{y}^{\mu}}^{\top}{X^{\mu}}^{\top}R_{11}\mathbf{x}_{L+1}^{\mu}=\tr\ab(W{H^{\mu}}^{\top})" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝖱𝖾𝖺𝖽</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝖠𝗍𝗍𝖾𝗇</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>L</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>22</mn></msub><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>𝐲</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>X</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup></mrow><mo>=</mo><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>H</mi><mrow></mrow><mi>μ</mi><mrow></mrow><mo>⊤</mo></mmultiscripts></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{Read}\ab(\mathsf{Atten}_{\Theta}(C^{\mu}))=\frac{1}{L}v_{22}{\mathbf{y}^{\mu}}^{\top}{X^{\mu}}^{\top}R_{11}\mathbf{x}_{L+1}^{\mu}=\tr\ab(W{H^{\mu}}^{\top})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A2.p6.2" class="ltx_p">This final expression demonstrates that the attention model’s output is equivalent to that of a single-layer linear neural network.
This equivalent network maps an effective feature matrix <math id="A2.p6.m2" class="ltx_Math" alttext="H^{\mu}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mi>μ</mi></msup><annotation encoding="application/x-tex">H^{\mu}</annotation></semantics></math> to a scalar prediction via the trace operator,
corresponding to a mapping from <math id="A2.p6.m3" class="ltx_Math" alttext="\mathbb{R}^{D\times D}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\mathbb{R}^{D\times D}\to\mathbb{R}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Justification of Equivalence of the Linear Attention Model to a Many-Teacher-Student Model</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">To enable a tractable high-dimensional analysis using the replica method, we map our ICL model to an equivalent teacher-student framework with multiple teachers. This reformulation is not only a crucial technical step, but it also provides a clear interpretation of the pre-training phase. Furthermore, we believe this analytical strategy can serve as a valuable starting point for studying a broader class of similar ICL models. The core of this equivalence is the following statement:</p>
</div>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_statement">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Statement C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The macroscopic statistical quantities of the learning process based on Eq. (<a href="#S2.E8" title="In 2.4 Attention Architecture ‣ 2 Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) remain unchanged if the true training labels <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="y^{\mu}_{L+1}" display="inline" intent=":literal"><semantics><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><annotation encoding="application/x-tex">y^{\mu}_{L+1}</annotation></semantics></math> are replaced by the outputs of a task-specific teacher model. The teacher for task <math id="A3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> is defined by the weight matrix <math id="A3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="W_{\mathsf{teacher}}^{\mu}=\mathbf{w}^{\mu}(\mathbf{w}^{\mu})^{\top}/D" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mi>𝗍𝖾𝖺𝖼𝗁𝖾𝗋</mi><mi>μ</mi></msubsup><mo>=</mo><mrow><mrow><msup><mi>𝐰</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">W_{\mathsf{teacher}}^{\mu}=\mathbf{w}^{\mu}(\mathbf{w}^{\mu})^{\top}/D</annotation></semantics></math>, leading to the substitution:</span></p>
<table id="A3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E29.m1" class="ltx_Math" alttext="y^{\mu}_{L+1}\to\tr\ab(W_{\mathsf{teacher}}^{\mu}H^{\mu})+\epsilon^{\mu}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo stretchy="false">→</mo><mrow><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>W</mi><mi>𝗍𝖾𝖺𝖼𝗁𝖾𝗋</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>ϵ</mi><mi>μ</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y^{\mu}_{L+1}\to\tr\ab(W_{\mathsf{teacher}}^{\mu}H^{\mu})+\epsilon^{\mu}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p">For the justification of Statement <a href="#A3.Thmtheorem1" title="Statement C.1. ‣ Appendix C Justification of Equivalence of the Linear Attention Model to a Many-Teacher-Student Model" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> and a discussion about its relevance to the traditional teacher-student model, see the following subsections.</p>
</div>
<div id="A3.p3" class="ltx_para ltx_noindent">
<p id="A3.p3.1" class="ltx_p">This equivalence is based on an analogous to the Gaussian Equivalence Theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx14" title="" class="ltx_ref">Mei and Montanari, 2022</a>]</cite>, as the first two moments of the true labels and the teacher’s outputs are identical, while higher-order correlations become negligible in the high-dimensional limit.</p>
</div>
<div id="A3.p4" class="ltx_para ltx_noindent">
<p id="A3.p4.1" class="ltx_p">The student model in our framework is not merely memorizing the solutions to specific tasks. Because it learns from an ensemble of <math id="A3.p4.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> different teachers, one for each training instance, it is forced to distill the underlying, universal problem-solving algorithm common to all of them.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Justification of Equivalence of the Linear Attention Model to a Many-Teacher-Student Model</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">In this subsection, we will justify the equivalence to a many-teacher-student model, by checking the consistency of the first and second-order statistics.
Specifically, we will show the following lemma:</p>
</div>
<div id="A3.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma C.2</span></span><span id="A3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem2.p1" class="ltx_para">
<p id="A3.Thmtheorem2.p1.1" class="ltx_p"><span id="A3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="W_{\mathsf{teacher}}^{\mu}=\mathbf{w}^{\mu}(\mathbf{w}^{\mu})^{\top}/D" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mi>𝗍𝖾𝖺𝖼𝗁𝖾𝗋</mi><mi>μ</mi></msubsup><mo>=</mo><mrow><mrow><msup><mi>𝐰</mi><mi>μ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐰</mi><mi>μ</mi></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>/</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">W_{\mathsf{teacher}}^{\mu}=\mathbf{w}^{\mu}(\mathbf{w}^{\mu})^{\top}/D</annotation></semantics></math> be the weight matrix of a task-specific teacher model,
and <math id="A3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\bar{y}^{\mu}_{L+1}=\tr\ab(W_{\mathsf{teacher}}^{\mu}H^{\mu})+\epsilon^{\mu}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo>=</mo><mrow><mrow><mrow><mi>tr</mi><mo lspace="0.167em">⁡</mo><mtext class="undefined">\ab</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>W</mi><mi>𝗍𝖾𝖺𝖼𝗁𝖾𝗋</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mi>μ</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>ϵ</mi><mi>μ</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\bar{y}^{\mu}_{L+1}=\tr\ab(W_{\mathsf{teacher}}^{\mu}H^{\mu})+\epsilon^{\mu}</annotation></semantics></math> be the output of a task-specific teacher model.
Then, for the fixed <math id="A3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\mathcal{W}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒲</mi><annotation encoding="application/x-tex">\mathcal{W}</annotation></semantics></math>, the first and second-order statistics of the teacher model are consistent with the ICL model, i.e.,</span></p>
<table id="A3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E30.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E30.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\ab[{y}^{\mu}_{L+1}]=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\ab[{y}^{\mu}_{L+1}]=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
<tbody id="A3.E31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E31.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}\bar{y}^{\nu}_{L+1}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}\bar{y}^{\nu}_{L+1}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E31.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\ab[{y}^{\mu}_{L+1}{y}^{\nu}_{L+1}]=\delta_{\mu\nu}\ab(1+\sigma^{2})+\mathcal{O}\ab(\frac{1}{D})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\ab[{y}^{\mu}_{L+1}{y}^{\nu}_{L+1}]=\delta_{\mu\nu}\ab(1+\sigma^{2})+\mathcal{O}\ab(\frac{1}{D})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
<tbody id="A3.E32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E32.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}H^{\nu}_{ij}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}H^{\nu}_{ij}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E32.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\ab[{y}^{\mu}_{L+1}H^{\nu}_{ij}]=\frac{1}{D}\delta_{\mu\nu}w_{i}^{\mu}w_{j}^{\mu}+\mathcal{O}\ab(\frac{1}{D^{2}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>i</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>j</mi><mi>μ</mi></msubsup></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>D</mi><mn>2</mn></msup></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\ab[{y}^{\mu}_{L+1}H^{\nu}_{ij}]=\frac{1}{D}\delta_{\mu\nu}w_{i}^{\mu}w_{j}^{\mu}+\mathcal{O}\ab(\frac{1}{D^{2}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text">Due to <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="H^{\mu}_{ij}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{\mu}_{ij}=0</annotation></semantics></math>, we have <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}]=\mathbb{E}\ab[{y}^{\mu}_{L+1}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mover accent="true"><mi>y</mi><mo>¯</mo></mover><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}\ab[\bar{y}^{\mu}_{L+1}]=\mathbb{E}\ab[{y}^{\mu}_{L+1}]=0</annotation></semantics></math>.
Also, straightforwardly we have <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="\mathbb{E}\ab[y^{\mu}_{L+1}y^{\nu}_{L+1}]=\delta_{\mu\nu}\ab(1+\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\ab[y^{\mu}_{L+1}y^{\nu}_{L+1}]=\delta_{\mu\nu}\ab(1+\sigma^{2})</annotation></semantics></math> and</span></p>
<table id="A3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E33.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\ab[H_{ij}^{\mu}y_{L+1}^{\nu}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\ab[H_{ij}^{\mu}y_{L+1}^{\nu}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E33.m2" class="ltx_Math" alttext="\displaystyle=\frac{D}{L}\delta_{\mu\nu}x_{L+1,i}^{\mu}\ab(\sum_{l=1}^{L}y_{l}^{\mu}x_{l,j}^{\mu})\ab(\sum_{k=1}^{D}w_{k}^{\mu}x_{l,k}^{\mu}+\epsilon_{l}^{\mu})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>D</mi><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><msubsup><mi>y</mi><mi>l</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>μ</mi></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><msubsup><mi>w</mi><mi>k</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>k</mi></mrow><mi>μ</mi></msubsup></mrow></mrow><mo>+</mo><msubsup><mi>ϵ</mi><mi>l</mi><mi>μ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{D}{L}\delta_{\mu\nu}x_{L+1,i}^{\mu}\ab(\sum_{l=1}^{L}y_{l}^{\mu}x_{l,j}^{\mu})\ab(\sum_{k=1}^{D}w_{k}^{\mu}x_{l,k}^{\mu}+\epsilon_{l}^{\mu})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
<tbody id="A3.E34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34.m1" class="ltx_Math" alttext="\displaystyle=\frac{D}{L}\delta_{\mu\nu}\sum_{k,k^{\prime}}w^{\mu}_{k}w^{\mu}_{k^{\prime}}\mathbb{E}\ab[x_{L+1,i}^{\mu}x_{L+1,k^{\prime}}\sum_{l=1}^{L}x_{l,j}^{\mu}x_{l,k}^{\mu}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>D</mi><mi>L</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><msubsup><mi>w</mi><mi>k</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><msup><mi>k</mi><mo>′</mo></msup><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>k</mi></mrow><mi>μ</mi></msubsup></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{D}{L}\delta_{\mu\nu}\sum_{k,k^{\prime}}w^{\mu}_{k}w^{\mu}_{k^{\prime}}\mathbb{E}\ab[x_{L+1,i}^{\mu}x_{L+1,k^{\prime}}\sum_{l=1}^{L}x_{l,j}^{\mu}x_{l,k}^{\mu}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
<tbody id="A3.E35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{D}\delta_{\mu\nu}w_{i}^{\mu}w_{j}^{\mu}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>D</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>i</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mi>j</mi><mi>μ</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{D}\delta_{\mu\nu}w_{i}^{\mu}w_{j}^{\mu}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p"><span id="A3.SS1.p2.2.1" class="ltx_text">For the second-order statistics of the teacher model, we have:</span></p>
<table id="A3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\ab[H^{\mu}_{ij}H^{\nu}_{i^{\prime}j^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mrow><msup><mi>i</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><mi>ν</mi></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\ab[H^{\mu}_{ij}H^{\nu}_{i^{\prime}j^{\prime}}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\ab[\frac{D^{2}}{L^{2}}\ab[x^{\mu}_{L+1,i}\sum_{l=1}^{L}\ab(\sum_{k=1}^{D}w_{k}^{\mu}x_{l,k}^{\mu}+\epsilon_{l,k}^{\mu})x_{l,j}^{\mu}]\ab[x^{\nu}_{L+1,i^{\prime}}\sum_{l^{\prime}=1}^{L}\ab(\sum_{k^{\prime}=1}^{D}w_{k^{\prime}}^{\nu}x_{l^{\prime},k^{\prime}}^{\nu}+\epsilon_{l^{\prime}}^{\nu})x_{l^{\prime},j^{\prime}}^{\nu}]]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>D</mi><mn>2</mn></msup><msup><mi>L</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><msubsup><mi>w</mi><mi>k</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>k</mi></mrow><mi>μ</mi></msubsup></mrow></mrow><mo>+</mo><msubsup><mi>ϵ</mi><mrow><mi>l</mi><mo>,</mo><mi>k</mi></mrow><mi>μ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>μ</mi></msubsup></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msup><mi>i</mi><mo>′</mo></msup></mrow><mi>ν</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mtext class="undefined">\ab</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mrow><msubsup><mi>w</mi><msup><mi>k</mi><mo>′</mo></msup><mi>ν</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mi>ν</mi></msubsup></mrow></mrow><mo>+</mo><msubsup><mi>ϵ</mi><msup><mi>l</mi><mo>′</mo></msup><mi>ν</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><mi>ν</mi></msubsup></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\ab[\frac{D^{2}}{L^{2}}\ab[x^{\mu}_{L+1,i}\sum_{l=1}^{L}\ab(\sum_{k=1}^{D}w_{k}^{\mu}x_{l,k}^{\mu}+\epsilon_{l,k}^{\mu})x_{l,j}^{\mu}]\ab[x^{\nu}_{L+1,i^{\prime}}\sum_{l^{\prime}=1}^{L}\ab(\sum_{k^{\prime}=1}^{D}w_{k^{\prime}}^{\nu}x_{l^{\prime},k^{\prime}}^{\nu}+\epsilon_{l^{\prime}}^{\nu})x_{l^{\prime},j^{\prime}}^{\nu}]]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
<tbody id="A3.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex2.m1" class="ltx_math_unparsed" alttext="\displaystyle=\delta_{\mu\nu}\mathbb{E}\left[\frac{D^{2}}{L^{2}}\sum_{k,k^{\prime}}w_{k}^{\mu}w_{k^{\prime}}^{\nu}\ab[x^{\mu}_{L+1,i}x^{\nu}_{L+1,i^{\prime}}\ab(\sum_{l=1}^{L}\sum_{l^{\prime}=1}^{L}x_{l,k}^{l}x_{l,j}^{l}x_{l^{\prime},k^{\prime}}^{l}x_{l^{\prime},j^{\prime}}^{l})]\right." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>δ</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mi>𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>D</mi><mn>2</mn></msup><msup><mi>L</mi><mn>2</mn></msup></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder></mstyle><msubsup><mi>w</mi><mi>k</mi><mi>μ</mi></msubsup><msubsup><mi>w</mi><msup><mi>k</mi><mo>′</mo></msup><mi>ν</mi></msubsup><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">[</mo><msubsup><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow><mi>μ</mi></msubsup><msubsup><mi>x</mi><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><msup><mi>i</mi><mo>′</mo></msup></mrow><mi>ν</mi></msubsup><mtext class="undefined">\ab</mtext><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>k</mi></mrow><mi>l</mi></msubsup><msubsup><mi>x</mi><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mi>l</mi></msubsup><msubsup><mi>x</mi><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup></mrow><mi>l</mi></msubsup><msubsup><mi>x</mi><mrow><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><mi>l</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\delta_{\mu\nu}\mathbb{E}\left[\frac{D^{2}}{L^{2}}\sum_{k,k^{\prime}}w_{k}^{\mu}w_{k^{\prime}}^{\nu}\ab[x^{\mu}_{L+1,i}x^{\nu}_{L+1,i^{\prime}}\ab(\sum_{l=1}^{L}\sum_{l^{\prime}=1}^{L}x_{l,k}^{l}x_{l,j}^{l}x_{l^{\prime},k^{\prime}}^{l}x_{l^{\prime},j^{\prime}}^{l})]\right.</annotation></semantics></math></td>
