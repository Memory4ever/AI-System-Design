<td id="S6.T3.5.6.4" class="ltx_td ltx_align_center"><math id="S6.T3.m4" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>80</td></tr>
<tr id="S6.T3.5.7" class="ltx_tr">
<td id="S6.T3.5.7.1" class="ltx_td ltx_align_left ltx_border_bb">RxT-Alpha Synthetic</td>
<td id="S6.T3.5.7.2" class="ltx_td ltx_align_center ltx_border_bb">160M</td>
