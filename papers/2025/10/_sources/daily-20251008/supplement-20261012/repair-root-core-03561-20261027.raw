<th id="S6.T3.5.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">4.37</th>
<th id="S6.T3.5.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">55</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T3.5.3" class="ltx_tr">
<td id="S6.T3.5.3.1" class="ltx_td ltx_align_left ltx_border_t">RxT-Alpha Nano</td>
