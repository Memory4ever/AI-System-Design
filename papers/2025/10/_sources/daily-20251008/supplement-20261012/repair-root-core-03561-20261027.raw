<td id="S6.T3.5.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>81</td></tr>
<tr id="S6.T3.5.4" class="ltx_tr">
<td id="S6.T3.5.4.1" class="ltx_td ltx_align_left">RxT-Alpha Micro</td>
<td id="S6.T3.5.4.2" class="ltx_td ltx_align_center">26M</td>
<td id="S6.T3.5.4.3" class="ltx_td ltx_align_center">2.56</td>
<td id="S6.T3.5.4.4" class="ltx_td ltx_align_center"><math id="S6.T3.m2" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>82</td></tr>
<tr id="S6.T3.5.5" class="ltx_tr">
<td id="S6.T3.5.5.1" class="ltx_td ltx_align_left">RxT-Alpha Micro (updated)</td>
<td id="S6.T3.5.5.2" class="ltx_td ltx_align_center">26M</td>
<td id="S6.T3.5.5.3" class="ltx_td ltx_align_center">2.31</td>
<td id="S6.T3.5.5.4" class="ltx_td ltx_align_center"><math id="S6.T3.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>82</td></tr>
<tr id="S6.T3.5.6" class="ltx_tr">
