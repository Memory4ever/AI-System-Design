<th id="A6.T5.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="A6.T5.2.1.1.5.1" class="ltx_text ltx_font_bold">AI+</span></th>
<th id="A6.T5.2.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="A6.T5.2.1.1.6.1" class="ltx_text ltx_font_bold">AC+</span></th></tr>
