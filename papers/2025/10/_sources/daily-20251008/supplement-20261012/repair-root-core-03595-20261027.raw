<th id="S4.T2.fig2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.fig2.1.1.2.1" class="ltx_text ltx_font_bold">AI</span></th>
<th id="S4.T2.fig2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.fig2.1.1.3.1" class="ltx_text ltx_font_bold">AC</span></th>
<th id="S4.T2.fig2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.fig2.1.1.4.1" class="ltx_text ltx_font_bold">AI+</span></th>
<th id="S4.T2.fig2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.fig2.1.1.5.1" class="ltx_text ltx_font_bold">AC+</span></th></tr>
<tr id="S4.T2.fig2.1.2" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<th id="S4.T2.fig2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_t" colspan="5"><span id="S4.T2.fig2.1.2.1.1" class="ltx_text ltx_font_italic">Llama-3.1-8B-Instruct</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.fig2.1.3" class="ltx_tr">
<th id="S4.T2.fig2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">NL</th>
<td id="S4.T2.fig2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">36.8</td>
<td id="S4.T2.fig2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">27.3</td>
<td id="S4.T2.fig2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">34.8</td>
<td id="S4.T2.fig2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">25.5</td></tr>
