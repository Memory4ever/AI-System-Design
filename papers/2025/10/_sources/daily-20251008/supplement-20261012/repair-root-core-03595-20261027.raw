<th id="A6.T5.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" rowspan="2"><span id="A6.T5.2.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
