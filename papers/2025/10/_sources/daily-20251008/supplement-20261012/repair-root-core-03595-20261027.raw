<th id="A6.T5.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">f1</th>
<th id="A6.T5.2.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Precision</th>
<th id="A6.T5.2.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Recall</th>
<th id="A6.T5.2.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">f1</th>
<th id="A6.T5.2.1.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Precision</th>
<th id="A6.T5.2.1.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Recall</th>
<th id="A6.T5.2.1.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">f1</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A6.T5.2.1.3" class="ltx_tr">
<th id="A6.T5.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="5"><span id="A6.T5.2.1.3.1.1" class="ltx_text">Llama-3.1-8B-Instruct</span></th>
