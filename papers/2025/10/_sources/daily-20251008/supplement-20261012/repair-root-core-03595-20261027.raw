<td id="A6.T5.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t">30.5</td>
<td id="A6.T5.2.1.3.10" class="ltx_td ltx_align_center ltx_border_t">40.5</td>
<td id="A6.T5.2.1.3.11" class="ltx_td ltx_align_center ltx_border_t">34.8</td>
<td id="A6.T5.2.1.3.12" class="ltx_td ltx_align_center ltx_border_t">21.7</td>
<td id="A6.T5.2.1.3.13" class="ltx_td ltx_align_center ltx_border_t">31.0</td>
<td id="A6.T5.2.1.3.14" class="ltx_td ltx_align_center ltx_border_t">25.5</td></tr>
<tr id="A6.T5.2.1.4" class="ltx_tr">
<th id="A6.T5.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">NL-S</th>
