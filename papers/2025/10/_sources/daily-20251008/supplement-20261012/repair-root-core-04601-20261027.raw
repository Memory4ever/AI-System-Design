<td id="A3.T9.2.1.5.3" class="ltx_td ltx_align_right"><math id="A3.T9.m4" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math>141.5</td>
<td id="A3.T9.2.1.5.4" class="ltx_td ltx_align_right"><math id="A3.T9.m5" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math>190</td></tr>
<tr id="A3.T9.2.1.6" class="ltx_tr">
<td id="A3.T9.2.1.6.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A3.T9.2.1.6.1.1" class="ltx_text ltx_font_bold">Ours (FedSRD / FedSRD-e)</span></td>
<td id="A3.T9.2.1.6.2" class="ltx_td ltx_align_right ltx_border_bb"><math id="A3.T9.m6" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math><span id="A3.T9.2.1.6.2.1" class="ltx_text ltx_font_bold">31.0</span></td>
