</span></div>
</figure>
<figure id="A3.T9" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 9. </span>Communication cost comparison per round (MB). Costs include both parameters and bitmaps where applicable.</figcaption>
<div id="A3.T9.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:62.3pt;vertical-align:-29.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-30.3pt,5.5pt) scale(0.850788065459512,0.850788065459512) ;">
<table id="A3.T9.2.1" class="ltx_tabular ltx_align_middle">
<tr id="A3.T9.2.1.1" class="ltx_tr">
<td id="A3.T9.2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A3.T9.2.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="A3.T9.2.1.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="A3.T9.2.1.1.2.1" class="ltx_text ltx_font_bold">Upload (MB)</span></td>
<td id="A3.T9.2.1.1.3" class="ltx_td ltx_align_right ltx_border_tt"><span id="A3.T9.2.1.1.3.1" class="ltx_text ltx_font_bold">Download (MB)</span></td>
<td id="A3.T9.2.1.1.4" class="ltx_td ltx_align_right ltx_border_tt"><span id="A3.T9.2.1.1.4.1" class="ltx_text ltx_font_bold">Total (MB)</span></td></tr>
<tr id="A3.T9.2.1.2" class="ltx_tr">
<td id="A3.T9.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">FedAvg / FedProx / FlexLoRA</td>
<td id="A3.T9.2.1.2.2" class="ltx_td ltx_align_right ltx_border_t">371</td>
<td id="A3.T9.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">371</td>
<td id="A3.T9.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t">742</td></tr>
<tr id="A3.T9.2.1.3" class="ltx_tr">
<td id="A3.T9.2.1.3.1" class="ltx_td ltx_align_left">FFA-LoRA</td>
<td id="A3.T9.2.1.3.2" class="ltx_td ltx_align_right">185.5</td>
<td id="A3.T9.2.1.3.3" class="ltx_td ltx_align_right">185.5</td>
<td id="A3.T9.2.1.3.4" class="ltx_td ltx_align_right">371</td></tr>
<tr id="A3.T9.2.1.4" class="ltx_tr">
<td id="A3.T9.2.1.4.1" class="ltx_td ltx_align_left">FedICU</td>
<td id="A3.T9.2.1.4.2" class="ltx_td ltx_align_right"><math id="A3.T9.m1" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math>197</td>
<td id="A3.T9.2.1.4.3" class="ltx_td ltx_align_right">371</td>
<td id="A3.T9.2.1.4.4" class="ltx_td ltx_align_right"><math id="A3.T9.m2" class="ltx_Math" alttext="\approx" display="inline" intent=":literal"><semantics><mo>≈</mo><annotation encoding="application/x-tex">\approx</annotation></semantics></math>568</td></tr>
<tr id="A3.T9.2.1.5" class="ltx_tr">
<td id="A3.T9.2.1.5.1" class="ltx_td ltx_align_left">Fed-DARE</td>
