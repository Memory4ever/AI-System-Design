<tr id="S5.T2.1.1.2" class="ltx_tr">
<td id="S5.T2.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.SS2.m1" class="ltx_Math" alttext="\text{CLIP}_{\text{img}}" display="inline" intent=":literal"><semantics><msub><mtext>CLIP</mtext><mtext>img</mtext></msub><annotation encoding="application/x-tex">\text{CLIP}_{\text{img}}</annotation></semantics></math></td>
<td id="S5.T2.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#A2BBFB;"><span id="S5.T2.1.1.2.2.1" class="ltx_text" style="--ltx-bg-color:#A2BBFB;">0.87</span></td>
