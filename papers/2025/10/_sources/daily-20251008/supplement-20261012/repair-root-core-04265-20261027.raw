<td id="A4.T5.4.3.1" class="ltx_td ltx_align_left">Format Aware</td>
<td id="A4.T5.4.3.2" class="ltx_td ltx_align_left">
<span id="A4.T5.4.3.2.1" class="ltx_inline-block ltx_align_top">
<span id="A4.T5.4.3.2.1.1" class="ltx_p">0 invalid; 1 wrong <math id="A4.T5.m6" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> unboxed; 2 wrong <math id="A4.T5.m7" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> boxed; 3 correct <math id="A4.T5.m8" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> unboxed; 4 correct <math id="A4.T5.m9" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> boxed</span>
</span></td></tr>
