<td id="A4.T5.4.4.1" class="ltx_td ltx_align_left">Conf-Calibrated</td>
<td id="A4.T5.4.4.2" class="ltx_td ltx_align_left">
<span id="A4.T5.4.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="A4.T5.4.4.2.1.1" class="ltx_p">0 invalid; 1 wrong <math id="A4.T5.m10" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> low_conf; 2 wrong_high_conf; 3 correct <math id="A4.T5.m11" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> low_conf; 4 correct <math id="A4.T5.m12" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> mid; 5 correct <math id="A4.T5.m13" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> high_conf</span>
</span></td></tr>
<tr id="A4.T5.4.5" class="ltx_tr">
<td id="A4.T5.4.5.1" class="ltx_td ltx_align_left">OOD Robustness</td>
<td id="A4.T5.4.5.2" class="ltx_td ltx_align_left">
<span id="A4.T5.4.5.2.1" class="ltx_inline-block ltx_align_top">
<span id="A4.T5.4.5.2.1.1" class="ltx_p">0 invalid; 1 ood <math id="A4.T5.m14" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> wrong; 2 ind <math id="A4.T5.m15" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> wrong; 3 ood <math id="A4.T5.m16" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> correct; 4 ind <math id="A4.T5.m17" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> correct</span>
</span></td></tr>
<tr id="A4.T5.4.6" class="ltx_tr">
<td id="A4.T5.4.6.1" class="ltx_td ltx_align_left">Strict Compliance</td>
<td id="A4.T5.4.6.2" class="ltx_td ltx_align_left">
<span id="A4.T5.4.6.2.1" class="ltx_inline-block ltx_align_top">
<span id="A4.T5.4.6.2.1.1" class="ltx_p">0 invalid; 1 wrong <math id="A4.T5.m18" class="ltx_Math" alttext="\lor" display="inline" intent=":literal"><semantics><mo>∨</mo><annotation encoding="application/x-tex">\lor</annotation></semantics></math> (correct <math id="A4.T5.m19" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> unboxed); 2 correct <math id="A4.T5.m20" class="ltx_Math" alttext="\land" display="inline" intent=":literal"><semantics><mo>∧</mo><annotation encoding="application/x-tex">\land</annotation></semantics></math> boxed</span>
</span></td></tr>
