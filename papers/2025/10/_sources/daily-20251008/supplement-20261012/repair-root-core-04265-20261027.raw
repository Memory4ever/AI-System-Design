<td id="S2.T1.2.3.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.2.3.1.1" class="ltx_text ltx_font_bold">Bayes@<math id="S2.T1.m16" class="ltx_Math" alttext="\!80" display="inline" intent=":literal"><semantics><mn>80</mn><annotation encoding="application/x-tex">\!80</annotation></semantics></math> (w/o CI)</span></td>
