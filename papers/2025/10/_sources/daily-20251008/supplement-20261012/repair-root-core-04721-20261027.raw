<td id="A1.T3.2.1.7.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="A1.T3.m13" class="ltx_Math" alttext="88.6" display="inline" intent=":literal"><semantics><mn>88.6</mn><annotation encoding="application/x-tex">88.6</annotation></semantics></math></td>
<td id="A1.T3.2.1.7.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="A1.T3.m14" class="ltx_Math" alttext="88.8" display="inline" intent=":literal"><semantics><mn>88.8</mn><annotation encoding="application/x-tex">88.8</annotation></semantics></math></td>
