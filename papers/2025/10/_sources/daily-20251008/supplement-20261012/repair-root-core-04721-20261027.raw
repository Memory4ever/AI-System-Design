<td id="A1.T3.2.1.6.4" class="ltx_td ltx_align_left"><math id="A1.T3.m12" class="ltx_Math" alttext="1.79" display="inline" intent=":literal"><semantics><mn>1.79</mn><annotation encoding="application/x-tex">1.79</annotation></semantics></math></td></tr>
