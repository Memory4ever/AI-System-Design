<td id="S2.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">24</td></tr>
<tr id="S2.T1.2.1.3" class="ltx_tr">
<td id="S2.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r">Question Rephrasing</td>
<td id="S2.T1.2.1.3.2" class="ltx_td ltx_align_center">7</td></tr>
<tr id="S2.T1.2.1.4" class="ltx_tr">
<td id="S2.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_border_r">Ground Truth Answer Rephrasing</td>
