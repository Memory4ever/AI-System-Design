<th id="A2.T7.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T7.5.1.1.4.1" class="ltx_text ltx_font_bold">Arc-E</span></th>
<th id="A2.T7.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T7.5.1.1.5.1" class="ltx_text ltx_font_bold">Arc-C</span></th>
<th id="A2.T7.5.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T7.5.1.1.6.1" class="ltx_text ltx_font_bold">BoolQ</span></th>
<th id="A2.T7.5.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T7.5.1.1.7.1" class="ltx_text ltx_font_bold">WinoGrande</span></th>
