<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A4.T12.3" class="ltx_text" style="font-size:90%;">Table 12</span>: </span><span id="A4.T12.4" class="ltx_text" style="font-size:90%;">Energy Evaluation for SpikingMamba with I-LIF and TI-LIF, where <math id="A4.T12.m3" class="ltx_Math" alttext="fr_{\text{in}}=\frac{\#\text{Spike}_{\text{in}}}{T\times k\times D}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mtext>in</mtext></msub></mrow><mo>=</mo><mfrac><mrow><mi mathsize="1.580em">#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext>Spike</mtext><mtext>in</mtext></msub></mrow><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">fr_{\text{in}}=\frac{\#\text{Spike}_{\text{in}}}{T\times k\times D}</annotation></semantics></math>, <math id="A4.T12.m4" class="ltx_Math" alttext="fr_{\text{out}}=\frac{\#\text{Spike}_{\text{out}}}{T\times k\times 2D}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mtext>out</mtext></msub></mrow><mo>=</mo><mfrac><mrow><mi mathsize="1.580em">#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext>Spike</mtext><mtext>out</mtext></msub></mrow><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">fr_{\text{out}}=\frac{\#\text{Spike}_{\text{out}}}{T\times k\times 2D}</annotation></semantics></math>.</span></figcaption>
