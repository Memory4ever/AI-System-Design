<th id="S2.T1.5.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.5.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="S2.T1.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.5.1.1.2.1" class="ltx_text ltx_font_bold">Size</span></th>
<th id="S2.T1.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.5.1.1.3.1" class="ltx_text ltx_font_bold">Training</span></th>
<th id="S2.T1.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.5.1.1.4.1" class="ltx_text ltx_font_bold">Step (<math id="S2.T1.m5" class="ltx_Math" alttext="T\times D" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">T\times D</annotation></semantics></math>)</span></th>
<th id="S2.T1.5.1.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.5.1.1.5.1" class="ltx_text ltx_font_bold">Infer. Comp.</span></th>
<th id="S2.T1.5.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.5.1.1.6.1" class="ltx_text ltx_font_bold">Zero-Shot</span></th></tr>
</thead>
