<th id="A2.T7.5.1.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T7.5.1.1.9.1" class="ltx_text ltx_font_bold">Diff.</span> (%)</th></tr>
<tr id="A2.T7.5.1.2" class="ltx_tr">
<td id="A2.T7.5.1.2.1" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T7.5.1.2.1.1" class="ltx_text ltx_font_bold">Mamba2-130m</span></td>
<td id="A2.T7.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">35.22</td>
<td id="A2.T7.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">64.25</td>
<td id="A2.T7.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">47.31</td>
<td id="A2.T7.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">24.06</td>
<td id="A2.T7.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">54.62</td>
<td id="A2.T7.5.1.2.7" class="ltx_td ltx_align_center ltx_border_t">52.25</td>
<td id="A2.T7.5.1.2.8" class="ltx_td ltx_align_center ltx_border_t">46.29</td>
<td id="A2.T7.5.1.2.9" class="ltx_td ltx_align_center ltx_border_t">-</td></tr>
<tr id="A2.T7.5.1.3" class="ltx_tr">
<td id="A2.T7.5.1.3.1" class="ltx_td ltx_align_center"><math id="A2.T7.m1" class="ltx_Math" alttext="y_{\text{max}}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mtext>max</mtext></msub><annotation encoding="application/x-tex">y_{\text{max}}</annotation></semantics></math> = 0</td>
<td id="A2.T7.5.1.3.2" class="ltx_td ltx_align_center">27.93</td>
<td id="A2.T7.5.1.3.3" class="ltx_td ltx_align_center">53.16</td>
