<tr id="S2.T1.5.1.2" class="ltx_tr">
<td id="S2.T1.5.1.2.1" class="ltx_td ltx_align_left ltx_border_t">SpikeBERT <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib29" title="" class="ltx_ref">Lv et al. (2023)</a></cite></td>
<td id="S2.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">109 M</td>
<td id="S2.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">2-stage distill</td>
<td id="S2.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S2.T1.m6" class="ltx_Math" alttext="4\times 1" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">4\times 1</annotation></semantics></math></td>
<td id="S2.T1.5.1.2.5" class="ltx_td ltx_align_left ltx_border_t"><math id="S2.T1.m7" class="ltx_Math" alttext="O(4L^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(4L^{2})</annotation></semantics></math></td>
