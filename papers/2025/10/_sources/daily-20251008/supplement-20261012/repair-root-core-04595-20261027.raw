<td id="S4.T2.13.1.2.2" class="ltx_td ltx_align_center"><span id="S4.T2.13.1.2.2.1" class="ltx_text ltx_font_bold">P.</span></td>
<td id="S4.T2.13.1.2.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.13.1.2.3.1" class="ltx_text"><span id="S4.T2.13.1.2.3.1.1" class="ltx_text ltx_font_bold">T.</span> (<math id="S4.T2.m16" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
<td id="S4.T2.13.1.2.4" class="ltx_td ltx_align_center"><span id="S4.T2.13.1.2.4.1" class="ltx_text ltx_font_bold">SNN</span></td>
<td id="S4.T2.13.1.2.5" class="ltx_td ltx_align_center"><span id="S4.T2.13.1.2.5.1" class="ltx_text ltx_font_bold">SGC</span></td>
<td id="S4.T2.13.1.2.6" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.13.1.2.6.1" class="ltx_text ltx_font_bold">Step</span></td>
<td id="S4.T2.13.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.7.1" class="ltx_text ltx_font_bold">BoolQ</span></td>
<td id="S4.T2.13.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.8.1" class="ltx_text ltx_font_bold">PIQA</span></td>
<td id="S4.T2.13.1.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.9.1" class="ltx_text ltx_font_bold">HS<math id="S4.T2.m17" class="ltx_Math" alttext="{}_{\text{Norm}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>Norm</mtext></msub><annotation encoding="application/x-tex">{}_{\text{Norm}}</annotation></semantics></math></span></td>
<td id="S4.T2.13.1.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.10.1" class="ltx_text ltx_font_bold">WG</span></td>
<td id="S4.T2.13.1.2.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.11.1" class="ltx_text ltx_font_bold">AE</span></td>
<td id="S4.T2.13.1.2.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.12.1" class="ltx_text ltx_font_bold">AC<math id="S4.T2.m18" class="ltx_Math" alttext="{}_{\text{Norm}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>Norm</mtext></msub><annotation encoding="application/x-tex">{}_{\text{Norm}}</annotation></semantics></math></span></td>
<td id="S4.T2.13.1.2.13" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.13.1" class="ltx_text ltx_font_bold">Avg.</span></td>
<td id="S4.T2.13.1.2.14" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.13.1.2.14.1" class="ltx_text ltx_font_bold">Diff.</span></td></tr>
<tr id="S4.T2.13.1.3" class="ltx_tr">
<td id="S4.T2.13.1.3.1" class="ltx_td ltx_align_left ltx_border_t">Mamba2</td>
<td id="S4.T2.13.1.3.2" class="ltx_td ltx_align_center ltx_border_t">130M</td>
<td id="S4.T2.13.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">-</td>
<td id="S4.T2.13.1.3.4" class="ltx_td ltx_align_center ltx_border_t">PT</td>
<td id="S4.T2.13.1.3.5" class="ltx_td ltx_align_center ltx_border_t">-</td>
<td id="S4.T2.13.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1</td>
