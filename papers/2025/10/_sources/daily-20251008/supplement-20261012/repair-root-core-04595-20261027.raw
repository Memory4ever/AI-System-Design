<td id="S4.T2.13.1.3.8" class="ltx_td ltx_align_center ltx_border_t">64.85</td>
<td id="S4.T2.13.1.3.9" class="ltx_td ltx_align_center ltx_border_t">35.13</td>
<td id="S4.T2.13.1.3.10" class="ltx_td ltx_align_center ltx_border_t">52.17</td>
<td id="S4.T2.13.1.3.11" class="ltx_td ltx_align_center ltx_border_t">47.31</td>
<td id="S4.T2.13.1.3.12" class="ltx_td ltx_align_center ltx_border_t">24.40</td>
<td id="S4.T2.13.1.3.13" class="ltx_td ltx_align_center ltx_border_t">46.58</td>
<td id="S4.T2.13.1.3.14" class="ltx_td ltx_align_center ltx_border_t">-</td></tr>
<tr id="S4.T2.13.1.4" class="ltx_tr" style="--ltx-bg-color:#FFEDDB;">
<td id="S4.T2.13.1.4.1" class="ltx_td ltx_align_left"><span id="S4.T2.13.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#FFEDDB;">SpikingMamba<sub id="S4.T2.13.1.4.1.1.1" class="ltx_sub"><span id="S4.T2.13.1.4.1.1.1.1" class="ltx_text ltx_font_italic">s</span></sub></span></td>
<td id="S4.T2.13.1.4.2" class="ltx_td ltx_align_center"><span id="S4.T2.13.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#FFEDDB;">130M</span></td>
<td id="S4.T2.13.1.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.13.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#FFEDDB;">7 B</span></td>
