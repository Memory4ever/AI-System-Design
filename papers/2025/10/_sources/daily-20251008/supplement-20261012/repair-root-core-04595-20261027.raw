<td id="A2.T7.5.1.3.5" class="ltx_td ltx_align_center">24.15</td>
<td id="A2.T7.5.1.3.6" class="ltx_td ltx_align_center">40.18</td>
<td id="A2.T7.5.1.3.7" class="ltx_td ltx_align_center">51.54</td>
