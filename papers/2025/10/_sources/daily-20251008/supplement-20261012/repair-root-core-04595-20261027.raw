<td id="S2.T1.5.1.3.1" class="ltx_td ltx_align_left">SpikingBERT <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib3" title="" class="ltx_ref">Bal &amp; Sengupta (2024)</a></cite></td>
<td id="S2.T1.5.1.3.2" class="ltx_td ltx_align_center">50 M</td>
<td id="S2.T1.5.1.3.3" class="ltx_td ltx_align_center">3-stage distill</td>
<td id="S2.T1.5.1.3.4" class="ltx_td ltx_align_center"><math id="S2.T1.m8" class="ltx_Math" alttext="125\times 1" display="inline" intent=":literal"><semantics><mrow><mn>125</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">125\times 1</annotation></semantics></math></td>
<td id="S2.T1.5.1.3.5" class="ltx_td ltx_align_left"><math id="S2.T1.m9" class="ltx_Math" alttext="O(125L^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>125</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(125L^{2})</annotation></semantics></math></td>
<td id="S2.T1.5.1.3.6" class="ltx_td ltx_align_center">✗</td></tr>
<tr id="S2.T1.5.1.4" class="ltx_tr">
<td id="S2.T1.5.1.4.1" class="ltx_td ltx_align_left">SpikeLM <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib50" title="" class="ltx_ref">Xing et al. (2024b)</a></cite></td>
<td id="S2.T1.5.1.4.2" class="ltx_td ltx_align_center">194 M</td>
<td id="S2.T1.5.1.4.3" class="ltx_td ltx_align_center">2-stage distill</td>
<td id="S2.T1.5.1.4.4" class="ltx_td ltx_align_center"><math id="S2.T1.m10" class="ltx_math_unparsed" alttext="4\times\pm 1" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em" rspace="0em">×</mo><mo lspace="0em">±</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">4\times\pm 1</annotation></semantics></math></td>
<td id="S2.T1.5.1.4.5" class="ltx_td ltx_align_left"><math id="S2.T1.m11" class="ltx_Math" alttext="O(4L^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(4L^{2})</annotation></semantics></math></td>
<td id="S2.T1.5.1.4.6" class="ltx_td ltx_align_center">✗</td></tr>
