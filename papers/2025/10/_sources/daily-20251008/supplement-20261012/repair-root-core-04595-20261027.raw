<td id="A4.T12.5.3.2" class="ltx_td ltx_align_left"><math id="A4.T12.m7" class="ltx_Math" alttext="k\times fr_{\text{out}}\times D\times 2D\times E_{\text{ADD}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>k</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mtext>out</mtext></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>D</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>E</mi><mtext>ADD</mtext></msub></mrow><annotation encoding="application/x-tex">k\times fr_{\text{out}}\times D\times 2D\times E_{\text{ADD}}</annotation></semantics></math></td></tr>
