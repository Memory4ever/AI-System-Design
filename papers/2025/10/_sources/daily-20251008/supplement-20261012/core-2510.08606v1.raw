<td id="S2.T2.8.9.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T2.8.9.3.1" class="ltx_text ltx_font_bold">85.89</span></td>
<td id="S2.T2.8.9.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T2.8.9.4.1" class="ltx_text ltx_font_bold">71.04</span></td>
<td id="S2.T2.8.9.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T2.8.9.5.1" class="ltx_text ltx_font_bold">72.34</span></td>
<td id="S2.T2.8.9.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T2.8.9.6.1" class="ltx_text ltx_font_bold">76.43</span></td>
<td id="S2.T2.8.9.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T2.8.9.7.1" class="ltx_text ltx_font_bold">84.81</span></td>
<td id="S2.T2.8.9.8" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T2.8.9.8.1" class="ltx_text ltx_font_bold">85.21</span></td>
