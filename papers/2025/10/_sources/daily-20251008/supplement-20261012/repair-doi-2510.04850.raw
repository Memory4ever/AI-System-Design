{"data":{"id":"10.48550/arxiv.2510.04850","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04850","prefix":"10.48550","suffix":"arxiv.2510.04850","identifiers":[{"identifier":"2510.04850","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.04850"}],"creators":[{"name":"Zhang, Hengxiang","nameType":"Personal","givenName":"Hengxiang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Choi, Hyeong Kyu","nameType":"Personal","givenName":"Hyeong Kyu","familyName":"Choi","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Sharon","nameType":"Personal","givenName":"Sharon","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Hongxin","nameType":"Personal","givenName":"Hongxin","familyName":"Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting Distillation Data from Reasoning Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T14:37:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:37:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-15T08:23:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T00:34:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-08T06:36:19Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-11T00:39:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Reasoning distillation has emerged as a prevailing paradigm for transferring reasoning capabilities from large reasoning models to small language models. Yet, reasoning distillation risks data contamination: benchmark data may inadvertently be included in the distillation data, thereby inflating model performance metrics. In this work, we formally define the distillation data detection task, which determines whether a given question is included in the model's distillation data. The unique challenge of this task lies in the partial availability of distillation data. To address this, we propose Token Probability Deviation (TPD), a detection method that leverages the probability patterns of output tokens generated by the model instead of input tokens. Our method is motivated by the observation that seen questions tend to elicit more near-deterministic tokens generated by the models than unseen ones. Our TPD score is thus designed to quantify the token-level deviation of generated tokens from a high-confidence reference probability. Consequently, seen questions can yield substantially lower TPD scores than unseen ones, enabling strong detection performance. Extensive experiments demonstrate the effectiveness of our approach, improving detection AUC by up to 31% on distillation datasets.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.04850","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T16:55:57.000Z","registered":"2025-10-07T16:55:58.000Z","published":"2025","updated":"2026-05-11T02:42:48.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.04850","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}