<td id="A5.T7.3.5.2" class="ltx_td ltx_align_center">0.747</td>
<td id="A5.T7.3.5.3" class="ltx_td ltx_align_center">0.213</td>
<td id="A5.T7.3.5.4" class="ltx_td ltx_align_center">0.947</td>
