<th id="S2.T2.5.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_r ltx_border_tt" style="padding:0.45pt 5.0pt;">
<span id="S2.T2.5.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:170.7pt;">
