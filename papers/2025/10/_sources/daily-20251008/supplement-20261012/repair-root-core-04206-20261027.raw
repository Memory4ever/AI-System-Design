<span id="S2.T2.5.1.3.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="S2.T2.5.1.3.1.1" class="ltx_p"><span id="S2.T2.5.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Algorithm</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T2.5.2" class="ltx_tr">
<td id="S2.T2.5.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding:0.45pt 5.0pt;">
<span id="S2.T2.5.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:56.9pt;">
<span id="S2.T2.5.2.1.1.1" class="ltx_p"><span id="S2.T2.5.2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Single-Turn</span></span>
</span></td>
<td id="S2.T2.5.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding:0.45pt 5.0pt;">
<span id="S2.T2.5.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:170.7pt;">
<span id="S2.T2.5.2.2.1.1" class="ltx_p"><span id="S2.T2.5.2.2.1.1.1" class="ltx_text" style="font-size:90%;">synchronous rollouts</span></span>
</span></td>
<td id="S2.T2.5.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.45pt 5.0pt;">
<span id="S2.T2.5.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="S2.T2.5.2.3.1.1" class="ltx_p"><span id="S2.T2.5.2.3.1.1.1" class="ltx_text" style="font-size:90%;">stable and scalable training</span></span>
</span></td></tr>
<tr id="S2.T2.5.3" class="ltx_tr">
<td id="S2.T2.5.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding:0.45pt 5.0pt;">
<span id="S2.T2.5.3.1.1" class="ltx_inline-block ltx_align_middle" style="width:56.9pt;">
<span id="S2.T2.5.3.1.1.1" class="ltx_p"><span id="S2.T2.5.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Multi-Turn</span></span>
</span></td>
<td id="S2.T2.5.3.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding:0.45pt 5.0pt;">
