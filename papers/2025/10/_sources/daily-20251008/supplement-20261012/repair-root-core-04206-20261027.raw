<td id="S4.T6.5.1.4.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:-0.2pt 12.0pt;"><span id="S4.T6.5.1.4.7.1" class="ltx_text" style="font-size:80%;">59.4</span></td></tr>
