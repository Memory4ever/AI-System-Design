</table>
</span></div>
</figure>
<figure id="S4.F7" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F7.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.04206v1/kg_ablation.svg" id="S4.F7.sf1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/412;" width="476" height="412"></object>
