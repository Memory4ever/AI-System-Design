<td id="S4.T6.5.1.3.5" class="ltx_td ltx_align_center" style="padding:-0.2pt 12.0pt;"><span id="S4.T6.5.1.3.5.1" class="ltx_text" style="font-size:80%;">39.7</span><sub id="S4.T6.5.1.3.5.2" class="ltx_sub"><span id="S4.T6.5.1.3.5.2.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#808080;">±2.3</span></sub></td>
<td id="S4.T6.5.1.3.6" class="ltx_td ltx_align_center" style="padding:-0.2pt 12.0pt;"><span id="S4.T6.5.1.3.6.1" class="ltx_text" style="font-size:80%;">54.5</span><sub id="S4.T6.5.1.3.6.2" class="ltx_sub"><span id="S4.T6.5.1.3.6.2.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#808080;">±1.3</span></sub></td>
<td id="S4.T6.5.1.3.7" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.2pt 12.0pt;"><span id="S4.T6.5.1.3.7.1" class="ltx_text" style="font-size:80%;">60.7</span></td></tr>
