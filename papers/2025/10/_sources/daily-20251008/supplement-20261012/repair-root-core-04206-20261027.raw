<td id="A5.T7.3.3.3" class="ltx_td ltx_align_center ltx_border_t">0.68</td>
<td id="A5.T7.3.3.4" class="ltx_td ltx_align_center ltx_border_t">0.926</td>
<td id="A5.T7.3.3.5" class="ltx_td ltx_align_center ltx_border_t">0.074</td></tr>
