+\ \mathcal{O}(KBLd)\end{aligned}" display="inline" intent=":literal"><semantics><mtable rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi style="--ltx-bg-color:#CCCCCC;" class="ltx_font_mathcaligraphic" mathbackground="#CCCCCC" mathsize="0.700em">𝒪</mi><mo>⁡</mo><mrow><mo style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">d</mi><mn style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">2</mn></msup></mrow><mo style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">+</mo><mrow><mi style="--ltx-bg-color:#CCCCCC;" class="ltx_font_mathcaligraphic" mathbackground="#CCCCCC" mathsize="0.700em">𝒪</mi><mo>⁡</mo><mrow><mo style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">K</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">B</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">L</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" mathsize="0.700em">d</mi></mrow><mo style="--ltx-bg-color:#CCCCCC;" mathbackground="#CCCCCC" maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} \mathcal{O}(Kd^{2})\\
