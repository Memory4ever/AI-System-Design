4.73 0) translate(17.63,0) matrix(1.0 0.0 0.0 1.0 -14.87 -1.31)"><foreignObject style="--ltx-fo-width:3.16em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="29.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F9.pic1.7" class="ltx_text" style="font-size:50%;">Gemini</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 60 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 C 0 0 8.53 0 11.81 0 C 15.09 0 23.62 0 23.62 0"></path><g style="--ltx-fill-color:#CC0000;" fill="#CC0000"><path d="M 9.04 -2.77 h 5.53 v 5.53 h -5.53 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 84.72 0) translate(16.76,0) matrix(1.0 0.0 0.0 1.0 -13.99 -1.31)"><foreignObject style="--ltx-fo-width:2.97em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="27.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F9.pic1.8" class="ltx_text" style="font-size:50%;">GPT-4</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 118.24 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 C 0 0 8.53 0 11.81 0 C 15.09 0 23.62 0 23.62 0"></path><g style="--ltx-fill-color:#996633;" fill="#996633"><path d="M 11.81 2.77 L 14.21 -1.38 L 9.41 -1.38 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 142.97 0) translate(34.33,0) matrix(1.0 0.0 0.0 1.0 -31.57 -1.36)"><foreignObject style="--ltx-fo-width:6.7em;--ltx-fo-height:0.51em;--ltx-fo-depth:0.14em;font-size:6.81pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="63.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F9.pic1.9" class="ltx_text" style="font-size:50%;">Qwen2.5-Coder</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 211.64 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 C 0 0 8.53 0 11.81 0 C 15.09 0 23.62 0 23.62 0"></path><path style="fill:none" d="M 14.58 0 C 14.58 1.53 13.34 2.77 11.81 2.77 C 10.28 2.77 9.04 1.53 9.04 0 C 9.04 -1.53 10.28 -2.77 11.81 -2.77 C 13.34 -2.77 14.58 -1.53 14.58 0 Z M 11.81 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 236.37 0) translate(22.36,0) matrix(1.0 0.0 0.0 1.0 -19.59 -1.31)"><foreignObject style="--ltx-fo-width:4.16em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.7" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="39.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F9.pic1.10" class="ltx_text" style="font-size:50%;">LLaMA-3</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 281.09 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 C 0 0 8.53 0 11.81 0 C 15.09 0 23.62 0 23.62 0"></path><g style="--ltx-fill-color:#0000CC;" fill="#0000CC"><path d="M 11.81 2.77 L 13.89 0 L 11.81 -2.77 L 9.74 0 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 305.82 0) translate(13.86,0) matrix(1.0 0.0 0.0 1.0 -11.09 -1.36)"><foreignObject style="--ltx-fo-width:2.36em;--ltx-fo-height:0.51em;--ltx-fo-depth:0em;font-size:6.81pt;" height="4.8" overflow="visible" transform="matrix(1 0 0 -1 0 4.8)" width="22.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F9.pic1.11" class="ltx_text" style="font-size:50%;">Phi-4</span></span></span></foreignObject></g></g></g></g></g></g></g></g></svg></span>
</figure>
<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Figure <a href="#S4.F8" title="Fig. 8 ‣ IV-B Results and Analysis ‣ IV Experiment: Vulnerability Detection and Reasoning in the Wild ‣ Real-VulLLM: An LLM Based Assessment Framework in the Wild" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> demonstrates that substantial improves improves both predictive accuracy and reasoning reliability in vulnerability detection when supplemented with contextual examples through FS prompting. Across all models, the proportion of correct predictions with correct reasoning (CP-CR) is consistently higher in FS than in Zero-Shot (ZS) settings. For instance, GPT-4 achieves the highest CP-CR percentage at 32.8% in FS, compared to only 22% in ZS. Comparable gains are observed for Qwen2.5-Coder and Phi-4, which reach 31.3% and 25.0% CP-CR in FS, but drop to 22.0% and 18.8% in ZS, respectively.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">The incorrect prediction with incorrect reasoning (ICP-ICR) of the model rise sharply increases in the absence of context. Phi-4 is particularly sensitive, with ICP-ICR climbing from 41.3% in FS to 63.8% in ZS, a 22.5% degradation. Gemini follows a similar pattern, increasing from 48.7%to 57.5%.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">These trends highlight that knowledge augmentation examples improve both prediction accuracy and reasoning quality, while ZS models often fail to generalize, particularly on vulnerable code samples. Notably, Gemini, despite achieving 23 CP-CRs in FS, has a high CP-ICR rate (31.3%), suggesting frequent incorrect reasoning even when predictions are correct. In contrast, LLaMA-3 for FS scenario shows balanced performance with a CP-CR of 30.0% and a moderate ICP-ICR of 47.8%, indicating relatively stronger reasoning consistency compared to other open-source models. Overall, FS settings reduce ICP-ICR by 4–22% across models and improve CP-CR by 4–13%, highlighting the importance of context in enhancing model reliability for vulnerability detection and reasoning.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p">Figure <a href="#S4.F7" title="Fig. 7 ‣ IV Experiment: Vulnerability Detection and Reasoning in the Wild ‣ Real-VulLLM: An LLM Based Assessment Framework in the Wild" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> presents a heatmap of correct predictions with correct reasoning across individual CVEs for all evaluated models. The results reveal clear variation in model performance depending on the vulnerability type. Certain CVEs, such as <span id="S4.SS2.p4.1.1" class="ltx_text ltx_font_typewriter">CVE-2023-23143</span>, <span id="S4.SS2.p4.1.2" class="ltx_text ltx_font_typewriter">CVE-2023-3316</span>, and <span id="S4.SS2.p4.1.3" class="ltx_text ltx_font_typewriter">CVE-2023-27585</span>, are consistently detected with correct reasoning across nearly all models, indicating that these vulnerabilities exhibit structural or semantic patterns that align well with the pretrained knowledge of LLMs.
In contrast, several CVEs (e.g., <span id="S4.SS2.p4.1.4" class="ltx_text ltx_font_typewriter">CVE-2023-41175</span>, <span id="S4.SS2.p4.1.5" class="ltx_text ltx_font_typewriter">CVE-2023-23144</span>, and <span id="S4.SS2.p4.1.6" class="ltx_text ltx_font_typewriter">CVE-2023-45871</span>) fails to get any correct response reflecting that model may generalize well on familiar patterns but does not perform well in case of atypical flaws. GPT-4 demonstrates the broadest coverage, while Qwen2.5-Coder, LLaMA-3, and Phi-4 perform well only on selected cases. Overall, the results indicate that LLMs generalize on familiar vulnerability patterns but struggle with rare or complex cases, underscoring the need for more diverse training data.</p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">Figure <a href="#S4.F9" title="Fig. 9 ‣ IV-B Results and Analysis ‣ IV Experiment: Vulnerability Detection and Reasoning in the Wild ‣ Real-VulLLM: An LLM Based Assessment Framework in the Wild" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> shows Decomposition prompt (P-Decomp) shows balanced and consistent performance across all models, with no model performing poorly, making it a strong general-purpose prompt. It yield the highest performance across all evaluated models in our “in the wild” vulnerability detection task. This prompting strategy explicitly guides the model through step by step reasoning, replicating the structured approach of security analysts. The prompt enforces to breakdown task into code understanding, vulnerability detection, localization, and present reasoning why it is vulnerable/secure. CoT and plan-and-solve strategy showed overall better results and specifically using plan-and-solve strategy GPT-4 model showed the highest performing, making plan-and-solve best prompt with GPT-4 as best model. This highlights the benefit of encouraging planing and explicit steps in enhancing models performance.</p>
</div>
<div id="S4.SS2.p6" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S4.SS2.p6.pic1" class="ltx_picture" height="424.03" overflow="visible" version="1.1" viewBox="0 0 650 424.03" width="650"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,424.03) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 418.12 C 0 421.39 2.64 424.03 5.91 424.03 L 644.09 424.03 C 647.36 424.03 650 421.39 650 418.12 L 650 5.91 C 650 2.64 647.36 0 644.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 398.38 L 648.03 398.38 L 648.03 5.91 C 648.03 3.73 646.27 1.97 644.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 407.75)"><foreignObject style="--ltx-fo-width:43.85em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="606.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.SS2.p6.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:43.85em;">
<span id="S4.SS2.p6.pic1.1.1" class="ltx_p"><span id="S4.SS2.p6.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">Decomposition Prompt (P-Decomp-Wild)</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.85)"><foreignObject style="--ltx-fo-width:41.76em;--ltx-fo-height:26.72em;--ltx-fo-depth:0.22em;font-size:10pt;" height="372.8" overflow="visible" transform="matrix(1 0 0 -1 0 369.72)" width="577.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.SS2.p6.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:41.76em;">
<span id="S4.SS2.p6.pic1.2.1" class="ltx_p"><span id="S4.SS2.p6.pic1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">System:<span id="S4.SS2.p6.pic1.2.1.1.1" class="ltx_text ltx_font_medium"> You are a security expert. Answer the following question clearly and concisely only from the context provided. If the answer cannot be determined from the context, then just answer that provided context is not enough to answer this question.</span></span></span>
<span id="S4.SS2.p6.pic1.2.2" class="ltx_p"><span id="S4.SS2.p6.pic1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Question:<span id="S4.SS2.p6.pic1.2.2.1.1" class="ltx_text ltx_font_medium">You are a security expert tasked with analyzing software code for vulnerabilities. Use a decomposition approach to break down the task into smaller, manageable components and address each systematically. Follow these steps:</span></span></span>
<span id="S4.I2" class="ltx_enumerate">
<span id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="S4.I2.i1.p1" class="ltx_para">
<span id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Understand</span><span id="S4.I2.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> the given code.</span></span>
</span></span>
<span id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="S4.I2.i2.p1" class="ltx_para">
<span id="S4.I2.i2.p1.1" class="ltx_p"><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Detect</span><span id="S4.I2.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> if the code contains any security vulnerability or not? Respond with ‘Yes’ or ‘No’ and briefly explain your reasoning.
If ‘Yes’, recommend a patch for vulnerability.
If your answer is ‘No’, state code appears secure. No further steps required.</span></span>
</span></span>
<span id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<span id="S4.I2.i3.p1" class="ltx_para">
<span id="S4.I2.i3.p1.1" class="ltx_p"><span id="S4.I2.i3.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">If ‘Yes’</span><span id="S4.I2.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, identify the vulnerability: Specify the exact location(s) in the code and explain why it is vulnerable.</span></span>
</span></span>
</span>
<span id="S4.SS2.p6.pic1.2.3" class="ltx_p"><span id="S4.SS2.p6.pic1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Ans:<span id="S4.SS2.p6.pic1.2.3.1.1" class="ltx_text ltx_font_medium"> Answer in a structured format</span></span></span><pre id="S4.SS2.p6.pic1.2.4" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">
Step 1: [Understanding]
Step 2: [Yes/No with Explanation]
Step 3: [Vulnerability Location and
         Reason]
</pre>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<figure id="S4.F10" class="ltx_figure">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F10.3" class="ltx_text" style="font-size:90%;">Fig. 10</span>: </span><span id="S4.F10.4" class="ltx_text" style="font-size:90%;">Distribution of Scoring Metrics that jointly evaluates prediction and its reasoning correctness</span></figcaption><img src="2510.04056v1/SM.png" id="S4.F10.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:191/112;" width="191" height="112" alt="Refer to caption">
</figure>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">Fig. <a href="#S4.F10" title="Fig. 10 ‣ IV-B Results and Analysis ‣ IV Experiment: Vulnerability Detection and Reasoning in the Wild ‣ Real-VulLLM: An LLM Based Assessment Framework in the Wild" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> presents the distribution of our novel scoring metric, which jointly assesses both prediction accuracy and its reasoning correctness. The figure shows a clear distinction between samples with correct predictions and correct reasoning (CP-CR) tend to score above 0.75, while those with incorrect predictions and incorrect reasoning (ICP-ICR) fall below 0.2. This clear separation highlights the effectiveness of the metric in capturing both the correctness and quality of model outputs, offering a more comprehensive evaluation than accuracy alone. In case of partially correct response some credit is assigned to model.</p>
</div>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p">This structured decomposition prompting aligns and is consistent with the prior findings of modular approach for solving complex tasks  <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>, <a href="#bib.bib52" title="" class="ltx_ref">52</a>]</cite>. We illustrate our decomposition strategy in Listing <a href="#S4.SS2" title="IV-B Results and Analysis ‣ IV Experiment: Vulnerability Detection and Reasoning in the Wild ‣ Real-VulLLM: An LLM Based Assessment Framework in the Wild" class="ltx_ref"><span class="ltx_text ltx_ref_tag">IV-B</span></a>.</p>
</div>
<div id="S4.SS2.p9" class="ltx_para">
<p id="S4.SS2.p9.1" class="ltx_p"><span id="S4.SS2.p9.1.1" class="ltx_text ltx_font_bold">Insight of Experiment:</span>
Detection in the wild setting i.e., in the wild is substantially harder than in synthetic or benchmark settings. The results shows that the model are not ready to be deployed in the wild. The results are in consistent with the findings of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>.
In-context learning has shown improved performance across all models as compared to ZS settings. The correct prediction and reasoning of the increases when supplied with semantically similar examples, enabling effectiveness of knowledge augmentation through semantic retrieval. Among all the models, closed-source models GPT-4 and Gemini outperforms open-source models particularly when provided with context. Overall, reasoning task is subtle than classification as when models predict correctly, the reasoning is often incorrect, or incomplete.This suggests LLMs still struggle with abstract or unfamiliar vulnerability patterns, indicating a gap in robust generalization under real-world situations.
<br class="ltx_break">Performance drops sharply when detecting vulnerabilities (as opposed to secure code), especially in the ZS setting. Even GPT-4, which leads in FS scenario, shows limited success on vulnerable samples, emphasizing the inherent difficulty of LLMs in identifying vulnerability patterns.</p>
</div>
<div id="S4.SS2.p10" class="ltx_para">
<p id="S4.SS2.p10.1" class="ltx_p">Prompt engineering plays a critical role in guiding model behavior. The decomposition Prompt (P-Decomp) yields consistent performance across all models, making it a strong general-purpose prompt. P-CoT and P-P&amp;S prompts both deliver better results overall. GPT-4 achieves its best results with Plan-and-Solve, highlighting the advantage of structured reasoning and step-by-step planning. This confirms that explicitly guiding the model’s reasoning process improves reliability on complex security tasks.</p>
</div>
<div id="S4.SS2.p11" class="ltx_para">
<p id="S4.SS2.p11.1" class="ltx_p">Model performance varies significantly across different CVEs. Some vulnerabilities (e.g., those with familiar CWE patterns) are consistently detected, while others receive no correct answers. This suggests that LLMs generalize better to patterns likely seen during pretraining but struggle with novel or unseen vulnerabilities. Although GPT-4 leads in total correct responses, Qwen2.5-Coder and Gemini show fewer fully incorrect cases, indicating a stable reasoning pattern.</p>
</div>
<div id="S4.SS2.p12" class="ltx_para">
<p id="S4.SS2.p12.1" class="ltx_p">In summary, despite better results from closed-source models, the LLMS are not fully reliable for the vulnerability detection or reasoning in the wild. However, if instruction tuning or fine-tuning on vulnerability specific task-oriented training is introduced and structured prompts, LLMs, with further fine-tuning and prompt design, hold potential for deployment in real-world security settings, though current performance remains insufficient.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">V </span><span id="S5.2" class="ltx_text ltx_font_smallcaps">Conclusion &amp; Future Work</span></h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">This research presented an assessment framework for LLMs on the task of <span id="S5.p1.1.1" class="ltx_text ltx_font_italic">ZS</span> and <span id="S5.p1.1.2" class="ltx_text ltx_font_italic">in-context</span> software vulnerability detection and its reasoning in the <span id="S5.p1.1.3" class="ltx_text ltx_font_italic">wild</span>. Our framework integrates carefully designed prompting strategies, real-world CVEs, and in-context examples which are selected on the basis of semantically similarity, , enabling a practical and reproducible evaluation setting.</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">We evaluated representative models of major technology companies, including Google, OpenAI, Alibaba, Microsoft and Meta. GPT-4 and Gemini-1.5-flash are closed-source, and Qwen2.5-Coder, Phi-4 and LLaMA-3 are open-source models. Our results signifies that closed-source models outperforms open-source models when guided by structured, role-based, or in-context prompts. A key insight from our framework is that Plan-and-Solve strategy leads to performance improvement in terms of vulnerability detection and its reasoning across closed source models verified by our assessment scoring metrics.</p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p">Open-source models, while showing more limited overall capability, performed relatively better when prompted with simple and direct instructions. Among them, Alibaba’s model Qwen2.5-Coder frequently outputs unstable response despite being trained on code, whereas LLaMA-3, showed more stable performance.</p>
</div>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p">However, our results show several limitations of LLMs performance across range of CVEs, indicating that current LLMs does not exhibit power yet to generalize well across wide range of software vulnerabilities. This highlights the gap between model capability and requirement of further advancement to meet the criteria of robust real-world LLMs.
In future work, we aim to extend Real-VulLLM with agentic AI workflows capable of collecting contextual information from multiple sources. This will help in the task of adaptive and robust vulnerability detection and reasoning pipelines, moving closer to practical integration of LLMs into software security workflows.</p>
</div>
</section>
