<td id="S3.T2.5.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.8pt 2.0pt;"><span id="S3.T2.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Release</span></td>
