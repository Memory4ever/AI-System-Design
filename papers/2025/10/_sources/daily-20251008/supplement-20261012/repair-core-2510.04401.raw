<tr id="S4.T2.8.1.5" class="ltx_tr">
<th id="S4.T2.8.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r">Llama4 Maverick</th>
<td id="S4.T2.8.1.5.2" class="ltx_td ltx_align_center">0.38</td>
<td id="S4.T2.8.1.5.3" class="ltx_td ltx_align_center">0.15</td>
<td id="S4.T2.8.1.5.4" class="ltx_td ltx_align_center">0.33</td>
