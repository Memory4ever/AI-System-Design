<td id="S3.T1.4.1.9.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib73" title="" class="ltx_ref">73</a>]</cite></td>
