<tbody class="ltx_tbody">
<tr id="S4.T2.8.1.3" class="ltx_tr">
<th id="S4.T2.8.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">Gemma3 27B</th>
<td id="S4.T2.8.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.26</td>
<td id="S4.T2.8.1.3.3" class="ltx_td ltx_align_center ltx_border_t">0.14</td>
<td id="S4.T2.8.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.21</td>
<td id="S4.T2.8.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.23</td>
<td id="S4.T2.8.1.3.6" class="ltx_td ltx_align_center ltx_border_t">0.22</td>
<td id="S4.T2.8.1.3.7" class="ltx_td ltx_align_center ltx_border_t">0.25</td>
<td id="S4.T2.8.1.3.8" class="ltx_td ltx_align_center ltx_border_t">0.23</td>
<td id="S4.T2.8.1.3.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.21</td></tr>
<tr id="S4.T2.8.1.4" class="ltx_tr">
<th id="S4.T2.8.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r">Kimi VL A3B</th>
<td id="S4.T2.8.1.4.2" class="ltx_td ltx_align_center">0.29</td>
<td id="S4.T2.8.1.4.3" class="ltx_td ltx_align_center">0.23</td>
<td id="S4.T2.8.1.4.4" class="ltx_td ltx_align_center">0.22</td>
<td id="S4.T2.8.1.4.5" class="ltx_td ltx_align_center">0.27</td>
<td id="S4.T2.8.1.4.6" class="ltx_td ltx_align_center">0.19</td>
<td id="S4.T2.8.1.4.7" class="ltx_td ltx_align_center">0.30</td>
<td id="S4.T2.8.1.4.8" class="ltx_td ltx_align_center">0.23</td>
