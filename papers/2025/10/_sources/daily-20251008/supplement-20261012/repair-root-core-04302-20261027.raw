<td id="S6.T2.2.13.3" class="ltx_td ltx_align_center">0.8 <math id="S6.T2.m68" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.1</td>
