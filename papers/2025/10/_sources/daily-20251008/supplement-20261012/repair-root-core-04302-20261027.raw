<td id="S6.T2.2.12.6" class="ltx_td ltx_align_center">1.4 <math id="S6.T2.m65" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.2</td>
<td id="S6.T2.2.12.7" class="ltx_td ltx_align_center">2.5 <math id="S6.T2.m66" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.3</td></tr>
