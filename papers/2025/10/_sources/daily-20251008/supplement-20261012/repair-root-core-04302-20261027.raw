<td id="S6.T2.2.11.7" class="ltx_td ltx_align_center">-43.9 <math id="S6.T2.m60" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.4</td></tr>
