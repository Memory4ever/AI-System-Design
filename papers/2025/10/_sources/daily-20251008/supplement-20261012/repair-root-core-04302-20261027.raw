<td id="S6.T2.2.13.7" class="ltx_td ltx_align_center">0.7 <math id="S6.T2.m72" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.2</td></tr>
<tr id="S6.T2.2.14" class="ltx_tr">
<th id="S6.T2.2.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Average</th>
<td id="S6.T2.2.14.2" class="ltx_td ltx_align_center ltx_border_t">-21.63</td>
<td id="S6.T2.2.14.3" class="ltx_td ltx_align_center ltx_border_t">-15.83</td>
<td id="S6.T2.2.14.4" class="ltx_td ltx_align_center ltx_border_t">-11.55</td>
<td id="S6.T2.2.14.5" class="ltx_td ltx_align_center ltx_border_t">-7.90</td>
<td id="S6.T2.2.14.6" class="ltx_td ltx_align_center ltx_border_t">-11.89</td>
