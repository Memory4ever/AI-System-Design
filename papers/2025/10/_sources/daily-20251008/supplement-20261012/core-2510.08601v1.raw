<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Tables</h2>

<figure id="A3.T1" class="ltx_table">
<div class="ltx_flex_figure ltx_flex_table">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A3.T1.st1" class="ltx_table ltx_figure_panel ltx_align_center">
<table id="A3.T1.st1.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
