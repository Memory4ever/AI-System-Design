<td id="S4.T4.3.1.3.4" class="ltx_td ltx_align_center">5.965<sup id="S4.T4.3.1.3.4.1" class="ltx_sup">†</sup></td>
<td id="S4.T4.3.1.3.5" class="ltx_td ltx_align_center">6.129<sup id="S4.T4.3.1.3.5.1" class="ltx_sup">†</sup></td>
<td id="S4.T4.3.1.3.6" class="ltx_td ltx_align_center">10.05<sup id="S4.T4.3.1.3.6.1" class="ltx_sup">†</sup></td>
