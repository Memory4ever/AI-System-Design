<td id="S4.T5.5.14.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T5.5.14.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#E6E6E6;">25.40</span></td>
<td id="S4.T5.5.14.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T5.5.14.4.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#E6E6E6;">0.7326</span></td>
<td id="S4.T5.5.14.5" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T5.5.14.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">24.71</span></td>
