              <span id="alg1.l21.2" class="ltx_text" style="font-size:70%;">   Use weights </span><math id="alg1.l21.m1" class="ltx_Math" alttext="\mathbf{W}_{3}(\mathcal{F}_{n})\leftarrow\mathbf{W}^{*}(\mathcal{F})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.700em">𝐖</mi><mn mathsize="0.700em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℱ</mi><mi mathsize="0.700em">n</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em" stretchy="false">←</mo><mrow><msup><mi mathsize="0.700em">𝐖</mi><mo mathsize="0.700em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℱ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{W}_{3}(\mathcal{F}_{n})\leftarrow\mathbf{W}^{*}(\mathcal{F})</annotation></semantics></math><span id="alg1.l21.3" class="ltx_text" style="font-size:70%;">, </span><math id="alg1.l21.m2" class="ltx_Math" alttext="\mathbf{W}_{3}(\mathcal{U}_{n})\leftarrow\mathbf{W}_{2}(\mathcal{U}_{n})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.700em">𝐖</mi><mn mathsize="0.700em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒰</mi><mi mathsize="0.700em">n</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.700em">𝐖</mi><mn mathsize="0.700em">2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒰</mi><mi mathsize="0.700em">n</mi></msub><mo maxsize="0.700em" minsize="