<td id="S4.T13.3.4.4" class="ltx_td ltx_align_center"><span id="S4.T13.3.4.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">29.63</span></td>
<td id="S4.T13.3.4.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T13.3.4.5.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">7.771 (89.8%)</span></td>
<td id="S4.T13.3.4.6" class="ltx_td ltx_align_center"><span id="S4.T13.3.4.6.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">6.91</span></td></tr>
<tr id="S4.T13.3.5" class="ltx_tr">
