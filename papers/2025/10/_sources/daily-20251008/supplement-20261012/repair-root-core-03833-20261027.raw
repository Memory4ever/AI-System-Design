<td id="S4.T5.5.14.7" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T5.5.14.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">24.35</span></td>
