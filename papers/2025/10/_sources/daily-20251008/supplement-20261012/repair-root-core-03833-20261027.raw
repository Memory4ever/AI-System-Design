                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
                
              <span id="alg1.l27.2" class="ltx_text" style="font-size:70%;"> </span><span id="alg1.l27.3" class="ltx_text ltx_font_bold" style="font-size:70%;">Output:</span><span id="alg1.l27.4" class="ltx_text" style="font-size:70%;"> Target weights </span><math id="alg1.l27.m1" class="ltx_Math" alttext="\mathbf{W}^{*}(\mathcal{K}_{n})\leftarrow[\mathbf{W}^{*}(\mathcal{F});\{\mathbf{W}^{*}(\mathcal{U}_{n})\}_{n=0}^{N-1}]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathsize="0.700em">𝐖</mi><mo mathsize="0.700em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒦</mi><mi mathsize="0.700em">n</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em" stretchy="false">←</mo><mrow><mo maxsize="0.700em" minsize="0.700em">[</mo><mrow><mrow><msup><mi mathsize="0.700em">𝐖</mi><mo mathsize="0.700em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℱ</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em">;</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><msup><mi mathsize="0.700em">𝐖</mi><mo mathsize="0.700em">∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒰</mi><mi mathsize="0.700em">n</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi mathsize="0.700em">n</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mrow><mi mathsize="0.700em">N</mi><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">1</mn></mrow></msubsup></mrow><mo maxsize="0.700em" minsize="0.700em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{W}^{*}(\mathcal{K}_{n})\leftarrow[\mathbf{W}^{*}(\mathcal{F});\{\mathbf{W}^{*}(\mathcal{U}_{n})\}_{n=0}^{N-1}]</annotation></semantics></math><span id="alg1.l27.5" class="ltx_text" style="font-size:70%;">
</span>
</div>
