<td id="S4.T13.3.5.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">5.702 (82.0%)</td>
<td id="S4.T13.3.5.4" class="ltx_td ltx_align_center ltx_border_b">29.60</td>
<td id="S4.T13.3.5.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">7.093 (82.0%)</td>
