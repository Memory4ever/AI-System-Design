              <span id="alg1.l26.2" class="ltx_text ltx_font_bold" style="font-size:70%;">end</span><span id="alg1.l26.3" class="ltx_text" style="font-size:70%;"> </span><span id="alg1.l26.4" class="ltx_text ltx_font_bold" style="font-size:70%;">for</span>
</div>
