<td id="S4.T1.3.3.4" class="ltx_td ltx_align_center">Vary <math id="S4.T1.m4" class="ltx_Math" alttext="s\sim\mathrm{U}[1,4]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\sim\mathrm{U}[1,4]</annotation></semantics></math></td></tr>
<tr id="S4.T1.3.4" class="ltx_tr">
<th id="S4.T1.3.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_r">3</th>
<td id="S4.T1.3.4.2" class="ltx_td ltx_align_center ltx_border_b">150K</td>
<td id="S4.T1.3.4.3" class="ltx_td ltx_align_center ltx_border_b">Fix <math id="S4.T1.m5" class="ltx_Math" alttext="t=8" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">t=8</annotation></semantics></math></td>
<td id="S4.T1.3.4.4" class="ltx_td ltx_align_center ltx_border_b">Vary <math id="S4.T1.m6" class="ltx_Math" alttext="s\sim\mathrm{U}[1,4]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\sim\mathrm{U}[1,4]</annotation></semantics></math></td></tr>
