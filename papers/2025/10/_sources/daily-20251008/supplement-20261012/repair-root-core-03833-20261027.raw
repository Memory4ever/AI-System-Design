<td id="S4.T14.3.1.7.2" class="ltx_td ltx_align_center ltx_border_b" style="--ltx-bg-color:#E6E6E6;"><span id="S4.T14.3.1.7.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">29.10</span></td>
