<th id="S4.T4.3.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T4.m12" class="ltx_Math" alttext="t=16" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">t=16</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T4.3.1.2" class="ltx_tr">
<th id="S4.T4.3.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">VideoINR <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>]</cite></th>
<td id="S4.T4.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">2.011</td>
<td id="S4.T4.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">2.395</td>
<td id="S4.T4.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">2.779</td>
<td id="S4.T4.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">3.163</td>
