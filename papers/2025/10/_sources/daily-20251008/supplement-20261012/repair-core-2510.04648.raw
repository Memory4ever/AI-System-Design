<span id="A1.T2.2.9.2.1" class="ltx_inline-block ltx_align_middle" style="width:102.4pt;">
<span id="A1.T2.2.9.2.1.1" class="ltx_p ltx_align_left">Opinion Expression</span>
</span></td>
<td id="A1.T2.2.9.3" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A1.T2.2.9.3.1" class="ltx_inline-block ltx_align_middle" style="width:221.9pt;">
<span id="A1.T2.2.9.3.1.1" class="ltx_p ltx_align_left">Refutes or negotiates with others’ statements.</span>
</span></td></tr>
<tr id="A1.T2.2.10" class="ltx_tr">
<td id="A1.T2.2.10.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
