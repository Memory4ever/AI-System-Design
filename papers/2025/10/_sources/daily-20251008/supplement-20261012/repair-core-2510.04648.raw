</figure></div><div class="ltx_flex_cell ltx_flex_size_many">
<figure id="A3.F3.sf3" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2510.04648v1/task3_he_chart.svg" id="A3.F3.sf3.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:548/530;" width="548" height="530"></object>
