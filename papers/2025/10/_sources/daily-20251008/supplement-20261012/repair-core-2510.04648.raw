<figure id="A3.F2.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.04648v1/task2_la_chart.svg" id="A3.F2.sf6.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:548/530;" width="548" height="530"></object>
