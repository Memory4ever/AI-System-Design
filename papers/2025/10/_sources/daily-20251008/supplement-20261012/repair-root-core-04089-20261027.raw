<span id="S4.T1.5.1.1.1.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S4.T1.5.1.1.1.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.5.1.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Methods</span></span>
</span></span>
<span id="S4.T1.5.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.25pt 3.5pt;"><span id="S4.T1.5.1.1.1.2.1" class="ltx_text ltx_font_bold">Math Reasoning</span></span>
<span id="S4.T1.5.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_colspan ltx_colspan_2" style="padding:-0.25pt 3.5pt;"><span id="S4.T1.5.1.1.1.3.1" class="ltx_text ltx_font_bold">Coding</span></span>
<span id="S4.T1.5.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_colspan ltx_colspan_2" style="padding:-0.25pt 3.5pt;"><span id="S4.T1.5.1.1.1.4.1" class="ltx_text ltx_font_bold">Question Answering</span></span>
<span id="S4.T1.5.1.1.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt ltx_rowspan ltx_rowspan_2" style="padding:-0.25pt 3.5pt;"><span id="S4.T1.5.1.1.1.5.1" class="ltx_text ltx_font_bold">AVG</span></span></span>
<span id="S4.T1.5.1.1.2" class="ltx_tr">
<span id="S4.T1.5.1.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_th_row" style="padding:-0.25pt 3.5pt;"></span>
<span id="S4.T1.5.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.25pt 3.5pt;">MATH</span>
<span id="S4.T1.5.1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.25pt 3.5pt;">HumanEval</span>
<span id="S4.T1.5.1.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.25pt 3.5pt;">MBPP</span>
<span id="S4.T1.5.1.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.25pt 3.5pt;">HotpotQA</span>
<span id="S4.T1.5.1.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:-0.25pt 3.5pt;">DROP</span></span>
</span>
<span class="ltx_tbody">
<span id="S4.T1.5.1.1.3" class="ltx_tr">
<span id="S4.T1.5.1.1.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_t" style="padding:-0.25pt 3.5pt;">
<span id="S4.T1.5.1.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S4.T1.5.1.1.3.1.1.1" class="ltx_p ltx_align_left">IO</span>
</span></span>
<span id="S4.T1.5.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 3.5pt;">52.2</span>
<span id="S4.T1.5.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 3.5pt;">90.1</span>
<span id="S4.T1.5.1.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 3.5pt;">69.5</span>
