<span id="S4.T2.5.1.1.5.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S4.T2.5.1.1.5.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9FFDD;">84.3<span id="S4.T2.5.1.1.5.3.1.1" class="ltx_text ltx_font_medium" style="position:relative; bottom:0.9pt;--ltx-fg-color:#004D00;">↑</span><span id="S4.T2.5.1.1.5.3.1.2" class="ltx_text ltx_font_medium" style="position:relative; bottom:0.5pt;--ltx-fg-color:#004D00;">0.2</span></span></span></span>
