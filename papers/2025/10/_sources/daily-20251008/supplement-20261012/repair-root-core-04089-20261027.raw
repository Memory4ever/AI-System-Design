<p id="S4.T4.5" class="ltx_p"><span id="S4.T4.5.1" class="ltx_text ltx_align_center ltx_inline-block" style="font-size:90%;width:496.9pt;">


<span id="S4.T4.5.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_thead">
<span id="S4.T4.5.1.1.1" class="ltx_tr">
<span id="S4.T4.5.1.1.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding:-0.25pt 4.0pt;">
<span id="S4.T4.5.1.1.1.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
