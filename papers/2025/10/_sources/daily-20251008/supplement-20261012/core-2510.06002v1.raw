</div>
<div id="lstnumberx67" class="ltx_listingline"><span id="lstnumberx67.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">    </span><span id="lstnumberx67.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;">"</span><span id="lstnumberx67.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">semantic_query</span><span id="lstnumberx67.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">"</span><span id="lstnumberx67.5" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;">:</span><span id="lstnumberx67.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx67.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">current_text</span><span id="lstnumberx67.8" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span>
</div>
