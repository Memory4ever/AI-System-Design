tx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">the</span><span id="lstnumberx63.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx63.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">change_date</span>
</div>
