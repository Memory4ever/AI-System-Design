<td id="S4.T3.3.6.5" class="ltx_td ltx_align_center" style="padding-top:-0.45pt;padding-bottom:-0.45pt;"><span id="S4.T3.3.6.5.1" class="ltx_text" style="font-size:90%;">44.44</span></td></tr>
