<td id="S5.T7.3.10.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S5.T7.3.10.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">100.0</span></td>
