<th id="S4.T3.3.2.2" class="ltx_td ltx_th ltx_th_column ltx_th_row" style="padding-top:-0.45pt;padding-bottom:-0.45pt;"></th>
<th id="S4.T3.3.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:-0.45pt;padding-bottom:-0.45pt;"><span id="S4.T3.3.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Gemini</span></th>
<th id="S4.T3.3.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:-0.45pt;padding-bottom:-0.45pt;"><span id="S4.T3.3.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-3.5</span></th>
