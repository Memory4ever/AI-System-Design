<span id="S4.T1.3.1.4.1.1" class="ltx_p"><span id="S4.T1.3.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">VM2</span></span>
</span></th>
<th id="S4.T1.3.1.5" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_t">
<span id="S4.T1.3.1.5.1" class="ltx_inline-block ltx_align_top" style="width:11.4pt;">
<span id="S4.T1.3.1.5.1.1" class="ltx_p"><span id="S4.T1.3.1.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">VM3</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.3.2" class="ltx_tr">
<td id="S4.T1.3.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.3.2.1.1" class="ltx_text" style="font-size:80%;">vsftpd 2.3.4 backdoor attack <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">33</a>]</cite></span></td>
<td id="S4.T1.3.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T1.3.2.2.1" class="ltx_text" style="font-size:80%;">4,6,7</span></td>
<td id="S4.T1.3.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T1.3.2.3.1" class="ltx_inline-block ltx_align_top" style="width:11.4pt;">
<span id="S4.T1.3.2.3.1.1" class="ltx_p"><span id="S4.T1.3.2.3.1.1.1" class="ltx_text" style="font-size:80%;">✓</span></span>
</span></td>
<td id="S4.T1.3.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T1.3.2.4.1" class="ltx_inline-block ltx_align_top" style="width:11.4pt;">
<span id="S4.T1.3.2.4.1.1" class="ltx_p"><span id="S4.T1.3.2.4.1.1.1" class="ltx_text" style="font-size:80%;">✓</span></span>
</span></td>
<td id="S4.T1.3.2.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_t"></td></tr>
<tr id="S4.T1.3.3" class="ltx_tr">
<td id="S4.T1.3.3.1" class="ltx_td ltx_align_left"><span id="S4.T1.3.3.1.1" class="ltx_text" style="font-size:80%;">OpenSSH username enumeration <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite></span></td>
