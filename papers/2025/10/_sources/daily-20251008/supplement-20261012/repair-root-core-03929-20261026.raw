<div id="alg3.l10" class="ltx_listingline">
            
            
              <span id="alg3.l10.2" class="ltx_text ltx_font_bold">if</span>  <math id="alg3.l10.m1" class="ltx_math_unparsed" alttext="U&lt;\text{min}\left(1,\overset{\rightarrow}{p}_{\theta,\phi}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}),\phi(\hat{\bm{x}}^{\sigma(i+1:d-1)}))/\overset{\leftrightarrow}{p}_{\theta}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}))\right)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>&lt;</mo><mtext>min</mtext><mrow><mo>(</mo><mn>1</mn><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">U&lt;\text{min}\left(1,\overset{\rightarrow}{p}_{\theta,\phi}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}),\phi(\hat{\bm{x}}^{\sigma(i+1:d-1)}))/\overset{\leftrightarrow}{p}_{\theta}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}))\right)</annotation></semantics></math> <span id="alg3.l10.3" class="ltx_text ltx_font_bold">then</span>



