<tbody id="A3.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E63.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E63.m2" class="ltx_Math" alttext="\displaystyle\qquad\vdots" display="inline" intent=":literal"><semantics><mi mathvariant="normal">⋮</mi><annotation encoding="application/x-tex">\displaystyle\qquad\vdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
<tbody id="A3.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E64.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E64.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{k=1}^{d}p_{\theta,\phi}(\bm{x}^{1:k-1},R^{k-1})p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})," display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=1}^{d}p_{\theta,\phi}(\bm{x}^{1:k-1},R^{k-1})p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p8.2" class="ltx_p">where <math id="A3.SS1.p8.m2" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:0},R^{0})=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:0},R^{0})=1</annotation></semantics></math> and <math id="A3.SS1.p8.m3" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{d:d},A^{d:d-1},R^{d}|\bm{x}^{1:d-1},R^{d-1})=p_{\theta,\phi}(\bm{x}^{d},R^{d}|\bm{x}^{1:d-1},R^{d-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{d:d},A^{d:d-1},R^{d}|\bm{x}^{1:d-1},R^{d-1})=p_{\theta,\phi}(\bm{x}^{d},R^{d}|\bm{x}^{1:d-1},R^{d-1})</annotation></semantics></math> by definition.
<br class="ltx_break"></p>
</div>
<div id="A3.SS1.p9" class="ltx_para ltx_noindent">
<p id="A3.SS1.p9.1" class="ltx_p">We can efficiently compute all the required values of <math id="A3.SS1.p9.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})</annotation></semantics></math> for all <math id="A3.SS1.p9.m2" class="ltx_Math" alttext="d\geq k" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">d\geq k</annotation></semantics></math>. We first split each term as</p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E65.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
<tbody id="A3.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E66.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E66.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{k:d-1},A^{k:d-1}|\bm{x}^{1:k-1},R^{k-1})p_{\theta,\phi}(\bm{x}^{d},R^{d}|\bm{x}^{1:d-1},A^{k:d-1},R^{k-1})." display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{k:d-1},A^{k:d-1}|\bm{x}^{1:k-1},R^{k-1})p_{\theta,\phi}(\bm{x}^{d},R^{d}|\bm{x}^{1:d-1},A^{k:d-1},R^{k-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p10" class="ltx_para ltx_noindent">
<p id="A3.SS1.p10.1" class="ltx_p">By Lemma <a href="#A3.Thmtheorem1" title="Lemma C.1. ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>, we have that</p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E67.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{k:d-1},A^{k:d-1}|\bm{x}^{1:k-1},R^{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{k:d-1},A^{k:d-1}|\bm{x}^{1:k-1},R^{k-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
<tbody id="A3.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E68.m1" class="ltx_math_unparsed" alttext="\displaystyle=\prod_{l=k}^{d-1}p_{\theta,\phi}(\bm{x}^{l},A^{l}|\bm{x}^{1:l-1},A^{k:l-1},R^{k-1})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>=</mo><mi>k</mi></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo>,</mo><msup><mi>A</mi><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{l=k}^{d-1}p_{\theta,\phi}(\bm{x}^{l},A^{l}|\bm{x}^{1:l-1},A^{k:l-1},R^{k-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
<tbody id="A3.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E69.m1" class="ltx_math_unparsed" alttext="\displaystyle=\prod_{l=k}^{d-1}\text{min}\left(\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{l}|\theta(\bm{x}^{1:k-1})),\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{l}|\theta(\bm{x}^{1:k-1}),\phi(\bm{x}^{k:l-1}))\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>l</mi><mo>=</mo><mi>k</mi></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mtext>min</mtext><mrow><mo>(</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>l</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{l=k}^{d-1}\text{min}\left(\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{l}|\theta(\bm{x}^{1:k-1})),\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{l}|\theta(\bm{x}^{1:k-1}),\phi(\bm{x}^{k:l-1}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p10.2" class="ltx_p">Therefore, we can just keep extending this product and obtain all of</p>
<table id="A3.E70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E70.m1" class="ltx_math_unparsed" alttext="\Big\{p_{\theta,\phi}(\bm{x}^{k:d-1},A^{k:d-1}|\bm{x}^{1:k-1},R^{k-1})\Big\}_{d=k+1}^{D}" display="block" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>d</mi><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>D</mi></msubsup><annotation encoding="application/x-tex">\Big\{p_{\theta,\phi}(\bm{x}^{k:d-1},A^{k:d-1}|\bm{x}^{1:k-1},R^{k-1})\Big\}_{d=k+1}^{D}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p10.3" class="ltx_p">in just <math id="A3.SS1.p10.m1" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> operations.
<br class="ltx_break"></p>
</div>
<div id="A3.SS1.p11" class="ltx_para ltx_noindent">
<p id="A3.SS1.p11.1" class="ltx_p">To obtain the required <math id="A3.SS1.p11.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})</annotation></semantics></math> distributions in Equation <a href="#A3.E66" title="Equation 66 ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">66</span></a> , we need to compute the additional rejection factor, for which we again make use of Lemma <a href="#A3.Thmtheorem1" title="Lemma C.1. ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a></p>
<table id="A3.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E71.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{d},R^{d}|\bm{x}^{1:d-1},A^{k:d-1},R^{k-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{d},R^{d}|\bm{x}^{1:d-1},A^{k:d-1},R^{k-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr></tbody>
<tbody id="A3.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E72.m1" class="ltx_math_unparsed" alttext="\displaystyle=\text{max}\left(0,\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{d}|\theta(\bm{x}^{1:k-1}),\phi(\bm{x}^{k:d-1}))-\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{d}|\theta(\bm{x}^{1:k-1}))\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mtext>max</mtext><mrow><mo>(</mo><mn>0</mn><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\text{max}\left(0,\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{d}|\theta(\bm{x}^{1:k-1}),\phi(\bm{x}^{k:d-1}))-\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{d}|\theta(\bm{x}^{1:k-1}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(72)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p11.2" class="ltx_p">We can therefore obtain</p>
<table id="A3.E73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E73.m1" class="ltx_math_unparsed" alttext="\Big\{p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})\Big\}_{d=k}^{D}" display="block" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>d</mi><mo>=</mo><mi>k</mi></mrow><mi>D</mi></msubsup><annotation encoding="application/x-tex">\Big\{p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})\Big\}_{d=k}^{D}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(73)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p11.3" class="ltx_p">in <math id="A3.SS1.p11.m2" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> operations. Allowing <math id="A3.SS1.p11.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to vary as well, we can obtain</p>
<table id="A3.E74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E74.m1" class="ltx_math_unparsed" alttext="\Big\{p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})\Big\}_{k\leq d}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>≤</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\Big\{p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d}|\bm{x}^{1:k-1},R^{k-1})\Big\}_{k\leq d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(74)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p11.4" class="ltx_p">in <math id="A3.SS1.p11.m4" class="ltx_Math" alttext="O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{2})</annotation></semantics></math> operations.</p>
</div>
<div id="A3.SS1.p12" class="ltx_para ltx_noindent">
<p id="A3.SS1.p12.1" class="ltx_p">Once, we have all of these values pre-computed we can use our formula for <math id="A3.SS1.p12.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d})</annotation></semantics></math> in Equation <a href="#A3.E64" title="Equation 64 ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">64</span></a> to compute all of</p>
<table id="A3.E75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E75.m1" class="ltx_math_unparsed" alttext="\Big\{p_{\theta,\phi}(\bm{x}^{1:d},R^{d})\Big\}_{d=1}^{D}" display="block" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></msubsup><annotation encoding="application/x-tex">\Big\{p_{\theta,\phi}(\bm{x}^{1:d},R^{d})\Big\}_{d=1}^{D}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(75)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p12.2" class="ltx_p">in <math id="A3.SS1.p12.m2" class="ltx_Math" alttext="O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{2})</annotation></semantics></math> operations. The total cost so far is then <math id="A3.SS1.p12.m3" class="ltx_Math" alttext="O(D^{2}+D^{2})=O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>D</mi><mn>2</mn></msup><mo>+</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(D^{2}+D^{2})=O(D^{2})</annotation></semantics></math>.
<br class="ltx_break"></p>
</div>
<div id="A3.SS1.p13" class="ltx_para ltx_noindent">
<p id="A3.SS1.p13.1" class="ltx_p">The final point of order is obtaining <math id="A3.SS1.p13.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})</annotation></semantics></math>. By Lemma <a href="#A3.Thmtheorem1" title="Lemma C.1. ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> we have</p>
<table id="A3.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E76.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E76.m2" class="ltx_math_unparsed" alttext="\displaystyle=\prod_{d=1}^{D}p_{\theta,\phi}(\bm{x}^{d},A^{d}|\bm{x}^{1:d-1},A^{1:d-1})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo>,</mo><msup><mi>A</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{d=1}^{D}p_{\theta,\phi}(\bm{x}^{d},A^{d}|\bm{x}^{1:d-1},A^{1:d-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
<tbody id="A3.E77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E77.m1" class="ltx_math_unparsed" alttext="\displaystyle=\prod_{d=1}^{D}\text{min}\left(\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{d}|\theta(\emptyset)),\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{d}|\theta(\emptyset),\phi(\bm{x}^{1:d-1}))\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mtext>min</mtext><mrow><mo>(</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{d=1}^{D}\text{min}\left(\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{d}|\theta(\emptyset)),\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{d}|\theta(\emptyset),\phi(\bm{x}^{1:d-1}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p14" class="ltx_para ltx_noindent">
<p id="A3.SS1.p14.1" class="ltx_p">We now have all the required quantities to compute the full likelihood as</p>
<table id="A3.E78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E78.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:D})=p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})+\sum_{d=1}^{D}p_{\theta,\phi}(\bm{x}^{1:d},R^{d})p_{\theta,\phi}(\bm{x}^{d+1:D},A^{d+1:D}|\bm{x}^{1:d},R^{d})." display="block" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">+</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:D})=p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})+\sum_{d=1}^{D}p_{\theta,\phi}(\bm{x}^{1:d},R^{d})p_{\theta,\phi}(\bm{x}^{d+1:D},A^{d+1:D}|\bm{x}^{1:d},R^{d}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p14.2" class="ltx_p">Computing all the <math id="A3.SS1.p14.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d})</annotation></semantics></math> quantities cost <math id="A3.SS1.p14.m2" class="ltx_Math" alttext="O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{2})</annotation></semantics></math> operations. Computing <math id="A3.SS1.p14.m3" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{d+1:D},A^{d+1:D}|\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{d+1:D},A^{d+1:D}|\bm{x}^{1:d},R^{d})</annotation></semantics></math> cost <math id="A3.SS1.p14.m4" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> each so computing all these required factors is another <math id="A3.SS1.p14.m5" class="ltx_Math" alttext="O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{2})</annotation></semantics></math> cost. Computing <math id="A3.SS1.p14.m6" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D})</annotation></semantics></math> is just <math id="A3.SS1.p14.m7" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math>. Therefore, the total cost of getting the full likelihood is <math id="A3.SS1.p14.m8" class="ltx_Math" alttext="O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{2})</annotation></semantics></math>.
<br class="ltx_break"></p>
</div>
<div id="A3.SS1.p15" class="ltx_para ltx_noindent">
<p id="A3.SS1.p15.1" class="ltx_p">An important note is to count how many forward passes of the neural networks are required. The required distributions are</p>
<table id="A3.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E79.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{d}|\theta(\bm{x}^{1:k}))\quad\forall d&gt;k" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∀</mo><mi>d</mi><mo>&gt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{d}|\theta(\bm{x}^{1:k}))\quad\forall d&gt;k</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(79)</span></td></tr></tbody>
<tbody id="A3.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E80.m1" class="ltx_math_unparsed" alttext="\displaystyle\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{d}|\theta(\bm{x}^{1:k}),\phi(\bm{x}^{k+1:d-1}))\quad\forall d&gt;k" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∀</mo><mi>d</mi><mo>&gt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{d}|\theta(\bm{x}^{1:k}),\phi(\bm{x}^{k+1:d-1}))\quad\forall d&gt;k</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p15.2" class="ltx_p">which in total is only <math id="A3.SS1.p15.m1" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> forward passes. So although we need to perform <math id="A3.SS1.p15.m2" class="ltx_Math" alttext="O(D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D^{2})</annotation></semantics></math> total operations, there are only <math id="A3.SS1.p15.m3" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> expensive neural network operations required.
<br class="ltx_break"></p>
</div>
<div id="A3.SS1.p16" class="ltx_para ltx_noindent">
<p id="A3.SS1.p16.1" class="ltx_p">Now we remove the assumption that the ordering is fixed when calculating the likelihood. Let us assume some distribution over orderings, <math id="A3.SS1.p16.m1" class="ltx_Math" alttext="\sigma\sim p(\sigma)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma\sim p(\sigma)</annotation></semantics></math> that we use to calculate our likelihood e.g. uniform. A bound on the log-likelihood is therefore</p>
<table id="A3.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E81.m1" class="ltx_math_unparsed" alttext="\displaystyle\log p_{\theta,\phi}(\bm{x}^{1:D})" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log p_{\theta,\phi}(\bm{x}^{1:D})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E81.m2" class="ltx_math_unparsed" alttext="\displaystyle\geq\mathbb{E}_{p(\sigma)}\left[\log p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)\right]" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><msub><mi>𝔼</mi><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo>[</mo><mi>log</mi><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\mathbb{E}_{p(\sigma)}\left[\log p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p16.2" class="ltx_p">For a given <math id="A3.SS1.p16.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>, we can calculate <math id="A3.SS1.p16.m3" class="ltx_math_unparsed" alttext="\log p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)</annotation></semantics></math> as above, just assuming we generate in the ordering given by <math id="A3.SS1.p16.m4" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>. Therefore, we can obtain an estimate of a lower bound on the log-likelihood by sampling <math id="A3.SS1.p16.m5" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> and calculating <math id="A3.SS1.p16.m6" class="ltx_math_unparsed" alttext="\log p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)</annotation></semantics></math>. To compute the <math id="A3.SS1.p16.m7" class="ltx_Math" alttext="\log" display="inline" intent=":literal"><semantics><mi>log</mi><annotation encoding="application/x-tex">\log</annotation></semantics></math> of sums of probabilities, we use LogSumExp for numerical stability.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Number of Rejections</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">Here we derive an expression for the distribution over the number of rejections during the speculative sampling procedure given in Algorithm <a href="#alg2" title="Algorithm 2 ‣ 3.3 Sampling Procedure ‣ 3 Self-Speculative Masked Diffusions ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. The number of forward passes required to generate <math id="A3.SS2.p1.m1" class="ltx_math_unparsed" alttext="\bm{x}^{1:D}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{x}^{1:D}</annotation></semantics></math> is then one more than the number of rejections. We now formally state and prove our result.</p>
</div>
<div id="A3.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition C.2</span></span><span id="A3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="A3.Thmtheorem2.p1.1" class="ltx_p"><span id="A3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Consider the sampling scheme defined by Algorithm <a href="#alg2" title="Algorithm 2 ‣ 3.3 Sampling Procedure ‣ 3 Self-Speculative Masked Diffusions ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Let <math id="A3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="N^{d}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mi>d</mi></msup><annotation encoding="application/x-tex">N^{d}</annotation></semantics></math> be the number of rejections occurring in the algorithm up until dimension <math id="A3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> in the ordering. The posterior of <math id="A3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="N^{d}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mi>d</mi></msup><annotation encoding="application/x-tex">N^{d}</annotation></semantics></math> given a datapoint and specific ordering is</span></p>
<table id="A3.E82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E82.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(N^{D}|\bm{x}^{\sigma(1:D)},\sigma)=\frac{p_{\theta,\phi}(\bm{x}^{1:D},N^{D}|\sigma)}{p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)}" display="block" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><mi>N</mi><msup><mrow></mrow><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(N^{D}|\bm{x}^{\sigma(1:D)},\sigma)=\frac{p_{\theta,\phi}(\bm{x}^{1:D},N^{D}|\sigma)}{p_{\theta,\phi}(\bm{x}^{1:D}|\sigma)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p1.2" class="ltx_p"><span id="A3.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="A3.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E83.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},N^{D}|\sigma)=" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},N^{D}|\sigma)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E83.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},R^{D},N^{D}|\sigma)+" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},R^{D},N^{D}|\sigma)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
<tbody id="A3.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E84.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{d=1}^{D}\sum_{N^{d-1}}\Bigg\{p_{\theta,\phi}(\bm{x}^{1:d-1},R^{d-1},N^{d-1}|\sigma)\times" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></munder></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>×</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{d=1}^{D}\sum_{N^{d-1}}\Bigg\{p_{\theta,\phi}(\bm{x}^{1:d-1},R^{d-1},N^{d-1}|\sigma)\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
<tbody id="A3.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E85.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 48.36958ptp_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1},\sigma)\Bigg\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 48.36958ptp_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1},\sigma)\Bigg\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p1.3" class="ltx_p"><span id="A3.Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">with</span></p>
<table id="A3.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E86.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d}|\sigma)=" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d}|\sigma)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E86.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{1:d-1},R^{d},N^{d}|\sigma)+" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{1:d-1},R^{d},N^{d}|\sigma)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
<tbody id="A3.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E87.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum_{k=2}^{d}\sum_{N^{k-1}}\Bigg\{p_{\theta,\phi}(\bm{x}^{1:k-1},R^{k-1},N^{k-1}|\sigma)\times" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>N</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></munder></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>×</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{k=2}^{d}\sum_{N^{k-1}}\Bigg\{p_{\theta,\phi}(\bm{x}^{1:k-1},R^{k-1},N^{k-1}|\sigma)\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
<tbody id="A3.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E88.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 48.36958ptp_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d},N^{d}|\bm{x}^{1:k-1},R^{k-1},N^{k-1},\sigma)\Bigg\}." display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 48.36958ptp_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d},N^{d}|\bm{x}^{1:k-1},R^{k-1},N^{k-1},\sigma)\Bigg\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p1.4" class="ltx_p"><span id="A3.Thmtheorem2.p1.4.1" class="ltx_text ltx_font_italic">where the quantities <math id="A3.Thmtheorem2.p1.m4" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1},\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐱</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1},\sigma)</annotation></semantics></math>, <math id="A3.Thmtheorem2.p1.m5" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},A^{1:d-1},R^{d},N^{d}|\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},A^{1:d-1},R^{d},N^{d}|\sigma)</annotation></semantics></math> and <math id="A3.Thmtheorem2.p1.m6" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d},N^{d}|\bm{x}^{1:k-1},R^{k-1},N^{k-1},\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐱</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{k:d},A^{k:d-1},R^{d},N^{d}|\bm{x}^{1:k-1},R^{k-1},N^{k-1},\sigma)</annotation></semantics></math> are directly calculable in terms of <math id="A3.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\overset{\leftrightarrow}{p}_{\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><annotation encoding="application/x-tex">\overset{\leftrightarrow}{p}_{\theta}</annotation></semantics></math> and <math id="A3.Thmtheorem2.p1.m8" class="ltx_Math" alttext="\overset{\rightarrow}{p}_{\theta,\phi}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><annotation encoding="application/x-tex">\overset{\rightarrow}{p}_{\theta,\phi}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.Thmtheorem2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.Thmtheorem2.p2" class="ltx_para ltx_noindent">
<p id="A3.Thmtheorem2.p2.1" class="ltx_p"><span id="A3.Thmtheorem2.p2.1.1" class="ltx_text">For notational simplicity, in the following we will drop the <math id="A3.Thmtheorem2.p2.m1" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> conditioning with it understood that <math id="A3.Thmtheorem2.p2.m2" class="ltx_math_unparsed" alttext="\bm{x}^{1:D}=\bm{x}^{\sigma(1:D)}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>=</mo><mi>𝒙</mi><msup><mrow></mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{x}^{1:D}=\bm{x}^{\sigma(1:D)}</annotation></semantics></math> and similarly for other random variables. All quantities are conditioned on the same ordering, <math id="A3.Thmtheorem2.p2.m3" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>, and so this does not affect our results.</span></p>
</div>
<div id="A3.Thmtheorem2.p3" class="ltx_para ltx_noindent">
<p id="A3.Thmtheorem2.p3.1" class="ltx_p"><span id="A3.Thmtheorem2.p3.1.1" class="ltx_text">By Bayes’ rule, our quantity of interest is given by,</span></p>
<table id="A3.E89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E89.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(N^{D}|\bm{x}^{1:D})=\frac{p_{\theta,\phi}(\bm{x}^{1:D},N^{D})}{p_{\theta,\phi}(\bm{x}^{1:D})}." display="block" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mrow><mi>p</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><mi>N</mi><msup><mrow></mrow><mi>D</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mo stretchy="false">(</mo><mi>𝒙</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(N^{D}|\bm{x}^{1:D})=\frac{p_{\theta,\phi}(\bm{x}^{1:D},N^{D})}{p_{\theta,\phi}(\bm{x}^{1:D})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p3.2" class="ltx_p"><span id="A3.Thmtheorem2.p3.2.1" class="ltx_text">The denominator can be obtained from Proposition <a href="#S3.Thmtheorem1" title="Proposition 3.1. ‣ 3.4 Theoretical Results ‣ 3 Self-Speculative Masked Diffusions ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> but we need to establish an expression for the numerator. We will use the same recursive decomposition technique to derive the numerator. The central object of the recursion will be</span></p>
<table id="A3.E90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E90.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})=p_{\theta,\phi}(\bm{x}^{1:d},R^{d})p_{\theta,\phi}(N^{d}|\bm{x}^{1:d},R^{d})," display="block" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})=p_{\theta,\phi}(\bm{x}^{1:d},R^{d})p_{\theta,\phi}(N^{d}|\bm{x}^{1:d},R^{d}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p3.3" class="ltx_p"><span id="A3.Thmtheorem2.p3.3.1" class="ltx_text">where we can represent <math id="A3.Thmtheorem2.p3.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(N^{d}|\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(N^{d}|\bm{x}^{1:d},R^{d})</annotation></semantics></math> as just a <math id="A3.Thmtheorem2.p3.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>-dimensional probability vector (as the probability of more than <math id="A3.Thmtheorem2.p3.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> rejects is <math id="A3.Thmtheorem2.p3.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>). We can obtain <math id="A3.Thmtheorem2.p3.m5" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d})</annotation></semantics></math> from the same calculations as in Proposition <a href="#S3.Thmtheorem1" title="Proposition 3.1. ‣ 3.4 Theoretical Results ‣ 3 Self-Speculative Masked Diffusions ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>. We first write <math id="A3.Thmtheorem2.p3.m6" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:D},N^{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:D},N^{D})</annotation></semantics></math> in terms of <math id="A3.Thmtheorem2.p3.m7" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})</annotation></semantics></math>,</span></p>
<table id="A3.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E91.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},N^{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},N^{D})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
<tbody id="A3.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E92.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E92.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{D},N^{D})+p_{\theta,\phi}(\bm{x}^{1:D},R^{D},N^{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{D},N^{D})+p_{\theta,\phi}(\bm{x}^{1:D},R^{D},N^{D})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
<tbody id="A3.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E93.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E93.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{D-1},A^{D},N^{D})+p(\bm{x}^{1:D},R^{D-1},A^{D},N^{D})+p(\bm{x}^{1:D},R^{D},N^{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>A</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>A</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{D-1},A^{D},N^{D})+p(\bm{x}^{1:D},R^{D-1},A^{D},N^{D})+p(\bm{x}^{1:D},R^{D},N^{D})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
<tbody id="A3.E94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E94.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
