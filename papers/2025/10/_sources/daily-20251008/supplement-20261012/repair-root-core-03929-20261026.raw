<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
<tbody id="A3.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E40.m1" class="ltx_Math" alttext="\displaystyle=p_{\text{res}}(\bm{x})\sum_{\hat{\bm{x}}}\overset{\leftrightarrow}{p}(\hat{\bm{x}})\left(1-\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>p</mi><mtext>res</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mtext>min</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=p_{\text{res}}(\bm{x})\sum_{\hat{\bm{x}}}\overset{\leftrightarrow}{p}(\hat{\bm{x}})\left(1-\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)\right)</annotation></semantics></math></td>
