<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E34.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{\hat{\bm{x}}}\overset{\leftrightarrow}{p}(\hat{\bm{x}})\updelta\{\bm{x}=\hat{\bm{x}}\}\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">δ</mi><mrow><mo stretchy="false">{</mo><mi>𝒙</mi><mo>=</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">}</mo></mrow><mtext>min</mtext><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}}\overset{\leftrightarrow}{p}(\hat{\bm{x}})\updelta\{\bm{x}=\hat{\bm{x}}\}\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)</annotation></semantics></math></td>
