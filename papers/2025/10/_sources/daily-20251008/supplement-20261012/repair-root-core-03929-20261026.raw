<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(108)</span></td></tr></tbody>
<tbody id="A3.E109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E109.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E109.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{d=1}^{D}\sum_{N^{d-1}}p_{\theta,\phi}(\bm{x}^{1:d-1},R^{d-1},N^{d-1})p_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><mi>D</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></munder></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{d=1}^{D}\sum_{N^{d-1}}p_{\theta,\phi}(\bm{x}^{1:d-1},R^{d-1},N^{d-1})p_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(109)</span></td></tr></tbody>
<tbody id="A3.E110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E110.m1" class="ltx_math_unparsed" alttext="\displaystyle+p_{\theta,\phi}(\bm{x}^{1:D},R^{D},N^{D})," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>D</mi></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+p_{\theta,\phi}(\bm{x}^{1:D},R^{D},N^{D}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(110)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p3.4" class="ltx_p"><span id="A3.Thmtheorem2.p3.4.1" class="ltx_text">where <math id="A3.Thmtheorem2.p3.m8" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:0},R^{0},N^{0})=1.0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mn>0</mn></msup><mo>,</mo><msup><mi>N</mi><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:0},R^{0},N^{0})=1.0</annotation></semantics></math> and <math id="A3.Thmtheorem2.p3.m9" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D},N^{D}|\bm{x}^{1:0},R^{0},N^{0})=p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D},N^{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mn>0</mn></msup><mo>,</mo><msup><mi>N</mi><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D},N^{D}|\bm{x}^{1:0},R^{0},N^{0})=p_{\theta,\phi}(\bm{x}^{1:D},A^{1:D},N^{D})</annotation></semantics></math> by definition. This is tractable to compute because we can compute the inner term as</span></p>
<table id="A3.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E111.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{d:D},A^{d:D},N^{D}|\bm{x}^{1:d-1},R^{d-1},N^{d-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(111)</span></td></tr></tbody>
<tbody id="A3.E112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E112.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E112.m2" class="ltx_math_unparsed" alttext="\displaystyle\left\{\prod_{k=d}^{D}p_{\theta,\phi}(\bm{x}^{k},A^{k}|\bm{x}^{1:k-1},A^{d:k-1},R^{d-1},N^{d-1})\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>d</mi></mrow><mi>D</mi></munderover></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>k</mi></msup><mo>,</mo><msup><mi>A</mi><mi>k</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{\prod_{k=d}^{D}p_{\theta,\phi}(\bm{x}^{k},A^{k}|\bm{x}^{1:k-1},A^{d:k-1},R^{d-1},N^{d-1})\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(112)</span></td></tr></tbody>
<tbody id="A3.E113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E113.m1" class="ltx_math_unparsed" alttext="\displaystyle\times p_{\theta,\phi}(N^{D}|\bm{x}^{1:D},A^{d:D},R^{d-1},N^{d-1})." display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">×</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\times p_{\theta,\phi}(N^{D}|\bm{x}^{1:D},A^{d:D},R^{d-1},N^{d-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(113)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p3.5" class="ltx_p"><span id="A3.Thmtheorem2.p3.5.1" class="ltx_text">The distributions over <math id="A3.Thmtheorem2.p3.m10" class="ltx_Math" alttext="\bm{x}^{k},A^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒙</mi><mi>k</mi></msup><mo>,</mo><msup><mi>A</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\bm{x}^{k},A^{k}</annotation></semantics></math> are just the same as those in the proof of Proposition <a href="#S3.Thmtheorem1" title="Proposition 3.1. ‣ 3.4 Theoretical Results ‣ 3 Self-Speculative Masked Diffusions ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> as the extra conditioning over the number of rejections up to dimension <math id="A3.Thmtheorem2.p3.m11" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math>, <math id="A3.Thmtheorem2.p3.m12" class="ltx_Math" alttext="N^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">N^{d-1}</annotation></semantics></math>, does not provide anymore relevant information than is already provided in the conditioning on <math id="A3.Thmtheorem2.p3.m13" class="ltx_Math" alttext="R^{d-1}." display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R^{d-1}.</annotation></semantics></math>
The distribution in Equation <a href="#A3.E113" title="Equation 113 ‣ Proof. ‣ Proposition C.2. ‣ C.2 Number of Rejections ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">113</span></a> is new however and is given by</span></p>
<table id="A3.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E114.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(N^{D}|\bm{x}^{1:D},A^{d:D},R^{d-1},N^{d-1})=\updelta\{N^{D}=N^{d-1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi mathvariant="normal">δ</mi><mrow><mo stretchy="false">{</mo><msup><mi>N</mi><mi>D</mi></msup><mo>=</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(N^{D}|\bm{x}^{1:D},A^{d:D},R^{d-1},N^{d-1})=\updelta\{N^{D}=N^{d-1}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(114)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem2.p3.6" class="ltx_p"><span id="A3.Thmtheorem2.p3.6.1" class="ltx_text">because we condition on all accepts between <math id="A3.Thmtheorem2.p3.m14" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and <math id="A3.Thmtheorem2.p3.m15" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> so <math id="A3.Thmtheorem2.p3.m16" class="ltx_Math" alttext="N^{D}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mi>D</mi></msup><annotation encoding="application/x-tex">N^{D}</annotation></semantics></math> is the same as <math id="A3.Thmtheorem2.p3.m17" class="ltx_Math" alttext="N^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">N^{d-1}</annotation></semantics></math>.
<br class="ltx_break"></span></p>
</div>
<div id="A3.Thmtheorem2.p4" class="ltx_para ltx_noindent">
<p id="A3.Thmtheorem2.p4.1" class="ltx_p"><span id="A3.Thmtheorem2.p4.1.1" class="ltx_text">Now we find a recursion for <math id="A3.Thmtheorem2.p4.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})</annotation></semantics></math></span></p>
<table id="A3.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E115.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},R^{d},N^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(115)</span></td></tr></tbody>
<tbody id="A3.E116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E116.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E116.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-1},R^{d},N^{d})+p_{\theta,\phi}(\bm{x}^{1:d},R^{d-1},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-1},R^{d},N^{d})+p_{\theta,\phi}(\bm{x}^{1:d},R^{d-1},R^{d},N^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(116)</span></td></tr></tbody>
<tbody id="A3.E117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E117.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E117.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-1},R^{d},N^{d})+\sum_{N^{d-1}}p_{\theta,\phi}(\bm{x}^{1:d},R^{d-1},N^{d-1},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></munder></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-1},R^{d},N^{d})+\sum_{N^{d-1}}p_{\theta,\phi}(\bm{x}^{1:d},R^{d-1},N^{d-1},R^{d},N^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(117)</span></td></tr></tbody>
<tbody id="A3.E118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E118.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E118.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-1},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-1},R^{d},N^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(118)</span></td></tr></tbody>
<tbody id="A3.E119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E119.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{N^{d-1}}p_{\theta,\phi}(\bm{x}^{1:d-1},R^{d-1},N^{d-1})p_{\theta,\phi}(\bm{x}^{d},R^{d},N^{d}|\bm{x}^{1:d-1},R^{d-1},N^{d-1})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></munder></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>d</mi></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{N^{d-1}}p_{\theta,\phi}(\bm{x}^{1:d-1},R^{d-1},N^{d-1})p_{\theta,\phi}(\bm{x}^{d},R^{d},N^{d}|\bm{x}^{1:d-1},R^{d-1},N^{d-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(119)</span></td></tr></tbody>
<tbody id="A3.E120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E120.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E120.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-2:d-1},R^{d},N^{d})+p_{\theta,\phi}(\bm{x}^{1:d},R^{d-2},A^{d-1},R^{d},N^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>N</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},A^{d-2:d-1},R^{d},N^{d})+p_{\theta,\phi}(\bm{x}^{1:d},R^{d-2},A^{d-1},R^{d},N^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(120)</span></td></tr></tbody>
<tbody id="A3.E121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
