               Reject <math id="alg3.l13.m1" class="ltx_Math" alttext="\hat{\bm{x}}^{\sigma(d)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">\hat{\bm{x}}^{\sigma(d)}</annotation></semantics></math> and resample <math id="alg3.l13.m2" class="ltx_Math" alttext="\hat{\bm{x}}^{\sigma(d)}\sim\tilde{p}(\hat{\bm{x}}^{\sigma(d)})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>∼</mo><mrow><mover accent="true"><mi>p</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{x}}^{\sigma(d)}\sim\tilde{p}(\hat{\bm{x}}^{\sigma(d)})</annotation></semantics></math> where

