<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E104.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{D-2:D},N^{D})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:D},A^{D-2:D},N^{D})</annotation></semantics></math></td>
