<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E44.m1" class="ltx_Math" alttext="\displaystyle=\frac{\text{max}(0,\overset{\rightarrow}{p}(\bm{x})-\overset{\leftrightarrow}{p}(\bm{x}))}{\sum_{z}\text{max}(0,\overset{\rightarrow}{p}(z)-\overset{\leftrightarrow}{p}(z))}\sum_{\hat{\bm{x}}}\text{max}(0,\overset{\rightarrow}{p}(\hat{\bm{x}})-\overset{\leftrightarrow}{p}(\hat{\bm{x}}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mtext>max</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mi>z</mi></msub><mrow><mtext>max</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mrow><mtext>max</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\text{max}(0,\overset{\rightarrow}{p}(\bm{x})-\overset{\leftrightarrow}{p}(\bm{x}))}{\sum_{z}\text{max}(0,\overset{\rightarrow}{p}(z)-\overset{\leftrightarrow}{p}(z))}\sum_{\hat{\bm{x}}}\text{max}(0,\overset{\rightarrow}{p}(\hat{\bm{x}})-\overset{\leftrightarrow}{p}(\hat{\bm{x}}))</annotation></semantics></math></td>
