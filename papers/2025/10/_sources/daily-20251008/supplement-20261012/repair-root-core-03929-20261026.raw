<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E39.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{\hat{\bm{x}}}\int_{U=0}^{U=1}\overset{\leftrightarrow}{p}(\hat{\bm{x}})p_{\text{res}}(\bm{x})\delta\left\{U&gt;\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)\right\}\mathrm{d}U" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>U</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>U</mi><mo>=</mo><mn>1</mn></mrow></msubsup></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mtext>res</mtext></msub><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mi>δ</mi><mrow><mo>{</mo><mi>U</mi><mo>&gt;</mo><mtext>min</mtext><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>}</mo></mrow><mi>d</mi><mi>U</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}}\int_{U=0}^{U=1}\overset{\leftrightarrow}{p}(\hat{\bm{x}})p_{\text{res}}(\bm{x})\delta\left\{U&gt;\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)\right\}\mathrm{d}U</annotation></semantics></math></td>
