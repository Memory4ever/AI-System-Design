               <math id="alg3.l14.m1" class="ltx_math_unparsed" alttext="\quad\tilde{p}(\hat{\bm{x}}^{\sigma(d)})\propto\text{max}\left(0,\overset{\rightarrow}{p}_{\theta,\phi}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}),\phi(\hat{\bm{x}}^{\sigma(i+1:d-1)}))-\overset{\leftrightarrow}{p}_{\theta}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}))\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>p</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>∝</mo><mtext>max</mtext><mrow><mo>(</mo><mn>0</mn><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\quad\tilde{p}(\hat{\bm{x}}^{\sigma(d)})\propto\text{max}\left(0,\overset{\rightarrow}{p}_{\theta,\phi}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}),\phi(\hat{\bm{x}}^{\sigma(i+1:d-1)}))-\overset{\leftrightarrow}{p}_{\theta}(\hat{\bm{x}}^{\sigma(d)}|\theta(\bm{x}^{\sigma(1:i)}))\right)</annotation></semantics></math>

</div>
<div id="alg3.l15" class="ltx_listingline">
            
            
               Set <math id="alg3.l15.m1" class="ltx_Math" alttext="\bm{x}^{\sigma(d)}\leftarrow\hat{\bm{x}}^{\sigma(d)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒙</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">←</mo><msup><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{x}^{\sigma(d)}\leftarrow\hat{\bm{x}}^{\sigma(d)}</annotation></semantics></math>

