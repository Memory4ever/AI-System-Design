<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E105.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{N^{D-2}}p_{\theta,\phi}(\bm{x}^{1:D-2},R^{D-2},N^{D-2})p_{\theta,\phi}(\bm{x}^{D-1:D},A^{D-1:D},N^{D}|\bm{x}^{1:D-2},R^{D-2},N^{D-2})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>N</mi><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></msup></munder></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>N</mi><mi>D</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>,</mo><msup><mi>N</mi><mrow><mi>D</mi><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{N^{D-2}}p_{\theta,\phi}(\bm{x}^{1:D-2},R^{D-2},N^{D-2})p_{\theta,\phi}(\bm{x}^{D-1:D},A^{D-1:D},N^{D}|\bm{x}^{1:D-2},R^{D-2},N^{D-2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(105)</span></td></tr></tbody>
