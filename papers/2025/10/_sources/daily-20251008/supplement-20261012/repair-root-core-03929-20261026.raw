<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E46.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{\hat{\bm{x}}:\overset{\leftrightarrow}{p}(\hat{\bm{x}})&gt;\overset{\rightarrow}{p}(\hat{\bm{x}})}\overset{\leftrightarrow}{p}(\hat{x})-\overset{\rightarrow}{p}(\hat{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}:\overset{\leftrightarrow}{p}(\hat{\bm{x}})&gt;\overset{\rightarrow}{p}(\hat{\bm{x}})}\overset{\leftrightarrow}{p}(\hat{x})-\overset{\rightarrow}{p}(\hat{\bm{x}})</annotation></semantics></math></td>
