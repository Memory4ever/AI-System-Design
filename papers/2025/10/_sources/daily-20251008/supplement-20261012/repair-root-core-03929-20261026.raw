<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E35.m1" class="ltx_Math" alttext="\displaystyle=\overset{\leftrightarrow}{p}(\bm{x})\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\bm{x})}{\overset{\leftrightarrow}{p}(\bm{x})}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>min</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\overset{\leftrightarrow}{p}(\bm{x})\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\bm{x})}{\overset{\leftrightarrow}{p}(\bm{x})}\right)</annotation></semantics></math></td>
