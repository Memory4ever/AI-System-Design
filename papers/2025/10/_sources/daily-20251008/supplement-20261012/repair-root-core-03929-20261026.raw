<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E37.m1" class="ltx_Math" alttext="\displaystyle p(\bm{x},R)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p(\bm{x},R)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E37.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\hat{\bm{x}}}\int_{U=0}^{U=1}\sum_{\tilde{\bm{x}}}p(\hat{\bm{x}},U,\tilde{\bm{x}},Y=R,\bm{x})\mathrm{d}U" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>U</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>U</mi><mo>=</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover></munder></mstyle><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo>,</mo><mi>U</mi><mo>,</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo>,</mo><mrow><mi>Y</mi><mo>=</mo><mi>R</mi></mrow><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>U</mi></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}}\int_{U=0}^{U=1}\sum_{\tilde{\bm{x}}}p(\hat{\bm{x}},U,\tilde{\bm{x}},Y=R,\bm{x})\mathrm{d}U</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
<tbody id="A3.E38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E38.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{\hat{\bm{x}}}\int_{U=0}^{U=1}\sum_{\tilde{\bm{x}}}\overset{\leftrightarrow}{p}(\hat{\bm{x}})p_{\text{res}}(\tilde{\bm{x}})\delta\left\{U&gt;\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)\right\}\delta\{\bm{x}=\tilde{\bm{x}}\}\mathrm{d}U" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>U</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>U</mi><mo>=</mo><mn>1</mn></mrow></msubsup></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mtext>res</mtext></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mi>δ</mi><mrow><mo>{</mo><mi>U</mi><mo>&gt;</mo><mtext>min</mtext><mrow><mo>(</mo><mn>1</mn><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>}</mo></mrow><mi>δ</mi><mrow><mo stretchy="false">{</mo><mi>𝒙</mi><mo>=</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mi>d</mi><mi>U</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}}\int_{U=0}^{U=1}\sum_{\tilde{\bm{x}}}\overset{\leftrightarrow}{p}(\hat{\bm{x}})p_{\text{res}}(\tilde{\bm{x}})\delta\left\{U&gt;\text{min}\left(1,\frac{\overset{\rightarrow}{p}(\hat{\bm{x}})}{\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\right)\right\}\delta\{\bm{x}=\tilde{\bm{x}}\}\mathrm{d}U</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
