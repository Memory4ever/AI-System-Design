<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E36.m1" class="ltx_Math" alttext="\displaystyle=\text{min}\left(\overset{\leftrightarrow}{p}(\bm{x}),\overset{\rightarrow}{p}(\bm{x})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mtext>min</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\text{min}\left(\overset{\leftrightarrow}{p}(\bm{x}),\overset{\rightarrow}{p}(\bm{x})\right).</annotation></semantics></math></td>
