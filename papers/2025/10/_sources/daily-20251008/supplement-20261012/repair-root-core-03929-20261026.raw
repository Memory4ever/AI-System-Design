r accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}:\overset{\leftrightarrow}{p}(\hat{\bm{x}})&gt;\overset{\rightarrow}{p}(\hat{\bm{x}})}\overset{\leftrightarrow}{p}(\hat{\bm{x}})-\sum_{\hat{\bm{x}}:\overset{\leftrightarrow}{p}(\hat{\bm{x}})&gt;\overset{\rightarrow}{p}(\hat{\bm{x}})}\overset{\rightarrow}{p}(\hat{\bm{x}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
<tbody id="A3.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E48.m1" class="ltx_math_unparsed" alttext="\displaystyle=\left(1-\sum_{\hat{\bm{x}}:\overset{\rightarrow}{p}(\hat{\bm{x}})&gt;\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\overset{\leftrightarrow}{p}(\hat{\bm{x}})\right)-\left(1-\sum_{\hat{\bm{x}}:\overset{\rightarrow}{p}(\hat{\bm{x}})&gt;\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\overset{\rightarrow}{p}(\hat{\bm{x}})\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(1-\sum_{\hat{\bm{x}}:\overset{\rightarrow}{p}(\hat{\bm{x}})&gt;\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\overset{\leftrightarrow}{p}(\hat{\bm{x}})\right)-\left(1-\sum_{\hat{\bm{x}}:\overset{\rightarrow}{p}(\hat{\bm{x}})&gt;\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\overset{\rightarrow}{p}(\hat{\bm{x}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
<tbody id="A3.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E49.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{\hat{\bm{x}}:\overset{\rightarrow}{p}(\hat{\bm{x}})&gt;\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\overset{\rightarrow}{p}(\hat{\bm{x}})-\overset{\leftrightarrow}{p}(\hat{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.710em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder></mstyle><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}:\overset{\rightarrow}{p}(\hat{\bm{x}})&gt;\overset{\leftrightarrow}{p}(\hat{\bm{x}})}\overset{\rightarrow}{p}(\hat{\bm{x}})-\overset{\leftrightarrow}{p}(\hat{\bm{x}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
<tbody id="A3.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E50.m1" class="ltx_Math" alttext="\displaystyle=\sum_{\hat{\bm{x}}}\text{max}\left(0,\overset{\rightarrow}{p}(\hat{\bm{x}})-\overset{\leftrightarrow}{p}(\hat{\bm{x}})\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover></munder></mstyle><mrow><mtext>max</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mrow><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒙</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\hat{\bm{x}}}\text{max}\left(0,\overset{\rightarrow}{p}(\hat{\bm{x}})-\overset{\leftrightarrow}{p}(\hat{\bm{x}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A3.Thmtheorem1.p5.4" class="ltx_p"><span id="A3.Thmtheorem1.p5.4.1" class="ltx_text">This completes the proof of Lemma <a href="#A3.Thmtheorem1" title="Lemma C.1. ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>.
∎</span></p>
</div>
</div>
</div>
<div id="A3.SS1.p7" class="ltx_para ltx_noindent">
<p id="A3.SS1.p7.1" class="ltx_p">We can now continue with our proof of Proposition <a href="#S3.Thmtheorem1" title="Proposition 3.1. ‣ 3.4 Theoretical Results ‣ 3 Self-Speculative Masked Diffusions ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, namely by using Lemma <a href="#A3.Thmtheorem1" title="Lemma C.1. ‣ C.1 Proof of Proposition ‣ Appendix C Proofs ‣ Self-Speculative Masked Diffusions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>, we have</p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E51.m1" class="ltx_math_unparsed" alttext="\displaystyle\prod_{k=d+1}^{D}p_{\theta,\phi}(A^{k},\bm{x}^{k}|x^{1:k-1},R^{d},A^{d+1:k-1})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>D</mi></munderover></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mi>k</mi></msup><mo>,</mo><msup><mi>𝒙</mi><mi>k</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\prod_{k=d+1}^{D}p_{\theta,\phi}(A^{k},\bm{x}^{k}|x^{1:k-1},R^{d},A^{d+1:k-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
<tbody id="A3.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E52.m1" class="ltx_math_unparsed" alttext="\displaystyle=\prod_{k=d+1}^{D}\text{min}\left(\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{k}|\theta(\bm{x}^{1:d})),\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{k}|\theta(\bm{x}^{1:d}),\phi(\bm{x}^{d+1:k-1}))\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>D</mi></munderover></mstyle><mtext>min</mtext><mrow><mo>(</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">↔</mo></mover><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>k</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo mathsize="0.700em" stretchy="false">→</mo></mover><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mi>k</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>θ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{k=d+1}^{D}\text{min}\left(\overset{\leftrightarrow}{p}_{\theta}(\bm{x}^{k}|\theta(\bm{x}^{1:d})),\overset{\rightarrow}{p}_{\theta,\phi}(\bm{x}^{k}|\theta(\bm{x}^{1:d}),\phi(\bm{x}^{d+1:k-1}))\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p7.2" class="ltx_p">Therefore, we can calculate <math id="A3.SS1.p7.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{d+1:D},A^{d+1:D}|\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo>,</mo><msup><mi>A</mi><mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>D</mi></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{d+1:D},A^{d+1:D}|\bm{x}^{1:d},R^{d})</annotation></semantics></math> in <math id="A3.SS1.p7.m2" class="ltx_Math" alttext="O(D)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(D)</annotation></semantics></math> operations.</p>
</div>
<div id="A3.SS1.p8" class="ltx_para ltx_noindent">
<p id="A3.SS1.p8.1" class="ltx_p">We now deal with the term <math id="A3.SS1.p8.m1" class="ltx_math_unparsed" alttext="p_{\theta,\phi}(\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta,\phi}(\bm{x}^{1:d},R^{d})</annotation></semantics></math>. We perform a recursive decomposition,</p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E53.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},R^{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{\theta,\phi}(\bm{x}^{1:d},R^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
<tbody id="A3.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E54.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E54.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{Y^{1:d-1}}p_{\theta,\phi}(\bm{x}^{1:d},Y^{1:d-1},R^{d})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>Y</mi><msup><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup></mrow></munder></mstyle><msub><mi>p</mi><mrow><mi>θ</mi><mo>,</mo><mi>ϕ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒙</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>Y</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msup><mo>,</mo><msup><mi>R</mi><mi>d</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{Y^{1:d-1}}p_{\theta,\phi}(\bm{x}^{1:d},Y^{1:d-1},R^{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
<tbody id="A3.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E55.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
