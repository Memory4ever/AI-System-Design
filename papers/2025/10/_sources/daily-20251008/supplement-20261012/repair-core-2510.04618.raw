<td id="S4.T3.2.1.9.1" class="ltx_td ltx_align_center ltx_border_t" colspan="7"><span id="S4.T3.2.1.9.1.1" class="ltx_text ltx_font_typewriter">Online Adaptation</span></td></tr>
<tr id="S4.T3.2.1.10" class="ltx_tr">
<td id="S4.T3.2.1.10.1" class="ltx_td ltx_align_left"><span id="S4.T3.2.1.10.1.1" class="ltx_text ltx_font_typewriter">ReAct</span> + ACE</td>
<td id="S4.T3.2.1.10.2" class="ltx_td ltx_align_center ltx_border_r">✗</td>
