<figure id="S6.F3.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.04767v1/shuffle.svg" id="S6.F3.sf5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/411;" width="548" height="411"></object>
