<span id="A4.T3.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:178.9pt;">
<span id="A4.T3.2.1.2.1.1" class="ltx_p ltx_align_left"><span id="A4.T3.2.1.2.1.1.1" class="ltx_text ltx_font_bold">Prompt</span></span>
</span></th>
<th id="A4.T3.2.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="A4.T3.2.1.3.1" class="ltx_inline-block ltx_align_top" style="width:103.3pt;">
<span id="A4.T3.2.1.3.1.1" class="ltx_p ltx_align_left"><span id="A4.T3.2.1.3.1.1.1" class="ltx_text ltx_font_bold">Example Answer</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
