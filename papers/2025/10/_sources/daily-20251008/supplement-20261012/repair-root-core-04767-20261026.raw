<figure id="S6.F3.sf9" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.04767v1/sudoku.svg" id="S6.F3.sf9.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/411;" width="548" height="411"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(i) </span>Sudoku</figcaption>
