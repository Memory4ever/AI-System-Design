<th id="Sx3.T1.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b" style="padding-top:0.25pt;padding-bottom:0.25pt;">Neutral</th>
<td id="Sx3.T1.1.8.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.25pt;padding-bottom:0.25pt;">121232</td>
<td id="Sx3.T1.1.8.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.25pt;padding-bottom:0.25pt;">26371</td>
