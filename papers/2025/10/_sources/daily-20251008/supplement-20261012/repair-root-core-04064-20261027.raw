<td id="Sx3.T1.1.6.5" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">49914</td></tr>
<tr id="Sx3.T1.1.7" class="ltx_tr">
<th id="Sx3.T1.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.25pt;padding-bottom:0.25pt;">Surprise</th>
<td id="Sx3.T1.1.7.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">7773</td>
<td id="Sx3.T1.1.7.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">14032</td>
<td id="Sx3.T1.1.7.4" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">8763</td>
<td id="Sx3.T1.1.7.5" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">30568</td></tr>
