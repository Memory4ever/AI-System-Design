<tr id="Sx3.T1.1.5" class="ltx_tr">
<th id="Sx3.T1.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.25pt;padding-bottom:0.25pt;">Joy</th>
<td id="Sx3.T1.1.5.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">45555</td>
<td id="Sx3.T1.1.5.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">18895</td>
<td id="Sx3.T1.1.5.4" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">9710</td>
<td id="Sx3.T1.1.5.5" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">74160</td></tr>
<tr id="Sx3.T1.1.6" class="ltx_tr">
<th id="Sx3.T1.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.25pt;padding-bottom:0.25pt;">Sadness</th>
<td id="Sx3.T1.1.6.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">23094</td>
