<td id="A1.T5.4.2.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;">Final Layer</td></tr>
<tr id="A1.T5.4.3" class="ltx_tr">
<td id="A1.T5.4.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;">Image Tokens (%)</td>
<td id="A1.T5.4.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A1.T5.4.3.2.1" class="ltx_text ltx_font_bold">3.46</span></td>
<td id="A1.T5.4.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A1.T5.4.3.3.1" class="ltx_text ltx_font_bold">10.02</span></td>
<td id="A1.T5.4.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;"><span id="A1.T5.4.3.4.1" class="ltx_text ltx_font_bold">15.92</span></td>
<td id="A1.T5.4.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;">1.96</td>
<td id="A1.T5.4.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;">3.22</td>
<td id="A1.T5.4.3.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;">4.05</td></tr>
<tr id="A1.T5.4.4" class="ltx_tr">
<td id="A1.T5.4.4.1" class="ltx_td ltx_align_left" style="padding-top:0.25pt;padding-bottom:0.25pt;">Textual Priors (%)</td>
