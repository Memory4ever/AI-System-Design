<tr id="S4.T2.6.4" class="ltx_tr">
<td id="S4.T2.6.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:0.25pt 3.5pt;">CoT</td>
<td id="S4.T2.6.4.2" class="ltx_td ltx_align_center" style="padding:0.25pt 3.5pt;">98.91</td>
<td id="S4.T2.6.4.3" class="ltx_td ltx_align_center" style="padding:0.25pt 3.5pt;">96.67</td>
<td id="S4.T2.6.4.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.25pt 3.5pt;">92.56</td>
<td id="S4.T2.6.4.5" class="ltx_td ltx_align_center" style="padding:0.25pt 3.5pt;">97.46</td>
<td id="S4.T2.6.4.6" class="ltx_td ltx_align_center" style="padding:0.25pt 3.5pt;">96.42</td>
<td id="S4.T2.6.4.7" class="ltx_td ltx_align_center ltx_border_r" style="padding:0.25pt 3.5pt;">92.38</td>
<td id="S4.T2.6.4.8" class="ltx_td ltx_align_center" style="padding:0.25pt 3.5pt;">0.03/0.08</td>
