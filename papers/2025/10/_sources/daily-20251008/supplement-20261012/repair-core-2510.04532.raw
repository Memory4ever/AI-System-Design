<td id="A1.T5.4.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.25pt;padding-bottom:0.25pt;" colspan="3"><span id="A1.T5.4.1.2.1" class="ltx_text ltx_font_bold">Detection Task</span></td>
<td id="A1.T5.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.25pt;padding-bottom:0.25pt;" colspan="3"><span id="A1.T5.4.1.3.1" class="ltx_text ltx_font_bold">Planning Task</span></td></tr>
