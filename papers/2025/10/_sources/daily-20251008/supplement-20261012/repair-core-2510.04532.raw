<td id="S4.T2.6.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 3.5pt;" colspan="3"><span id="S4.T2.6.1.3.1" class="ltx_text ltx_font_bold">Closed-Loop Score</span> <math id="S4.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S4.T2.6.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 3.5pt;" colspan="3"><span id="S4.T2.6.1.4.1" class="ltx_text ltx_font_bold">Avg. ADE / FDE (m)</span> <math id="S4.T2.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="S4.T2.6.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 3.5pt;" colspan="3"><span id="S4.T2.6.1.5.1" class="ltx_text ltx_font_bold">Collision Ratio</span> <math id="S4.T2.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
