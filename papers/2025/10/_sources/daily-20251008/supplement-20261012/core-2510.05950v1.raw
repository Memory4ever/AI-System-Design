<td id="S4.T2.2.1.7.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T2.2.1.7.6.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">-6.7</span></td></tr>
