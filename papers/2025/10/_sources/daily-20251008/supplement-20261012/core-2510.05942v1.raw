<td id="S4.T1.10.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.10.3.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#004C99;--ltx-bg-color:#F0F0F0;">0.887</span></td>
<td id="S4.T1.10.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.10.3.7.1" class="ltx_text" style="--ltx-fg-color:#1B9E77;--ltx-bg-color:#F0F0F0;">+0.088</span></td>
<td id="S4.T1.10.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><em id="S4.T1.10.3.8.1" class="ltx_emph ltx_font_italic" style="--ltx-bg-color:#F0F0F0;">0.866</em></td>
<td id="S4.T1.10.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><em id="S4.T1.10.3.9.1" class="ltx_emph ltx_font_italic" style="--ltx-bg-color:#F0F0F0;">0.912</em></td>
<td id="S4.T1.10.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.10.3.10.1" class="ltx_text" style="--ltx-bg-color:#F0F0F0;">81</span></td></tr>
<tr id="S4.T1.10.4" class="ltx_tr" style="--ltx-bg-color:#F0F0F0;">
