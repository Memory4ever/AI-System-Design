ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">the</span><span id="lstnumberx18.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">fence</span><span id="lstnumberx18.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">right</span><span id="lstnumberx18.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">over</span><span id="lstnumberx18.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">there</span><span id="lstnumberx18.45" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span><span id="lstnumberx18.46" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">And</span><span id="lstnumberx18.48" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">he</span><span id="lstnumberx18.50" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">come</span><span id="lstnumberx18.52" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx18.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">ridin</span><span id="lstn