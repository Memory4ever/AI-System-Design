            <span id="alg1.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <math id="alg1.l15.m1" class="ltx_Math" alttext="a\leftarrow\mathrm{SYNTHESIZE}(M)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo stretchy="false">←</mo><mrow><mi>SYNTHESIZE</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\leftarrow\mathrm{SYNTHESIZE}(M)</annotation></semantics></math> <span id="alg1.l15.3" class="ltx_text" style="float:right;"><math id="alg1.l15.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l15.3.1" class="ltx_text ltx_font_smallcaps">Manager</span> agent
</span>
</div>
