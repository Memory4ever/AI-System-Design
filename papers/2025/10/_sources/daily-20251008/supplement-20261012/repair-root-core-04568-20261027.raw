              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathcal{F}_{i}\leftarrow\mathcal{F}_{i}\cup\Delta\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>∪</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}_{i}\leftarrow\mathcal{F}_{i}\cup\Delta\mathcal{F}_{i}</annotation></semantics></math>

