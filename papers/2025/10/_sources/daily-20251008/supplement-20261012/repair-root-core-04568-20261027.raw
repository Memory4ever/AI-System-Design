<th id="S6.T1.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S6.T1.2.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="S6.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S6.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S6.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">InfBench-QA</span></th>
<th id="S6.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T1.2.1.1.4.1" class="ltx_text ltx_font_bold">InfBench-MC</span></th>
<th id="S6.T1.2.1.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T1.2.1.1.5.1" class="ltx_text ltx_font_bold">NarrativeQA-256k</span></th></tr>
<tr id="S6.T1.2.1.2" class="ltx_tr">
<th id="S6.T1.2.1.2.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="S6.T1.2.1.2.2" class="ltx_td ltx_th ltx_th_column ltx_th_row"></th>
<th id="S6.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column">(ROUGE-F1)</th>
<th id="S6.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column">(Exact Match)</th>
<th id="S6.T1.2.1.2.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column">(ROUGE-F1)</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T1.2.1.3" class="ltx_tr">
<th id="S6.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="S6.T1.2.1.3.1.1" class="ltx_text ltx_font_bold">GPT-4.1</span></th>
<th id="S6.T1.2.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">TC</th>
