<td id="S4.T4.2.4.2" class="ltx_td ltx_align_left ltx_border_t">LoRA</td>
<td id="S4.T4.2.4.3" class="ltx_td ltx_align_center ltx_border_t">23.2</td>
<td id="S4.T4.2.4.4" class="ltx_td ltx_align_center ltx_border_t">25.8</td>
<td id="S4.T4.2.4.5" class="ltx_td ltx_align_center ltx_border_t">27.4</td></tr>
<tr id="S4.T4.2.5" class="ltx_tr">
<td id="S4.T4.2.5.1" class="ltx_td ltx_align_left">IniLoRA</td>
<td id="S4.T4.2.5.2" class="ltx_td ltx_align_center">24.7</td>
