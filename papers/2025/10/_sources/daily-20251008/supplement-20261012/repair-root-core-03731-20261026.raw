<td id="S3.T2.2.13.5" class="ltx_td ltx_align_center"><span id="S3.T2.2.13.5.1" class="ltx_text ltx_font_bold">61.3</span></td>
<td id="S3.T2.2.13.6" class="ltx_td ltx_align_center">40.8</td>
