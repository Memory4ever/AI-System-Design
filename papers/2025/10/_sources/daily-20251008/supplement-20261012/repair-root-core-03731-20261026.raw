<td id="S4.T4.2.2.2" class="ltx_td ltx_align_left ltx_border_t">LoRA</td>
<td id="S4.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_t">20.5</td>
<td id="S4.T4.2.2.4" class="ltx_td ltx_align_center ltx_border_t">21.8</td>
<td id="S4.T4.2.2.5" class="ltx_td ltx_align_center ltx_border_t">25.2</td></tr>
<tr id="S4.T4.2.3" class="ltx_tr">
