<tr id="S3.T2.2.13" class="ltx_tr">
<td id="S3.T2.2.13.1" class="ltx_td"></td>
<td id="S3.T2.2.13.2" class="ltx_td ltx_align_left">LoRA</td>
<td id="S3.T2.2.13.3" class="ltx_td ltx_align_center">59.6</td>
