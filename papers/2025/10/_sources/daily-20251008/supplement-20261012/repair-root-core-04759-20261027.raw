<th id="S4.T1.10.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding:0.25pt 2.1pt;">Mod.</th>
<th id="S4.T1.10.1.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt" style="--ltx-bg-color:#E6E6E6;padding:0.25pt 2.1pt;"><span id="S4.T1.10.1.1.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">mIoU</span></th>
