<p id="S4.T1.10.1.1.10.1.1" class="ltx_p"><math id="S4.T1.m7" class="ltx_Math" alttext="\blacksquare" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#0000E6;" mathcolor="#0000E6" mathvariant="normal">■</mi><annotation encoding="application/x-tex">\blacksquare</annotation></semantics></math>
pedestrian</p>
