<span id="lstnumberx57" class="ltx_listingline"><span id="lstnumberx57.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;">            </span><span id="lstnumberx57.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">"</span><span id="lstnumberx57.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">explanation</span><span id="lstnumberx57.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">":</span><span id="lstnumberx57.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx57.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">"</span><span id="lstnumberx57.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">The</span><span id="lstnumberx57.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx57.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">original</span><span id="lstnumberx57.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx57.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">array</span><span id="lstnumberx57.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx57.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">was</span><span id="lstnumberx57.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx57.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[0,1,2,4,5,6,7]</span><span id="lstnumberx57.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx57.17" class="ltx_text ltx_lst_id