</span>
<span id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx27.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx27.3" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx27.5" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Length</span><span id="lstnumberx27.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.8" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx27.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.10" class="ltx_text ltx_font_typewriter">1]</span><span id="lstnumberx27.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.12" class="ltx_text ltx_font_typewriter">:=</span><span id="lstnumberx27.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">tmp</span><span id="lstnumberx27.15" class="ltx_text ltx_font_typewriter">;</span>
