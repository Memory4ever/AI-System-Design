          <span id="lstnumberx52.2" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx52.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">think</span><span id="lstnumberx52.4" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
<div id="lstnumberx53" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">21</span>
            
            
            
          
</div>
<div id="lstnumberx54" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">22</span>
            
            
            
          <span id="lstnumberx54.2" class="ltx_text ltx_font_typewriter">&lt;/</span><span id="lstnumberx54.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">think</span><span id="lstnumberx54.4" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
