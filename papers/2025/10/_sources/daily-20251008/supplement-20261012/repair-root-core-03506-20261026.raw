<span id="S4.T4.3.1.1.1.1.1.1.1.1.2.6" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Edit Flow</span></span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.3" class="ltx_tr">
<span id="S4.T4.3.1.1.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Image</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">AR</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.3.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Diffusion / FM</span>
