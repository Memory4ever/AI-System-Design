<span id="S4.T4.3.1.1.1.1.1.1.1.1.3.5" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Discrete FM</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.3.6" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">FM</span></span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.4" class="ltx_tr">
<span id="S4.T4.3.1.1.1.1.1.1.1.1.4.1" class="ltx_td ltx_align_left ltx_border_t ltx_colspan ltx_colspan_6" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.3.1.1.1.1.1.1.1.1.4.1.1" class="ltx_text ltx_font_italic">Training Properties</span></span></span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5" class="ltx_tr">
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Attention</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Causal</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Block Causal</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Bidirectional</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5.5" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Bidirectional</span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.5.6" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">Bidirectional</span></span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.6" class="ltx_tr" style="--ltx-bg-color:#E6EFFC;">
<span id="S4.T4.3.1.1.1.1.1.1.1.1.6.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.3.1.1.1.1.1.1.1.1.6.1.1" class="ltx_text" style="--ltx-bg-color:#E6EFFC;">Tokens / Iter</span></span>
<span id="S4.T4.3.1.1.1.1.1.1.1.1.6.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S4.T4.3.1.1.1.1.1.1.1.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#E6EFFC;">Seq Len</span></span>
