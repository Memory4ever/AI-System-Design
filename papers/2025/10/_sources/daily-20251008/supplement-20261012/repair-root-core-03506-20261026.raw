             <span id="alg2.l23.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l23.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
            
            
            <span id="alg2.l24.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l24.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l25" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
            
            
          
</div>
<div id="alg2.l26" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
            
            
            <math id="alg2.l26.m1" class="ltx_Math" alttext="t_{\text{text}}\leftarrow t_{\text{text}}+\Delta t_{\text{text}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mtext>text</mtext></msub><mo stretchy="false">←</mo><mrow><msub><mi>t</mi><mtext>text</mtext></msub><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mtext>text</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\text{text}}\leftarrow t_{\text{text}}+\Delta t_{\text{text}}</annotation></semantics></math>

</div>
<div id="alg2.l27" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
            
            
            <span id="alg2.l27.3" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l27.m1" class="ltx_Math" alttext="X,\mathcal{I},t_{\text{text}},t_{\text{img}}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>,</mo><msub><mi>t</mi><mtext>text</mtext></msub><mo>,</mo><msub><mi>t</mi><mtext>img</mtext></msub></mrow><annotation encoding="application/x-tex">X,\mathcal{I},t_{\text{text}},t_{\text{img}}</annotation></semantics></math>

</div>
<div id="alg2.l28" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l28.1" class="ltx_text" style="font-size:80%;">28:</span></span>
            
            
          <span id="alg2.l28.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l28.4" class="ltx_text ltx_font_bold">function</span>
</div>
</div>
</figure>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.4" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> <span id="alg3.5" class="ltx_text ltx_font_bold">OneFlow training loss with interleaved schedule</span></figcaption>
<div id="alg3.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          <span id="alg3.l1.3" class="ltx_text ltx_font_bold">function</span> <span id="alg3.l1.4" class="ltx_text ltx_font_smallcaps">OneFlowTrainingStep</span>(data sequence <math id="alg3.l1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, image latents <math id="alg3.l1.m2" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math>, schedule <math id="alg3.l1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>)

</div>
<div id="alg3.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
            <math id="alg3.l2.m1" class="ltx_Math" alttext="\tau_{\text{text}}\sim\mathrm{Unif}[0,2]" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mtext>text</mtext></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{\text{text}}\sim\mathrm{Unif}[0,2]</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
            <math id="alg3.l3.m1" class="ltx_Math" alttext="t_{\text{text}}\leftarrow\min\{1,\tau_{\text{text}}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mtext>text</mtext></msub><mo stretchy="false">←</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><msub><mi>τ</mi><mtext>text</mtext></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\text{text}}\leftarrow\min\{1,\tau_{\text{text}}\}</annotation></semantics></math>

</div>
<div id="alg3.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            <math id="alg3.l4.m1" class="ltx_Math" alttext="j\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\leftarrow 0</annotation></semantics></math>

</div>
<div id="alg3.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            <math id="alg3.l5.m1" class="ltx_Math" alttext="X_{t}\leftarrow[]" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">X_{t}\leftarrow[]</annotation></semantics></math>

</div>
<div id="alg3.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
            <span id="alg3.l6.3" class="ltx_text ltx_font_bold">for all</span> <math id="alg3.l6.m1" class="ltx_Math" alttext="x^{i}\in X" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>i</mi></msup><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">x^{i}\in X</annotation></semantics></math> <span id="alg3.l6.4" class="ltx_text ltx_font_bold">do</span> <span id="alg3.l6.5" class="ltx_text" style="float:right;"><math id="alg3.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <em id="alg3.l6.5.1" class="ltx_emph ltx_font_italic">Keep each ground-truth token with prob <math id="alg3.l6.m3" class="ltx_Math" alttext="\kappa(t_{\text{text}})" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mtext class="ltx_mathvariant_italic">text</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa(t_{\text{text}})</annotation></semantics></math> to get noisy <math id="alg3.l6.m4" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math></em>
</span>
</div>
<div id="alg3.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
             <span id="alg3.l7.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l7.m1" class="ltx_Math" alttext="r&lt;\kappa(t_{\text{text}})\;\text{where}\;r\sim\mathrm{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mtext>text</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><mtext>where</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>r</mi></mrow><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r&lt;\kappa(t_{\text{text}})\;\text{where}\;r\sim\mathrm{Unif}(0,1)</annotation></semantics></math> <span id="alg3.l7.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
               <math id="alg3.l8.m1" class="ltx_Math" alttext="X_{t}\leftarrow X_{t}+[x^{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>X</mi><mi>t</mi></msub><mo>+</mo><mrow><mo stretchy="false">[</mo><msup><mi>x</mi><mi>i</mi></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{t}\leftarrow X_{t}+[x^{i}]</annotation></semantics></math>

</div>
<div id="alg3.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
               <math id="alg3.l9.m1" class="ltx_Math" alttext="j\leftarrow j+1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo stretchy="false">←</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j\leftarrow j+1</annotation></semantics></math>

</div>
<div id="alg3.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
               <math id="alg3.l10.m1" class="ltx_Math" alttext="\mathcal{A}_{j}\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>j</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}_{j}\leftarrow\{\}</annotation></semantics></math>

</div>
<div id="alg3.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
             <span id="alg3.l11.3" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg3.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
               <math id="alg3.l12.m1" class="ltx_Math" alttext="\mathcal{A}_{j}\leftarrow\mathcal{A}_{j}\cup\{X^{i}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>j</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>j</mi></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><msup><mi>X</mi><mi>i</mi></msup><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}_{j}\leftarrow\mathcal{A}_{j}\cup\{X^{i}\}</annotation></semantics></math> <span id="alg3.l12.3" class="ltx_text" style="float:right;"><math id="alg3.l12.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <em id="alg3.l12.3.1" class="ltx_emph ltx_font_italic">Record the deleted tokens at each position in <math id="alg3.l12.m3" class="ltx_Math" alttext="\mathcal{A}_{j}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{j}</annotation></semantics></math></em>
</span>
</div>
<div id="alg3.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
             <span id="alg3.l13.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l13.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
            <span id="alg3.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l14.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
            <math id="alg3.l15.m1" class="ltx_Math" alttext="\mathcal{I}_{t}\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}_{t}\leftarrow\{\}</annotation></semantics></math>

</div>
<div id="alg3.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
            <span id="alg3.l16.3" class="ltx_text ltx_font_bold">for all</span> images <math id="alg3.l16.m1" class="ltx_Math" alttext="Y\in\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><annotation encoding="application/x-tex">Y\in\mathcal{I}</annotation></semantics></math> <span id="alg3.l16.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg3.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
             <math id="alg3.l17.m1" class="ltx_Math" alttext="Y_{1}\leftarrow\text{VAEEnc}(\text{img})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mn>1</mn></msub><mo stretchy="false">←</mo><mrow><mtext>VAEEnc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>img</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{1}\leftarrow\text{VAEEnc}(\text{img})</annotation></semantics></math>

</div>
<div id="alg3.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
             <math id="alg3.l18.m1" class="ltx_Math" alttext="u\sim\mathrm{Unif}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\sim\mathrm{Unif}(0,1)</annotation></semantics></math>

</div>
<div id="alg3.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
             <math id="alg3.l19.m1" class="ltx_Math" alttext="\tau_{\text{img}}(Y)\leftarrow\tau_{\text{text}}-\kappa^{-1}(u)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mtext>img</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><msub><mi>τ</mi><mtext>text</mtext></msub><mo>−</mo><mrow><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{\text{img}}(Y)\leftarrow\tau_{\text{text}}-\kappa^{-1}(u)</annotation></semantics></math>

</div>
<div id="alg3.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
             <span id="alg3.l20.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l20.m1" class="ltx_Math" alttext="\tau_{\text{img}}&lt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mtext>img</mtext></msub><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau_{\text{img}}&lt;0</annotation></semantics></math> <span id="alg3.l20.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
            
            
               add <span id="alg3.l21.3" class="ltx_text ltx_font_typewriter">&lt;|image|&gt;</span> to the appropriate <math id="alg3.l21.m1" class="ltx_Math" alttext="\mathcal{A}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{i}</annotation></semantics></math> <span id="alg3.l21.4" class="ltx_text" style="float:right;"><math id="alg3.l21.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <em id="alg3.l21.4.1" class="ltx_emph ltx_font_italic">Image is “deleted” at this snapshot</em>
</span>
</div>
<div id="alg3.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
             <span id="alg3.l22.3" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg3.l23" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
            
            
               <math id="alg3.l23.m1" class="ltx_Math" alttext="t_{\text{img}}(Y)\leftarrow\min\{1,\tau_{\text{img}}(Y)\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mtext>img</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mrow><msub><mi>τ</mi><mtext>img</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{\text{img}}(Y)\leftarrow\min\{1,\tau_{\text{img}}(Y)\}</annotation></semantics></math>

</div>
<div id="alg3.l24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
            
            
               <math id="alg3.l24.m1" class="ltx_Math" alttext="Y_{0}\sim\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mn>0</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{0}\sim\mathcal{N}(0,I)</annotation></semantics></math>

</div>
