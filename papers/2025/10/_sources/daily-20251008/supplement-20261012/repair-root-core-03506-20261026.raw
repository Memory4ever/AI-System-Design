<span id="S3.T2.3.1.1.1.1.1.1.1.2" class="ltx_td ltx_border_tt" style="padding-top:0.2pt;padding-bottom:0.2pt;"></span>
<span id="S3.T2.3.1.1.1.1.1.1.1.3" class="ltx_td ltx_border_tt" style="padding-top:0.2pt;padding-bottom:0.2pt;"></span>
<span id="S3.T2.3.1.1.1.1.1.1.1.4" class="ltx_td ltx_border_tt" style="padding-top:0.2pt;padding-bottom:0.2pt;"></span>
<span id="S3.T2.3.1.1.1.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_4" style="--ltx-bg-color:#EBF7FA;padding-top:0.2pt;padding-bottom:0.2pt;"><span id="S3.T2.3.1.1.1.1.1.1.1.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EBF7FA;">Image Generation</span></span>
<span id="S3.T2.3.1.1.1.1.1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_3" style="--ltx-bg-color:#EDE8FA;padding-top:0.2pt;padding-bottom:0.2pt;"><span id="S3.T2.3.1.1.1.1.1.1.1.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EDE8FA;">Captioning</span></span></span>
<span id="S3.T2.3.1.1.1.1.1.1.2" class="ltx_tr">
<span id="S3.T2.3.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_left" style="padding-top:0.2pt;padding-bottom:0.2pt;"><span id="S3.T2.3.1.1.1.1.1.1.2.1.1" class="ltx_text ltx_font_bold">Model</span></span>
<span id="S3.T2.3.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center" style="padding-top:0.2pt;padding-bottom:0.2pt;"><span id="S3.T2.3.1.1.1.1.1.1.2.2.1" class="ltx_text ltx_font_bold">Size</span></span>
<span id="S3.T2.3.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center" style="padding-top:0.2pt;padding-bottom:0.2pt;">
<span id="S3.T2.3.1.1.1.1.1.1.2.3.1" class="ltx_inline-block ltx_transformed_outer" style="width:16.1pt;height:16.1pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:18.0pt;transform:translate(-0.9pt,-5.7pt) rotate(-45deg) ;">
<span id="S3.T2.3.1.1.1.1.1.1.2.3.1.1" class="ltx_p"><span id="S3.T2.3.1.1.1.1.1.1.2.3.1.1.1" class="ltx_text ltx_font_bold">Text</span></span>
</span></span></span>
<span id="S3.T2.3.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_center" style="padding-top:0.2pt;padding-bottom:0.2pt;">
<span id="S3.T2.3.1.1.1.1.1.1.2.4.1" class="ltx_inline-block ltx_transformed_outer" style="width:21.3pt;height:21.3pt;vertical-align:-1.0pt;"><span class="ltx_transformed_inner" style="width:24.0pt;transform:translate(-1.3pt,-7.6pt) rotate(-45deg) ;">
<span id="S3.T2.3.1.1.1.1.1.1.2.4.1.1" class="ltx_p"><span id="S3.T2.3.1.1.1.1.1.1.2.4.1.1.1" class="ltx_text ltx_font_bold">Image</span></span>
</span></span></span>
<span id="S3.T2.3.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#EBF7FA;padding-top:0.2pt;padding-bottom:0.2pt;"><span id="S3.T2.3.1.1.1.1.1.1.2.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#EBF7FA;">FID<math id="S3.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#EBF7FA;" mathbackground="#EBF7FA" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></span>
