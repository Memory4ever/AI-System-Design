<td id="S4.T2.5.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.5.1.5.1" class="ltx_text"></span> <span id="S4.T2.5.1.5.2" class="ltx_text">
<span id="S4.T2.5.1.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T2.5.1.5.2.1.1" class="ltx_tr">
<span id="S4.T2.5.1.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Audio+Video</span></span>
<span id="S4.T2.5.1.5.2.1.2" class="ltx_tr">
<span id="S4.T2.5.1.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Fusion</span></span>
</span></span><span id="S4.T2.5.1.5.3" class="ltx_text"></span></td>
<td id="S4.T2.5.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T2.5.1.6.1" class="ltx_text"></span> <span id="S4.T2.5.1.6.2" class="ltx_text">
