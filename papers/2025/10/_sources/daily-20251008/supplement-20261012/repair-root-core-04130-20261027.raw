<td id="A5.T2.1.7.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="A5.T2.m9" class="ltx_Math" alttext="\phi(i,j,n)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }j=0,\\
2,&amp;\text{ if }i-j=0,\\
3,&amp;\text{ if }i-j=n,\\
4,&amp;\text{ if }i-j=n+1,\\
0,&amp;\text{ otherwise}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">n</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">2</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">3</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mi mathsize="0.700em">n</mi></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">4</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mrow><mi mathsize="0.700em">n</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.700em"> otherwise</mtext><mo lspace="0em" mathsize="0.700em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\phi(i,j,n)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }j=0,\\
2,&amp;\text{ if }i-j=0,\\
3,&amp;\text{ if }i-j=n,\\
4,&amp;\text{ if }i-j=n+1,\\
0,&amp;\text{ otherwise}.\end{array}\right.</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
<div id="A5.p4" class="ltx_para">
<p id="A5.p4.1" class="ltx_p"><span id="A5.p4.1.1" class="ltx_text ltx_font_bold">Training.</span> All the models are trained with AdamW and the same experiment groups share the hyperparameters.</p>
</div>
<div id="A5.p5" class="ltx_para">
<p id="A5.p5.1" class="ltx_p">Settings of the dataset sizes, the model hyperparameters, and the training recipes are listed in Tables <a href="#A5.T6" title="TABLE VI ‣ Appendix E Experimental Details ‣ On the Limitations and Capabilities of Position Embeddings for Length Generalization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VI</span></a>–<a href="#A5.T6" title="TABLE VI ‣ Appendix E Experimental Details ‣ On the Limitations and Capabilities of Position Embeddings for Length Generalization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">VI</span></a>.</p>
</div>
