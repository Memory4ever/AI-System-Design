<th id="A5.T1.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T1.1.7.1.1" class="ltx_text" style="font-size:90%;">Multiplication (1 * N)</span></th>
<td id="A5.T1.1.7.2" class="ltx_td ltx_align_center"><math id="A5.T1.m11" class="ltx_Math" alttext="\mathtt{y_{1}\;*\;x_{1}\;\dots\;x_{n}\;=\;z_{1}\;\dots\;z_{n}\;z_{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">𝚢</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0.502em" mathsize="0.900em" rspace="0.502em">∗</mo><msub><mi mathsize="0.900em">𝚡</mi><mn mathsize="0.900em">𝟷</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚡</mi><mi mathsize="0.900em">𝚗</mi></msub></mrow><mo mathsize="0.900em" rspace="0.558em">=</mo><mrow><msub><mi mathsize="0.900em">𝚣</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mi mathsize="0.900em">𝚗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mrow><mi mathsize="0.900em">𝚗</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">𝟷</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathtt{y_{1}\;*\;x_{1}\;\dots\;x_{n}\;=\;z_{1}\;\dots\;z_{n}\;z_{n+1}}</annotation></semantics></math></td>
<td id="A5.T1.1.7.3" class="ltx_td ltx_align_center"><math id="A5.T1.m12" class="ltx_Math" alttext="\mathtt{y_{1}\;*\;x_{1}\;\dots\;x_{n}\;0\;\dots\;0\;=\;z_{1}\;\dots\;z_{n}\;z_{n+1}\;0\;\dots\;0}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">𝚢</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0.502em" mathsize="0.900em" rspace="0.502em">∗</mo><msub><mi mathsize="0.900em">𝚡</mi><mn mathsize="0.900em">𝟷</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚡</mi><mi mathsize="0.900em">𝚗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn><mo lspace="0.280em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn></mrow><mo lspace="0.558em" mathsize="0.900em" rspace="0.558em">=</mo><mrow><msub><mi mathsize="0.900em">𝚣</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mi mathsize="0.900em">𝚗</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mrow><mi mathsize="0.900em">𝚗</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">𝟷</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn><mo lspace="0.280em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn></mrow></mrow><annotation encoding="application/x-tex">\mathtt{y_{1}\;*\;x_{1}\;\dots\;x_{n}\;0\;\dots\;0\;=\;z_{1}\;\dots\;z_{n}\;z_{n+1}\;0\;\dots\;0}</annotation></semantics></math></td></tr>
<tr id="A5.T1.1.8" class="ltx_tr">
<th id="A5.T1.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T1.1.8.1.1" class="ltx_text" style="font-size:90%;">Division (N / 1)</span></th>
<td id="A5.T1.1.8.2" class="ltx_td ltx_align_center"><math id="A5.T1.m13" class="ltx_Math" alttext="\mathtt{y_{1}\;\backslash\;x_{n}\;\dots\;x_{1}\;=\;z_{n}\;\dots\;z_{1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">𝚢</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0.502em" mathsize="0.900em" rspace="0.502em">\</mo><msub><mi mathsize="0.900em">𝚡</mi><mi mathsize="0.900em">𝚗</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚡</mi><mn mathsize="0.900em">𝟷</mn></msub></mrow><mo mathsize="0.900em" rspace="0.558em">=</mo><mrow><msub><mi mathsize="0.900em">𝚣</mi><mi mathsize="0.900em">𝚗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mn mathsize="0.900em">𝟷</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\mathtt{y_{1}\;\backslash\;x_{n}\;\dots\;x_{1}\;=\;z_{n}\;\dots\;z_{1}}</annotation></semantics></math></td>
<td id="A5.T1.1.8.3" class="ltx_td ltx_align_center"><math id="A5.T1.m14" class="ltx_Math" alttext="\mathtt{y_{1}\;\backslash\;0\;\dots\;0\;x_{n}\;\dots\;x_{1}\;=0\;\dots\;0\;z_{n}\;\dots\;z_{1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathsize="0.900em">𝚢</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0.502em" mathsize="0.900em" rspace="0.222em">\</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚡</mi><mi mathsize="0.900em">𝚗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚡</mi><mn mathsize="0.900em">𝟷</mn></msub></mrow><mo mathsize="0.900em">=</mo><mrow><mn mathsize="0.900em">𝟶</mn><mo lspace="0.280em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mn class="ltx_mathvariant_monospace" mathsize="0.900em" mathvariant="monospace"> 0</mn><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mi mathsize="0.900em">𝚗</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚣</mi><mn mathsize="0.900em">𝟷</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\mathtt{y_{1}\;\backslash\;0\;\dots\;0\;x_{n}\;\dots\;x_{1}\;=0\;\dots\;0\;z_{n}\;\dots\;z_{1}}</annotation></semantics></math></td></tr>
<tr id="A5.T1.1.9" class="ltx_tr">
<th id="A5.T1.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A5.T1.1.9.1.1" class="ltx_text" style="font-size:90%;">Select</span></th>
<td id="A5.T1.1.9.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T1.m15" class="ltx_Math" alttext="\mathtt{x_{1}\;\dots\;x_{n}\;=y}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">𝚡</mi><mn mathsize="0.900em">𝟷</mn></msub><mo lspace="0.280em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo lspace="0.280em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝚡</mi><mi mathsize="0.900em">𝚗</mi></msub></mrow><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">𝚢</mi></mrow><annotation encoding="application/x-tex">\mathtt{x_{1}\;\dots\;x_{n}\;=y}</annotation></semantics></math></td>
<td id="A5.T1.1.9.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A5.T1.1.9.3.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
</tbody>
</table>
</figure>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p">To reduce the data requirements, all Addition instances are in base 3.</p>
</div>
<div id="A5.p3" class="ltx_para">
<p id="A5.p3.1" class="ltx_p"><span id="A5.p3.1.1" class="ltx_text ltx_font_bold">Models.</span> We train GPT-2 models with various PEs. We summarize the PRFs of the IPEs and the PRF-SHs of the IPE-SHs used in the experiments in Table <a href="#A5.T2" title="TABLE II ‣ Appendix E Experimental Details ‣ On the Limitations and Capabilities of Position Embeddings for Length Generalization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">II</span></a>.</p>
</div>
<figure id="A5.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">TABLE II: </span>PRFs for the IPEs and PRF-SHs for the IPE-SHs in our experiments.</figcaption>
<table id="A5.T2.1" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A5.T2.1.1" class="ltx_tr">
<th id="A5.T2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A5.T2.1.1.1.1" class="ltx_text" style="font-size:90%;">Task</span></th>
<th id="A5.T2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A5.T2.1.1.2.1" class="ltx_text" style="font-size:90%;">PRF</span></th>
<th id="A5.T2.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A5.T2.1.1.3.1" class="ltx_text" style="font-size:90%;">PRF-SH</span></th></tr>
</thead>
