<th id="A5.T2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A5.T2.1.2.1.1" class="ltx_text" style="font-size:90%;">Copy</span></th>
<td id="A5.T2.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A5.T2.m1" class="ltx_Math" alttext="\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i-j=20,\\
0,&amp;\text{ otherwise}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">20</mn></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.700em"> otherwise</mtext><mo lspace="0em" mathsize="0.700em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i-j=20,\\
0,&amp;\text{ otherwise}.\end{array}\right.</annotation></semantics></math></td>
<td id="A5.T2.1.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="A5.T2.1.2.3.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
<tr id="A5.T2.1.3" class="ltx_tr">
<th id="A5.T2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T2.1.3.1.1" class="ltx_text" style="font-size:90%;">Shift</span></th>
<td id="A5.T2.1.3.2" class="ltx_td ltx_align_left"><math id="A5.T2.m2" class="ltx_Math" alttext="\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i=2N-1\text{ and }j=0,\\
2,&amp;\text{ if }i&lt;2N-1\text{ and }i-j=N-1,\\
0,&amp;\text{ otherwise}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">=</mo><mrow><mrow><mn mathsize="0.700em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">N</mi></mrow><mo mathsize="0.700em">−</mo><mrow><mn mathsize="0.700em">1</mn><mo lspace="0em" rspace="0em">​</mo><mtext mathsize="0.700em"> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">j</mi></mrow></mrow><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">2</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">&lt;</mo><mrow><mrow><mn mathsize="0.700em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">N</mi></mrow><mo mathsize="0.700em">−</mo><mrow><mn mathsize="0.700em">1</mn><mo lspace="0em" rspace="0em">​</mo><mtext mathsize="0.700em"> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mrow><mi mathsize="0.700em">N</mi><mo mathsize="0.700em">−</mo><mn mathsize="0.700em">1</mn></mrow></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.700em"> otherwise</mtext><mo lspace="0em" mathsize="0.700em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i=2N-1\text{ and }j=0,\\
2,&amp;\text{ if }i&lt;2N-1\text{ and }i-j=N-1,\\
0,&amp;\text{ otherwise}.\end{array}\right.</annotation></semantics></math></td>
<td id="A5.T2.1.3.3" class="ltx_td ltx_align_left"><span id="A5.T2.1.3.3.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
<tr id="A5.T2.1.4" class="ltx_tr">
<th id="A5.T2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T2.1.4.1.1" class="ltx_text" style="font-size:90%;">Parity (with CoT)</span></th>
<td id="A5.T2.1.4.2" class="ltx_td ltx_align_left"><math id="A5.T2.m3" class="ltx_Math" alttext="\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i-j=0,\\
2,&amp;\text{ if }i-j=N,\\
0,&amp;\text{ otherwise}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><mo mathsize="0.700em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">0</mn></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">2</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext mathsize="0.700em"> if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">i</mi></mrow><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">j</mi></mrow><mo mathsize="0.700em">=</mo><mi mathsize="0.700em">N</mi></mrow><mo mathsize="0.700em">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.700em">0</mn><mo mathsize="0.700em">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext mathsize="0.700em"> otherwise</mtext><mo lspace="0em" mathsize="0.700em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i-j=0,\\
2,&amp;\text{ if }i-j=N,\\
0,&amp;\text{ otherwise}.\end{array}\right.</annotation></semantics></math></td>
<td id="A5.T2.1.4.3" class="ltx_td ltx_align_left"><span id="A5.T2.1.4.3.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
<tr id="A5.T2.1.5" class="ltx_tr">
<th id="A5.T2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T2.1.5.1.1" class="ltx_text" style="font-size:90%;">Addition</span></th>
<td id="A5.T2.1.5.2" class="ltx_td ltx_align_left"><math id="A5.T2.m4" class="ltx_Math" alttext="\phi(i,j)=\left\{\begin{array}[]{ll}1,&amp;\text{ if }i-j=0,\\
2,&amp;\text{ if }i-j=N,\\
3,&amp;\text{ if }i-j=N+1,\\
4,&amp;\text{ if }i-j=2N+1,\\
5,&amp;\text{ if }i-j=2N+2,\\
