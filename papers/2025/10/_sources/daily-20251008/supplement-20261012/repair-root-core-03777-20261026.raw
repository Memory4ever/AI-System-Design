<tr id="A5.T6.4.1" class="ltx_tr">
<th id="A5.T6.4.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt">Model</th>
<th id="A5.T6.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt">Repeated Sampling</th>
<th id="A5.T6.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="A5.T6.4.1.3.1" class="ltx_text ltx_font_smallcaps">GuidedSampling</span></th>
<th id="A5.T6.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt">Diversity in RS</th>
<th id="A5.T6.4.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">Diversity in <span id="A5.T6.4.1.5.1" class="ltx_text ltx_font_smallcaps">GS</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T6.4.2" class="ltx_tr">
<td id="A5.T6.4.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">GPT-4o-mini</td>
<td id="A5.T6.4.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">85.71%</td>
<td id="A5.T6.4.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">90.00%</td>
<td id="A5.T6.4.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">3.2</td>
<td id="A5.T6.4.2.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">5.0</td></tr>
