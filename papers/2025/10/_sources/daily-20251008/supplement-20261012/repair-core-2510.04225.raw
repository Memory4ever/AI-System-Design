<td id="S4.T1.2.1.6.5" class="ltx_td ltx_align_center">-</td>
<td id="S4.T1.2.1.6.6" class="ltx_td ltx_align_center">0.275</td>
<td id="S4.T1.2.1.6.7" class="ltx_td ltx_align_center">0.136</td>
<td id="S4.T1.2.1.6.8" class="ltx_td ltx_align_center">0.269</td>
<td id="S4.T1.2.1.6.9" class="ltx_td ltx_nopad_r ltx_align_center">0.245</td></tr>
<tr id="S4.T1.2.1.7" class="ltx_tr">
<th id="S4.T1.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">E+G-32B (one-turn)</th>
<td id="S4.T1.2.1.7.2" class="ltx_td ltx_align_center">0.914</td>
<td id="S4.T1.2.1.7.3" class="ltx_td ltx_align_center">-</td>
