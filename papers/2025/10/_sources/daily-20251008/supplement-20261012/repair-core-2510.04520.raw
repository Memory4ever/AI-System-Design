</annotation></semantics></math></span><span id="lstnumberx146.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.24" class="ltx_text ltx_lst_identifier">R</span><span id="lstnumberx146.25" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.26" class="ltx_text ltx_lst_literate"><math id="lstnumberx146.m3" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math></span><span id="lstnumberx146.27" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.28" class="ltx_text ltx_lst_identifier">R</span><span id="lstnumberx146.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.30" class="ltx_text ltx_lst_literate"><math id="lstnumberx146.m4" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math></span><span id="lstnumberx146.31" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.32" class="ltx_text ltx_lst_identifier">Type</span><span id="lstnumberx146.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.34" class="ltx_text ltx_lst_identifier">u_1</span>’,<span id="lstnumberx146.35" class="ltx_text ltx_lst_space"> </span>’<span id="lstnumberx146.36" class="ltx_text ltx_lst_identifier">informal_name</span>’:<span id="lstnumberx146.37" class="ltx_text ltx_lst_space"> </span>’<span id="lstnumberx146.38" class="ltx_text ltx_lst_identifier">Quaternion</span><span id="lstnumberx146.39" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.40" class="ltx_text ltx_lst_identifier">Algebra</span>’,<span id="lstnumberx146.41" class="ltx_text ltx_lst_space"> </span>’<span id="lstnumberx146.42" class="ltx_text ltx_lst_identifier">informal_description</span>’:<span id="lstnumberx146.43" class="ltx_text ltx_lst_space"> </span>’<span id="lstnumberx146.44" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx146.45" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.46" class="ltx_text ltx_lst_identifier">structure</span><span id="lstnumberx146.47" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.48" class="ltx_text ltx_lst_identifier">representing</span><span id="lstnumberx146.49" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.50" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx146.51" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.52" class="ltx_text ltx_lst_identifier">quaternion</span><span id="lstnumberx146.53" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.54" class="ltx_text ltx_lst_identifier">algebra</span><span id="lstnumberx146.55" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.56" class="ltx_text ltx_lst_identifier">over</span><span id="lstnumberx146.57" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.58" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx146.59" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.60" class="ltx_text ltx_lst_identifier">commutative</span><span id="lstnumberx146.61" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.62" class="ltx_text ltx_lst_identifier">ring</span><span id="lstnumberx146.63" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.64" class="ltx_text"><math id="lstnumberx146.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math></span><span id="lstnumberx146.65" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.66" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx146.67" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.68" class="ltx_text ltx_lst_identifier">fixed</span><span id="lstnumberx146.69" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.70" class="ltx_text ltx_lst_identifier">coefficients</span><span id="lstnumberx146.71" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.72" class="ltx_text"><math id="lstnumberx146.m6" class="ltx_Math" alttext="a,b,c" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">a,b,c</annotation></semantics></math></span>,<span id="lstnumberx146.73" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.74" class="ltx_text ltx_lst_identifier">where</span><span id="lstnumberx146.75" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.76" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx146.77" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.78" class="ltx_text ltx_lst_identifier">elements</span><span id="lstnumberx146.79" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.80" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx146.81" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.82" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx146.83" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.84" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx146.85" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.86" class="ltx_text ltx_lst_identifier">form</span><span id="lstnumberx146.87" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.88" class="ltx_text"><math id="lstnumberx146.m7" class="ltx_Math" alttext="x+yi+zj+wk" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>+</mo><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">x+yi+zj+wk</annotation></semantics></math></span><span id="lstnumberx146.89" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.90" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx146.91" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.92" class="ltx_text"><math id="lstnumberx146.m8" class="ltx_Math" alttext="x,y,z,w\in R" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo>,</mo><mrow><mi>w</mi><mo>∈</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">x,y,z,w\in R</annotation></semantics></math></span><span id="lstnumberx146.93" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.94" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx146.95" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.96" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx146.97" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.98" class="ltx_text ltx_lst_identifier">multiplication</span><span id="lstnumberx146.99" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.100" class="ltx_text ltx_lst_identifier">rules</span><span id="lstnumberx146.101" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.102" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx146.103" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.104" class="ltx_text ltx_lst_identifier">determined</span><span id="lstnumberx146.105" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.106" class="ltx_text ltx_lst_identifier">by</span><span id="lstnumberx146.107" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.108" class="ltx_text"><math id="lstnumberx146.m9" class="ltx_Math" alttext="i^{2}=a+bi" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">i^{2}=a+bi</annotation></semantics></math></span><span id="lstnumberx146.109" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.110" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx146.111" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.112" class="ltx_text"><math id="lstnumberx146.m10" class="ltx_Math" alttext="j^{2}=c" display="inline" intent=":literal"><semantics><mrow><msup><mi>j</mi><mn>2</mn></msup><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">j^{2}=c</annotation></semantics></math></span>.<span id="lstnumberx146.113" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.114" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx146.115" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.116" class="ltx_text ltx_lst_identifier">structure</span><span id="lstnumberx146.117" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.118" class="ltx_text ltx_lst_identifier">has</span><span id="lstnumberx146.119" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.120" class="ltx_text ltx_lst_identifier">four</span><span id="lstnumberx146.121" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.122" class="ltx_text ltx_lst_identifier">components</span>:<span id="lstnumberx146.123" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.124" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx146.125" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.126" class="ltx_text ltx_lst_identifier">real</span><span id="lstnumberx146.127" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.128" class="ltx_text ltx_lst_identifier">part</span><span id="lstnumberx146.129" class="ltx_text ltx_lst_space"> </span>‘<span id="lstnumberx146.130" class="ltx_text ltx_lst_identifier">re</span>‘<span id="lstnumberx146.131" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.132" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx146.133" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.134" class="ltx_text ltx_lst_identifier">three</span><span id="lstnumberx146.135" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.136" class="ltx_text ltx_lst_identifier">imaginary</span><span id="lstnumberx146.137" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx146.138" class="ltx_text ltx_lst_identifier">parts</span><span id="lstnumberx146.139" class="ltx_text ltx_lst_space"> </span>‘<span id="lstnumberx146.140" class="ltx_text ltx_lst_identifier">imI</span>‘,<span id="lstnumberx146.141" class="ltx_text ltx_lst_space"> </span>‘<span id="lstnumberx146.142" class="ltx_text ltx_lst_identifier">imJ</span>‘,<span id="lstnumberx146.143" class="ltx_text ltx_lst_space"> </span>‘<span id="lstnumberx146.144" class="ltx_text ltx_lst_identifier">imK</span>‘.’}
</div>
</div>
</div>
<div id="A2.SS2.p8" class="ltx_para ltx_noindent">
<p id="A2.SS2.p8.1" class="ltx_p"><span id="A2.SS2.p8.1.1" class="ltx_text ltx_font_smallcaps">Matching And Assessment by Aria’s Semanctic Checker</span></p>
</div>
<div id="A2.SS2.p9" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS2.p9.pic1" class="ltx_picture" height="1434.24" overflow="visible" version="1.1" viewBox="0 0 550 1434.24" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,1434.24) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 1434.24 L 550 1434.24 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 1433.55 L 549.31 1433.55 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.32)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:98.75em;--ltx-fo-depth:3.09em;font-size:10pt;" height="1409.25" overflow="visible" transform="matrix(1 0 0 -1 0 1366.43)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.SS2.p9.pic1.1" class="ltx_inline-sectional-block ltx_minipage">
                    
<span id="A2.SS2.p9.pic1.p1" class="ltx_para">
<span id="A2.SS2.p9.pic1.p1.1" class="ltx_p"><span id="A2.SS2.p9.pic1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let’s compare the mathematical conditions and conclusions with the Lean 4 formal statement one by one:</span></span>
<span id="A2.I7" class="ltx_enumerate">
<span id="A2.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A2.I7.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i1.p1.1" class="ltx_p"><math id="A2.I7.i1.p1.m1" class="ltx_Math" alttext="A,B\in\mathbb{Q}^{\times}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">×</mo></msup></mrow><annotation encoding="application/x-tex">A,B\in\mathbb{Q}^{\times}</annotation></semantics></math><span id="A2.I7.i1.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;"> (i.e., <math id="A2.I7.i1.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="A2.I7.i1.p1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> are non-zero rational numbers).</span><span id="A2.I7.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></span>
<span id="A2.I7.i1.I1" class="ltx_itemize">
<span id="A2.I7.i1.I0.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i1.I0.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i1.I0.i1.p1.1" class="ltx_p"><span id="A2.I7.i1.I0.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Math: </span><math id="A2.I7.i1.I0.i1.p1.m1" class="ltx_Math" alttext="A,B\in\mathbb{Q}^{\times}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">×</mo></msup></mrow><annotation encoding="application/x-tex">A,B\in\mathbb{Q}^{\times}</annotation></semantics></math><span id="A2.I7.i1.I0.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i1.I0.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i1.I0.i2.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i1.I0.i2.p1.1" class="ltx_p"><span id="A2.I7.i1.I0.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Lean: </span><span id="A2.I7.i1.I0.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(A B : ℚ) (hA : A ≠ 0) (hB : B ≠ 0)</span><span id="A2.I7.i1.I0.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i1.I0.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i1.I0.i3.p1" class="ltx_para">
<span id="A2.I7.i1.I0.i3.p1.1" class="ltx_p"><span id="A2.I7.i1.I0.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Match: Perfectly match.</span></span>
</span></span>
</span>
</span></span>
<span id="A2.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A2.I7.i2.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i2.p1.1" class="ltx_p"><math id="A2.I7.i2.p1.m1" class="ltx_Math" alttext="D_{A,B,\mathbb{R}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></msub><annotation encoding="application/x-tex">D_{A,B,\mathbb{R}}</annotation></semantics></math><span id="A2.I7.i2.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;"> is an <math id="A2.I7.i2.p1.m2" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>-algebra defined on the set <math id="A2.I7.i2.p1.m3" class="ltx_math_unparsed" alttext="\{a+b\bm{i}+c\bm{j}+d\bm{k}\;|\;a,b,c,d\in\mathbb{R}\}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" fence="false" lspace="0.280em" mathcolor="#000000" rspace="0.447em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a+b\bm{i}+c\bm{j}+d\bm{k}\;|\;a,b,c,d\in\mathbb{R}\}</annotation></semantics></math>.</span><span id="A2.I7.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></span>
<span id="A2.I7.i2.I1" class="ltx_itemize">
<span id="A2.I7.i2.I0.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i2.I0.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i2.I0.i1.p1.1" class="ltx_p"><span id="A2.I7.i2.I0.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Math: The algebra is defined on the set of elements of the form </span><math id="A2.I7.i2.I0.i1.p1.m1" class="ltx_Math" alttext="a+b\bm{i}+c\bm{j}+d\bm{k}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒋</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒌</mi></mrow></mrow><annotation encoding="application/x-tex">a+b\bm{i}+c\bm{j}+d\bm{k}</annotation></semantics></math><span id="A2.I7.i2.I0.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> with real coefficients.</span></span>
</span></span>
<span id="A2.I7.i2.I0.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i2.I0.i2.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i2.I0.i2.p1.1" class="ltx_p"><span id="A2.I7.i2.I0.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Lean: </span><span id="A2.I7.i2.I0.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">QuaternionAlgebra ℝ (A : ℝ) (B : ℝ) 1</span><span id="A2.I7.i2.I0.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i2.I0.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i2.I0.i3.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i2.I0.i3.p1.1" class="ltx_p"><span id="A2.I7.i2.I0.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">According to the provided Mathlib entry for </span><span id="A2.I7.i2.I0.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">QuaternionAlgebra</span><span id="A2.I7.i2.I0.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, the elements are of the form </span><span id="A2.I7.i2.I0.i3.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">x + yi + zj + wk</span><span id="A2.I7.i2.I0.i3.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> where </span><span id="A2.I7.i2.I0.i3.p1.1.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">x, y, z, w</span><span id="A2.I7.i2.I0.i3.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> are from the base ring </span><span id="A2.I7.i2.I0.i3.p1.1.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">R</span><span id="A2.I7.i2.I0.i3.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;">, which is ℝ in this case. This matches the form of the elements.</span></span>
</span></span>
<span id="A2.I7.i2.I0.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i2.I0.i4.p1" class="ltx_para">
<span id="A2.I7.i2.I0.i4.p1.1" class="ltx_p"><span id="A2.I7.i2.I0.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Match: Perfectly match.</span></span>
</span></span>
</span>
</span></span>
<span id="A2.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<span id="A2.I7.i3.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i3.p1.1" class="ltx_p"><span id="A2.I7.i3.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">The multiplication in <math id="A2.I7.i3.p1.m1" class="ltx_Math" alttext="D_{A,B,\mathbb{R}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></msub><annotation encoding="application/x-tex">D_{A,B,\mathbb{R}}</annotation></semantics></math> is defined by the relations: <math id="A2.I7.i3.p1.m2" class="ltx_Math" alttext="\bm{i}^{2}=A" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=A</annotation></semantics></math>, <math id="A2.I7.i3.p1.m3" class="ltx_Math" alttext="\bm{j}^{2}=B" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><annotation encoding="application/x-tex">\bm{j}^{2}=B</annotation></semantics></math>, and <math id="A2.I7.i3.p1.m4" class="ltx_Math" alttext="\bm{i}\bm{j}=-\bm{j}\bm{i}=\bm{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></mrow><annotation encoding="application/x-tex">\bm{i}\bm{j}=-\bm{j}\bm{i}=\bm{k}</annotation></semantics></math>.</span><span id="A2.I7.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></span>
<span id="A2.I7.i3.I1" class="ltx_itemize">
<span id="A2.I7.i3.I0.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i3.I0.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i3.I0.i1.p1.1" class="ltx_p"><span id="A2.I7.i3.I0.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Math: The multiplication rules are </span><math id="A2.I7.i3.I0.i1.p1.m1" class="ltx_Math" alttext="\bm{i}^{2}=A" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=A</annotation></semantics></math><span id="A2.I7.i3.I0.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A2.I7.i3.I0.i1.p1.m2" class="ltx_Math" alttext="\bm{j}^{2}=B" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒋</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi></mrow><annotation encoding="application/x-tex">\bm{j}^{2}=B</annotation></semantics></math><span id="A2.I7.i3.I0.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i3.I0.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i3.I0.i2.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i3.I0.i2.p1.1" class="ltx_p"><span id="A2.I7.i3.I0.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Lean: The multiplication is determined by </span><span id="A2.I7.i3.I0.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">QuaternionAlgebra ℝ (A : ℝ) (B : ℝ) 1</span><span id="A2.I7.i3.I0.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i3.I0.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i3.I0.i3.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i3.I0.i3.p1.1" class="ltx_p"><span id="A2.I7.i3.I0.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">According to the provided Mathlib entry, </span><span id="A2.I7.i3.I0.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">QuaternionAlgebra R a b c</span><span id="A2.I7.i3.I0.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> has multiplication rules </span><math id="A2.I7.i3.I0.i3.p1.m1" class="ltx_Math" alttext="i^{2}=a+bi" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">i^{2}=a+bi</annotation></semantics></math><span id="A2.I7.i3.I0.i3.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A2.I7.i3.I0.i3.p1.m2" class="ltx_Math" alttext="j^{2}=c" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi></mrow><annotation encoding="application/x-tex">j^{2}=c</annotation></semantics></math><span id="A2.I7.i3.I0.i3.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">. For the Lean statement, </span><span id="A2.I7.i3.I0.i3.p1.1.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">R</span><span id="A2.I7.i3.I0.i3.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> is ℝ, </span><span id="A2.I7.i3.I0.i3.p1.1.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">a</span><span id="A2.I7.i3.I0.i3.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> is </span><span id="A2.I7.i3.I0.i3.p1.1.10" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(A : ℝ)</span><span id="A2.I7.i3.I0.i3.p1.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><span id="A2.I7.i3.I0.i3.p1.1.12" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">b</span><span id="A2.I7.i3.I0.i3.p1.1.13" class="ltx_text" style="--ltx-fg-color:#000000;"> is </span><span id="A2.I7.i3.I0.i3.p1.1.14" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(B : ℝ)</span><span id="A2.I7.i3.I0.i3.p1.1.15" class="ltx_text" style="--ltx-fg-color:#000000;">, and </span><span id="A2.I7.i3.I0.i3.p1.1.16" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">c</span><span id="A2.I7.i3.I0.i3.p1.1.17" class="ltx_text" style="--ltx-fg-color:#000000;"> is 1. This implies the rules are </span><math id="A2.I7.i3.I0.i3.p1.m3" class="ltx_Math" alttext="\bm{i}^{2}=A+B\bm{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=A+B\bm{i}</annotation></semantics></math><span id="A2.I7.i3.I0.i3.p1.1.18" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A2.I7.i3.I0.i3.p1.m4" class="ltx_Math" alttext="\bm{j}^{2}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒋</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">\bm{j}^{2}=1</annotation></semantics></math><span id="A2.I7.i3.I0.i3.p1.1.19" class="ltx_text" style="--ltx-fg-color:#000000;">. These rules do not match the mathematical rules.</span></span>
</span></span>
<span id="A2.I7.i3.I0.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i3.I0.i4.p1" class="ltx_para">
<span id="A2.I7.i3.I0.i4.p1.1" class="ltx_p"><span id="A2.I7.i3.I0.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Match: Major inconsistency.</span></span>
</span></span>
</span>
</span></span>
<span id="A2.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<span id="A2.I7.i4.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i4.p1.1" class="ltx_p"><math id="A2.I7.i4.p1.m1" class="ltx_Math" alttext="D_{A,B,\mathbb{R}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></msub><annotation encoding="application/x-tex">D_{A,B,\mathbb{R}}</annotation></semantics></math><span id="A2.I7.i4.p1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;"> is isomorphic to <math id="A2.I7.i4.p1.m2" class="ltx_Math" alttext="\mathbb{H}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℍ</mi><annotation encoding="application/x-tex">\mathbb{H}</annotation></semantics></math> (the Hamilton quaternions) or isomorphic to <math id="A2.I7.i4.p1.m3" class="ltx_Math" alttext="\mathrm{Mat}_{2\times 2}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Mat</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Mat}_{2\times 2}(\mathbb{R})</annotation></semantics></math> (the algebra of 2x2 real matrices) as <math id="A2.I7.i4.p1.m4" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>-algebras.</span><span id="A2.I7.i4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></span>
<span id="A2.I7.i4.I1" class="ltx_itemize">
<span id="A2.I7.i4.I0.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i4.I0.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i4.I0.i1.p1.1" class="ltx_p"><span id="A2.I7.i4.I0.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Math: </span><math id="A2.I7.i4.I0.i1.p1.m1" class="ltx_Math" alttext="(D_{A,B,\mathbb{R}}\cong\mathbb{H})\lor(D_{A,B,\mathbb{R}}\cong\mathrm{Mat}_{2\times 2}(\mathbb{R}))" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℍ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∨</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Mat</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(D_{A,B,\mathbb{R}}\cong\mathbb{H})\lor(D_{A,B,\mathbb{R}}\cong\mathrm{Mat}_{2\times 2}(\mathbb{R}))</annotation></semantics></math><span id="A2.I7.i4.I0.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i4.I0.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i4.I0.i2.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i4.I0.i2.p1.1" class="ltx_p"><span id="A2.I7.i4.I0.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Lean: </span><span id="A2.I7.i4.I0.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">Nonempty (QuaternionAlgebra ℝ (A : ℝ) (B : ℝ) 1 ≃ₐ[ℝ] (QuaternionAlgebra ℝ (-1) (-1) 1)) ∨ Nonempty (QuaternionAlgebra ℝ (A : ℝ) (B : ℝ) 1 ≃ₐ[ℝ] Matrix (Fin 2) (Fin 2) ℝ)</span><span id="A2.I7.i4.I0.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i4.I0.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i4.I0.i3.p1" class="ltx_para ltx_noindent">
<span id="A2.I7.i4.I0.i3.p1.1" class="ltx_p"><span id="A2.I7.i4.I0.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The conclusion in Lean concerns the algebra </span><span id="A2.I7.i4.I0.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">QuaternionAlgebra ℝ (A : ℝ) (B : ℝ) 1</span><span id="A2.I7.i4.I0.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, which, as established in point 3, is not the same as </span><math id="A2.I7.i4.I0.i3.p1.m1" class="ltx_Math" alttext="D_{A,B,\mathbb{R}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi></mrow></msub><annotation encoding="application/x-tex">D_{A,B,\mathbb{R}}</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">. Furthermore, the Hamilton quaternions (</span><math id="A2.I7.i4.I0.i3.p1.m2" class="ltx_Math" alttext="\mathbb{H}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℍ</mi><annotation encoding="application/x-tex">\mathbb{H}</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">), defined by </span><math id="A2.I7.i4.I0.i3.p1.m3" class="ltx_Math" alttext="\bm{i}^{2}=-1,\bm{j}^{2}=-1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒋</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=-1,\bm{j}^{2}=-1</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, are represented in Lean as </span><span id="A2.I7.i4.I0.i3.p1.1.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">QuaternionAlgebra ℝ (-1) (-1) 1</span><span id="A2.I7.i4.I0.i3.p1.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">. According to the provided documentation, this corresponds to an algebra with rules </span><math id="A2.I7.i4.I0.i3.p1.m4" class="ltx_Math" alttext="\bm{i}^{2}=-1-\bm{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒊</mi></mrow></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=-1-\bm{i}</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A2.I7.i4.I0.i3.p1.m5" class="ltx_Math" alttext="\bm{j}^{2}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒋</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">\bm{j}^{2}=1</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.10" class="ltx_text" style="--ltx-fg-color:#000000;">, which is not </span><math id="A2.I7.i4.I0.i3.p1.m6" class="ltx_Math" alttext="\mathbb{H}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℍ</mi><annotation encoding="application/x-tex">\mathbb{H}</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">. While the representation of </span><math id="A2.I7.i4.I0.i3.p1.m7" class="ltx_Math" alttext="\mathrm{Mat}_{2\times 2}(\mathbb{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Mat</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Mat}_{2\times 2}(\mathbb{R})</annotation></semantics></math><span id="A2.I7.i4.I0.i3.p1.1.12" class="ltx_text" style="--ltx-fg-color:#000000;"> as </span><span id="A2.I7.i4.I0.i3.p1.1.13" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">Matrix (Fin 2) (Fin 2) ℝ</span><span id="A2.I7.i4.I0.i3.p1.1.14" class="ltx_text" style="--ltx-fg-color:#000000;"> is correct, the overall statement is about different algebraic structures than those in the mathematical problem.</span></span>
</span></span>
<span id="A2.I7.i4.I0.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i4.I0.i4.p1" class="ltx_para">
<span id="A2.I7.i4.I0.i4.p1.1" class="ltx_p"><span id="A2.I7.i4.I0.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Match: Major inconsistency.</span></span>
</span></span>
</span>
</span></span>
</span>
</span>
                    
<section id="A2.SS2.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Check for missing conditions / implicit conditions:</h4>

<span id="A2.SS2.SSSx1.p1" class="ltx_para">
<span id="A2.I8" class="ltx_itemize">
<span id="A2.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I8.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I8.i1.p1.1" class="ltx_p"><span id="A2.I8.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">No missing conditions / implicit conditions</span></span>
</span></span>
<span id="A2.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I8.i2.p1" class="ltx_para">
<span id="A2.I8.i2.p1.1" class="ltx_p"><span id="A2.I8.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Match: Perfectly match.</span></span>
</span></span>
</span>
</span>
</section>
                  </span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS2.p10" class="ltx_para ltx_noindent">
<p id="A2.SS2.p10.1" class="ltx_p"><span id="A2.SS2.p10.1.1" class="ltx_text ltx_font_smallcaps">Analysis</span></p>
</div>
<div id="A2.SS2.p11" class="ltx_para ltx_noindent">
<p id="A2.SS2.p11.1" class="ltx_p">In this case, the informal statement introduces <math id="A2.SS2.p11.m1" class="ltx_Math" alttext="D_{A,B,\mathbb{R}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>A</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>ℝ</mi></mrow></msub><annotation encoding="application/x-tex">D_{A,B,\mathbb{R}}</annotation></semantics></math> with multiplication rules: <math id="A2.SS2.p11.m2" class="ltx_Math" alttext="\bm{i}^{2}=A" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒊</mi><mn>2</mn></msup><mo>=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=A</annotation></semantics></math>, <math id="A2.SS2.p11.m3" class="ltx_Math" alttext="\bm{j}^{2}=B" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒋</mi><mn>2</mn></msup><mo>=</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\bm{j}^{2}=B</annotation></semantics></math>, and <math id="A2.SS2.p11.m4" class="ltx_Math" alttext="\bm{i}\bm{j}=-\bm{j}\bm{i}=\bm{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒋</mi></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>𝒋</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒊</mi></mrow></mrow><mo>=</mo><mi>𝒌</mi></mrow><annotation encoding="application/x-tex">\bm{i}\bm{j}=-\bm{j}\bm{i}=\bm{k}</annotation></semantics></math>. However, the corresponding Lean term actually has completely different rules:<math id="A2.SS2.p11.m5" class="ltx_Math" alttext="\bm{i}^{2}=A+B\bm{i},\bm{j}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒊</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒊</mi></mrow></mrow></mrow><mo>,</mo><mrow><msup><mi>𝒋</mi><mn>2</mn></msup><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\bm{i}^{2}=A+B\bm{i},\bm{j}^{2}=1</annotation></semantics></math>. These differences are not perceptible by surface text comparison, Both the informal and formal version use <math id="A2.SS2.p11.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="A2.SS2.p11.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, and have similar algebra structure. By term-level grounding, AriaChecker gets the explicit retrieval of the definition of <span id="A2.SS2.p11.1.1" class="ltx_text ltx_font_typewriter">QuaternionAlgebra</span>, making the semantic incorrectness obvious to AriaScorer. While LeanScorer is deceived by apparent textual similarity and misjudges this case, AriaScorer correctly flags it as "Major Inconsistency". This demonstrates that Defintion Discrepancy Detection enables AriaScorer to distinguish semantic incorrectness, ensuring that the formal statement aligns with the formal statement in mathematical intent.</p>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Hallucination Suppression via Grounding</h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p"><span id="A2.SS3.p1.1.1" class="ltx_text ltx_font_smallcaps">Informal Statement</span></p>
</div>
<div id="A2.SS3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS3.p2.pic1" class="ltx_picture" height="55.45" overflow="visible" version="1.1" viewBox="0 0 550 55.45" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,55.45) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 55.45 L 550 55.45 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 54.76 L 549.31 54.76 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.96)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:1.95em;--ltx-fo-depth:0.25em;font-size:10pt;" height="30.44" overflow="visible" transform="matrix(1 0 0 -1 0 26.98)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS3.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.8em;">
<span id="A2.SS3.p2.pic1.1.1" class="ltx_p"><span id="A2.SS3.p2.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let <math id="A2.SS3.p2.pic1.m1" class="ltx_Math" alttext="\alpha=\sqrt{(2+\sqrt{2})(3+\sqrt{3})}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\alpha=\sqrt{(2+\sqrt{2})(3+\sqrt{3})}</annotation></semantics></math> and consider the extension <math id="A2.SS3.p2.pic1.m2" class="ltx_Math" alttext="E=\mathbb{Q}(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E=\mathbb{Q}(\alpha)</annotation></semantics></math>. Show that <math id="A2.SS3.p2.pic1.m3" class="ltx_Math" alttext="\mathrm{Gal}(E/\mathbb{Q})\cong Q_{8}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Gal</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></msub></mrow><annotation encoding="application/x-tex">\mathrm{Gal}(E/\mathbb{Q})\cong Q_{8}</annotation></semantics></math>, the quaternion group of order <math id="A2.SS3.p2.pic1.m4" class="ltx_Math" alttext="8" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn><annotation encoding="application/x-tex">8</annotation></semantics></math>.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS3.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.p3.1" class="ltx_p"><span id="A2.SS3.p3.1.1" class="ltx_text ltx_font_smallcaps">Conditions and Conclusions</span></p>
</div>
<div id="A2.SS3.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS3.p4.pic1" class="ltx_picture" height="264.85" overflow="visible" version="1.1" viewBox="0 0 550 264.85" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,264.85) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 264.85 L 550 264.85 L 550 0 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 264.16 L 549.31 264.16 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 134.96)"><foreignObject style="--ltx-fo-width:36.8em;--ltx-fo-height:8.48em;--ltx-fo-depth:8.85em;font-size:10pt;" height="239.84" overflow="visible" transform="matrix(1 0 0 -1 0 117.39)" width="509.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS3.p4.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.8em;">
<span id="A2.SS3.p4.pic1.1.1" class="ltx_p"><span id="A2.SS3.p4.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Conditions:<span id="A2.SS3.p4.pic1.1.1.1.1" class="ltx_text"></span></span></span>
<span id="A2.I9" class="ltx_enumerate">
<span id="A2.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A2.I9.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I9.i1.p1.1" class="ltx_p"><math id="A2.I9.i1.p1.m1" class="ltx_Math" alttext="\alpha=\sqrt{(2+\sqrt{2})(3+\sqrt{3})}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\alpha=\sqrt{(2+\sqrt{2})(3+\sqrt{3})}</annotation></semantics></math></span>
</span></span>
<span id="A2.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A2.I9.i2.p1" class="ltx_para">
<span id="A2.I9.i2.p1.1" class="ltx_p"><math id="A2.I9.i2.p1.m1" class="ltx_Math" alttext="E=\mathbb{Q}(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E=\mathbb{Q}(\alpha)</annotation></semantics></math><span id="A2.I9.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> (E is the smallest field containing both </span><math id="A2.I9.i2.p1.m2" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math><span id="A2.I9.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A2.I9.i2.p1.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="A2.I9.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">)</span></span>
</span></span>
</span>
<span id="A2.SS3.p4.pic1.1.2" class="ltx_p"><span id="A2.SS3.p4.pic1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Conclusion:<span id="A2.SS3.p4.pic1.1.2.1.1" class="ltx_text"></span></span></span>
<span id="A2.I10" class="ltx_itemize">
<span id="A2.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I10.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I10.i1.p1.1" class="ltx_p"><span id="A2.I10.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The Galois group of the extension </span><math id="A2.I10.i1.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="A2.I10.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> over </span><math id="A2.I10.i1.p1.m2" class="ltx_Math" alttext="\mathbb{Q}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><annotation encoding="application/x-tex">\mathbb{Q}</annotation></semantics></math><span id="A2.I10.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> is isomorphic to the quaternion group </span><math id="A2.I10.i1.p1.m3" class="ltx_Math" alttext="Q_{8}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></msub><annotation encoding="application/x-tex">Q_{8}</annotation></semantics></math><span id="A2.I10.i1.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">. In mathematical notation:</span></span>
<span id="A2.Ex1" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex1.m1" class="ltx_math_unparsed" alttext="\mathrm{Gal}(E/\mathbb{Q})\cong Q_{8},\text{ where:}" display="block" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Gal</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000"> where:</mtext></mrow><annotation encoding="application/x-tex">\mathrm{Gal}(E/\mathbb{Q})\cong Q_{8},\text{ where:}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A2.I10.i1.I1" class="ltx_itemize">
<span id="A2.I10.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I10.i1.I1.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<span id="A2.I10.i1.I1.i1.p1" class="ltx_para ltx_noindent">
<span id="A2.I10.i1.I1.i1.p1.1" class="ltx_p"><math id="A2.I10.i1.I1.i1.p1.m1" class="ltx_math_unparsed" alttext="\mathrm{Gal}(E/\mathbb{Q})=\{\sigma:E\to E\mid\sigma\text{ is a field automorphism and }\forall x\in\mathbb{Q},\sigma(x)=x\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Gal</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000"> is a field automorphism and </mtext><mo style="--ltx-fg-color:#000000;" lspace="0.167em" mathcolor="#000000" rspace="0.167em">∀</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℚ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Gal}(E/\mathbb{Q})=\{\sigma:E\to E\mid\sigma\text{ is a field automorphism and }\forall x\in\mathbb{Q},\sigma(x)=x\}</annotation></semantics></math></span>
</span></span>
<span id="A2.I10.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A2.I10.i1.I1.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<span id="A2.I10.i1.I1.i2.p1" class="ltx_para">
<span id="A2.I10.i1.I1.i2.p1.1" class="ltx_p"><math id="A2.I10.i1.I1.i2.p1.m1" class="ltx_math_unparsed" alttext="Q_{8}=\langle x,y\mid x^{4}=1,x^{2}=y^{2},y^{-1}xy=x^{-1}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo stretchy="false">⟨</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{8}=\langle x,y\mid x^{4}=1,x^{2}=y^{2},y^{-1}xy=x^{-1}\rangle</annotation></semantics></math><span id="A2.I10.i1.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> is the quaternion group of order 8.</span></span>
</span></span>
</span>
</span></span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS3.p5" class="ltx_para ltx_noindent">
<p id="A2.SS3.p5.1" class="ltx_p"><span id="A2.SS3.p5.1.1" class="ltx_text ltx_font_smallcaps">Formal Statement translated by Aria</span></p>
</div>
<div id="A2.SS3.p6" class="ltx_para ltx_noindent">
<div id="A2.SS3.p6.1" class="ltx_listing ltx_lst_language_lean ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx147" class="ltx_listingline"><span id="lstnumberx147.1" class="ltx_text ltx_lst_identifier">import</span><span id="lstnumberx147.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx147.3" class="ltx_text ltx_lst_identifier">Mathlib</span>
</div>
<div id="lstnumberx148" class="ltx_listingline">
</div>
<div id="lstnumberx149" class="ltx_listingline"><span id="lstnumberx149.1" class="ltx_text ltx_lst_identifier">open</span><span id="lstnumberx149.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx149.3" class="ltx_text ltx_lst_identifier">Polynomial</span>
</div>
<div id="lstnumberx150" class="ltx_listingline">
</div>
<div id="lstnumberx151" class="ltx_listingline">/–
</div>
