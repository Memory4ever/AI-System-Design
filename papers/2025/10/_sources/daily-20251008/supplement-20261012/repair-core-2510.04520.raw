<td id="A3.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T3.2.1.2.1" class="ltx_text ltx_font_bold">Final acc.</span></td></tr>
<tr id="A3.T3.2.2" class="ltx_tr">
