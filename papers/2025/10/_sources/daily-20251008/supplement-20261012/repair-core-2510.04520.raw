n id="lstnumberx37.19" class="ltx_text ltx_lst_identifier">K</span><span id="lstnumberx37.20" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx37.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx37.22" class="ltx_text ltx_lst_literate"><math id="lstnumberx37.m4" class="ltx_Math" alttext="\bot" display="inline" intent=":literal"><semantics><mo>⊥</mo><annotation encoding="application/x-tex">\bot</annotation></semantics></math></span>)
