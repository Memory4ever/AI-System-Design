<td id="S3.T1.4.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T1.4.2.4.1" class="ltx_text" style="font-size:90%;">1.0</span></td>
<td id="S3.T1.4.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T1.4.2.5.1" class="ltx_text" style="font-size:90%;">0.6</span></td>
