<th id="S3.T1.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{rec}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">rec</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{rec}}</annotation></semantics></math></th>
<th id="S3.T1.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{KL}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">KL</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{KL}}</annotation></semantics></math></th>
<th id="S3.T1.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m3" class="ltx_Math" alttext="\mathcal{L}_{\text{reg}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">reg</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{reg}}</annotation></semantics></math></th>
<th id="S3.T1.4.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m4" class="ltx_Math" alttext="\mathcal{L}_{\text{nei}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">nei</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{nei}}</annotation></semantics></math></th>
<th id="S3.T1.4.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m5" class="ltx_Math" alttext="\mathcal{L}_{\text{pitch}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">pitch</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{pitch}}</annotation></semantics></math></th>
<th id="S3.T1.4.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m6" class="ltx_Math" alttext="\mathcal{L}_{\text{inst}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">inst</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{inst}}</annotation></semantics></math></th>
<th id="S3.T1.4.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="S3.T1.m7" class="ltx_Math" alttext="\mathcal{L}_{\text{fam}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℒ</mi><mtext mathsize="0.900em">fam</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{fam}}</annotation></semantics></math></th></tr>
