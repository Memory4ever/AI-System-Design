<tr id="S3.T1.4.3" class="ltx_tr">
<th id="S3.T1.4.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r"><math id="S3.T1.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math></th>
<td id="S3.T1.4.3.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S3.T1.4.3.2.1" class="ltx_text" style="font-size:90%;">–</span></td>
