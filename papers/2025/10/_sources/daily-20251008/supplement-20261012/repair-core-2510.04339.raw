<span id="p2.1.2.1.2.1" class="ltx_p ltx_align_center"><span id="p2.1.2.1.2.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Stefan Weinzierl 
<br class="ltx_break" style="--ltx-break-space:5.7pt;"></span><span id="p2.1.2.1.2.1.2" class="ltx_text" style="font-size:90%;">
</span><a href="https://www.tu.berlin/en/ak" title="" class="ltx_ref ltx_href" style="font-size:90%;">Audio Communication Group</a></span>
<span id="p2.1.2.1.2.2" class="ltx_p ltx_align_center"><span id="p2.1.2.1.2.2.1" class="ltx_text" style="font-size:90%;">Technische Universität Berlin</span></span>
<span id="p2.1.2.1.2.3" class="ltx_p ltx_align_center"><span id="p2.1.2.1.2.3.1" class="ltx_text" style="font-size:90%;">Berlin, DE</span></span>
<span id="p2.1.2.1.2.4" class="ltx_p ltx_align_center"><a href="mailto:stefan.weinzierl@tu-berlin.de" title="" class="ltx_ref ltx_href ltx_font_typewriter" style="font-size:90%;">stefan.weinzierl@tu-berlin.de</a></span>
</span></td></tr>
