<td id="S5.T3.2.1.8.16" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb" style="padding:1pt 1.5pt;"><span id="S5.T3.2.1.8.16.1" class="ltx_text ltx_font_bold">100.00</span></td>
