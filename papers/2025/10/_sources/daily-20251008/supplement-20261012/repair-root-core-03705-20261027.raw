<td id="S5.T3.2.1.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">Align</td>
<td id="S5.T3.2.1.2.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">None</td>
<td id="S5.T3.2.1.2.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">Sand</td>
<td id="S5.T3.2.1.2.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">Ins</td>
<td id="S5.T3.2.1.2.10" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">Rem</td>
<td id="S5.T3.2.1.2.11" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">StruQ</td>
<td id="S5.T3.2.1.2.12" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:1pt 1.5pt;">Align</td>
