<section id="A2.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.7 </span>Further Analysis</h3>

<figure id="A2.T13" class="ltx_table">
<table id="A2.T13.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
