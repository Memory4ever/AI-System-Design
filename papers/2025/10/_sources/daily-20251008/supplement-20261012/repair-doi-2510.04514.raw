{"data":{"id":"10.48550/arxiv.2510.04514","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04514","prefix":"10.48550","suffix":"arxiv.2510.04514","identifiers":[{"identifier":"2510.04514","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.04514"}],"creators":[{"name":"Kaur, Rachneet","nameType":"Personal","givenName":"Rachneet","familyName":"Kaur","affiliation":[],"nameIdentifiers":[]},{"name":"Srishankar, Nishan","nameType":"Personal","givenName":"Nishan","familyName":"Srishankar","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Ganesh, Sumitra","nameType":"Personal","givenName":"Sumitra","familyName":"Ganesh","affiliation":[],"nameIdentifiers":[]},{"name":"Veloso, Manuela","nameType":"Personal","givenName":"Manuela","familyName":"Veloso","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ChartAgent: A Multimodal Agent for Visually Grounded Reasoning in Complex Chart Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computational Engineering, Finance, and Science (cs.CE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Methodology (stat.ME)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T06:05:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:16:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-07T06:02:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-08T01:21:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-08T20:02:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-10T00:09:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent multimodal LLMs have shown promise in chart-based visual question answering, but their performance declines sharply on unannotated charts-those requiring precise visual interpretation rather than relying on textual shortcuts. To address this, we introduce ChartAgent, a novel agentic framework that explicitly performs visual reasoning directly within the chart's spatial domain. Unlike textual chain-of-thought reasoning, ChartAgent iteratively decomposes queries into visual subtasks and actively manipulates and interacts with chart images through specialized actions such as drawing annotations, cropping regions (e.g., segmenting pie slices, isolating bars), and localizing axes, using a library of chart-specific vision tools to fulfill each subtask. This iterative reasoning process closely mirrors human cognitive strategies for chart comprehension. ChartAgent achieves state-of-the-art accuracy on the ChartBench and ChartX benchmarks, surpassing prior methods by up to 16.07% absolute gain overall and 17.31% on unannotated, numerically intensive queries. Furthermore, our analyses show that ChartAgent is (a) effective across diverse chart types, (b) achieves the highest scores across varying visual and reasoning complexity levels, and (c) serves as a plug-and-play framework that boosts performance across diverse underlying LLMs. Our work is among the first to demonstrate visually grounded reasoning for chart understanding using tool-augmented multimodal agents.","descriptionType":"Abstract"},{"description":"Accepted at ACL 2026 (Main Conference). Also presented as an oral paper at the NeurIPS 2025 Multimodal Algorithmic Reasoning Workshop (https://marworkshop.github.io/neurips25/)","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.04514","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:16:22.000Z","registered":"2025-10-07T03:16:23.000Z","published":"2025","updated":"2026-06-10T02:30:04.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.04514","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}