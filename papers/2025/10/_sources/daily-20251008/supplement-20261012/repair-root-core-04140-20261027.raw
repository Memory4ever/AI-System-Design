<td id="S4.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFFF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">AMC</span></td>
<td id="S4.T1.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFFF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.2.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Minerva</span></td>
