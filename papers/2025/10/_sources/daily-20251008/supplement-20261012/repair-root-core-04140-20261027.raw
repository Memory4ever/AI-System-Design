<tr id="S4.T1.4.1.4" class="ltx_tr">
<th id="S4.T1.4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:-0.05pt 4.2pt;">Base</th>
<td id="S4.T1.4.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5F5FF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#F5F5FF;">10.6</span></td>
<td id="S4.T1.4.1.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5F5FF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#F5F5FF;">0.1</span></td>
<td id="S4.T1.4.1.4.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5F5FF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#F5F5FF;">0.0</span></td>
<td id="S4.T1.4.1.4.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5F5FF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#F5F5FF;">1.8</span></td>
<td id="S4.T1.4.1.4.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5F5FF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.4.6.1" class="ltx_text" style="--ltx-bg-color:#F5F5FF;">4.4</span></td>
<td id="S4.T1.4.1.4.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F5F5FF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.4.7.1" class="ltx_text" style="--ltx-bg-color:#F5F5FF;">2.1</span></td>
