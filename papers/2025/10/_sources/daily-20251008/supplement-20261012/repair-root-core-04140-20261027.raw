<td id="S4.T1.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.05pt 4.2pt;" colspan="6"><span id="S4.T1.4.1.1.2.1" class="ltx_text ltx_font_bold">In-Domain Performance</span></td>
<td id="S4.T1.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.05pt 4.2pt;" colspan="3"><span id="S4.T1.4.1.1.3.1" class="ltx_text ltx_font_bold">Out-of-Domain</span></td>
<td id="S4.T1.4.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="--ltx-bg-color:#FFFFFF;padding:-0.05pt 4.2pt;" rowspan="3"><span id="S4.T1.4.1.1.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFFFFF;">Avg</span></td></tr>
<tr id="S4.T1.4.1.2" class="ltx_tr">
