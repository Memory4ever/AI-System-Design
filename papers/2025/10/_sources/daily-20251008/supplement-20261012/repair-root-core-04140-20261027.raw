<td id="S4.T1.4.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFFF;padding:-0.05pt 4.2pt;"><span id="S4.T1.4.1.2.9.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">MMLU-Pro</span></td></tr>
