<td id="S2.T1.7.1.8.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.05pt 4.0pt;"><span id="S2.T1.7.1.8.3.1" class="ltx_text" style="font-size:80%;">99.84</span></td>
