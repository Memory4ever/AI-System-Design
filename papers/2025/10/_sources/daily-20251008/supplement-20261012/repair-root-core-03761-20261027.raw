<td id="S3.T3.5.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S3.T3.5.1.2.1" class="ltx_text ltx_font_bold">CRED</span></td>
<td id="S3.T3.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S3.T3.5.1.3.1" class="ltx_text ltx_font_bold">PII</span></td>
<td id="S3.T3.5.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S3.T3.5.1.4.1" class="ltx_text ltx_font_bold">NETID</span></td>
<td id="S3.T3.5.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S3.T3.5.1.5.1" class="ltx_text ltx_font_bold">Costs</span></td></tr>
<tr id="S3.T3.5.2" class="ltx_tr">
<td id="S3.T3.5.2.1" class="ltx_td ltx_align_left"><span id="S3.T3.5.2.1.1" class="ltx_text ltx_font_bold">Model</span></td>
<td id="S3.T3.5.2.2" class="ltx_td ltx_align_center"><span id="S3.T3.5.2.2.1" class="ltx_text ltx_font_bold">EMA</span></td>
<td id="S3.T3.5.2.3" class="ltx_td ltx_align_center"><span id="S3.T3.5.2.3.1" class="ltx_text ltx_font_bold">ONE</span></td>
<td id="S3.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T3.5.2.4.1" class="ltx_text ltx_font_bold">O</span></td>
<td id="S3.T3.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.5.1" class="ltx_text ltx_font_bold">TP</span></td>
<td id="S3.T3.5.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.6.1" class="ltx_text ltx_font_bold">FP</span></td>
<td id="S3.T3.5.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.5.2.7.1" class="ltx_text ltx_font_bold">FN</span></td>
<td id="S3.T3.5.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.8.1" class="ltx_text ltx_font_bold">TP</span></td>
<td id="S3.T3.5.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.9.1" class="ltx_text ltx_font_bold">FP</span></td>
<td id="S3.T3.5.2.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.5.2.10.1" class="ltx_text ltx_font_bold">FN</span></td>
<td id="S3.T3.5.2.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.11.1" class="ltx_text ltx_font_bold">TP</span></td>
<td id="S3.T3.5.2.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.12.1" class="ltx_text ltx_font_bold">FP</span></td>
<td id="S3.T3.5.2.13" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.5.2.13.1" class="ltx_text ltx_font_bold">FN</span></td>
<td id="S3.T3.5.2.14" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.2.14.1" class="ltx_text ltx_font_bold">MT</span></td>
<td id="S3.T3.5.2.15" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T3.5.2.15.1" class="ltx_text ltx_font_bold">ALL</span></td></tr>
<tr id="S3.T3.5.3" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="S3.T3.5.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T3.5.3.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">GPT-5</span></td>
<td id="S3.T3.5.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">82.7%</span></td>
<td id="S3.T3.5.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">91.7%</span></td>
<td id="S3.T3.5.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.5.3.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">✗</span></td>
<td id="S3.T3.5.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.5.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">50</span></td>
<td id="S3.T3.5.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.6.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">3</span></td>
<td id="S3.T3.5.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.5.3.7.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">0</span></td>
<td id="S3.T3.5.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.8.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">42</span></td>
<td id="S3.T3.5.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.9.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">16</span></td>
<td id="S3.T3.5.3.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.5.3.10.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">2</span></td>
<td id="S3.T3.5.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.11.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">38</span></td>
<td id="S3.T3.5.3.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.5.3.12.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">9</span></td>
