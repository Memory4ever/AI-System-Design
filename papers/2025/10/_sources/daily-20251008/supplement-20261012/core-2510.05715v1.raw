<th id="A3.T5.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">75 <math id="A3.T5.m6" class="ltx_Math" alttext="\overline{\text{Age}}_{|\delta|\downarrow}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mtext>Age</mtext><mo stretchy="true">¯</mo></mover><mrow><mrow><mo stretchy="false">|</mo><mi>δ</mi><mo stretchy="false">|</mo></mrow><mo stretchy="false">↓</mo><mphantom></mphantom></mrow></msub><annotation encoding="application/x-tex">\overline{\text{Age}}_{|\delta|\downarrow}</annotation></semantics></math></th>
<th id="A3.T5.5.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">75 MAE<math id="A3.T5.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T5.5.2" class="ltx_tr">
<td id="A3.T5.5.2.1" class="ltx_td ltx_align_center ltx_border_t">1</td>
<td id="A3.T5.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T5.m8" class="ltx_Math" alttext="20.51_{5.51}" display="inline" intent=":literal"><semantics><msub><mn>20.51</mn><mn>5.51</mn></msub><annotation encoding="application/x-tex">20.51_{5.51}</annotation></semantics></math></td>
<td id="A3.T5.5.2.3" class="ltx_td ltx_align_center ltx_border_t">6.73</td>
