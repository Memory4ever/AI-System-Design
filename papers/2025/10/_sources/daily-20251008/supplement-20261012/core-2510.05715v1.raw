<td id="A3.T5.5.4.2" class="ltx_td ltx_align_center"><math id="A3.T5.m12" class="ltx_Math" alttext="\underline{16.79}_{\underline{1.79}}" display="inline" intent=":literal"><semantics><msub><munder accentunder="true"><mn>16.79</mn><mo stretchy="true">¯</mo></munder><munder accentunder="true"><mn>1.79</mn><mo stretchy="true">¯</mo></munder></msub><annotation encoding="application/x-tex">\underline{16.79}_{\underline{1.79}}</annotation></semantics></math></td>
<td id="A3.T5.5.4.3" class="ltx_td ltx_align_center"><span id="A3.T5.5.4.3.1" class="ltx_text ltx_font_bold">2.82</span></td>
<td id="A3.T5.5.4.4" class="ltx_td ltx_align_center"><math id="A3.T5.m13" class="ltx_Math" alttext="\underline{78.82}_{\underline{3.82}}" display="inline" intent=":literal"><semantics><msub><munder accentunder="true"><mn>78.82</mn><mo stretchy="true">¯</mo></munder><munder accentunder="true"><mn>3.82</mn><mo stretchy="true">¯</mo></munder></msub><annotation encoding="application/x-tex">\underline{78.82}_{\underline{3.82}}</annotation></semantics></math></td>
<td id="A3.T5.5.4.5" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A3.T5.5.4.5.1" class="ltx_text ltx_underline">3.98</span></td></tr>
<tr id="A3.T5.5.5" class="ltx_tr">
