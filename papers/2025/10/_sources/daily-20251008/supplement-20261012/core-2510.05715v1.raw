<td id="A3.T5.5.2.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">6.89</td></tr>
<tr id="A3.T5.5.3" class="ltx_tr">
<td id="A3.T5.5.3.1" class="ltx_td ltx_align_center">5</td>
<td id="A3.T5.5.3.2" class="ltx_td ltx_align_center"><math id="A3.T5.m10" class="ltx_Math" alttext="11.95_{3.05}" display="inline" intent=":literal"><semantics><msub><mn>11.95</mn><mn>3.05</mn></msub><annotation encoding="application/x-tex">11.95_{3.05}</annotation></semantics></math></td>
