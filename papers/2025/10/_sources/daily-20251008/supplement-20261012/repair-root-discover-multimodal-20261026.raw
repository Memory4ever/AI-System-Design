{"data":[{"id":"10.48550/arxiv.2510.03419","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03419","identifiers":[{"identifier":"2510.03419","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joseph","familyName":"Rawson","name":"Rawson, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Domniki","familyName":"Ladopoulou","name":"Ladopoulou, Domniki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Petros","familyName":"Dellaportas","name":"Dellaportas, Petros","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-task Neural Diffusion Processes"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T18:26:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:05:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-16T12:40:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-19T01:34:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-15T12:14:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-16T01:10:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural diffusion processes provide a scalable, non-Gaussian approach to modelling distributions over functions, but existing formulations are limited to single-task inference and do not capture dependencies across related tasks. We propose multi-task neural diffusion processes (MT-NDPs), an extension that incorporates a task encoder to enable task-conditioned probabilistic regression and few-shot adaptation across related functions. The task encoder extracts a low-dimensional representation from context observations and conditions the diffusion model on this representation, allowing information sharing across tasks while accommodating variable-sized context sets and preserving permutation invariance with respect to the ordering of context observations. We evaluate MT-NDPs through synthetic experiments and two real-world applications involving wind turbine data and school examination outcomes. The results demonstrate improved predictive accuracy relative to single-task diffusion baselines when context observations are available, alongside competitive performance against neural-process and Gaussian-process alternatives. In the wind-energy application, MT-NDPs achieve the lowest average coverage error among the evaluated models at larger context sizes, demonstrating improved predictive uncertainty calibration. Overall, our findings highlight the potential of task-conditioned diffusion models for uncertainty-aware multi-task regression and few-shot adaptation to previously unseen tasks."},{"descriptionType":"Other","description":"37 pages, 16 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03419","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:49:27Z","registered":"2025-10-07T02:49:28Z","published":null,"updated":"2026-10-16T03:15:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04532","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04532","identifiers":[{"identifier":"2510.04532","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xurui","familyName":"Song","name":"Song, Xurui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Huai","name":"Huai, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"JingJing","familyName":"Jiang","name":"Jiang, JingJing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Kong","name":"Kong, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Luo","name":"Luo, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"More Than Meets the Eye? Uncovering the Reasoning-Planning Disconnect in Training Vision-Language Driving Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T06:50:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:17:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-08T02:08:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-09T00:26:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Model (VLM) driving agents promise explainable end-to-end autonomy by first producing natural-language reasoning and then predicting trajectory planning. However, whether planning is causally driven by this reasoning remains a critical but unverified assumption. To investigate this, we build DriveMind, a large-scale driving Visual Question Answering corpus with plan-aligned Chain-of-Thought (CoT), automatically generated from nuPlan. Our data generation process converts sensors and annotations into structured inputs and, crucially, separates priors from to-be-reasoned signals, enabling clean information ablations. Using DriveMind, we train representative VLM agents with Supervised Fine-Tuning and Group Relative Policy Optimization and evaluate them with nuPlan's metrics. Our results, unfortunately, indicate a consistent causal disconnect in reasoning-planning: removing ego/navigation priors causes large drops in planning scores, whereas removing CoT produces only minor changes. Attention analysis further shows that planning primarily focuses on priors rather than the CoT. Based on this evidence, we propose the Reasoning-Planning Decoupling Hypothesis, positing that the training-yielded reasoning is an ancillary byproduct rather than a causal mediator. To enable efficient diagnosis, we introduce a novel, training-free probe that measures an agent's reliance on priors by evaluating its planning robustness against minor input perturbations. In summary, we provide the community with a new dataset and a diagnostic tool to evaluate the causal fidelity of future models."},{"descriptionType":"Other","description":"NeurIPS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04532","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:16:48Z","registered":"2025-10-07T03:16:49Z","published":null,"updated":"2026-10-09T03:15:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04525","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04525","identifiers":[{"identifier":"2510.04525","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Satoshi","familyName":"Hayakawa","name":"Hayakawa, Satoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhta","familyName":"Takida","name":"Takida, Yuhta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masaaki","familyName":"Imaizumi","name":"Imaizumi, Masaaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiromi","familyName":"Wakaki","name":"Wakaki, Hiromi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuki","familyName":"Mitsufuji","name":"Mitsufuji, Yuki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Demystifying MaskGIT Sampler and Beyond: Adaptive Order Selection in Masked Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Probability (math.PR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T06:30:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:16:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-31T05:31:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-23T00:52:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-28T07:09:20Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-29T02:20:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Masked diffusion models have shown promising performance in generating high-quality samples in a wide range of domains, but accelerating their sampling process remains relatively underexplored. To investigate efficient samplers for masked diffusion, this paper theoretically analyzes the MaskGIT sampler for image modeling, revealing its implicit temperature sampling mechanism. Through this analysis, we show that MaskGIT is asymptotically equivalent to a choose-then-sample (CTS) formulation, instantiated as the \"moment sampler,\" which explicitly separates index selection from token sampling. This CTS reformulation is essential: it yields unbiased token sampling and exposes an algorithmic design space for index selection, both of which are inaccessible in MaskGIT's original formulation. Regarding token sampling, we reveal that MaskGIT implicitly adopts a low-temperature sampler, which explains why MaskGIT often degrades with more sampling steps. The CTS reformulation of MaskGIT allows us to fix the temperature sampling to ensure unbiasedness. We also improve the index selection in CTS through two key innovations: a partial caching technique for transformers that approximates longer sampling trajectories without proportional computational cost, and a hybrid approach formalizing the exploration-exploitation trade-off in adaptive unmasking. Experiments in image and text domains demonstrate our theory as well as the efficiency of our proposed methods, advancing both theoretical understanding and practical implementation of masked diffusion samplers."},{"descriptionType":"Other","description":"TMLR Featured Certification"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04525","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:16:38Z","registered":"2025-10-07T03:16:39Z","published":null,"updated":"2026-09-29T06:56:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03519","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03519","identifiers":[{"identifier":"2510.03519","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fangxu","familyName":"Yu","name":"Yu, Fangxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyu","familyName":"Zhao","name":"Zhao, Hongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Zhou","name":"Zhou, Tianyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TS-Reasoner: Aligning Time Series Foundation Models with LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T21:20:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:11:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-01T20:02:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T00:44:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-19T18:00:06Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-21T00:03:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series reasoning is crucial to decision-making in diverse domains, including finance, energy, and scientific discovery. While existing time series foundation models (TSFMs) can capture low-level dynamic patterns and provide accurate forecasting, further analysis usually requires additional background knowledge and sophisticated reasoning, which are lacking in most TSFMs but can be achieved through Large Language Models (LLMs). On the other hand, without expensive post-training, LLMs often struggle with the numerical understanding of time series data. Although it is intuitive to integrate the two types of models, developing effective training recipes that align the two modalities for reasoning tasks is still an open challenge. To this end, we propose TS-Reasoner that aligns the latent representations of TSFMs with the textual inputs of LLMs for downstream understanding/reasoning tasks. Specifically, we propose a simple yet effective method to curate diverse, synthetic pairs of time series and textual captions for alignment training. We then develop a two-stage training recipe that applies instruction fine-tuning after the alignment pretraining. Unlike existing works that train an LLM to take time series as inputs, we leverage a pretrained TSFM and freeze it during training. Experiments on several benchmarks demonstrate that TS-Reasoner not only outperforms a wide range of open-source LLMs, Vision-Language Models (VLMs), and Time Series LLMs of comparable scale, but also does so with remarkable data efficiency, e.g., using less than half the training data."},{"descriptionType":"Other","description":"Accepted to Transactions on Machine Learning Research, 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03519","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:51:54Z","registered":"2025-10-07T02:51:55Z","published":null,"updated":"2026-08-21T02:22:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03880","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03880","identifiers":[{"identifier":"2510.03880","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunhao","familyName":"Li","name":"Li, Yunhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sijing","familyName":"Wu","name":"Wu, Sijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Jia","name":"Jia, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Fu","name":"Fu, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Jia","name":"Jia, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yucheng","familyName":"Zhu","name":"Zhu, Yucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Sun","name":"Sun, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangtao","familyName":"Zhai","name":"Zhai, Guangtao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Instruction Data Quality for Explainable Image Quality Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T17:12:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:39:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-13T16:47:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-14T01:02:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent years, with the rapid development of large multimodal models (LMMs), explainable image quality assessment (IQA) has attracted increasing attention, aiming to understand the perceptual quality problems of images. Existing studies typically construct large-scale instruction tuning datasets to enhance the quality perception capabilities of LMMs, following the data scaling law. However, as the fundamental capabilities of LMMs continue to improve, existing instruction tuning datasets may contain redundant and less challenging samples, resulting in substantial computational costs. In this paper, we investigate whether data quantity remains the dominant factor in LMM instruction tuning for explainable IQA. Based on a strong pre-trained LMM, we observe that randomly selecting a properly sized subset of training data can outperform full-data fine-tuning, indicating substantial redundancy in existing instruction tuning datasets. Motivated by this observation, we propose Q-Selector, a clustering-based data selection framework consisting of three stages: hierarchical LMM-based clustering feature extraction, cluster quota allocation through density and transferability, and SVD-based cluster sampling strategy. Specifically, Q-Selector extracts multi-layer features from the vision encoder, text encoder, and large language model components of LMMs as clustering features. It then determines the sampling quota for each cluster based on inter-cluster transferability and intra-cluster density. Finally, Q-Selector employs a Singular Value Decomposition (SVD)-based sampling strategy to select high-quality instruction data. Experimental results demonstrate that Q-Selector achieves 102.1% and 103.7% of the performance of full-data fine-tuning using only 10% of the training data on explainable IQA and image aesthetics assessment tasks, respectively."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03880","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:00:46Z","registered":"2025-10-07T03:00:47Z","published":null,"updated":"2026-08-14T02:22:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03434","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03434","identifiers":[{"identifier":"2510.03434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiying","familyName":"Jiang","name":"Jiang, Zhiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raihan","familyName":"Seraj","name":"Seraj, Raihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcos","familyName":"Villagra","name":"Villagra, Marcos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bidhan","familyName":"Roy","name":"Roy, Bidhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Paris: A Decentralized Trained Open-Weight Diffusion Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T18:53:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:06:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-12T03:17:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T02:02:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-31T16:40:13Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-03T00:57:55Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present Paris, the first publicly released diffusion model pre-trained entirely through decentralized computation. Paris demonstrates that high-quality text-to-image generation can be achieved without centrally coordinated infrastructure. Paris is open for research and commercial use. Paris required implementing our Distributed Diffusion Training framework from scratch. The model consists of 8 expert diffusion models (129M-605M parameters each) trained in complete isolation with no gradient, parameter, or intermediate activation synchronization. Rather than requiring synchronized gradient updates across thousands of GPUs, we partition data into semantically coherent clusters where each expert independently optimizes its subset while collectively approximating the full distribution. A lightweight transformer router dynamically selects appropriate experts at inference, achieving generation quality comparable to centrally coordinated baselines. Eliminating synchronization enables training on heterogeneous hardware without specialized interconnects. Empirical validation confirms that Paris's decentralized training maintains generation quality while removing the dedicated GPU cluster requirement for large-scale diffusion models. Paris achieves this using 14$\\times$ less training data and 16$\\times$ less compute than the prior decentralized baseline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03434","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:49:49Z","registered":"2025-10-07T02:49:49Z","published":null,"updated":"2026-08-03T02:08:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03314","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03314","identifiers":[{"identifier":"2510.03314","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shucheng","familyName":"Zhang","name":"Zhang, Shucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Shi","name":"Shi, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingzhang","familyName":"Wang","name":"Wang, Bingzhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuang","familyName":"Zhang","name":"Zhang, Yuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Monjurul","familyName":"Karim","name":"Karim, Muhammad Monjurul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kehua","familyName":"Chen","name":"Chen, Kehua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxi","familyName":"Liu","name":"Liu, Chenxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehrdad","familyName":"Nasri","name":"Nasri, Mehrdad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinhai","familyName":"Wang","name":"Wang, Yinhai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Camera-Based Sensing to Reasoning: A Comprehensive Review Toward Proactive Vulnerable Road User Safety"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T23:50:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:02:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-25T05:48:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-28T00:19:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tits.2026.3707876","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ensuring the safety of vulnerable road users (VRUs), such as pedestrians and cyclists, remains a critical challenge, as conventional infrastructure-based measures are often insufficient in dynamic urban environments. Recent advances in learning-based visual sensing systems have created new opportunities for more adaptive and context-aware VRU protection. This paper presents a comprehensive review of camera-based methods for proactive VRU safety, with a focus on developments over the past five years. Unlike prior surveys that primarily emphasize detection, we organize the literature into three interconnected components: visual perception (detection and classification), motion modeling (tracking and trajectory prediction), and behavior understanding (intent recognition and reasoning). These components form a unified hierarchical pipeline that enables early risk anticipation and timely intervention. Furthermore, this survey systematically incorporates emerging AI paradigms, including Vision Transformers (ViTs), Large Language Models (LLMs), and diffusion models, highlighting their roles in representation learning, uncertainty modeling, and semantic reasoning. Finally, we identify four key challenges specific to VRU safety, including data scarcity, behavioral uncertainty, edge deployment efficiency, and real-world sensing constraints, and discuss corresponding research directions. This work provides a unified foundation for the development of reliable, scalable, and deployable VRU safety systems."},{"descriptionType":"Other","description":"18 pages, 4 figures, 5 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03314","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-07T02:46:55Z","registered":"2025-10-07T02:46:56Z","published":null,"updated":"2026-07-28T03:48:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04019","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04019","identifiers":[{"identifier":"2510.04019","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anthony","familyName":"Zhan","name":"Zhan, Anthony","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simple Policy Gradients for Reasoning with Diffusion Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T03:53:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:47:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-01T03:54:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:59:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-23T05:31:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-24T00:25:29Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion large language models (dLLMs) represent a promising alternative to autoregressive LLMs; however, the lack of effective post-training techniques, including reinforcement learning (RL), remains a key challenge for dLLMs, especially for downstream applications. Existing approaches often rely on a sequence-level view that requires biased likelihood approximations. In this work, we propose Amortized Group Relative Policy Optimization (AGRPO), a policy gradient algorithm that leverages the Markovian nature of dLLMs, optimizing individual denoising steps rather than full sequences. Our approach improves alignment between the trained policy and the inference process and also admits efficient, unbiased gradient updates via a novel timestep estimation scheme. We demonstrate AGRPO's effectiveness on different math and reasoning tasks, achieving absolute accuracy gains of +59.4\\% and +69.7\\% on Countdown and Sudoku over the base LLaDA model, exceeding comparable methods such as diffu-GRPO. Code is available at https://github.com/probablyabot/agrpo."},{"descriptionType":"Other","description":"19 pages. ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04019","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:04:13Z","registered":"2025-10-07T03:04:13Z","published":null,"updated":"2026-07-24T02:11:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04547","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04547","identifiers":[{"identifier":"2510.04547","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seunghyeon","familyName":"Kim","name":"Kim, Seunghyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taesun","familyName":"Yeom","name":"Yeom, Taesun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinho","familyName":"Kim","name":"Kim, Jinho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wonpyo","familyName":"Park","name":"Park, Wonpyo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyuyeun","familyName":"Kim","name":"Kim, Kyuyeun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeho","familyName":"Lee","name":"Lee, Jaeho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Activation Quantization of Vision Encoders Needs Prefixing Registers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T07:27:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:18:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T06:33:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:27:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-28T12:54:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-01T02:26:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-19T12:18:57Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-20T00:55:25Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-07-08T06:28:12Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-07-09T00:24:47Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large pretrained vision encoders are central to multimodal intelligence, powering applications from on-device vision processing to vision-language models. Since these applications often demand real-time processing of massive visual data, reducing the inference cost of vision encoders is critical. Quantization offers a practical path, but it remains challenging even at 8-bit precision due to so-called outliers. In this work, we propose $\\textit{RegCache}$, a training-free algorithm that mitigates outliers in large-scale pretrained vision encoders and serves as a plug-in module that can be applied on top of other quantization methods. RegCache introduces outlier-prone yet semantically meaningless prefix tokens to the vision encoder, which prevent other tokens from having outliers. Notably, we observe that outliers in vision encoders behave differently from those in language models, motivating two technical innovations: middle-layer prefixing and token deletion. Experimental results show that our method consistently improves quantized model performance across various vision encoders, particularly in extremely low-bit regimes (e.g., 4-bit)."},{"descriptionType":"Other","description":"Accepted to ECCV 2026. Code: https://github.com/spbob0418/RegCache"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04547","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:17:11Z","registered":"2025-10-07T03:17:12Z","published":null,"updated":"2026-07-09T02:02:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04157","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04157","identifiers":[{"identifier":"2510.04157","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Efrayim","familyName":"Yanir","name":"Yanir, Efrayim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Burshtein","name":"Burshtein, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharon","familyName":"Gannot","name":"Gannot, Sharon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GDiffuSE: Diffusion-based speech enhancement with noise model guidance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T11:22:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:54:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T10:41:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-01T00:38:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icassp55912.2026.11462263","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a novel speech enhancement (SE) approach based on a denoising diffusion probabilistic model (DDPM), termed Guided diffusion for speech enhancement (GDiffuSE). In contrast to conventional methods that directly map noisy speech to clean speech, our method employs a lightweight helper model to estimate the noise distribution, which is then incorporated into the diffusion denoising process via a guidance mechanism. This design improves robustness by enabling seamless adaptation to unseen noise types and by leveraging large-scale DDPMs originally trained for speech generation in the context of SE. We evaluate our approach on noisy signals obtained by adding noise samples from the BBC sound effects database to LibriSpeech utterances, showing consistent improvements over state-of-the-art baselines under mismatched noise conditions. Examples are available at our project webpage."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04157","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-07T03:07:37Z","registered":"2025-10-07T03:07:38Z","published":null,"updated":"2026-07-01T02:27:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03584","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03584","identifiers":[{"identifier":"2510.03584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chaoyu","familyName":"Li","name":"Li, Chaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianzhi","familyName":"Li","name":"Li, Tianzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Tao","name":"Tao, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyu","familyName":"Zhao","name":"Zhao, Zhenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqian","familyName":"Wu","name":"Wu, Ziqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maozheng","familyName":"Zhao","name":"Zhao, Maozheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntong","familyName":"Song","name":"Song, Juntong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Niu","name":"Niu, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pooyan","familyName":"Fazli","name":"Fazli, Pooyan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FrameOracle: Learning What to See and How Much to See in Videos"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T00:24:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:15:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-30T05:18:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:27:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-13T07:46:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T00:27:09Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models (VLMs) advance video understanding but operate under tight computational budgets, making performance dependent on selecting a small, high-quality subset of frames. Existing frame sampling strategies, such as uniform or fixed-budget selection, fail to adapt to variations in content density or task complexity. To address this, we present FrameOracle, a lightweight, plug-and-play module that predicts both (1) which frames are most relevant to a given query and (2) how many frames are needed. FrameOracle is trained via a curriculum that progresses from weak proxy signals, such as cross-modal similarity, to stronger supervision with FrameOracle-41K, the first large-scale VideoQA dataset with validated keyframe annotations specifying minimal sufficient frames per question. Extensive experiments across five VLMs and six benchmarks show that FrameOracle reduces 16-frame inputs to an average of 10.4 frames without accuracy loss. When starting from 64-frame candidates, it reduces inputs to 13.9 frames on average while improving accuracy by 1.5%, achieving state-of-the-art efficiency-accuracy trade-offs for scalable video understanding."},{"descriptionType":"Other","description":"ICML 2026. Project page: https://people-robots.github.io/frameoracle/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03584","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:53:28Z","registered":"2025-10-07T02:53:29Z","published":null,"updated":"2026-06-16T04:06:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03896","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03896","identifiers":[{"identifier":"2510.03896","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingyu","familyName":"Liu","name":"Liu, Mingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Huang","name":"Huang, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Lin","name":"Lin, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muzhi","familyName":"Zhu","name":"Zhu, Muzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Canyu","familyName":"Zhao","name":"Zhao, Canyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yating","familyName":"Wang","name":"Wang, Yating","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyi","familyName":"Zhu","name":"Zhu, Haoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunhua","familyName":"Shen","name":"Shen, Chunhua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GAE: Unleashing Physical Potential of VLM with Generalizable Action Expert"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T18:33:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:40:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-11T03:17:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-12T00:23:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models demonstrate strong reasoning and planning abilities, yet grounding these predictions into precise robot actions remains a central challenge. Existing Vision-Language-Action methods typically entangle reasoning and action generation, leading to limited generalization. We propose Generalizable Action Expert (GAE), a task-agnostic model that converts sparse geometric plans into dense robot actions. Our approach introduces a sparse geometric interface: the VLM predicts sparse 3D waypoints representing high-level intention, while GAE maps these waypoints together with real-time point cloud observations to continuous action trajectories. GAE is pretrained on a large-scale pointcloud-trajectory dataset comprising 150k trajectories from both simulation and real-world robots. To further improve efficiency and generalization, we introduce an Action Pre-training, Pointcloud Fine-tuning (APPF) scheme that decouples learning action dynamics from geometry grounding. After pretraining, GAE is frozen and reused across downstream tasks, requiring only lightweight fine-tuning of the VLM to produce the sparse interface. Experiments show that our method achieves strong performance and generalization across diverse visual domains, camera viewpoints, and natural language instructions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03896","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:01:11Z","registered":"2025-10-07T03:01:12Z","published":null,"updated":"2026-06-12T02:19:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04718","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04718","identifiers":[{"identifier":"2510.04718","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rodney","familyName":"Nicolaas","name":"Nicolaas, Rodney","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sascha","familyName":"Caron","name":"Caron, Sascha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fiorenzo","familyName":"Stoppa","name":"Stoppa, Fiorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saptashwa","familyName":"Bhattacharyya","name":"Bhattacharyya, Saptashwa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto Ruiz","familyName":"de Austri","name":"de Austri, Roberto Ruiz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul J.","familyName":"Groot","name":"Groot, Paul J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew J.","familyName":"Levan","name":"Levan, Andrew J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BGRem: A background noise remover for astronomical images based on a diffusion model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T11:37:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:28:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T11:41:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:43:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-11T08:21:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-10T13:31:44Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1051/0004-6361/202557715","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Context: Astronomical imaging aims to maximize signal capture while minimizing noise. Enhancing the signal-to-noise ratio directly on detectors is difficult and expensive, leading to extensive research in advanced post-processing techniques.\n Aims: Removing background noise from images is a valuable pre-processing step catalog-building tasks. We introduce BGRem, a machine learning (ML) based tool to remove background noise from astronomical images.\n Methods: BGRem uses a diffusion-based model with an attention U-Net as backbone, trained on simulated images for optical and gamma (γ)-ray data from the MeerLICHT and Fermi-LAT telescopes. In a supervised manner, BGRem learns to denoise astronomical images over several diffusion steps.\n Results: BGRem performance was compared with a widely used tool for cataloging astronomical sources, SourceExtractor (SExtractor). It was shown that the amount of true positive sources using SExtractor increased by about 7% for MeerLICHT data when BGRem was used as a pre-processing step. We also show the generalizability of BGRem by testing it with optical images from different telescopes and also on simulated γ-ray data representative of the Fermi-LAT telescope. We show that in both cases, BGRem improves the source detection efficiency.\n Conclusions: BGRem can improve the accuracy in source detection of traditional pixel-based methods by removing complex background noise. Using zero-shot approach, BGRem can generalize well to a wide range of optical images. The successful application of BGRem to simulated γ-ray images, alongside optical data, demonstrates its adaptability to distinct noise characteristics and observational domains. This cross-wavelength performance highlights its potential as a general-purpose background removal framework for multi-wavelength astronomical surveys."},{"descriptionType":"Other","description":"Accepted version in A\u0026amp;A before any editorial changes"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04718","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-07T03:21:20Z","registered":"2025-10-07T03:21:20Z","published":null,"updated":"2026-06-11T02:25:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03550","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03550","identifiers":[{"identifier":"2510.03550","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junbao","familyName":"Zhou","name":"Zhou, Junbao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Zhou","name":"Zhou, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kesen","familyName":"Zhao","name":"Zhao, Kesen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingshan","familyName":"Xu","name":"Xu, Qingshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beier","familyName":"Zhu","name":"Zhu, Beier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richang","familyName":"Hong","name":"Hong, Richang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanwang","familyName":"Zhang","name":"Zhang, Hanwang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Streaming Drag-Oriented Interactive Video Manipulation: Drag Anything, Anytime!"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T22:38:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:13:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-20T01:47:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-21T01:04:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-08T20:23:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T01:25:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-28T15:10:18Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-29T01:14:02Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Achieving streaming, fine-grained control over the outputs of autoregressive video diffusion models remains challenging, making it difficult to ensure that they consistently align with user expectations. To bridge this gap, we propose \\textbf{stReaming drag-oriEnted interactiVe vidEo manipuLation (REVEL)}, a new task that enables users to modify generated videos \\emph{anytime} on \\emph{anything} via fine-grained, interactive drag. Beyond DragVideo and SG-I2V, REVEL unifies drag-style video manipulation as editing and animating video frames with both supporting user-specified translation, deformation, and rotation effects, making drag operations versatile. In resolving REVEL, we observe: \\emph{i}) drag-induced perturbations accumulate in latent space, causing severe latent distribution drift that halts the drag process; \\emph{ii}) streaming drag is easily disturbed by context frames, thereby yielding visually unnatural outcomes. We thus propose a training-free approach, \\textbf{DragStream}, comprising: \\emph{i}) an adaptive distribution self-rectification strategy that leverages neighboring frames' statistics to effectively constrain the drift of latent embeddings; \\emph{ii}) a spatial-frequency selective optimization mechanism, allowing the model to fully exploit contextual information while mitigating its interference via selectively propagating visual cues along generation. Our method can be seamlessly integrated into existing autoregressive video diffusion models, and extensive experiments firmly demonstrate the effectiveness of our DragStream."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03550","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:52:39Z","registered":"2025-10-07T02:52:40Z","published":null,"updated":"2026-05-29T02:57:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04533","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04533","identifiers":[{"identifier":"2510.04533","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunmin","familyName":"Cho","name":"Cho, Hyunmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donghoon","familyName":"Ahn","name":"Ahn, Donghoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susung","familyName":"Hong","name":"Hong, Susung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jee Eun","familyName":"Kim","name":"Kim, Jee Eun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungryong","familyName":"Kim","name":"Kim, Seungryong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyong Hwan","familyName":"Jin","name":"Jin, Kyong Hwan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TAG: Tangential Amplifying Guidance for Hallucination-Resistant Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T06:53:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:17:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-26T13:18:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-27T00:59:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models achieve state-of-the-art image generation but often produce semantic inconsistencies, or hallucinations. Existing inference-time guidance methods rely on external signals or architectural modifications, adding computational overhead. We propose $\\mathbf{T}$angential $\\mathbf{A}$mplifying $\\mathbf{G}$uidance $\\mathbf{(TAG)}$, a training-free, architecture-agnostic, plug-and-play guidance method that operates purely on trajectory signals. TAG uses an intermediate sample as a projection basis and amplifies the tangential components of the estimated score to correct the sampling trajectory. A first-order Taylor analysis shows that this steers the state toward higher-probability regions of the data manifold, reducing inconsistencies and improving fidelity while adding negligible overhead to existing samplers. Code is available at our Project Page (https://hyeon-cho.github.io/TAG/)."},{"descriptionType":"Other","description":"Accepted to ICML 2026 (Regular)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04533","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:16:50Z","registered":"2025-10-07T03:16:51Z","published":null,"updated":"2026-05-27T02:36:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03352","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03352","identifiers":[{"identifier":"2510.03352","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mahdi","familyName":"Farahbakhsh","name":"Farahbakhsh, Mahdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishnu Teja","familyName":"Kunde","name":"Kunde, Vishnu Teja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dileep","familyName":"Kalathil","name":"Kalathil, Dileep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishna","familyName":"Narayanan","name":"Narayanan, Krishna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-Francois","familyName":"Chamberland","name":"Chamberland, Jean-Francois","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Inference-Time Search Using Side Information for Diffusion-Based Image Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T20:16:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:03:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-17T17:13:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-20T01:06:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-26T02:33:06Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-27T00:23:54Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have been used as priors for solving inverse problems. However, existing approaches typically overlook side information that could significantly improve reconstruction quality, especially in severely ill-posed settings. In this work, we propose a novel framework that incorporates side information into existing diffusion-based inverse problem solvers via inference-time search, in a plug-and-play, training-free manner. Through extensive experiments across a range of inverse problems, including inpainting, super-resolution, and several deblurring tasks, and across multiple diffusion-based inverse problem solvers (DPS, DAPS, and MPGD), we show that augmenting each solver with our framework consistently improves the quality of the reconstructions over the corresponding original method. To demonstrate the generality of our approach, we consider diverse forms of side information, including reference images, textual descriptions, and anatomical MRI scans. The code is available at this \\href{https://github.com/mahdi-farahbakhsh/DISS}{repository}\\footnote{https://github.com/mahdi-farahbakhsh/DISS}."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03352","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:47:49Z","registered":"2025-10-07T02:47:50Z","published":null,"updated":"2026-05-27T02:36:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03827","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03827","identifiers":[{"identifier":"2510.03827","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xueyang","familyName":"Zhou","name":"Zhou, Xueyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangming","familyName":"Xu","name":"Xu, Yangming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guiyao","familyName":"Tie","name":"Tie, Guiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongchao","familyName":"Chen","name":"Chen, Yongchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guowen","familyName":"Zhang","name":"Zhang, Guowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duanfeng","familyName":"Chu","name":"Chu, Duanfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Zhou","name":"Zhou, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichao","familyName":"Sun","name":"Sun, Lichao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LIBERO-PRO: Towards Robust and Fair Evaluation of Vision-Language-Action Models Beyond Memorization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T14:56:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:36:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-25T08:44:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-26T01:36:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LIBERO has emerged as a widely adopted benchmark for evaluating Vision-Language-Action (VLA) models; however, its current training and evaluation settings are problematic, often leading to inflated performance estimates and preventing fair model comparison. To address these issues, we introduce LIBERO-PRO, an extended LIBERO benchmark that systematically evaluates model performance under reasonable perturbations across four dimensions: manipulated objects, initial states, task instructions, and environments. Experimental results reveal that, although existing models achieve over 90% accuracy under the standard LIBERO evaluation, their performance collapses to 0.0% under our generalized setting. Crucially, this discrepancy exposes the models' reliance on rote memorization of action sequences and environment layouts from the training set, rather than genuine task understanding or environmental perception. For instance, models persist in executing grasping actions when the target object is replaced with irrelevant items, and their outputs remain unchanged even when given corrupted instructions or even messy tokens. These findings expose the severe flaws in current evaluation practices, and we call on the community to abandon misleading methodologies in favor of robust assessments of model generalization and comprehension. Our code is available at: https://github.com/Zxy-MLlab/LIBERO-PRO."},{"descriptionType":"Other","description":"10 pages,7 figures, 0 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03827","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:59:24Z","registered":"2025-10-07T02:59:24Z","published":null,"updated":"2026-05-26T04:04:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03895","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03895","identifiers":[{"identifier":"2510.03895","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zheng","familyName":"Huang","name":"Huang, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyu","familyName":"Liu","name":"Liu, Mingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Lin","name":"Lin, Xiaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muzhi","familyName":"Zhu","name":"Zhu, Muzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Canyu","familyName":"Zhao","name":"Zhao, Canyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongze","familyName":"Du","name":"Du, Zongze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Lin","name":"Lin, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoman","familyName":"Li","name":"Li, Xiaoman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiduo","familyName":"Jia","name":"Jia, Yiduo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhong","name":"Zhong, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunhua","familyName":"Shen","name":"Shen, Chunhua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NoTVLA: Semantics-Preserving Robot Adaptation via Narrative Action Interfaces"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T18:26:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:40:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T17:14:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T02:30:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models represent a pivotal advance in embodied intelligence, yet they confront critical barriers to real-world deployment, most notably catastrophic forgetting. This issue stems from their overreliance on continuous action sequences or action chunks, which inadvertently create isolated data silos that disrupt knowledge retention across tasks. To tackle these challenges, we propose the Narrowing of Trajectory VLA (NoTVLA) framework: a novel approach that narrows its focus to sparse trajectories, thereby avoiding the catastrophic forgetting associated with dense trajectory fine-tuning. A key innovation of NoTVLA lies in its trajectory planning strategy: instead of centering on the target object's trajectory, it leverages temporal compression and spatial reasoning pruning specifically for the robot end effector's trajectory. Furthermore, training is conducted using these sparse trajectories rather than dense action trajectories, an optimization that delivers remarkable practical advantages with better performance in zero-shot. In multi-task evaluation scenarios, NoTVLA achieves superior performance and generalization compared to pi0 while operating under two critical constraints: it uses over an order of magnitude less computing power than pi0 and requires no wrist-mounted camera. This design ensures that NoTVLA's operational accuracy closely approximates that of single-task expert models. Crucially, it also preserves the model's inherent language capabilities, enabling zero-shot generalization in specific scenarios, supporting unified model deployment across multiple robot platforms, and fostering a degree of generalization even when perceiving tasks from novel perspectives."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03895","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:01:10Z","registered":"2025-10-07T03:01:11Z","published":null,"updated":"2026-05-12T05:03:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04573","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04573","identifiers":[{"identifier":"2510.04573","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoqiang","familyName":"Kang","name":"Kang, Haoqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhe","familyName":"Zhang","name":"Zhang, Yizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikki Lijing","familyName":"Kuang","name":"Kuang, Nikki Lijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicklas","familyName":"Majamaki","name":"Majamaki, Nicklas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Navdeep","familyName":"Jaitly","name":"Jaitly, Navdeep","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-An","familyName":"Ma","name":"Ma, Yi-An","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianhui","familyName":"Qin","name":"Qin, Lianhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LaDiR: Latent Diffusion Enhances LLMs for Text Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T08:15:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:19:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T17:58:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T01:03:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-13T07:01:12Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-14T01:35:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-11T22:01:37Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-15T01:09:14Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-03T09:27:20Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-04T01:38:48Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-23T01:00:26Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-04-24T00:15:30Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) demonstrate their reasoning ability through chain-of-thought (CoT) generation. However, LLM's autoregressive decoding may limit the ability to revisit and refine earlier tokens in a holistic manner, which can also lead to inefficient exploration for diverse solutions. In this paper, we propose LaDiR} (Latent Diffusion Reasoner), a novel reasoning framework that unifies the expressiveness of continuous latent representation with the iterative refinement capabilities of latent diffusion models for an existing LLM. We first construct a structured latent reasoning space using a Variational Autoencoder (VAE) that encodes text reasoning steps into blocks of thought tokens, preserving semantic information and interpretability while offering compact but expressive representations. Subsequently, we utilize a latent diffusion model that learns to denoise a block of latent thought tokens with a blockwise bidirectional attention mask, enabling longer horizon and iterative refinement with adaptive test-time compute. This design, combined with explicit diversity guidance during diffusion inference, enables the generation of multiple diverse reasoning trajectories that explore distinct regions of the latent space, rather than producing repetitive solutions as often occurs in standard autoregressive sampling. We conduct evaluations on a suite of mathematical reasoning, code generation and puzzle planning benchmarks. Empirical results show that LaDiR consistently improves accuracy, diversity, and interpretability over existing autoregressive, diffusion-based, and latent reasoning methods, revealing a new paradigm for text reasoning with latent diffusion."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04573","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:17:49Z","registered":"2025-10-07T03:17:49Z","published":null,"updated":"2026-04-24T02:13:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04225","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04225","identifiers":[{"identifier":"2510.04225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yikun","familyName":"Ji","name":"Ji, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Hong","name":"Hong, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Deng","name":"Deng, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Lan","name":"Lan, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huijia","familyName":"Zhu","name":"Zhu, Huijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiqiang","familyName":"Wang","name":"Wang, Weiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liqing","familyName":"Zhang","name":"Zhang, Liqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianfu","familyName":"Zhang","name":"Zhang, Jianfu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Locate-Then-Examine: Grounded Region Reasoning Improves Detection of AI-Generated Images"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10; I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-10-05T14:29:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:58:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-21T18:16:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-23T00:04:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid growth of AI-generated imagery has blurred the boundary between real and synthetic content, raising practical concerns for digital integrity. Vision-language models (VLMs) can provide natural language explanations, but standard one-pass classifiers often miss subtle artifacts in high-quality synthetic images and offer limited grounding in the pixels. We propose Locate-Then-Examine (LTE), a two-stage VLM-based forensic framework that first localizes suspicious regions and then re-examines these crops together with the full image to refine the real vs. AI-generated verdict and its explanation. LTE explicitly links each decision to localized visual evidence through region proposals and region-aware reasoning. To support training and evaluation, we introduce TRACE, a dataset of 20,000 real and high-quality synthetic images with region-level annotations and automatically generated forensic explanations, constructed by a VLM-based pipeline with additional consistency checks and quality control. Across TRACE and multiple external benchmarks, LTE achieves competitive accuracy and improved robustness while providing human-understandable, region-grounded explanations suitable for forensic deployment."},{"descriptionType":"Other","description":"18 pages, 11 figures (including supplementary material)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04225","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:09:18Z","registered":"2025-10-07T03:09:19Z","published":null,"updated":"2026-04-23T02:22:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03721","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03721","identifiers":[{"identifier":"2510.03721","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leander","familyName":"Girrbach","name":"Girrbach, Leander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephan","familyName":"Alaniz","name":"Alaniz, Stephan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Genevieve","familyName":"Smith","name":"Smith, Genevieve","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Trevor","familyName":"Darrell","name":"Darrell, Trevor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeynep","familyName":"Akata","name":"Akata, Zeynep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Person-Centric Annotations of LAION-400M: Auditing Bias and Its Transfer to Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T07:51:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:27:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-29T11:37:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T00:58:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language models trained on large-scale multimodal datasets show strong demographic biases, but the role of training data in producing these biases remains unclear. A major barrier has been the lack of demographic annotations in web-scale datasets such as LAION-400M. We address this gap by creating person-centric annotations for the full dataset, including over 276 million bounding boxes, perceived gender and race/ethnicity labels, and automatically generated captions. These annotations are produced through validated automatic labeling pipelines combining object detection, multimodal captioning, and finetuned classifiers. Using them, we uncover demographic imbalances and harmful associations, such as the disproportionate linking of men and individuals perceived as Black or Middle Eastern with crime-related and negative content. We also show that a linear fit predicts 60-70% of gender bias in CLIP and Stable Diffusion from direct co-occurrences in the data. Our resources establish the first large-scale empirical link between dataset composition and downstream model bias. Code is available at https://github.com/ExplainableML/LAION-400M-Person-Centric-Annotations."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03721","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:56:48Z","registered":"2025-10-07T02:56:49Z","published":null,"updated":"2026-03-31T04:02:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04428","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04428","identifiers":[{"identifier":"2510.04428","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuanhao","familyName":"Zou","name":"Zou, Yuanhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengji","familyName":"Jin","name":"Jin, Shengji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andong","familyName":"Deng","name":"Deng, Andong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youpeng","familyName":"Zhao","name":"Zhao, Youpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Wang","name":"Wang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Chen","name":"Chen, Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A.I.R.: Enabling Adaptive, Iterative, and Reasoning-based Frame Selection For Video Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T01:51:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:10:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-26T01:08:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-27T01:13:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-27T02:48:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-30T00:20:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Effectively applying Vision-Language Models (VLMs) to Video Question Answering (VideoQA) hinges on selecting a concise yet comprehensive set of frames, as processing entire videos is computationally infeasible. However, current frame selection methods face a critical trade-off: approaches relying on lightweight similarity models, such as CLIP, often fail to capture the nuances of complex queries, resulting in inaccurate similarity scores that cannot reflect the authentic query-frame relevance, which further undermines frame selection. Meanwhile, methods that leverage a VLM for deeper analysis achieve higher accuracy but incur prohibitive computational costs. To address these limitations, we propose A.I.R., a training-free approach for Adaptive, Iterative, and Reasoning-based frame selection. We leverage a powerful VLM to perform deep, semantic analysis on complex queries, and this analysis is deployed within a cost-effective iterative loop that processes only a small batch of the most high-potential frames at a time. Extensive experiments on various VideoQA benchmarks demonstrate that our approach outperforms existing frame selection methods, significantly boosts the performance of the foundation VLM, and achieves substantial gains in computational efficiency over other VLM-based techniques."},{"descriptionType":"Other","description":"ICLR 2026 Paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04428","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:14:15Z","registered":"2025-10-07T03:14:16Z","published":null,"updated":"2026-03-30T02:11:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04058","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04058","identifiers":[{"identifier":"2510.04058","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subhodip","familyName":"Panda","name":"Panda, Subhodip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun M","familyName":"S","name":"S, Varun M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shreyans","familyName":"Jain","name":"Jain, Shreyans","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarthak Kumar","familyName":"Maharana","name":"Maharana, Sarthak Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prathosh A.","familyName":"P","name":"P, Prathosh A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unlearning in Diffusion models under Data Constraints: A Variational Inference Approach"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T06:39:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:49:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-10T13:26:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-11T02:35:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-11T16:41:13Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-12T01:58:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-23T04:07:49Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-24T01:28:15Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For a responsible and safe deployment of diffusion models in various domains, regulating the generated outputs from these models is desirable because such models could generate undesired, violent, and obscene outputs. To tackle this problem, recent works use machine unlearning methodology to forget training data points containing these undesired features from pre-trained generative models. However, these methods proved to be ineffective in data-constrained settings where the whole training dataset is inaccessible. Thus, the principal objective of this work is to propose a machine unlearning methodology that can prevent the generation of outputs containing undesired features from a pre-trained diffusion model in such a data-constrained setting. Our proposed method, termed as Variational Diffusion Unlearning (VDU), is a computationally efficient method that only requires access to a subset of training data containing undesired features. Our approach is inspired by the variational inference framework with the objective of minimizing a loss function consisting of two terms: plasticity inducer and stability regularizer. Plasticity inducer reduces the log-likelihood of the undesired training data points, while the stability regularizer, essential for preventing loss of image generation quality, regularizes the model in parameter space. We validate the effectiveness of our method through comprehensive experiments for both class unlearning and feature unlearning. For class unlearning, we unlearn some user-identified classes from MNIST, CIFAR-10, and tinyImageNet datasets from a pre-trained unconditional denoising diffusion probabilistic model (DDPM). Similarly, for feature unlearning, we unlearn the generation of certain high-level features from a pre-trained Stable Diffusion model trained on LAION-5B dataset."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04058","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:05:09Z","registered":"2025-10-07T03:05:10Z","published":null,"updated":"2026-03-24T04:16:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03813","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03813","identifiers":[{"identifier":"2510.03813","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Byungjun","familyName":"Kim","name":"Kim, Byungjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soobin","familyName":"Um","name":"Um, Soobin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jong Chul","familyName":"Ye","name":"Ye, Jong Chul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diverse Text-to-Image Generation via Contrastive Noise Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T13:51:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:35:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T04:37:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:21:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-16T13:07:55Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-17T02:16:14Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-to-image (T2I) diffusion models have demonstrated impressive performance in generating high-fidelity images, largely enabled by text-guided inference. However, this advantage often comes with a critical drawback: limited diversity, as outputs tend to collapse into similar modes under strong text guidance. Existing approaches typically optimize intermediate latents or text conditions during inference, but these methods deliver only modest gains or remain sensitive to hyperparameter tuning. In this work, we introduce Contrastive Noise Optimization, a simple yet effective method that addresses the diversity issue from a distinct perspective. Unlike prior techniques that adapt intermediate latents, our approach shapes the initial noise to promote diverse outputs. Specifically, we develop a contrastive loss defined in the Tweedie data space and optimize a batch of noise latents. Our contrastive optimization repels instances within the batch to maximize diversity while keeping them anchored to a reference sample to preserve fidelity. We further provide theoretical insights into the mechanism of this preprocessing to substantiate its effectiveness. Extensive experiments across multiple T2I backbones demonstrate that our approach achieves a superior quality-diversity Pareto frontier while remaining robust to hyperparameter choices."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03813","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:59:03Z","registered":"2025-10-07T02:59:04Z","published":null,"updated":"2026-03-17T04:56:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03608","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03608","identifiers":[{"identifier":"2510.03608","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruitao","familyName":"Wu","name":"Wu, Ruitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhao","name":"Zhao, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyao","familyName":"Chen","name":"Chen, Guangyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diffusion-Classifier Synergy: Reward-Aligned Learning via Mutual Boosting Loop for FSCIL"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T01:48:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:17:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-15T03:30:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T00:22:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-16T04:18:15Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-17T01:49:34Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Few-Shot Class-Incremental Learning (FSCIL) challenges models to sequentially learn new classes from minimal examples without forgetting prior knowledge, a task complicated by the stability-plasticity dilemma and data scarcity. Current FSCIL methods often struggle with generalization due to their reliance on limited datasets. While diffusion models offer a path for data augmentation, their direct application can lead to semantic misalignment or ineffective guidance. This paper introduces Diffusion-Classifier Synergy (DCS), a novel framework that establishes a mutual boosting loop between diffusion model and FSCIL classifier. DCS utilizes a reward-aligned learning strategy, where a dynamic, multi-faceted reward function derived from the classifier's state directs the diffusion model. This reward system operates at two levels: the feature level ensures semantic coherence and diversity using prototype-anchored maximum mean discrepancy and dimension-wise variance matching, while the logits level promotes exploratory image generation and enhances inter-class discriminability through confidence recalibration and cross-session confusion-aware mechanisms. This co-evolutionary process, where generated images refine the classifier and an improved classifier state yields better reward signals, demonstrably achieves state-of-the-art performance on FSCIL benchmarks, significantly enhancing both knowledge retention and new class learning."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03608","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:54:03Z","registered":"2025-10-07T02:54:03Z","published":null,"updated":"2026-03-17T04:56:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03666","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03666","identifiers":[{"identifier":"2510.03666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiang","familyName":"Wu","name":"Wu, Jiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sichao","familyName":"Wu","name":"Wu, Sichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinsong","familyName":"Ma","name":"Ma, Yinsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyuan","familyName":"Yu","name":"Yu, Guangyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyuan","familyName":"Xu","name":"Xu, Haoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifang","familyName":"Zheng","name":"Zheng, Lifang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingliang","familyName":"Duan","name":"Duan, Jingliang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MonitorVLM:A Vision Language Framework for Safety Violation Detection in Mining Operations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T04:46:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:23:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-11T12:33:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-12T00:46:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Industrial accidents, particularly in high-risk domains such as surface and underground mining, are frequently caused by unsafe worker behaviors. Traditional manual inspection remains labor-intensive, error-prone, and insufficient for large-scale, dynamic environments, highlighting the urgent need for intelligent and automated safety monitoring. In this paper, we present MonitorVLM, a novel vision--language framework designed to detect safety violations directly from surveillance video streams. MonitorVLM introduces three key innovations: (1) a domain-specific violation dataset comprising 9,000 vision--question--answer (VQA) samples across 40 high-frequency mining regulations, enriched with augmentation and auxiliary detection cues; (2) a clause filter (CF) module that dynamically selects the Top-$K$ most relevant clauses, reducing inference latency by 13.56\\% while maintaining accuracy; and (3) a behavior magnifier (BM) module that enhances worker regions to improve fine-grained action recognition, yielding additional gains of 3.45% in precision and 8.62% in recall. Experimental results demonstrate that MonitorVLM significantly outperforms baseline vision--language models, achieving improvements of 22.01% in precision, 34.22\\% in recall, and 28.37% in F1 score over the 72B unfine-tuned baseline. A lightweight web-based interface further integrates MonitorVLM into practical workflows, enabling automatic violation reporting with video timestamping. This study highlights the potential of multimodal large models to enhance occupational safety monitoring in mining and beyond."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03666","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:55:27Z","registered":"2025-10-07T02:55:28Z","published":null,"updated":"2026-03-12T02:25:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04436","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04436","identifiers":[{"identifier":"2510.04436","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jushan","familyName":"Chen","name":"Chen, Jushan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Santiago","familyName":"Paternain","name":"Paternain, Santiago","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PAD-TRO: Projection-Augmented Diffusion for Direct Trajectory Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T02:06:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:11:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-21T22:51:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-23T01:09:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-06T21:15:31Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-10T00:12:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recently, diffusion models have gained popularity and attention in trajectory optimization due to their capability of modeling multi-modal probability distributions. However, addressing nonlinear equality constraints, i.e, dynamic feasibility, remains a great challenge in diffusion-based trajectory optimization. Recent diffusion-based trajectory optimization frameworks rely on a single-shooting style approach where the denoised control sequence is applied to forward propagate the dynamical system, which cannot explicitly enforce constraints on the states and frequently leads to sub-optimal solutions. In this work, we propose a novel direct trajectory optimization approach via model-based diffusion, which directly generates a sequence of states. To ensure dynamic feasibility, we propose a gradient-free projection mechanism that is incorporated into the reverse diffusion process. Our results show that, compared to a recent state-of-the-art baseline, our approach leads to zero dynamic feasibility error and approximately 4x higher success rate in a quadrotor waypoint navigation scenario involving dense static obstacles."},{"descriptionType":"Other","description":"Final manuscript. Accepted for publication at the 2026 American Control Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04436","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:14:28Z","registered":"2025-10-07T03:14:29Z","published":null,"updated":"2026-03-10T04:50:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03929","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03929","identifiers":[{"identifier":"2510.03929","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrew","familyName":"Campbell","name":"Campbell, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"De Bortoli","name":"De Bortoli, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxin","familyName":"Shi","name":"Shi, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnaud","familyName":"Doucet","name":"Doucet, Arnaud","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self-Speculative Masked Diffusions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T20:16:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:42:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T10:45:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:38:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present self-speculative masked diffusions, a new class of masked diffusion generative models for discrete data that require significantly fewer function evaluations to generate samples. Standard masked diffusion models predict factorized logits over currently masked positions. A number of masked positions are then sampled, however, the factorization approximation means that sampling too many positions in one go leads to poor sample quality. As a result, many simulation steps and therefore neural network function evaluations are required to generate high-quality data. We reduce the computational burden by generating non-factorized predictions over masked positions. This is achieved by modifying the final transformer attention mask from non-causal to causal, enabling draft token generation and parallel validation via a novel, model-integrated speculative sampling mechanism. This results in a non-factorized predictive distribution over masked positions in a single forward pass. We apply our method to GPT2 scale text modelling and protein sequence generation, finding that we can achieve a ~2x reduction in the required number of network forward passes relative to standard masked diffusion models."},{"descriptionType":"Other","description":"32 pages, 7 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03929","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:02:00Z","registered":"2025-10-07T03:02:01Z","published":null,"updated":"2026-03-09T02:09:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04504","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04504","identifiers":[{"identifier":"2510.04504","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijing","familyName":"Hu","name":"Hu, Zijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunze","familyName":"Tong","name":"Tong, Yunze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fengda","familyName":"Zhang","name":"Zhang, Fengda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junkun","familyName":"Yuan","name":"Yuan, Junkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Xiao","name":"Xiao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Kuang","name":"Kuang, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asynchronous Denoising Diffusion Models for Aligning Text-to-Image Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T05:45:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:15:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-26T10:10:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-27T01:37:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have achieved impressive results in generating high-quality images. Yet, they often struggle to faithfully align the generated images with the input prompts. This limitation is associated with synchronous denoising, where all pixels simultaneously evolve from random noise to clear images. As a result, during generation, the prompt-related regions can only reference the unrelated regions at the same noise level, failing to obtain clear context and ultimately impairing text-to-image alignment. To address this issue, we propose asynchronous diffusion models -- a novel framework that allocates distinct timesteps to different pixels and reformulates the pixel-wise denoising process. By dynamically modulating the timestep schedules of individual pixels, prompt-related regions are denoised more gradually than unrelated regions, thereby allowing them to leverage clearer inter-pixel context. Consequently, these prompt-related regions achieve better alignment in the final images. Extensive experiments demonstrate that our asynchronous diffusion models can significantly improve text-to-image alignment across diverse prompts. The code repository for this work is available at https://github.com/hu-zijing/AsynDM."},{"descriptionType":"Other","description":"Accepted to ICLR 2026, 25 pages, 13 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04504","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:16:08Z","registered":"2025-10-07T03:16:09Z","published":null,"updated":"2026-02-27T03:15:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03574","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03574","identifiers":[{"identifier":"2510.03574","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mehmet Onurcan","familyName":"Kaya","name":"Kaya, Mehmet Onurcan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Desmond","familyName":"Elliott","name":"Elliott, Desmond","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dim P.","familyName":"Papadopoulos","name":"Papadopoulos, Dim P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Test-Time Scaling for Small Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T23:49:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:14:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-16T15:56:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-17T02:42:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Small Vision-Language Models (VLMs) provide a computationally efficient alternative to larger models, at the cost of weaker generalization abilities and downstream task performance. These shortcomings could be addressed by test-time scaling techniques, but existing methods are typically computationally demanding, contradicting the resource-efficient design goals of small models. To address these limitations, we propose two novel and efficient test-time scaling strategies that leverage the model-internal features rather than external supervision: (i) Test-Time Augmentation (TTAug), which generates multiple augmented inputs and aggregates outputs at the token level without parameter updates, and (ii) Test-Time Adaptation (TTAdapt), which adapts model parameters during inference using consensus-based pseudolabels from TTAug. Through extensive experiments across nine benchmarks, we demonstrate consistent performance improvements while maintaining computational efficiency suitable for resource-constrained environments. The generality of our approach is demonstrated both within models at different scales and across different VLMs without additional tuning."},{"descriptionType":"Other","description":"Accepted at ICLR 2026. Project Page: https://monurcan.github.io/efficient_test_time_scaling"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03574","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:53:13Z","registered":"2025-10-07T02:53:14Z","published":null,"updated":"2026-02-17T04:46:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04331","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04331","identifiers":[{"identifier":"2510.04331","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nghiem T.","familyName":"Diep","name":"Diep, Nghiem T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hien","familyName":"Dang","name":"Dang, Hien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tuan","familyName":"Truong","name":"Truong, Tuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tan","familyName":"Dinh","name":"Dinh, Tan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huy","familyName":"Nguyen","name":"Nguyen, Huy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nhat","familyName":"Ho","name":"Ho, Nhat","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T19:27:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:05:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-06T17:31:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-09T01:55:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Parameter-efficient fine-tuning (PEFT) methods have become the standard paradigm for adapting large-scale models. Among these techniques, Weight-Decomposed Low-Rank Adaptation (DoRA) has been shown to improve both the learning capacity and training stability of the Low-Rank Adaptation (LoRA) method by explicitly decomposing pre-trained weights into magnitude and directional components. In this work, we propose DoRAN, a new technique designed to stabilize training and boost the sample efficiency of DoRA. Our framework introduces two key components: (i) the injection of learnable noise into the denominator of DoRA weight decomposition, which serves as an adaptive regularizer to mitigate instabilities and improve the estimation rate of low-rank matrices; and (ii) the replacement of static low-rank matrices with auxiliary networks that generate them dynamically, enabling parameter coupling between the query and value projection matrices, leading to improved sample efficiency both theoretically and empirically. Comprehensive experiments on vision and language benchmarks show that DoRAN consistently outperforms LoRA, DoRA, and other PEFT baselines, underscoring the effectiveness of combining noise-based regularization with network-based parameter generation."},{"descriptionType":"Other","description":"Nghiem T. Diep, Hien Dang, and Tuan Truong contributed equally to this work"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04331","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:11:53Z","registered":"2025-10-07T03:11:54Z","published":null,"updated":"2026-02-09T03:01:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04217","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04217","identifiers":[{"identifier":"2510.04217","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenlu","familyName":"Ding","name":"Ding, Chenlu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiancan","familyName":"Wu","name":"Wu, Jiancan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leheng","familyName":"Sheng","name":"Sheng, Leheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Zhang","name":"Zhang, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yancheng","familyName":"Yuan","name":"Yuan, Yancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Wang","name":"Wang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangnan","familyName":"He","name":"He, Xiangnan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MLLMEraser: Achieving Test-Time Unlearning in Multimodal Large Language Models through Activation Steering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T14:20:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:58:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T11:47:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:44:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-02T12:41:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-03T02:58:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) have demonstrated remarkable capabilities across vision-language tasks, yet their large-scale deployment raises pressing concerns about memorized private data, outdated knowledge, and harmful content. Existing unlearning approaches for MLLMs typically adapt training-based strategies such as gradient ascent or preference optimization, but these methods are computationally expensive, irreversible, and often distort retained knowledge. In this work, we propose MLLMEraser, an input-aware, training-free framework for test-time unlearning. Our approach leverages activation steering to enable dynamic knowledge erasure without parameter updates. Specifically, we construct a multimodal erasure direction by contrasting adversarially perturbed, knowledge-recall image-text pairs with knowledge-erasure counterparts, capturing both textual and visual discrepancies. To prevent unnecessary interference, we further design an input-aware steering mechanism that adaptively determines when and how the erasure direction should be applied, preserving utility on retained knowledge while enforcing forgetting on designated content. Experiments on LLaVA-1.5 and Qwen-2.5-VL demonstrate that MLLMEraser consistently outperforms state-of-the-art MLLM unlearning baselines, achieving stronger forgetting performance with lower computational cost and minimal utility degradation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04217","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:09:06Z","registered":"2025-10-07T03:09:07Z","published":null,"updated":"2026-02-03T05:40:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03906","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03906","identifiers":[{"identifier":"2510.03906","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ardalan","familyName":"Aryashad","name":"Aryashad, Ardalan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Parsa","familyName":"Razmara","name":"Razmara, Parsa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amin","familyName":"Mahjoub","name":"Mahjoub, Amin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seyedarmin","familyName":"Azizi","name":"Azizi, Seyedarmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahdi","familyName":"Salmani","name":"Salmani, Mahdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arad","familyName":"Firouzkouhi","name":"Firouzkouhi, Arad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Filters to VLMs: Benchmarking Defogging Methods through Object Detection and Segmentation Performance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-04T19:05:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:40:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-26T12:26:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T02:25:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous driving perception systems are particularly vulnerable in foggy conditions, where light scattering reduces contrast and obscures fine details critical for safe operation. While numerous defogging methods exist, from handcrafted filters to learned restoration models, improvements in image fidelity do not consistently translate into better downstream detection and segmentation. Moreover, prior evaluations often rely on synthetic data, raising concerns about real-world transferability.\n We present a structured empirical study that benchmarks a comprehensive set of defogging pipelines, including classical dehazing filters, modern defogging networks, chained variants combining filters and models, and prompt-driven visual language image editing models applied directly to foggy images. To bridge the gap between simulated and physical environments, we evaluate these pipelines on both the synthetic Foggy Cityscapes dataset and the real-world Adverse Conditions Dataset with Correspondences (ACDC).\n We examine generalization by evaluating performance on synthetic fog and real-world conditions, assessing both image quality and downstream perception in terms of object detection mean average precision and segmentation panoptic quality. Our analysis identifies when defogging is effective, the impact of combining models, and how visual language models compare to traditional approaches. We additionally report qualitative rubric-based evaluations from both human and visual language model judges and analyze their alignment with downstream task metrics.\n Together, these results establish a transparent, task-oriented benchmark for defogging methods and identify the conditions under which pre-processing meaningfully improves autonomous perception in adverse weather.\n Project page: https://aradfir.github.io/filters-to-vlms-defogging-page/"},{"descriptionType":"Other","description":"Accepted at WACV 2026 Proceedings (Oral), 5th Workshop on Image, Video, and Audio Quality Assessment in Computer Vision, with a focus on VLM and Diffusion Models"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03906","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:01:26Z","registered":"2025-10-07T03:01:27Z","published":null,"updated":"2026-01-27T04:35:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03289","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03289","identifiers":[{"identifier":"2510.03289","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haocheng","familyName":"Sun","name":"Sun, Haocheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cynthia Xin","familyName":"Wen","name":"Wen, Cynthia Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward Hong","familyName":"Wang","name":"Wang, Edward Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Why mask diffusion does not work"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T12:07:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:01:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-23T09:36:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-24T01:30:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The main advantages of diffusion language models over autoregressive (AR) models lie in their ability to support parallel generation and bidirectional attention, enabling a more controllable generation process. In recent years, open-source mask diffusion language models have emerged, most of which are based on a variant known as absorbing diffusion. However, this paper demonstrates why mask diffusion faces inherent difficulties in achieving parallel generation and bidirectional attention. We also propose the most effective training and inference strategies for mask diffusion."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03289","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:46:17Z","registered":"2025-10-07T02:46:18Z","published":null,"updated":"2025-12-24T02:56:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04564","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04564","identifiers":[{"identifier":"2510.04564","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Honglin","familyName":"Liu","name":"Liu, Honglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Sun","name":"Sun, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Hu","name":"Hu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunfan","familyName":"Li","name":"Li, Yunfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Peng","name":"Peng, Xi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conditional Representation Learning for Customized Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T08:00:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:19:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-13T08:39:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-16T01:26:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Conventional representation learning methods learn a universal representation that primarily captures dominant semantics, which may not always align with customized downstream tasks. For instance, in animal habitat analysis, researchers prioritize scene-related features, whereas universal embeddings emphasize categorical semantics, leading to suboptimal results. As a solution, existing approaches resort to supervised fine-tuning, which however incurs high computational and annotation costs. In this paper, we propose Conditional Representation Learning (CRL), aiming to extract representations tailored to arbitrary user-specified criteria. Specifically, we reveal that the semantics of a space are determined by its basis, thereby enabling a set of descriptive words to approximate the basis for a customized feature space. Building upon this insight, given a user-specified criterion, CRL first employs a large language model (LLM) to generate descriptive texts to construct the semantic basis, then projects the image representation into this conditional feature space leveraging a vision-language model (VLM). The conditional representation better captures semantics for the specific criterion, which could be utilized for multiple customized tasks. Extensive experiments on classification and retrieval tasks demonstrate the superiority and generality of the proposed CRL. The code is available at https://github.com/XLearning-SCU/2025-NeurIPS-CRL."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04564","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:17:35Z","registered":"2025-10-07T03:17:36Z","published":null,"updated":"2025-12-16T04:50:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04146","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04146","identifiers":[{"identifier":"2510.04146","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minseo","familyName":"Kim","name":"Kim, Minseo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Coleman","familyName":"Hooper","name":"Hooper, Coleman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Tomar","name":"Tomar, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenfeng","familyName":"Xu","name":"Xu, Chenfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehrdad","familyName":"Farajtabar","name":"Farajtabar, Mehrdad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael W.","familyName":"Mahoney","name":"Mahoney, Michael W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kurt","familyName":"Keutzer","name":"Keutzer, Kurt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Gholami","name":"Gholami, Amir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Next-Token Prediction: A Performance Characterization of Diffusion versus Autoregressive Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T10:50:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:54:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-15T16:36:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-16T02:44:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have achieved state-of-the-art performance on a broad range of Natural Language Processing (NLP) tasks, including document processing and code generation. Autoregressive Language Models (ARMs), which generate tokens sequentially conditioned on all previous tokens, have been the predominant paradigm for LLMs. While these models have achieved high accuracy across a range of downstream tasks, they exhibit low arithmetic intensity due to the inherent sequential dependency in next-token prediction. Recently, Diffusion Language Models (DLMs) have emerged as a promising alternative architecture. DLMs generate output tokens in parallel, mitigating the limitations of sequential decoding. However, the performance implications of DLMs relative to commonly deployed ARMs are not fully understood. In this work, we present a comprehensive study of the performance characteristics of ARMs and DLMs, combining theoretical analysis with empirical profiling to characterize the trade-offs between these approaches. We show that although DLMs can achieve higher arithmetic intensity than ARMs by leveraging parallelism across token positions, they fail to scale effectively with longer contexts. We then explore block-wise decoding for DLMs, which decouples arithmetic intensity from sequence length and enables better scaling to long contexts (similar to ARMs). We also examine batched inference and find that ARMs exhibit superior throughput as they benefit more from parallelism across sequences in the batch. Finally, we highlight opportunities for accelerating DLM inference, emphasizing that reducing the number of sampling steps is key for open-source DLMs to achieve lower latency relative to ARMs."},{"descriptionType":"Other","description":"11 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04146","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:07:21Z","registered":"2025-10-07T03:07:22Z","published":null,"updated":"2025-12-16T04:50:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04522","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04522","identifiers":[{"identifier":"2510.04522","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yisen","familyName":"Gao","name":"Gao, Yisen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingcheng","familyName":"Fu","name":"Fu, Xingcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Sun","name":"Sun, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxin","familyName":"Li","name":"Li, Jianxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianxian","familyName":"Li","name":"Li, Xianxian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward a Unified Geometry Understanding: Riemannian Diffusion Framework for Graph Generation and Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T06:29:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:16:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-11T07:48:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-12T01:30:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph diffusion models have made significant progress in learning structured graph data and have demonstrated strong potential for predictive tasks. Existing approaches typically embed node, edge, and graph-level features into a unified latent space, modeling prediction tasks including classification and regression as a form of conditional generation. However, due to the non-Euclidean nature of graph data, features of different curvatures are entangled in the same latent space without releasing their geometric potential. To address this issue, we aim to construt an ideal Riemannian diffusion model to capture distinct manifold signatures of complex graph data and learn their distribution. This goal faces two challenges: numerical instability caused by exponential mapping during the encoding proces and manifold deviation during diffusion generation. To address these challenges, we propose GeoMancer: a novel Riemannian graph diffusion framework for both generation and prediction tasks. To mitigate numerical instability, we replace exponential mapping with an isometric-invariant Riemannian gyrokernel approach and decouple multi-level features onto their respective task-specific manifolds to learn optimal representations. To address manifold deviation, we introduce a manifold-constrained diffusion method and a self-guided strategy for unconditional generation, ensuring that the generated data remains aligned with the manifold signature. Extensive experiments validate the effectiveness of our approach, demonstrating superior performance across a variety of tasks."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04522","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:16:34Z","registered":"2025-10-07T03:16:34Z","published":null,"updated":"2025-12-12T03:11:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03506","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03506","identifiers":[{"identifier":"2510.03506","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"John","familyName":"Nguyen","name":"Nguyen, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marton","familyName":"Havasi","name":"Havasi, Marton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tariq","familyName":"Berrada","name":"Berrada, Tariq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luke","familyName":"Zettlemoyer","name":"Zettlemoyer, Luke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ricky T. Q.","familyName":"Chen","name":"Chen, Ricky T. Q.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OneFlow: Concurrent Mixed-Modal and Interleaved Generation with Edit Flows"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-03T20:40:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:10:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T04:05:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:27:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-10T16:49:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-11T01:51:35Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present OneFlow, the first non-autoregressive multimodal model that enables variable-length and concurrent mixed-modal generation. Unlike autoregressive models that enforce rigid causal ordering between text and image generation, OneFlow combines an insertion-based Edit Flow for discrete text tokens with Flow Matching for image latents. OneFlow enables concurrent text-image synthesis with hierarchical sampling that prioritizes content over grammar. Through controlled experiments across model sizes from 1B to 8B, we demonstrate that OneFlow outperforms autoregressive baselines on both generation and understanding tasks while using up to 50% fewer training FLOPs. OneFlow surpasses both autoregressive and diffusion-based approaches while unlocking new capabilities for concurrent generation, iterative refinement, and natural reasoning-like generation."},{"descriptionType":"Other","description":"https://oneflow.framer.ai"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.03506","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:51:34Z","registered":"2025-10-07T02:51:35Z","published":null,"updated":"2025-12-11T03:05:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.04002","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04002","identifiers":[{"identifier":"2510.04002","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Yang","name":"Yang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunkui","familyName":"Chen","name":"Chen, Yunkui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanfei","familyName":"Feng","name":"Feng, Lanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Zhang","name":"Zhang, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Xu","name":"Xu, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyu","familyName":"Zhang","name":"Zhang, Jianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nueraili","familyName":"Aierken","name":"Aierken, Nueraili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runhe","familyName":"Huang","name":"Huang, Runhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongjian","familyName":"Lin","name":"Lin, Hongjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yibin","familyName":"Ying","name":"Ying, Yibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijian","familyName":"Li","name":"Li, Shijian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgriGPT-VL: Agricultural Vision-Language Understanding Suite"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-05T02:30:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:46:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T13:17:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:47:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-07T17:46:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-09T01:57:55Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite rapid advances in multimodal large language models, agricultural applications remain constrained by the scarcity of domain-tailored models, curated vision-language corpora, and rigorous evaluation. To address these challenges, we present the AgriGPT-VL Suite, a unified multimodal framework for agriculture. Our contributions are threefold. First, we introduce Agri-3M-VL, the largest vision-language corpus for agriculture to our knowledge, curated by a scalable multi-agent data generator; it comprises 1M image-caption pairs, 2M image-grounded VQA pairs, 50K expert-level VQA instances, and 15K GRPO reinforcement learning samples. Second, we develop AgriGPT-VL, an agriculture-specialized vision-language model trained via a progressive curriculum of textual grounding, multimodal shallow/deep alignment, and GRPO refinement. This method achieves strong multimodal reasoning while preserving text-only capability. Third, we establish AgriBench-VL-4K, a compact yet challenging evaluation suite with open-ended and image-grounded questions, paired with multi-metric evaluation and an LLM-as-a-judge framework. Experiments show that AgriGPT-VL outperforms leading general-purpose VLMs on AgriBench-VL-4K, achieving higher pairwise win rates in the LLM-as-a-judge evaluation. Meanwhile, it remains competitive on the text-only AgriBench-13K with no noticeable degradation of language ability. Ablation studies further confirm consistent gains from our alignment and GRPO refinement stages. We will open source all of the resources to support reproducible research and deployment in low-resource agricultural settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.04002","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:03:47Z","registered":"2025-10-07T03:03:48Z","published":null,"updated":"2025-12-09T04:37:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.03342","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03342","identifiers":[{"identifier":"2510.03342","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","affiliation":[],"name":"Gemini Robotics Team","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abbas","familyName":"Abdolmaleki","name":"Abdolmaleki, Abbas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saminda","familyName":"Abeyruwan","name":"Abeyruwan, Saminda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua","familyName":"Ainslie","name":"Ainslie, Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-Baptiste","familyName":"Alayrac","name":"Alayrac, Jean-Baptiste","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Montserrat Gonzalez","familyName":"Arenas","name":"Arenas, Montserrat Gonzalez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashwin","familyName":"Balakrishna","name":"Balakrishna, Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Batchelor","name":"Batchelor, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Bewley","name":"Bewley, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff","familyName":"Bingham","name":"Bingham, Jeff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Bloesch","name":"Bloesch, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Konstantinos","famil