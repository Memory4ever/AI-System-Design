<tr id="S5.T1.2.5" class="ltx_tr">
<th id="S5.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="4"><span id="S5.T1.2.5.1.1" class="ltx_text ltx_font_bold">Time (seconds)</span></th></tr>
<tr id="S5.T1.2.6" class="ltx_tr">
<th id="S5.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Full</th>
<td id="S5.T1.2.6.2" class="ltx_td ltx_align_center">11.62</td>
<td id="S5.T1.2.6.3" class="ltx_td ltx_align_center">8.26</td>
<td id="S5.T1.2.6.4" class="ltx_td"></td></tr>
<tr id="S5.T1.2.7" class="ltx_tr">
<th id="S5.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Diff</th>
<td id="S5.T1.2.7.2" class="ltx_td ltx_align_center"><span id="S5.T1.2.7.2.1" class="ltx_text ltx_font_bold">6.70</span></td>
<td id="S5.T1.2.7.3" class="ltx_td ltx_align_center"><span id="S5.T1.2.7.3.1" class="ltx_text ltx_font_bold">5.66</span></td>
<td id="S5.T1.2.7.4" class="ltx_td"></td></tr>
