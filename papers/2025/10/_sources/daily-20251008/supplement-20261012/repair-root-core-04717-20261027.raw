<td id="S5.T1.2.8.2" class="ltx_td ltx_align_center"><span id="S5.T1.2.8.2.1" class="ltx_text ltx_font_bold">42.3%</span></td>
<td id="S5.T1.2.8.3" class="ltx_td ltx_align_center"><span id="S5.T1.2.8.3.1" class="ltx_text ltx_font_bold">31.5%</span></td>
<td id="S5.T1.2.8.4" class="ltx_td"></td></tr>
