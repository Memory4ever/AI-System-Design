<td id="S3.T1.3.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:0.9pt 3.0pt;"><span id="S3.T1.3.3.2.1" class="ltx_text" style="font-size:90%;">Nursing &amp; Support</span></td>
