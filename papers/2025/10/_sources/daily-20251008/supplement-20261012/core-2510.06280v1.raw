<td id="S4.T2.3.35.9" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding:0.85pt 3.0pt;"><span id="S4.T2.3.35.9.1" class="ltx_text" style="font-size:80%;">18.25</span></td>
