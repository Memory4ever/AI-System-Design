<div id="S4.T3.6.1.2.1" class="ltx_inline-block ltx_align_center ltx_align_top ltx_transformed_outer" style="width:6.9pt;height:41.6pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:41.6pt;transform:translate(-17.3pt,-17.3pt) rotate(-90deg) ;">
