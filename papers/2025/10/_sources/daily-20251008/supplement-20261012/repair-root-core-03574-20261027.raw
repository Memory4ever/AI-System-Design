<span id="S4.T5.4.11.2.1.1" class="ltx_p ltx_align_center">43.8</span>
</span></td>
<td id="S4.T5.4.11.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;">
