<tr id="S5.T1.3.4" class="ltx_tr">
<th id="S5.T1.3.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">Mass position of Y axis</th>
<td id="S5.T1.3.4.2" class="ltx_td ltx_align_center">[-0.1, 0.1]</td>
<td id="S5.T1.3.4.3" class="ltx_td ltx_align_center"><math id="S5.T1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math></td></tr>
<tr id="S5.T1.3.5" class="ltx_tr">
<th id="S5.T1.3.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">Mass position of Z axis</th>
