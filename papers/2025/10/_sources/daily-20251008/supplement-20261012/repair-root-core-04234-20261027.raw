<td id="S6.T3.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">46.6</td></tr>
<tr id="S6.T3.3.3" class="ltx_tr">
<th id="S6.T3.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="S6.T3.m1" class="ltx_Math" alttext="E_{v}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>v</mi></msub><annotation encoding="application/x-tex">E_{v}</annotation></semantics></math> (%)</th>
