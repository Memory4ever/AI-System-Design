<td id="S5.T1.3.9.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T1.m8" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math></td></tr>
