<td id="S6.T3.3.3.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">51.4</td></tr>
<tr id="S6.T3.3.4" class="ltx_tr">
<th id="S6.T3.3.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;" rowspan="2"><span id="S6.T3.3.4.1.1" class="ltx_text ltx_font_bold">0.7 m/s Forward</span></th>
<th id="S6.T3.3.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">Stability (%)</th>
<td id="S6.T3.3.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S6.T3.3.4.3.1" class="ltx_text ltx_font_bold">90.5</span></td>
<td id="S6.T3.3.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">23.1</td></tr>
<tr id="S6.T3.3.5" class="ltx_tr">
<th id="S6.T3.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="S6.T3.m2" class="ltx_Math" alttext="E_{v}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>v</mi></msub><annotation encoding="application/x-tex">E_{v}</annotation></semantics></math> (%)</th>
<td id="S6.T3.3.5.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S6.T3.3.5.2.1" class="ltx_text ltx_font_bold">28.5</span></td>
<td id="S6.T3.3.5.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">77.0</td></tr>
<tr id="S6.T3.3.6" class="ltx_tr">
<th id="S6.T3.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;" rowspan="2"><span id="S6.T3.3.6.1.1" class="ltx_text ltx_font_bold">1.0 m/s Forward</span></th>
<th id="S6.T3.3.6.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">Stability (%)</th>
<td id="S6.T3.3.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S6.T3.3.6.3.1" class="ltx_text ltx_font_bold">98.8</span></td>
<td id="S6.T3.3.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">18.4</td></tr>
