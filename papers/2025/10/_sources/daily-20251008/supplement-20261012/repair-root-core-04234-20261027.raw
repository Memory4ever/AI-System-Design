<th id="S6.T3.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S6.T3.3.1.4.1" class="ltx_text ltx_font_bold">w/o finetuning</span></th></tr>
