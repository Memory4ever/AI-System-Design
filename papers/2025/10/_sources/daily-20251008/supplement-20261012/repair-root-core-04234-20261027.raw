<td id="S5.T1.3.7.3" class="ltx_td ltx_align_center"><math id="S5.T1.m6" class="ltx_Math" alttext="rad" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">rad</annotation></semantics></math></td></tr>
<tr id="S5.T1.3.8" class="ltx_tr">
