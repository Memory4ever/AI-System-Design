            <math id="alg2.l15.m1" class="ltx_Math" alttext="\hat{\mu}_{i}\leftarrow\frac{1}{D}\sum_{h=1}^{H}\sum_{w=1}^{W}\sum_{c=1}^{C}\mathbf{z}_{T}[c,h,w]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mi>D</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><msubsup><mo>∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>C</mi></msubsup><mrow><msub><mi>𝐳</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mu}_{i}\leftarrow\frac{1}{D}\sum_{h=1}^{H}\sum_{w=1}^{W}\sum_{c=1}^{C}\mathbf{z}_{T}[c,h,w]</annotation></semantics></math>  for <math id="alg2.l15.m2" class="ltx_Math" alttext="i=1,\dots,B" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,B</annotation></semantics></math>

