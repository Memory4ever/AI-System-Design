<div id="alg2.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
            <math id="alg2.l16.m1" class="ltx_Math" alttext="\hat{\sigma}^{2}_{i}\leftarrow\frac{1}{D-1}\sum_{h=1}^{H}\sum_{w=1}^{W}\sum_{c=1}^{C}(\mathbf{z}_{T}[c,h,w]-\hat{\mu})^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>i</mi><mn>2</mn></msubsup><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><mrow><mi>D</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>w</mi><mo>=</mo><mn>1</mn></mrow><mi>W</mi></msubsup><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>C</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>𝐳</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>c</mi><mo>,</mo><mi>h</mi><mo>,</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\sigma}^{2}_{i}\leftarrow\frac{1}{D-1}\sum_{h=1}^{H}\sum_{w=1}^{W}\sum_{c=1}^{C}(\mathbf{z}_{T}[c,h,w]-\hat{\mu})^{2}</annotation></semantics></math>  for <math id="alg2.l16.m2" class="ltx_Math" alttext="i=1,\dots,B" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,B</annotation></semantics></math>

</div>
<div id="alg2.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
            <math id="alg2.l17.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{KL}}\coloneqq\frac{1}{B}\sum_{i=1}^{B}\left[\log\frac{1}{\hat{\sigma}_{i}}+\frac{\hat{\sigma}_{i}^{2}+\hat{\mu}_{i}^{2}}{2}-\frac{1}{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>KL</mtext></msub><mo>≔</mo><mrow><mfrac><mn>1</mn><mi>B</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mrow><mo>[</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>i</mi></msub></mfrac></mrow><mo>+</mo><mfrac><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>i</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>i</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{KL}}\coloneqq\frac{1}{B}\sum_{i=1}^{B}\left[\log\frac{1}{\hat{\sigma}_{i}}+\frac{\hat{\sigma}_{i}^{2}+\hat{\mu}_{i}^{2}}{2}-\frac{1}{2}\right]</annotation></semantics></math>

</div>
<div id="alg2.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
            <math id="alg2.l18.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{total}}\leftarrow\mathcal{L}^{\gamma}_{\text{CNO}}+\lambda\mathcal{L}_{\text{KL}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>total</mtext></msub><mo stretchy="false">←</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CNO</mtext><mi>γ</mi></msubsup><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>KL</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{total}}\leftarrow\mathcal{L}^{\gamma}_{\text{CNO}}+\lambda\mathcal{L}_{\text{KL}}</annotation></semantics></math>

</div>
<div id="alg2.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">19:</span>
            
            
            <math id="alg2.l19.m1" class="ltx_Math" alttext="\mathbf{Z}_{T}\leftarrow\mathbf{Z}_{T}-\eta\cdot\nabla_{\mathbf{Z}_{T}}\mathcal{L}_{\text{total}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐙</mi><mi>T</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>𝐙</mi><mi>T</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐙</mi><mi>T</mi></msub></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>total</mtext></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{T}\leftarrow\mathbf{Z}_{T}-\eta\cdot\nabla_{\mathbf{Z}_{T}}\mathcal{L}_{\text{total}}</annotation></semantics></math>

</div>
<div id="alg2.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">20:</span>
            
            
           <span id="alg2.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l20.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">21:</span>
            
            
           <math id="alg2.l21.m1" class="ltx_Math" alttext="\{\mathbf{z}_{0}^{b}\}_{b=1}^{B}\leftarrow\mathcal{D}_{\text{DDIM}}(\mathbf{Z}_{T},c)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>DDIM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>T</mi></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\mathbf{z}_{0}^{b}\}_{b=1}^{B}\leftarrow\mathcal{D}_{\text{DDIM}}(\mathbf{Z}_{T},c)</annotation></semantics></math>

</div>
<div id="alg2.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">22:</span>
            
            
           <math id="alg2.l22.m1" class="ltx_Math" alttext="\{\mathbf{x}_{0}^{b}\}_{b=1}^{B}\leftarrow\text{Decode}(\{\mathbf{z}_{0}^{b}\}_{b=1}^{B})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mo stretchy="false">←</mo><mrow><mtext>Decode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\mathbf{x}_{0}^{b}\}_{b=1}^{B}\leftarrow\text{Decode}(\{\mathbf{z}_{0}^{b}\}_{b=1}^{B})</annotation></semantics></math>

</div>
<div id="alg2.l23" class="ltx_listingline">
