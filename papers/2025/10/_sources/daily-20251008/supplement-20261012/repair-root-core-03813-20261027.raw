             <span id="alg1.l7.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l7.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
            
              <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathbf{z}_{0|T}^{i,\text{fixed}}\leftarrow\mathbf{z}_{0|T}^{i,\text{opt}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>fixed</mtext></mrow></msubsup><mo stretchy="false">←</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{z}_{0|T}^{i,\text{fixed}}\leftarrow\mathbf{z}_{0|T}^{i,\text{opt}}</annotation></semantics></math>


</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
             <span id="alg1.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
             <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{i,\text{fixed}}\leftarrow\text{DownSample}(\mathbf{z}_{0|T}^{i,\text{opt}};w),~~\text{DownSample}(\mathbf{z}_{0|T}^{i,\text{fixed}};w)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>fixed</mtext></mrow></msubsup><mo stretchy="false">←</mo><mrow><mtext>DownSample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mtext>DownSample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>fixed</mtext></mrow></msubsup><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{i,\text{fixed}}\leftarrow\text{DownSample}(\mathbf{z}_{0|T}^{i,\text{opt}};w),~~\text{DownSample}(\mathbf{z}_{0|T}^{i,\text{fixed}};w)</annotation></semantics></math>


</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
             <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{i,\text{fixed}}\leftarrow\text{Normalize}(\mathbf{z}_{0|T}^{i,\text{opt}}),~~\text{Normalize}(\mathbf{z}_{0|T}^{i,\text{fixed}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>fixed</mtext></mrow></msubsup><mo stretchy="false">←</mo><mrow><mtext>Normalize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mtext>Normalize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>fixed</mtext></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{i,\text{fixed}}\leftarrow\text{Normalize}(\mathbf{z}_{0|T}^{i,\text{opt}}),~~\text{Normalize}(\mathbf{z}_{0|T}^{i,\text{fixed}})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
            <span id="alg1.l12.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
            <math id="alg1.l13.m1" class="ltx_Math" alttext="\mathcal{L}^{\gamma}_{\text{CNO}}\coloneqq\mathbb{E}_{i\sim\mathcal{B}}\left[-\log\frac{\exp(\text{sim}(\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{i,\text{fixed}})/\gamma\tau)}{\sum_{j\in\mathcal{B}}\exp(\text{sim}(\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{j,\text{opt}})/\tau)}\right]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>CNO</mtext><mi>γ</mi></msubsup><mo>≔</mo><mrow><msub><mi>𝔼</mi><mrow><mi>i</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mtext>sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>,</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>fixed</mtext></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>γ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow></msub></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mtext>sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>,</mo><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>j</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}^{\gamma}_{\text{CNO}}\coloneqq\mathbb{E}_{i\sim\mathcal{B}}\left[-\log\frac{\exp(\text{sim}(\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{i,\text{fixed}})/\gamma\tau)}{\sum_{j\in\mathcal{B}}\exp(\text{sim}(\mathbf{z}_{0|T}^{i,\text{opt}},\mathbf{z}_{0|T}^{j,\text{opt}})/\tau)}\right]</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
            <math id="alg1.l14.m1" class="ltx_Math" alttext="\mathbf{Z}_{T}\leftarrow\mathbf{Z}_{T}-\eta\cdot\nabla_{\mathbf{Z}_{T}}\mathcal{L}^{\gamma}_{\text{InfoNCE}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐙</mi><mi>T</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>𝐙</mi><mi>T</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>𝐙</mi><mi>T</mi></msub></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>InfoNCE</mtext><mi>γ</mi></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{T}\leftarrow\mathbf{Z}_{T}-\eta\cdot\nabla_{\mathbf{Z}_{T}}\mathcal{L}^{\gamma}_{\text{InfoNCE}}</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
           <span id="alg1.l15.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l15.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
            
           <math id="alg1.l16.m1" class="ltx_Math" alttext="\{\mathbf{z}_{0}^{b}\}_{b=1}^{B}\leftarrow\mathcal{D}_{\text{DDIM}}(\mathbf{Z}_{T},c)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>DDIM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>T</mi></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\mathbf{z}_{0}^{b}\}_{b=1}^{B}\leftarrow\mathcal{D}_{\text{DDIM}}(\mathbf{Z}_{T},c)</annotation></semantics></math>

</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">17:</span>
            
            
           <math id="alg1.l17.m1" class="ltx_Math" alttext="\{\mathbf{x}_{0}^{b}\}_{b=1}^{B}\leftarrow\text{Decode}(\{\mathbf{z}_{0}^{b}\}_{b=1}^{B})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mo stretchy="false">←</mo><mrow><mtext>Decode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐳</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\mathbf{x}_{0}^{b}\}_{b=1}^{B}\leftarrow\text{Decode}(\{\mathbf{z}_{0}^{b}\}_{b=1}^{B})</annotation></semantics></math>

</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">18:</span>
            
            
           <span id="alg1.l18.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l18.m1" class="ltx_Math" alttext="\{\mathbf{x}_{0}^{b}\}_{b=1}^{B}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mn>0</mn><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mi>B</mi></msubsup><annotation encoding="application/x-tex">\{\mathbf{x}_{0}^{b}\}_{b=1}^{B}</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Contrastive Noise Optimization <span id="alg2.5" class="ltx_text" style="--ltx-fg-color:#FF0000;">with KL Regularization</span></figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">0:</span>
            
            
