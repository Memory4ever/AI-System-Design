<td id="A3.T4.2.3.3" class="ltx_td ltx_align_center">21.2164</td>
<td id="A3.T4.2.3.4" class="ltx_td ltx_align_center">4.8016</td></tr>
<tr id="A3.T4.2.4" class="ltx_tr">
<th id="A3.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CADS</th>
<td id="A3.T4.2.4.2" class="ltx_td ltx_align_center">11.167</td>
<td id="A3.T4.2.4.3" class="ltx_td ltx_align_center">21.2254</td>
<td id="A3.T4.2.4.4" class="ltx_td ltx_align_center">4.7964</td></tr>
<tr id="A3.T4.2.5" class="ltx_tr">
<th id="A3.T4.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DiversityPrompt</th>
<td id="A3.T4.2.5.2" class="ltx_td ltx_align_center">18.703</td>
<td id="A3.T4.2.5.3" class="ltx_td ltx_align_center">21.3067</td>
<td id="A3.T4.2.5.4" class="ltx_td ltx_align_center">4.7599</td></tr>
<tr id="A3.T4.2.6" class="ltx_tr">
