           <span id="alg1.l4.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l4.m2" class="ltx_Math" alttext="N_{\text{opt}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext>opt</mtext></msub><annotation encoding="application/x-tex">N_{\text{opt}}</annotation></semantics></math> <span id="alg1.l4.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <span id="alg1.l5.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l5.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
             <math id="alg1.l6.m1" class="ltx_Math" alttext="\mathbf{z}_{0|T}^{i,\text{opt}}\leftarrow\frac{1}{\sqrt{\bar{\alpha}_{T}}}(\mathbf{z}^{i,\text{opt}}_{T}-\sqrt{1-\bar{\alpha}_{T}}\texttt{stopgrad}\{\epsilon_{\theta}(\mathbf{z}^{i,\text{opt}}_{T},T,c)\})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐳</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>T</mi></mrow><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo stretchy="false">←</mo><mrow><mfrac><mn>1</mn><msqrt><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>T</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐳</mi><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>−</mo><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>T</mi></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">stopgrad</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mtext>opt</mtext></mrow></msubsup><mo>,</mo><mi>T</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{0|T}^{i,\text{opt}}\leftarrow\frac{1}{\sqrt{\bar{\alpha}_{T}}}(\mathbf{z}^{i,\text{opt}}_{T}-\sqrt{1-\bar{\alpha}_{T}}\texttt{stopgrad}\{\epsilon_{\theta}(\mathbf{z}^{i,\text{opt}}_{T},T,c)\})</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
