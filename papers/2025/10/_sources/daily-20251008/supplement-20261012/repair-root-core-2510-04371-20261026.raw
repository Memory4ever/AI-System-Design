<span id="S1.T1.2.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 8.0pt;"><cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib23" title="" class="ltx_ref">OpenAI, 2025</a>)</cite></span></span>
