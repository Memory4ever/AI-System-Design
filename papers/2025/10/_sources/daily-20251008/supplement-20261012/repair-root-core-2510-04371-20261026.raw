<span id="S1.T1.2.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 8.0pt;"><span id="S1.T1.2.1.2.2.1.1.1.1" class="ltx_text ltx_font_bold">Deep Research</span></span></span>
