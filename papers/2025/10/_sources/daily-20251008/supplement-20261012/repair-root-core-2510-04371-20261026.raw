<span id="S1.T1.2.1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S1.T1.2.1.1.2.1.1" class="ltx_tr">
<span id="S1.T1.2.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 8.0pt;"><span id="S1.T1.2.1.1.2.1.1.1.1" class="ltx_text ltx_font_bold">OS Tasks</span></span></span>
<span id="S1.T1.2.1.1.2.1.2" class="ltx_tr">
<span id="S1.T1.2.1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:1.5pt 8.0pt;"><cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib1" title="" class="ltx_ref">Abhyankar et al., 2025</a>)</cite></span></span>
</span></span><span id="S1.T1.2.1.1.3" class="ltx_text"></span></td>
<td id="S1.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1.5pt 8.0pt;"><span id="S1.T1.2.1.2.1" class="ltx_text"></span> <span id="S1.T1.2.1.2.2" class="ltx_text">
<span id="S1.T1.2.1.2.2.1" class="ltx_tabular ltx_align_middle">
