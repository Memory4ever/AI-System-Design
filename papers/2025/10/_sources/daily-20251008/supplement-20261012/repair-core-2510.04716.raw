#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -142.65 -73.53)"><foreignObject style="--ltx-fo-width:4.65em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.27em;font-size:9.25pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="59.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m2" class="ltx_Math" alttext="C_{1}=\{x,y\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">C</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">x</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">C_{1}=\{x,y\}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 141.89 -59.01 L 83.13 -59.01 C 80.84 -59.01 78.98 -60.86 78.98 -63.16 L 78.98 -76.99 C 78.98 -79.29 80.84 -81.14 83.13 -81.14 L 141.89 -81.14 C 144.18 -81.14 146.04 -79.29 146.04 -76.99 L 146.04 -63.16 C 146.04 -60.86 144.18 -59.01 141.89 -59.01 Z M 78.98 -81.14"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 83.13 -73.53)"><foreignObject style="--ltx-fo-width:4.59em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.27em;font-size:9.25pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="58.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m3" class="ltx_Math" alttext="C_{2}=\{y,z\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">C</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">y</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">z</mi></mrow><mo stretchy="false">}</