</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Canonical Curved Examples</h2>

<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.1 </span>KCBS pentagon (minimal curved core)</h3>

<div id="S6.SS1.p1" class="ltx_para"><span class="ltx_inline-block"><svg id="S6.SS1.pic1" class="ltx_picture ltx_centering" height="157.5" overflow="visible" version="1.1" viewBox="0 0 164.54 157.5" width="164.54"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,157.5) matrix(1 0 0 -1 0 0) translate(82.27,0) translate(0,71.53)"><path style="fill:none" d="M 10.1 75.59 C 10.1 81.17 5.58 85.69 0 85.69 C -5.58 85.69 -10.1 81.17 -10.1 75.59 C -10.1 70.01 -5.58 65.49 0 65.49 C 5.58 65.49 10.1 70.01 10.1 75.59 Z M 0 75.59"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -6.71 73.65)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="13.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS1.pic1.m1" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 81.99 23.36 C 81.99 28.94 77.47 33.46 71.89 33.46 C 66.31 33.46 61.79 28.94 61.79 23.36 C 61.79 17.78 66.31 13.26 71.89 13.26 C 77.47 13.26 81.99 17.78 81.99 23.36 Z M 71.89 23.36"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 65.19 21.42)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="13.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS1.pic1.m2" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 54.53 -61.15 C 54.53 -55.57 50.01 -51.05 44.43 -51.05 C 38.85 -51.05 34.33 -55.57 34.33 -61.15 C 34.33 -66.73 38.85 -71.26 44.43 -71.26 C 50.01 -71.26 54.53 -66.73 54.53 -61.15 Z M 44.43 -61.15"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 37.72 -63.1)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="13.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS1.pic1.m3" class="ltx_Math" alttext="v_{3}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>3</mn></msub><annotation encoding="application/x-tex">v_{3}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -34.33 -61.15 C -34.33 -55.57 -38.85 -51.05 -44.43 -51.05 C -50.01 -51.05 -54.53 -55.57 -54.53 -61.15 C -54.53 -66.73 -50.01 -71.26 -44.43 -71.26 C -38.85 -71.26 -34.33 -66.73 -34.33 -61.15 Z M -44.43 -61.15"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -51.14 -63.1)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="13.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS1.pic1.m4" class="ltx_Math" alttext="v_{4}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>4</mn></msub><annotation encoding="application/x-tex">v_{4}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -61.79 23.36 C -61.79 28.94 -66.31 33.46 -71.89 33.46 C -77.47 33.46 -81.99 28.94 -81.99 23.36 C -81.99 17.78 -77.47 13.26 -71.89 13.26 C -66.31 13.26 -61.79 17.78 -61.79 23.36 Z M -71.89 23.36"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -78.6 21.42)"><foreignObject style="--ltx-fo-width:0.97em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="13.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS1.pic1.m5" class="ltx_Math" alttext="v_{5}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>5</mn></msub><annotation encoding="application/x-tex">v_{5}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 8.4 69.49 L 63.49 29.46 M 68.68 13.49 L 47.64 -51.28 M 34.05 -61.15 L -34.05 -61.15 M -47.64 -51.28 L -68.68 13.49 M -63.49 29.46 L -8.4 69.49"></path></g></svg></span>
</div>
<div id="S6.SS1.p2" class="ltx_para">
<p id="S6.SS1.p2.1" class="ltx_p">Contexts are adjacent pairs <math id="S6.SS1.p2.m1" class="ltx_Math" alttext="\{v_{i},v_{i+1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v_{i},v_{i+1}\}</annotation></semantics></math> (indices mod 5).
Suppose each context enforces exclusivity <math id="S6.SS1.p2.m2" class="ltx_Math" alttext="v_{i}\land v_{i+1}=\mathrm{F}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∧</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>=</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">v_{i}\land v_{i+1}=\mathrm{F}</annotation></semantics></math> and exactly-one constraints.
Each edge admits a local valuation (e.g., <math id="S6.SS1.p2.m3" class="ltx_Math" alttext="(\mathrm{T},\mathrm{F})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathrm{T},\mathrm{F})</annotation></semantics></math>), but traversing the cycle forces a parity contradiction:
an odd cycle cannot consistently assign “exactly one true” globally.
Thus <math id="S6.SS1.p2.m4" class="ltx_Math" alttext="\kappa&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa&gt;0</annotation></semantics></math>.</p>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2 </span>Mermin square</h3>

<div id="S6.SS2.p1" class="ltx_para"><span class="ltx_inline-block"><svg id="S6.SS2.pic1" class="ltx_picture ltx_centering" height="121.81" overflow="visible" version="1.1" viewBox="0 0 139.14 121.81" width="139.14"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,121.81) matrix(1 0 0 -1 0 0) translate(17.6,0) translate(0,17.6)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -9.46 84.67)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m1" class="ltx_Math" alttext="v_{11}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>11</mn></msub><annotation encoding="application/x-tex">v_{11}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.51 84.67)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m2" class="ltx_Math" alttext="v_{12}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>12</mn></msub><annotation encoding="application/x-tex">v_{12}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 94.47 84.67)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m3" class="ltx_Math" alttext="v_{13}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>13</mn></msub><annotation encoding="application/x-tex">v_{13}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -9.46 41.37)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m4" class="ltx_Math" alttext="v_{21}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>21</mn></msub><annotation encoding="application/x-tex">v_{21}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.51 41.37)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m5" class="ltx_Math" alttext="v_{22}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>22</mn></msub><annotation encoding="application/x-tex">v_{22}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 94.47 41.37)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m6" class="ltx_Math" alttext="v_{23}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>23</mn></msub><annotation encoding="application/x-tex">v_{23}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -9.46 -1.94)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m7" class="ltx_Math" alttext="v_{31}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>31</mn></msub><annotation encoding="application/x-tex">v_{31}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 42.51 -1.94)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m8" class="ltx_Math" alttext="v_{32}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>32</mn></msub><annotation encoding="application/x-tex">v_{32}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 94.47 -1.94)"><foreignObject style="--ltx-fo-width:1.37em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="18.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS2.pic1.m9" class="ltx_Math" alttext="v_{33}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>33</mn></msub><annotation encoding="application/x-tex">v_{33}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -17.32 103.94 M -17.32 95.64 L -17.32 77.59 C -17.32 73.01 -13.61 69.29 -9.02 69.29 L 112.96 69.29 C 117.54 69.29 121.26 73.01 121.26 77.59 L 121.26 95.64 C 121.26 100.22 117.54 103.94 112.96 103.94 L -9.02 103.94 C -13.61 103.94 -17.32 100.22 -17.32 95.64 Z M 121.26 69.29"></path><path style="fill:none" d="M -17.32 60.63 M -17.32 52.33 L -17.32 34.29 C -17.32 29.7 -13.61 25.98 -9.02 25.98 L 112.96 25.98 C 117.54 25.98 121.26 29.7 121.26 34.29 L 121.26 52.33 C 121.26 56.91 117.54 60.63 112.96 60.63 L -9.02 60.63 C -13.61 60.63 -17.32 56.91 -17.32 52.33 Z M 121.26 25.98"></path><path style="fill:none" d="M -17.32 17.32 M -17.32 9.02 L -17.32 -9.02 C -17.32 -13.61 -13.61 -17.32 -9.02 -17.32 L 112.96 -17.32 C 117.54 -17.32 121.26 -13.61 121.26 -9.02 L 121.26 9.02 C 121.26 13.61 117.54 17.32 112.96 17.32 L -9.02 17.32 C -13.61 17.32 -17.32 13.61 -17.32 9.02 Z M 121.26 -17.32"></path><path style="fill:none" d="M -17.32 103.94 M -17.32 95.64 L -17.32 -9.02 C -17.32 -13.61 -13.61 -17.32 -9.02 -17.32 L 9.02 -17.32 C 13.61 -17.32 17.32 -13.61 17.32 -9.02 L 17.32 95.64 C 17.32 100.22 13.61 103.94 9.02 103.94 L -9.02 103.94 C -13.61 103.94 -17.32 100.22 -17.32 95.64 Z M 17.32 -17.32"></path><path style="fill:none" d="M 34.65 103.94 M 34.65 95.64 L 34.65 -9.02 C 34.65 -13.61 38.36 -17.32 42.95 -17.32 L 60.99 -17.32 C 65.58 -17.32 69.29 -13.61 69.29 -9.02 L 69.29 95.64 C 69.29 100.22 65.58 103.94 60.99 103.94 L 42.95 103.94 C 38.36 103.94 34.65 100.22 34.65 95.64 Z M 69.29 -17.32"></path><path style="fill:none" d="M 86.61 103.94 M 86.61 95.64 L 86.61 -9.02 C 86.61 -13.61 90.33 -17.32 94.92 -17.32 L 112.96 -17.32 C 117.54 -17.32 121.26 -13.61 121.26 -9.02 L 121.26 95.64 C 121.26 100.22 117.54 103.94 112.96 103.94 L 94.92 103.94 C 90.33 103.94 86.61 100.22 86.61 95.64 Z M 121.26 -17.32"></path></g></svg></span>
</div>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p">Contexts are rows and columns.
Under parity constraints, each row/column admits a local valuation, but the product of all rows contradicts the product of all columns.
No global valuation exists; <math id="S6.SS2.p2.m1" class="ltx_Math" alttext="\kappa&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa&gt;0</annotation></semantics></math>.</p>
</div>
</section>
<section id="S6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.3 </span>Curved cores</h3>

<div id="Thmdefinition8" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition8.2" class="ltx_text ltx_font_bold">Definition 8</span></span><span id="Thmdefinition8.3" class="ltx_text ltx_font_bold"> </span>(Curved core)<span id="Thmdefinition8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition8.p1" class="ltx_para">
<p id="Thmdefinition8.p1.1" class="ltx_p"><span id="Thmdefinition8.p1.1.1" class="ltx_text ltx_font_italic">A <em id="Thmdefinition8.p1.1.1.1" class="ltx_emph ltx_font_upright">curved core</em> of <math id="Thmdefinition8.p1.m1" class="ltx_Math" alttext="(V,\mathcal{C})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V,\mathcal{C})</annotation></semantics></math> is a minimal subfamily <math id="Thmdefinition8.p1.m2" class="ltx_Math" alttext="\mathcal{C}^{\prime}\subseteq\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>′</mo></msup><mo>⊆</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mathcal{C}^{\prime}\subseteq\mathcal{C}</annotation></semantics></math> such that:</span></p>
<ol id="S6.I1" class="ltx_enumerate">
<li id="S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S6.I1.i1.p1" class="ltx_para">
<p id="S6.I1.i1.p1.1" class="ltx_p"><math id="S6.I1.i1.p1.m1" class="ltx_Math" alttext="\kappa(V,\mathcal{C}^{\prime})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa(V,\mathcal{C}^{\prime})&gt;0</annotation></semantics></math><span id="S6.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">, and</span></p>
</div></li>
<li id="S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S6.I1.i2.p1" class="ltx_para">
<p id="S6.I1.i2.p1.1" class="ltx_p"><span id="S6.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">for every proper subfamily </span><math id="S6.I1.i2.p1.m1" class="ltx_Math" alttext="\mathcal{C}^{\prime\prime}\subsetneq\mathcal{C}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>′′</mo></msup><mo>⊊</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{C}^{\prime\prime}\subsetneq\mathcal{C}^{\prime}</annotation></semantics></math><span id="S6.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S6.I1.i2.p1.m2" class="ltx_Math" alttext="\kappa(V,\mathcal{C}^{\prime\prime})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\kappa(V,\mathcal{C}^{\prime\prime})=0</annotation></semantics></math><span id="S6.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S6.SS3.p1" class="ltx_para">
<p id="S6.SS3.p1.1" class="ltx_p">Curved cores are obstruction witnesses: every curved system contains one.
Examples: KCBS pentagon, Mermin square.</p>
</div>
</section>
<section id="S6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.4 </span>Overlap propagation illustration</h3>

