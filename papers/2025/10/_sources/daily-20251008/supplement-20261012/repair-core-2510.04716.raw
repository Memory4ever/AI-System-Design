<td id="A2.T11.5.1.3" class="ltx_td ltx_align_right ltx_border_b ltx_border_tt"><math id="A2.T11.m10" class="ltx_Math" alttext="\hat{\alpha}_{\infty}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>α</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\hat{\alpha}_{\infty}</annotation></semantics></math></td></tr>
