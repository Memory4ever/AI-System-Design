 style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 84.93 7.54)"><foreignObject style="--ltx-fo-width:2.93em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="37.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S6.SS4.pic1.1" class="ltx_text" style="font-size:90%;">(OVL)</span></span></span></foreignObject></g><path style="fill:none" d="M 34.8 -72.38 L -34.8 -72.38 C -37.85 -72.38 -40.33 -74.85 -40.33 -77.91 L -40.33 -87.44 C -40.33 -90.5 -37.85 -92.98 -34.8 -92.98 L 34.8 -92.98 C 37.85 -92.98 40.33 -90.5 40.33 -87.44 L 40.33 -77.91 C 40.33 -74.85 37.85 -72.38 34.8 -72.38 Z M -40.33 -92.98"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -36.18 -86.14)"><foreignObject style="--ltx-fo-width:5.23em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="72.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS4.pic1.m4" class="ltx_math_unparsed" alttext="C:\ \Gamma,\psi\vdash\bot" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.278em" rspace="0.778em">:</mo><mi mathvariant="normal">Γ</mi><mo>,</mo><mi>ψ</mi><mo rspace="0em">⊢</mo><mo lspace="0em">⊥</mo></mrow><annotation encoding="application/x-tex">C:\ \Gamma,\psi\vdash\bot</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 237.43 -71.98 L 156.27 -71.98 C 153.21 -71.98 150.74 -74.46 150.74 -77.51 L 150.74 -87.84 C 150.74 -90.9 153.21 -93.37 156.27 -93.37 L 237.43 -93.37 C 240.49 -93.37 242.97 -90.9 242.97 -87.84 L 242.97 -77.51 C 242.97 -74.46 240.49 -71.98 237.43 -71.98 Z M 150.74 -93.37"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 154.89 -86.53)"><foreignObject style="--ltx-fo-width:6.07em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.19em;font-size:10pt;" height="13.09" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="83.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS4.pic1.m5" class="ltx_math_unparsed" alttext="C^{\prime}:\ \Gamma,\lnot\psi\vdash\bot" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0.278em" rspace="0.778em">:</mo><mi mathvariant="normal">Γ</mi><mo>,</mo><mo rspace="0.167em">¬</mo><mi>ψ</mi><mo rspace="0em">⊢</mo><mo lspace="0em">⊥</mo></mrow><annotation encoding="application/x-tex">C^{\prime}:\ \Gamma,\lnot\psi\vdash\bot</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 138.78 -116.63 L 58.07 -116.63 C 55.01 -116.63 52.53 -119.11 52.53 -122.17 L 52.53 -129.8 C 52.53 -132.86 55.01 -135.34 58.07 -135.34 L 138.78 -135.34 C 141.84 -135.34 144.32 -132.86 144.32 -129.8 L 144.32 -122.17 C 144.32 -119.11 141.84 -116.63 138.78 -116.63 Z M 52.53 -135.34"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.68 -131.19)"><foreignObject style="--ltx-fo-width:6.03em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="83.49"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.SS4.pic1.m6" class="ltx_math_unparsed" alttext="C\cup C^{\prime}:\ \Gamma\vdash\bot" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∪</mo><mi>C</mi><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0.278em" rspace="0.778em">:</mo><mi mathvariant="normal">Γ</mi><mo rspace="0em">⊢</mo><mo lspace="0em">⊥</mo></mrow><annotation encoding="application/x-tex">C\cup C^{\prime}:\ \Gamma\vdash\bot</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 24.04 -93.25 L 65.99 -111.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.91534 -0.40266 0.40266 0.91534 65.99 -111.71)"><path d="M 10.43 0 C 9.15 0.31 3.52 2.05 0 3.95 L 0 -3.95 C 3.52 -2.05 9.15 -0.31 10.43 0 Z"></path></g><path style="fill:none" d="M 171.91 -93.65 L 130.86 -111.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.91534 -0.40266 0.40266 -0.91534 130.86 -111.71)"><path d="M 10.43 0 C 9.15 0.31 3.52 2.05 0 3.95 L 0 -3.95 C 3.52 -2.05 9.15 -0.31 10.43 0 Z"></path></g></g></svg></span>
</figure>
</section>
<section id="S6.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.5 </span>Encoding KCBS as CBL-SAT</h3>

<div id="S6.SS5.p1" class="ltx_para">
<p id="S6.SS5.p1.1" class="ltx_p">Let <math id="S6.SS5.p1.m1" class="ltx_Math" alttext="V=\{v_{1},\ldots,v_{5}\}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mn>5</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V=\{v_{1},\ldots,v_{5}\}</annotation></semantics></math> and contexts <math id="S6.SS5.p1.m2" class="ltx_Math" alttext="C_{i}=\{v_{i},v_{i+1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">C_{i}=\{v_{i},v_{i+1}\}</annotation></semantics></math> (mod 5).
Each <math id="S6.SS5.p1.m3" class="ltx_Math" alttext="C_{i}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>i</mi></msub><annotation encoding="application/x-tex">C_{i}</annotation></semantics></math> has clauses:</p>
<table id="S6.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex2.m1" class="ltx_Math" alttext="\phi_{i}^{(1)}:=(v_{i}\lor v_{i+1}),\quad\phi_{i}^{(2)}:=(\lnot v_{i}\lor\lnot v_{i+1})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>ϕ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∨</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mi>ϕ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">¬</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo>∨</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi_{i}^{(1)}:=(v_{i}\lor v_{i+1}),\quad\phi_{i}^{(2)}:=(\lnot v_{i}\lor\lnot v_{i+1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS5.p1.2" class="ltx_p">Locally satisfiable, but globally unsatisfiable.</p>
</div>
<figure id="S6.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S6.T3.3" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="S6.T3.4" class="ltx_text" style="font-size:90%;">KCBS local assignments vs global inconsistency.</span></figcaption>
