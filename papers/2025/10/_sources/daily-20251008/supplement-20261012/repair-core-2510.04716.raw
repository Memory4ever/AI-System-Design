<section id="S24.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">24.2 </span>CHSH/KCBS Mixtures</h3>

<figure id="S24.T9" class="ltx_table">
