(density <math id="S24.T9.m8" class="ltx_Math" alttext="1/4" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">1/4</annotation></semantics></math>) and <math id="S24.T9.m9" class="ltx_Math" alttext="(1-p)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-p)</annotation></semantics></math> is KCBS (<math id="S24.T9.m10" class="ltx_Math" alttext="1/5" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">1/5</annotation></semantics></math>); hence <math id="S24.T9.m11" class="ltx_Math" alttext="\rho_{\mathrm{face}}(p)=p/4+(1-p)/5" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>face</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>p</mi><mo>/</mo><mn>4</mn></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>5</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{\mathrm{face}}(p)=p/4+(1-p)/5</annotation></semantics></math>.
Fitted large-<math id="S24.T9.m12" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> intercepts follow the predicted linear law.</span></figcaption>
