" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="87.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S1.F1.pic1.4" class="ltx_text ltx_font_sansserif" style="font-size:90%;">CBL (this work)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#666666;" stroke="#666666"><path style="fill:none" d="M 69.06 0 L 244.6 0"></path><g style="--ltx-fill-color:#666666;" fill="#666666" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 241.66 0)"><path d="M 7.22 0 L 1.56 2.1 L 3.19 0 L 1.56 -2.1 Z"></path></g></g><g style="--ltx-stroke-color:#666666;" stroke="#666666"><path style="fill:none" d="M 330.47 0 L 506 0"></path><g style="--ltx-fill-color:#666666;" fill="#666666" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 503.06 0)"><path d="M 7.22 0 L 1.56 2.1 L 3.19 0 L 1.56 -2.1 Z"></path></g></g><g style="--ltx-stroke-color:#666666;" stroke="#666666"><path style="fill:none" d="M 645.02 0 L 820.55 0"></path><g style="--ltx-fill-color:#666666;" fill="#666666" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 817.61 0)"><path d="M 7.22 0 L 1.56 2.1 L 3.19 0 L 1.56 -2.1 Z"></path></g></g></g></svg></span>
