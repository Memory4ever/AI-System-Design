          <span id="lstnumberx3.2" class="ltx_text ltx_lst_keyword" style="font-size:80%;--ltx-fg-color:#FF00FF;">import</span><span id="lstnumberx3.3" class="ltx_text ltx_lst_space" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">pandas</span><span id="lstnumberx3.5" class="ltx_text ltx_lst_space" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">as</span><span id="lstnumberx3.7" class="ltx_text ltx_lst_space" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx3.8" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">pd</span>
