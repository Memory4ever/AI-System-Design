tx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">additional</span><span id="lstnumberx106.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">regularization</span><span id="lstnumberx106.18" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">;</span><span id="lstnumberx106.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx106.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">model</span><span id="lstnumberx106.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx106.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">not</span><span id="lstnumberx106.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">overfit</span><span id="lstnumberx106.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">because</span><span id="lstnumberx106.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx106.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">default</span><span id="lstnumberx106.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">parameter</span><span id="lstnumberx106.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">C</span><span id="lstnumberx106.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx106.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.42" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">1,</span><span id="lstnumberx106.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx106.45" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">should</span><span id="lstnumberx106.47" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">actually</span><span id="lstnumberx106.49" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">be</span><span id="lstnumberx106.51" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">higher</span><span id="lstnumberx106.53" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">to</span><span id="lstnumberx106.55" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">decrease</span><span id="lstnumberx106.57" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">regularization</span><span id="lstnumberx106.59" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx106.60" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.61" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">However</span><span id="lstnumberx106.62" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx106.63" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.64" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">students</span><span id="lstnumberx106.65" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.66" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">should</span><span id="lstnumberx106.67" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">explore</span><span id="lstnumberx106.69" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.70" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">tuning</span><span id="lstnumberx106.71" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.72" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx106.73" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.74" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">parameter</span><span id="lstnumberx106.75" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.76" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">on</span><span id="lstnumberx106.77" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.78" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">their</span><span id="lstnumberx106.79" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.80" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">own</span><span id="lstnumberx106.81" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.82" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">if</span><span id="lstnumberx106.83" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.84" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">they</span><span id="lstnumberx106.85" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx106.86" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">wish</span><span id="lstnumberx106.87" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span>
</div>
</div>
<figcaption class="ltx_caption" style="--ltx-fg-color:#000000;--ltx-bg-color:#FFF7DE;"><span class="ltx_tag ltx_tag_float">Listing A.6: </span><span id="LST6.8" class="ltx_text ltx_font_bold">Logistic Regression</span> task solutions provided to the <span id="LST6.9" class="ltx_text ltx_font_bold">Misconceptions Inference LLM</span>.</figcaption>
</figure>
