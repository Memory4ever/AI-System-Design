tifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">represent</span><span id="lstnumberx170.60" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.61" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">what</span><span id="lstnumberx170.62" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.63" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">they</span><span id="lstnumberx170.64" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.65" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">subjectively</span><span id="lstnumberx170.66" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.67" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">believe</span><span id="lstnumberx170.68" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.69" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">to</span><span id="lstnumberx170.70" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">be</span><span id="lstnumberx170.72" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">true</span><span id="lstnumberx170.74" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">about</span><span id="lstnumberx170.76" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx170.78" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.79" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">task</span><span id="lstnumberx170.80" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx170.81" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.82" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">while</span><span id="lstnumberx170.83" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.84" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">misconceptions</span><span id="lstnumberx170.85" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.86" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">represent</span><span id="lstnumberx170.87" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.88" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">what</span><span id="lstnumberx170.89" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.90" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">they</span><span id="lstnumberx170.91" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.92" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">don</span><span id="lstnumberx170.93" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">’</span><span id="lstnumberx170.94" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">t</span><span id="lstnumberx170.95" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.96" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">know</span><span id="lstnumberx170.97" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.98" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">or</span><span id="lstnumberx170.99" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.100" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">don</span><span id="lstnumberx170.101" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">’</span><span id="lstnumberx170.102" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">t</span><span id="lstnumberx170.103" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx170.104" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">understand</span><span id="lstnumberx170.105" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span>
</div>
<div id="lstnumberx171" class="ltx_listingline"><span id="lstnumberx171.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">2.</span><span id="lstnumberx171.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx171.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx171.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx171.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">assignment</span><span id="lstnumberx171.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx171.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">context</span><span id="lstnumberx171.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx171.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">and</span><span id="lstnumberx171.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx171.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">conversation</span><span id="lstnumberx171.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx171.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">history</span><span id="lstnumberx171.14" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span>
</div>
</div>
