<span id="S3.T1.7.2.3.1" class="ltx_inline-block ltx_align_top" style="width:112.4pt;">
<span id="S3.T1.7.2.3.1.1" class="ltx_p"><span id="S3.T1.7.2.3.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Proposed Solution</span></span>
</span></th>
