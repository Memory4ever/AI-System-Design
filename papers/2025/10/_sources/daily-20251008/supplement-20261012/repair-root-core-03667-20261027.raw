          <span id="lstnumberx4.2" class="ltx_text ltx_lst_keyword" style="font-size:80%;--ltx-fg-color:#FF00FF;">from</span><span id="lstnumberx4.3" class="ltx_text ltx_lst_space" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx4.4" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">sklearn</span><span id="lstnumberx4.5" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">ensemble</span><span id="lstnumberx4.7" class="ltx_text ltx_lst_space" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx4.8" class="ltx_text ltx_lst_keyword" style="font-size:80%;--ltx-fg-color:#FF00FF;">import</span><span id="lstnumberx4.9" class="ltx_text ltx_lst_space" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx4.10" class="ltx_text ltx_lst_identifier" style="font-size:80%;--ltx-fg-color:#000000;">RandomForestClassifier</span>
