<span id="S3.T1.7.3.1.1" class="ltx_inline-block ltx_align_top" style="width:11.4pt;">
<span id="S3.T1.7.3.1.1.1" class="ltx_p"><span id="S3.T1.7.3.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">RF1</span></span>
</span></th>
<td id="S3.T1.7.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
