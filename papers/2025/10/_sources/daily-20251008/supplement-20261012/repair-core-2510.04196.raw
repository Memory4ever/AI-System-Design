<td id="S4.T1.2.7.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Qwen2.5-VL-72B</td>
<td id="S4.T1.2.7.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">  70.4</td>
