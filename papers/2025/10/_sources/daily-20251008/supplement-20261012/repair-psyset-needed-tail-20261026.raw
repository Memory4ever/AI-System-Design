<td id="S3.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.2.2.7.1" class="ltx_text" style="--ltx-bg-color:#E8F1FF;">-</span></td>
<td id="S3.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S3.T1.m6" class="ltx_Math" style="--ltx-bg-color:#E8F1FF;" alttext="\mathbf{5.0_{\scriptstyle\pm 0.0}}" display="inline" intent=":literal"><semantics><msub><mn style="--ltx-bg-color:#E8F1FF;" class="ltx_mathvariant_bold" mathbackground="#E8F1FF" mathvariant="bold">5.0</mn><mrow><mo style="--ltx-bg-color:#E8F1FF;" mathbackground="#E8F1FF">±</mo><mn style="--ltx-bg-color:#E8F1FF;" class="ltx_mathvariant_bold" mathbackground="#E8F1FF" mathvariant="bold">0.0</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{5.0_{\scriptstyle\pm 0.0}}</annotation></semantics></math></td>
