</span></span><span id="S4.T1.2.4.2.3" class="ltx_text"></span></td>
<td id="S4.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.4.3.1" class="ltx_text"></span> <span id="S4.T1.2.4.3.2" class="ltx_text">
<span id="S4.T1.2.4.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.2.4.3.2.1.1" class="ltx_tr">
<span id="S4.T1.2.4.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">35.4%</span></span>
<span id="S4.T1.2.4.3.2.1.2" class="ltx_tr">
