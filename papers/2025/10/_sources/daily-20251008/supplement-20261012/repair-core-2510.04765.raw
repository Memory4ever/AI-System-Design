<div id="alg1.6.6" class="ltx_listingline"><span id="alg1.6.6.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.6.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.6.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.6.4" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#0000FF;">6</span></span>
              <span id="alg1.6.6.5" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#0000FF;">### Action generation with MoE ###</span><span id="alg1.6.6.6" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg1.6.7" class="ltx_listingline"><span id="alg1.6.7.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.7.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.7.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.7.4" class="ltx_text ltx_font_bold" style="font-size:80%;">7</span></span>
              <span id="alg1.6.7.5" class="ltx_text" style="font-size:80%;">Each expert generates its own action </span><math id="alg1.m7" class="ltx_Math" alttext="\mathcal{E}_{\boldsymbol{\psi}_{i}}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℰ</mi><msub><mi mathsize="0.800em">𝝍</mi><mi mathsize="0.800em">i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">𝐱</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\boldsymbol{\psi}_{i}}(\mathbf{x})</annotation></semantics></math><span id="alg1.6.7.6" class="ltx_text" style="font-size:80%;"> based on the current state.
</span>
</div>
<div id="alg1.6.8" class="ltx_listingline"><span id="alg1.6.8.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.8.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.8.3" class="ltx_text" style="font-size:80%;">  </span>
