<span id="S3.T1.2.1.1.1.4.1.1" class="ltx_inline-block ltx_align_middle" style="width:55.6pt;">
<span id="S3.T1.2.1.1.1.4.1.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.2.1.1.1.4.1.1.1.1" class="ltx_text ltx_font_typewriter">crop</span></span>
</span></span>
<span id="S3.T1.2.1.1.1.4.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t" style="padding:-0.1pt 4.0pt;">
