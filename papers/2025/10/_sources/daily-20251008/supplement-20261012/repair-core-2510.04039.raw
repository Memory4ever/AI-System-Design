<td id="S5.T5.4.1.21.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m83" class="ltx_Math" style="--ltx-bg-color:#F8E4E2;" alttext="20.2" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F8E4E2;" mathbackground="#F8E4E2">20.2</mn><annotation encoding="application/x-tex">20.2</annotation></semantics></math></td>
<td id="S5.T5.4.1.21.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.1pt 4.0pt;"><span id="S5.T5.4.1.21.6.1" class="ltx_text" style="--ltx-bg-color:#F8E4E2;">-</span></td>
<td id="S5.T5.4.1.21.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m84" class="ltx_Math" style="--ltx-bg-color:#F8E4E2;" alttext="35.6" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F8E4E2;" mathbackground="#F8E4E2">35.6</mn><annotation encoding="application/x-tex">35.6</annotation></semantics></math></td></tr>
<tr id="S5.T5.4.1.22" class="ltx_tr" style="--ltx-bg-color:#D5ECED;">
<td id="S5.T5.4.1.22.1" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><span id="S5.T5.4.1.22.1.1" class="ltx_text" style="--ltx-bg-color:#D5ECED;">GUI-Spotlight (Init. UI-TARS-1.5-7B)</span></td>
<td id="S5.T5.4.1.22.2" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m85" class="ltx_Math" style="--ltx-bg-color:#D5ECED;" alttext="68.2" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D5ECED;" mathbackground="#D5ECED">68.2</mn><annotation encoding="application/x-tex">68.2</annotation></semantics></math></td>
<td id="S5.T5.4.1.22.3" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m86" class="ltx_Math" style="--ltx-bg-color:#D5ECED;" alttext="60.6" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D5ECED;" mathbackground="#D5ECED">60.6</mn><annotation encoding="application/x-tex">60.6</annotation></semantics></math></td>
<td id="S5.T5.4.1.22.4" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m87" class="ltx_Math" style="--ltx-bg-color:#D5ECED;" alttext="63.2" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D5ECED;" mathbackground="#D5ECED">63.2</mn><annotation encoding="application/x-tex">63.2</annotation></semantics></math></td>
<td id="S5.T5.4.1.22.5" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m88" class="ltx_Math" style="--ltx-bg-color:#D5ECED;" alttext="45.6" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D5ECED;" mathbackground="#D5ECED">45.6</mn><annotation encoding="application/x-tex">45.6</annotation></semantics></math></td>
<td id="S5.T5.4.1.22.6" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><span id="S5.T5.4.1.22.6.1" class="ltx_text" style="--ltx-bg-color:#D5ECED;">-</span></td>
<td id="S5.T5.4.1.22.7" class="ltx_td ltx_align_center ltx_border_b" style="padding:-0.1pt 4.0pt;"><math id="S5.T5.m89" class="ltx_Math" style="--ltx-bg-color:#D5ECED;" alttext="62.7" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D5ECED;" mathbackground="#D5ECED">62.7</mn><annotation encoding="application/x-tex">62.7</annotation></semantics></math></td></tr>
