<tr id="A1.T7.2.12" class="ltx_tr">
<th id="A1.T7.2.12.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:-0.1pt 4.0pt;">KL coefficient <math id="A1.T7.m7" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></th>
<td id="A1.T7.2.12.2" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="A1.T7.2.12.2.1" class="ltx_text ltx_font_typewriter">0.00</span></td></tr>
<tr id="A1.T7.2.13" class="ltx_tr">
<th id="A1.T7.2.13.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:-0.1pt 4.0pt;">Max prompt length</th>
