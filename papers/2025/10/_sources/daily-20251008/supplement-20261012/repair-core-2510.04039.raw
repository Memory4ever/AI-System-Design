<div id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx6.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">crop</span><span id="lstnumberx6.3" class="ltx_text ltx_font_typewriter">&gt;(</span><span id="lstnumberx6.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Image_0</span><span id="lstnumberx6.5" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx6.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.7" class="ltx_text ltx_font_typewriter">(10,</span><span id="lstnumberx6.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.9" class="ltx_text ltx_font_typewriter">20),</span><span id="lstnumberx6.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.11" class="ltx_text ltx_font_typewriter">(110,</span><span id="lstnumberx6.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.13" class="ltx_text ltx_font_typewriter">100))&lt;/</span><span id="lstnumberx6.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">crop</span><span id="lstnumberx6.15" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx6.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.17" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx6.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Crop</span><span id="lstnumberx6.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx6.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rectangle</span><span id="lstnumberx6.24" class="ltx_text ltx_lst_sp