<th id="A1.T7.2.8.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:-0.1pt 4.0pt;">Clip range high <math id="A1.T7.m6" class="ltx_Math" alttext="\epsilon_{\text{high}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mtext>high</mtext></msub><annotation encoding="application/x-tex">\epsilon_{\text{high}}</annotation></semantics></math></th>
<td id="A1.T7.2.8.2" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="A1.T7.2.8.2.1" class="ltx_text ltx_font_typewriter">0.28</span></td></tr>
<tr id="A1.T7.2.9" class="ltx_tr">
