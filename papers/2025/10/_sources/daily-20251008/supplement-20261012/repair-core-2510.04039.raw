<td id="S3.T2.2.1.3.1" class="ltx_td ltx_align_center" style="padding-bottom: 2.0pt;padding:-0.1pt 4.0pt;"><math id="S3.T2.m10" class="ltx_Math" alttext="r_{2}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>2</mn></msub><annotation encoding="application/x-tex">r_{2}</annotation></semantics></math></td>
