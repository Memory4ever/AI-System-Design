            <math id="algorithm1.m24" class="ltx_Math" alttext="u_{cur}\leftarrow u_{next}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">←</mo><msub><mi>u</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">u_{cur}\leftarrow u_{next}</annotation></semantics></math>;
