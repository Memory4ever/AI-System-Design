<td id="S5.T4.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">w/ <span id="S5.T4.2.1.2.1.1" class="ltx_text ltx_font_smallcaps">Agent+P</span></td>
<td id="S5.T4.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">0.60</td>
