<div id="lstnumberx26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26</span>
              
              
              
            <span id="lstnumberx26.2" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">      </span><span id="lstnumberx26.3" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx26.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">when</span><span id="lstnumberx26.5" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx26.6" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx26.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">goal</span><span id="lstnumberx26.8" class="ltx_text ltx_font_typewriter ltx_font_bold">-</span><span id="lstnumberx26.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">node</span><span id="lstnumberx26.10" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx26.11" class="ltx_text ltx_font_typewriter ltx_font_bold">?</span><span id="lstnumberx26.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">to</span><span id="lstnumberx26.13" class="ltx_text ltx_font_typewriter ltx_font_bold">)</span><span id="lstnumberx26.14" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx26.15" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx26.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">goal</span><span id="lstnumberx26.17" class="ltx_text ltx_font_typewriter ltx_font_bold">-</span><span id="lstnumberx26.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">achieved</span><span id="lstnumberx26.19" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx26.20" class="ltx_text ltx_font_typewriter ltx_font_bold">?</span><span id="lstnumberx26.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">to</span><span id="lstnumberx26.22" class="ltx_text ltx_font_typewriter ltx_font_bold">))</span>
</div>
