            <span id="lstnumberx27.2" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">    </span><span id="lstnumberx27.3" class="ltx_text ltx_font_typewriter ltx_font_bold">)</span>
</div>
