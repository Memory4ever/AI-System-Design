<figure id="S3.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 2: </span>Mapping of UI automation notation to classical planning equivalent.</figcaption>
<div id="S3.T2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:76.7pt;vertical-align:-36.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-73.3pt,16.3pt) scale(0.701853676307664,0.701853676307664) ;">
<table id="S3.T2.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S3.T2.2.1.1" class="ltx_tr">
<th id="S3.T2.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt"><span id="S3.T2.2.1.1.1.1" class="ltx_text ltx_font_bold">UI Automation Notation</span></th>
<td id="S3.T2.2.1.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_tt"><span id="S3.T2.2.1.1.2.1" class="ltx_text ltx_font_bold">Classical Planning Equivalent</span></td></tr>
<tr id="S3.T2.2.1.2" class="ltx_tr">
<th id="S3.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">A UI state (UI) <math id="S3.T2.m1" class="ltx_Math" alttext="u\in\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">u\in\mathcal{U}</annotation></semantics></math></th>
<td id="S3.T2.2.1.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">A state <math id="S3.T2.m2" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> where the predicate <math id="S3.T2.m3" class="ltx_Math" alttext="at(u)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u)</annotation></semantics></math> is true</td></tr>
<tr id="S3.T2.2.1.3" class="ltx_tr">
<th id="S3.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">The set of all UIs <math id="S3.T2.m4" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math></th>
<td id="S3.T2.2.1.3.2" class="ltx_td ltx_nopad_r ltx_align_left">The state space <math id="S3.T2.m5" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.1.4" class="ltx_tr">
<th id="S3.T2.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">The initial UI <math id="S3.T2.m6" class="ltx_Math" alttext="u_{init}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{init}</annotation></semantics></math></th>
<td id="S3.T2.2.1.4.2" class="ltx_td ltx_nopad_r ltx_align_left">The initial state <math id="S3.T2.m7" class="ltx_Math" alttext="s_{init}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">s_{init}</annotation></semantics></math>, defined by <math id="S3.T2.m8" class="ltx_Math" alttext="at(u_{init})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u_{init})</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.1.5" class="ltx_tr">
<th id="S3.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">The target UI <math id="S3.T2.m9" class="ltx_Math" alttext="u_{target}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{target}</annotation></semantics></math></th>
<td id="S3.T2.2.1.5.2" class="ltx_td ltx_nopad_r ltx_align_left">The goal <math id="S3.T2.m10" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>, specified by the condition <math id="S3.T2.m11" class="ltx_Math" alttext="at(u_{target})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u_{target})</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.1.6" class="ltx_tr">
<th id="S3.T2.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">A UI transition via the edge <math id="S3.T2.m12" class="ltx_Math" alttext="(u_{i},u_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u_{i},u_{j})</annotation></semantics></math> with label <math id="S3.T2.m13" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math></th>
<td id="S3.T2.2.1.6.2" class="ltx_td ltx_nopad_r ltx_align_left">A planning action</td></tr>
<tr id="S3.T2.2.1.7" class="ltx_tr">
<th id="S3.T2.2.1.7.1" class="ltx_td ltx_align_right ltx_th ltx_th_row"><span id="S3.T2.2.1.7.1.1" class="ltx_text ltx_font_italic">Precondition: the app is on UI <math id="S3.T2.m14" class="ltx_Math" alttext="u_{i}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>i</mi></msub><annotation encoding="application/x-tex">u_{i}</annotation></semantics></math></span></th>
<td id="S3.T2.2.1.7.2" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T2.m15" class="ltx_Math" alttext="pre(a):at(u_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">pre(a):at(u_{i})</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.1.8" class="ltx_tr">
<th id="S3.T2.2.1.8.1" class="ltx_td ltx_align_right ltx_th ltx_th_row"><span id="S3.T2.2.1.8.1.1" class="ltx_text ltx_font_italic">Effect: the app moves to UI <math id="S3.T2.m16" class="ltx_Math" alttext="u_{j}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>j</mi></msub><annotation encoding="application/x-tex">u_{j}</annotation></semantics></math></span></th>
<td id="S3.T2.2.1.8.2" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T2.m17" class="ltx_Math" alttext="eff(a):\lnot at(u_{i})\land at(u_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo rspace="0.167em">¬</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∧</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">eff(a):\lnot at(u_{i})\land at(u_{j})</annotation></semantics></math></td></tr>
<tr id="S3.T2.2.1.9" class="ltx_tr">
<th id="S3.T2.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">A path from <math id="S3.T2.m18" class="ltx_Math" alttext="u_{init}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{init}</annotation></semantics></math> to <math id="S3.T2.m19" class="ltx_Math" alttext="u_{target}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{target}</annotation></semantics></math> via the sequence of action <math id="S3.T2.m20" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math></th>
<td id="S3.T2.2.1.9.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb">A plan <math id="S3.T2.m21" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math></td></tr>
</tbody>
</table>
</span></div>
</figure>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Symbolic and Classical Planning</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Symbolic planning is a long-standing area of AI concerned with finding a sequence of actions to achieve a predefined goal. The most fundamental and widely studied form is <span id="S3.SS2.p1.1.1" class="ltx_text ltx_font_bold">classical planning</span> where a planning problem instance, <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, is formally described as a tuple <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="P=\langle\mathcal{D},s_{init},\mathcal{G}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">P=\langle\mathcal{D},s_{init},\mathcal{G}\rangle</annotation></semantics></math>, where <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="\mathcal{D}=\langle\mathcal{F},\mathcal{A}\rangle" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\langle\mathcal{F},\mathcal{A}\rangle</annotation></semantics></math> is the planning domain. These components are defined as follows:</p>
<ul id="S3.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">States</span>: <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is a set of fluents or predicates that describe the properties of the world. A state <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is a complete assignment of truth values to all fluents in <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>. The set of all possible states is the state space <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Initial States</span>: <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="s_{init}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s_{init}\in\mathcal{S}</annotation></semantics></math> is the initial state of the world.</p>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p"><span id="S3.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Goal<math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext=":\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">:\mathcal{G}</annotation></semantics></math></span> is the goal specification, a set of conditions on states. Any state <math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> that satisfies all conditions in <math id="S3.I1.i3.p1.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is a goal state.</p>
</div></li>
<li id="S3.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i4.p1" class="ltx_para">
<p id="S3.I1.i4.p1.1" class="ltx_p"><span id="S3.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Actions</span>: <math id="S3.I1.i4.p1.m1" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math> is a set of actions. Each action <math id="S3.I1.i4.p1.m2" class="ltx_Math" alttext="a\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><annotation encoding="application/x-tex">a\in\mathcal{A}</annotation></semantics></math> is defined by its preconditions, <math id="S3.I1.i4.p1.m3" class="ltx_Math" alttext="\text{pre}(a)" display="inline" intent=":literal"><semantics><mrow><mtext>pre</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{pre}(a)</annotation></semantics></math>, and its effects, <math id="S3.I1.i4.p1.m4" class="ltx_Math" alttext="\text{eff}(a)" display="inline" intent=":literal"><semantics><mrow><mtext>eff</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{eff}(a)</annotation></semantics></math>. An action can only be executed in a state where its preconditions are met, and its effects describe how the state changes after its execution.</p>
</div></li>
</ul>
<p id="S3.SS2.p1.2" class="ltx_p">A solution, or plan, <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>, is a sequence of actions <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="\langle a_{1},a_{2},\dots,a_{N}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>N</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle a_{1},a_{2},\dots,a_{N}\rangle</annotation></semantics></math> that transforms the initial state <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="s_{init}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">s_{init}</annotation></semantics></math> into a goal state. This is achieved by applying the actions sequentially, where each action <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> is applicable in the state resulting from the execution of <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="a_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">a_{i-1}</annotation></semantics></math>, and the final state after executing <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="a_{N}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>N</mi></msub><annotation encoding="application/x-tex">a_{N}</annotation></semantics></math> satisfies <math id="S3.SS2.p1.m10" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">The Planning Domain Definition Language (PDDL) <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib1" title="" class="ltx_ref">Aeronautiques et al. (1998)</a></cite> is the standard language for representing such planning problems, typically using two files: a domain file defining <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> and <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math>, and a problem file defining <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="s_{init}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">s_{init}</annotation></semantics></math> and <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>UI Automation to Classical Planning</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">The pathfinding problem can be naturally cast into a classical planning problem, allowing us to leverage classical planners to compute the solution, i.e., the shortest path. <a href="#S3.T2" title="Table 2 ‣ 3.1 Problem Definition ‣ 3 Problem Formulation ‣ Agent+P: Guiding UI Agents via Symbolic Planning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Table 2</span></a> illustrates the mapping from the UI automation domain to the classical planning domain, which is elaborated as follows:</p>
<ul id="S3.I2" class="ltx_itemize ltx_leftmargin_flush">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">States</span>: A planning state <math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> corresponds to the app being at a specific UI <math id="S3.I2.i1.p1.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>. We can define a predicate <math id="S3.I2.i1.p1.m3" class="ltx_Math" alttext="at(u)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u)</annotation></semantics></math> which is true if the app is currently on UI <math id="S3.I2.i1.p1.m4" class="ltx_Math" alttext="u\in\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">u\in\mathcal{U}</annotation></semantics></math>. The state space <math id="S3.I2.i1.p1.m5" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> is the set of all possible UIs, <math id="S3.I2.i1.p1.m6" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Initial State</span>: The initial state <math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="s_{init}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">s_{init}</annotation></semantics></math> is defined by the predicate <math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="at(u_{init})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u_{init})</annotation></semantics></math> being true.</p>
</div></li>
<li id="S3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i3.p1" class="ltx_para">
<p id="S3.I2.i3.p1.1" class="ltx_p"><span id="S3.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Goal</span>: The goal <math id="S3.I2.i3.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is specified by the condition that the predicate <math id="S3.I2.i3.p1.m2" class="ltx_Math" alttext="at(u_{target})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u_{target})</annotation></semantics></math> must be true.</p>
</div></li>
<li id="S3.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i4.p1" class="ltx_para">
<p id="S3.I2.i4.p1.1" class="ltx_p"><span id="S3.I2.i4.p1.1.1" class="ltx_text ltx_font_bold">Actions</span>: For each UI transition <math id="S3.I2.i4.p1.m1" class="ltx_Math" alttext="(u_{i},u_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u_{i},u_{j})</annotation></semantics></math> in the UTG triggered by
an action <math id="S3.I2.i4.p1.m2" class="ltx_Math" alttext="a=(w,e)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a=(w,e)</annotation></semantics></math>, we define a planning operator with precondition <math id="S3.I2.i4.p1.m3" class="ltx_Math" alttext="at(u_{i})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u_{i})</annotation></semantics></math>
and effects <math id="S3.I2.i4.p1.m4" class="ltx_Math" alttext="\lnot at(u_{i})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">¬</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lnot at(u_{i})</annotation></semantics></math> and <math id="S3.I2.i4.p1.m5" class="ltx_Math" alttext="at(u_{j})" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">at(u_{j})</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S3.SS3.p1.2" class="ltx_p">Following this formulation, we define a general PDDL domain file template applicable to any targeted UI automation task, as shown in <a href="#LST1" title="Listing 1 ‣ 3.1 Problem Definition ‣ 3 Problem Formulation ‣ Agent+P: Guiding UI Agents via Symbolic Planning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">1</span></a>. Any specific user task, represented by UTG with a specified target UI, <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="u_{target}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{target}</annotation></semantics></math>, can be translated into a corresponding PDDL problem file via this template. For instance, to solve the “Change the time zone” task in the Simple Calendar Pro app, the UTG from <a href="#A1.F3" title="Figure 3 ‣ Appendix A Additional Figures and Tables ‣ Agent+P: Guiding UI Agents via Symbolic Planning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Figure 3</span></a> is converted into the problem file presented in <a href="#LST2" title="Listing 2 ‣ Appendix A Additional Figures and Tables ‣ Agent+P: Guiding UI Agents via Symbolic Planning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">2</span></a>. This symbolic representation allows us to employ a classical planner to efficiently compute a valid and optimal sequence of actions to navigate the app from the initial UI, <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="u_{init}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{init}</annotation></semantics></math>, to the target, <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="u_{target}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">u_{target}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span><span id="S4.2" class="ltx_text ltx_font_smallcaps">Agent+P</span></h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">Algorithm <a href="#algorithm1" title="In 4.1 UTG Builder ‣ 4 Agent+P ‣ Agent+P: Guiding UI Agents via Symbolic Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> shows the workflow of <span id="S4.p1.1.1" class="ltx_text ltx_font_smallcaps">Agent+P</span>.
Given a natural language goal specified by the user, <span id="S4.p1.1.2" class="ltx_text ltx_font_smallcaps">Agent+P</span> operates through four primary modules that interact in a continuous loop until the goal is achieved: the <span id="S4.p1.1.3" class="ltx_text ltx_font_bold">UTG Builder</span>, the <span id="S4.p1.1.4" class="ltx_text ltx_font_bold">Node Selector</span>, the <span id="S4.p1.1.5" class="ltx_text ltx_font_bold">Plan Generator</span>, and the <span id="S4.p1.1.6" class="ltx_text ltx_font_bold">UI Explorer</span>.
In the following subsections, we elaborate on the design rationale and functionality of each module.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>UTG Builder</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Existing methods for constructing a UTG rely on either dynamic analysis <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib30" title="" class="ltx_ref">Wen et al. (2024)</a>; <a href="#bib.bib26" title="" class="ltx_ref">Sun et al. (2025)</a></cite>, which is accurate but often suffers from high cost and incomplete coverage, or static analysis <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib4" title="" class="ltx_ref">Azim and Neamtiu (2013)</a>; <a href="#bib.bib35" title="" class="ltx_ref">Yang et al. (2018)</a></cite>, which is more comprehensive but can introduce infeasible transitions <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib16" title="" class="ltx_ref">Liu et al. (2022)</a></cite>.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">To overcome these limitations, <span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_smallcaps">Agent+P</span> utilizes a hybrid approach that synergizes both techniques to build UTG. <span id="S4.SS1.p2.1.2" class="ltx_text ltx_font_smallcaps">Agent+P</span> begins by performing static analysis to construct an initial UTG (Line 1 of Algorithm <a href="#algorithm1" title="In 4.1 UTG Builder ‣ 4 Agent+P ‣ Agent+P: Guiding UI Agents via Symbolic Planning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), following established practices that track API calls responsible for UI transitions in the app’s source code <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib35" title="" class="ltx_ref">Yang et al. (2018)</a>; <a href="#bib.bib16" title="" class="ltx_ref">Liu et al. (2022)</a></cite>.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">This initial UTG is then dynamically verified and refined as the UI Explorer explores the app (Line 10 and Line 16).
Specifically, let the current UTG be <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="G=(\mathcal{U},\mathcal{T},\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(\mathcal{U},\mathcal{T},\epsilon)</annotation></semantics></math>. During UI automation, an observed transition <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="(u_{i},a_{obs},u_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>a</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u_{i},a_{obs},u_{j})</annotation></semantics></math>, where <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="u_{i}\in\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">u_{i}\in\mathcal{U}</annotation></semantics></math>, updates the graph to <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="G^{\prime}=(\mathcal{U}^{\prime},\mathcal{T}^{\prime},\epsilon^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>′</mo></msup><mo>,</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}=(\mathcal{U}^{\prime},\mathcal{T}^{\prime},\epsilon^{\prime})</annotation></semantics></math> in one of three ways:</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<ul id="S4.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Update Edge:</span> An action leads from an existing source node to a target node, but the recorded action does not match the corresponding one in the UTG. Formally, if <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="(u_{i},u_{j})\in\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">(u_{i},u_{j})\in\mathcal{T}</annotation></semantics></math> and <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="\epsilon((u_{i},u_{j}))\neq a_{obs}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><msub><mi>a</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\epsilon((u_{i},u_{j}))\neq a_{obs}</annotation></semantics></math>, the labeling function is updated such that <math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="\epsilon^{\prime}((u_{i},u_{j}))=a_{obs}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϵ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>a</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\epsilon^{\prime}((u_{i},u_{j}))=a_{obs}</annotation></semantics></math>, while <math id="S4.I1.i1.p1.m4" class="ltx_Math" alttext="\mathcal{U}^{\prime}=\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>′</mo></msup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">\mathcal{U}^{\prime}=\mathcal{U}</annotation></semantics></math> and <math id="S4.I1.i1.p1.m5" class="ltx_Math" alttext="\mathcal{T}^{\prime}=\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>′</mo></msup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}^{\prime}=\mathcal{T}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Add Edge:</span> An action connects two existing UI nodes, but no corresponding edge exists in the UTG. This occurs when <math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="u_{j}\in\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">u_{j}\in\mathcal{U}</annotation></semantics></math> and <math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="(u_{i},u_{j})\notin\mathcal{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo>∉</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow><annotation encoding="application/x-tex">(u_{i},u_{j})\notin\mathcal{T}</annotation></semantics></math>. A new transition is added by setting <math id="S4.I1.i2.p1.m3" class="ltx_Math" alttext="\mathcal{T}^{\prime}=\mathcal{T}\cup\{(u_{i},u_{j})\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>′</mo></msup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}^{\prime}=\mathcal{T}\cup\{(u_{i},u_{j})\}</annotation></semantics></math> and extending <math id="S4.I1.i2.p1.m4" class="ltx_Math" alttext="\epsilon^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\epsilon^{\prime}</annotation></semantics></math> with <math id="S4.I1.i2.p1.m5" class="ltx_Math" alttext="\epsilon^{\prime}((u_{i},u_{j}))=a_{obs}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϵ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>a</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\epsilon^{\prime}((u_{i},u_{j}))=a_{obs}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p"><span id="S4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Add Node:</span> An action leads to a UI that is not yet in the UTG. If <math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="u_{j}\notin\mathcal{U}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>∉</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">u_{j}\notin\mathcal{U}</annotation></semantics></math>, a new node and edge are added to the graph: <math id="S4.I1.i3.p1.m2" class="ltx_Math" alttext="\mathcal{U}^{\prime}=\mathcal{U}\cup\{u_{j}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>′</mo></msup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}^{\prime}=\mathcal{U}\cup\{u_{j}\}</annotation></semantics></math>, <math id="S4.I1.i3.p1.m3" class="ltx_Math" alttext="\mathcal{T}^{\prime}=\mathcal{T}\cup\{(u_{i},u_{j})\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>′</mo></msup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}^{\prime}=\mathcal{T}\cup\{(u_{i},u_{j})\}</annotation></semantics></math>, and <math id="S4.I1.i3.p1.m4" class="ltx_Math" alttext="\epsilon^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ϵ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\epsilon^{\prime}</annotation></semantics></math> is extended with <math id="S4.I1.i3.p1.m5" class="ltx_Math" alttext="\epsilon^{\prime}((u_{i},u_{j}))=a_{obs}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ϵ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>a</mi><mrow><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\epsilon^{\prime}((u_{i},u_{j}))=a_{obs}</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p">This approach allows <span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_smallcaps">Agent+P</span> to maintain a UTG that is both comprehensive and dynamically accurate, combining the breadth of static analysis with the precision of real-time exploration.</p>
</div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.4" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Workflow of <span id="algorithm1.5" class="ltx_text ltx_font_smallcaps">Agent+P</span> </figcaption>
<div id="algorithm1.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.6.1" class="ltx_listingline"><span id="algorithm1.6.1.1" class="ltx_text"><span id="algorithm1.6.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Natural language goal <math id="algorithm1.m1" class="ltx_Math" alttext="g_{nl}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">g_{nl}</annotation></semantics></math>, App <math id="algorithm1.m2" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math>, Max running steps <math id="algorithm1.m3" class="ltx_Math" alttext="maxStep" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">maxStep</annotation></semantics></math>
</div>
<div id="algorithm1.6.2" class="ltx_listingline"><span id="algorithm1.6.2.1" class="ltx_text"><span id="algorithm1.6.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Automation outcome: <span id="algorithm1.6.2.2" class="ltx_text ltx_font_italic">Success</span> or <span id="algorithm1.6.2.3" class="ltx_text ltx_font_italic">Failure</span>
</div>
<div id="algorithm1.6.3" class="ltx_listingline"><span id="algorithm1.6.3.1" class="ltx_text ltx_font_italic">Aliases: <span id="algorithm1.6.3.1.1" class="ltx_text ltx_font_bold">UB</span> <math id="algorithm1.m4" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> UtgBuilder; <span id="algorithm1.6.3.1.2" class="ltx_text ltx_font_bold">NS</span> <math id="algorithm1.m5" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> NodeSelector; <span id="algorithm1.6.3.1.3" class="ltx_text ltx_font_bold">PG</span> <math id="algorithm1.m6" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> PlanGenerator; <span id="algorithm1.6.3.1.4" class="ltx_text ltx_font_bold">UE</span> <math id="algorithm1.m7" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> UiExplorer</span>

</div>
<div id="algorithm1.6.4" class="ltx_listingline"><math id="algorithm1.m8" class="ltx_Math" alttext="G\leftarrow\text{UB.buildStaticUTG}(\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">←</mo><mrow><mtext>UB.buildStaticUTG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\leftarrow\text{UB.buildStaticUTG}(\mathcal{A})</annotation></semantics></math>;
</div>
<div id="algorithm1.6.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.5.1" class="ltx_text ltx_font_bold">1</span></span>
            <math id="algorithm1.m9" class="ltx_Math" alttext="u_{cur}\leftarrow\text{getCurrentUI}(\mathcal{A})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>getCurrentUI</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{cur}\leftarrow\text{getCurrentUI}(\mathcal{A})</annotation></semantics></math>;
</div>
<div id="algorithm1.6.6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.6.1" class="ltx_text ltx_font_bold">2</span></span>
            <math id="algorithm1.m10" class="ltx_Math" alttext="steps\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">steps\leftarrow 0</annotation></semantics></math>;
</div>
<div id="algorithm1.6.7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.7.1" class="ltx_text ltx_font_bold">3</span></span>
            <span id="algorithm1.6.7.2" class="ltx_text ltx_font_bold">while</span> <em id="algorithm1.6.7.3" class="ltx_emph ltx_font_italic"> <math id="algorithm1.m11" class="ltx_Math" alttext="steps\leq maxStep" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>≤</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">steps\leq maxStep</annotation></semantics></math></em> <span id="algorithm1.6.7.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.6.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.8.1" class="ltx_text ltx_font_bold">4</span></span>
            <math id="algorithm1.m12" class="ltx_Math" alttext="u_{target}\leftarrow\text{NS.selectTargetNode}(g_{nl},G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>NS.selectTargetNode</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{target}\leftarrow\text{NS.selectTargetNode}(g_{nl},G)</annotation></semantics></math>;
</div>
<div id="algorithm1.6.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.9.1" class="ltx_text ltx_font_bold">5</span></span>
