            <span id="algorithm1.6.21.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.6.21.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m25" class="ltx_Math" alttext="\text{UE.evaluate}(g_{nl})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">UE.evaluate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{UE.evaluate}(g_{nl})</annotation></semantics></math>)</em> <span id="algorithm1.6.21.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.6.22" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
