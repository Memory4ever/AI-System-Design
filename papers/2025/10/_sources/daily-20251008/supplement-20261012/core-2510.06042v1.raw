<tr id="S5.T4.2.1.3" class="ltx_tr">
<td id="S5.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_border_bb">w/o <span id="S5.T4.2.1.3.1.1" class="ltx_text ltx_font_smallcaps">Agent+P</span></td>
<td id="S5.T4.2.1.3.2" class="ltx_td ltx_align_left ltx_border_bb">0.60</td>
<td id="S5.T4.2.1.3.3" class="ltx_td ltx_align_left ltx_border_bb">6.10</td>
