<th id="S5.T1.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">AdamW</th>
<td id="S5.T1.2.5.2" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S5.T1.2.5.2.1" class="ltx_text ltx_font_bold">77.8</span></td>
<td id="S5.T1.2.5.3" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;">61.8</td>
