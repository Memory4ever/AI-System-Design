<tr id="S5.T1.2.6" class="ltx_tr">
<th id="S5.T1.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S5.T1.2.6.1.1" class="ltx_text ltx_font_bold">REG(ours)</span></th>
