<td id="S5.T5.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">10.0</td>
<td id="S5.T5.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">49.8</td></tr>
<tr id="S5.T5.2.3" class="ltx_tr">
<th id="S5.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S5.T5.m2" class="ltx_Math" alttext="p=2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p=2</annotation></semantics></math></th>
