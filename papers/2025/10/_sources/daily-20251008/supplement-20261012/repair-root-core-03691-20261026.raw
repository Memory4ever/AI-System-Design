<td id="S5.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">21.9</td></tr>
<tr id="S5.T1.2.3" class="ltx_tr">
<th id="S5.T1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">Muon</th>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;">49.1</td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;">58.6</td>
<td id="S5.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">10.0</td>
<td id="S5.T1.2.3.5" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;">39.2</td></tr>
<tr id="S5.T1.2.4" class="ltx_tr">
<th id="S5.T1.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">NGD</th>
<td id="S5.T1.2.4.2" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;">70.1</td>
