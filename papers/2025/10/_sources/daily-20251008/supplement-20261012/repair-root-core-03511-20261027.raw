<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Table 1: </span>CIFAR-10 Accuracy (%).</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S5.T2" class="ltx_figure ltx_figure_panel ltx_align_center ltx_align_middle" style="width:178.9pt;">
<div id="S5.T2.1" class="ltx_inline-block ltx_figure_panel ltx_align_center ltx_transformed_outer" style="width:152.0pt;height:53.8pt;vertical-align:-25.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-27.4pt,9.7pt) scale(0.734773890335729,0.734773890335729) ;">
<table id="S5.T2.1.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T2.1.1.1" class="ltx_tr">
<td id="S5.T2.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S5.T2.1.1.1.1.1" class="ltx_text ltx_font_bold">Group</span></td>
<td id="S5.T2.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.1.1.1.2.1" class="ltx_text ltx_font_bold">Attention</span></td>
<td id="S5.T2.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T2.1.1.1.3.1" class="ltx_text ltx_font_bold">Conv</span></td></tr>
<tr id="S5.T2.1.1.2" class="ltx_tr">
<td id="S5.T2.1.1.2.1" class="ltx_td"></td>
