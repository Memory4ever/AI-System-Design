<section id="A1.SSx1.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">System Prompt and Tool Schema of the Planner-Agent</h4>

<div id="A1.SSx1.SSSx1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SSx1.SSSx1.p1.pic1" class="ltx_picture" height="63.38" overflow="visible" version="1.1" viewBox="0 0 700 63.38" width="700"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,63.38) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 57.48 C 0 60.74 2.64 63.38 5.91 63.38 L 694.09 63.38 C 697.36 63.38 700 60.74 700 57.48 L 700 5.91 C 700 2.64 697.36 0 694.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 39.43 L 698.03 39.43 L 698.03 5.91 C 698.03 3.73 696.27 1.97 694.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 48.02)"><foreignObject style="--ltx-fo-width:47.46em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="656.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SSx1.SSSx1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:47.46em;">
