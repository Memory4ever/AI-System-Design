<td id="S1.T1.5.15.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.15.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.15.2.1.1" class="ltx_p">Standard projection matrices (<math id="S1.T1.m19" class="ltx_Math" alttext="E\!\times\!E" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.052em" rspace="0.052em">×</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">E\!\times\!E</annotation></semantics></math>)</span>
</span></td></tr>
<tr id="S1.T1.5.16" class="ltx_tr">
<th id="S1.T1.5.16.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m20" class="ltx_Math" alttext="\tilde{W}_{Q},\tilde{W}_{K},\tilde{W}_{V}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>W</mi><mo>~</mo></mover><mi>Q</mi></msub><mo>,</mo><msub><mover accent="true"><mi>W</mi><mo>~</mo></mover><mi>K</mi></msub><mo>,</mo><msub><mover accent="true"><mi>W</mi><mo>~</mo></mover><mi>V</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{W}_{Q},\tilde{W}_{K},\tilde{W}_{V}</annotation></semantics></math></th>
<td id="S1.T1.5.16.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.16.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.16.2.1.1" class="ltx_p">Down-projections to latent space (<math id="S1.T1.m21" class="ltx_Math" alttext="E\!\times\!\tilde{e}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.052em" rspace="0.052em">×</mo><mover accent="true"><mi>e</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">E\!\times\!\tilde{e}</annotation></semantics></math>)</span>
</span></td></tr>
<tr id="S1.T1.5.17" class="ltx_tr">
<th id="S1.T1.5.17.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m22" class="ltx_Math" alttext="C_{KV}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow></msub><annotation encoding="application/x-tex">C_{KV}</annotation></semantics></math></th>
<td id="S1.T1.5.17.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.17.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.17.2.1.1" class="ltx_p">Shared compressed key-value cache</span>
</span></td></tr>
<tr id="S1.T1.5.18" class="ltx_tr">
<th id="S1.T1.5.18.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m23" class="ltx_Math" alttext="C_{Q}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">C_{Q}</annotation></semantics></math></th>
<td id="S1.T1.5.18.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.18.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.18.2.1.1" class="ltx_p">Compressed query latent</span>
</span></td></tr>
<tr id="S1.T1.5.19" class="ltx_tr">
<th id="S1.T1.5.19.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m24" class="ltx_Math" alttext="\tilde{q},\tilde{k},\tilde{v}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>q</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>k</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>v</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{q},\tilde{k},\tilde{v}</annotation></semantics></math></th>
<td id="S1.T1.5.19.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.19.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.19.2.1.1" class="ltx_p">Compressed query, key, and value tensors</span>
</span></td></tr>
<tr id="S1.T1.5.20" class="ltx_tr">
<th id="S1.T1.5.20.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m25" class="ltx_Math" alttext="o_{h}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mi>h</mi></msub><annotation encoding="application/x-tex">o_{h}</annotation></semantics></math></th>
<td id="S1.T1.5.20.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.20.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.20.2.1.1" class="ltx_p">Output of attention head <math id="S1.T1.m26" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math></span>
</span></td></tr>
<tr id="S1.T1.5.21" class="ltx_tr">
<th id="S1.T1.5.21.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m27" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></th>
<td id="S1.T1.5.21.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.21.2.1" class="ltx_inline-block ltx_align_top">
