<th id="S1.T1.5.13.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m15" class="ltx_Math" alttext="d_{h}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>h</mi></msub><annotation encoding="application/x-tex">d_{h}</annotation></semantics></math></th>
