<span id="S1.T1.5.6.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.6.2.1.1" class="ltx_p">Per-head dimension (<math id="S1.T1.m6" class="ltx_Math" alttext="d=E/n_{h}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>E</mi><mo>/</mo><msub><mi>n</mi><mi>h</mi></msub></mrow></mrow><annotation encoding="application/x-tex">d=E/n_{h}</annotation></semantics></math>)</span>
</span></td></tr>
<tr id="S1.T1.5.7" class="ltx_tr">
<th id="S1.T1.5.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math></th>
<td id="S1.T1.5.7.2" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;">
<span id="S1.T1.5.7.2.1" class="ltx_inline-block ltx_align_top">
<span id="S1.T1.5.7.2.1.1" class="ltx_p">Number of groups in GQA</span>
</span></td></tr>
<tr id="S1.T1.5.8" class="ltx_tr">
<th id="S1.T1.5.8.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math></th>
