<th id="S1.T1.5.12.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m13" class="ltx_Math" alttext="\tilde{e}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>e</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{e}</annotation></semantics></math></th>
