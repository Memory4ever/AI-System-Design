<th id="S1.T1.5.11.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m12" class="ltx_Math" alttext="c_{kv}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">c_{kv}</annotation></semantics></math></th>
