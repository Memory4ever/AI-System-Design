<tr id="S3.T4.3.4" class="ltx_tr">
<td id="S3.T4.3.4.1" class="ltx_td ltx_align_center ltx_border_l" style="padding-top:1pt;padding-bottom:1pt;">1</td>
<td id="S3.T4.3.4.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">✕</td>
