<th id="S1.T1.5.9.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 2.0pt;padding-top:1pt;padding-bottom:1pt;"><math id="S1.T1.m10" class="ltx_Math" alttext="C_{1},\,C_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">C_{1},\,C_{2}</annotation></semantics></math></th>
