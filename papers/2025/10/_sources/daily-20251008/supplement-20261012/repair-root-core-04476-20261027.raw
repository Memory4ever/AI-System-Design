<th id="S2.T3.3.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">2.286</th>
<td id="S2.T3.3.7.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:1pt;padding-bottom:1pt;">59.6</td>
