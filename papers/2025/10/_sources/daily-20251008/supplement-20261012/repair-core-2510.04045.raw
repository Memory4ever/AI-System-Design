<tr id="S4.T3.2.6" class="ltx_tr">
<td id="S4.T3.2.6.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">Llama 3 8B RLVR</td>
<td id="S4.T3.2.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">77.3</td>
<td id="S4.T3.2.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">70.3</td></tr>
</tbody>
</table>
