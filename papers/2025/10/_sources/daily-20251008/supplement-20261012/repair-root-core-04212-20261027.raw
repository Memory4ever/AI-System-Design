               Compute <math id="alg3.l9.m1" class="ltx_Math" alttext="{\mathbf{P}}_{i}^{(j)}=\exp({\mathbf{S}}_{ij}-{\mathbf{L}}_{i})\in\mathbb{R}^{B_{r}\times B_{c}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐏</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐒</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mi>𝐋</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><mi>c</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{P}}_{i}^{(j)}=\exp({\mathbf{S}}_{ij}-{\mathbf{L}}_{i})\in\mathbb{R}^{B_{r}\times B_{c}}</annotation></semantics></math>.

</div>
<div id="alg3.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
               Compute
<math id="alg3.l10.m1" class="ltx_Math" alttext="d{\mathbf{V}}_{j}\leftarrow d{\mathbf{V}}_{j}+({\mathbf{P}}_{i}^{(j)})^{\top}d{\mathbf{O}}_{i}\in\mathbb{R}^{B_{c}\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mi>j</mi></msub></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐏</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎</mi><mi>i</mi></msub></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>B</mi><mi>c</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">d{\mathbf{V}}_{j}\leftarrow d{\mathbf{V}}_{j}+({\mathbf{P}}_{i}^{(j)})^{\top}d{\mathbf{O}}_{i}\in\mathbb{R}^{B_{c}\times d}</annotation></semantics></math>.

</div>
<div id="alg3.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
               Compute
<math id="alg3.l11.m1" class="ltx_Math" alttext="d{\mathbf{P}}_{i}^{(j)}=d{\mathbf{O}}_{i}{\mathbf{V}}_{j}^{\top}\in\mathbb{R}^{B_{r}\times B_{c}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐏</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐕</mi><mi>j</mi><mo>⊤</mo></msubsup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><mi>c</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">d{\mathbf{P}}_{i}^{(j)}=d{\mathbf{O}}_{i}{\mathbf{V}}_{j}^{\top}\in\mathbb{R}^{B_{r}\times B_{c}}</annotation></semantics></math>.

</div>
<div id="alg3.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
               Compute <math id="alg3.l12.m1" class="ltx_Math" alttext="d{\mathbf{S}}_{i}^{(j)}={\mathbf{P}}_{i}^{(j)}\circ(d{\mathbf{P}}_{i}^{(j)}-{\bm{\delta}}_{i})\in\mathbb{R}^{B_{r}\times B_{c}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐒</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><msubsup><mi>𝐏</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐏</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>−</mo><msub><mi>𝜹</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><mi>c</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">d{\mathbf{S}}_{i}^{(j)}={\mathbf{P}}_{i}^{(j)}\circ(d{\mathbf{P}}_{i}^{(j)}-{\bm{\delta}}_{i})\in\mathbb{R}^{B_{r}\times B_{c}}</annotation></semantics></math>.

</div>
<div id="alg3.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
               Update <math id="alg3.l13.m1" class="ltx_Math" alttext="d{\mathbf{Q}}_{i}\leftarrow d{\mathbf{Q}}_{i}+d{\mathbf{S}}_{i}^{(j)}{\mathbf{K}}_{j}\in\mathbb{R}^{B_{r}\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mi>i</mi></msub></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐒</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐊</mi><mi>j</mi></msub></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">d{\mathbf{Q}}_{i}\leftarrow d{\mathbf{Q}}_{i}+d{\mathbf{S}}_{i}^{(j)}{\mathbf{K}}_{j}\in\mathbb{R}^{B_{r}\times d}</annotation></semantics></math>.

</div>
<div id="alg3.l14" class="ltx_listingline">
