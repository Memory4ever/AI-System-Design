<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
             Initialize <math id="alg3.l3.m1" class="ltx_Math" alttext="d{\mathbf{Q}}=(0)_{N\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐐</mi></mrow><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d{\mathbf{Q}}=(0)_{N\times d}</annotation></semantics></math> and divide it into <math id="alg3.l3.m2" class="ltx_Math" alttext="T_{r}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>r</mi></msub><annotation encoding="application/x-tex">T_{r}</annotation></semantics></math> blocks <math id="alg3.l3.m3" class="ltx_Math" alttext="d{\mathbf{Q}}_{1},\dots,d{\mathbf{Q}}_{T_{r}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐐</mi><msub><mi>T</mi><mi>r</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">d{\mathbf{Q}}_{1},\dots,d{\mathbf{Q}}_{T_{r}}</annotation></semantics></math> of size <math id="alg3.l3.m4" class="ltx_Math" alttext="B_{r}\times d" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">B_{r}\times d</annotation></semantics></math> each.
Divide <math id="alg3.l3.m5" class="ltx_Math" alttext="d{\mathbf{K}},d{\mathbf{V}}\in\mathbb{R}^{N\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐊</mi></mrow><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">d{\mathbf{K}},d{\mathbf{V}}\in\mathbb{R}^{N\times d}</annotation></semantics></math> in to <math id="alg3.l3.m6" class="ltx_Math" alttext="T_{c}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>c</mi></msub><annotation encoding="application/x-tex">T_{c}</annotation></semantics></math> blocks <math id="alg3.l3.m7" class="ltx_Math" alttext="d{\mathbf{K}}_{1},\dots,d{\mathbf{K}}_{T_{c}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐊</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐊</mi><msub><mi>T</mi><mi>c</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">d{\mathbf{K}}_{1},\dots,d{\mathbf{K}}_{T_{c}}</annotation></semantics></math> and
<math id="alg3.l3.m8" class="ltx_Math" alttext="d{\mathbf{V}}_{1},\dots,d{\mathbf{V}}_{T_{c}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><msub><mi>T</mi><mi>c</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">d{\mathbf{V}}_{1},\dots,d{\mathbf{V}}_{T_{c}}</annotation></semantics></math>, of size <math id="alg3.l3.m9" class="ltx_Math" alttext="B_{c}\times d" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>c</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">B_{c}\times d</annotation></semantics></math> each.

