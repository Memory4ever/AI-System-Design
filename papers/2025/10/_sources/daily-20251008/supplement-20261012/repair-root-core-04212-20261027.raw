<div id="alg3.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
               Compute <math id="alg3.l8.m1" class="ltx_Math" alttext="{\mathbf{S}}_{i}^{(j)}={\mathbf{Q}}_{i}{\mathbf{K}}_{j}^{T}\in\mathbb{R}^{B_{r}\times B_{c}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐒</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msub><mi>𝐐</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐊</mi><mi>j</mi><mi>T</mi></msubsup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><mi>c</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbf{S}}_{i}^{(j)}={\mathbf{Q}}_{i}{\mathbf{K}}_{j}^{T}\in\mathbb{R}^{B_{r}\times B_{c}}</annotation></semantics></math>.

</div>
<div id="alg3.l9" class="ltx_listingline">
