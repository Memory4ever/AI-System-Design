<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex3.m4" class="ltx_Math" alttext="\displaystyle{\color[rgb]{0,1,0}\mathtt{1}}" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">𝟷</mn><annotation encoding="application/x-tex">\displaystyle{\color[rgb]{0,1,0}\mathtt{1}}</annotation></semantics></math></span>
