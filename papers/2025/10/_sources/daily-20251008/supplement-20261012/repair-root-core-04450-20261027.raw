<td id="A3.T5.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T5.2.1.1.2.1" class="ltx_text ltx_font_bold">FID</span> <math id="A3.T5.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A3.T5.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T5.2.1.1.3.1" class="ltx_text ltx_font_bold">IS</span> <math id="A3.T5.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
