<td id="A3.T5.2.1.3.1" class="ltx_td ltx_align_left">DE@14</td>
<td id="A3.T5.2.1.3.2" class="ltx_td ltx_align_center">20.17</td>
<td id="A3.T5.2.1.3.3" class="ltx_td ltx_align_center">60.8</td></tr>
