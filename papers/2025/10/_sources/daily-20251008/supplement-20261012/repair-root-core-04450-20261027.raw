<td id="A3.T5.2.1.4.1" class="ltx_td ltx_align_left">DE@15</td>
<td id="A3.T5.2.1.4.2" class="ltx_td ltx_align_center">20.03</td>
<td id="A3.T5.2.1.4.3" class="ltx_td ltx_align_center">61.0</td></tr>
