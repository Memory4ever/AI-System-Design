<td id="S5.T2.2.6.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t"><span id="S5.T2.2.6.2.1" class="ltx_text ltx_font_bold">1.419</span></td>
<td id="S5.T2.2.6.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_t"><span id="S5.T2.2.6.3.1" class="ltx_text ltx_font_bold">0.152</span></td></tr>
