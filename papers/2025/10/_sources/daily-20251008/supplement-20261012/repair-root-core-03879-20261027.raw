<td id="S4.T1.st1.2.8.3" class="ltx_td ltx_align_right ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T1.st1.2.8.3.1" class="ltx_text ltx_font_bold">74</span></td>
<td id="S4.T1.st1.2.8.4" class="ltx_td ltx_align_right ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T1.st1.2.8.4.1" class="ltx_text ltx_font_bold">89%</span></td></tr>
</tbody>
</table>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
