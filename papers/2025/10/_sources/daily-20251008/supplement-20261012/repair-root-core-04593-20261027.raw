<td id="Sx4.T1.3.20.2" class="ltx_td ltx_align_center" style="padding:3.5pt 5.0pt;"><math id="Sx4.T1.m28" class="ltx_Math" alttext="0.15" display="inline" intent=":literal"><semantics><mn>0.15</mn><annotation encoding="application/x-tex">0.15</annotation></semantics></math>B</td>
