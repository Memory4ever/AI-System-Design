<td id="Sx4.T1.3.21.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:3.5pt 5.0pt;"><math id="Sx4.T1.m29" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn>0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math>B</td>
