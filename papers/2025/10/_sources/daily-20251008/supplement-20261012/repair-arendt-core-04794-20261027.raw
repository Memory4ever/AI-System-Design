<td id="S3.T1.12.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.12.4.1.1" class="ltx_text" style="font-size:70%;">EfficientNetV2-M <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite></span></td>
<td id="S3.T1.12.4.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.12.4.2.1" class="ltx_text" style="font-size:70%;">54.1M</span></td>
<td id="S3.T1.12.4.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.12.4.3.1" class="ltx_text" style="font-size:70%;">ImageNet1k</span></td>
<td id="S3.T1.12.4.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.12.4.4.1" class="ltx_text" style="font-size:70%;">Classification</span></td></tr>
