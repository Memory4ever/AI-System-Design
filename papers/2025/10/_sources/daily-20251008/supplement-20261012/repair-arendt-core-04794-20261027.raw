</div></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="A3.F8.4" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:165.6pt;"><img src="2510.04794v1/FlyingThings_Right.png" id="A3.F8.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/129;" width="229" height="129" alt="Refer to caption">
