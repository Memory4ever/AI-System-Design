<td id="S3.T1.12.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.12.3.3.1" class="ltx_text" style="font-size:70%;">ImageNet1k</span></td>
