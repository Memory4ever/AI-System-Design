<td id="S3.F6.pic1.1.3.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding-bottom: 6.0pt;padding-left:1.0pt;padding-right:1.0pt;"><math id="S3.F6.pic1.m16" class="ltx_Math" alttext="=b_{1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">=</mo><msub><mi mathsize="0.900em">b</mi><mn mathsize="0.900em">1</mn></msub></mrow><annotation encoding="application/x-tex">=b_{1}</annotation></semantics></math></td></tr>
<tr id="S3.F6.pic1.1.4" class="ltx_tr">
