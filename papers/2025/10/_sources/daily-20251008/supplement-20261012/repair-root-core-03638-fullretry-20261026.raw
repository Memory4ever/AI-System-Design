-depth:0.19em;font-size:10pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="7.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F1.pic1.m44" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 8.27 -22.03)"><foreignObject style="--ltx-fo-width:7.62em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="89.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.2" class="ltx_text" style="font-size:80%;">Fixed-point map <math id="S2.F1.pic1.m45" class="ltx_Math" alttext="y_{\ast}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y_{\ast}(x)</annotation></semantics></math></span></span></span></foreignObject></g></g></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F1.4" class="ltx_text" style="font-size:90%;">Figure 1</span>. </span><span id="S2.F1.5" class="ltx_text" style="font-size:90%;">(Conceptual diagram) A simple implicit update expresses a complex map via iteration.</span></figcaption>
</figure>
<div id="S2.p14" class="ltx_para">
<p id="S2.p14.1" class="ltx_p"><span id="S2.p14.1.1" class="ltx_text ltx_font_bold">Generalization.</span> Someone may ask: does a large Lipschitz constant of the fixed-point map <math id="S2.p14.m1" class="ltx_Math" alttext="{\bm{y}}_{\ast}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{\ast}({\bm{x}})</annotation></semantics></math> imply sensitivity or poor generalization (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib71" title="" class="ltx_ref">71</a>]</cite>)? Our view is that this sensitivity is <em id="S2.p14.1.2" class="ltx_emph ltx_font_italic">inherent to the target</em> <math id="S2.p14.m2" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math>, not to the implicit representation—any faithful model, explicit or implicit, must track <math id="S2.p14.m3" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math>’s sharp variations. Our case studies in Section <a href="#S3" title="3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> confirm this: the target <math id="S2.p14.m4" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> in many tasks is indeed steep somewhere and the effective Lipschitz growth as accuracy improves. Crucially, the implicit formulation can realize such targets with a <span id="S2.p14.1.3" class="ltx_text ltx_font_italic">simple</span> operator <math id="S2.p14.m5" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math>, which regularizes training and supports good generalization in practice.</p>
</div>
<div id="S2.p15" class="ltx_para">
<p id="S2.p15.1" class="ltx_p"><span id="S2.p15.1.1" class="ltx_text ltx_font_bold">Insights for practitioners.</span> A substantial line of work (e.g., <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>, <a href="#bib.bib95" title="" class="ltx_ref">95</a>, <a href="#bib.bib45" title="" class="ltx_ref">45</a>, <a href="#bib.bib80" title="" class="ltx_ref">80</a>, <a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite>) enforces a global Lipschitz bound on the fixed-point map <math id="S2.p15.m1" class="ltx_Math" alttext="{\bm{y}}_{\ast}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{\ast}({\bm{x}})</annotation></semantics></math>. Typically, the model is parameterized as <math id="S2.p15.m2" class="ltx_Math" alttext="{\mathcal{G}}({\bm{y}},{\bm{x}})=\sigma({\bm{A}}{\bm{y}}+{\bm{B}}{\bm{x}}+{\bm{b}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow><mo>+</mo><mrow><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><mo>+</mo><mi>𝒃</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}({\bm{y}},{\bm{x}})=\sigma({\bm{A}}{\bm{y}}+{\bm{B}}{\bm{x}}+{\bm{b}})</annotation></semantics></math>, and by imposing specific algebraic structure on <math id="S2.p15.m3" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> and <math id="S2.p15.m4" class="ltx_Math" alttext="{\bm{B}}" display="inline" intent=":literal"><semantics><mi>𝑩</mi><annotation encoding="application/x-tex">{\bm{B}}</annotation></semantics></math>,
one ensures that <math id="S2.p15.m5" class="ltx_Math" alttext="{\bm{y}}_{\ast}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{\ast}({\bm{x}})</annotation></semantics></math> is globally Lipschitz in <math id="S2.p15.m6" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math>. While this indeed improves robustness, our theory shows it <span id="S2.p15.1.2" class="ltx_text ltx_font_bold">constrains expressivity and undercuts the unique advantage of implicit models</span>. Our recommendation is different: rather than imposing uniform Lipschitz constraints, incorporate case-by-case <span id="S2.p15.1.3" class="ltx_text ltx_font_italic">domain-specific knowledge, priors, or constraints</span> (as illustrated in our case studies Sec. <a href="#S3" title="3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). This method provides effective regularization, leading to robustness and strong test performance while unlocking the full power of implicit models—representing complex maps with relatively simple operators.</p>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Case Studies</h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">In this section, we present three case studies. For each task, we (i) show that the target map satisfies Assumption <a href="#S2.Thmtheorem2" title="Assumption 2.2. ‣ 2. Main Results ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>, bringing it under our theory; (ii) specify a <math id="S3.p1.m1" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> architecture infused with domain priors or constraints; (iii) verify—without any explicit Lipschitz control, using only vanilla training—that the learned <math id="S3.p1.m2" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> is regular (i.e., <math id="S3.p1.m3" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> is Lipschitz in <math id="S3.p1.m4" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> with a modest constant and the iterates converge <math id="S3.p1.m5" class="ltx_Math" alttext="{\bm{y}}_{t}({\bm{x}})\to{\mathcal{F}}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t}({\bm{x}})\to{\mathcal{F}}({\bm{x}})</annotation></semantics></math>; and (iv) test whether increasing test-time iterations enables <math id="S3.p1.m6" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> to realize progressively more complex mappings.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1. </span>Case Study 1: Image Reconstruction (Inverse problems)</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Inverse problems in imaging seek to recover an image <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="{\bm{y}}_{\ast}\in{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mo>∗</mo></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{y}}_{\ast}\in{\mathbb{R}}^{n}</annotation></semantics></math> from partial, noisy measurements <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="{\bm{x}}={\bm{A}}{\bm{y}}_{\ast}+{\bm{n}}\in{\mathbb{R}}^{d}~(d&lt;n)" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>=</mo><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒚</mi><mo>∗</mo></msub></mrow><mo>+</mo><mi>𝒏</mi></mrow><mo>∈</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>&lt;</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}={\bm{A}}{\bm{y}}_{\ast}+{\bm{n}}\in{\mathbb{R}}^{d}~(d&lt;n)</annotation></semantics></math>, where <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is a known linear operator and <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="{\bm{n}}" display="inline" intent=":literal"><semantics><mi>𝒏</mi><annotation encoding="application/x-tex">{\bm{n}}</annotation></semantics></math> is noise. A common prior is that <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="{\bm{y}}_{\ast}" display="inline" intent=":literal"><semantics><msub><mi>𝒚</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{y}}_{\ast}</annotation></semantics></math> lies near a smooth data manifold <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="{\mathbb{M}}\subset{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbb{M}}\subset{\mathbb{R}}^{n}</annotation></semantics></math>. To recover <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="{\bm{y}}_{\ast}" display="inline" intent=":literal"><semantics><msub><mi>𝒚</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{y}}_{\ast}</annotation></semantics></math>, a standard estimator solves</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="\min_{{\bm{y}}\in{\mathbb{R}}^{n}}\;\frac{1}{2}\|{\bm{x}}-{\bm{A}}{\bm{y}}\|^{2}\;+\;\frac{\alpha}{2}\,\mathrm{dist}^{2}({\bm{y}},{\mathbb{M}})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>min</mi><mrow><mi>𝒚</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></munder><mo lspace="0.447em">⁡</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝒙</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.502em">+</mo><mrow><mfrac><mi>α</mi><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>dist</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝕄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{{\bm{y}}\in{\mathbb{R}}^{n}}\;\frac{1}{2}\|{\bm{x}}-{\bm{A}}{\bm{y}}\|^{2}\;+\;\frac{\alpha}{2}\,\mathrm{dist}^{2}({\bm{y}},{\mathbb{M}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">or, equivalently, a variable–splitting surrogate</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="\min_{{\bm{y}},{\bm{z}}\in{\mathbb{R}}^{n}}\;\frac{1}{2}\|{\bm{x}}-{\bm{A}}{\bm{y}}\|^{2}\;+\;\frac{\alpha}{2}\,\mathrm{dist}^{2}({\bm{z}},{\mathbb{M}})\;+\;\frac{\beta}{2}\|{\bm{y}}-{\bm{z}}\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>min</mi><mrow><mrow><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></munder><mo lspace="0.447em">⁡</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝒙</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.502em">+</mo><mrow><mfrac><mi>α</mi><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>dist</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>𝕄</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><mfrac><mi>β</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝒚</mi><mo>−</mo><mi>𝒛</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{{\bm{y}},{\bm{z}}\in{\mathbb{R}}^{n}}\;\frac{1}{2}\|{\bm{x}}-{\bm{A}}{\bm{y}}\|^{2}\;+\;\frac{\alpha}{2}\,\mathrm{dist}^{2}({\bm{z}},{\mathbb{M}})\;+\;\frac{\beta}{2}\|{\bm{y}}-{\bm{z}}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.3" class="ltx_p">Next we will show that, under mild assumptions, both (<a href="#S3.E3" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and (<a href="#S3.E4" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) admit a unique minimizer for each <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> in a bounded set, and the solution map <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="{\bm{x}}\mapsto\hat{{\bm{y}}}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo stretchy="false">↦</mo><mrow><mover accent="true"><mi>𝒚</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}\mapsto\hat{{\bm{y}}}({\bm{x}})</annotation></semantics></math> is <em id="S3.SS1.p1.3.1" class="ltx_emph ltx_font_italic">locally Lipschitz</em>. Hence the reconstruction target falls within Assumption <a href="#S2.Thmtheorem2" title="Assumption 2.2. ‣ 2. Main Results ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> and is covered by our expressivity results in Section <a href="#S2" title="2. Main Results ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Assumption 3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p">Let <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="{\mathbb{M}}\subset{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbb{M}}\subset{\mathbb{R}}^{n}</annotation></semantics></math> be a compact, <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="{\mathcal{C}}^{2}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\mathcal{C}}^{2}</annotation></semantics></math>, embedded (possibly nonconvex) submanifold with positive reach <math id="S3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\tau&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau&gt;0</annotation></semantics></math>. Assume the forward operator <math id="S3.Thmtheorem1.p1.m4" class="ltx_Math" alttext="{\bm{A}}:{\mathbb{R}}^{n}\!\to\!{\mathbb{R}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo rspace="0.108em" stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}:{\mathbb{R}}^{n}\!\to\!{\mathbb{R}}^{d}</annotation></semantics></math> is <math id="S3.Thmtheorem1.p1.m5" class="ltx_Math" alttext="(\mu,L)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mu,L)</annotation></semantics></math>–bi-Lipschitz when restricted to <math id="S3.Thmtheorem1.p1.m6" class="ltx_Math" alttext="{\mathbb{M}}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">{\mathbb{M}}</annotation></semantics></math> and let <math id="S3.Thmtheorem1.p1.m7" class="ltx_Math" alttext="\sigma_{\textup{max}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mtext>max</mtext></msub><annotation encoding="application/x-tex">\sigma_{\textup{max}}</annotation></semantics></math> denote the maximal singular value of <math id="S3.Thmtheorem1.p1.m8" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">These assumptions are modest: they are standard in prior work and supported by existing theory. Formal definitions (reach and bi-Lipschitz continuity) and relevant literature appear in Appendix <a href="#A3" title="Appendix C Proofs of Theorems for Inverse Problems ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>.</p>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Definition 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p">Define the admissible set of observations <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> for (<a href="#S3.E3" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and (<a href="#S3.E4" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>):</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_math_unparsed" alttext="{\mathbb{X}}:=\left\{{\bm{x}}:{\bm{x}}={\bm{A}}{\bm{y}}_{\ast}+{\bm{n}},\quad\textup{for some }{\bm{y}}_{\ast}\in{\mathbb{M}},~~\|{\bm{n}}\|&lt;\frac{1}{80}\frac{\mu^{5}}{\sigma^{2}_{\textup{max}}L^{2}}\tau.\right\}" display="block" intent=":literal"><semantics><mrow><mi>𝕏</mi><mo>:=</mo><mrow><mo>{</mo><mi>𝒙</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝒙</mi><mo>=</mo><mi>𝑨</mi><msub><mi>𝒚</mi><mo>∗</mo></msub><mo>+</mo><mi>𝒏</mi><mo rspace="1.167em">,</mo><mtext>for some </mtext><msub><mi>𝒚</mi><mo>∗</mo></msub><mo>∈</mo><mi>𝕄</mi><mo rspace="0.549em">,</mo><mo rspace="0.167em">∥</mo><mi>𝒏</mi><mo lspace="0em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">&lt;</mo><mfrac><mn>1</mn><mn>80</mn></mfrac><mfrac><msup><mi>μ</mi><mn>5</mn></msup><mrow><msubsup><mi>σ</mi><mtext>max</mtext><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow></mfrac><mi>τ</mi><mo lspace="0em" rspace="0.167em">.</mo><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{X}}:=\left\{{\bm{x}}:{\bm{x}}={\bm{A}}{\bm{y}}_{\ast}+{\bm{n}},\quad\textup{for some }{\bm{y}}_{\ast}\in{\mathbb{M}},~~\|{\bm{n}}\|&lt;\frac{1}{80}\frac{\mu^{5}}{\sigma^{2}_{\textup{max}}L^{2}}\tau.\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 3.3</span></span><span id="S3.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.1" class="ltx_p"><span id="S3.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1. ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, there exists <math id="S3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math> for all <math id="S3.Thmtheorem3.p1.m2" class="ltx_Math" alttext="{\bm{x}}\in{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>𝕏</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}\in{\mathbb{X}}</annotation></semantics></math> such that the minimization problem </span>(<a href="#S3.E3" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)<span id="S3.Thmtheorem3.p1.1.2" class="ltx_text ltx_font_italic"> yields a unique minimizer <math id="S3.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\hat{{\bm{y}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{y}}}</annotation></semantics></math>. Let <math id="S3.Thmtheorem3.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}_{1a}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{1a}</annotation></semantics></math>: <math id="S3.Thmtheorem3.p1.m5" class="ltx_Math" alttext="{\bm{x}}\mapsto\hat{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">↦</mo><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">{\bm{x}}\mapsto\hat{{\bm{y}}}</annotation></semantics></math> denote the associated solution map from input <math id="S3.Thmtheorem3.p1.m6" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> to the recovery <math id="S3.Thmtheorem3.p1.m7" class="ltx_Math" alttext="\hat{{\bm{y}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{y}}}</annotation></semantics></math>. Then <math id="S3.Thmtheorem3.p1.m8" class="ltx_Math" alttext="{\mathcal{F}}_{1a}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{1a}</annotation></semantics></math> is locally Lipschitz continuous on <math id="S3.Thmtheorem3.p1.m9" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 3.4</span></span><span id="S3.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem4.p1" class="ltx_para">
<p id="S3.Thmtheorem4.p1.1" class="ltx_p"><span id="S3.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1. ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, there exist <math id="S3.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\alpha,\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha,\beta&gt;0</annotation></semantics></math> for all <math id="S3.Thmtheorem4.p1.m2" class="ltx_Math" alttext="{\bm{x}}\in{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>𝕏</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}\in{\mathbb{X}}</annotation></semantics></math> such that the minimization problem </span>(<a href="#S3.E4" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>)<span id="S3.Thmtheorem4.p1.1.2" class="ltx_text ltx_font_italic"> yields a unique minimizer <math id="S3.Thmtheorem4.p1.m3" class="ltx_Math" alttext="(\hat{{\bm{y}}},\hat{{\bm{z}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><mo>,</mo><mover accent="true"><mi>𝐳</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\hat{{\bm{y}}},\hat{{\bm{z}}})</annotation></semantics></math>. Let <math id="S3.Thmtheorem4.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}_{1b}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{1b}</annotation></semantics></math>: <math id="S3.Thmtheorem4.p1.m5" class="ltx_Math" alttext="{\bm{x}}\mapsto\hat{{\bm{y}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">↦</mo><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">{\bm{x}}\mapsto\hat{{\bm{y}}}</annotation></semantics></math> denote the associated solution map from input <math id="S3.Thmtheorem4.p1.m6" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math> to the recovery <math id="S3.Thmtheorem4.p1.m7" class="ltx_Math" alttext="\hat{{\bm{y}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐲</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{{\bm{y}}}</annotation></semantics></math>. Then <math id="S3.Thmtheorem4.p1.m8" class="ltx_Math" alttext="{\mathcal{F}}_{1b}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{1b}</annotation></semantics></math> is locally Lipschitz continuous on <math id="S3.Thmtheorem4.p1.m9" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.Thmtheorem5" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem5.2" class="ltx_text ltx_font_bold">Corollary 3.5</span></span><span id="S3.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem5.p1" class="ltx_para">
<p id="S3.Thmtheorem5.p1.1" class="ltx_p"><span id="S3.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">There must be a regular implicit operator <math id="S3.Thmtheorem5.p1.m1" class="ltx_Math" alttext="{\mathcal{G}}({\bm{y}},{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}({\bm{y}},{\bm{x}})</annotation></semantics></math> such that <math id="S3.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\textup{Fix}({\mathcal{G}}(\cdot,{\bm{x}}))={\mathcal{F}}_{1a}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>Fix</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textup{Fix}({\mathcal{G}}(\cdot,{\bm{x}}))={\mathcal{F}}_{1a}({\bm{x}})</annotation></semantics></math> for all <math id="S3.Thmtheorem5.p1.m3" class="ltx_Math" alttext="{\bm{x}}\in{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>𝕏</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}\in{\mathbb{X}}</annotation></semantics></math>. The same conclusion holds for <math id="S3.Thmtheorem5.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}_{1b}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{1b}({\bm{x}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">Proofs of the theorems are deferred to Appendix <a href="#A3" title="Appendix C Proofs of Theorems for Inverse Problems ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>, and Corollary <a href="#S3.Thmtheorem5" title="Corollary 3.5. ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a> follows immediately from Theorems <a href="#S2.Thmtheorem4" title="Theorem 2.4 (Sufficiency). ‣ 2. Main Results ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a>, <a href="#S3.Thmtheorem3" title="Theorem 3.3. ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, and <a href="#S3.Thmtheorem4" title="Theorem 3.4. ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>. This corollary guarantees the existence of regular implicit models <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> for image reconstruction. Next, we present how to implement <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math> in this context.</p>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p"><span id="S3.SS1.p4.1.1" class="ltx_text ltx_font_bold">Problem-specific <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math>.</span>
We adopt <em id="S3.SS1.p4.1.2" class="ltx_emph ltx_font_italic">algorithm-inspired</em> designs that mirror classical solvers for (<a href="#S3.E3" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) and (<a href="#S3.E4" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).
Parameterizing these iterative solvers gives problem-tailored implicit models. In particular,</p>
<ul id="S3.I1" class="ltx_itemize" style="--ltx-enum-leftmargin:5mm;">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">Option I (PGD-style).
To solve (<a href="#S3.E3" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), if <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{M}}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">{\mathbb{M}}</annotation></semantics></math> were known, one would use proximal gradient descent (PGD): <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="{\bm{y}}_{t+1}=\textup{prox}_{\sigma}\!({\bm{y}}_{t}-\gamma\,{\bm{A}}^{\top}({\bm{A}}{\bm{y}}_{t}-{\bm{x}}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mtext>prox</mtext><mi>σ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo>−</mo><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒚</mi><mi>t</mi></msub></mrow><mo>−</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t+1}=\textup{prox}_{\sigma}\!({\bm{y}}_{t}-\gamma\,{\bm{A}}^{\top}({\bm{A}}{\bm{y}}_{t}-{\bm{x}}))</annotation></semantics></math>, with parameters <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\sigma,\gamma&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>,</mo><mi>γ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma,\gamma&gt;0</annotation></semantics></math>, where <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="\textup{prox}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mtext>prox</mtext><mi>σ</mi></msub><annotation encoding="application/x-tex">\textup{prox}_{\sigma}</annotation></semantics></math> is the proximal map of <math id="S3.I1.i1.p1.m5" class="ltx_Math" alttext="({\sigma}/{2})\mathrm{dist}^{2}({\bm{y}},{\mathbb{M}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>dist</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝕄</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">({\sigma}/{2})\mathrm{dist}^{2}({\bm{y}},{\mathbb{M}})</annotation></semantics></math> (see Appendix <a href="#A3.SS1" title="C.1. Proximal operator near a manifold ‣ Appendix C Proofs of Theorems for Inverse Problems ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>).
In practice, we replace <math id="S3.I1.i1.p1.m6" class="ltx_Math" alttext="\textup{prox}_{\sigma}" display="inline" intent=":literal"><semantics><msub><mtext>prox</mtext><mi>σ</mi></msub><annotation encoding="application/x-tex">\textup{prox}_{\sigma}</annotation></semantics></math> by a learnable neural network denoiser <math id="S3.I1.i1.p1.m7" class="ltx_Math" alttext="{\mathcal{H}}_{\theta,\sigma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>θ</mi><mo>,</mo><mi>σ</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{H}}_{\theta,\sigma}</annotation></semantics></math> (parameters <math id="S3.I1.i1.p1.m8" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> and noise level input <math id="S3.I1.i1.p1.m9" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>) and obtain</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="{\mathcal{G}}_{\Theta}({\bm{y}},{\bm{x}})={\mathcal{H}}_{\theta,\sigma}\!\Big({\bm{y}}-\gamma\,{\bm{A}}^{\top}({\bm{A}}{\bm{y}}-{\bm{x}})\Big),\qquad\Theta=\{\theta,\sigma,\gamma\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>θ</mi><mo>,</mo><mi>σ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>𝒚</mi><mo>−</mo><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi></mrow><mo>−</mo><mi>𝒙</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>θ</mi><mo>,</mo><mi>σ</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{\Theta}({\bm{y}},{\bm{x}})={\mathcal{H}}_{\theta,\sigma}\!\Big({\bm{y}}-\gamma\,{\bm{A}}^{\top}({\bm{A}}{\bm{y}}-{\bm{x}})\Big),\qquad\Theta=\{\theta,\sigma,\gamma\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">Option II (HQS-style).
For (<a href="#S3.E4" title="In 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), a standard solver is half–quadratic splitting (HQS, see Appendix <a href="#A3.SS2" title="C.2. Discussions regarding PnP ‣ Appendix C Proofs of Theorems for Inverse Problems ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>).
Similar to Option I, we replace the proximal map by a learned module and obtain</p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_Math" alttext="{\mathcal{G}}_{\Theta}({\bm{y}},{\bm{x}})\;=\;{\mathcal{H}}_{\theta,\sigma}\!\left(\,\big({\bm{A}}^{\top}{\bm{A}}+\beta{\bm{I}}\big)^{-1}\!\big({\bm{A}}^{\top}{\bm{x}}+\beta\,{\bm{y}}\big)\right),\qquad\Theta=\{\theta,\sigma,\beta\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒙</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>θ</mi><mo>,</mo><mi>σ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.170em">(</mo><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒙</mi></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝒚</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>θ</mi><mo>,</mo><mi>σ</mi><mo>,</mo><mi>β</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{\Theta}({\bm{y}},{\bm{x}})\;=\;{\mathcal{H}}_{\theta,\sigma}\!\left(\,\big({\bm{A}}^{\top}{\bm{A}}+\beta{\bm{I}}\big)^{-1}\!\big({\bm{A}}^{\top}{\bm{x}}+\beta\,{\bm{y}}\big)\right),\qquad\Theta=\{\theta,\sigma,\beta\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="S3.SS1.p4.2" class="ltx_p">Here we follow the long-standing “plug-in denoiser” idea from Plug-and-Play (PnP) methods <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib92" title="" class="ltx_ref">92</a>]</cite>, which replaces a proximal operator with an off-the-shelf denoiser inside an iterative solver (see brief bibliography in Appendix <a href="#A3.SS2" title="C.2. Discussions regarding PnP ‣ Appendix C Proofs of Theorems for Inverse Problems ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>). Unlike PnP, one can also train the <em id="S3.SS1.p4.2.1" class="ltx_emph ltx_font_italic">entire</em> <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="{\mathcal{G}}_{\Theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{\Theta}</annotation></semantics></math> as an implicit model, in both PGD-style <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>, <a href="#bib.bib95" title="" class="ltx_ref">95</a>, <a href="#bib.bib104" title="" class="ltx_ref">104</a>, <a href="#bib.bib101" title="" class="ltx_ref">101</a>, <a href="#bib.bib19" title="" class="ltx_ref">19</a>, <a href="#bib.bib86" title="" class="ltx_ref">86</a>]</cite> and HQS-style <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">36</a>]</cite> formulations. We adopt the latter.</p>
</div>
<div id="S3.SS1.p5" class="ltx_para">
<p id="S3.SS1.p5.1" class="ltx_p"><span id="S3.SS1.p5.1.1" class="ltx_text ltx_font_bold">Questions.</span> Given the parameterizations in (<a href="#S3.E5" title="In 1st item ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) and (<a href="#S3.E6" title="In 2nd item ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>), we examine: (i) are these <math id="S3.SS1.p5.m1" class="ltx_Math" alttext="{\mathcal{G}}_{\Theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{\Theta}</annotation></semantics></math> operators Lipschitz with respect to <math id="S3.SS1.p5.m2" class="ltx_Math" alttext="{\bm{x}}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">{\bm{x}}</annotation></semantics></math>; and (ii) do they, as our theory predicts, realize progressively more complex input–output mappings over iterations despite having simple per-iteration operators?</p>
</div>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p"><span id="S3.SS1.p6.1.1" class="ltx_text ltx_font_bold">Experiment settings.</span> We study image deblurring, <math id="S3.SS1.p6.m1" class="ltx_Math" alttext="{\bm{x}}={\bm{A}}({\bm{y}}_{\ast})+{\bm{n}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒙</mi><mo>=</mo><mrow><mrow><mi>𝑨</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒚</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>𝒏</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}={\bm{A}}({\bm{y}}_{\ast})+{\bm{n}}</annotation></semantics></math>, where <math id="S3.SS1.p6.m2" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is a motion-blur operator and <math id="S3.SS1.p6.m3" class="ltx_Math" alttext="{\bm{n}}" display="inline" intent=":literal"><semantics><mi>𝒏</mi><annotation encoding="application/x-tex">{\bm{n}}</annotation></semantics></math> is additive Gaussian noise. Using BSDS500 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib66" title="" class="ltx_ref">66</a>]</cite>, we construct 200 training, 100 validation, and 200 test pairs <math id="S3.SS1.p6.m4" class="ltx_Math" alttext="({\bm{x}},{\bm{y}}_{\ast})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><msub><mi>𝒚</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{x}},{\bm{y}}_{\ast})</annotation></semantics></math>, yielding datasets <math id="S3.SS1.p6.m5" class="ltx_Math" alttext="{\mathbb{D}}_{\textup{inv,train}}" display="inline" intent=":literal"><semantics><msub><mi>𝔻</mi><mtext>inv,train</mtext></msub><annotation encoding="application/x-tex">{\mathbb{D}}_{\textup{inv,train}}</annotation></semantics></math>, <math id="S3.SS1.p6.m6" class="ltx_Math" alttext="{\mathbb{D}}_{\textup{inv,val}}" display="inline" intent=":literal"><semantics><msub><mi>𝔻</mi><mtext>inv,val</mtext></msub><annotation encoding="application/x-tex">{\mathbb{D}}_{\textup{inv,val}}</annotation></semantics></math>, and <math id="S3.SS1.p6.m7" class="ltx_Math" alttext="{\mathbb{D}}_{\textup{inv,test}}" display="inline" intent=":literal"><semantics><msub><mi>𝔻</mi><mtext>inv,test</mtext></msub><annotation encoding="application/x-tex">{\mathbb{D}}_{\textup{inv,test}}</annotation></semantics></math>. Implementation details (data preprocessing, model choices, and training) are in Appendix <a href="#A6" title="Appendix F Experiment Details regarding Image Reconstruction ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>.</p>
</div>
<div id="S3.SS1.p7" class="ltx_para">
<p id="S3.SS1.p7.1" class="ltx_p">For evaluation, we analyze 100 iterations of the learned dynamics, <math id="S3.SS1.p7.m1" class="ltx_Math" alttext="{\bm{y}}_{t+1}({\bm{x}})={\mathcal{G}}_{\Theta}({\bm{y}}_{t}({\bm{x}}),{\bm{x}}),0\leq t\leq 99" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝒚</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mn>99</mn></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t+1}({\bm{x}})={\mathcal{G}}_{\Theta}({\bm{y}}_{t}({\bm{x}}),{\bm{x}}),0\leq t\leq 99</annotation></semantics></math> and <math id="S3.SS1.p7.m2" class="ltx_Math" alttext="{\bm{y}}_{0}={\bm{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mn>0</mn></msub><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{y}}_{0}={\bm{0}}</annotation></semantics></math>, on the test set <math id="S3.SS1.p7.m3" class="ltx_Math" alttext="{\mathbb{D}}_{\textup{inv,test}}=\{({\bm{x}}_{i},{\bm{y}}^{\ast}_{i})\}_{i=1}^{200}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔻</mi><mtext>inv,test</mtext></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>𝒚</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>200</mn></msubsup></mrow><annotation encoding="application/x-tex">{\mathbb{D}}_{\textup{inv,test}}=\{({\bm{x}}_{i},{\bm{y}}^{\ast}_{i})\}_{i=1}^{200}</annotation></semantics></math>. For each <math id="S3.SS1.p7.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we create 5 perturbed ground truths <math id="S3.SS1.p7.m5" class="ltx_Math" alttext="{\bm{y}}^{\ast}_{i,j},1\leq j\leq 5" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝒚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo>,</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}^{\ast}_{i,j},1\leq j\leq 5</annotation></semantics></math>, and for each <math id="S3.SS1.p7.m6" class="ltx_Math" alttext="{\bm{y}}^{\ast}_{i,j}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{y}}^{\ast}_{i,j}</annotation></semantics></math>, we apply <math id="S3.SS1.p7.m7" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>, add noise, and then obtain <math id="S3.SS1.p7.m8" class="ltx_Math" alttext="{\bm{x}}_{i,j}" display="inline" intent=":literal"><semantics><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{x}}_{i,j}</annotation></semantics></math>. The perturbed pairs <math id="S3.SS1.p7.m9" class="ltx_Math" alttext="\{({\bm{x}}_{i,j},{\bm{y}}^{\ast}_{i,j})\}_{i,j}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>,</mo><msubsup><mi>𝒚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\{({\bm{x}}_{i,j},{\bm{y}}^{\ast}_{i,j})\}_{i,j}</annotation></semantics></math> form the perturbed dataset <math id="S3.SS1.p7.m10" class="ltx_Math" alttext="{\mathbb{D}}^{\prime}_{\textup{inv,test}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔻</mi><mtext>inv,test</mtext><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathbb{D}}^{\prime}_{\textup{inv,test}}</annotation></semantics></math>. Details appear in Appendix <a href="#A6" title="Appendix F Experiment Details regarding Image Reconstruction ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>. We track two metrics, including an empirical Lipschitz estimate and reconstruction quality in PSNR (i.e., Peak Signal-to-Noise Ratio, higher PSNR means more accurate reconstruction, see appendix):</p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="L_{t}:=\max_{1\leq i\leq 200}\max_{1\leq j\leq 5}\frac{\|{\bm{y}}_{t}({\bm{x}}_{i})-{\bm{y}}_{t}({\bm{x}}_{i,j})\|}{\|{\bm{x}}_{i}-{\bm{x}}_{i,j}\|},\quad\textup{and}\quad P_{t}(i,j):=\textup{PSNR}({\bm{y}}_{t}({\bm{x}}_{i,j}),{\bm{y}}^{\ast}_{i,j})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>L</mi><mi>t</mi></msub><mo>:=</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mn>200</mn></mrow></munder><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>5</mn></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝒙</mi><mi>i</mi></msub><mo>−</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mrow></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi>P</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mtext>PSNR</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mi>𝒚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">L_{t}:=\max_{1\leq i\leq 200}\max_{1\leq j\leq 5}\frac{\|{\bm{y}}_{t}({\bm{x}}_{i})-{\bm{y}}_{t}({\bm{x}}_{i,j})\|}{\|{\bm{x}}_{i}-{\bm{x}}_{i,j}\|},\quad\textup{and}\quad P_{t}(i,j):=\textup{PSNR}({\bm{y}}_{t}({\bm{x}}_{i,j}),{\bm{y}}^{\ast}_{i,j}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p7.2" class="ltx_p">for <math id="S3.SS1.p7.m11" class="ltx_Math" alttext="1\leq i\leq 200,0\leq j\leq 5" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mn>200</mn></mrow><mo>,</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq 200,0\leq j\leq 5</annotation></semantics></math>,
where <math id="S3.SS1.p7.m12" class="ltx_Math" alttext="j=0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j=0</annotation></semantics></math> means the original (unperturbed) sample, <math id="S3.SS1.p7.m13" class="ltx_Math" alttext="{\bm{x}}_{i,0}:={\bm{x}}_{i},{\bm{y}}^{\ast}_{i,0}:={\bm{y}}^{\ast}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒙</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>:=</mo><msub><mi>𝒙</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><msubsup><mi>𝒚</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow><mo>∗</mo></msubsup><mo>:=</mo><msubsup><mi>𝒚</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{i,0}:={\bm{x}}_{i},{\bm{y}}^{\ast}_{i,0}:={\bm{y}}^{\ast}_{i}</annotation></semantics></math>.
Here, <math id="S3.SS1.p7.m14" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> estimates how complex the t-th iterate map <math id="S3.SS1.p7.m15" class="ltx_Math" alttext="{\bm{y}}_{t}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t}(\cdot)</annotation></semantics></math> is, while <math id="S3.SS1.p7.m16" class="ltx_Math" alttext="P_{t}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>t</mi></msub><annotation encoding="application/x-tex">P_{t}</annotation></semantics></math> measures the reconstruction quality on <span id="S3.SS1.p7.2.1" class="ltx_text ltx_font_italic">both</span> the original dataset <math id="S3.SS1.p7.m17" class="ltx_Math" alttext="{\mathbb{D}}_{\textup{inv,test}}" display="inline" intent=":literal"><semantics><msub><mi>𝔻</mi><mtext>inv,test</mtext></msub><annotation encoding="application/x-tex">{\mathbb{D}}_{\textup{inv,test}}</annotation></semantics></math> and the perturbed set <math id="S3.SS1.p7.m18" class="ltx_Math" alttext="{\mathbb{D}}^{\prime}_{\textup{inv,test}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔻</mi><mtext>inv,test</mtext><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathbb{D}}^{\prime}_{\textup{inv,test}}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.p8" class="ltx_para">
<p id="S3.SS1.p8.1" class="ltx_p"><span id="S3.SS1.p8.1.1" class="ltx_text ltx_font_bold">Experiment results.</span>
<span id="S3.SS1.p8.1.2" class="ltx_text ltx_underline ltx_font_bold ltx_font_italic">(i)</span> Results in Figure <a href="#S3.F2" title="Figure 2 ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> support our theory.
Figure <a href="#S3.F2.sf1" title="In Figure 2 ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(a)</span></a> plots <math id="S3.SS1.p8.m1" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> versus <math id="S3.SS1.p8.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, while Figure <a href="#S3.F2.sf2" title="In Figure 2 ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(b)</span></a> reports the mean <math id="S3.SS1.p8.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> std of <math id="S3.SS1.p8.m4" class="ltx_Math" alttext="\{P_{t}(i,j)\}_{i,j}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>P</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">\{P_{t}(i,j)\}_{i,j}</annotation></semantics></math> versus <math id="S3.SS1.p8.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
At <math id="S3.SS1.p8.m6" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>, the mapping <math id="S3.SS1.p8.m7" class="ltx_Math" alttext="{\bm{y}}_{1}({\bm{x}})={\mathcal{G}}_{\Theta}({\bm{0}},{\bm{x}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒚</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{1}({\bm{x}})={\mathcal{G}}_{\Theta}({\bm{0}},{\bm{x}})</annotation></semantics></math> reflects a <span id="S3.SS1.p8.1.3" class="ltx_text ltx_font_italic">single application of <math id="S3.SS1.p8.m8" class="ltx_Math" alttext="{\mathcal{G}}_{\Theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{\Theta}</annotation></semantics></math> and exhibits low Lipschitz constant</span>: <math id="S3.SS1.p8.m9" class="ltx_Math" alttext="L_{1}=0.140" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>=</mo><mn>0.140</mn></mrow><annotation encoding="application/x-tex">L_{1}=0.140</annotation></semantics></math> for PGD and <math id="S3.SS1.p8.m10" class="ltx_Math" alttext="L_{1}=0.436" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>=</mo><mn>0.436</mn></mrow><annotation encoding="application/x-tex">L_{1}=0.436</annotation></semantics></math> for HQS.
As <math id="S3.SS1.p8.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> increases, <math id="S3.SS1.p8.m12" class="ltx_Math" alttext="{\bm{y}}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒚</mi><mi>t</mi></msub><annotation encoding="application/x-tex">{\bm{y}}_{t}</annotation></semantics></math> approaches the fixed point and <math id="S3.SS1.p8.m13" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> grows substantially, saturating around <math id="S3.SS1.p8.m14" class="ltx_Math" alttext="\approx 5.0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≈</mo><mn>5.0</mn></mrow><annotation encoding="application/x-tex">\approx 5.0</annotation></semantics></math> for both models (Figure <a href="#S3.F2.sf1" title="In Figure 2 ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(a)</span></a>).
Meanwhile, the PSNR rises and stabilizes, indicating that <math id="S3.SS1.p8.m15" class="ltx_Math" alttext="{\bm{y}}_{t}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t}({\bm{x}})</annotation></semantics></math> converges toward the ground truth (Figure <a href="#S3.F2.sf2" title="In Figure 2 ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(b)</span></a>).
Thus, the increase in <math id="S3.SS1.p8.m16" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> does not reflect divergence or instability; rather, <span id="S3.SS1.p8.1.4" class="ltx_text ltx_font_italic">it captures the greater complexity of the underlying target mapping <math id="S3.SS1.p8.m17" class="ltx_Math" alttext="{\bm{x}}\mapsto{\bm{y}}_{\ast}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">↦</mo><msub><mi>𝐲</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">{\bm{x}}\mapsto{\bm{y}}_{\ast}</annotation></semantics></math>, which is progressively expressed through iteration</span>.
<span id="S3.SS1.p8.1.5" class="ltx_text ltx_underline ltx_font_bold ltx_font_italic">(ii)</span> We also provide a comparison (both visually and
quantitatively) to an explicit model in Figure <a href="#S3.F3" title="Figure 3 ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.
This baseline uses the identical DRUnet and is trained on the deblurring dataset with an end-to-end MSE loss.
A visual inspection reveals that implicit models, particularly implicit HQS (<a href="#S3.E6" title="In 2nd item ‣ 3.1. Case Study 1: Image Reconstruction (Inverse problems) ‣ 3. Case Studies ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>), produce sharper images with better-recovered textures and fewer artifacts than the explicit baseline. This perceptual advantage is corroborated by the quantitative metrics, where the DEQ-HQS model achieves a significant PSNR gain of over 2dB on average across the entire test set.
<span id="S3.SS1.p8.1.6" class="ltx_text ltx_underline ltx_font_bold ltx_font_italic">(iii)</span> Additional experiments showing a small implicit model outperforming larger explicit ones appear in Appendix <a href="#A6" title="Appendix F Experiment Details regarding Image Reconstruction ‣ Implicit Models: Expressive Power Scales with Test-Time Compute" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>.</p>
</div>
<figure id="S3.F2" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F2.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.03638v1/lip_plot_inv.svg" id="S3.F2.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/215;" width="476" height="215"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S3.F2.sf1.4" class="ltx_text" style="font-size:90%;">Empirical Lipschitz <math id="S3.F2.sf1.m7" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> of <math id="S3.F2.sf1.m8" class="ltx_Math" alttext="{\bm{y}}_{t}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t}(\cdot)</annotation></semantics></math> vs. iteration. <math id="S3.F2.sf1.m9" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math> starts small at <math id="S3.F2.sf1.m10" class="ltx_Math" alttext="t{=}1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t{=}1</annotation></semantics></math> and grows to a plateau (<math id="S3.F2.sf1.m11" class="ltx_Math" alttext="\sim\!5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">\sim\!5</annotation></semantics></math>), indicating increasing expressivity of <math id="S3.F2.sf1.m12" class="ltx_Math" alttext="{\bm{y}}_{t}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t}(\cdot)</annotation></semantics></math>.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.03638v1/psnr_plot_inv.svg" id="S3.F2.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/215;" width="476" height="215"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S3.F2.sf2.4" class="ltx_text" style="font-size:90%;">Reconstruction quality <math id="S3.F2.sf2.m4" class="ltx_Math" alttext="P_{t}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>t</mi></msub><annotation encoding="application/x-tex">P_{t}</annotation></semantics></math> (mean <math id="S3.F2.sf2.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> std over the original and perturbed test samples) increases and stabilizes: <math id="S3.F2.sf2.m6" class="ltx_Math" alttext="{\bm{y}}_{t}({\bm{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒚</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{y}}_{t}({\bm{x}})</annotation></semantics></math> converges toward the truth.</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>. </span><span id="S3.F2.4" class="ltx_text" style="font-size:90%;">Validation on image deblurring. Iterating a simple operator <math id="S3.F2.m2" class="ltx_Math" alttext="{\mathcal{G}}_{\Theta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">Θ</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{\Theta}</annotation></semantics></math> produces a complex fixed-point mapping: Lipschitz (a) grows, while accuracy (b) improves and stabilizes.</span></figcaption>
</figure>
