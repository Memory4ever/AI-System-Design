<sup id="id8" class="ltx_sup"><math id="m10" class="ltx_Math" alttext="\clubsuit" display="inline" intent=":literal"><semantics><mi mathvariant="normal">♣</mi><annotation encoding="application/x-tex">\clubsuit</annotation></semantics></math></sup>Department of Linguistics
</span>
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span><sup id="id9" class="ltx_sup"><math id="m11" class="ltx_Math" alttext="\spadesuit" display="inline" intent=":literal"><semantics><mi mathvariant="normal">♠</mi><annotation encoding="application/x-tex">\spadesuit</annotation></semantics></math></sup>Institute for Advanced Computational Science
