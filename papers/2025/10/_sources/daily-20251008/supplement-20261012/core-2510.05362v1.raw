<th id="S7.T4.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S7.T4.2.1.2.1" class="ltx_text ltx_font_bold">Score</span></th>
<th id="S7.T4.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S7.T4.2.1.3.1" class="ltx_text ltx_font_bold">Doc 1</span></th>
<th id="S7.T4.2.1.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S7.T4.2.1.4.1" class="ltx_text ltx_font_bold">Doc 2</span></th></tr>
