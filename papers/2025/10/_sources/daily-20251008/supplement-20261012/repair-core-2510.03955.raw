<td id="S3.T4.6.1.8.2" class="ltx_td ltx_align_center"><span id="S3.T4.6.1.8.2.1" class="ltx_text" style="font-size:70%;">13.8k</span></td>
<td id="S3.T4.6.1.8.3" class="ltx_td ltx_align_center"><span id="S3.T4.6.1.8.3.1" class="ltx_text" style="font-size:70%;">✓</span></td>
<td id="S3.T4.6.1.8.4" class="ltx_td ltx_align_center"><span id="S3.T4.6.1.8.4.1" class="ltx_text" style="font-size:70%;">✗</span></td></tr>
