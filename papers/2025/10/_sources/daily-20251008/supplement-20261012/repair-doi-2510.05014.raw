{"data":{"id":"10.48550/arxiv.2510.05014","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05014","prefix":"10.48550","suffix":"arxiv.2510.05014","identifiers":[{"identifier":"2510.05014","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.05014"}],"creators":[{"name":"Cui, Xuanming","nameType":"Personal","givenName":"Xuanming","familyName":"Cui","affiliation":[],"nameIdentifiers":[]},{"name":"Cheng, Jianpeng","nameType":"Personal","givenName":"Jianpeng","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Hong-you","nameType":"Personal","givenName":"Hong-you","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Shukla, Satya Narayan","nameType":"Personal","givenName":"Satya Narayan","familyName":"Shukla","affiliation":[],"nameIdentifiers":[]},{"name":"Awasthi, Abhijeet","nameType":"Personal","givenName":"Abhijeet","familyName":"Awasthi","affiliation":[],"nameIdentifiers":[]},{"name":"Pan, Xichen","nameType":"Personal","givenName":"Xichen","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Ahuja, Chaitanya","nameType":"Personal","givenName":"Chaitanya","familyName":"Ahuja","affiliation":[],"nameIdentifiers":[]},{"name":"Mishra, Shlok Kumar","nameType":"Personal","givenName":"Shlok Kumar","familyName":"Mishra","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Yonghuan","nameType":"Personal","givenName":"Yonghuan","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Xiao, Jun","nameType":"Personal","givenName":"Jun","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Qi","nameType":"Personal","givenName":"Qi","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Lim, Ser-Nam","nameType":"Personal","givenName":"Ser-Nam","familyName":"Lim","affiliation":[],"nameIdentifiers":[]},{"name":"Singh, Aashu","nameType":"Personal","givenName":"Aashu","familyName":"Singh","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Xiangjun","nameType":"Personal","givenName":"Xiangjun","familyName":"Fan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Think Then Embed: Generative Context Improves Multimodal Embedding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T16:53:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:45:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T00:57:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:14:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-29T23:44:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-31T00:13:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-19T16:13:58Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-21T02:34:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"There is a growing interest in Universal Multimodal Embeddings (UME), where models are required to generate task-specific representations. While recent studies show that Multimodal Large Language Models (MLLMs) perform well on such tasks, they treat MLLMs solely as encoders, overlooking their generative capacity. However, such an encoding paradigm becomes less effective as instructions become more complex and require compositional reasoning. Inspired by the proven effectiveness of chain-of-thought reasoning, we propose a general Think-Then-Embed (TTE) framework for UME, composed of a reasoner and an embedder. The reasoner MLLM first generates reasoning traces that explain complex queries, followed by an embedder that produces representations conditioned on both the original query and the intermediate reasoning. This explicit reasoning step enables more nuanced understanding of complex multimodal instructions. Our contributions are threefold. First, by leveraging a powerful MLLM reasoner, we achieve state-of-the-art performance on the MMEB-V2 benchmark, surpassing proprietary models trained on massive in-house datasets. Second, to reduce the dependency on large MLLM reasoners, we finetune a smaller MLLM reasoner using high-quality embedding-centric reasoning traces, achieving the best performance among open-source models with a 7% absolute gain over recently proposed models. Third, we investigate strategies for integrating the reasoner and embedder into a unified model for improved efficiency without sacrificing performance.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.05014","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T17:02:43.000Z","registered":"2025-10-07T17:02:43.000Z","published":"2025","updated":"2026-01-21T06:05:58.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.05014","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}