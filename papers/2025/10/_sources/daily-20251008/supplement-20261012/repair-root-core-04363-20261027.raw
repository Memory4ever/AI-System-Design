<td id="S4.T3.2.5.4" class="ltx_td ltx_align_right">72</td>
<td id="S4.T3.2.5.5" class="ltx_td ltx_align_right">90.0</td></tr>
<tr id="S4.T3.2.6" class="ltx_tr">
<td id="S4.T3.2.6.1" class="ltx_td ltx_align_left"><em id="S4.T3.2.6.1.1" class="ltx_emph ltx_font_italic">Instagram-like</em></td>
<td id="S4.T3.2.6.2" class="ltx_td ltx_align_right">120</td>
