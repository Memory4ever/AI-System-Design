<td id="S4.T3.2.4.4" class="ltx_td ltx_align_right">470</td>
<td id="S4.T3.2.4.5" class="ltx_td ltx_align_right">94.2</td></tr>
<tr id="S4.T3.2.5" class="ltx_tr">
<td id="S4.T3.2.5.1" class="ltx_td ltx_align_left"><em id="S4.T3.2.5.1.1" class="ltx_emph ltx_font_italic">Threads-like</em></td>
<td id="S4.T3.2.5.2" class="ltx_td ltx_align_right">20</td>
