<th id="S4.T2.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.2.1.4.1" class="ltx_text ltx_font_bold">Rate (%)</span></th></tr>
