<td id="S4.T3.2.7.4" class="ltx_td ltx_align_right">69</td>
<td id="S4.T3.2.7.5" class="ltx_td ltx_align_right">86.3</td></tr>
<tr id="S4.T3.2.8" class="ltx_tr">
