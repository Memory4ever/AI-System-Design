<th id="S4.T2.2.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t">2,370</th>
<th id="S4.T2.2.2.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t">91.7</th></tr>
</thead>
<tbody class="ltx_tbody">
