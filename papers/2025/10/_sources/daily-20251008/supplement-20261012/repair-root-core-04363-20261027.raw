<thead class="ltx_thead">
<tr id="S4.T2.2.1" class="ltx_tr">
<th id="S4.T2.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.2.1.1.1" class="ltx_text ltx_font_bold">Complexity</span></th>
<th id="S4.T2.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.2.1.2.1" class="ltx_text ltx_font_bold">Total</span></th>
