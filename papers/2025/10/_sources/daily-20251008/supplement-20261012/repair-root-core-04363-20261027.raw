<td id="S4.T3.2.3.4" class="ltx_td ltx_align_right">457</td>
<td id="S4.T3.2.3.5" class="ltx_td ltx_align_right">98.7</td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
<td id="S4.T3.2.4.1" class="ltx_td ltx_align_left"><em id="S4.T3.2.4.1.1" class="ltx_emph ltx_font_italic">Reddit-like</em></td>
<td id="S4.T3.2.4.2" class="ltx_td ltx_align_right">130</td>
