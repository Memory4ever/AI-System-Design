<td id="S4.T3.4.1.2.11" class="ltx_td ltx_align_center ltx_border_t">Weather (short)</td></tr>
<tr id="S4.T3.4.1.3" class="ltx_tr">
<td id="S4.T3.4.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="S4.T3.4.1.3.1.1" class="ltx_text ltx_font_smallcaps">TS-Reasoner</span>-7B (ours)</td>
<td id="S4.T3.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.2.1" class="ltx_text ltx_font_bold">52.29</span></td>
<td id="S4.T3.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.3.1" class="ltx_text ltx_font_bold">60.92</span></td>
<td id="S4.T3.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.4.1" class="ltx_text ltx_font_bold">52.71</span></td>
<td id="S4.T3.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t">64.60</td>
<td id="S4.T3.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.6.1" class="ltx_text ltx_font_bold">41.27</span></td>
<td id="S4.T3.4.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T3.4.1.3.7.1" class="ltx_text ltx_font_bold">54.26</span></td>
<td id="S4.T3.4.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.8.1" class="ltx_text ltx_font_bold">90.12</span></td>
<td id="S4.T3.4.1.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.9.1" class="ltx_text ltx_font_bold">91.85</span></td>
<td id="S4.T3.4.1.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.10.1" class="ltx_text ltx_font_bold">60.44</span></td>
<td id="S4.T3.4.1.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.4.1.3.11.1" class="ltx_text ltx_font_bold">61.24</span></td></tr>
