<td id="A1.T4.4.1.9.3" class="ltx_td ltx_align_center"><math id="A1.T4.m2" class="ltx_Math" alttext="2\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\times 10^{-5}</annotation></semantics></math></td></tr>
