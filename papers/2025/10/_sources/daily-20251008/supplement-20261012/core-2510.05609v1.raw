<tr id="S4.T1.3.1.13" class="ltx_tr">
<th id="S4.T1.3.1.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen2.5-VL-3B-SFT</th>
<th id="S4.T1.3.1.13.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">1000 steps</th>
<td id="S4.T1.3.1.13.3" class="ltx_td ltx_align_center">15.23</td>
