<td id="S4.T1.3.1.13.8" class="ltx_td ltx_align_center">17.54</td></tr>
<tr id="S4.T1.3.1.14" class="ltx_tr">
<th id="S4.T1.3.1.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen2.5-VL-3B-SFT</th>
<th id="S4.T1.3.1.14.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">1 epoch</th>
<td id="S4.T1.3.1.14.3" class="ltx_td ltx_align_center">16.77</td>
