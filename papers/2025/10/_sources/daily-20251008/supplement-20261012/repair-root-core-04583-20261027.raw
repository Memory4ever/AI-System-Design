<td id="A7.T11.2.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">NLL<math id="A7.T11.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
<td id="A7.T11.2.1.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="A7.T11.m7" class="ltx_Math" alttext="\mathcal{C}_{0.95}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>0.95</mn></msub><annotation encoding="application/x-tex">\mathcal{C}_{0.95}</annotation></semantics></math></td></tr>
<tr id="A7.T11.2.2" class="ltx_tr">
<td id="A7.T11.2.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;" rowspan="6"><span id="A7.T11.2.2.1.1" class="ltx_text ltx_font_bold">Burgers’</span></td>
<td id="A7.T11.2.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">2</td>
