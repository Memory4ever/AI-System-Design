<td id="A7.T11.2.5.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">10</td>
<td id="A7.T11.2.5.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">7.46 (0.17)</td>
<td id="A7.T11.2.5.3" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0.1040</td>
