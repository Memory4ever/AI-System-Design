<td id="S4.T1.2.8.8" class="ltx_td ltx_align_center"><span id="S4.T1.2.8.8.1" class="ltx_text ltx_font_bold">1.65</span></td>
<td id="S4.T1.2.8.9" class="ltx_td ltx_align_center ltx_border_r">1.69</td></tr>
<tr id="S4.T1.2.9" class="ltx_tr">
