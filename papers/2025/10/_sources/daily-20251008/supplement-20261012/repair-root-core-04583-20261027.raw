<td id="S4.T1.2.9.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.9.4.1" class="ltx_text ltx_font_bold">0.66</span></td>
<td id="S4.T1.2.9.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.9.5.1" class="ltx_text ltx_font_bold">0.66</span></td>
<td id="S4.T1.2.9.6" class="ltx_td ltx_align_center">0.34</td>
<td id="S4.T1.2.9.7" class="ltx_td ltx_align_center">0.34</td>
<td id="S4.T1.2.9.8" class="ltx_td ltx_align_center">0.34</td>
<td id="S4.T1.2.9.9" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.9.9.1" class="ltx_text ltx_font_bold">0.33</span></td></tr>
<tr id="S4.T1.2.10" class="ltx_tr">
<td id="S4.T1.2.10.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r">Yacht</td>
