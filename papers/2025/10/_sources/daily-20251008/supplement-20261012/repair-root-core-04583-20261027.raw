<td id="S4.T1.2.7.8" class="ltx_td ltx_align_center"><span id="S4.T1.2.7.8.1" class="ltx_text ltx_font_bold">1.81</span></td>
<td id="S4.T1.2.7.9" class="ltx_td ltx_align_center ltx_border_r">1.93</td></tr>
<tr id="S4.T1.2.8" class="ltx_tr">
<td id="S4.T1.2.8.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r">Protein</td>
<td id="S4.T1.2.8.2" class="ltx_td ltx_align_center">3.76</td>
<td id="S4.T1.2.8.3" class="ltx_td ltx_align_center"><span id="S4.T1.2.8.3.1" class="ltx_text ltx_font_bold">3.71</span></td>
<td id="S4.T1.2.8.4" class="ltx_td ltx_align_center">3.72</td>
<td id="S4.T1.2.8.5" class="ltx_td ltx_align_center ltx_border_r">3.76</td>
<td id="S4.T1.2.8.6" class="ltx_td ltx_align_center">1.71</td>
