36.13 v 35.94 h -36.13 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -32.25 -30.43)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 30.4)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 3.15)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 21.7 0) translate(0.24,0) matrix(0.35 0.0 0.0 0.35 5.58 -1.45)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.11em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" color="#000000" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="15.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F5.pic1.m31" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.31)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 17.68 0) translate(4.26,0) matrix(0.35 0.0 0.0 0.35 -3.3 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.36em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">1k </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.33)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.47 0) translate(5.48,0) matrix(0.35 0.0 0.0 0.35 -4.51 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.86em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="25.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">10k </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.36)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 17.28 0) translate(4.67,0) matrix(0.35 0.0 0.0 0.35 -3.7 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.53em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="21.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">90k</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 27.39)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.07 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">750k</span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span><span id="S4.F5.3" class="ltx_text ltx_font_bold">Neon consistently improves autoregressive models across architectures and resolutions.</span> We plot the minimum FID (optimized over merge weight <math id="S4.F5.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and CFG scale <math id="S4.F5.m6" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>) versus the fine-tuning budget <math id="S4.F5.m7" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> for various synthetic dataset sizes <math id="S4.F5.m8" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math>. From left: xAR-B and xAR-L on ImageNet-256 (with xAR-L achieving a state-of-the-art 1.02 FID), VAR-d16 on ImageNet-256, and VAR-d30 on ImageNet-512.</figcaption>
</figure>
