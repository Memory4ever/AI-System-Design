<td id="A1.T1.tab1.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding:-0.25pt 2.0pt;"><span id="A1.T1.tab1.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">Model</span></td>
