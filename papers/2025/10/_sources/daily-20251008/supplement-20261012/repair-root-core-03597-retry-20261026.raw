-1 17.68 0) translate(4.26,0) matrix(0.35 0.0 0.0 0.35 -3.3 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.36em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">1k </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.33)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 17.68 0) translate(4.26,0) matrix(0.35 0.0 0.0 0.35 -3.3 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.36em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">6k </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.36)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 17.28 0) translate(4.67,0) matrix(0.35 0.0 0.0 0.35 -3.7 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.53em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="21.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">25k</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 27.39)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.07 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.32)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">100k</span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span><span id="S4.F3.3" class="ltx_text ltx_font_bold">Neon consistently improves FID with minimal self-training overhead.</span> Minimum FID (optimized over extrapolation strength <math id="S4.F3.m9" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>) vs. self-training budget <math id="S4.F3.m10" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> (millions of images seen during fine-tuning on <math id="S4.F3.m11" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>) for varying synthetic dataset sizes <math id="S4.F3.m12" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math>, on EDM-VP (CIFAR-10/FFHQ-64) and flow matching (CIFAR-10). Optimal gains use <math id="S4.F3.m13" class="ltx_Math" alttext="\mathcal{B}\leq 3" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\mathcal{B}\leq 3</annotation></semantics></math>Mi (<math id="S4.F3.m14" class="ltx_Math" alttext="&lt;2\%" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mn>2</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">&lt;2\%</annotation></semantics></math> of base model training compute for EDM; <math id="S4.F3.m15" class="ltx_Math" alttext="&lt;3\%" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mn>3</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">&lt;3\%</annotation></semantics></math> for flow), confirming Neon’s efficiency. At <math id="S4.F3.m16" class="ltx_Math" alttext="\mathcal{B}=0" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{B}=0</annotation></semantics></math>, FID reflects the base model (no Neon).</figcaption>
</figure>
