r" fill="#000000" stroke="#908CC2" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 19.97 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">3 Mi</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 27.21)"><g style="--ltx-stroke-color:#7570B3;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#7570B3" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.87 0) translate(8.97,0) matrix(0.35 0.0 0.0 0.35 -8 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:3.31em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="45.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">3.75 Mi</span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure D.1: </span><span id="A4.F1.3" class="ltx_text ltx_font_bold">Neon’s precision-recall trade-off across diffusion and flow matching architectures.</span> FID, precision, and recall as functions of merge weight <math id="A4.F1.m6" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> for EDM-VP on FFHQ-64 with <math id="A4.F1.m7" class="ltx_Math" alttext="|\mathcal{S}|=18" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>18</mn></mrow><annotation encoding="application/x-tex">|\mathcal{S}|=18</annotation></semantics></math>k (top row) and Flow Matching on CIFAR-10 with <math id="A4.F1.m8" class="ltx_Math" alttext="|\mathcal{S}|=25" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>25</mn></mrow><annotation encoding="application/x-tex">|\mathcal{S}|=25</annotation></semantics></math>k (bottom row), shown across different fine-tuning budgets <math id="A4.F1.m9" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>. Both architectures exhibit the characteristic pattern: FID reaches a minimum at intermediate <math id="A4.F1.m10" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> values, precision monotonically decreases, and recall follows an inverted-U curve peaking near the FID optimum.</figcaption>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
