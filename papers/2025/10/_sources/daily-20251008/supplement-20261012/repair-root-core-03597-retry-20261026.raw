nt-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">4 Mi </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.23)"><g style="--ltx-stroke-color:#E17F35;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#E17F35" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.87 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">5 Mi</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 27.21)"><g style="--ltx-stroke-color:#D95F02;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#D95F02" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.87 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">6 Mi</span></span></foreignObject></g></g></g></g></g></g><g transform="matrix(1.0 0.0 0.0 1.0 358.7 2.12)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0) translate(38.3,0) translate(0,36.28)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000"><path d="M -38.02 -36 h 37.74 v 35.72 h -37.74 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -33.87 -30.25)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 30.19)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 3.15)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 22.51 0) translate(0.24,0) matrix(0.35 0.0 0.0 0.35 5.21 -1.45)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.26em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" color="#000000" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="17.49"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic1.m29" class="ltx_Math" alttext="|\mathcal{B}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{B}|</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.29)"><g style="--ltx-stroke-color:#C8C6E1;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#C8C6E1" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.87 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">3 Mi</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.26)"><g style="--ltx-stroke-color:#ACA9D2;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#ACA9D2" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.07 0) translate(6.69,0) matrix(0.35 0.0 0.0 0.35 -5.72 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">4 Mi </span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.23)"><g style="--ltx-stroke-color:#908CC2;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#908CC2" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.87 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">5 Mi</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 27.21)"><g style="--ltx-stroke-color:#7570B3;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#7570B3" stroke-width="0.8pt" transform="matrix(1 0 0 -1 0 0) translate(0.55,0)"><path style="fill:none" d="M 0 0 L 7.48 0 L 14.96 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 16.87 0) translate(5.88,0) matrix(0.35 0.0 0.0 0.35 -4.91 -1.29)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.03em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">6 Mi</span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span><span id="S4.F4.3" class="ltx_text ltx_font_bold">Neon trades precision for recall, yielding net FID improvement.</span> For the EDM-VP model trained on CIFAR-10, we plot the FID, precision, and recall vs. negative extrapolation strength <math id="S4.F4.m4" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> for various training budgets <math id="S4.F4.m5" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>. In each case, <math id="S4.F4.m6" class="ltx_Math" alttext="|\mathcal{S}|=6" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">|\mathcal{S}|=6</annotation></semantics></math>k.</figcaption>
</figure>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Diffusion and Flow Matching Models</h3>

<div id="S4.SS1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS1.p1.1" class="ltx_p">We evaluate Neon with the EDM-VP <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib27" title="" class="ltx_ref">Karras et al., 2022</a>)</cite> (CIFAR-10 conditional, FFHQ-64 unconditional) and flow matching <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib58" title="" class="ltx_ref">Tong et al., 2024</a>; <a href="#bib.bib57" title="" class="ltx_ref">Tong et al., 2023</a>)</cite> (CIFAR-10 unconditional) models using public checkpoints. The synthetic datasets <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> were generated with default inference settings.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Results.</span> 
Figure <a href="#S4.F3" title="Figure 3 ‣ 4 Experiments ‣ Neon: Negative Extrapolation From Self-Training Improves Image Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> plots the FID vs. the fine-tuning budget <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> for various <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math>.
Neon achieves substantial gains with minimal overhead:
Neon+EDM-VP trained on CIFAR-10 improves the FID from <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="1.78" display="inline" intent=":literal"><semantics><mn>1.78</mn><annotation encoding="application/x-tex">1.78</annotation></semantics></math> to <span id="S4.SS1.p2.1.2" class="ltx_text ltx_font_bold">1.38</span> using only <math id="S4.SS1.p2.m4" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>k synthetic samples and <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="1.75\%" display="inline" intent=":literal"><semantics><mrow><mn>1.75</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">1.75\%</annotation></semantics></math> extra compute compared to training the base model.
Neon+EDM-VP trained on FFHQ-64 improves the FID from <math id="S4.SS1.p2.m6" class="ltx_Math" alttext="2.39" display="inline" intent=":literal"><semantics><mn>2.39</mn><annotation encoding="application/x-tex">2.39</annotation></semantics></math> to <span id="S4.SS1.p2.1.3" class="ltx_text ltx_font_bold">1.12</span> using only <math id="S4.SS1.p2.m7" class="ltx_Math" alttext="18" display="inline" intent=":literal"><semantics><mn>18</mn><annotation encoding="application/x-tex">18</annotation></semantics></math>k samples and <math id="S4.SS1.p2.m8" class="ltx_Math" alttext="0.85\%" display="inline" intent=":literal"><semantics><mrow><mn>0.85</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">0.85\%</annotation></semantics></math> additional compute.
Neon+Flow matching on CIFAR-10 improves the FID from <math id="S4.SS1.p2.m9" class="ltx_Math" alttext="3.5" display="inline" intent=":literal"><semantics><mn>3.5</mn><annotation encoding="application/x-tex">3.5</annotation></semantics></math> to <span id="S4.SS1.p2.1.4" class="ltx_text ltx_font_bold">2.32</span> using only <math id="S4.SS1.p2.m10" class="ltx_Math" alttext="25" display="inline" intent=":literal"><semantics><mn>25</mn><annotation encoding="application/x-tex">25</annotation></semantics></math>k samples and <math id="S4.SS1.p2.m11" class="ltx_Math" alttext="3.2\%" display="inline" intent=":literal"><semantics><mrow><mn>3.2</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">3.2\%</annotation></semantics></math> additional compute.
Neon’s performance shows a non-monotonic relationship with the synthetic dataset size <math id="S4.SS1.p2.m12" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math>, with optimal performance in the range <math id="S4.SS1.p2.m13" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>k–<math id="S4.SS1.p2.m14" class="ltx_Math" alttext="25" display="inline" intent=":literal"><semantics><mn>25</mn><annotation encoding="application/x-tex">25</annotation></semantics></math>k samples.
Smaller <math id="S4.SS1.p2.m15" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math> require more precise <math id="S4.SS1.p2.m16" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> tuning but converge rapidly; larger <math id="S4.SS1.p2.m17" class="ltx_Math" alttext="|\mathcal{S}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|</annotation></semantics></math> support a wider range of <math id="S4.SS1.p2.m18" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>’s but slower convergence.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para ltx_noindent">
<p id="S4.SS1.p3.1" class="ltx_p">Figure <a href="#S4.F4" title="Figure 4 ‣ 4 Experiments ‣ Neon: Negative Extrapolation From Self-Training Improves Image Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> dissects Neon’s effect on EDM-VP trained on CIFAR-10 using precision-recall metrics with <math id="S4.SS1.p3.m1" class="ltx_math_unparsed" alttext="|\mathcal{S}=6" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">|\mathcal{S}=6</annotation></semantics></math>k. The FID vs. weight relationship (left panel) exhibits the unimodal shape predicted by our Taylor series analysis.
As fine-tuning progresses, the optimal <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="w^{*}" display="inline" intent=":literal"><semantics><msup><mi>w</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">w^{*}</annotation></semantics></math> decreases, which is consistent with <math id="S4.SS1.p3.m3" class="ltx_math_unparsed" alttext="w^{*}\approx-s/(\alpha z)" display="inline" intent=":literal"><semantics><mrow><msup><mi>w</mi><mo>∗</mo></msup><mo rspace="0em">≈</mo><mo lspace="0em">−</mo><mi>s</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w^{*}\approx-s/(\alpha z)</annotation></semantics></math>, where <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> increases with training steps.
The precision-recall trade-off (middle/right panels) reveals Neon’s mechanism: precision monotonically decreases with <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, while recall follows an inverted-U peaking near the FID-optimal weight. This aligns with our analysis: fine-tuning on synthetic data concentrates probability mass on well-captured modes, degrading coverage.
By reversing this direction, Neon redistributes mass from over-represented to under-represented regions, trading precision for improved recall and yielding net FID improvement.
These dynamics intensify with longer fine-tuning, with later checkpoints showing sharper recall peaks and steeper precision drops. (See Appendix <a href="#A4" title="Appendix D Additional experiments for diffusion and flow matching models ‣ Neon: Negative Extrapolation From Self-Training Improves Image Generation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a> for all models.)</p>
</div>
