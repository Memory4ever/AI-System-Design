<span id="A1.SS3.p3.pic1.2.2" class="ltx_p"><span id="A1.SS3.p3.pic1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Sentence 1:<span id="A1.SS3.p3.pic1.2.2.1.1" class="ltx_text ltx_font_medium"> <span id="A1.SS3.p3.pic1.2.2.1.1.1" class="ltx_text ltx_font_typewriter">{output_i}</span></span></span></span>
