-fg-color:#007D00;">is</span><span id="lstnumberx163.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">from</span><span id="lstnumberx163.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">end</span><span id="lstnumberx163.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">of</span><span id="lstnumberx163.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">game</span><span id="lstnumberx163.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">when</span><span id="lstnumberx163.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">player_id</span><span id="lstnumberx163.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">is</span><span id="lstnumberx163.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx163.32" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#007D00;">-4."""</span>
</div>
</div>
</div>
<div id="A7.SS5.p3" class="ltx_para ltx_noindent">
<p id="A7.SS5.p3.1" class="ltx_p">Note the extra argument <span id="A7.SS5.p3.1.1" class="ltx_text ltx_font_typewriter">last_is_terminal</span>. This indicates that the final observation in <span id="A7.SS5.p3.1.2" class="ltx_text ltx_font_typewriter">obs_action_history</span> is of the terminal state. This allows adding tests that resample the entire game from the beginning to the terminal state, testing the ability of the LLM to predict the final reward of the player. In open deck, the transition tests cover this. For simplicity, we assumed that the rewards are terminal but this is easy to relax.</p>
</div>
<div id="A7.SS5.p4" class="ltx_para ltx_noindent">
<p id="A7.SS5.p4.1" class="ltx_p">The corresponding <span id="A7.SS5.p4.1.1" class="ltx_text ltx_font_typewriter">unit_tests</span> for the inference function is:</p>
</div>
<div id="A7.SS5.p5" class="ltx_para ltx_noindent">
<div id="A7.SS5.p5.1" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx164" class="ltx_listingline"><span id="lstnumberx164.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">state</span><span id="lstnumberx164.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx164.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#007D00;">=</span><span id="lstnumberx164.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#007D00;"> </span><span id="lstnumberx164.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#007D00;">INITIAL_STATE</span>
</div>
