<th id="A3.T4.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" rowspan="2"><span id="A3.T4.2.1.4.1" class="ltx_text"># LLM calls</span></th></tr>
<tr id="A3.T4.2.2" class="ltx_tr">
