<th id="A3.T8.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">Random</th></tr>
<tr id="A3.T8.2.2" class="ltx_tr">
<th id="A3.T8.2.2.1" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t">Us</th>
<th id="A3.T8.2.2.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t">Them</th>
<th id="A3.T8.2.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t">Us</th>
