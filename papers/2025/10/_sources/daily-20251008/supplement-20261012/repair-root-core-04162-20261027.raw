<span id="S5.T3.3.1.1.1.1.1.1.6.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m49" class="ltx_Math" alttext="\mathbf{7.03}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">7.03</mn><annotation encoding="application/x-tex">\mathbf{7.03}</annotation></semantics></math></span>
<span id="S5.T3.3.1.1.1.1.1.1.6.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m50" class="ltx_Math" alttext="\mathbf{31.04}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">31.04</mn><annotation encoding="application/x-tex">\mathbf{31.04}</annotation></semantics></math></span>
<span id="S5.T3.3.1.1.1.1.1.1.6.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m51" class="ltx_Math" alttext="\mathbf{5.01}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">5.01</mn><annotation encoding="application/x-tex">\mathbf{5.01}</annotation></semantics></math></span>
