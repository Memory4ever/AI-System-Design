<span id="S5.T3.3.1.1.1.1.1.1.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m43" class="ltx_Math" alttext="\mathbf{10.57}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">10.57</mn><annotation encoding="application/x-tex">\mathbf{10.57}</annotation></semantics></math></span>
<span id="S5.T3.3.1.1.1.1.1.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m44" class="ltx_Math" alttext="\mathbf{38.54}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">38.54</mn><annotation encoding="application/x-tex">\mathbf{38.54}</annotation></semantics></math></span>
<span id="S5.T3.3.1.1.1.1.1.1.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m45" class="ltx_Math" alttext="\mathbf{11.27}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">11.27</mn><annotation encoding="application/x-tex">\mathbf{11.27}</annotation></semantics></math></span>
<span id="S5.T3.3.1.1.1.1.1.1.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T3.m46" class="ltx_Math" alttext="\mathbf{42.17}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">42.17</mn><annotation encoding="application/x-tex">\mathbf{42.17}</annotation></semantics></math></span>
