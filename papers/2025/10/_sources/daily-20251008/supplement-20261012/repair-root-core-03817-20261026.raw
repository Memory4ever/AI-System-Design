<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{i=0}^{k-1}p(x_{i})\log\frac{p(x_{i})}{q(x_{i})}+\sum_{i=k}^{|\mathcal{V}|-1}p(x_{i})\log\frac{\delta}{q(x_{i})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mi>k</mi></mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>δ</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i=0}^{k-1}p(x_{i})\log\frac{p(x_{i})}{q(x_{i})}+\sum_{i=k}^{|\mathcal{V}|-1}p(x_{i})\log\frac{\delta}{q(x_{i})}</annotation></semantics></math></td>
