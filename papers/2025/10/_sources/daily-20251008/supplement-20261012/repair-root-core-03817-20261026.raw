"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F5.pic1.m4" class="ltx_Math" alttext="K=16" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">K=16</annotation></semantics></math></span></span></foreignObject></g></g></g></g></g></g></svg></span><span class="ltx_inline-block"><svg id="S5.F5.pic2" class="ltx_picture" height="161.17" overflow="visible" version="1.1" viewBox="0 0 270.34 161.17" width="270.34"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,161.17) matrix(1 0 0 -1 0 0) translate(57.33,0) translate(0,43.72) matrix(1.0 0.0 0.0 1.0 -57.33 -43.72)"><g class="ltx_nestedsvg" transform="matrix(1 0 0 1 0 0) translate(57.33,0) translate(0,43.72)"><g style="--ltx-stroke-color:#B0B0B0;--ltx-fill-color:#B0B0B0;--ltx-fg-color:#B0B0B0;" color="#B0B0B0" fill="#B0B0B0" stroke="#B0B0B0" stroke-width="0.4pt"><path style="fill:none" d="M 1.03 0 L 1.03 95.21 M 45.06 0 L 45.06 95.21 M 89.09 0 L 89.09 95.21 M 133.12 0 L 133.12 95.21 M 177.16 0 L 177.16 95.21"></path></g><g style="--ltx-stroke-color:#B0B0B0;--ltx-fill-color:#B0B0B0;--ltx-fg-color:#B0B0B0;" color="#B0B0B0" fill="#B0B0B0" stroke="#B0B0B0" stroke-width="0.4pt"><path style="fill:none" d="M 0 32.25 L 212.74 32.25 M 0 77.22 L 212.74 77.22"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#808080;" color="#808080" fill="#000000" stroke="#000000" stroke-width="0.2pt"><path style="fill:none" d="M 1.03 -5.91 L 1.03 0 M 45.06 -5.91 L 45.06 0 M 89.09 -5.91 L 89.09 0 M 133.12 -5.91 L 133.12 0 M 177.16 -5.91 L 177.16 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;--ltx-fg-color:#808080;" color="#808080" fill="#000000" stroke="#000000" stroke-width="0.2pt"><path style="fill:none" d="M -5.91 32.25 L 0 32.25 M -5.91 77.22 L 0 77.22"></path></