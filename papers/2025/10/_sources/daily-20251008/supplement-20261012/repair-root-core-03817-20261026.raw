)" width="20.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic3.m3" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 106.68 -19.71)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="20.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic3.m4" class="ltx_Math" alttext="150" display="inline" intent=":literal"><semantics><mn>150</mn><annotation encoding="application/x-tex">150</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 144.56 -19.71)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="20.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic3.m5" class="ltx_Math" alttext="200" display="inline" intent=":literal"><semantics><mn>200</mn><annotation encoding="application/x-tex">200</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 182.45 -19.71)"><foreignObject style="--ltx-fo-width:1.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="20.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject