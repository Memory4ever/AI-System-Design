<thead class="ltx_thead">
<tr id="S1.T2.3.1.1" class="ltx_tr">
<th id="S1.T2.3.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S1.T2.3.1.1.1.1" class="ltx_text ltx_font_bold"># of Concepts</span></th>
<th id="S1.T2.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S1.T2.3.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S1.T2.3.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S1.T2.3.1.1.3.1" class="ltx_text ltx_font_bold">Capacity</span></th>
<th id="S1.T2.3.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S1.T2.3.1.1.4.1" class="ltx_text ltx_font_bold">Times</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S1.T2.3.1.2" class="ltx_tr">
<td id="S1.T2.3.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;" rowspan="6"><span id="S1.T2.3.1.2.1.1" class="ltx_text ltx_font_bold">Single concept</span></td>
<td id="S1.T2.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">Textual Inversion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite></td>
<td id="S1.T2.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">4.2KB</td>
<td id="S1.T2.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="S1.T2.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math> 2h</td></tr>
<tr id="S1.T2.3.1.3" class="ltx_tr">
<td id="S1.T2.3.1.3.1" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">DreamBooth <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">29</a>]</cite></td>
<td id="S1.T2.3.1.3.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">5.2GB</td>
<td id="S1.T2.3.1.3.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="S1.T2.m2" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math> 7m</td></tr>
<tr id="S1.T2.3.1.4" class="ltx_tr">
<td id="S1.T2.3.1.4.1" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">Custom Diffusion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite></td>
<td id="S1.T2.3.1.4.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">97.5MB</td>
<td id="S1.T2.3.1.4.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><math id="S1.T2.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math> 12m</td></tr>
<tr id="S1.T2.3.1.5" class="ltx_tr">
<td id="S1.T2.3.1.5.1" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">Cones 2 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">21</a>]</cite></td>
<td id="S1.T2.3.1.5.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">4.2KB</td>
