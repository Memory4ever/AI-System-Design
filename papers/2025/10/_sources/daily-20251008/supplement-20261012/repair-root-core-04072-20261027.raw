<th id="S4.T2.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Base</th>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t">20.40</td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t">17.90</td></tr>
<tr id="S4.T2.2.3" class="ltx_tr">
<th id="S4.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GRPO</th>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center">32.92</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center">25.83</td></tr>
<tr id="S4.T2.2.4" class="ltx_tr">
<th id="S4.T2.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="--ltx-bg-color:#DCF0F3;"><span id="S4.T2.2.4.1.1" class="ltx_text" style="--ltx-bg-color:#DCF0F3;">SFPO</span></th>
<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DCF0F3;"><span id="S4.T2.2.4.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DCF0F3;">34.17</span></td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DCF0F3;"><span id="S4.T2.2.4.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#DCF0F3;">27.50</span></td></tr>
<tr id="S4.T2.2.5" class="ltx_tr">
<th id="S4.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="3"><span id="S4.T2.2.5.1.1" class="ltx_text ltx_font_bold">DS-Qwen-7B</span></th>
<th id="S4.T2.2.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Base</th>
