<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proofs of Theoretical Results</h2>

<div id="Thmdefinition2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmdefinition2.2" class="ltx_text ltx_font_bold">Definition 2</span></span><span id="Thmdefinition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmdefinition2.p1" class="ltx_para ltx_noindent">
<p id="Thmdefinition2.p1.1" class="ltx_p"><span id="Thmdefinition2.p1.1.1" class="ltx_text ltx_font_italic">Consider an <math id="Thmdefinition2.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-layer MLP with ReLU activation functions:</span></p>
<ul id="A1.I1" class="ltx_itemize">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i1.p1.1" class="ltx_p"><span id="A1.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">Input: </span><math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="\mathbf{h}^{(0)}=\mathbf{x}\in\mathbb{R}^{1\times n_{0}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mn>0</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(0)}=\mathbf{x}\in\mathbb{R}^{1\times n_{0}}</annotation></semantics></math></p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i2.p1.1" class="ltx_p"><span id="A1.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">Hidden Layers: </span><math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\mathbf{h}^{(l)}=\mathsf{ReLU}(\mathbf{f}^{(l)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mi>𝖱𝖾𝖫𝖴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(l)}=\mathsf{ReLU}(\mathbf{f}^{(l)})</annotation></semantics></math><span id="A1.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, where </span><math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="\mathbf{f}^{(l)}=\mathbf{h}^{(l-1)}\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}^{(l)}=\mathbf{h}^{(l-1)}\mathbf{W}_{l}</annotation></semantics></math><span id="A1.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> for </span><math id="A1.I1.i2.p1.m3" class="ltx_Math" alttext="l=1,\dots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\dots,L</annotation></semantics></math><span id="A1.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i3.p1.1" class="ltx_p"><math id="A1.I1.i3.p1.m1" class="ltx_Math" alttext="\mathbf{W}_{l}\in\mathbb{R}^{n_{l-1}\times n_{l}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mi>l</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>n</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mi>l</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{W}_{l}\in\mathbb{R}^{n_{l-1}\times n_{l}}</annotation></semantics></math><span id="A1.I1.i3.p1.1.1" class="ltx_text ltx_font_italic"> is the weight matrix for layer </span><math id="A1.I1.i3.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math><span id="A1.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A1.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i4.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i4.p1.1" class="ltx_p"><math id="A1.I1.i4.p1.m1" class="ltx_Math" alttext="\mathbf{h}^{(l)}\in\mathbb{R}^{1\times n_{l}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mi>l</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(l)}\in\mathbb{R}^{1\times n_{l}}</annotation></semantics></math><span id="A1.I1.i4.p1.1.1" class="ltx_text ltx_font_italic"> is the activation vector of layer </span><math id="A1.I1.i4.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math><span id="A1.I1.i4.p1.1.2" class="ltx_text ltx_font_italic">. (We use row vectors for activations).</span></p>
</div></li>
<li id="A1.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i5.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i5.p1.1" class="ltx_p"><math id="A1.I1.i5.p1.m1" class="ltx_Math" alttext="\mathbf{f}^{(l)}\in\mathbb{R}^{1\times n_{l}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mi>l</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{f}^{(l)}\in\mathbb{R}^{1\times n_{l}}</annotation></semantics></math><span id="A1.I1.i5.p1.1.1" class="ltx_text ltx_font_italic"> is the pre-activation vector of layer </span><math id="A1.I1.i5.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math><span id="A1.I1.i5.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A1.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I1.i6.p1" class="ltx_para">
<p id="A1.I1.i6.p1.1" class="ltx_p"><span id="A1.I1.i6.p1.1.1" class="ltx_text ltx_font_italic">Output: </span><math id="A1.I1.i6.p1.m1" class="ltx_Math" alttext="\mathbf{h}^{(L)}\in\mathbb{R}^{1\times n_{L}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mi>L</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(L)}\in\mathbb{R}^{1\times n_{L}}</annotation></semantics></math><span id="A1.I1.i6.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Proof with respect to parameters</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">First we derive the gradient expression of the weight matrix <math id="A1.SS1.p1.m1" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math>
under the cross-entropy loss function,
which is given by the following theorem:</p>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Gradient Expression for Linear Layers)<span id="Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Given an <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-layer Multilayer Perceptron (MLP) with the ReLU activation function, i.e., <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathbf{h}^{(l)}=\text{ReLU}(\mathbf{h}^{(l-1)}\mathbf{W}_{l})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mtext class="ltx_mathvariant_italic">ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(l)}=\text{ReLU}(\mathbf{h}^{(l-1)}\mathbf{W}_{l})</annotation></semantics></math>,
where <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="\mathbf{h}^{(0)}=\mathbf{x},l=1\dots L" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>𝐱</mi></mrow><mo>,</mo><mrow><mi>l</mi><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(0)}=\mathbf{x},l=1\dots L</annotation></semantics></math>. Let <math id="Thmtheorem2.p1.m4" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> be a cross-entropy loss function that depends on the final output <math id="Thmtheorem2.p1.m5" class="ltx_Math" alttext="\mathbf{h}^{(L)}" display="inline" intent=":literal"><semantics><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{h}^{(L)}</annotation></semantics></math>.
Then, the gradient of the loss function <math id="Thmtheorem2.p1.m6" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> with respect to the weight matrix <math id="Thmtheorem2.p1.m7" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math> can be approximated as:</span></p>
<table id="A1.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex2.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\approx(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>≈</mo><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mtext class="ltx_mathvariant_italic">Diag</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\approx(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem2.p1.m8" class="ltx_Math" alttext="\mathbf{p}-\mathbf{t}" display="inline" intent=":literal"><semantics><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><annotation encoding="application/x-tex">\mathbf{p}-\mathbf{t}</annotation></semantics></math> is a term related to the gradient of the loss function at the output layer,
and <math id="Thmtheorem2.p1.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is a scalar approximation factor.</span></p>
</div>
</div>
<div id="A1.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS1.p2.1" class="ltx_p"><span id="A1.SS1.p2.1.1" class="ltx_text">By the chain rule of differentiation and matrix differentiation rules, the gradient of the weight matrix is given by:</span></p>
<table id="A1.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex3.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}=\left(\frac{\partial\mathbf{f}^{(l)}}{\partial\mathbf{W}_{l}}\right)^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}=(\mathbf{h}^{(l-1)})^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>=</mo><mrow><msup><mrow><mo>(</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}=\left(\frac{\partial\mathbf{f}^{(l)}}{\partial\mathbf{W}_{l}}\right)^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}=(\mathbf{h}^{(l-1)})^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.2" class="ltx_p"><span id="A1.SS1.p2.2.1" class="ltx_text">where the second equality is obtained by differentiating the linear layer’s forward propagation expression <math id="A1.SS1.p2.m1" class="ltx_Math" alttext="\mathbf{f}^{(l)}=\mathbf{h}^{(l-1)}\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}^{(l)}=\mathbf{h}^{(l-1)}\mathbf{W}_{l}</annotation></semantics></math> with respect to <math id="A1.SS1.p2.m2" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS1.p3" class="ltx_para ltx_noindent">
<p id="A1.SS1.p3.1" class="ltx_p"><span id="A1.SS1.p3.1.1" class="ltx_text">To find <math id="A1.SS1.p3.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}</annotation></semantics></math>,
the gradient must be backpropagated from the network output <math id="A1.SS1.p3.m2" class="ltx_Math" alttext="h^{(L)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(L)}</annotation></semantics></math> to the <math id="A1.SS1.p3.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th layer along the computation graph. This process also follows the chain rule:</span></p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}=\frac{\partial\mathcal{L}}{\partial\mathbf{h}^{(L)}}\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{f}^{(l)}}=(\mathbf{p}-\mathbf{t})\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{f}^{(l)}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>=</mo><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}=\frac{\partial\mathcal{L}}{\partial\mathbf{h}^{(L)}}\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{f}^{(l)}}=(\mathbf{p}-\mathbf{t})\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{f}^{(l)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p3.2" class="ltx_p"><span id="A1.SS1.p3.2.1" class="ltx_text">where the second equality holds because <math id="A1.SS1.p3.m4" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is a cross-entropy loss function.
Therefore, its gradient with respect to the final network output <math id="A1.SS1.p3.m5" class="ltx_Math" alttext="\mathbf{h}^{(L)}" display="inline" intent=":literal"><semantics><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{h}^{(L)}</annotation></semantics></math> (i.e., the logits) is <math id="A1.SS1.p3.m6" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{h}^{(L)}}=\mathbf{p}-\mathbf{t}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>=</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{h}^{(L)}}=\mathbf{p}-\mathbf{t}</annotation></semantics></math>, where <math id="A1.SS1.p3.m7" class="ltx_Math" alttext="\mathbf{p}" display="inline" intent=":literal"><semantics><mi>𝐩</mi><annotation encoding="application/x-tex">\mathbf{p}</annotation></semantics></math> is the probability distribution row vector output by the network via the Softmax function, and <math id="A1.SS1.p3.m8" class="ltx_Math" alttext="\mathbf{t}" display="inline" intent=":literal"><semantics><mi>𝐭</mi><annotation encoding="application/x-tex">\mathbf{t}</annotation></semantics></math> is the one-hot encoded row vector corresponding to the true label.</span></p>
</div>
<div id="A1.SS1.p4" class="ltx_para ltx_noindent">
<p id="A1.SS1.p4.1" class="ltx_p"><span id="A1.SS1.p4.1.1" class="ltx_text">The second term in the expression for <math id="A1.SS1.p4.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{f}^{(l)}}</annotation></semantics></math>,
<math id="A1.SS1.p4.m2" class="ltx_Math" alttext="\frac{\partial h^{(L)}}{\partial f^{(l)}}\in\mathbb{R}^{n_{L}\times n_{l}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>n</mi><mi>L</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>n</mi><mi>l</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\frac{\partial h^{(L)}}{\partial f^{(l)}}\in\mathbb{R}^{n_{L}\times n_{l}}</annotation></semantics></math>, is a Jacobian matrix that describes the local linear behavior of the nonlinear mapping from the pre-activation of the <math id="A1.SS1.p4.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th layer to the final network output. It can be found by the chain rule for composite functions, expressed as a product of the Jacobian matrices of each layer from layer <math id="A1.SS1.p4.m4" class="ltx_Math" alttext="l+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l+1</annotation></semantics></math> to layer <math id="A1.SS1.p4.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>:</span></p>
<table id="A1.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_math_unparsed" alttext="\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{f}^{(l)}}=\left(\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{h}^{(L-1)}}\right)\cdots\left(\frac{\partial\mathbf{h}^{(l+1)}}{\partial\mathbf{h}^{(l)}}\right)\left(\frac{\partial\mathbf{h}^{(l)}}{\partial\mathbf{f}^{(l)}}\right)=\left(\prod_{k=l+1}^{L}\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{h}^{(k-1)}}\right)\frac{\partial\mathbf{h}^{(l)}}{\partial\mathbf{f}^{(l)}}" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>=</mo><mrow><mo>(</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo>(</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mrow><mo>(</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mo>=</mo><mrow><mo>(</mo><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>L</mi></munderover><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{f}^{(l)}}=\left(\frac{\partial\mathbf{h}^{(L)}}{\partial\mathbf{h}^{(L-1)}}\right)\cdots\left(\frac{\partial\mathbf{h}^{(l+1)}}{\partial\mathbf{h}^{(l)}}\right)\left(\frac{\partial\mathbf{h}^{(l)}}{\partial\mathbf{f}^{(l)}}\right)=\left(\prod_{k=l+1}^{L}\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{h}^{(k-1)}}\right)\frac{\partial\mathbf{h}^{(l)}}{\partial\mathbf{f}^{(l)}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p5" class="ltx_para ltx_noindent">
<p id="A1.SS1.p5.1" class="ltx_p"><span id="A1.SS1.p5.1.1" class="ltx_text">Since the activation function is ReLU, <math id="A1.SS1.p5.m1" class="ltx_Math" alttext="\mathbf{h}^{(l)}=\text{ReLU}(\mathbf{f}^{(l)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mtext>ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}^{(l)}=\text{ReLU}(\mathbf{f}^{(l)})</annotation></semantics></math>, its corresponding Jacobian matrix is a diagonal matrix:</span></p>
<table id="A1.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\frac{\partial\mathbf{h}^{(l)}}{\partial\mathbf{f}^{(l)}}=\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>=</mo><mrow><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathbf{h}^{(l)}}{\partial\mathbf{f}^{(l)}}=\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p5.2" class="ltx_p"><span id="A1.SS1.p5.2.1" class="ltx_text">Its diagonal elements are determined by the sign of the pre-activation values of that layer, being either 1 or 0. Similarly, by the chain rule,
the intra-layer Jacobian of network layer <math id="A1.SS1.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, <math id="A1.SS1.p5.m3" class="ltx_Math" alttext="\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{h}^{(k-1)}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{h}^{(k-1)}}</annotation></semantics></math>, is:</span></p>
<table id="A1.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{h}^{(k-1)}}=\frac{\partial\mathbf{f}^{(k)}}{\partial\mathbf{h}^{(k-1)}}\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{f}^{(k)}}=\mathbf{W}_{k}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>=</mo><mrow><mfrac><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mo>∂</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mrow><mo>=</mo><mrow><msub><mi>𝐖</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{h}^{(k-1)}}=\frac{\partial\mathbf{f}^{(k)}}{\partial\mathbf{h}^{(k-1)}}\frac{\partial\mathbf{h}^{(k)}}{\partial\mathbf{f}^{(k)}}=\mathbf{W}_{k}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p6" class="ltx_para ltx_noindent">
<p id="A1.SS1.p6.1" class="ltx_p"><span id="A1.SS1.p6.1.1" class="ltx_text">Thus, we have obtained the exact expression for the gradient:</span></p>
<table id="A1.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E4.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}=(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))\right)\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}=(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))\right)\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p7" class="ltx_para ltx_noindent">
<p id="A1.SS1.p7.1" class="ltx_p"><span id="A1.SS1.p7.1.1" class="ltx_text">The above equation contains complex Diag terms that depend on the instantaneous activation state,
making the Jacobian matrix a product of a series of random matrices, which is difficult to analyze directly.
To obtain an expression that is more tractable for theoretical analysis, we adopt a mean-field approximation method, which is common in deep learning theory.</span></p>
</div>
<div id="A1.SS1.p8" class="ltx_para ltx_noindent">
<p id="A1.SS1.p8.1" class="ltx_p"><span id="A1.SS1.p8.1.1" class="ltx_text">Consider any scalar path from a neuron in the <math id="A1.SS1.p8.m1" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th layer to a neuron in the <math id="A1.SS1.p8.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-th layer in the computation graph. The validity of this path depends on whether all ReLU units along the way are activated.
Assuming the network is sufficiently deep and the parameters are randomly initialized,
it can be argued that this series of random, data-dependent multiplicative gating effects
<math id="A1.SS1.p8.m3" class="ltx_Math" alttext="\prod_{k=L}^{l+1}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mrow><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{k=L}^{l+1}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))</annotation></semantics></math>
can be replaced by its mean effect.</span></p>
</div>
<div id="A1.SS1.p9" class="ltx_para ltx_noindent">
<p id="A1.SS1.p9.1" class="ltx_p"><span id="A1.SS1.p9.1.1" class="ltx_text">We consider the dynamics of the network as follows: during training, for any such path, the probability of it being activated is the same, denoted by a scalar constant <math id="A1.SS1.p9.m1" class="ltx_Math" alttext="\rho\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in[0,1]</annotation></semantics></math>.
This consideration reflects the mean-field approximation viewpoint, i.e., that the validity of the path for gradient signal propagation is uniform throughout the network.</span></p>
</div>
<div id="A1.SS1.p10" class="ltx_para ltx_noindent">
<p id="A1.SS1.p10.1" class="ltx_p"><span id="A1.SS1.p10.1.1" class="ltx_text">Based on this, we approximate the complex, instantaneous activation-dependent Diag matrices in the exact expression (<a href="#A1.E4" title="Equation 4 ‣ Proof. ‣ A.1 Proof with respect to parameters ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>),
modeling their overall effect as a scalar factor <math id="A1.SS1.p10.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> times the product of the transposed weights:</span></p>
<table id="A1.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E5.m1" class="ltx_Math" alttext="\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))\right)\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))\approx\rho\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\text{Diag}(\mathds{1}(\mathbf{f}^{(k)}&gt;0))\right)\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))\approx\rho\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p10.2" class="ltx_p"><span id="A1.SS1.p10.2.1" class="ltx_text">Here, <math id="A1.SS1.p10.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is defined as the expected probability of any scalar path from layer <math id="A1.SS1.p10.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> to layer <math id="A1.SS1.p10.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> being activated, and the <math id="A1.SS1.p10.m5" class="ltx_Math" alttext="\prod" display="inline" intent=":literal"><semantics><mo>∏</mo><annotation encoding="application/x-tex">\prod</annotation></semantics></math> symbol denotes the continued product of matrices. The above approximation captures the average strength of gradient propagation while ignoring sample-specific activation fluctuations.</span></p>
</div>
<div id="A1.SS1.p11" class="ltx_para ltx_noindent">
<p id="A1.SS1.p11.1" class="ltx_p"><span id="A1.SS1.p11.1.1" class="ltx_text">Substituting the approximation (<a href="#A1.E5" title="Equation 5 ‣ Proof. ‣ A.1 Proof with respect to parameters ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) into the expression (<a href="#A1.E4" title="Equation 4 ‣ Proof. ‣ A.1 Proof with respect to parameters ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>),
and retaining the activation term of the current layer <math id="A1.SS1.p11.m1" class="ltx_Math" alttext="\text{Diag}(\mathbf{1}(\mathbf{f}^{(l)}&gt;0))" display="inline" intent=":literal"><semantics><mrow><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Diag}(\mathbf{1}(\mathbf{f}^{(l)}&gt;0))</annotation></semantics></math>, we obtain the final approximate gradient expression:</span></p>
<table id="A1.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex8.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\approx(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>≈</mo><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mtext>Diag</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\approx(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p11.2" class="ltx_p"><span id="A1.SS1.p11.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.SS1.p12" class="ltx_para ltx_noindent">
<p id="A1.SS1.p12.1" class="ltx_p">For a linear layer <math id="A1.SS1.p12.m1" class="ltx_Math" alttext="\mathbf{f}^{(l)}=\mathbf{h}^{(l-1)}\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{f}^{(l)}=\mathbf{h}^{(l-1)}\mathbf{W}_{l}</annotation></semantics></math>
in a deep neural network,
we now derive the condition under which the spectral norm <math id="A1.SS1.p12.m2" class="ltx_Math" alttext="\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math> increases after a parameter update.</p>
</div>
<div id="A1.SS1.p13" class="ltx_para ltx_noindent">
<p id="A1.SS1.p13.1" class="ltx_p">Under gradient descent, the update rule for the weight matrix <math id="A1.SS1.p13.m1" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math> is:</p>
<table id="A1.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\mathbf{W}_{l,\text{new}}=\mathbf{W}_{l}-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>l</mi><mo>,</mo><mtext>new</mtext></mrow></msub><mo>=</mo><mrow><msub><mi>𝐖</mi><mi>l</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{W}_{l,\text{new}}=\mathbf{W}_{l}-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p13.2" class="ltx_p">To analyze the change in the spectral norm of <math id="A1.SS1.p13.m2" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math> after this update,
we rely on matrix perturbation theory.
The updated matrix can be seen as the original matrix <math id="A1.SS1.p13.m3" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math>
plus a small perturbation <math id="A1.SS1.p13.m4" class="ltx_Math" alttext="-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}</annotation></semantics></math>.
The following theorem describes the spectral norm increasing under such a perturbation.</p>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Change in Spectral Norm under Perturbation)<span id="Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem3.p1.1" class="ltx_p"><span id="Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem3.p1.m1" class="ltx_Math" alttext="A\in\mathbb{R}^{m\times n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A\in\mathbb{R}^{m\times n}</annotation></semantics></math> be a matrix,
whose singular value decomposition is <math id="Thmtheorem3.p1.m2" class="ltx_Math" alttext="\mathbf{A}=\mathbf{U}\bm{\Sigma}\mathbf{V}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>=</mo><mrow><mi>𝐔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐕</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}=\mathbf{U}\bm{\Sigma}\mathbf{V}^{\top}</annotation></semantics></math>, where <math id="Thmtheorem3.p1.m3" class="ltx_Math" alttext="\sigma_{1}=\|\mathbf{A}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\sigma_{1}=\|\mathbf{A}\|_{2}</annotation></semantics></math> is the principal singular value.
If a small perturbation <math id="Thmtheorem3.p1.m4" class="ltx_Math" alttext="\eta\mathbf{B}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><annotation encoding="application/x-tex">\eta\mathbf{B}</annotation></semantics></math> is applied to it,
then the change in its spectral norm is approximately equal to the projection of the perturbation <math id="Thmtheorem3.p1.m5" class="ltx_Math" alttext="\eta\mathbf{B}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><annotation encoding="application/x-tex">\eta\mathbf{B}</annotation></semantics></math> onto the principal singular directions of <math id="Thmtheorem3.p1.m6" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math>, i.e.:</span></p>
<table id="A1.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E6.m1" class="ltx_Math" alttext="\|\mathbf{A}+\eta\mathbf{B}\|_{2}=\sigma_{1}+\eta\cdot\langle\mathbf{u}_{1}^{\top}\mathbf{B},\mathbf{v}_{1}^{\top}\rangle+o(\eta\|\mathbf{B}\|_{2})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>,</mo><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{A}+\eta\mathbf{B}\|_{2}=\sigma_{1}+\eta\cdot\langle\mathbf{u}_{1}^{\top}\mathbf{B},\mathbf{v}_{1}^{\top}\rangle+o(\eta\|\mathbf{B}\|_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="Thmtheorem3.p1.2" class="ltx_p"><span id="Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem3.p1.m7" class="ltx_Math" alttext="\mathbf{u}_{1},\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{u}_{1},\mathbf{v}_{1}</annotation></semantics></math> are the principal left and right singular vectors of matrix <math id="Thmtheorem3.p1.m8" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math>, respectively.</span></p>
</div>
</div>
<div id="A1.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS1.p14" class="ltx_para ltx_noindent">
<p id="A1.SS1.p14.1" class="ltx_p"><span id="A1.SS1.p14.1.1" class="ltx_text">Let the function be <math id="A1.SS1.p14.m1" class="ltx_Math" alttext="f(\eta)=\|\mathbf{A}+\eta\mathbf{B}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f(\eta)=\|\mathbf{A}+\eta\mathbf{B}\|_{2}</annotation></semantics></math>.
We compute the first-order Taylor expansion of <math id="A1.SS1.p14.m2" class="ltx_Math" alttext="f(\eta)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\eta)</annotation></semantics></math> at <math id="A1.SS1.p14.m3" class="ltx_Math" alttext="\eta=0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta=0</annotation></semantics></math>. According to the definition of the spectral norm, we have <math id="A1.SS1.p14.m4" class="ltx_Math" alttext="f(\eta)^{2}=\lambda_{\max}((\mathbf{A}+\eta\mathbf{B})^{\top}(\mathbf{A}+\eta\mathbf{B}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(\eta)^{2}=\lambda_{\max}((\mathbf{A}+\eta\mathbf{B})^{\top}(\mathbf{A}+\eta\mathbf{B}))</annotation></semantics></math>, where <math id="A1.SS1.p14.m5" class="ltx_Math" alttext="\lambda_{\max}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\max}(\cdot)</annotation></semantics></math> denotes the largest eigenvalue of a symmetric matrix.</span></p>
</div>
<div id="A1.SS1.p15" class="ltx_para ltx_noindent">
<p id="A1.SS1.p15.1" class="ltx_p"><span id="A1.SS1.p15.1.1" class="ltx_text">Let <math id="A1.SS1.p15.m1" class="ltx_Math" alttext="\mathbf{M}(\eta)=(\mathbf{A}+\eta\mathbf{B})^{\top}(\mathbf{A}+\eta\mathbf{B})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}(\eta)=(\mathbf{A}+\eta\mathbf{B})^{\top}(\mathbf{A}+\eta\mathbf{B})</annotation></semantics></math>. Expanding this gives:</span></p>
<table id="A1.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\mathbf{M}(\eta)=\mathbf{A}^{\top}\mathbf{A}+\eta(\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A})+\eta^{2}\mathbf{B}^{\top}\mathbf{B}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow><mo>+</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>+</mo><mrow><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}(\eta)=\mathbf{A}^{\top}\mathbf{A}+\eta(\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A})+\eta^{2}\mathbf{B}^{\top}\mathbf{B}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p15.2" class="ltx_p"><span id="A1.SS1.p15.2.1" class="ltx_text">Let <math id="A1.SS1.p15.m2" class="ltx_Math" alttext="\lambda(\eta)=\lambda_{\max}(\mathbf{M}(\eta))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>λ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(\eta)=\lambda_{\max}(\mathbf{M}(\eta))</annotation></semantics></math> and <math id="A1.SS1.p15.m3" class="ltx_Math" alttext="\mathbf{v}(\eta)" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}(\eta)</annotation></semantics></math> be its corresponding normalized eigenvector. In the unperturbed case, i.e., when <math id="A1.SS1.p15.m4" class="ltx_Math" alttext="\eta=0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta=0</annotation></semantics></math>, <math id="A1.SS1.p15.m5" class="ltx_Math" alttext="\mathbf{M}(0)=\mathbf{A}^{\top}\mathbf{A}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}(0)=\mathbf{A}^{\top}\mathbf{A}</annotation></semantics></math>. Its largest eigenvalue is <math id="A1.SS1.p15.m6" class="ltx_Math" alttext="\lambda(0)=\sigma_{1}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mi>σ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\lambda(0)=\sigma_{1}^{2}</annotation></semantics></math>, and the corresponding eigenvector is <math id="A1.SS1.p15.m7" class="ltx_Math" alttext="\mathbf{v}(0)=\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{v}(0)=\mathbf{v}_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS1.p16" class="ltx_para ltx_noindent">
<p id="A1.SS1.p16.1" class="ltx_p"><span id="A1.SS1.p16.1.1" class="ltx_text">According to the eigenvalue perturbation theory for symmetric matrices, the derivative of the eigenvalue with respect to the perturbation parameter is given by:</span></p>
<table id="A1.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\lambda^{\prime}(\eta)=\mathbf{v}(\eta)^{\top}\mathbf{M}^{\prime}(\eta)\mathbf{v}(\eta)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐌</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda^{\prime}(\eta)=\mathbf{v}(\eta)^{\top}\mathbf{M}^{\prime}(\eta)\mathbf{v}(\eta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.2" class="ltx_p"><span id="A1.SS1.p16.2.1" class="ltx_text">where <math id="A1.SS1.p16.m1" class="ltx_Math" alttext="\mathbf{M}^{\prime}(\eta)=\frac{d\mathbf{M}(\eta)}{d\eta}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐌</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbf{M}^{\prime}(\eta)=\frac{d\mathbf{M}(\eta)}{d\eta}</annotation></semantics></math>. Differentiating <math id="A1.SS1.p16.m2" class="ltx_Math" alttext="\mathbf{M}(\eta)" display="inline" intent=":literal"><semantics><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}(\eta)</annotation></semantics></math>, we get:</span></p>
<table id="A1.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\mathbf{M}^{\prime}(\eta)=\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A}+2\eta\mathbf{B}^{\top}\mathbf{B}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐌</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>+</mo><mrow><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}^{\prime}(\eta)=\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A}+2\eta\mathbf{B}^{\top}\mathbf{B}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.3" class="ltx_p"><span id="A1.SS1.p16.3.1" class="ltx_text">At <math id="A1.SS1.p16.m3" class="ltx_Math" alttext="\eta=0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta=0</annotation></semantics></math>, the derivative is <math id="A1.SS1.p16.m4" class="ltx_Math" alttext="\mathbf{M}^{\prime}(0)=\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐌</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>+</mo><mrow><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}^{\prime}(0)=\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A}</annotation></semantics></math>. Therefore, the derivative of the eigenvalue at <math id="A1.SS1.p16.m5" class="ltx_Math" alttext="\eta=0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta=0</annotation></semantics></math> is:</span></p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\lambda^{\prime}(0)=\mathbf{v}(0)^{\top}\mathbf{M}^{\prime}(0)\mathbf{v}(0)=\mathbf{v}_{1}^{\top}(\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A})\mathbf{v}_{1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐌</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>+</mo><mrow><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐯</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda^{\prime}(0)=\mathbf{v}(0)^{\top}\mathbf{M}^{\prime}(0)\mathbf{v}(0)=\mathbf{v}_{1}^{\top}(\mathbf{A}^{\top}\mathbf{B}+\mathbf{B}^{\top}\mathbf{A})\mathbf{v}_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.4" class="ltx_p"><span id="A1.SS1.p16.4.1" class="ltx_text">Expanding this expression:</span></p>
<table id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\lambda^{\prime}(0)=\mathbf{v}_{1}^{\top}\mathbf{A}^{\top}\mathbf{B}\mathbf{v}_{1}+\mathbf{v}_{1}^{\top}\mathbf{B}^{\top}\mathbf{A}\mathbf{v}_{1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐀𝐯</mi><mn>1</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda^{\prime}(0)=\mathbf{v}_{1}^{\top}\mathbf{A}^{\top}\mathbf{B}\mathbf{v}_{1}+\mathbf{v}_{1}^{\top}\mathbf{B}^{\top}\mathbf{A}\mathbf{v}_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.5" class="ltx_p"><span id="A1.SS1.p16.5.1" class="ltx_text">From the properties of singular value decomposition, we have <math id="A1.SS1.p16.m6" class="ltx_Math" alttext="\mathbf{A}\mathbf{v}_{1}=\sigma_{1}\mathbf{u}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐀𝐯</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}\mathbf{v}_{1}=\sigma_{1}\mathbf{u}_{1}</annotation></semantics></math>, and thus <math id="A1.SS1.p16.m7" class="ltx_Math" alttext="(\mathbf{A}\mathbf{v}_{1})^{\top}=\mathbf{v}_{1}^{\top}\mathbf{A}^{\top}=\sigma_{1}\mathbf{u}_{1}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐀𝐯</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>=</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{A}\mathbf{v}_{1})^{\top}=\mathbf{v}_{1}^{\top}\mathbf{A}^{\top}=\sigma_{1}\mathbf{u}_{1}^{\top}</annotation></semantics></math>. Substituting this into the equation gives:</span></p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\lambda^{\prime}(0)=\sigma_{1}\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}+\mathbf{v}_{1}^{\top}\mathbf{B}^{\top}(\sigma_{1}\mathbf{u}_{1})=\sigma_{1}\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}+\sigma_{1}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐮</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda^{\prime}(0)=\sigma_{1}\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}+\mathbf{v}_{1}^{\top}\mathbf{B}^{\top}(\sigma_{1}\mathbf{u}_{1})=\sigma_{1}\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}+\sigma_{1}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.6" class="ltx_p"><span id="A1.SS1.p16.6.1" class="ltx_text">Since <math id="A1.SS1.p16.m8" class="ltx_Math" alttext="\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}</annotation></semantics></math> is a scalar, its value is equal to its transpose, so:</span></p>
<table id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\lambda^{\prime}(0)=2\sigma_{1}\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda^{\prime}(0)=2\sigma_{1}\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.7" class="ltx_p"><span id="A1.SS1.p16.7.1" class="ltx_text">Now, we perform a first-order Taylor expansion of <math id="A1.SS1.p16.m9" class="ltx_Math" alttext="\lambda(\eta)=\|\mathbf{A}+\eta\mathbf{B}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\lambda(\eta)=\|\mathbf{A}+\eta\mathbf{B}\|_{2}^{2}</annotation></semantics></math> at <math id="A1.SS1.p16.m10" class="ltx_Math" alttext="\eta=0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta=0</annotation></semantics></math>:</span></p>
<table id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\lambda(\eta)=\lambda(0)+\eta\lambda^{\prime}(0)+O(\eta^{2})" display="block" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(\eta)=\lambda(0)+\eta\lambda^{\prime}(0)+O(\eta^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\|\mathbf{A}+\eta\mathbf{B}\|_{2}^{2}=\sigma_{1}^{2}+2\eta\sigma_{1}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})" display="block" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mrow><msubsup><mi>σ</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{A}+\eta\mathbf{B}\|_{2}^{2}=\sigma_{1}^{2}+2\eta\sigma_{1}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.8" class="ltx_p"><span id="A1.SS1.p16.8.1" class="ltx_text">To find <math id="A1.SS1.p16.m11" class="ltx_Math" alttext="\|\mathbf{A}+\eta\mathbf{B}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\mathbf{A}+\eta\mathbf{B}\|_{2}</annotation></semantics></math>, we take the square root of both sides of the equation:</span></p>
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex19.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{A}+\eta\mathbf{B}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\mathbf{A}+\eta\mathbf{B}\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{\sigma_{1}^{2}+2\eta\sigma_{1}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msqrt><mrow><msubsup><mi>σ</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{\sigma_{1}^{2}+2\eta\sigma_{1}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\displaystyle=\sigma_{1}\sqrt{1+\frac{2\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msub><mi>σ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{1}\sqrt{1+\frac{2\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.9" class="ltx_p"><span id="A1.SS1.p16.9.1" class="ltx_text">Using the approximation <math id="A1.SS1.p16.m12" class="ltx_Math" alttext="\sqrt{1+x}=1+\frac{1}{2}x+O(x^{2})" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></msqrt><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sqrt{1+x}=1+\frac{1}{2}x+O(x^{2})</annotation></semantics></math> for <math id="A1.SS1.p16.m13" class="ltx_Math" alttext="x\to 0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x\to 0</annotation></semantics></math>, let <math id="A1.SS1.p16.m14" class="ltx_Math" alttext="x=\frac{2\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msub><mi>σ</mi><mn>1</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x=\frac{2\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})</annotation></semantics></math>, we get:</span></p>
<table id="A1.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\displaystyle\|\mathbf{A}+\eta\mathbf{B}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\|\mathbf{A}+\eta\mathbf{B}\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\sigma_{1}\left(1+\frac{1}{2}\cdot\frac{2\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msub><mi>σ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{1}\left(1+\frac{1}{2}\cdot\frac{2\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+O(\eta^{2})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle=\sigma_{1}\left(1+\frac{\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})\right)+o(\eta)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><msub><mi>σ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{1}\left(1+\frac{\eta}{\sigma_{1}}(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})\right)+o(\eta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\displaystyle=\sigma_{1}+\eta(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+o(\eta)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sigma_{1}+\eta(\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1})+o(\eta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.10" class="ltx_p"><span id="A1.SS1.p16.10.1" class="ltx_text">Writing the inner product form <math id="A1.SS1.p16.m15" class="ltx_Math" alttext="\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐁𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathbf{u}_{1}^{\top}\mathbf{B}\mathbf{v}_{1}</annotation></semantics></math> as
<math id="A1.SS1.p16.m16" class="ltx_Math" alttext="\eta\cdot\langle\mathbf{u}_{1}^{\top}\mathbf{B},\mathbf{v}_{1}^{\top}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>,</mo><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\cdot\langle\mathbf{u}_{1}^{\top}\mathbf{B},\mathbf{v}_{1}^{\top}\rangle</annotation></semantics></math>,
we finally obtain the expression for the spectral norm of <math id="A1.SS1.p16.m17" class="ltx_Math" alttext="\mathbf{A}+\eta\mathbf{B}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}+\eta\mathbf{B}</annotation></semantics></math>:</span></p>
<table id="A1.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\|\mathbf{A}+\eta\mathbf{B}\|_{2}=\sigma_{1}+\eta\cdot\langle\mathbf{u}_{1}^{\top}\mathbf{B},\mathbf{v}_{1}^{\top}\rangle+o(\eta\|\mathbf{B}\|_{2})" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>+</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow><mo>,</mo><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝐁</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\mathbf{A}+\eta\mathbf{B}\|_{2}=\sigma_{1}+\eta\cdot\langle\mathbf{u}_{1}^{\top}\mathbf{B},\mathbf{v}_{1}^{\top}\rangle+o(\eta\|\mathbf{B}\|_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p16.11" class="ltx_p"><span id="A1.SS1.p16.11.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.SS1.p17" class="ltx_para ltx_noindent">
<p id="A1.SS1.p17.1" class="ltx_p">Substituting the expression
<math id="A1.SS1.p17.m1" class="ltx_Math" alttext="\mathbf{W}_{l,\text{new}}=\mathbf{W}_{l}-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>l</mi><mo>,</mo><mtext>new</mtext></mrow></msub><mo>=</mo><mrow><msub><mi>𝐖</mi><mi>l</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{W}_{l,\text{new}}=\mathbf{W}_{l}-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}</annotation></semantics></math>
into the above derivation,
we generally consider the parameter update and learning rate
<math id="A1.SS1.p17.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> to be small quantities,
the change in spectral norm is approximately:</p>
<table id="A1.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex25.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx\langle\mathbf{u}_{1}^{\top}\left(-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\right),\mathbf{v}_{1}\rangle=-\eta\cdot\mathbf{u}_{1}^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\mathbf{v}_{1}" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐖</mi><mi>l</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≈</mo><mrow><mo stretchy="false">⟨</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>η</mi><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>)</mo></mrow><mo>,</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">⟩</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx\langle\mathbf{u}_{1}^{\top}\left(-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\right),\mathbf{v}_{1}\rangle=-\eta\cdot\mathbf{u}_{1}^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\mathbf{v}_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Proof of <a href="#Thmtheorem1" title="Theorem 1 (Spectral Norm Growth During Training). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a></h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p">To prove <a href="#Thmtheorem1" title="Theorem 1 (Spectral Norm Growth During Training). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a>,
we first need to derive the change in the spectral norm <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math>
during a single gradient descent step.
The exact expression is given by the following theorem:</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Change of the Spectral Norm)<span id="Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">In a network layer
that satisfies the spectral alignment condition,
the change of the spectral norm <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math>
in a single gradient descent step can be approximated as:</span></p>
<table id="A1.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex26.m1" class="ltx_Math" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2}(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≈</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>,</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2}(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is the learning rate, <math id="Thmtheorem4.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is the gradient propagation factor.</span></p>
</div>
</div>
<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.p2.1" class="ltx_p"><span id="A1.SS2.p2.1.1" class="ltx_text">By substituting the expression
<math id="A1.SS2.p2.m1" class="ltx_Math" alttext="\mathbf{W}_{l,\text{new}}=\mathbf{W}_{l}-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mrow><mi>l</mi><mo>,</mo><mtext>new</mtext></mrow></msub><mo>=</mo><mrow><msub><mi>𝐖</mi><mi>l</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{W}_{l,\text{new}}=\mathbf{W}_{l}-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}</annotation></semantics></math>
into <a href="#Thmtheorem3" title="Theorem 3 (Change in Spectral Norm under Perturbation). ‣ A.1 Proof with respect to parameters ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3</span></a>,
<math id="A1.SS2.p2.m2" class="ltx_Math" alttext="\Delta\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math> is approximately equal to
the projection of the gradient descent update term <math id="A1.SS2.p2.m3" class="ltx_Math" alttext="-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}</annotation></semantics></math> onto its principal singular directions, i.e.:</span></p>
<table id="A1.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex27.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx\langle\mathbf{u}_{1}^{\top}\left(-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\right),\mathbf{v}_{1}\rangle=-\eta\cdot\mathbf{u}_{1}^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\mathbf{v}_{1}" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐖</mi><mi>l</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≈</mo><mrow><mo stretchy="false">⟨</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>η</mi><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>)</mo></mrow><mo>,</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo stretchy="false">⟩</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx\langle\mathbf{u}_{1}^{\top}\left(-\eta\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\right),\mathbf{v}_{1}\rangle=-\eta\cdot\mathbf{u}_{1}^{\top}\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\mathbf{v}_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.2" class="ltx_p"><span id="A1.SS2.p2.2.1" class="ltx_text">where <math id="A1.SS2.p2.m4" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is the learning rate, and <math id="A1.SS2.p2.m5" class="ltx_Math" alttext="\mathbf{u}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{u}_{1}</annotation></semantics></math> and <math id="A1.SS2.p2.m6" class="ltx_Math" alttext="\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{v}_{1}</annotation></semantics></math> are the top left and right singular vectors of <math id="A1.SS2.p2.m7" class="ltx_Math" alttext="\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{l}</annotation></semantics></math>, respectively.
We substitute the approximate gradient expression derived earlier in Theorem <a href="#Thmtheorem2" title="Theorem 2 (Gradient Expression for Linear Layers). ‣ A.1 Proof with respect to parameters ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> into the above equation. The gradient expression is:</span></p>
<table id="A1.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex28.m1" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\approx(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mfrac><mo>≈</mo><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>Diag</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial\mathbf{W}_{l}}\approx(\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.3" class="ltx_p"><span id="A1.SS2.p2.3.1" class="ltx_text">After substituting the gradient expression, the change in the spectral norm is:</span></p>
<table id="A1.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex29.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\cdot\mathbf{u}_{1}^{\top}\left((\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))\right)\mathbf{v}_{1}" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐖</mi><mi>l</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≈</mo><mo lspace="0em">−</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mrow><mo>(</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">(</mo><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi><mo stretchy="false">)</mo></mrow><mi>ρ</mi><munderover><mo movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>Diag</mtext><mrow><mo stretchy="false">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\cdot\mathbf{u}_{1}^{\top}\left((\mathbf{h}^{(l-1)})^{\top}(\mathbf{p}-\mathbf{t})\rho\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\cdot\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))\right)\mathbf{v}_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.4" class="ltx_p"><span id="A1.SS2.p2.4.1" class="ltx_text">Using the associative property of matrix multiplication,
we rearrange the terms in the above equation and factor out the scalar <math id="A1.SS2.p2.m8" class="ltx_Math" alttext="(-\eta\rho)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(-\eta\rho)</annotation></semantics></math> to get the expression:</span></p>
<table id="A1.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex30.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\cdot\left(\mathbf{u}_{1}^{\top}(\mathbf{h}^{(l-1)})^{\top}\right)\cdot\left((\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))\mathbf{v}_{1}\right)" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐖</mi><mi>l</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≈</mo><mo lspace="0em">−</mo><mi>η</mi><mi>ρ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mtext>Diag</mtext><mrow><mo stretchy="false">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mi>𝐯</mi><mn>1</mn></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\cdot\left(\mathbf{u}_{1}^{\top}(\mathbf{h}^{(l-1)})^{\top}\right)\cdot\left((\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\text{Diag}(\mathds{1}(\mathbf{f}^{(l)}&gt;0))\mathbf{v}_{1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.5" class="ltx_p"><span id="A1.SS2.p2.5.1" class="ltx_text">In the above equation, the first term <math id="A1.SS2.p2.m9" class="ltx_Math" alttext="\left(\mathbf{u}_{1}^{\top}(\mathbf{h}^{(l-1)})^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msubsup><mi>𝐮</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathbf{u}_{1}^{\top}(\mathbf{h}^{(l-1)})^{\top}\right)</annotation></semantics></math> is the inner product of <math id="A1.SS2.p2.m10" class="ltx_Math" alttext="\mathbf{u}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{u}_{1}</annotation></semantics></math> and <math id="A1.SS2.p2.m11" class="ltx_Math" alttext="\mathbf{h}^{(l-1)}" display="inline" intent=":literal"><semantics><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{h}^{(l-1)}</annotation></semantics></math>,
and the second term is the effect of the backpropagated gradient from the output layer on the right singular vector <math id="A1.SS2.p2.m12" class="ltx_Math" alttext="\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{v}_{1}</annotation></semantics></math>.
Note that the product of a diagonal matrix and a vector <math id="A1.SS2.p2.m13" class="ltx_Math" alttext="\text{Diag}(\mathbf{a})\mathbf{v}" display="inline" intent=":literal"><semantics><mrow><mtext>Diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi></mrow><annotation encoding="application/x-tex">\text{Diag}(\mathbf{a})\mathbf{v}</annotation></semantics></math> is equivalent to the Hadamard product of the two vectors <math id="A1.SS2.p2.m14" class="ltx_Math" alttext="\mathbf{a}\odot\mathbf{v}" display="inline" intent=":literal"><semantics><mrow><mi>𝐚</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐯</mi></mrow><annotation encoding="application/x-tex">\mathbf{a}\odot\mathbf{v}</annotation></semantics></math>,
so we can rewrite the expression as:</span></p>
<table id="A1.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex31.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\cdot\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle\cdot(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot\mathbf{v}_{1}\right)" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐖</mi><mi>l</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≈</mo><mo lspace="0em">−</mo><mi>η</mi><mi>ρ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.055em" stretchy="false">⟩</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mrow><mo>(</mo><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>𝐯</mi><mn>1</mn></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\cdot\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle\cdot(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot\mathbf{v}_{1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.6" class="ltx_p"><span id="A1.SS2.p2.6.1" class="ltx_text">where <math id="A1.SS2.p2.m15" class="ltx_Math" alttext="\odot" display="inline" intent=":literal"><semantics><mo>⊙</mo><annotation encoding="application/x-tex">\odot</annotation></semantics></math> denotes the Hadamard product (element-wise product).</span></p>
</div>
<div id="A1.SS2.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.p3.1" class="ltx_p"><span id="A1.SS2.p3.1.1" class="ltx_text">We substitute the orthogonal decomposition from the spectral alignment condition <a href="#Thmassumption1" title="Assumption 1 (Pathological Spectral Alignment). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> into the above equation, using the column vector form of the decomposition, i.e.,
<math id="A1.SS2.p3.m1" class="ltx_Math" alttext="\mathbf{u}_{1}=\alpha(\mathbf{h}^{(l-1)})^{\top}+\bm{\epsilon}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐮</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>+</mo><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{u}_{1}=\alpha(\mathbf{h}^{(l-1)})^{\top}+\bm{\epsilon}^{\top}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p4" class="ltx_para ltx_noindent">
<p id="A1.SS2.p4.1" class="ltx_p"><span id="A1.SS2.p4.1.1" class="ltx_text">Substituting the decomposition of <math id="A1.SS2.p4.m1" class="ltx_Math" alttext="\mathbf{u}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{u}_{1}</annotation></semantics></math> into the first term <math id="A1.SS2.p4.m2" class="ltx_Math" alttext="\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle</annotation></semantics></math>, yielding:</span></p>
<table id="A1.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex32.m1" class="ltx_Math" alttext="\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle=\alpha\langle(\mathbf{h}^{(l-1)})^{\top},(\mathbf{h}^{(l-1)})^{\top}\rangle+\langle\bm{\epsilon}^{\top},(\mathbf{h}^{(l-1)})^{\top}\rangle" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>⊤</mo></msup><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle=\alpha\langle(\mathbf{h}^{(l-1)})^{\top},(\mathbf{h}^{(l-1)})^{\top}\rangle+\langle\bm{\epsilon}^{\top},(\mathbf{h}^{(l-1)})^{\top}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p4.2" class="ltx_p"><span id="A1.SS2.p4.2.1" class="ltx_text">Since <math id="A1.SS2.p4.m3" class="ltx_Math" alttext="\bm{\epsilon}" display="inline" intent=":literal"><semantics><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><annotation encoding="application/x-tex">\bm{\epsilon}</annotation></semantics></math> and <math id="A1.SS2.p4.m4" class="ltx_Math" alttext="\mathbf{h}^{(l-1)}" display="inline" intent=":literal"><semantics><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{h}^{(l-1)}</annotation></semantics></math> are orthogonal in the decomposition, the second term in the above equation is zero.
Therefore, the inner product term <math id="A1.SS2.p4.m5" class="ltx_Math" alttext="\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝐮</mi><mn>1</mn></msub><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\mathbf{u}_{1},(\mathbf{h}^{(l-1)})^{\top}\rangle</annotation></semantics></math> simplifies to <math id="A1.SS2.p4.m6" class="ltx_Math" alttext="\alpha\langle\mathbf{h}^{(l-1)},\mathbf{h}^{(l-1)}\rangle=\alpha\|\mathbf{h}^{(l-1)}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\alpha\langle\mathbf{h}^{(l-1)},\mathbf{h}^{(l-1)}\rangle=\alpha\|\mathbf{h}^{(l-1)}\|_{2}^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p5" class="ltx_para ltx_noindent">
<p id="A1.SS2.p5.1" class="ltx_p"><span id="A1.SS2.p5.1.1" class="ltx_text">Now we handle the second term containing <math id="A1.SS2.p5.m1" class="ltx_Math" alttext="\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{v}_{1}</annotation></semantics></math>, <math id="A1.SS2.p5.m2" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot\mathbf{v}_{1}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot\mathbf{v}_{1}\right)</annotation></semantics></math>.
Note that the condition <math id="A1.SS2.p5.m3" class="ltx_Math" alttext="\|\bm{\epsilon}_{1}\|\ll\|\alpha_{1}\mathbf{f}^{(l)}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mo>≪</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\|\bm{\epsilon}_{1}\|\ll\|\alpha_{1}\mathbf{f}^{(l)}\|</annotation></semantics></math> holds,
so if we perform an orthogonal decomposition of <math id="A1.SS2.p5.m4" class="ltx_Math" alttext="h^{(l-1)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(l-1)}</annotation></semantics></math> as <math id="A1.SS2.p5.m5" class="ltx_Math" alttext="h^{(l-1)}=\beta u_{1}^{\top}+\delta" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">h^{(l-1)}=\beta u_{1}^{\top}+\delta</annotation></semantics></math>,
we similarly have <math id="A1.SS2.p5.m6" class="ltx_Math" alttext="\|\delta\|\ll\beta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mo>≪</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\|\delta\|\ll\beta</annotation></semantics></math>.
Substituting into the forward propagation equation yields
<math id="A1.SS2.p5.m7" class="ltx_Math" alttext="f^{(l)}=\beta u_{1}^{\top}\mathbf{W}_{l}+\delta\mathbf{W}_{l}=\beta\sigma_{1}v_{1}^{\top}+\delta\mathbf{W}_{l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mrow><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{(l)}=\beta u_{1}^{\top}\mathbf{W}_{l}+\delta\mathbf{W}_{l}=\beta\sigma_{1}v_{1}^{\top}+\delta\mathbf{W}_{l}</annotation></semantics></math>,
where the leading singular value <math id="A1.SS2.p5.m8" class="ltx_Math" alttext="\sigma_{1}=\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\sigma_{1}=\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math>
is the spectral norm.
We have <math id="A1.SS2.p5.m9" class="ltx_Math" alttext="\|\delta\mathbf{W}_{l}\|_{2}\leq\|\delta\|_{2}\cdot\|\mathbf{W}_{l}\|_{2}\ll\beta\|\mathbf{W}_{l}\|_{2}=\|\beta\sigma_{1}v_{1}^{\top}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>l</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≪</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\delta\mathbf{W}_{l}\|_{2}\leq\|\delta\|_{2}\cdot\|\mathbf{W}_{l}\|_{2}\ll\beta\|\mathbf{W}_{l}\|_{2}=\|\beta\sigma_{1}v_{1}^{\top}\|_{2}</annotation></semantics></math>,
and note that <math id="A1.SS2.p5.m10" class="ltx_Math" alttext="\beta\sigma_{1}v_{1}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">\beta\sigma_{1}v_{1}^{\top}</annotation></semantics></math>
is precisely in the direction of the principal right singular vector.
Therefore, if we perform an orthogonal decomposition of <math id="A1.SS2.p5.m11" class="ltx_Math" alttext="f^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">f^{(l)}</annotation></semantics></math> with respect to <math id="A1.SS2.p5.m12" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math>,
the residual orthogonal term remains much smaller than the projection term.</span></p>
</div>
<div id="A1.SS2.p6" class="ltx_para ltx_noindent">
<p id="A1.SS2.p6.1" class="ltx_p"><span id="A1.SS2.p6.1.1" class="ltx_text">The above discussion can be stated as:
when the input <math id="A1.SS2.p6.m1" class="ltx_Math" alttext="\mathbf{h}" display="inline" intent=":literal"><semantics><mi>𝐡</mi><annotation encoding="application/x-tex">\mathbf{h}</annotation></semantics></math> is aligned with <math id="A1.SS2.p6.m2" class="ltx_Math" alttext="\mathbf{u}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{u}_{1}</annotation></semantics></math>,
the pre-activation <math id="A1.SS2.p6.m3" class="ltx_Math" alttext="\mathbf{f}" display="inline" intent=":literal"><semantics><mi>𝐟</mi><annotation encoding="application/x-tex">\mathbf{f}</annotation></semantics></math> is also aligned with <math id="A1.SS2.p6.m4" class="ltx_Math" alttext="\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{v}_{1}</annotation></semantics></math>.
So if we decompose <math id="A1.SS2.p6.m5" class="ltx_Math" alttext="\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{v}_{1}</annotation></semantics></math> in the direction of <math id="A1.SS2.p6.m6" class="ltx_Math" alttext="\mathbf{f}^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{f}^{(l)}</annotation></semantics></math>,
and substituting the decomposition into the Hadamard product
<math id="A1.SS2.p6.m7" class="ltx_Math" alttext="\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot\mathbf{v}_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>𝐯</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot\mathbf{v}_{1}</annotation></semantics></math>.
Then by previous discussion,
we can neglect the small residual term,
and we obtain the expression for the change in spectral norm:</span></p>
<table id="A1.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex33.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho(\alpha\|\mathbf{h}^{(l-1)}\|_{2}^{2})\cdot(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot(\mathbf{f}^{(l)})^{\top})\right)" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>𝐖</mi><mi>l</mi></msub><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≈</mo><mo lspace="0em">−</mo><mi>η</mi><mi>ρ</mi><mrow><mo stretchy="false">(</mo><mi>α</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><msubsup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup><mo>)</mo></mrow><mrow><mo>(</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>,</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mrow><mo stretchy="false">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho(\alpha\|\mathbf{h}^{(l-1)}\|_{2}^{2})\cdot(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot(\mathbf{f}^{(l)})^{\top})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p6.2" class="ltx_p"><span id="A1.SS2.p6.2.1" class="ltx_text">Here <math id="A1.SS2.p6.m8" class="ltx_Math" alttext="\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>,</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><annotation encoding="application/x-tex">\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}</annotation></semantics></math>
is the norm of the projection.
The complex term <math id="A1.SS2.p6.m9" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot(\mathbf{f}^{(l)})^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><msubsup><mi>𝐖</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})\left(\prod_{k=L}^{l+1}\mathbf{W}_{k}^{\top}\right)\left(\mathds{1}(\mathbf{f}^{(l)}&gt;0)\odot(\mathbf{f}^{(l)})^{\top}\right)</annotation></semantics></math>
is essentially a forward propagation process,
where the linear layers act on the signal originating from the pre-activation <math id="A1.SS2.p6.m10" class="ltx_Math" alttext="\mathbf{f}^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{f}^{(l)}</annotation></semantics></math>
of the <math id="A1.SS2.p6.m11" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th layer and map it to the final layer.
Therefore, this term can be directly expressed by the final output term <math id="A1.SS2.p6.m12" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p7" class="ltx_para ltx_noindent">
<p id="A1.SS2.p7.1" class="ltx_p"><span id="A1.SS2.p7.1.1" class="ltx_text">Combining all the scalars, we get the final expression:</span></p>
<table id="A1.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex34.m1" class="ltx_Math" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2}(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≈</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>,</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2}(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p7.2" class="ltx_p"><span id="A1.SS2.p7.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A1.SS2.p8" class="ltx_para ltx_noindent">
<p id="A1.SS2.p8.1" class="ltx_p">To determine the sign of the key term
<math id="A1.SS2.p8.m1" class="ltx_Math" alttext="((\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top})</annotation></semantics></math>
in the expression for <math id="A1.SS2.p8.m2" class="ltx_Math" alttext="\Delta\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math>,
we need the following technical lemma,
which provides the final foundation for the proof of <a href="#Thmtheorem1" title="Theorem 1 (Spectral Norm Growth During Training). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold"> </span>(Sign of the Expected Logit Deviation Term)<span id="Thmlemma1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)</annotation></semantics></math> be the cross-entropy loss function defined by a neural network with parameters <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, which produces a logit vector <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="\mathbf{z}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">\mathbf{z}</annotation></semantics></math> at the output layer.
The optimization process of minimizing <math id="Thmlemma1.p1.m4" class="ltx_Math" alttext="\mathcal{L}(\theta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\theta)</annotation></semantics></math> via gradient descent will necessarily cause the system state to evolve into a region satisfying the inequality <math id="Thmlemma1.p1.m5" class="ltx_Math" alttext="z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]</annotation></semantics></math>, where <math id="Thmlemma1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is the index of the target class.
Therefore, the sign of the expected logit deviation term <math id="Thmlemma1.p1.m7" class="ltx_Math" alttext="E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}=(\mathbf{p}-\mathbf{t})\mathbf{h}^{(L)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}=(\mathbf{p}-\mathbf{t})\mathbf{h}^{(L)}</annotation></semantics></math> is negative.</span></p>
</div>
</div>
<div id="A1.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p9" class="ltx_para ltx_noindent">
<p id="A1.SS2.p9.1" class="ltx_p"><span id="A1.SS2.p9.1.1" class="ltx_text">We first analyze the gradient properties of the cross-entropy loss function <math id="A1.SS2.p9.m1" class="ltx_Math" alttext="\mathcal{L}(\mathbf{z})=\log(\sum_{j}e^{z_{j}})-z_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∑</mo><mi>j</mi></msub><msup><mi>e</mi><msub><mi>z</mi><mi>j</mi></msub></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathbf{z})=\log(\sum_{j}e^{z_{j}})-z_{k}</annotation></semantics></math> within the logit space <math id="A1.SS2.p9.m2" class="ltx_Math" alttext="\mathbb{R}^{n_{L}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msub><mi>n</mi><mi>L</mi></msub></msup><annotation encoding="application/x-tex">\mathbb{R}^{n_{L}}</annotation></semantics></math>.
Since <math id="A1.SS2.p9.m3" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is the cross-entropy loss function, its gradient with respect to the final logit output is
<math id="A1.SS2.p9.m4" class="ltx_Math" alttext="\nabla_{z}\mathcal{L}=\frac{\partial\mathcal{L}}{\partial\mathbf{h}^{(L)}}=\mathbf{p}-\mathbf{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>z</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo>=</mo><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac><mo>=</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla_{z}\mathcal{L}=\frac{\partial\mathcal{L}}{\partial\mathbf{h}^{(L)}}=\mathbf{p}-\mathbf{t}</annotation></semantics></math>,
where <math id="A1.SS2.p9.m5" class="ltx_Math" alttext="\mathbf{t}" display="inline" intent=":literal"><semantics><mi>𝐭</mi><annotation encoding="application/x-tex">\mathbf{t}</annotation></semantics></math> is the one-hot vector for the target label <math id="A1.SS2.p9.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,
and <math id="A1.SS2.p9.m7" class="ltx_Math" alttext="\mathbf{p}_{i}=e^{z_{i}}/\sum_{j}e^{z_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐩</mi><mi>i</mi></msub><mo>=</mo><mrow><msup><mi>e</mi><msub><mi>z</mi><mi>i</mi></msub></msup><mo rspace="0.055em">/</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msup><mi>e</mi><msub><mi>z</mi><mi>j</mi></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{p}_{i}=e^{z_{i}}/\sum_{j}e^{z_{j}}</annotation></semantics></math> is the probability obtained via the Softmax function.</span></p>
</div>
<div id="A1.SS2.p10" class="ltx_para ltx_noindent">
<p id="A1.SS2.p10.1" class="ltx_p"><span id="A1.SS2.p10.1.1" class="ltx_text">A gradient-based optimization algorithm must converge to a stable point where the gradient of the loss function is zero,
i.e., the gradient vector <math id="A1.SS2.p10.m1" class="ltx_Math" alttext="\nabla_{\mathbf{z}}\mathcal{L}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝐳</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{z}}\mathcal{L}=0</annotation></semantics></math>.
A necessary and sufficient condition for this is that all components are simultaneously zero, i.e., <math id="A1.SS2.p10.m2" class="ltx_Math" alttext="p_{k}-1=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{k}-1=0</annotation></semantics></math> and <math id="A1.SS2.p10.m3" class="ltx_Math" alttext="p_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{i}=0</annotation></semantics></math> for all <math id="A1.SS2.p10.m4" class="ltx_Math" alttext="i\neq k" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">i\neq k</annotation></semantics></math>.
Thus, the cross-entropy loss function has a unique stable point in the logit space,
which corresponds to the state where the model makes a perfect classification (i.e., <math id="A1.SS2.p10.m5" class="ltx_Math" alttext="p_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}=1</annotation></semantics></math>).</span></p>
</div>
<div id="A1.SS2.p11" class="ltx_para ltx_noindent">
<p id="A1.SS2.p11.1" class="ltx_p"><span id="A1.SS2.p11.1.1" class="ltx_text">Next, we prove that the optimization process cannot converge to any point that does not satisfy the inequality <math id="A1.SS2.p11.m1" class="ltx_Math" alttext="z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]</annotation></semantics></math>.
Assume the optimization process converges to a point <math id="A1.SS2.p11.m2" class="ltx_Math" alttext="\mathbf{z}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathbf{z}^{*}</annotation></semantics></math> that does not satisfy this inequality,
i.e., <math id="A1.SS2.p11.m3" class="ltx_Math" alttext="z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup><mo>≤</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]</annotation></semantics></math>. We will show that this assumption leads to a logical contradiction.</span></p>
</div>
<div id="A1.SS2.p12" class="ltx_para ltx_noindent">
<p id="A1.SS2.p12.1" class="ltx_p"><span id="A1.SS2.p12.1.1" class="ltx_text">The inequality <math id="A1.SS2.p12.m1" class="ltx_Math" alttext="z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup><mo>≤</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]</annotation></semantics></math> implies <math id="A1.SS2.p12.m2" class="ltx_Math" alttext="p_{k}^{*}&lt;1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>k</mi><mo>∗</mo></msubsup><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}^{*}&lt;1</annotation></semantics></math>,
because only when <math id="A1.SS2.p12.m3" class="ltx_Math" alttext="p_{k}^{*}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>k</mi><mo>∗</mo></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}^{*}=1</annotation></semantics></math> (at which point all <math id="A1.SS2.p12.m4" class="ltx_Math" alttext="p_{i\neq k}^{*}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mrow><mi>i</mi><mo>≠</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{i\neq k}^{*}=0</annotation></semantics></math>) does the expectation take its boundary value <math id="A1.SS2.p12.m5" class="ltx_Math" alttext="E_{i\sim p(\mathbf{z}^{*})}[z_{i}]=\sum_{j}p_{j}^{*}z_{j}^{*}=1\cdot z_{k}^{*}+\sum_{j\neq k}0\cdot z_{j}^{*}=z_{k}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msubsup><mi>p</mi><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>j</mi><mo>∗</mo></msubsup></mrow></mrow><mo>=</mo><mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup></mrow><mo rspace="0.055em">+</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>≠</mo><mi>k</mi></mrow></msub><mn>0</mn></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>z</mi><mi>j</mi><mo>∗</mo></msubsup></mrow></mrow><mo>=</mo><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">E_{i\sim p(\mathbf{z}^{*})}[z_{i}]=\sum_{j}p_{j}^{*}z_{j}^{*}=1\cdot z_{k}^{*}+\sum_{j\neq k}0\cdot z_{j}^{*}=z_{k}^{*}</annotation></semantics></math>.
In any other case, as long as there is at least one <math id="A1.SS2.p12.m6" class="ltx_Math" alttext="p_{i\neq k}^{*}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mrow><mi>i</mi><mo>≠</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{i\neq k}^{*}&gt;0</annotation></semantics></math>, the expected value is a weighted average of all logits,
and the inequality <math id="A1.SS2.p12.m7" class="ltx_Math" alttext="z_{k}^{*}&gt;E_{i\sim p(\mathbf{z}^{*})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup><mo>&gt;</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}^{*}&gt;E_{i\sim p(\mathbf{z}^{*})}[z_{i}]</annotation></semantics></math> would hold.</span></p>
</div>
<div id="A1.SS2.p13" class="ltx_para ltx_noindent">
<p id="A1.SS2.p13.1" class="ltx_p"><span id="A1.SS2.p13.1.1" class="ltx_text">Furthermore, according to the gradient expression, at any point where <math id="A1.SS2.p13.m1" class="ltx_Math" alttext="p_{k}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}&lt;1</annotation></semantics></math>, the gradient component <math id="A1.SS2.p13.m2" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial z_{k}}=p_{k}-1" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>z</mi><mi>k</mi></msub></mrow></mfrac><mo>=</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial z_{k}}=p_{k}-1</annotation></semantics></math> must be negative, which means the gradient vector <math id="A1.SS2.p13.m3" class="ltx_Math" alttext="\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝐳</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{*})</annotation></semantics></math> must be non-zero.</span></p>
</div>
<div id="A1.SS2.p14" class="ltx_para ltx_noindent">
<p id="A1.SS2.p14.1" class="ltx_p"><span id="A1.SS2.p14.1.1" class="ltx_text">The above assumption (that the optimization process converges to a point <math id="A1.SS2.p14.m1" class="ltx_Math" alttext="\mathbf{z}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathbf{z}^{*}</annotation></semantics></math> and <math id="A1.SS2.p14.m2" class="ltx_Math" alttext="z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup><mo>≤</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]</annotation></semantics></math>) leads to a contradiction. By the definition of a convergence point, <math id="A1.SS2.p14.m3" class="ltx_Math" alttext="\mathbf{z}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathbf{z}^{*}</annotation></semantics></math> must be a stable point, i.e., the gradient <math id="A1.SS2.p14.m4" class="ltx_Math" alttext="\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{*})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>𝐳</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{*})=0</annotation></semantics></math>.
However, the condition <math id="A1.SS2.p14.m5" class="ltx_Math" alttext="z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mo>∗</mo></msubsup><mo>≤</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}^{*}\leq E_{i\sim p(\mathbf{z}^{*})}[z_{i}]</annotation></semantics></math> implies <math id="A1.SS2.p14.m6" class="ltx_Math" alttext="p_{k}^{*}&lt;1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>k</mi><mo>∗</mo></msubsup><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}^{*}&lt;1</annotation></semantics></math>.
For any state with <math id="A1.SS2.p14.m7" class="ltx_Math" alttext="p_{k}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}&lt;1</annotation></semantics></math>, the gradient component <math id="A1.SS2.p14.m8" class="ltx_Math" alttext="\frac{\partial\mathcal{L}}{\partial z_{k}}=p_{k}-1\neq 0" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mrow><mo>∂</mo><msub><mi>z</mi><mi>k</mi></msub></mrow></mfrac><mo>=</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}}{\partial z_{k}}=p_{k}-1\neq 0</annotation></semantics></math>, hence <math id="A1.SS2.p14.m9" class="ltx_Math" alttext="\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{*})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>𝐳</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{*})\neq 0</annotation></semantics></math>. Thus, <math id="A1.SS2.p14.m10" class="ltx_Math" alttext="\mathbf{z}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathbf{z}^{*}</annotation></semantics></math> cannot be a stable point, and the assumption is false.</span></p>
</div>
<div id="A1.SS2.p15" class="ltx_para ltx_noindent">
<p id="A1.SS2.p15.1" class="ltx_p"><span id="A1.SS2.p15.1.1" class="ltx_text">From the preceding discussion, the set of convergence points for the optimization algorithm is a subset of the state space region satisfying the inequality <math id="A1.SS2.p15.m1" class="ltx_Math" alttext="z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]</annotation></semantics></math>. Define the state space <math id="A1.SS2.p15.m2" class="ltx_Math" alttext="S_{&gt;}=\{\mathbf{z}\in\mathbb{R}^{n_{L}}\mid z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mo>&gt;</mo></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>𝐳</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>n</mi><mi>L</mi></msub></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S_{&gt;}=\{\mathbf{z}\in\mathbb{R}^{n_{L}}\mid z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]\}</annotation></semantics></math>.
For any point <math id="A1.SS2.p15.m3" class="ltx_Math" alttext="\mathbf{z}^{\prime}\notin S_{&gt;}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐳</mi><mo>′</mo></msup><mo>∉</mo><msub><mi>S</mi><mo>&gt;</mo></msub></mrow><annotation encoding="application/x-tex">\mathbf{z}^{\prime}\notin S_{&gt;}</annotation></semantics></math> (except for the unique stable point <math id="A1.SS2.p15.m4" class="ltx_Math" alttext="p_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{k}=1</annotation></semantics></math>), its gradient <math id="A1.SS2.p15.m5" class="ltx_Math" alttext="\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝐳</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\mathbf{z}}\mathcal{L}(\mathbf{z}^{\prime})</annotation></semantics></math> is non-zero. The gradient descent update vector <math id="A1.SS2.p15.m6" class="ltx_Math" alttext="\Delta\mathbf{z}=-\eta\nabla_{\mathbf{z}}\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐳</mi></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><mi>𝐳</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{z}=-\eta\nabla_{\mathbf{z}}\mathcal{L}</annotation></semantics></math> ensures an increase in <math id="A1.SS2.p15.m7" class="ltx_Math" alttext="z_{k}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>k</mi></msub><annotation encoding="application/x-tex">z_{k}</annotation></semantics></math> and a decrease in <math id="A1.SS2.p15.m8" class="ltx_Math" alttext="z_{i\neq k}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>i</mi><mo>≠</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">z_{i\neq k}</annotation></semantics></math>, and this update vector field must point towards the region <math id="A1.SS2.p15.m9" class="ltx_Math" alttext="S_{&gt;}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mo>&gt;</mo></msub><annotation encoding="application/x-tex">S_{&gt;}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p16" class="ltx_para">
<p id="A1.SS2.p16.1" class="ltx_p"><span id="A1.SS2.p16.1.1" class="ltx_text">Given that the loss function <math id="A1.SS2.p16.m1" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is bounded below and gradient descent ensures <math id="A1.SS2.p16.m2" class="ltx_Math" alttext="\mathcal{L}(\mathbf{z}_{t+1})&lt;\mathcal{L}(\mathbf{z}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathbf{z}_{t+1})&lt;\mathcal{L}(\mathbf{z}_{t})</annotation></semantics></math>, the convergence trajectory <math id="A1.SS2.p16.m3" class="ltx_Math" alttext="\{\mathbf{z}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathbf{z}_{t}\}</annotation></semantics></math> must approach the unique stable point. This convergence process requires the trajectory to leave the non-stable regions, enter, and ultimately remain within the region <math id="A1.SS2.p16.m4" class="ltx_Math" alttext="S_{&gt;}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mo>&gt;</mo></msub><annotation encoding="application/x-tex">S_{&gt;}</annotation></semantics></math>.
Therefore, the sign of the expected logit deviation term <math id="A1.SS2.p16.m5" class="ltx_Math" alttext="E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}=(\mathbf{p}-\mathbf{t})\mathbf{h}^{(L)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}=(\mathbf{p}-\mathbf{t})\mathbf{h}^{(L)}</annotation></semantics></math> is negative.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p17" class="ltx_para ltx_noindent">
<p id="A1.SS2.p17.1" class="ltx_p">Now we can complete the proof of the main <a href="#Thmtheorem1" title="Theorem 1 (Spectral Norm Growth During Training). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a>.
It demonstrates that under the spectral alignment condition,
the spectral norm exhibits deterministic growth.</p>
</div>
<div id="A1.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">proof of <a href="#Thmtheorem1" title="Theorem 1 (Spectral Norm Growth During Training). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</h6>
<div id="A1.SS2.p18" class="ltx_para ltx_noindent">
<p id="A1.SS2.p18.1" class="ltx_p"><span id="A1.SS2.p18.1.1" class="ltx_text">Recall the expression for the change in spectral norm is given by</span></p>
<table id="A1.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex35.m1" class="ltx_Math" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2}(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≈</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>,</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2}(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.2" class="ltx_p"><span id="A1.SS2.p18.2.1" class="ltx_text">We need to determine the sign of the right-hand side of the above equation.
In this expression,
the learning rate <math id="A1.SS2.p18.m1" class="ltx_Math" alttext="\eta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta&gt;0</annotation></semantics></math>,
the scalar approximation factor <math id="A1.SS2.p18.m2" class="ltx_Math" alttext="\rho&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho&gt;0</annotation></semantics></math>,
and the squared norm <math id="A1.SS2.p18.m3" class="ltx_Math" alttext="\|\mathbf{h}^{(l-1)}\|_{2}^{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|\mathbf{h}^{(l-1)}\|_{2}^{2}&gt;0</annotation></semantics></math>.
According to the spectral alignment condition,
the alignment strengths <math id="A1.SS2.p18.m4" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math>.
Therefore, the sign of <math id="A1.SS2.p18.m5" class="ltx_Math" alttext="\Delta\|\mathbf{W}_{l}\|_{2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝐖</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}</annotation></semantics></math> is entirely determined by the sign of <math id="A1.SS2.p18.m6" class="ltx_Math" alttext="-(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">-(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math>.
We expand <math id="A1.SS2.p18.m7" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math>, considering that the logits of the final layer are obtained from the previous layer’s activation <math id="A1.SS2.p18.m8" class="ltx_Math" alttext="\mathbf{h}^{(L-1)}" display="inline" intent=":literal"><semantics><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{h}^{(L-1)}</annotation></semantics></math> and the weight matrix <math id="A1.SS2.p18.m9" class="ltx_Math" alttext="\mathbf{W}_{L}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mi>L</mi></msub><annotation encoding="application/x-tex">\mathbf{W}_{L}</annotation></semantics></math>, i.e., <math id="A1.SS2.p18.m10" class="ltx_Math" alttext="\mathbf{z}=\mathbf{h}^{(L)}=\mathbf{h}^{(L-1)}\mathbf{W}_{L}" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>=</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐖</mi><mi>L</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}=\mathbf{h}^{(L)}=\mathbf{h}^{(L-1)}\mathbf{W}_{L}</annotation></semantics></math>.
We can write this term as the matrix weights acting on the forward propagation: <math id="A1.SS2.p18.m11" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})\mathbf{W}_{L}^{\top}(\mathbf{h}^{(L-1)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})\mathbf{W}_{L}^{\top}(\mathbf{h}^{(L-1)})^{\top}</annotation></semantics></math>.
Expanding it, we get:</span></p>
<table id="A1.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex36.m1" class="ltx_Math" alttext="\displaystyle(\mathbf{p}-\mathbf{t})\mathbf{W}_{L}^{\top}(\mathbf{h}^{(L-1)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle(\mathbf{p}-\mathbf{t})\mathbf{W}_{L}^{\top}(\mathbf{h}^{(L-1)})^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex36.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left(\sum_{i=1}^{n_{L}}p_{i}(\mathbf{W}_{L}^{\top})_{i,:}-(\mathbf{W}_{L}^{\top})_{k,:}\right)(\mathbf{h}^{(L-1)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>L</mi></msub></munderover></mstyle><msub><mi>p</mi><mi>i</mi></msub><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mo>:</mo></mrow></msub><mo>−</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><mo>)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\sum_{i=1}^{n_{L}}p_{i}(\mathbf{W}_{L}^{\top})_{i,:}-(\mathbf{W}_{L}^{\top})_{k,:}\right)(\mathbf{h}^{(L-1)})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex37.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{i=1}^{n_{L}}p_{i}(\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top}-(\mathbf{W}_{L}^{\top})_{k,:}(\mathbf{h}^{(L-1)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>L</mi></msub></munderover></mstyle><msub><mi>p</mi><mi>i</mi></msub><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo>−</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{n_{L}}p_{i}(\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top}-(\mathbf{W}_{L}^{\top})_{k,:}(\mathbf{h}^{(L-1)})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.3" class="ltx_p"><span id="A1.SS2.p18.3.1" class="ltx_text">Here <math id="A1.SS2.p18.m12" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is the index of the target label. Noting that logits <math id="A1.SS2.p18.m13" class="ltx_math_unparsed" alttext="z_{i}=(\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>i</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">z_{i}=(\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top}</annotation></semantics></math>, and substituting the definition of Softmax probability <math id="A1.SS2.p18.m14" class="ltx_Math" alttext="p_{i}=\frac{e^{z_{i}}}{\sum_{j=1}^{n_{L}}e^{z_{j}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>=</mo><mfrac><msup><mi>e</mi><msub><mi>z</mi><mi>i</mi></msub></msup><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>L</mi></msub></msubsup></mstyle><msup><mi>e</mi><msub><mi>z</mi><mi>j</mi></msub></msup></mrow></mfrac></mrow><annotation encoding="application/x-tex">p_{i}=\frac{e^{z_{i}}}{\sum_{j=1}^{n_{L}}e^{z_{j}}}</annotation></semantics></math>, we get the expression for <math id="A1.SS2.p18.m15" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math>:</span></p>
<table id="A1.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex38.m1" class="ltx_math_unparsed" alttext="(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}=\sum_{i=1}^{n_{L}}\left(((\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top})\cdot\frac{e^{(\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top}}}{\sum_{j=1}^{n_{L}}e^{(\mathbf{W}_{L}^{\top})_{j,:}(\mathbf{h}^{(L-1)})^{\top}}}\right)-(\mathbf{W}_{L}^{\top})_{k,:}(\mathbf{h}^{(L-1)})^{\top}" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi><mo stretchy="false">)</mo></mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>L</mi></msub></munderover><mrow><mo>(</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mfrac><mrow><mi>e</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><msub><mrow></mrow><mi>L</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝐡</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow></msup></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><msub><mi>n</mi><mi>L</mi></msub></msup><mi>e</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>𝐖</mi><msub><mrow></mrow><mi>L</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>,</mo><mo>:</mo></mrow></msub><mo stretchy="false">(</mo><mi>𝐡</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow></msup></mrow></mfrac><mo>)</mo></mrow><mo>−</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐖</mi><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>,</mo><mo>:</mo></mrow></msub><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}=\sum_{i=1}^{n_{L}}\left(((\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top})\cdot\frac{e^{(\mathbf{W}_{L}^{\top})_{i,:}(\mathbf{h}^{(L-1)})^{\top}}}{\sum_{j=1}^{n_{L}}e^{(\mathbf{W}_{L}^{\top})_{j,:}(\mathbf{h}^{(L-1)})^{\top}}}\right)-(\mathbf{W}_{L}^{\top})_{k,:}(\mathbf{h}^{(L-1)})^{\top}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.4" class="ltx_p"><span id="A1.SS2.p18.4.1" class="ltx_text">Substituting the logit definition <math id="A1.SS2.p18.m16" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math> back into the above equation, the expression simplifies to:</span></p>
<table id="A1.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex39.m1" class="ltx_Math" alttext="\displaystyle(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex39.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{n_{L}}z_{i}\frac{e^{z_{i}}}{\sum_{j=1}^{n_{L}}e^{z_{j}}}-z_{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>L</mi></msub></munderover></mstyle><mrow><msub><mi>z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><msub><mi>z</mi><mi>i</mi></msub></msup><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>L</mi></msub></msubsup><msup><mi>e</mi><msub><mi>z</mi><mi>j</mi></msub></msup></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{n_{L}}z_{i}\frac{e^{z_{i}}}{\sum_{j=1}^{n_{L}}e^{z_{j}}}-z_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex40.m1" class="ltx_Math" alttext="\displaystyle=E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.5" class="ltx_p"><span id="A1.SS2.p18.5.1" class="ltx_text">By Lemma <a href="#Thmlemma1" title="Lemma 1 (Sign of the Expected Logit Deviation Term). ‣ A.2 Proof of ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the gradient properties of the cross-entropy loss function determine its optimization dynamics. In the logit space, any gradient descent step will deterministically increase the value of the target logit <math id="A1.SS2.p18.m17" class="ltx_Math" alttext="z_{k}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>k</mi></msub><annotation encoding="application/x-tex">z_{k}</annotation></semantics></math>, and the system state evolves to eventually satisfy the following inequality:</span></p>
<table id="A1.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex41.m1" class="ltx_Math" alttext="z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]" display="block" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{k}&gt;E_{i\sim p(\mathbf{z})}[z_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.6" class="ltx_p"><span id="A1.SS2.p18.6.1" class="ltx_text">From this, we can deduce:</span></p>
<table id="A1.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex42.m1" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}=E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}&lt;0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><mrow><msub><mi>E</mi><mrow><mi>i</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mi>k</mi></msub></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}=E_{i\sim p(\mathbf{z})}[z_{i}]-z_{k}&lt;0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.7" class="ltx_p"><span id="A1.SS2.p18.7.1" class="ltx_text">Since the value of <math id="A1.SS2.p18.m18" class="ltx_Math" alttext="(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">(\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top}</annotation></semantics></math> is negative, we can finally determine the sign of the change in the spectral norm:</span></p>
<table id="A1.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex43.m1" class="ltx_math_unparsed" alttext="\Delta\|\mathbf{W}_{l}\|_{2}\approx-\underbrace{(\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2})}_{\text{positive}}\cdot\underbrace{((\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top})}_{\text{negative}}&gt;0" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝐖</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≈</mo><mo lspace="0em">−</mo><munder accentunder="true"><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐯</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>,</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">⟩</mo></mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>positive</mtext></msub><mo rspace="0.222em">⋅</mo><munder accentunder="true"><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐩</mi><mo>−</mo><mi>𝐭</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝐡</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>negative</mtext></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta\|\mathbf{W}_{l}\|_{2}\approx-\underbrace{(\eta\rho\alpha\frac{\langle\mathbf{v}_{1}^{\top},\mathbf{f}^{(l)}\rangle}{\|\mathbf{f}^{(l)}\|_{2}}\|\mathbf{h}^{(l-1)}\|_{2}^{2})}_{\text{positive}}\cdot\underbrace{((\mathbf{p}-\mathbf{t})(\mathbf{h}^{(L)})^{\top})}_{\text{negative}}&gt;0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p18.8" class="ltx_p"><span id="A1.SS2.p18.8.1" class="ltx_text">This proves that, driven by the cross-entropy loss and satisfying the spectral alignment condition, the spectral norm of the weight matrices has an intrinsic tendency to grow, leading to training collapse.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p19" class="ltx_para ltx_noindent">
<p id="A1.SS2.p19.1" class="ltx_p">Finally,
we provide the proof of Corollary <a href="#Thmcorollary1" title="Corollary 1. ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,
which demonstrates that when spectral alignment causes the spectral norm to increase,
it leads to trigger a growth of activations and gradients.
This confirms the effectiveness of spectral alignment
as an early-warning indicator.</p>
</div>
<div id="A1.SS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">proof of <a href="#Thmcorollary1" title="Corollary 1. ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</h6>
<div id="A1.SS2.p20" class="ltx_para ltx_noindent">
<p id="A1.SS2.p20.1" class="ltx_p"><span id="A1.SS2.p20.1.1" class="ltx_text">Consider the forward propagation <math id="A1.SS2.p20.m1" class="ltx_Math" alttext="f^{(l)}=h^{(l-1)}W_{l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f^{(l)}=h^{(l-1)}W_{l}</annotation></semantics></math>.
When training enters the pathological spectral alignment state,
we perform an orthogonal decomposition of the input vector <math id="A1.SS2.p20.m2" class="ltx_Math" alttext="h^{(l-1)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(l-1)}</annotation></semantics></math>
with respect to the principal left singular vector <math id="A1.SS2.p20.m3" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math> of the
weight matrix
<math id="A1.SS2.p20.m4" class="ltx_Math" alttext="W_{l}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>l</mi></msub><annotation encoding="application/x-tex">W_{l}</annotation></semantics></math>: <math id="A1.SS2.p20.m5" class="ltx_Math" alttext="h^{(l-1)}=\beta u_{1}^{\top}+\delta" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">h^{(l-1)}=\beta u_{1}^{\top}+\delta</annotation></semantics></math>,
where <math id="A1.SS2.p20.m6" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is the projection coefficient and <math id="A1.SS2.p20.m7" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>
is the residual term orthogonal to <math id="A1.SS2.p20.m8" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math>.
Under the alignment condition, <math id="A1.SS2.p20.m9" class="ltx_Math" alttext="\|\delta\|_{2}\ll\beta" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≪</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\|\delta\|_{2}\ll\beta</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p21" class="ltx_para ltx_noindent">
<p id="A1.SS2.p21.1" class="ltx_p"><span id="A1.SS2.p21.1.1" class="ltx_text">Substituting this decomposition into the forward propagation equation,
we obtain:
<math id="A1.SS2.p21.m1" class="ltx_Math" alttext="f^{(l)}=(\beta u_{1}^{\top}+\delta)W_{l}=\beta u_{1}^{\top}W_{l}+\delta W_{l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{(l)}=(\beta u_{1}^{\top}+\delta)W_{l}=\beta u_{1}^{\top}W_{l}+\delta W_{l}</annotation></semantics></math>.
By the properties of singular value decomposition,
<math id="A1.SS2.p21.m2" class="ltx_Math" alttext="u_{1}^{\top}W_{l}=\sigma_{1}v_{1}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">u_{1}^{\top}W_{l}=\sigma_{1}v_{1}^{\top}</annotation></semantics></math>,
where <math id="A1.SS2.p21.m3" class="ltx_Math" alttext="\sigma_{1}=\|W_{l}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\sigma_{1}=\|W_{l}\|_{2}</annotation></semantics></math> is the spectral norm of the weight matrix
and <math id="A1.SS2.p21.m4" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> is the principal right singular vector. Therefore,</span></p>
<table id="A1.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex44.m1" class="ltx_Math" alttext="f^{(l)}=\beta\sigma_{1}v_{1}^{\top}+\delta W_{l}" display="block" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{(l)}=\beta\sigma_{1}v_{1}^{\top}+\delta W_{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p21.2" class="ltx_p"><span id="A1.SS2.p21.2.1" class="ltx_text">Since <math id="A1.SS2.p21.m5" class="ltx_Math" alttext="\|\delta\|\ll\beta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mo>≪</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\|\delta\|\ll\beta</annotation></semantics></math>,
we have
<math id="A1.SS2.p21.m6" class="ltx_Math" alttext="\|\delta W_{l}\|_{2}\leq\|\delta\|_{2}\|W_{l}\|_{2}\ll\beta\|W_{l}\|_{2}=\|\beta\sigma_{1}v_{1}^{\top}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≪</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\delta W_{l}\|_{2}\leq\|\delta\|_{2}\|W_{l}\|_{2}\ll\beta\|W_{l}\|_{2}=\|\beta\sigma_{1}v_{1}^{\top}\|_{2}</annotation></semantics></math>,
which means the norm of the residual term <math id="A1.SS2.p21.m7" class="ltx_Math" alttext="\delta W_{l}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">\delta W_{l}</annotation></semantics></math>
is much smaller than that of the projection term
<math id="A1.SS2.p21.m8" class="ltx_Math" alttext="\beta\sigma_{1}v_{1}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">\beta\sigma_{1}v_{1}^{\top}</annotation></semantics></math>.
Thus, the norm of the pre-activation <math id="A1.SS2.p21.m9" class="ltx_Math" alttext="f^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">f^{(l)}</annotation></semantics></math>
can be approximated as <math id="A1.SS2.p21.m10" class="ltx_Math" alttext="\|f^{(l)}\|_{2}\approx\beta\|W_{l}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≈</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|f^{(l)}\|_{2}\approx\beta\|W_{l}\|_{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS2.p22" class="ltx_para ltx_noindent">
<p id="A1.SS2.p22.1" class="ltx_p"><a href="#Thmtheorem1" title="Theorem 1 (Spectral Norm Growth During Training). ‣ 3.2 Theoretical Justification for Detection Ability of Spectral Alignment ‣ 3 Spectral Alignment and Theoretical Justification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a><span id="A1.SS2.p22.1.1" class="ltx_text">
proves that under the pathological alignment condition,
the spectral norm <math id="A1.SS2.p22.m1" class="ltx_Math" alttext="\|W_{l}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|W_{l}\|_{2}</annotation></semantics></math> increases in a single gradient descent step.
According to the above discussion, when <math id="A1.SS2.p22.m2" class="ltx_Math" alttext="\|W_{l}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>l</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|W_{l}\|_{2}</annotation></semantics></math> increases,
the norm of the pre-activation <math id="A1.SS2.p22.m3" class="ltx_Math" alttext="f^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">f^{(l)}</annotation></semantics></math> also increases.
Since activation functions such as ReLU are monotonic,
this will cause the norm of the activation
<math id="A1.SS2.p22.m4" class="ltx_Math" alttext="h^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(l)}</annotation></semantics></math> to increase as well.</span></p>
</div>
<div id="A1.SS2.p23" class="ltx_para ltx_noindent">
<p id="A1.SS2.p23.1" class="ltx_p"><span id="A1.SS2.p23.1.1" class="ltx_text">Now consider the gradient in the backward propagation process.
By <a href="#Thmtheorem2" title="Theorem 2 (Gradient Expression for Linear Layers). ‣ A.1 Proof with respect to parameters ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a>,
the approximate expression for the gradient is</span></p>
<table id="A1.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex45.m1" class="ltx_Math" alttext="\frac{\partial L}{\partial W_{l}}\approx(h^{(l-1)})^{\top}(p-t)\rho\left(\prod_{k=L}^{l+1}W_{k}^{\top}\right)\cdot\mathrm{Diag}(1(f^{(l)}&gt;0))" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><msub><mi>W</mi><mi>l</mi></msub></mrow></mfrac><mo>≈</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>W</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>Diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial L}{\partial W_{l}}\approx(h^{(l-1)})^{\top}(p-t)\rho\left(\prod_{k=L}^{l+1}W_{k}^{\top}\right)\cdot\mathrm{Diag}(1(f^{(l)}&gt;0))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p23.2" class="ltx_p"><span id="A1.SS2.p23.2.1" class="ltx_text">where
<math id="A1.SS2.p23.m1" class="ltx_Math" alttext="\left(\prod_{k=L}^{l+1}W_{k}^{\top}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><msubsup><mi>W</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\prod_{k=L}^{l+1}W_{k}^{\top}\right)</annotation></semantics></math>
is the product of transposed weight matrices in the backward pass.
As analyzed in <a href="#Thmtheorem4" title="Theorem 4 (Change of the Spectral Norm). ‣ A.2 Proof of ‣ Appendix A Proofs of Theoretical Results" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4</span></a> for forward propagation,
when the input <math id="A1.SS2.p23.m2" class="ltx_Math" alttext="h^{(l-1)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(l-1)}</annotation></semantics></math> is aligned with <math id="A1.SS2.p23.m3" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math>,
the corresponding pre-activation <math id="A1.SS2.p23.m4" class="ltx_Math" alttext="f^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">f^{(l)}</annotation></semantics></math> is aligned with <math id="A1.SS2.p23.m5" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math>,
causing the forward signal to be amplified along
the principal singular directions of each weight matrix.</span></p>
</div>
<div id="A1.SS2.p24" class="ltx_para ltx_noindent">
<p id="A1.SS2.p24.1" class="ltx_p"><span id="A1.SS2.p24.1.1" class="ltx_text">In the gradient expression,
the key term
<math id="A1.SS2.p24.m1" class="ltx_Math" alttext="\left(\prod_{k=L}^{l+1}W_{k}^{\top}\right)\cdot\mathrm{Diag}(1(f^{(l)}&gt;0))" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msubsup><msubsup><mi>W</mi><mi>k</mi><mo>⊤</mo></msubsup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>Diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\prod_{k=L}^{l+1}W_{k}^{\top}\right)\cdot\mathrm{Diag}(1(f^{(l)}&gt;0))</annotation></semantics></math>
essentially represents the network’s forward propagation.
Since the forward signal is forcibly amplified along the principal singular directions,
the backward gradient signal will also propagate along these directions.
Under the pathological alignment condition,
the spectral norm <math id="A1.SS2.p24.m2" class="ltx_Math" alttext="\|W_{k}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|W_{k}\|_{2}</annotation></semantics></math> of each weight matrix grows,
causing the backward gradient signal to be repeatedly amplified.</span></p>
</div>
<div id="A1.SS2.p25" class="ltx_para ltx_noindent">
<p id="A1.SS2.p25.1" class="ltx_p"><span id="A1.SS2.p25.1.1" class="ltx_text">Therefore,
the growth trend of the backward gradient norm can be approximated
by the product of the spectral norms of each weight matrix:</span></p>
<table id="A1.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex46.m1" class="ltx_Math" alttext="\left\|\frac{\partial L}{\partial W_{l}}\right\|_{F}\propto\|h^{(l-1)}\|_{2}\cdot\prod_{k=L}^{l+1}\|W_{k}\|_{2}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><msub><mi>W</mi><mi>l</mi></msub></mrow></mfrac><mo>‖</mo></mrow><mi>F</mi></msub><mo>∝</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.055em" stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>k</mi><mo>=</mo><mi>L</mi></mrow><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></munderover><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|\frac{\partial L}{\partial W_{l}}\right\|_{F}\propto\|h^{(l-1)}\|_{2}\cdot\prod_{k=L}^{l+1}\|W_{k}\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p25.2" class="ltx_p"><span id="A1.SS2.p25.2.1" class="ltx_text">When the spectral norm <math id="A1.SS2.p25.m1" class="ltx_Math" alttext="\|W_{k}\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\|W_{k}\|_{2}</annotation></semantics></math> increases,
the gradient norm will also increase,
leading to loss explosion.
∎</span></p>
</div>
</div>
<div id="A1.SS2.p26" class="ltx_para ltx_noindent">
<p id="A1.SS2.p26.1" class="ltx_p"><cite class="ltx_cite"><span class="ltx_ref ltx_missing_citation ltx_ref_self">*</span></cite></p>
</div>
</section>
</section>
