<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>LLM Generation Prompt Template</h2>

<div id="A4.p1" class="ltx_para"><code id="A4.p1.1" class="ltx_verbatim"><span class="ltx_inline-block"><svg id="A4.p1.pic1" class="ltx_picture" height="61.85" overflow="visible" version="1.1" viewBox="0 0 550 61.85" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,61.85) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 55.94 C 0 59.2 2.64 61.85 5.91 61.85 L 544.09 61.85 C 547.36 61.85 550 59.2 550 55.94 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 37.89 L 548.03 37.89 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 46.49)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
