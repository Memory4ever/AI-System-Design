{"data":{"id":"10.48550/arxiv.2510.04547","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04547","prefix":"10.48550","suffix":"arxiv.2510.04547","identifiers":[{"identifier":"2510.04547","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.04547"}],"creators":[{"name":"Kim, Seunghyeon","nameType":"Personal","givenName":"Seunghyeon","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Yeom, Taesun","nameType":"Personal","givenName":"Taesun","familyName":"Yeom","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Jinho","nameType":"Personal","givenName":"Jinho","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Park, Wonpyo","nameType":"Personal","givenName":"Wonpyo","familyName":"Park","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Kyuyeun","nameType":"Personal","givenName":"Kyuyeun","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Jaeho","nameType":"Personal","givenName":"Jaeho","familyName":"Lee","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Activation Quantization of Vision Encoders Needs Prefixing Registers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T07:27:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:18:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T06:33:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:27:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-28T12:54:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-01T02:26:10Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-19T12:18:57Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-20T00:55:25Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-07-08T06:28:12Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-07-09T00:24:47Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large pretrained vision encoders are central to multimodal intelligence, powering applications from on-device vision processing to vision-language models. Since these applications often demand real-time processing of massive visual data, reducing the inference cost of vision encoders is critical. Quantization offers a practical path, but it remains challenging even at 8-bit precision due to so-called outliers. In this work, we propose $\\textit{RegCache}$, a training-free algorithm that mitigates outliers in large-scale pretrained vision encoders and serves as a plug-in module that can be applied on top of other quantization methods. RegCache introduces outlier-prone yet semantically meaningless prefix tokens to the vision encoder, which prevent other tokens from having outliers. Notably, we observe that outliers in vision encoders behave differently from those in language models, motivating two technical innovations: middle-layer prefixing and token deletion. Experimental results show that our method consistently improves quantized model performance across various vision encoders, particularly in extremely low-bit regimes (e.g., 4-bit).","descriptionType":"Abstract"},{"description":"Accepted to ECCV 2026. Code: https://github.com/spbob0418/RegCache","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.04547","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:17:11.000Z","registered":"2025-10-07T03:17:12.000Z","published":"2025","updated":"2026-07-09T02:02:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.04547","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}