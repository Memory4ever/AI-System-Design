<td id="A2.T4.10.3.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m1" class="ltx_Math" alttext="2035" display="inline" intent=":literal"><semantics><mn>2035</mn><annotation encoding="application/x-tex">2035</annotation></semantics></math></td>
<td id="A2.T4.10.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m2" class="ltx_Math" alttext="1221" display="inline" intent=":literal"><semantics><mn>1221</mn><annotation encoding="application/x-tex">1221</annotation></semantics></math></td>
<td id="A2.T4.10.3.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m3" class="ltx_Math" alttext="2194" display="inline" intent=":literal"><semantics><mn>2194</mn><annotation encoding="application/x-tex">2194</annotation></semantics></math></td>
<td id="A2.T4.10.3.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m4" class="ltx_Math" alttext="2050" display="inline" intent=":literal"><semantics><mn>2050</mn><annotation encoding="application/x-tex">2050</annotation></semantics></math></td>
<td id="A2.T4.10.3.6" class="ltx_td ltx_align_center ltx_border_bb"><math id="A2.T4.m5" class="ltx_Math" alttext="1418" display="inline" intent=":literal"><semantics><mn>1418</mn><annotation encoding="application/x-tex">1418</annotation></semantics></math></td></tr>
