<th id="S1.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S1.T1.2.1.5.1.1" class="ltx_text ltx_font_bold">LEGO-IRT</span></th>
<td id="S1.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">high</td>
