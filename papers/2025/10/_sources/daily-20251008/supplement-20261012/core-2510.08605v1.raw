<span id="S5.T1.2.1.1.1.1.1.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">Multiple-choice question</span>
<span id="S5.T1.2.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t">97.38%</span>
<span id="S5.T1.2.1.1.1.1.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">89.85%</span>
<span id="S5.T1.2.1.1.1.1.1.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">93.62%</span>
<span id="S5.T1.2.1.1.1.1.1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">97.18%</span>
