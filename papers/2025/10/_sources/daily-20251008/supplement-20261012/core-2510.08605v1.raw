<span id="S5.T1.2.1.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t ltx_colspan ltx_colspan_3"><span id="S5.T1.2.1.1.1.1.1.1.1.2.1" class="ltx_text ltx_font_bold">RAG-Llama (text-embedding-3-large)</span></span>
<span id="S5.T1.2.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t ltx_colspan ltx_colspan_3"><span id="S5.T1.2.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">RAG-Llama (jina-embeddings-v3)</span></span>
<span id="S5.T1.2.1.1.1.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t ltx_colspan ltx_colspan_3"><span id="S5.T1.2.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">RAG-Llama (multilingual-e5-large)</span></span></span>
<span id="S5.T1.2.1.1.1.1.1.1.2" class="ltx_tr">
<span id="S5.T1.2.1.1.1.1.1.1.2.1" class="ltx_td ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"></span>
<span id="S5.T1.2.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">False</span>
