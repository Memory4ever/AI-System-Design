</figure>
<figure id="S4.T4" class="ltx_table">
<table id="S4.T4.3" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S4.T4.3.1" class="ltx_tr">
<td id="S4.T4.3.1.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;" rowspan="2"><span id="S4.T4.3.1.1.1" class="ltx_text" style="font-size:90%;">   </span><span id="S4.T4.3.1.1.2" class="ltx_text" style="font-size:90%;"><math id="S4.T4.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math></span><span id="S4.T4.3.1.1.3" class="ltx_text" style="font-size:90%;">   </span></td>
<td id="S4.T4.3.1.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;" colspan="2"><span id="S4.T4.3.1.2.1" class="ltx_text" style="font-size:90%;">   </span><span id="S4.T4.3.1.2.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Dataset</span><span id="S4.T4.3.1.2.3" class="ltx_text" style="font-size:90%;">   </span></td>
<td id="S4.T4.3.1.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;" rowspan="2"><span id="S4.T4.3.1.3.1" class="ltx_text" style="font-size:90%;">   </span><span id="S4.T4.3.1.3.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Overall</span><span id="S4.T4.3.1.3.3" class="ltx_text" style="font-size:90%;">   </span></td></tr>
<tr id="S4.T4.3.2" class="ltx_tr">
<td id="S4.T4.3.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;"><span id="S4.T4.3.2.1.1" class="ltx_text" style="font-size:90%;">   </span><span id="S4.T4.3.2.1.2" class="ltx_text ltx_font_bold" style="font-size:90%;">LUAD</span><span id="S4.T4.3.2.1.3" class="ltx_text" style="font-size:90%;">   </span></td>
<td id="S4.T4.3.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:15.0pt;padding-right:15.0pt;"><span id="S4.T4.3.2.2.1" class="ltx_text" style="font-size:90%;">   </span><span id="S4.T4.3.2.2.2" class="ltx_text ltx_font_bold" style="font-size:90%;">BLCA</span><span id="S4.T4.3.2.2.3" class="ltx_text" style="font-size:90%;">   </span></td></tr>
