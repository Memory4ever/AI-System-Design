<td id="S4.T3.3.3.1" class="ltx_td ltx_align_left" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.3.1.1" class="ltx_text" style="font-size:90%;">CMTA + FeatProto (Large) + Euclidean Similarity</span></td>
<td id="S4.T3.3.3.2" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.3.2.1" class="ltx_text" style="font-size:90%;">0.6941±0.0265</span></td></tr>
<tr id="S4.T3.3.4" class="ltx_tr">
<td id="S4.T3.3.4.1" class="ltx_td ltx_align_left" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.4.1.1" class="ltx_text" style="font-size:90%;">CMTA + FeatProto (Large) + PMDSim</span></td>
<td id="S4.T3.3.4.2" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.4.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.7167±0.0315</span></td></tr>
<tr id="S4.T3.3.5" class="ltx_tr">
<td id="S4.T3.3.5.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Model</span></td>
<td id="S4.T3.3.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.5.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">BLCA</span></td></tr>
<tr id="S4.T3.3.6" class="ltx_tr">
<td id="S4.T3.3.6.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.6.1.1" class="ltx_text" style="font-size:90%;">CCL + FeatProto(Large) + Cosine Similarity</span></td>
<td id="S4.T3.3.6.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.6.2.1" class="ltx_text" style="font-size:90%;">0.6605±0.0277</span></td></tr>
<tr id="S4.T3.3.7" class="ltx_tr">
<td id="S4.T3.3.7.1" class="ltx_td ltx_align_left" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S4.T3.3.7.1.1" class="ltx_text" style="font-size:90%;">CCL + FeatProto(Large) + Euclidean Similarity</span></td>
