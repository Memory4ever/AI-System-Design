</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F7.fig3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.04533v1/Assets/Qualitative/Cond/full_size_dog/SD1.5_sample_seed_1032485116_tgs_2.0_a_full_size_dog_is_smelling_a_bat_on_a_ballfield._cfg_2.5.jpg" id="S5.F7.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:537/537;" width="537" height="537" alt="Refer to caption">
