<span id="S2.F2.2.4.1.1.1" class="ltx_p"><span id="S2.F2.2.4.1.1.1.1" class="ltx_text" style="position:relative; bottom:25.3pt;">
<span id="S2.F2.2.4.1.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:9.9pt;height:29.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:29.2pt;transform:translate(-9.6pt,-9.6pt) rotate(-90deg) ;">
<span id="S2.F2.2.4.1.1.1.1.1.1" class="ltx_p"><math id="S2.F2.m4" class="ltx_Math" alttext="\bm{\Delta_{k}^{\rm TAG}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝚫</mi><mi>𝒌</mi><mi>𝐓𝐀𝐆</mi></msubsup><annotation encoding="application/x-tex">\bm{\Delta_{k}^{\rm TAG}}</annotation></semantics></math></span>
</span></span></span></span>
</span></th>
<td id="S2.F2.2.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-bottom: -20.00003pt;padding:-5pt 0.0pt;"><img src="2510.04533v1/Assets/Tangential_visualize/delta/delta_step_981_mag_Greys_r_mag_981.jpg" id="S2.F2.g35" class="ltx_graphics ltx_img_square" style="aspect-ratio:42/42;" width="42" height="42" alt="Refer to caption"></td>
