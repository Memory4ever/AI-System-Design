<th id="S5.T5.6.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="--ltx-bg-color:#F0F1FF;padding-left:4.0pt;padding-right:4.0pt;">
<span id="S5.T5.6.3.1.1" class="ltx_inline-block ltx_align_top">
