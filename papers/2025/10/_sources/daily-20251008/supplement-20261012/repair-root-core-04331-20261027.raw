<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex123.m1" class="ltx_Math" alttext="\displaystyle\widetilde{B}_{n,2}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{B}_{n,2}({\bm{X}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex123.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|&gt;1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,0}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|&gt;1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,0}m_{Q,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
