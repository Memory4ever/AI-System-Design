<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex91.m2" class="ltx_Math" alttext="\displaystyle=m_{V}\frac{\partial\bm{N}}{\partial{{\bm{A}}^{(u)}}}\bm{X},\quad\dfrac{\partial\widetilde{V}}{\partial{{\bm{B}}^{(u)}}}=m_{V}\frac{\partial\bm{N}}{\partial{{\bm{B}}^{(u)}}}\bm{X}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>m</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>𝑵</mi></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo>=</mo><mrow><msub><mi>m</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>𝑵</mi></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=m_{V}\frac{\partial\bm{N}}{\partial{{\bm{A}}^{(u)}}}\bm{X},\quad\dfrac{\partial\widetilde{V}}{\partial{{\bm{B}}^{(u)}}}=m_{V}\frac{\partial\bm{N}}{\partial{{\bm{B}}^{(u)}}}\bm{X},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex92.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\partial^{2}\widetilde{V}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{A}}^{(v)}}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\dfrac{\partial^{2}\widetilde{V}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{A}}^{(v)}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex92.m2" class="ltx_Math" alttext="\displaystyle=m_{V}\frac{\partial^{2}\bm{N}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{A}}^{(v)}}}\bm{X},\quad\dfrac{\partial^{2}\widetilde{V}}{\partial{{\bm{B}}^{(u)}}\partial{{\bm{B}}^{(v)}}}=m_{V}\frac{\partial^{2}\bm{N}}{\partial{{\bm{B}}^{(u)}}\partial{{\bm{B}}^{(v)}}}\bm{X},\dfrac{\partial^{2}\widetilde{V}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{B}}^{(v)}}}=m_{V}\frac{\partial^{2}\bm{N}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{B}}^{(v)}}}\bm{X}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>m</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><mi>𝑵</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><msub><mi>m</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><mi>𝑵</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><msub><mi>m</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><mi>𝑵</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=m_{V}\frac{\partial^{2}\bm{N}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{A}}^{(v)}}}\bm{X},\quad\dfrac{\partial^{2}\widetilde{V}}{\partial{{\bm{B}}^{(u)}}\partial{{\bm{B}}^{(v)}}}=m_{V}\frac{\partial^{2}\bm{N}}{\partial{{\bm{B}}^{(u)}}\partial{{\bm{B}}^{(v)}}}\bm{X},\dfrac{\partial^{2}\widetilde{V}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{B}}^{(v)}}}=m_{V}\frac{\partial^{2}\bm{N}}{\partial{{\bm{A}}^{(u)}}\partial{{\bm{B}}^{(v)}}}\bm{X}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p4.2" class="ltx_p">Plugging these terms into <math id="A3.SS2.SSS1.Px1.p4.m7" class="ltx_Math" alttext="\widetilde{A}_{n,1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\widetilde{A}_{n,1}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p4.m8" class="ltx_Math" alttext="\widetilde{A}_{n,2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\widetilde{A}_{n,2}</annotation></semantics></math>, we obtain that:</p>
<table id="A3.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex93.m1" class="ltx_Math" alttext="\displaystyle\widetilde{A}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{A}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex93.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\Biggr\{\sum_{|\alpha|=1}\biggr\{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})m_{Q,j}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{\alpha_{1}}\partial\bm{B}^{\alpha_{2}}}\bm{X}\widetilde{V}_{j}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mo lspace="0em" rspace="0em">{</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder></mstyle><mo lspace="0em" rspace="0em">{</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mi>exp</mi><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mi>𝑿</mi><msubsup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\Biggr\{\sum_{|\alpha|=1}\biggr\{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})m_{Q,j}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{\alpha_{1}}\partial\bm{B}^{\alpha_{2}}}\bm{X}\widetilde{V}_{j}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex94.m1" class="ltx_math_unparsed" alttext="\displaystyle+\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}m_{V,j}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{\alpha_{1}}\bm{B}^{\alpha_{2}}}\bm{X}\widetilde{U}_{j}\biggr\}+\widetilde{R}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mfrac></mstyle><mi>𝑿</mi><msub><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">}</mo><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}m_{V,j}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{\alpha_{1}}\bm{B}^{\alpha_{2}}}\bm{X}\widetilde{U}_{j}\biggr\}+\widetilde{R}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex95.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\Bigg[\sum_{u=(1,1)}^{(d,d)}\widetilde{M}_{n,j,u,0}\left(m_{Q,j}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)m_{V,j}\bm{N}_{j}^{*}\bm{X}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><mrow><mo>(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\Bigg[\sum_{u=(1,1)}^{(d,d)}\widetilde{M}_{n,j,u,0}\left(m_{Q,j}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)m_{V,j}\bm{N}_{j}^{*}\bm{X}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex96.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u=(1,1)}^{(d,d)}\widetilde{M}_{n,j,0,u}\left(m_{Q,j}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)m_{V,j}\bm{N}_{j}^{*}\bm{X}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><mrow><mo>(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u=(1,1)}^{(d,d)}\widetilde{M}_{n,j,0,u}\left(m_{Q,j}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)m_{V,j}\bm{N}_{j}^{*}\bm{X}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u=(1,1)}^{(d,d)}\widetilde{M}_{n,j,u,0}m_{V,j}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}+\widetilde{M}_{n,j,0,u}m_{V,j}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\Bigg]+\widetilde{R}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>+</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo maxsize="2.600em" minsize="2.600em">]</mo><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u=(1,1)}^{(d,d)}\widetilde{M}_{n,j,u,0}m_{V,j}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}+\widetilde{M}_{n,j,0,u}m_{V,j}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\Bigg]+\widetilde{R}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex98.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\Bigg[\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{M}_{n,j,u,0}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\Bigg[\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{M}_{n,j,u,0}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex99.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{M}_{n,j,0,u}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{M}_{n,j,0,u}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u=(1,1)}^{(d,d)}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\times\widetilde{M}_{n,j,u,0}m_{V,j}+\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\times\widetilde{M}_{n,j,0,u}m_{V,j}\Bigg]+\widetilde{R}_{n,1}(\bm{X})." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u=(1,1)}^{(d,d)}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\times\widetilde{M}_{n,j,u,0}m_{V,j}+\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\times\widetilde{M}_{n,j,0,u}m_{V,j}\Bigg]+\widetilde{R}_{n,1}(\bm{X}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p4.3" class="ltx_p">On the other hand, we have</p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex101.m1" class="ltx_Math" alttext="\displaystyle\widetilde{A}_{n,2}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{A}_{n,2}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex101.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|&gt;1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\Bigg[\sum_{u}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\bm{N}^{*}_{j}\bm{X}\widetilde{M}_{n,j,u,0}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>u</mi></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|&gt;1}\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})\Bigg[\sum_{u}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\bm{N}^{*}_{j}\bm{X}\widetilde{M}_{n,j,u,0}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex102.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\bm{N}^{*}_{j}\bm{X}\widetilde{M}_{n,j,0,u}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>u</mi></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\bm{N}^{*}_{j}\bm{X}\widetilde{M}_{n,j,0,u}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex103.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\widetilde{M}_{n,j,u,0}m_{V,j}+\sum_{u}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\widetilde{M}_{n,j,0,u}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>u</mi></msub><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mover accent="true"><mi>M</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><mi>m</mi><msub><mrow></mrow><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>u</mi></msub><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mover accent="true"><mi>M</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><mi>m</mi><msub><mrow></mrow><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\widetilde{M}_{n,j,u,0}m_{V,j}+\sum_{u}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\widetilde{M}_{n,j,0,u}m_{V,j}</annotation></semantics></math></td>
