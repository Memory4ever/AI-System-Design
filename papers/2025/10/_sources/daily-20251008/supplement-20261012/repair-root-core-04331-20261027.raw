<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex28.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 85.35826pt-\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c^{n}_{i})\Bigg[\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>i</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><msub><mi>𝑪</mi><mi>K</mi></msub><mi>𝑿</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 85.35826pt-\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c^{n}_{i})\Bigg[\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)</annotation></semantics></math></td>
