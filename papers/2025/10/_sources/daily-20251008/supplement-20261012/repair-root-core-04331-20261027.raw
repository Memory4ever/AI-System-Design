<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex143.m1" class="ltx_Math" alttext="\displaystyle\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X}),\quad\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X}),\quad\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex144.m1" class="ltx_Math" alttext="\displaystyle\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X}),\quad\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X}),\quad\widetilde{U}_{j}^{*}(\bm{X})\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS1.Px2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p4.1" class="ltx_p">for any indices <math id="A3.SS2.SSS1.Px2.p4.m1" class="ltx_Math" alttext="1\leq j\leq L" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">1\leq j\leq L</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px2.p4.m2" class="ltx_Math" alttext="u=(u_{1},u_{2}),v=(v_{1},v_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>v</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u=(u_{1},u_{2}),v=(v_{1},v_{2})</annotation></semantics></math> with <math id="A3.SS2.SSS1.Px2.p4.m3" class="ltx_Math" alttext="1\leq u_{1},v_{1},u_{2},v_{2}\leq d" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>v</mi><mn>2</mn></msub><mo>≤</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq u_{1},v_{1},u_{2},v_{2}\leq d</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px2.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p5.1" class="ltx_p">We will show that at least one of the coefficients of these independent functions does not go to 0 as <math id="A3.SS2.SSS1.Px2.p5.m1" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. Assume by contrary that all these coefficients of these linear independent functions go to 0 when <math id="A3.SS2.SSS1.Px2.p5.m2" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. From equation (<a href="#A3.E14" title="In Decomposing 𝐵̃_𝑛⁢(𝑿). ‣ C.2.1 Local Part ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), we have that <math id="A3.SS2.SSS1.Px2.p5.m3" class="ltx_Math" alttext="\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math>, <math id="A3.SS2.SSS1.Px2.p5.m4" class="ltx_Math" alttext="\widetilde{M}_{n,j,\alpha_{1},\beta_{1},\alpha_{2},\beta_{2}}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{M}_{n,j,\alpha_{1},\beta_{1},\alpha_{2},\beta_{2}}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math>, and <math id="A3.SS2.SSS1.Px2.p5.m5" class="ltx_Math" alttext="\widetilde{N}_{n,j}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{N}_{n,j}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math> go to 0 for all the coefficients <math id="A3.SS2.SSS1.Px2.p5.m6" class="ltx_Math" alttext="\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}\in\mathbb{N}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∈</mo><msup><mi>ℕ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}\in\mathbb{N}^{d\times d}</annotation></semantics></math> satisfying that <math id="A3.SS2.SSS1.Px2.p5.m7" class="ltx_Math" alttext="1\leq|\alpha_{1}|+|\beta_{1}|+|\alpha_{2}|+|\beta_{2}|\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>α</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo rspace="0em">+</mo></mrow></mrow></mrow><mo fence="false" lspace="0em">|</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>≤</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">1\leq|\alpha_{1}|+|\beta_{1}|+|\alpha_{2}|+|\beta_{2}|\leq 2</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px2.p6" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p6.1" class="ltx_p">Since <math id="A3.SS2.SSS1.Px2.p6.m1" class="ltx_Math" alttext="\widetilde{N}_{n,j}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{N}_{n,j}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0</annotation></semantics></math>, we find that for any <math id="A3.SS2.SSS1.Px2.p6.m2" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math></p>
<table id="A3.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex145.m1" class="ltx_Math" alttext="\displaystyle\frac{|\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}=\frac{|\widetilde{N}_{n,j}|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{|\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}=\frac{|\widetilde{N}_{n,j}|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p6.2" class="ltx_p">Taking the summation of these limits over <math id="A3.SS2.SSS1.Px2.p6.m3" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math> yields</p>
<table id="A3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E15.m1" class="ltx_Math" alttext="\displaystyle\frac{\sum_{j=1}^{L}|\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{j=1}^{L}|\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p6.3" class="ltx_p">Now, for any index <math id="A3.SS2.SSS1.Px2.p6.m4" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math> such that <math id="A3.SS2.SSS1.Px2.p6.m5" class="ltx_Math" alttext="|\mathcal{V}_{j}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{V}_{j}|=1</annotation></semantics></math>, the limits <math id="A3.SS2.SSS1.Px2.p6.m6" class="ltx_Math" alttext="\widetilde{M}_{n,j,e_{u},0_{d}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>e</mi><mi>u</mi></msub><mo>,</mo><msub><mn>0</mn><mi>d</mi></msub></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{M}_{n,j,e_{u},0_{d}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0</annotation></semantics></math> lead to <math id="A3.SS2.SSS1.Px2.p6.m7" class="ltx_Math" alttext="\frac{\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\|\Delta{\bm{A}}_{n,ij}\|_{1}}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\|\Delta{\bm{A}}_{n,ij}\|_{1}}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0</annotation></semantics></math> as <math id="A3.SS2.SSS1.Px2.p6.m8" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.
Because the <math id="A3.SS2.SSS1.Px2.p6.m9" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math>-norm and <math id="A3.SS2.SSS1.Px2.p6.m10" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math>-norm are equivalent, this result implies that</p>
<table id="A3.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex146.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\|\Delta{\bm{A}}_{n,ij}\|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></msub><mo>∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mi>exp</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>𝑨</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em">∥</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\|\Delta{\bm{A}}_{n,ij}\|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p6.4" class="ltx_p">Similarly, since <math id="A3.SS2.SSS1.Px2.p6.m11" class="ltx_Math" alttext="\widetilde{M}_{n,j,0_{d},e_{u}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mn>0</mn><mi>d</mi></msub><mo>,</mo><msub><mi>e</mi><mi>u</mi></msub></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{M}_{n,j,0_{d},e_{u}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0</annotation></semantics></math>, we also have that <math id="A3.SS2.SSS1.Px2.p6.m12" class="ltx_math_unparsed" alttext="\frac{\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\|\Delta{\bm{B}}_{n,ij}\|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></msub><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mi>exp</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em">∥</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\|\Delta{\bm{B}}_{n,ij}\|}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0</annotation></semantics></math>. Thus, we obtain</p>
<table id="A3.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E16.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{A}}_{n,ij}\|+\|\Delta{\bm{B}}_{n,ij}\|)}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></msub><mo>∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mi>exp</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>𝑨</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mo stretchy="false">)</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{A}}_{n,ij}\|+\|\Delta{\bm{B}}_{n,ij}\|)}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p6.5" class="ltx_p">Moving to indices <math id="A3.SS2.SSS1.Px2.p6.m13" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math> such that their corresponding Voronoi cells have more than one element, i.e., <math id="A3.SS2.SSS1.Px2.p6.m14" class="ltx_Math" alttext="|\mathcal{V}_{j}|&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{V}_{j}|&gt;1</annotation></semantics></math>. The limits <math id="A3.SS2.SSS1.Px2.p6.m15" class="ltx_Math" alttext="\widetilde{M}_{n,j,2e_{u},0_{d}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>u</mi></msub></mrow><mo>,</mo><msub><mn>0</mn><mi>d</mi></msub></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{M}_{n,j,2e_{u},0_{d}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px2.p6.m16" class="ltx_Math" alttext="\widetilde{M}_{n,j,0_{d},2e_{u}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mn>0</mn><mi>d</mi></msub><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>u</mi></msub></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{M}_{n,j,0_{d},2e_{u}}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0</annotation></semantics></math> induces that</p>
<table id="A3.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E17.m1" class="ltx_math_unparsed" alttext="\displaystyle\frac{\sum_{j:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{A}}_{n,ij}\|^{2}+\|\Delta{\bm{B}}_{n,ij}\|^{2})}{\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to 0" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></msub><mo>∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mi>exp</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>𝑨</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><mi>𝑩</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\sum_{j:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{A}}_{n,ij}\|^{2}+\|\Delta{\bm{B}}_{n,ij}\|^{2})}{\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p6.6" class="ltx_p">By putting the results in equations (<a href="#A3.E15" title="In Decomposing 𝐵̃_𝑛⁢(𝑿). ‣ C.2.1 Local Part ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>), (<a href="#A3.E16" title="In Decomposing 𝐵̃_𝑛⁢(𝑿). ‣ C.2.1 Local Part ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), and (<a href="#A3.E17" title="In Decomposing 𝐵̃_𝑛⁢(𝑿). ‣ C.2.1 Local Part ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) together, we arrive at <math id="A3.SS2.SSS1.Px2.p6.m17" class="ltx_Math" alttext="1=\frac{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>=</mo><mfrac><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">1=\frac{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}{\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})}\to 0</annotation></semantics></math>
as <math id="A3.SS2.SSS1.Px2.p6.m18" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>, which is a contradiction. As a consequence, at least one of the coefficients of the linear independent functions in <math id="A3.SS2.SSS1.Px2.p6.m19" class="ltx_Math" alttext="T_{n}(\bm{X})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{n}(\bm{X})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math> does not go to 0 as <math id="A3.SS2.SSS1.Px2.p6.m20" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px2.p7" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p7.1" class="ltx_p"><span id="A3.SS2.SSS1.Px2.p7.1.1" class="ltx_text ltx_font_bold">Step 3 - Application of the Fatou’s lemma.</span> We define <math id="A3.SS2.SSS1.Px2.p7.m1" class="ltx_Math" alttext="\widetilde{m}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widetilde{m}_{n}</annotation></semantics></math> to be the maximum of the absolute values of the coefficients of the linear independent functions in <math id="A3.SS2.SSS1.Px2.p7.m2" class="ltx_Math" alttext="T_{n}(\bm{X})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{n}(\bm{X})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math>. As at least one of these coefficients does not go to 0, it
indicates that <math id="A3.SS2.SSS1.Px2.p7.m3" class="ltx_Math" alttext="1/\widetilde{m}_{n}\not\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>/</mo><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo stretchy="false">↛</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">1/\widetilde{m}_{n}\not\to\infty</annotation></semantics></math> as <math id="A3.SS2.SSS1.Px2.p7.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px2.p8" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p8.1" class="ltx_p">Since <math id="A3.SS2.SSS1.Px2.p8.m1" class="ltx_Math" alttext="\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0</annotation></semantics></math> as <math id="A3.SS2.SSS1.Px2.p8.m2" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>, we obtain <math id="A3.SS2.SSS1.Px2.p8.m3" class="ltx_Math" alttext="\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/(\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*}))\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/(\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*}))\to 0</annotation></semantics></math>. An application of the Fatou’s lemma leads to:</p>
<table id="A3.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex147.m1" class="ltx_Math" alttext="\displaystyle 0=\lim_{n\to\infty}\dfrac{\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\geq\int\liminf_{n\to\infty}\dfrac{\left|f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right|}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}d\mu(\bm{X})\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>≥</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mfrac><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>μ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mstyle><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 0=\lim_{n\to\infty}\dfrac{\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\geq\int\liminf_{n\to\infty}\dfrac{\left|f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right|}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}d\mu(\bm{X})\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p8.2" class="ltx_p">This inequality implies that <math id="A3.SS2.SSS1.Px2.p8.m4" class="ltx_Math" alttext="\liminf_{n\to\infty}\dfrac{\left|f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right|}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\liminf_{n\to\infty}\dfrac{\left|f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right|}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}=0</annotation></semantics></math> for almost surely <math id="A3.SS2.SSS1.Px2.p8.m5" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>. As <math id="A3.SS2.SSS1.Px2.p8.m6" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>, we have</p>
<table id="A3.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex148.m1" class="ltx_Math" alttext="\displaystyle\dfrac{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to\tilde{\tau}_{j,\alpha_{1},\alpha_{2}},\quad\dfrac{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to\tilde{\xi}_{j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}},\quad\dfrac{\widetilde{N}_{n,j}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to\tilde{\lambda}_{0,j}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub></mrow><mo rspace="1.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><msub><mover accent="true"><mi>ξ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub></mrow><mo rspace="1.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">→</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to\tilde{\tau}_{j,\alpha_{1},\alpha_{2}},\quad\dfrac{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to\tilde{\xi}_{j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}},\quad\dfrac{\widetilde{N}_{n,j}}{\widetilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}\to\tilde{\lambda}_{0,j},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p8.3" class="ltx_p">for any indices <math id="A3.SS2.SSS1.Px2.p8.m7" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math> and any coefficients <math id="A3.SS2.SSS1.Px2.p8.m8" class="ltx_Math" alttext="\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}</annotation></semantics></math> such that <math id="A3.SS2.SSS1.Px2.p8.m9" class="ltx_Math" alttext="1\leq|\alpha_{1}|+|\alpha_{2}|+|\beta_{1}|+|\beta_{2}|\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>α</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo rspace="0em">+</mo></mrow></mrow></mrow><mo fence="false" lspace="0em">|</mo><mrow><msub><mi>β</mi><mn>2</mn></msub><mo fence="false">|</mo><mrow><mphantom></mphantom><mo>≤</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">1\leq|\alpha_{1}|+|\alpha_{2}|+|\beta_{1}|+|\beta_{2}|\leq 2</annotation></semantics></math>. Here, at least one element of the set <math id="A3.SS2.SSS1.Px2.p8.m10" class="ltx_Math" alttext="\{\tilde{\tau}_{j,\alpha_{1},\alpha_{2}},\tilde{\xi}_{j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}},\tilde{\lambda}_{0,j}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>ξ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{\tau}_{j,\alpha_{1},\alpha_{2}},\tilde{\xi}_{j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}},\tilde{\lambda}_{0,j}\}</annotation></semantics></math> is different from 0. Given the above notations, the limit <math id="A3.SS2.SSS1.Px2.p8.m11" class="ltx_Math" alttext="\liminf_{n\to\infty}\dfrac{\left|f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right|}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\liminf_{n\to\infty}\dfrac{\left|f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right|}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}=0</annotation></semantics></math> implies that:</p>
<table id="A3.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex149.m1" class="ltx_Math" alttext="\displaystyle 0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\displaystyle 0</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex149.m2" class="ltx_Math" alttext="\displaystyle=\liminf_{n\to\infty}\frac{T_{n}(\bm{X})}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\liminf_{n\to\infty}\frac{T_{n}(\bm{X})}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex150.m1" class="ltx_Math" alttext="\displaystyle=\liminf_{n\to\infty}\frac{\widetilde{A}_{n,1}+\widetilde{A}_{n,2}-\widetilde{B}_{n,1}-\widetilde{B}_{n,2}+\sum_{j=1}^{L}\widetilde{N}_{n,j}\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big[(m_{V,j}\bm{N}_{j}^{*}){\bm{X}}-f_{\widetilde{G}_{n}}({\bm{X}})\Big]}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo>−</mo><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mrow><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\liminf_{n\to\infty}\frac{\widetilde{A}_{n,1}+\widetilde{A}_{n,2}-\widetilde{B}_{n,1}-\widetilde{B}_{n,2}+\sum_{j=1}^{L}\widetilde{N}_{n,j}\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big[(m_{V,j}\bm{N}_{j}^{*}){\bm{X}}-f_{\widetilde{G}_{n}}({\bm{X}})\Big]}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p8.4" class="ltx_p">for almost surely <math id="A3.SS2.SSS1.Px2.p8.m12" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math>. For example, we look at the limit of <math id="A3.SS2.SSS1.Px2.p8.m13" class="ltx_Math" alttext="\widetilde{A}_{n,1}/\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>/</mo><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{A}_{n,1}/\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math>,</p>
<table id="A3.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex151.m1" class="ltx_math_unparsed" alttext="\displaystyle\liminf_{n\to\infty}\frac{\widetilde{A}_{n,1}}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}=\sum_{j:|\mathcal{V}_{j}|=1}\Bigg(\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mstyle displaystyle="true"><mfrac><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\liminf_{n\to\infty}\frac{\widetilde{A}_{n,1}}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}=\sum_{j:|\mathcal{V}_{j}|=1}\Bigg(\exp(m_{Q,j}\bm{X}^{\top}\bm{M}_{j}^{*}\bm{X})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex152.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 56.9055pt\Bigg[\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{\tau}_{j,u,0}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 56.9055pt\Bigg[\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{\tau}_{j,u,0}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex153.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 56.9055pt+\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{\tau}_{j,0,u}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 56.9055pt+\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)\bm{N}_{j}^{*}\bm{X}\times\widetilde{\tau}_{j,0,u}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex154.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 56.9055pt+\sum_{u=(1,1)}^{(d,d)}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\times\widetilde{\tau}_{j,u,0}m_{V,j}+\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\times\widetilde{\tau}_{j,0,u}m_{V,j}\Bigg]\Bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 56.9055pt+\sum_{u=(1,1)}^{(d,d)}\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\times\widetilde{\tau}_{j,u,0}m_{V,j}+\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\times\widetilde{\tau}_{j,0,u}m_{V,j}\Bigg]\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p8.5" class="ltx_p">The equation <math id="A3.SS2.SSS1.Px2.p8.m14" class="ltx_Math" alttext="0=\liminf_{n\to\infty}\frac{T_{n}(\bm{X})}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mfrac><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">0=\liminf_{n\to\infty}\frac{T_{n}(\bm{X})}{\tilde{m}_{n}\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})}</annotation></semantics></math> and the linear independence of the functions imply that all the coefficients <math id="A3.SS2.SSS1.Px2.p8.m15" class="ltx_Math" alttext="\{\tilde{\tau}_{j,\alpha_{1},\alpha_{2}},\tilde{\xi}_{j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}},\tilde{\lambda}_{0,j}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>ξ</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{\tau}_{j,\alpha_{1},\alpha_{2}},\tilde{\xi}_{j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}},\tilde{\lambda}_{0,j}\}</annotation></semantics></math> are 0, which is a contradiction. As a consequence, we obtain that:</p>
<table id="A3.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex155.m1" class="ltx_math_unparsed" alttext="\lim_{\varepsilon\to 0}\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta):\mathcal{D}_{3}(\widetilde{G},\widetilde{G}_{*})\leq\varepsilon}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})&gt;0." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ε</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">inf</mo><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ε</mi></mrow></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\varepsilon\to 0}\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta):\mathcal{D}_{3}(\widetilde{G},\widetilde{G}_{*})\leq\varepsilon}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.2 </span>Global Part</h4>

<div id="A3.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS2.p1.1" class="ltx_p">The result of the local part implies that there exists a positive constant <math id="A3.SS2.SSS2.p1.m1" class="ltx_Math" alttext="\varepsilon^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>ε</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\varepsilon^{\prime}</annotation></semantics></math> such that</p>
<table id="A3.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex156.m1" class="ltx_math_unparsed" alttext="\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta):\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})\leq\varepsilon^{\prime}}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mi>ε</mi><mo>′</mo></msup></mrow></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta):\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})\leq\varepsilon^{\prime}}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.2" class="ltx_p">Therefore the remaining part is to prove</p>
<table id="A3.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex157.m1" class="ltx_math_unparsed" alttext="\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta):\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;\varepsilon^{\prime}}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi>ε</mi><mo>′</mo></msup></mrow></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta):\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;\varepsilon^{\prime}}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.3" class="ltx_p">We assume by contradiction that the above claim does not hold. It means there exists a sequence of
measures <math id="A3.SS2.SSS2.p1.m2" class="ltx_Math" alttext="\widetilde{G}^{\prime}_{n}:=\sum_{j=1}^{L}\exp(c_{n,j})\delta_{({\bm{B}}_{n,j},{\bm{A}}_{n,j})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>,</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{G}^{\prime}_{n}:=\sum_{j=1}^{L}\exp(c_{n,j})\delta_{({\bm{B}}_{n,j},{\bm{A}}_{n,j})}</annotation></semantics></math> in <math id="A3.SS2.SSS2.p1.m3" class="ltx_Math" alttext="\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)</annotation></semantics></math> such that</p>
<table id="A3.Ex158" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex158.m1" class="ltx_math_unparsed" alttext="\left\{\begin{matrix}\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;\varepsilon^{\prime}\\
\|f_{\widetilde{G}^{\prime}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})\to 0\end{matrix}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo mathsize="0.700em">,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi>ε</mi><mo>′</mo></msup></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{matrix}\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;\varepsilon^{\prime}\\
\|f_{\widetilde{G}^{\prime}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})\to 0\end{matrix}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.4" class="ltx_p">as <math id="A3.SS2.SSS2.p1.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>, which implies that <math id="A3.SS2.SSS2.p1.m5" class="ltx_Math" alttext="\|f_{\widetilde{G}^{\prime}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|f_{\widetilde{G}^{\prime}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}\to 0</annotation></semantics></math> as <math id="A3.SS2.SSS2.p1.m6" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.
<br class="ltx_break">Given that <math id="A3.SS2.SSS2.p1.m7" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> is a compact set, there exists a mixing measure <math id="A3.SS2.SSS2.p1.m8" class="ltx_Math" alttext="\widetilde{G}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\widetilde{G}^{\prime}</annotation></semantics></math> in <math id="A3.SS2.SSS2.p1.m9" class="ltx_Math" alttext="\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)</annotation></semantics></math> such that one of the <math id="A3.SS2.SSS2.p1.m10" class="ltx_Math" alttext="\widetilde{G}^{\prime}_{n}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\widetilde{G}^{\prime}_{n}</annotation></semantics></math>’s subsequences converges to <math id="A3.SS2.SSS2.p1.m11" class="ltx_Math" alttext="\widetilde{G}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\widetilde{G}^{\prime}</annotation></semantics></math>. Since <math id="A3.SS2.SSS2.p1.m12" class="ltx_Math" alttext="\mathcal{D}_{2}(\widetilde{G}^{\prime}_{n},\widetilde{G}_{*})&gt;\varepsilon^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi>ε</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{2}(\widetilde{G}^{\prime}_{n},\widetilde{G}_{*})&gt;\varepsilon^{\prime}</annotation></semantics></math>, we obtain that <math id="A3.SS2.SSS2.p1.m13" class="ltx_Math" alttext="\mathcal{D}_{2}(\widetilde{G}^{\prime},\widetilde{G}_{*})&gt;\varepsilon^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi>ε</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{2}(\widetilde{G}^{\prime},\widetilde{G}_{*})&gt;\varepsilon^{\prime}</annotation></semantics></math>.
An application of the Fatou’s lemma leads to</p>
<table id="A3.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex159.m1" class="ltx_Math" alttext="0=\lim_{n\to\infty}\|f_{\widetilde{G}^{\prime}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}\geq\int\liminf_{n\to\infty}\left\|f_{\widetilde{G}^{\prime}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right\|^{2}d\mu(\bm{X})." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo rspace="0.111em">≥</mo><mrow><mo>∫</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">lim inf</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>f</mi><msubsup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi><mo>′</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>μ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0=\lim_{n\to\infty}\|f_{\widetilde{G}^{\prime}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}\geq\int\liminf_{n\to\infty}\left\|f_{\widetilde{G}^{\prime}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})\right\|^{2}d\mu(\bm{X}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p1.5" class="ltx_p">The above inequality indicates that <math id="A3.SS2.SSS2.p1.m14" class="ltx_Math" alttext="f_{\widetilde{G}^{\prime}}=f_{\widetilde{G}_{*}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup></msub><mo>=</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><annotation encoding="application/x-tex">f_{\widetilde{G}^{\prime}}=f_{\widetilde{G}_{*}}</annotation></semantics></math> for almost surely <math id="A3.SS2.SSS2.p1.m15" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math>. From the identifiability property that we will prove shortly below, we deduce that <math id="A3.SS2.SSS2.p1.m16" class="ltx_Math" alttext="\widetilde{G}^{\prime}\equiv\widetilde{G}_{*}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup><mo>≡</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\widetilde{G}^{\prime}\equiv\widetilde{G}_{*}</annotation></semantics></math>. It follows that <math id="A3.SS2.SSS2.p1.m17" class="ltx_Math" alttext="\mathcal{D}_{2}(\widetilde{G}^{\prime},\widetilde{G}_{*})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{D}_{2}(\widetilde{G}^{\prime},\widetilde{G}_{*})=0</annotation></semantics></math>, which is opposed to the fact that <math id="A3.SS2.SSS2.p1.m18" class="ltx_Math" alttext="\mathcal{D}_{2}(\widetilde{G}^{\prime},\widetilde{G}_{*})&gt;\varepsilon^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>′</mo></msup><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msup><mi>ε</mi><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{D}_{2}(\widetilde{G}^{\prime},\widetilde{G}_{*})&gt;\varepsilon^{\prime}&gt;0</annotation></semantics></math>.
Hence, the proof is completed.
<br class="ltx_break"></p>
</div>
<div id="A3.SS2.SSS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS2.p2.1" class="ltx_p"><span id="A3.SS2.SSS2.p2.1.1" class="ltx_text ltx_font_bold">Proof for the identifiability property.</span>
We will prove that if <math id="A3.SS2.SSS2.p2.m1" class="ltx_Math" alttext="f_{\widetilde{G}}(\bm{X})=f_{\widetilde{G}_{*}}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\widetilde{G}}(\bm{X})=f_{\widetilde{G}_{*}}(\bm{X})</annotation></semantics></math> for almost surely <math id="A3.SS2.SSS2.p2.m2" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>, then <math id="A3.SS2.SSS2.p2.m3" class="ltx_Math" alttext="\widetilde{G}\equiv\widetilde{G}_{*}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>≡</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\widetilde{G}\equiv\widetilde{G}_{*}</annotation></semantics></math>.
To ease the presentation, for any mixing measure <math id="A3.SS2.SSS2.p2.m4" class="ltx_Math" alttext="\widetilde{G}=\sum_{j=1}^{\tilde{L}}\exp(c_{j})\delta_{({\bm{B}}_{j},{\bm{A}}_{j})}\in\mathcal{G}_{L^{\prime}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mover accent="true"><mi>L</mi><mo>~</mo></mover></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo>,</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{G}=\sum_{j=1}^{\tilde{L}}\exp(c_{j})\delta_{({\bm{B}}_{j},{\bm{A}}_{j})}\in\mathcal{G}_{L^{\prime}}(\Theta)</annotation></semantics></math>, we denote</p>
<table id="A3.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex160.m1" class="ltx_Math" alttext="\displaystyle\mathrm{softmax}_{G}(u)" display="inline" intent=":literal"><semantics><mrow><msub><mi>softmax</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{softmax}_{G}(u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex160.m2" class="ltx_Math" alttext="\displaystyle=\dfrac{\exp(u)}{\sum_{k=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{k})\sigma_{1}(\bm{A}_{k})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{k})\sigma_{1}(\bm{A}_{k})\|+\tau_{Q}}\bm{X}+c_{k}\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{\exp(u)}{\sum_{k=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{k})\sigma_{1}(\bm{A}_{k})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{k})\sigma_{1}(\bm{A}_{k})\|+\tau_{Q}}\bm{X}+c_{k}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p2.2" class="ltx_p">where <math id="A3.SS2.SSS2.p2.m5" class="ltx_math_unparsed" alttext="u\in\Biggr\{\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})\|+\tau_{Q}}\bm{X}+c_{j}:j\in[\tilde{L}]\Biggr\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo rspace="0em">∈</mo><mo lspace="0em" rspace="0em">{</mo></mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac><mi>𝑿</mi><mo>+</mo><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">u\in\Biggr\{\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})\|+\tau_{Q}}\bm{X}+c_{j}:j\in[\tilde{L}]\Biggr\}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS2.p3.1" class="ltx_p">The equation <math id="A3.SS2.SSS2.p3.m1" class="ltx_Math" alttext="f_{\widetilde{G}}({\bm{X}})=f_{\widetilde{G}_{*}}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\widetilde{G}}({\bm{X}})=f_{\widetilde{G}_{*}}({\bm{X}})</annotation></semantics></math> indicates that</p>
<table id="A3.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E18.m1" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{\tilde{L}}\mathrm{softmax}\Bigg(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})\|+\tau_{Q}}\bm{X}+c_{j}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mover accent="true"><mi>L</mi><mo>~</mo></mover></munderover></mstyle><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msub><mi>c</mi><mi>j</mi></msub></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{\tilde{L}}\mathrm{softmax}\Bigg(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})\|+\tau_{Q}}\bm{X}+c_{j}\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
