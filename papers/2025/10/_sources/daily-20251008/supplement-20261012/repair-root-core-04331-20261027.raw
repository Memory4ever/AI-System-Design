</table>
<p id="A3.SS1.SSS0.Px1.p4.3" class="ltx_p">It follows from the choices of <math id="A3.SS1.SSS0.Px1.p4.m2" class="ltx_Math" alttext="{\bm{B}}^{n}_{Q,i},{\bm{A}}^{n}_{Q,i},{\bm{B}}^{n}_{V,i},{\bm{A}}^{n}_{V,i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">{\bm{B}}^{n}_{Q,i},{\bm{A}}^{n}_{Q,i},{\bm{B}}^{n}_{V,i},{\bm{A}}^{n}_{V,i}</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p4.m3" class="ltx_Math" alttext="c^{n}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">c^{n}_{i}</annotation></semantics></math> that</p>
<table id="A3.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex33.m1" class="ltx_Math" alttext="\displaystyle A_{n}(\bm{X})=\sum_{k=1}^{2}\frac{1}{2}\Big[\exp(c^{*}_{1})+\frac{1}{n^{r+1}}\Big]\left(m_{V,1}\frac{\bm{C}_{V}+\bm{B}^{*}_{V,1}\bm{A}^{*}_{V,1}}{\|\bm{C}_{V}+\bm{B}^{*}_{V,1}\bm{A}^{*}_{V,1}\|}\right)\bm{X}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mn>2</mn></munderover></mstyle><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mn>1</mn><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A_{n}(\bm{X})=\sum_{k=1}^{2}\frac{1}{2}\Big[\exp(c^{*}_{1})+\frac{1}{n^{r+1}}\Big]\left(m_{V,1}\frac{\bm{C}_{V}+\bm{B}^{*}_{V,1}\bm{A}^{*}_{V,1}}{\|\bm{C}_{V}+\bm{B}^{*}_{V,1}\bm{A}^{*}_{V,1}\|}\right)\bm{X}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m1" class="ltx_Math" alttext="\displaystyle\times\left(\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\bm{B}^{n}_{Q,k}\bm{A}^{n}_{Q,k}}{\|\bm{C}_{Q}+\bm{B}^{n}_{Q,k}\bm{A}^{n}_{Q,k}\|}\bm{C}_{K}\bm{X}\right)-\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}\|}\bm{C}_{K}\bm{X}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\times\left(\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\bm{B}^{n}_{Q,k}\bm{A}^{n}_{Q,k}}{\|\bm{C}_{Q}+\bm{B}^{n}_{Q,k}\bm{A}^{n}_{Q,k}\|}\bm{C}_{K}\bm{X}\right)-\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}\|}\bm{C}_{K}\bm{X}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p5.1" class="ltx_p">We denote <math id="A3.SS1.SSS0.Px1.p5.m1" class="ltx_Math" alttext="L({\bm{Z}}):=\exp\left(\bm{X}^{\top}m_{Q}\frac{\bm{C}_{Q}+{\bm{Z}}}{\|\bm{C}_{Q}+{\bm{Z}}\|}\bm{C}_{K}\bm{X}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L({\bm{Z}}):=\exp\left(\bm{X}^{\top}m_{Q}\frac{\bm{C}_{Q}+{\bm{Z}}}{\|\bm{C}_{Q}+{\bm{Z}}\|}\bm{C}_{K}\bm{X}\right)</annotation></semantics></math>. Then, by using first-order Taylor expansion, we have that,</p>
<table id="A3.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_Math" alttext="\displaystyle L(\bm{B}^{n}_{Q,1}\bm{A}^{n}_{Q,1})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L(\bm{B}^{n}_{Q,1}\bm{A}^{n}_{Q,1})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m2" class="ltx_Math" alttext="\displaystyle=\langle\bm{B}^{n}_{Q,1}\bm{A}^{n}_{Q,1}-\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1},\frac{\partial L}{\partial\bm{B}\bm{A}}(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})\rangle+R_{1}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo>−</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\langle\bm{B}^{n}_{Q,1}\bm{A}^{n}_{Q,1}-\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1},\frac{\partial L}{\partial\bm{B}\bm{A}}(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})\rangle+R_{1}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle L(\bm{B}^{n}_{Q,2}\bm{A}^{n}_{Q,2})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L(\bm{B}^{n}_{Q,2}\bm{A}^{n}_{Q,2})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36.m2" class="ltx_Math" alttext="\displaystyle=\langle\bm{B}^{n}_{Q,2}\bm{A}^{n}_{Q,2}-\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1},\frac{\partial L}{\partial\bm{B}\bm{A}}(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})\rangle+R_{2}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup></mrow><mo>−</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><mrow><msub><mi>R</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\langle\bm{B}^{n}_{Q,2}\bm{A}^{n}_{Q,2}-\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1},\frac{\partial L}{\partial\bm{B}\bm{A}}(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})\rangle+R_{2}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p5.2" class="ltx_p">where <math id="A3.SS1.SSS0.Px1.p5.m2" class="ltx_Math" alttext="R_{1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{1}(\bm{X})</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p5.m3" class="ltx_Math" alttext="R_{2}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R_{2}(\bm{X})</annotation></semantics></math> are Taylor remainder such that <math id="A3.SS1.SSS0.Px1.p5.m4" class="ltx_Math" alttext="R_{1}/\mathcal{D}_{1}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{1}/\mathcal{D}_{1}(G_{n},G_{*})\to 0</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p5.m5" class="ltx_Math" alttext="R_{2}/\mathcal{D}_{1}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>R</mi><mn>2</mn></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{2}/\mathcal{D}_{1}(G_{n},G_{*})\to 0</annotation></semantics></math> as <math id="A3.SS1.SSS0.Px1.p5.m6" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. It follows based on the chosen <math id="A3.SS1.SSS0.Px1.p5.m7" class="ltx_Math" alttext="\bm{B}^{n}_{Q,1},\bm{A}^{n}_{Q,1},\bm{B}^{n}_{Q,2},\bm{A}^{n}_{Q,2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">\bm{B}^{n}_{Q,1},\bm{A}^{n}_{Q,1},\bm{B}^{n}_{Q,2},\bm{A}^{n}_{Q,2}</annotation></semantics></math>,</p>
<table id="A3.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\displaystyle L(\bm{B}^{n}_{Q,1}\bm{A}^{n}_{Q,1})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})+L(\bm{B}^{n}_{Q,2}\bm{A}^{n}_{Q,2})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L(\bm{B}^{n}_{Q,1}\bm{A}^{n}_{Q,1})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})+L(\bm{B}^{n}_{Q,2}\bm{A}^{n}_{Q,2})-L(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\displaystyle\hskip 85.35826pt=\frac{1}{n}\langle\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1}+\bm{C}_{Q},\frac{\partial L}{\partial\bm{B}\bm{A}}(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})\rangle+R_{1}+R_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="8.818em">=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>+</mo><msub><mi>𝑪</mi><mi>Q</mi></msub></mrow><mo>,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mrow><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>+</mo><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><msub><mi>R</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 85.35826pt=\frac{1}{n}\langle\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1}+\bm{C}_{Q},\frac{\partial L}{\partial\bm{B}\bm{A}}(\bm{B}^{*}_{Q,1}\bm{A}^{*}_{Q,1})\rangle+R_{1}+R_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex39.m1" class="ltx_Math" alttext="\displaystyle\hskip 85.35826pt=R_{1}+R_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="8.818em">=</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><msub><mi>R</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 85.35826pt=R_{1}+R_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p5.3" class="ltx_p">where the inner product is <math id="A3.SS1.SSS0.Px1.p5.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> due to Lemma …. Therefore, we have that <math id="A3.SS1.SSS0.Px1.p5.m9" class="ltx_Math" alttext="A_{n}(\bm{X})/\mathcal{D}_{1}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>A</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{n}(\bm{X})/\mathcal{D}_{1}(G_{n},G_{*})\to 0</annotation></semantics></math> as <math id="A3.SS1.SSS0.Px1.p5.m10" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.SSS0.Px1.p6" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p6.1" class="ltx_p">Additionally, it is similar to verify that <math id="A3.SS1.SSS0.Px1.p6.m1" class="ltx_Math" alttext="B_{n}(\bm{X})/\mathcal{D}_{1}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>B</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{n}(\bm{X})/\mathcal{D}_{1}(G_{n},G_{*})\to 0</annotation></semantics></math>, and <math id="A3.SS1.SSS0.Px1.p6.m2" class="ltx_Math" alttext="C_{n}(\bm{X})=\mathcal{O}(n^{-(r+1)})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{n}(\bm{X})=\mathcal{O}(n^{-(r+1)})</annotation></semantics></math>. Thus, <math id="A3.SS1.SSS0.Px1.p6.m3" class="ltx_Math" alttext="T_{n}(\bm{X})/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T_{n}(\bm{X})/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0</annotation></semantics></math> as <math id="A3.SS1.SSS0.Px1.p6.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math> for almost every <math id="A3.SS1.SSS0.Px1.p6.m5" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.SSS0.Px1.p7" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p7.1" class="ltx_p">Since the term <math id="A3.SS1.SSS0.Px1.p7.m1" class="ltx_Math" alttext="\sum_{k=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}\|}\bm{C}_{K}\bm{X}+c^{*}_{k}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>c</mi><mi>k</mi><mo>∗</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,k}\bm{A}^{*}_{Q,k}\|}\bm{C}_{K}\bm{X}+c^{*}_{k}\right)</annotation></semantics></math> is bounded, we have

<br class="ltx_break"><math id="A3.SS1.SSS0.Px1.p7.m2" class="ltx_Math" alttext="[f_{G_{n}}(\bm{X})-f_{G_{*}}(\bm{X})]/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><msub><mi>G</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">[f_{G_{n}}(\bm{X})-f_{G_{*}}(\bm{X})]/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0</annotation></semantics></math> for almost every <math id="A3.SS1.SSS0.Px1.p7.m3" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math>. Therefore, we have</p>
<table id="A3.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex40.m1" class="ltx_Math" alttext="\|f_{G_{n}}-f_{G_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|f_{G_{n}}-f_{G_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p7.2" class="ltx_p">as <math id="A3.SS1.SSS0.Px1.p7.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. We obtain the claim in equation (<a href="#A3.E8" title="In Step 1. ‣ C.1 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>).

<br class="ltx_break"></p>
</div>
</section>
<section id="A3.SS1.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 2.</h5>

<div id="A3.SS1.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px2.p1.1" class="ltx_p">Now, we are ready to prove the desired result, i.e.,</p>
<table id="A3.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E10.m1" class="ltx_math_unparsed" alttext="\displaystyle\inf_{G_{n}\in\mathcal{G}_{L^{\prime}}(\Theta)}\sup_{G\in\mathcal{G}_{L^{\prime}}(\Theta)\setminus\mathcal{G}_{L-1}(\Theta)}\mathbb{E}_{f_{G}}[\mathcal{D}_{1,r}(G_{n},G)]\gtrsim n^{-1/2}." display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">inf</mo><mrow><msub><mi>G</mi><mi>n</mi></msub><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><munder><mo lspace="0.167em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>G</mi><mo>∈</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><msub><mi>𝔼</mi><msub><mi>f</mi><mi>G</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>≳</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\inf_{G_{n}\in\mathcal{G}_{L^{\prime}}(\Theta)}\sup_{G\in\mathcal{G}_{L^{\prime}}(\Theta)\setminus\mathcal{G}_{L-1}(\Theta)}\mathbb{E}_{f_{G}}[\mathcal{D}_{1,r}(G_{n},G)]\gtrsim n^{-1/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p1.2" class="ltx_p">Since the noise variables <math id="A3.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\varepsilon_{i}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varepsilon_{i}</annotation></semantics></math> follow from the Gaussian distribution, we have that <math id="A3.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="Y_{i}|\bm{X}_{i}\sim\mathcal{N}(f_{G_{*}}(\bm{X}_{i}),\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>i</mi></msub><mo fence="false">|</mo><mrow><msub><mi>𝑿</mi><mi>i</mi></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑿</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{i}|\bm{X}_{i}\sim\mathcal{N}(f_{G_{*}}(\bm{X}_{i}),\sigma^{2})</annotation></semantics></math> for all <math id="A3.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math>. For sufficiently small <math id="A3.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math> and a fixed constant <math id="A3.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="C_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{1}&gt;0</annotation></semantics></math> which we will choose later, there exists a mixing measure <math id="A3.SS1.SSS0.Px2.p1.m6" class="ltx_Math" alttext="G^{\prime}_{*}\in\mathcal{G}_{L^{\prime}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}_{*}\in\mathcal{G}_{L^{\prime}}(\Theta)</annotation></semantics></math> such that <math id="A3.SS1.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\mathcal{D}_{1,r}(G^{\prime}_{*},G_{*})=2\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{1,r}(G^{\prime}_{*},G_{*})=2\varepsilon</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\|f_{G^{\prime}_{*}}-f_{G_{*}}\|_{L^{2}(\mu)}\leq C_{1}\varepsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup></msub><mo>−</mo><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><annotation encoding="application/x-tex">\|f_{G^{\prime}_{*}}-f_{G_{*}}\|_{L^{2}(\mu)}\leq C_{1}\varepsilon</annotation></semantics></math> thanks to the result in equation (<a href="#A3.E8" title="In Step 1. ‣ C.1 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>). Due to the Le Cam’s lemma <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib53" title="" class="ltx_ref">53</a>]</cite> and the fact that the Voronoi loss function <math id="A3.SS1.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\mathcal{D}_{1,r}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{D}_{1,r}</annotation></semantics></math> satisfies the weak triangle inequality, we can derive that</p>
<table id="A3.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex41.m1" class="ltx_Math" alttext="\displaystyle\inf_{G_{n}\in\mathcal{G}_{L^{\prime}}(\Theta)}" display="inline" intent=":literal"><semantics><munder><mo movablelimits="false">inf</mo><mrow><msub><mi>G</mi><mi>n</mi></msub><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><annotation encoding="application/x-tex">\displaystyle\inf_{G_{n}\in\mathcal{G}_{L^{\prime}}(\Theta)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex41.m2" class="ltx_Math" alttext="\displaystyle\sup_{G\in\mathcal{G}_{L^{\prime}}(\Theta)\setminus\mathcal{G}_{L-1}(\Theta)}\mathbb{E}_{f_{G}}[\mathcal{D}_{1,r}(G_{n},G)]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>G</mi><mo>∈</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></munder><mrow><msub><mi>𝔼</mi><msub><mi>f</mi><mi>G</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{G\in\mathcal{G}_{L^{\prime}}(\Theta)\setminus\mathcal{G}_{L-1}(\Theta)}\mathbb{E}_{f_{G}}[\mathcal{D}_{1,r}(G_{n},G)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex42.m1" class="ltx_Math" alttext="\displaystyle\gtrsim\frac{\mathcal{D}_{1,r}(G^{\prime}_{*},G_{*})}{8}\text{exp}(-n\mathbb{E}_{\bm{X}\sim\mu}[\text{KL}(\mathcal{N}(f_{G^{\prime}_{*}}(\bm{X}),\sigma^{2}),\mathcal{N}(f_{G_{*}}(\bm{X}),\sigma^{2}))])" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≳</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mn>8</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mtext>exp</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mi>𝑿</mi><mo>∼</mo><mi>μ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>KL</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gtrsim\frac{\mathcal{D}_{1,r}(G^{\prime}_{*},G_{*})}{8}\text{exp}(-n\mathbb{E}_{\bm{X}\sim\mu}[\text{KL}(\mathcal{N}(f_{G^{\prime}_{*}}(\bm{X}),\sigma^{2}),\mathcal{N}(f_{G_{*}}(\bm{X}),\sigma^{2}))])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex43.m1" class="ltx_Math" alttext="\displaystyle\gtrsim\varepsilon\cdot\text{exp}(-n\|f_{G^{\prime}_{*}}-f_{G_{*}}\|_{L^{2}(\mu)}^{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≳</mo><mrow><mrow><mi>ε</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>exp</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup></msub><mo>−</mo><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\gtrsim\varepsilon\cdot\text{exp}(-n\|f_{G^{\prime}_{*}}-f_{G_{*}}\|_{L^{2}(\mu)}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E11.m1" class="ltx_Math" alttext="\displaystyle\gtrsim\varepsilon\cdot\text{exp}(-C_{1}n\varepsilon^{2})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≳</mo><mrow><mrow><mi>ε</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>exp</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\gtrsim\varepsilon\cdot\text{exp}(-C_{1}n\varepsilon^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p1.3" class="ltx_p">where the second inequality follows from the KL distance of two multivariate Gaussians, i.e.,</p>
<table id="A3.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex44.m1" class="ltx_Math" alttext="\displaystyle\text{KL}(\mathcal{N}(f_{G^{\prime}_{*}}(\bm{X}),\sigma^{2}),\mathcal{N}(f_{G_{*}}(\bm{X}),\sigma^{2}))=\dfrac{(f_{G^{\prime}_{*}}(\bm{X})-f_{G_{*}}(\bm{X}))^{2}}{2\sigma^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>KL</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>f</mi><msubsup><mi>G</mi><mo>∗</mo><mo>′</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{KL}(\mathcal{N}(f_{G^{\prime}_{*}}(\bm{X}),\sigma^{2}),\mathcal{N}(f_{G_{*}}(\bm{X}),\sigma^{2}))=\dfrac{(f_{G^{\prime}_{*}}(\bm{X})-f_{G_{*}}(\bm{X}))^{2}}{2\sigma^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p1.4" class="ltx_p">Let <math id="A3.SS1.SSS0.Px2.p1.m10" class="ltx_math_unparsed" alttext="\varepsilon=n^{-1/2}" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mi>n</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\varepsilon=n^{-1/2}</annotation></semantics></math>, then we get that the RHS <math id="A3.SS1.SSS0.Px2.p1.m11" class="ltx_math_unparsed" alttext="\varepsilon\cdot\text{exp}(-C_{1}n\varepsilon^{2})=n^{-1/2}\exp(-C_{1})" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>exp</mtext><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>C</mi><mn>1</mn></msub><mi>n</mi><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\cdot\text{exp}(-C_{1}n\varepsilon^{2})=n^{-1/2}\exp(-C_{1})</annotation></semantics></math>. Thus, we achieve the desired minimax lower bound in equation (<a href="#A3.E10" title="In Step 2. ‣ C.1 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>).</p>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="L({\bm{Z}}):=\exp\left(\bm{X}^{\top}m_{Q}\frac{\bm{C}_{Q}+{\bm{Z}}}{\|\bm{C}_{Q}+{\bm{Z}}\|}\bm{C}_{K}\bm{X}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐙</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝐗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>𝐂</mi><mi>Q</mi></msub><mo>+</mo><mi>𝐙</mi></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝐂</mi><mi>Q</mi></msub><mo>+</mo><mi>𝐙</mi></mrow><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐂</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐗</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L({\bm{Z}}):=\exp\left(\bm{X}^{\top}m_{Q}\frac{\bm{C}_{Q}+{\bm{Z}}}{\|\bm{C}_{Q}+{\bm{Z}}\|}\bm{C}_{K}\bm{X}\right)</annotation></semantics></math>. We have that,</span></p>
<table id="A3.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\displaystyle\langle\bm{C}_{Q}+{\bm{Z}},\frac{\partial L}{\partial{\bm{Z}}}\rangle=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mi>𝒁</mi></mrow></mfrac></mstyle></mrow><mo stretchy="false">⟩</mo></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\bm{C}_{Q}+{\bm{Z}},\frac{\partial L}{\partial{\bm{Z}}}\rangle=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px2.p2.1" class="ltx_p">Proof of Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ Step 2. ‣ C.1 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>: It follows from direct calculation,</p>
<table id="A3.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex46.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial L}{\partial{\bm{Z}}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mi>𝒁</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial L}{\partial{\bm{Z}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex46.m2" class="ltx_Math" alttext="\displaystyle=m_{Q}\frac{\bm{X}(\bm{C}_{K}\bm{X})^{\top}}{\|\bm{C}_{Q}+{\bm{Z}}\|}-m_{Q}(\bm{X}^{\top}(\bm{C}_{Q}+{\bm{Z}})\bm{C}_{K}\bm{X})\frac{\bm{C}_{Q}+{\bm{Z}}}{\|\bm{C}_{Q}+{\bm{Z}}\|^{3}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>m</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><msub><mi>m</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=m_{Q}\frac{\bm{X}(\bm{C}_{K}\bm{X})^{\top}}{\|\bm{C}_{Q}+{\bm{Z}}\|}-m_{Q}(\bm{X}^{\top}(\bm{C}_{Q}+{\bm{Z}})\bm{C}_{K}\bm{X})\frac{\bm{C}_{Q}+{\bm{Z}}}{\|\bm{C}_{Q}+{\bm{Z}}\|^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex47.m1" class="ltx_Math" alttext="\displaystyle\langle\bm{C}_{Q}+{\bm{Z}},\frac{\partial L}{\partial{\bm{Z}}}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mi>𝒁</mi></mrow></mfrac></mstyle></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\langle\bm{C}_{Q}+{\bm{Z}},\frac{\partial L}{\partial{\bm{Z}}}\rangle</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex47.m2" class="ltx_Math" alttext="\displaystyle=\frac{m_{Q}}{\|\bm{C}_{Q}+{\bm{Z}}\|}\operatorname{Trace}\left((\bm{C}_{Q}+{\bm{Z}})^{\top}\bm{X}\bm{X}^{\top}\bm{C}_{K}^{\top}-\bm{X}^{\top}(\bm{C}_{Q}+{\bm{Z}})\bm{C}_{K}\bm{X}\right)=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>m</mi><mi>Q</mi></msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Trace</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑪</mi><mi>K</mi><mo>⊤</mo></msubsup></mrow><mo>−</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mi>𝒁</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{m_{Q}}{\|\bm{C}_{Q}+{\bm{Z}}\|}\operatorname{Trace}\left((\bm{C}_{Q}+{\bm{Z}})^{\top}\bm{X}\bm{X}^{\top}\bm{C}_{K}^{\top}-\bm{X}^{\top}(\bm{C}_{Q}+{\bm{Z}})\bm{C}_{K}\bm{X}\right)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ 4.2 Shared-structure with added noise ‣ 4 Theoretical Analysis ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">Before going to the proof, without loss of generality, we can assume <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="\bm{W}_{1,j},\bm{W}_{2,j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mrow><mn>1</mn><mo>,</mo><mi>j</mi></mrow></msub><mo>,</mo><msub><mi>𝑾</mi><mrow><mn>2</mn><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{W}_{1,j},\bm{W}_{2,j}</annotation></semantics></math> are identity matrices for each <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>. In particular, we may denote <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="\sigma_{1}(\bm{W}_{1}\bm{A})" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝑾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{1}(\bm{W}_{1}\bm{A})</annotation></semantics></math> as <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="\sigma_{1}(\bm{A})" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{1}(\bm{A})</annotation></semantics></math> for an input matrix <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="\bm{A}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">\bm{A}</annotation></semantics></math>. Throughout this proof, we also assume without loss of generality that <math id="A3.SS2.p1.m6" class="ltx_Math" alttext="C_{K,j}=I_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>K</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><msub><mi>I</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">C_{K,j}=I_{d}</annotation></semantics></math> with a note that our techniques can be extended to the general setting of that matrix.</p>
</div>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p">We first start with the following result regarding the convergence rate of the regression function estimation <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="f_{\widetilde{G}_{n}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><annotation encoding="application/x-tex">f_{\widetilde{G}_{n}}</annotation></semantics></math> to the true regression function <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="f_{\widetilde{G}_{*}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><annotation encoding="application/x-tex">f_{\widetilde{G}_{*}}</annotation></semantics></math>:</p>
</div>
<div id="Thmproposition1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition1.2" class="ltx_text ltx_font_bold">Proposition 1</span></span><span id="Thmproposition1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition1.p1" class="ltx_para">
<p id="Thmproposition1.p1.1" class="ltx_p"><span id="Thmproposition1.p1.1.1" class="ltx_text ltx_font_italic">Given the least square estimator <math id="Thmproposition1.p1.m1" class="ltx_Math" alttext="\widetilde{G}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widetilde{G}_{n}</annotation></semantics></math>, the convergence rate of the regression function estimator <math id="Thmproposition1.p1.m2" class="ltx_Math" alttext="f_{\widetilde{G}_{n}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><annotation encoding="application/x-tex">f_{\widetilde{G}_{n}}</annotation></semantics></math> to the true regression function <math id="Thmproposition1.p1.m3" class="ltx_Math" alttext="f_{\widetilde{G}_{*}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><annotation encoding="application/x-tex">f_{\widetilde{G}_{*}}</annotation></semantics></math> under the <math id="Thmproposition1.p1.m4" class="ltx_Math" alttext="L^{2}(\mu)" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}(\mu)</annotation></semantics></math> norm is,</span></p>
<table id="A3.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E12.m1" class="ltx_Math" alttext="\displaystyle\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}=\mathcal{O}_{P}(\sqrt{\log(n)/n})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>n</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}=\mathcal{O}_{P}(\sqrt{\log(n)/n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.p3.1" class="ltx_p">Our goal now is to demonstrate the following inequality:</p>
<table id="A3.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex48.m1" class="ltx_Math" alttext="\displaystyle\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\inf_{\widetilde{G}\in\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p3.2" class="ltx_p">and since from Proposition <a href="#Thmproposition1" title="Proposition 1. ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the rate of <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}</annotation></semantics></math> is <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="\mathcal{O}_{P}(\sqrt{\log(n)/n})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>n</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{P}(\sqrt{\log(n)/n})</annotation></semantics></math>, we deduce that <math id="A3.SS2.p3.m3" class="ltx_Math" alttext="\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})</annotation></semantics></math> is also <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="\mathcal{O}_{P}(\sqrt{\log(n)/n})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>n</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}_{P}(\sqrt{\log(n)/n})</annotation></semantics></math>. We will prove this inequality by considering separately the local part when the Voronoi loss is small and the global part when the Voronoi loss is large. Before delving into the proof, we first state some essential assumptions on the activation function <math id="A3.SS2.p3.m5" class="ltx_Math" alttext="\sigma_{1}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\sigma_{1}</annotation></semantics></math> and <math id="A3.SS2.p3.m6" class="ltx_Math" alttext="\sigma_{2}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\sigma_{2}</annotation></semantics></math>.</p>
</div>
<section id="A3.SS2.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Assumptions.</h5>

<div id="A3.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p1.1" class="ltx_p">We impose the following assumptions on the activation functions <math id="A3.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\sigma_{1}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\sigma_{1}</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\sigma_{2}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\sigma_{2}</annotation></semantics></math>:</p>
</div>
<div id="A3.SS2.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p2.1" class="ltx_p"><span id="A3.SS2.SSS0.Px1.p2.1.1" class="ltx_text ltx_font_italic">(A.1) (Algebraic Independence)</span> For any pair of matrices <math id="A3.SS2.SSS0.Px1.p2.m1" class="ltx_Math" alttext="(\bm{B}_{1},\bm{A}_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝑨</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{B}_{1},\bm{A}_{1})</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px1.p2.m2" class="ltx_Math" alttext="(\bm{B}_{2},\bm{A}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝑨</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{B}_{2},\bm{A}_{2})</annotation></semantics></math> such that <math id="A3.SS2.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\sigma_{2}(\bm{B}_{1})\sigma_{1}(\bm{A}_{1})=\sigma_{2}(\bm{B}_{2})\sigma_{1}(\bm{A}_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma_{2}(\bm{B}_{1})\sigma_{1}(\bm{A}_{1})=\sigma_{2}(\bm{B}_{2})\sigma_{1}(\bm{A}_{2})</annotation></semantics></math>, then it follows that <math id="A3.SS2.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\bm{B}_{1}=\bm{B}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑩</mi><mn>1</mn></msub><mo>=</mo><msub><mi>𝑩</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\bm{B}_{1}=\bm{B}_{2}</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\bm{A}_{1}=\bm{A}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑨</mi><mn>1</mn></msub><mo>=</mo><msub><mi>𝑨</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\bm{A}_{1}=\bm{A}_{2}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p3.1" class="ltx_p"><span id="A3.SS2.SSS0.Px1.p3.1.1" class="ltx_text ltx_font_italic">(A.2) (Uniform Lipschitz)</span> Denote</p>
<table id="A3.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex49.m1" class="ltx_Math" alttext="\displaystyle\bm{F}(\bm{X},\bm{A},\bm{B}):=\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}}\bm{X}\right)\left(m^{*}_{V,j}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}}\right)\bm{X}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑭</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑨</mi><mo>,</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{F}(\bm{X},\bm{A},\bm{B}):=\exp\left(\bm{X}^{\top}m_{Q,k}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}}\bm{X}\right)\left(m^{*}_{V,j}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}}\right)\bm{X},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px1.p3.2" class="ltx_p">then for any <math id="A3.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\tau\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{1,2\}</annotation></semantics></math>,</p>
<table id="A3.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex50.m1" class="ltx_Math" alttext="\sum_{|\alpha|=\tau}\left\|\left(\dfrac{\partial^{|\alpha|}\bm{F}}{\partial{\bm{A}}^{\alpha_{1}}\partial{\bm{B}}^{\alpha_{2}}}({\bm{X}},\bm{A}_{1},\bm{B}_{1})-\dfrac{\partial^{|\alpha|}\bm{F}}{\partial{\bm{A}}^{\alpha_{1}}\partial{\bm{B}}^{\alpha_{2}}}({\bm{X}},\bm{A}_{2},\bm{B}_{2})\right)\gamma^{\alpha}\right\|\leq C\|(\bm{A}_{1},\bm{B}_{1})-(\bm{A}_{2},\bm{B}_{2})\|^{a}\|\gamma\|^{a}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>τ</mi></mrow></munder><mrow><mo lspace="0em">‖</mo><mrow><mrow><mo>(</mo><mrow><mrow><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mi>𝑭</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><msub><mi>𝑨</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝑩</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mi>𝑭</mi></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><msub><mi>𝑨</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝑩</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mi>α</mi></msup></mrow><mo>‖</mo></mrow></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝑩</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝑩</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>γ</mi><mo stretchy="false">‖</mo></mrow><mi>a</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{|\alpha|=\tau}\left\|\left(\dfrac{\partial^{|\alpha|}\bm{F}}{\partial{\bm{A}}^{\alpha_{1}}\partial{\bm{B}}^{\alpha_{2}}}({\bm{X}},\bm{A}_{1},\bm{B}_{1})-\dfrac{\partial^{|\alpha|}\bm{F}}{\partial{\bm{A}}^{\alpha_{1}}\partial{\bm{B}}^{\alpha_{2}}}({\bm{X}},\bm{A}_{2},\bm{B}_{2})\right)\gamma^{\alpha}\right\|\leq C\|(\bm{A}_{1},\bm{B}_{1})-(\bm{A}_{2},\bm{B}_{2})\|^{a}\|\gamma\|^{a},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS0.Px1.p3.3" class="ltx_p">for any vector <math id="A3.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\gamma\in\mathbb{R}^{2dr}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\gamma\in\mathbb{R}^{2dr}</annotation></semantics></math> and for some positive constant <math id="A3.SS2.SSS0.Px1.p3.m3" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px1.p3.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> independent of input <math id="A3.SS2.SSS0.Px1.p3.m5" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math> and parameter <math id="A3.SS2.SSS0.Px1.p3.m6" class="ltx_Math" alttext="{\bm{A}}_{1},{\bm{B}}_{1},{\bm{A}}_{2},{\bm{B}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑨</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝑩</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝑨</mi><mn>2</mn></msub><mo>,</mo><msub><mi>𝑩</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\bm{A}}_{1},{\bm{B}}_{1},{\bm{A}}_{2},{\bm{B}}_{2}</annotation></semantics></math>. We denote the index <math id="A3.SS2.SSS0.Px1.p3.m7" class="ltx_Math" alttext="\alpha=(\alpha_{1},\alpha_{2})\in\mathbb{N}^{r\times d}\times\mathbb{N}^{d\times r}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>ℕ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℕ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha=(\alpha_{1},\alpha_{2})\in\mathbb{N}^{r\times d}\times\mathbb{N}^{d\times r}</annotation></semantics></math> and <math id="A3.SS2.SSS0.Px1.p3.m8" class="ltx_Math" alttext="\bm{A}^{\alpha_{1}}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><annotation encoding="application/x-tex">\bm{A}^{\alpha_{1}}</annotation></semantics></math> will return the entries of <math id="A3.SS2.SSS0.Px1.p3.m9" class="ltx_Math" alttext="\bm{A}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">\bm{A}</annotation></semantics></math> at the position that the element of <math id="A3.SS2.SSS0.Px1.p3.m10" class="ltx_Math" alttext="\alpha_{1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\alpha_{1}</annotation></semantics></math> is non-zero.</p>
</div>
<div id="A3.SS2.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p4.1" class="ltx_p"><span id="A3.SS2.SSS0.Px1.p4.1.1" class="ltx_text ltx_font_italic">(A.3) (Strong identifiability)</span>
We denote</p>
<table id="A3.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\displaystyle\bm{M}" display="inline" intent=":literal"><semantics><mi>𝑴</mi><annotation encoding="application/x-tex">\displaystyle\bm{M}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex51.m2" class="ltx_Math" alttext="\displaystyle:=\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex52.m1" class="ltx_Math" alttext="\displaystyle\bm{N}" display="inline" intent=":literal"><semantics><mi>𝑵</mi><annotation encoding="application/x-tex">\displaystyle\bm{N}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52.m2" class="ltx_Math" alttext="\displaystyle:=\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS0.Px1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p5.1" class="ltx_p">Then, for any non-positive integer <math id="A3.SS2.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> and distinct matrices <math id="A3.SS2.SSS0.Px1.p5.m2" class="ltx_Math" alttext="\{({\bm{B}}_{j},{\bm{A}}_{j})\}_{j\in[\ell]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo>,</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{({\bm{B}}_{j},{\bm{A}}_{j})\}_{j\in[\ell]}</annotation></semantics></math>, the functions in the set below are linear independent for almost sure <math id="A3.SS2.SSS0.Px1.p5.m3" class="ltx_Math" alttext="\bm{X}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">\bm{X}</annotation></semantics></math>:</p>
<table id="A3.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex53.m1" class="ltx_Math" alttext="\displaystyle\Bigg\{\;" display="inline" intent=":literal"><semantics><mo stretchy="false">{</mo><annotation encoding="application/x-tex">\displaystyle\Bigg\{\;</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex53.m2" class="ltx_Math" alttext="\displaystyle\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\bm{N}^{*}_{j}\bm{X},\quad\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\bm{N}^{*}_{j}\bm{X},\quad\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X},\quad\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo rspace="1.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo rspace="1.167em">,</mo><m