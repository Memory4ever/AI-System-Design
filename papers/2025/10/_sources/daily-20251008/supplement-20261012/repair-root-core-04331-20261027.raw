<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex168.m1" class="ltx_Math" alttext="\displaystyle\hskip 98.16191pt\Bigg(m_{V,j}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})\|+\tau_{V}}\Bigg)\bm{X}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑩</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑨</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 98.16191pt\Bigg(m_{V,j}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B}_{j})\sigma_{1}(\bm{A}_{j})\|+\tau_{V}}\Bigg)\bm{X}</annotation></semantics></math></td>
