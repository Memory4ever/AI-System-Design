<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_Math" alttext="\displaystyle:=A_{n}(\bm{X})-B_{n}(\bm{X})+C_{n}(\bm{X})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>A</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>B</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=A_{n}(\bm{X})-B_{n}(\bm{X})+C_{n}(\bm{X}).</annotation></semantics></math></td>
