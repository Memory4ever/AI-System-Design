<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E19.m2" class="ltx_Math" alttext="\displaystyle\sum_{j=1}^{L}\mathrm{softmax}\Bigg(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}+c_{j}^{*}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{L}\mathrm{softmax}\Bigg(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}+c_{j}^{*}\Bigg)</annotation></semantics></math></td>
