<section id="A3.SS2.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Decomposing <math id="A3.SS2.SSS1.Px1.m1" class="ltx_Math" alttext="\widetilde{A}_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{A}_{n}(\bm{X})</annotation></semantics></math>.</h5>

<div id="A3.SS2.SSS1.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px1.p1.1" class="ltx_p">We denote:</p>
<table id="A3.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex70.m1" class="ltx_Math" alttext="\displaystyle\widetilde{U}(\bm{X};{\bm{B}},{\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{U}(\bm{X};{\bm{B}},{\bm{A}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70.m2" class="ltx_Math" alttext="\displaystyle:=\exp\left(\bm{X}^{\top}m_{Q}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}}\bm{X}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\exp\left(\bm{X}^{\top}m_{Q}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}}\bm{X}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex71.m1" class="ltx_Math" alttext="\displaystyle\widetilde{V}(\bm{X};{\bm{B}},{\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>V</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{V}(\bm{X};{\bm{B}},{\bm{A}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71.m2" class="ltx_Math" alttext="\displaystyle:=\left(m_{V}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}}\right)\bm{X}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>m</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=\left(m_{V}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}}\right)\bm{X}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex72.m1" class="ltx_Math" alttext="\displaystyle\widetilde{F}(\bm{X};{\bm{B}},{\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>F</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{F}(\bm{X};{\bm{B}},{\bm{A}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72.m2" class="ltx_Math" alttext="\displaystyle:=\widetilde{U}(\bm{X};{\bm{B}},{\bm{A}})\widetilde{V}(\bm{X};{\bm{B}},{\bm{A}})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>V</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\widetilde{U}(\bm{X};{\bm{B}},{\bm{A}})\widetilde{V}(\bm{X};{\bm{B}},{\bm{A}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p1.2" class="ltx_p">and for brevity of notation, we will use <math id="A3.SS2.SSS1.Px1.p1.m1" class="ltx_Math" alttext="\tilde{U}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>U</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{U}</annotation></semantics></math> instead of <math id="A3.SS2.SSS1.Px1.p1.m2" class="ltx_Math" alttext="\widetilde{U}(\bm{X};{\bm{B}},{\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{U}(\bm{X};{\bm{B}},{\bm{A}})</annotation></semantics></math> with its subscript follows the subscripts of <math id="A3.SS2.SSS1.Px1.p1.m3" class="ltx_Math" alttext="\{{\bm{B}},{\bm{A}}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>𝑩</mi><mo>,</mo><mi>𝑨</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{{\bm{B}},{\bm{A}}\}</annotation></semantics></math>, similarly for <math id="A3.SS2.SSS1.Px1.p1.m4" class="ltx_Math" alttext="\tilde{V}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>V</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{V}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p1.m5" class="ltx_Math" alttext="\widetilde{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{F}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px1.p2.1" class="ltx_p">We decompose <math id="A3.SS2.SSS1.Px1.p2.m1" class="ltx_Math" alttext="\widetilde{A}_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{A}_{n}(\bm{X})</annotation></semantics></math> based on the number of element in the Voronoi cells as follows:</p>
<table id="A3.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex73.m1" class="ltx_Math" alttext="\displaystyle\widetilde{A}_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{A}_{n}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{F}_{n,i}-\widetilde{F}^{*}_{j}\Big]+\sum_{j:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{F}_{n,i}-\widetilde{F}^{*}_{j}\Big]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mover accent="true"><mi>F</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>F</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mover accent="true"><mi>F</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>F</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{F}_{n,i}-\widetilde{F}^{*}_{j}\Big]+\sum_{j:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{F}_{n,i}-\widetilde{F}^{*}_{j}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex74.m1" class="ltx_Math" alttext="\displaystyle:=\widetilde{A}_{n,1}(\bm{X})+\widetilde{A}_{n,2}(\bm{X})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\widetilde{A}_{n,1}(\bm{X})+\widetilde{A}_{n,2}(\bm{X}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p2.2" class="ltx_p">We apply the first-order Taylor expansion to <math id="A3.SS2.SSS1.Px1.p2.m2" class="ltx_Math" alttext="\widetilde{U}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>U</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{U}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p2.m3" class="ltx_Math" alttext="\widetilde{V}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>V</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{V}</annotation></semantics></math>,</p>
<table id="A3.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex75.m1" class="ltx_Math" alttext="\displaystyle\widetilde{U}_{n,i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>U</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\widetilde{U}_{n,i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75.m2" class="ltx_Math" alttext="\displaystyle=\widetilde{U}_{j}^{*}+\sum_{|\alpha|=1}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})+\widetilde{R}_{ij,1}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>2</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>U</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\widetilde{U}_{j}^{*}+\sum_{|\alpha|=1}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})+\widetilde{R}_{ij,1}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex76.m1" class="ltx_Math" alttext="\displaystyle\widetilde{V}_{n,i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle\widetilde{V}_{n,i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex76.m2" class="ltx_Math" alttext="\displaystyle=\widetilde{V}^{*}_{j}+\sum_{|\alpha|=1}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})+\widetilde{R}_{ij,2}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>2</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>,</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\widetilde{V}^{*}_{j}+\sum_{|\alpha|=1}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})+\widetilde{R}_{ij,2}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p2.3" class="ltx_p">for any <math id="A3.SS2.SSS1.Px1.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p2.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> such that <math id="A3.SS2.SSS1.Px1.p2.m6" class="ltx_Math" alttext="i\in\mathcal{V}_{j}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">i\in\mathcal{V}_{j}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p2.m7" class="ltx_Math" alttext="|\mathcal{V}_{j}|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\mathcal{V}_{j}|=1</annotation></semantics></math>. Here, the functions <math id="A3.SS2.SSS1.Px1.p2.m8" class="ltx_Math" alttext="\widetilde{R}_{ij,1}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{R}_{ij,1}({\bm{X}})</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p2.m9" class="ltx_Math" alttext="\widetilde{R}_{ij,2}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{R}_{ij,2}({\bm{X}})</annotation></semantics></math> denote the Taylor remainders. Plugging the above identities into <math id="A3.SS2.SSS1.Px1.p2.m10" class="ltx_Math" alttext="\widetilde{A}_{n,1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\widetilde{A}_{n,1}</annotation></semantics></math> leads to</p>
<table id="A3.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex77.m1" class="ltx_Math" alttext="\displaystyle\widetilde{A}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{A}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex77.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!}\sum_{|\alpha|=1}\biggr\{(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{V}_{j}^{*}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>α</mi><mo>!</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder></mstyle><mo lspace="0em" rspace="0em">{</mo><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msup><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>2</mn></msub></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>U</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo><msubsup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!}\sum_{|\alpha|=1}\biggr\{(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{V}_{j}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex78.m1" class="ltx_math_unparsed" alttext="\displaystyle+(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{U}_{j}^{*}\biggr\}+\widetilde{R}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msup><msup><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>2</mn></msub></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{U}_{j}^{*}\biggr\}+\widetilde{R}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex79.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{|\alpha|=1}\biggr\{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{V}^{*}_{j}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder></mstyle><mo lspace="0em" rspace="0em">{</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>U</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo><msubsup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{|\alpha|=1}\biggr\{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{V}^{*}_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex80.m1" class="ltx_math_unparsed" alttext="\displaystyle+\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{U}_{j}^{*}\biggr\}+\widetilde{R}_{n,1}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{U}_{j}^{*}\biggr\}+\widetilde{R}_{n,1}({\bm{X}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p2.4" class="ltx_p">where <math id="A3.SS2.SSS1.Px1.p2.m11" class="ltx_Math" alttext="\alpha=(\alpha_{1},\alpha_{2})\in(\mathbb{N}^{r\times d},\mathbb{N}^{d\times r})" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℕ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup><mo>,</mo><msup><mi>ℕ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha=(\alpha_{1},\alpha_{2})\in(\mathbb{N}^{r\times d},\mathbb{N}^{d\times r})</annotation></semantics></math> and the function <math id="A3.SS2.SSS1.Px1.p2.m12" class="ltx_Math" alttext="\widetilde{R}_{n,1}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{R}_{n,1}({\bm{X}})</annotation></semantics></math> satisfies that <math id="A3.SS2.SSS1.Px1.p2.m13" class="ltx_Math" alttext="\widetilde{R}_{n,1}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{R}_{n,1}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0</annotation></semantics></math>. This fact is due to the uniform Lipschitz assumption of the function <math id="A3.SS2.SSS1.Px1.p2.m14" class="ltx_Math" alttext="\widetilde{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{F}</annotation></semantics></math>. The coefficients <math id="A3.SS2.SSS1.Px1.p2.m15" class="ltx_Math" alttext="\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}</annotation></semantics></math> are given by:</p>
<table id="A3.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex81.m1" class="ltx_Math" alttext="\displaystyle\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\displaystyle\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex81.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>α</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p2.5" class="ltx_p">for any <math id="A3.SS2.SSS1.Px1.p2.m16" class="ltx_Math" alttext="|\alpha|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\alpha|=1</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px1.p3.1" class="ltx_p">Moving to the function <math id="A3.SS2.SSS1.Px1.p3.m1" class="ltx_Math" alttext="\widetilde{A}_{n,2}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{A}_{n,2}(\bm{X})</annotation></semantics></math>, we perform the Taylor expansion up to the second order of <math id="A3.SS2.SSS1.Px1.p3.m2" class="ltx_Math" alttext="\widetilde{U}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>U</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{U}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p3.m3" class="ltx_Math" alttext="\widetilde{V}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>V</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{V}</annotation></semantics></math> then plugging in <math id="A3.SS2.SSS1.Px1.p3.m4" class="ltx_Math" alttext="\widetilde{A}_{n,2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\widetilde{A}_{n,2}</annotation></semantics></math> yields,</p>
<table id="A3.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex82.m1" class="ltx_Math" alttext="\displaystyle\widetilde{A}_{n,2}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{A}_{n,2}({\bm{X}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex82.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|&gt;1}\ \sum_{1\leq|\alpha|\leq 2}\biggr\{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{V}_{j}^{*}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>2</mn></mrow></munder></mstyle><mo lspace="0em" rspace="0em">{</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>U</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo><msubsup><mover accent="true"><mi>V</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|&gt;1}\ \sum_{1\leq|\alpha|\leq 2}\biggr\{\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{V}_{j}^{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle+\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{U}^{*}_{j}\Biggr\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\widetilde{U}^{*}_{j}\Biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex84.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{|\alpha|=1,|\beta|=1}\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\beta_{1}}}\partial{{\bm{B}}^{\beta_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})+\widetilde{R}_{n,2}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi>β</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>U</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>β</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>β</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo>;</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{|\alpha|=1,|\beta|=1}\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})\dfrac{\partial^{|\alpha|}\widetilde{V}}{\partial{{\bm{A}}^{\beta_{1}}}\partial{{\bm{B}}^{\beta_{2}}}}(\bm{X};{\bm{B}}_{j}^{*},{\bm{A}}_{j}^{*})+\widetilde{R}_{n,2}({\bm{X}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p3.2" class="ltx_p">where the remainder <math id="A3.SS2.SSS1.Px1.p3.m5" class="ltx_Math" alttext="\widetilde{R}_{n,2}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{R}_{n,2}({\bm{X}})</annotation></semantics></math> satisfies that <math id="A3.SS2.SSS1.Px1.p3.m6" class="ltx_Math" alttext="\widetilde{R}_{n,2}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*}))\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{R}_{n,2}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*}))\to 0</annotation></semantics></math>. The coefficients <math id="A3.SS2.SSS1.Px1.p3.m7" class="ltx_Math" alttext="\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p3.m8" class="ltx_Math" alttext="\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}</annotation></semantics></math> take the following forms:</p>
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex85.m1" class="ltx_Math" alttext="\displaystyle\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}=\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>α</mi><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}=\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}}(\Delta{\bm{B}}_{n,ij})^{\alpha_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p3.3" class="ltx_p">for any <math id="A3.SS2.SSS1.Px1.p3.m9" class="ltx_Math" alttext="|\alpha|=2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|\alpha|=2</annotation></semantics></math> and</p>
<table id="A3.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex86.m1" class="ltx_Math" alttext="\displaystyle\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">\displaystyle\widetilde{M}_{n,j,\alpha_{1},\alpha_{2},\beta_{1},\beta_{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex86.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!\beta!}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}+\alpha_{2}}(\Delta{\bm{B}}_{n,ij})^{\beta_{1}+\beta_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mrow><mi>α</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mo>!</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>+</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>+</mo><msub><mi>β</mi><mn>2</mn></msub></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i\in\mathcal{V}_{j}}\dfrac{\exp(c_{n,i})}{\alpha!\beta!}(\Delta{\bm{A}}_{n,ij})^{\alpha_{1}+\alpha_{2}}(\Delta{\bm{B}}_{n,ij})^{\beta_{1}+\beta_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px1.p3.4" class="ltx_p">for any <math id="A3.SS2.SSS1.Px1.p3.m10" class="ltx_Math" alttext="|\alpha|=|\beta|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>β</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\alpha|=|\beta|=1</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px1.p4.1" class="ltx_p">The partial derivatives of <math id="A3.SS2.SSS1.Px1.p4.m1" class="ltx_Math" alttext="\widetilde{U}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>U</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{U}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p4.m2" class="ltx_Math" alttext="\widetilde{V}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>V</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{V}</annotation></semantics></math> can be calculated as following (recall the <math id="A3.SS2.SSS1.Px1.p4.m3" class="ltx_Math" alttext="\bm{M}" display="inline" intent=":literal"><semantics><mi>𝑴</mi><annotation encoding="application/x-tex">\bm{M}</annotation></semantics></math>, <math id="A3.SS2.SSS1.Px1.p4.m4" class="ltx_Math" alttext="\bm{N}" display="inline" intent=":literal"><semantics><mi>𝑵</mi><annotation encoding="application/x-tex">\bm{N}</annotation></semantics></math> term appear in <math id="A3.SS2.SSS1.Px1.p4.m5" class="ltx_Math" alttext="\widetilde{U}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>U</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{U}</annotation></semantics></math> and <math id="A3.SS2.SSS1.Px1.p4.m6" class="ltx_Math" alttext="\widetilde{V}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>V</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{V}</annotation></semantics></math>):</p>
<table id="A3.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
