<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\widetilde{M}_{n,j,0,u,0,v}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>v</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\widetilde{M}_{n,j,0,u,0,v}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex114.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\widetilde{M}_{n,j,u,0,0,v}m_{Q,j}m_{V,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi>v</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\widetilde{M}_{n,j,u,0,0,v}m_{Q,j}m_{V,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex115.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X}\widetilde{M}_{n,j,0,u,v,0}m_{Q,j}m_{V,j}\Bigg]+\widetilde{R}_{n,2}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X}\widetilde{M}_{n,j,0,u,v,0}m_{Q,j}m_{V,j}\Bigg]+\widetilde{R}_{n,2}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS1.Px1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px1.p5.1" class="ltx_p">here we use the notation <math id="A3.SS2.SSS1.Px1.p5.m1" class="ltx_Math" alttext="\frac{\partial\bm{M}^{*}_{j}}{\partial\bm{A}^{u}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\bm{M}^{*}_{j}}{\partial\bm{A}^{u}}</annotation></semantics></math> to denote for the value of <math id="A3.SS2.SSS1.Px1.p5.m2" class="ltx_Math" alttext="\frac{\partial\bm{M}}{\partial\bm{A}^{u}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mo>∂</mo><mi>𝑴</mi></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac><annotation encoding="application/x-tex">\frac{\partial\bm{M}}{\partial\bm{A}^{u}}</annotation></semantics></math> at <math id="A3.SS2.SSS1.Px1.p5.m3" class="ltx_Math" alttext="(\bm{A}^{*}_{j},\bm{B}^{*}_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo>,</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{A}^{*}_{j},\bm{B}^{*}_{j})</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS2.SSS1.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Decomposing <math id="A3.SS2.SSS1.Px2.m1" class="ltx_Math" alttext="\widetilde{B}_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{B}_{n}(\bm{X})</annotation></semantics></math>.</h5>

<div id="A3.SS2.SSS1.Px2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p1.1" class="ltx_p">Moving to <math id="A3.SS2.SSS1.Px2.p1.m1" class="ltx_Math" alttext="\widetilde{B}_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{B}_{n}(\bm{X})</annotation></semantics></math>, we can decompose this function as follows:</p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex116.m1" class="ltx_Math" alttext="\displaystyle\widetilde{B}_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{B}_{n}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex116.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{U}_{n,i}-\widetilde{U}^{*}_{j}\Big]f_{\widetilde{G}_{n}}(\bm{X})+\sum_{j:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{U}_{n,i}-\widetilde{U}_{j}^{*}\Big]f_{\widetilde{G}_{n}}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mover accent="true"><mi>U</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mover accent="true"><mi>U</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{U}_{n,i}-\widetilde{U}^{*}_{j}\Big]f_{\widetilde{G}_{n}}(\bm{X})+\sum_{j:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\widetilde{U}_{n,i}-\widetilde{U}_{j}^{*}\Big]f_{\widetilde{G}_{n}}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex117.m1" class="ltx_Math" alttext="\displaystyle:=\widetilde{B}_{n,1}(\bm{X})+\widetilde{B}_{n,2}(\bm{X})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\widetilde{B}_{n,1}(\bm{X})+\widetilde{B}_{n,2}(\bm{X}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p1.2" class="ltx_p">Performing the Taylor expansions up to the first order for <math id="A3.SS2.SSS1.Px2.p1.m2" class="ltx_Math" alttext="\widetilde{B}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{B}_{n,1}(\bm{X})</annotation></semantics></math> and the second order for <math id="A3.SS2.SSS1.Px2.p1.m3" class="ltx_Math" alttext="\widetilde{B}_{n,2}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{B}_{n,2}(\bm{X})</annotation></semantics></math> leads to</p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex118.m1" class="ltx_Math" alttext="\displaystyle\widetilde{B}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{B}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex118.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{|\alpha|=1}\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}^{*}_{j}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}f_{\widetilde{G}_{n}}(\bm{X})+\widetilde{R}_{n,3}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder></mstyle><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{|\alpha|=1}\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}^{*}_{j}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}f_{\widetilde{G}_{n}}(\bm{X})+\widetilde{R}_{n,3}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex119.m1" class="ltx_Math" alttext="\displaystyle\widetilde{B}_{n,2}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{B}_{n,2}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex119.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{1\leq|\alpha|\leq 2}\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}_{j}^{*}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}f_{\widetilde{G}_{n}}(\bm{X})+\widetilde{R}_{n,4}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>2</mn></mrow></munder></mstyle><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow></msup><msubsup><mover accent="true"><mi>U</mi><mo>~</mo></mover><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><msub><mi>α</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><msub><mi>α</mi><mn>2</mn></msub></msup></mrow></mrow></mrow></mfrac></mstyle><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>4</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\sum_{1\leq|\alpha|\leq 2}\widetilde{M}_{n,j,\alpha_{1},\alpha_{2}}\dfrac{\partial^{|\alpha|}\widetilde{U}_{j}^{*}}{\partial{{\bm{A}}^{\alpha_{1}}}\partial{{\bm{B}}^{\alpha_{2}}}}f_{\widetilde{G}_{n}}(\bm{X})+\widetilde{R}_{n,4}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p1.3" class="ltx_p">where the Taylor remainders <math id="A3.SS2.SSS1.Px2.p1.m4" class="ltx_Math" alttext="\widetilde{R}_{n,3}({\bm{X}}),\widetilde{R}_{n,4}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{R}_{n,3}({\bm{X}}),\widetilde{R}_{n,4}({\bm{X}})</annotation></semantics></math> satisfy that:</p>
<table id="A3.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex120.m1" class="ltx_Math" alttext="\displaystyle\widetilde{R}_{n,3}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0,\quad" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{R}_{n,3}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0,\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex120.m2" class="ltx_Math" alttext="\displaystyle\widetilde{R}_{n,4}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{R}_{n,4}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p1.4" class="ltx_p">Direct calculation leads to</p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex121.m1" class="ltx_Math" alttext="\displaystyle\widetilde{B}_{n,1}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{B}_{n,1}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex121.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\exp(m_{Q,j}\bm{X}^{\top}\mathbf{Q}_{j}^{*}\bm{X})\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\mathbf{Q}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,0}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>𝐐</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></munderover></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝐐</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j:|\mathcal{V}_{j}|=1}\exp(m_{Q,j}\bm{X}^{\top}\mathbf{Q}_{j}^{*}\bm{X})\sum_{u=(1,1)}^{(d,d)}\left(\bm{X}^{\top}\frac{\partial\mathbf{Q}_{j}^{*}}{\partial\bm{A}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,0}m_{Q,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u}\left(\bm{X}^{\top}\frac{\partial\mathbf{Q}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u}m_{Q,j}+\widetilde{R}_{n,3}(\bm{X})," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>u</mi></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝐐</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><msub><mover accent="true"><mi>R</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u}\left(\bm{X}^{\top}\frac{\partial\mathbf{Q}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u}m_{Q,j}+\widetilde{R}_{n,3}(\bm{X}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
