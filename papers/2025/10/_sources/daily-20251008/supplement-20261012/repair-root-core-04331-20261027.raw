<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Proofs</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ Voronoi loss. ‣ 4.1 Non-shared structure causes suboptimal sample complexity ‣ 4 Theoretical Analysis ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h3>

<section id="A3.SS1.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 1.</h5>

<div id="A3.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p1.1" class="ltx_p">Firstly, we demonstrate that the following limit holds for any <math id="A3.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math>:</p>
<table id="A3.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E8.m1" class="ltx_math_unparsed" alttext="\displaystyle\lim_{\varepsilon\to 0}\inf_{G\in\mathcal{G}_{L^{\prime}}(\Theta):\mathcal{D}_{1,r}(G,G_{*})\leq\varepsilon}\frac{\|f_{G}-f_{G_{*}}\|_{L^{2}(\mu)}}{\mathcal{D}_{1,r}(G,G_{*})}=0." display="inline" intent=":literal"><semantics><mrow><mo movablelimits="false" rspace="0.0835em">lim</mo><msub><mrow></mrow><mrow><mi>ε</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></msub><mo lspace="0.0835em" movablelimits="false" rspace="0.167em">inf</mo><msub><mrow></mrow><mrow><mi>G</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ε</mi></mrow></mrow></msub><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>G</mi></msub><mo>−</mo><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\varepsilon\to 0}\inf_{G\in\mathcal{G}_{L^{\prime}}(\Theta):\mathcal{D}_{1,r}(G,G_{*})\leq\varepsilon}\frac{\|f_{G}-f_{G_{*}}\|_{L^{2}(\mu)}}{\mathcal{D}_{1,r}(G,G_{*})}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p2.1" class="ltx_p">To prove this, we construct a mixing measure sequence <math id="A3.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="(G_{n})_{n}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mi>n</mi></msub><annotation encoding="application/x-tex">(G_{n})_{n}</annotation></semantics></math> that satisfies both <math id="A3.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\mathcal{D}_{1,r}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{D}_{1,r}(G_{n},G_{*})\to 0</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="{\|f_{G_{n}}-f_{G_{*}}\|_{L^{2}(\mu)}}/{\mathcal{D}_{1,r}(G_{n},G_{*})}\to 0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\|f_{G_{n}}-f_{G_{*}}\|_{L^{2}(\mu)}}/{\mathcal{D}_{1,r}(G_{n},G_{*})}\to 0,</annotation></semantics></math>
as <math id="A3.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. Specifically, we consider the sequence of mixing measure with <math id="A3.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="L+1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L+1</annotation></semantics></math> atoms, <math id="A3.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="G_{n}=\sum_{i=1}^{L+1}\exp(c^{n}_{i})\delta_{({\bm{B}}^{n}_{Q,i},{\bm{A}}^{n}_{Q,i},{\bm{B}}^{n}_{V,i},{\bm{A}}^{n}_{V,i})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>i</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>,</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{n}=\sum_{i=1}^{L+1}\exp(c^{n}_{i})\delta_{({\bm{B}}^{n}_{Q,i},{\bm{A}}^{n}_{Q,i},{\bm{B}}^{n}_{V,i},{\bm{A}}^{n}_{V,i})}</annotation></semantics></math>, where,</p>
<ul id="A3.I1" class="ltx_itemize">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i1.p1.1" class="ltx_p"><math id="A3.I1.i1.p1.m1" class="ltx_Math" alttext="\exp(c^{n}_{1})=\exp(c^{n}_{2})=\frac{1}{2}\exp(c^{*}_{1})+\frac{1}{2n^{r+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mn>1</mn><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mn>2</mn><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mn>1</mn><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\exp(c^{n}_{1})=\exp(c^{n}_{2})=\frac{1}{2}\exp(c^{*}_{1})+\frac{1}{2n^{r+1}}</annotation></semantics></math> and <math id="A3.I1.i1.p1.m2" class="ltx_Math" alttext="\exp(c^{n}_{i})=\exp(c^{*}_{i-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>i</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp(c^{n}_{i})=\exp(c^{*}_{i-1})</annotation></semantics></math> for any <math id="A3.I1.i1.p1.m3" class="ltx_Math" alttext="3\leq i\leq L+1" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3\leq i\leq L+1</annotation></semantics></math>;</p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i2.p1.1" class="ltx_p"><math id="A3.I1.i2.p1.m1" class="ltx_Math" alttext="{\bm{B}}^{n}_{Q,1}=\left(1+\frac{1}{n}\right){\bm{B}}^{*}_{Q,1}+\frac{1}{\sqrt{n}}\bm{S},{\bm{B}}^{n}_{Q,2}=\left(1+\frac{1}{n}\right){\bm{B}}^{*}_{Q,1}-\frac{1}{\sqrt{n}}\bm{S}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑺</mi></mrow></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑺</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{B}}^{n}_{Q,1}=\left(1+\frac{1}{n}\right){\bm{B}}^{*}_{Q,1}+\frac{1}{\sqrt{n}}\bm{S},{\bm{B}}^{n}_{Q,2}=\left(1+\frac{1}{n}\right){\bm{B}}^{*}_{Q,1}-\frac{1}{\sqrt{n}}\bm{S}</annotation></semantics></math> and <math id="A3.I1.i2.p1.m2" class="ltx_Math" alttext="{\bm{B}}^{n}_{Q,i}={\bm{B}}^{*}_{Q,i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{B}}^{n}_{Q,i}={\bm{B}}^{*}_{Q,i-1}</annotation></semantics></math> for any <math id="A3.I1.i2.p1.m3" class="ltx_Math" alttext="3\leq i\leq L+1" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3\leq i\leq L+1</annotation></semantics></math>;</p>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i3.p1.1" class="ltx_p"><math id="A3.I1.i3.p1.m1" class="ltx_Math" alttext="{\bm{A}}^{n}_{Q,1}={\bm{A}}^{*}_{Q,1}+\frac{1}{\sqrt{n}}\bm{T},{\bm{A}}^{n}_{Q,2}={\bm{A}}^{*}_{Q,1}-\frac{1}{\sqrt{n}}\bm{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>=</mo><mrow><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo>+</mo><mrow><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑻</mi></mrow></mrow></mrow><mo>,</mo><mrow><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo>=</mo><mrow><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo>−</mo><mrow><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑻</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}^{n}_{Q,1}={\bm{A}}^{*}_{Q,1}+\frac{1}{\sqrt{n}}\bm{T},{\bm{A}}^{n}_{Q,2}={\bm{A}}^{*}_{Q,1}-\frac{1}{\sqrt{n}}\bm{T}</annotation></semantics></math> and <math id="A3.I1.i3.p1.m2" class="ltx_Math" alttext="{\bm{A}}^{n}_{Q,i}={\bm{A}}^{*}_{Q,i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{A}}^{n}_{Q,i}={\bm{A}}^{*}_{Q,i-1}</annotation></semantics></math> for any <math id="A3.I1.i3.p1.m3" class="ltx_Math" alttext="3\leq i\leq L+1" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3\leq i\leq L+1</annotation></semantics></math>;</p>
</div></li>
<li id="A3.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i4.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i4.p1.1" class="ltx_p"><math id="A3.I1.i4.p1.m1" class="ltx_Math" alttext="{\bm{B}}^{n}_{V,1}={\bm{B}}^{n}_{V,2}={\bm{B}}^{*}_{V,1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{B}}^{n}_{V,1}={\bm{B}}^{n}_{V,2}={\bm{B}}^{*}_{V,1}</annotation></semantics></math> and <math id="A3.I1.i4.p1.m2" class="ltx_Math" alttext="{\bm{B}}^{n}_{V,i}={\bm{B}}^{*}_{V,i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{B}}^{n}_{V,i}={\bm{B}}^{*}_{V,i-1}</annotation></semantics></math> for any <math id="A3.I1.i4.p1.m3" class="ltx_Math" alttext="3\leq i\leq L+1" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3\leq i\leq L+1</annotation></semantics></math>,</p>
</div></li>
<li id="A3.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i5.p1" class="ltx_para">
<p id="A3.I1.i5.p1.1" class="ltx_p"><math id="A3.I1.i5.p1.m1" class="ltx_Math" alttext="{\bm{A}}^{n}_{V,1}={\bm{A}}^{n}_{V,2}={\bm{A}}^{*}_{V,1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{A}}^{n}_{V,1}={\bm{A}}^{n}_{V,2}={\bm{A}}^{*}_{V,1}</annotation></semantics></math> and <math id="A3.I1.i5.p1.m2" class="ltx_Math" alttext="{\bm{A}}^{n}_{V,i}={\bm{A}}^{*}_{V,i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>i</mi></mrow><mi>n</mi></msubsup><mo>=</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{A}}^{n}_{V,i}={\bm{A}}^{*}_{V,i-1}</annotation></semantics></math> for any <math id="A3.I1.i5.p1.m3" class="ltx_Math" alttext="3\leq i\leq L+1" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">3\leq i\leq L+1</annotation></semantics></math>,</p>
</div></li>
</ul>
<p id="A3.SS1.SSS0.Px1.p2.2" class="ltx_p">where <math id="A3.SS1.SSS0.Px1.p2.m7" class="ltx_Math" alttext="\bm{S}\in\mathbb{R}^{d\times r}" display="inline" intent=":literal"><semantics><mrow><mi>𝑺</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>r</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{S}\in\mathbb{R}^{d\times r}</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p2.m8" class="ltx_Math" alttext="\bm{T}\in\mathbb{R}^{r\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝑻</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{T}\in\mathbb{R}^{r\times d}</annotation></semantics></math> are chosen to satisfy <math id="A3.SS1.SSS0.Px1.p2.m9" class="ltx_Math" alttext="\bm{S}\bm{T}=\bm{C}_{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑻</mi></mrow><mo>=</mo><msub><mi>𝑪</mi><mi>Q</mi></msub></mrow><annotation encoding="application/x-tex">\bm{S}\bm{T}=\bm{C}_{Q}</annotation></semantics></math> if rank of <math id="A3.SS1.SSS0.Px1.p2.m10" class="ltx_Math" alttext="\bm{C}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑪</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\bm{C}_{Q}</annotation></semantics></math> is less than or equal <math id="A3.SS1.SSS0.Px1.p2.m11" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. We note that choosing <math id="A3.SS1.SSS0.Px1.p2.m12" class="ltx_Math" alttext="\bm{S}" display="inline" intent=":literal"><semantics><mi>𝑺</mi><annotation encoding="application/x-tex">\bm{S}</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p2.m13" class="ltx_Math" alttext="\bm{T}" display="inline" intent=":literal"><semantics><mi>𝑻</mi><annotation encoding="application/x-tex">\bm{T}</annotation></semantics></math> so that <math id="A3.SS1.SSS0.Px1.p2.m14" class="ltx_Math" alttext="\bm{S}\bm{T}=\bm{C}_{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑻</mi></mrow><mo>=</mo><msub><mi>𝑪</mi><mi>Q</mi></msub></mrow><annotation encoding="application/x-tex">\bm{S}\bm{T}=\bm{C}_{Q}</annotation></semantics></math> can be done easily using the singular vectors and singular values of <math id="A3.SS1.SSS0.Px1.p2.m15" class="ltx_Math" alttext="\bm{C}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑪</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\bm{C}_{Q}</annotation></semantics></math>. Then, if we have <math id="A3.SS1.SSS0.Px1.p2.m16" class="ltx_Math" alttext="\bm{S}\bm{T}=\bm{C}_{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑻</mi></mrow><mo>=</mo><msub><mi>𝑪</mi><mi>Q</mi></msub></mrow><annotation encoding="application/x-tex">\bm{S}\bm{T}=\bm{C}_{Q}</annotation></semantics></math>,
it is clear that,</p>
<table id="A3.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex22.m1" class="ltx_Math" alttext="\displaystyle{\bm{B}}^{n}_{Q,1}{\bm{A}}^{n}_{Q,1}+{\bm{B}}^{n}_{Q,2}{\bm{A}}^{n}_{Q,2}=2\left(1+\frac{1}{n}\right){\bm{B}}^{*}_{Q,1}{\bm{A}}^{*}_{Q,1}+\frac{2}{n}\bm{C}_{Q}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>Q</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{B}}^{n}_{Q,1}{\bm{A}}^{n}_{Q,1}+{\bm{B}}^{n}_{Q,2}{\bm{A}}^{n}_{Q,2}=2\left(1+\frac{1}{n}\right){\bm{B}}^{*}_{Q,1}{\bm{A}}^{*}_{Q,1}+\frac{2}{n}\bm{C}_{Q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p2.3" class="ltx_p">This identity is necessary for the later part of our proof. Now, if rank of <math id="A3.SS1.SSS0.Px1.p2.m17" class="ltx_Math" alttext="\bm{C}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑪</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\bm{C}_{Q}</annotation></semantics></math> is larger than <math id="A3.SS1.SSS0.Px1.p2.m18" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, we can write <math id="A3.SS1.SSS0.Px1.p2.m19" class="ltx_Math" alttext="\bm{C}_{Q}" display="inline" intent=":literal"><semantics><msub><mi>𝑪</mi><mi>Q</mi></msub><annotation encoding="application/x-tex">\bm{C}_{Q}</annotation></semantics></math> as the sum of multiple matrices, let’s say <math id="A3.SS1.SSS0.Px1.p2.m20" class="ltx_Math" alttext="\bm{C}_{Q,1}" display="inline" intent=":literal"><semantics><msub><mi>𝑪</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\bm{C}_{Q,1}</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p2.m21" class="ltx_Math" alttext="\bm{C}_{Q,2}" display="inline" intent=":literal"><semantics><msub><mi>𝑪</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\bm{C}_{Q,2}</annotation></semantics></math>), each with rank less than or equal to <math id="A3.SS1.SSS0.Px1.p2.m22" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and build the mixing measure similarly with more atoms, so that we can recover the sum <math id="A3.SS1.SSS0.Px1.p2.m23" class="ltx_Math" alttext="\bm{C}_{Q,1}+\bm{C}_{Q,2}=\bm{C}_{Q}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑪</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>𝑪</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo>=</mo><msub><mi>𝑪</mi><mi>Q</mi></msub></mrow><annotation encoding="application/x-tex">\bm{C}_{Q,1}+\bm{C}_{Q,2}=\bm{C}_{Q}</annotation></semantics></math>. Just for this example, the goal is to have the following,</p>
<table id="A3.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex23.m1" class="ltx_Math" alttext="\displaystyle{\bm{B}}^{n}_{Q,1}{\bm{A}}^{n}_{Q,1}+{\bm{B}}^{n}_{Q,2}{\bm{A}}^{n}_{Q,2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow><mi>n</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{B}}^{n}_{Q,1}{\bm{A}}^{n}_{Q,1}+{\bm{B}}^{n}_{Q,2}{\bm{A}}^{n}_{Q,2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex23.m2" class="ltx_Math" alttext="\displaystyle=2\left(1+\frac{1}{2n}\right){\bm{B}}^{*}_{Q,1}{\bm{A}}^{*}_{Q,1}+\frac{2}{n}\bm{C}_{Q,1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2\left(1+\frac{1}{2n}\right){\bm{B}}^{*}_{Q,1}{\bm{A}}^{*}_{Q,1}+\frac{2}{n}\bm{C}_{Q,1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex24.m1" class="ltx_Math" alttext="\displaystyle{\bm{B}}^{n}_{Q,3}{\bm{A}}^{n}_{Q,3}+{\bm{B}}^{n}_{Q,4}{\bm{A}}^{n}_{Q,4}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>3</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>3</mn></mrow><mi>n</mi></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>4</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>4</mn></mrow><mi>n</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{B}}^{n}_{Q,3}{\bm{A}}^{n}_{Q,3}+{\bm{B}}^{n}_{Q,4}{\bm{A}}^{n}_{Q,4}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24.m2" class="ltx_Math" alttext="\displaystyle=2\left(1+\frac{1}{2n}\right){\bm{B}}^{*}_{Q,1}{\bm{A}}^{*}_{Q,1}+\frac{2}{n}\bm{C}_{Q,2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mrow><mi>Q</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2\left(1+\frac{1}{2n}\right){\bm{B}}^{*}_{Q,1}{\bm{A}}^{*}_{Q,1}+\frac{2}{n}\bm{C}_{Q,2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p3.1" class="ltx_p">We go back to the original chosen values above. Computing the loss function <math id="A3.SS1.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\mathcal{D}_{1,r}(G_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{1,r}(G_{n},G_{*})</annotation></semantics></math> yields</p>
<table id="A3.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E9.m1" class="ltx_Math" alttext="\displaystyle\mathcal{D}_{1,r}(G_{n},G_{*})=\frac{1}{n^{r+1}}+\Big[\exp(c^{*}_{1})+\frac{1}{n^{r+1}}\Big]\cdot\frac{1}{n^{r}}\|\bm{B}_{Q,1}^{*}\|^{r}=\mathcal{O}(n^{-r})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mn>1</mn><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">]</mo></mrow><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>n</mi><mi>r</mi></msup></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo stretchy="false">‖</mo></mrow><mi>r</mi></msup></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mi>r</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{D}_{1,r}(G_{n},G_{*})=\frac{1}{n^{r+1}}+\Big[\exp(c^{*}_{1})+\frac{1}{n^{r+1}}\Big]\cdot\frac{1}{n^{r}}\|\bm{B}_{Q,1}^{*}\|^{r}=\mathcal{O}(n^{-r}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p3.2" class="ltx_p">It can be seen that <math id="A3.SS1.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\mathcal{D}_{1,r}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{D}_{1,r}(G_{n},G_{*})\to 0</annotation></semantics></math> as <math id="A3.SS1.SSS0.Px1.p3.m3" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.SSS0.Px1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS0.Px1.p4.1" class="ltx_p">Now we show that <math id="A3.SS1.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\|f_{G_{n}}-f_{G_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mi>G</mi><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mn>1</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\|f_{G_{n}}-f_{G_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{1,r}(G_{n},G_{*})\to 0</annotation></semantics></math>. Indeed, consider the below quantity,</p>
<table id="A3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex25.m1" class="ltx_Math" alttext="T_{n}(\bm{X}):=\left(\sum_{j=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}\|}\bm{C}_{K}\bm{X}+c^{*}_{j}\right)\right)\cdot[f_{G_{n}}(\bm{X})-f_{\bar{G}_{*}}(\bm{X})]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑪</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><msub><mi>G</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>¯</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T_{n}(\bm{X}):=\left(\sum_{j=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}\|}\bm{C}_{K}\bm{X}+c^{*}_{j}\right)\right)\cdot[f_{G_{n}}(\bm{X})-f_{\bar{G}_{*}}(\bm{X})],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p4.2" class="ltx_p">which can be decomposed as follows:</p>
<table id="A3.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle T_{n}(\bm{X})=\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c^{n}_{i})\Bigg[\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)\left(m_{V,j}\frac{\bm{C}_{V,j}+\bm{B}^{n}_{V,j}\bm{A}^{n}_{V,j}}{\|\bm{C}_{V,j}+\bm{B}^{n}_{V,j}\bm{A}^{n}_{V,j}\|}\right)\bm{X}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>i</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><msub><mi>𝑪</mi><mi>K</mi></msub><mi>𝑿</mi><mo>)</mo></mrow><mrow><mo>(</mo><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>𝑿</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{n}(\bm{X})=\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c^{n}_{i})\Bigg[\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{n}_{Q,j}\bm{A}^{n}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)\left(m_{V,j}\frac{\bm{C}_{V,j}+\bm{B}^{n}_{V,j}\bm{A}^{n}_{V,j}}{\|\bm{C}_{V,j}+\bm{B}^{n}_{V,j}\bm{A}^{n}_{V,j}\|}\right)\bm{X}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 85.35826pt-\exp\left(\bm{X}^{\top}m^{*}_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)\left(m_{V,j}\frac{\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}}{\|\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}\|}\right)\bm{X}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msubsup><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><msub><mi>𝑪</mi><mi>K</mi></msub><mi>𝑿</mi><mo>)</mo></mrow><mrow><mo>(</mo><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>𝑿</mi><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 85.35826pt-\exp\left(\bm{X}^{\top}m^{*}_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)\left(m_{V,j}\frac{\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}}{\|\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}\|}\right)\bm{X}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
