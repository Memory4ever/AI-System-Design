<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex125.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}\partial\bm{A}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u+v,0}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}\partial\bm{A}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u+v,0}m_{Q,j}</annotation></semantics></math></td>
