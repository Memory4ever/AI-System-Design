/mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{j=1}^{L}\exp{(c_{j}^{*})}\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}^{*}_{j})\sigma_{1}(\bm{A}^{*}_{j})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}^{*}_{j})\sigma_{1}(\bm{A}^{*}_{j})\|+\tau_{Q}}\bm{X}\right)</annotation></semantics></math></td>
