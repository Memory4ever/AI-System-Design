<tbody id="A3.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex163.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex163.m2" class="ltx_Math" alttext="\displaystyle\{\mathrm{softmax}(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}+c_{j}^{*}):j\in[L]\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{\mathrm{softmax}(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}+c_{j}^{*}):j\in[L]\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p3.3" class="ltx_p">for almost surely <math id="A3.SS2.SSS2.p3.m3" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math>. By relabeling the indices, we can assume without loss of generality that for any <math id="A3.SS2.SSS2.p3.m4" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math> that:</p>
<table id="A3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

