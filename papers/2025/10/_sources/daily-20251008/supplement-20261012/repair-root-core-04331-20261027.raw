<tbody id="A3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex126.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u+v,0}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mo>,</mo><mn>0</mn></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u+v,0}m_{Q,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex127.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u+v}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u+v}m_{Q,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex128.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u+v}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u+v}m_{Q,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex129.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,v}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><msup><mo>∂</mo><mn>2</mn></msup><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial^{2}\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,v}m_{Q,j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex130.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,v}m_{Q,j}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u,v}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,u,v}m_{Q,j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.SSS1.Px2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p2.1" class="ltx_p">Putting all the above results together, we can represent the function <math id="A3.SS2.SSS1.Px2.p2.m1" class="ltx_Math" alttext="T_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{n}(\bm{X})</annotation></semantics></math> as follows:</p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex131.m1" class="ltx_Math" alttext="\displaystyle Q_{n}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q_{n}({\bm{X}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex131.m2" class="ltx_Math" alttext="\displaystyle=\widetilde{A}_{n,1}+\widetilde{A}_{n,2}-\widetilde{B}_{n,1}-\widetilde{B}_{n,2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo>−</mo><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\widetilde{A}_{n,1}+\widetilde{A}_{n,2}-\widetilde{B}_{n,1}-\widetilde{B}_{n,2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{j=1}^{L}\widetilde{N}_{n,j}\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big[(m_{V,j}\bm{N}_{j}^{*}){\bm{X}}-f_{\widetilde{G}_{n}}({\bm{X}})\Big]," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo>)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝑿</mi><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{j=1}^{L}\widetilde{N}_{n,j}\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big[(m_{V,j}\bm{N}_{j}^{*}){\bm{X}}-f_{\widetilde{G}_{n}}({\bm{X}})\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.Px2.p2.2" class="ltx_p">where <math id="A3.SS2.SSS1.Px2.p2.m2" class="ltx_Math" alttext="\widetilde{N}_{n,j}:=\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>N</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo rspace="0.111em">:=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{N}_{n,j}:=\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})</annotation></semantics></math> for any <math id="A3.SS2.SSS1.Px2.p2.m3" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.Px2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.Px2.p3.1" class="ltx_p"><span id="A3.SS2.SSS1.Px2.p3.1.1" class="ltx_text ltx_font_bold">Step 2 - Non-vanishing coefficients.</span>
As indicated in equation (<a href="#A3.E14" title="In Decomposing 𝐵̃_𝑛⁢(𝑿). ‣ C.2.1 Local Part ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), <math id="A3.SS2.SSS1.Px2.p3.m1" class="ltx_Math" alttext="Q_{n}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mi>G</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{n}({\bm{X}})/\mathcal{D}_{2}(\widetilde{G}_{n},G_{*})</annotation></semantics></math> can be expressed as a linear combination of the following independent functions:</p>
<table id="A3.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
