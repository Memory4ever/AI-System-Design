<tbody id="A3.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E23.m1" class="ltx_Math" alttext="\displaystyle\hskip 76.82234pt\left(m^{*}_{V,j}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B}^{*}_{j})\sigma_{1}(\bm{A}^{*}_{j})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B}^{*}_{j})\sigma_{1}(\bm{A}^{*}_{j})\|+\tau_{V}}\right)\bm{X}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msubsup><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 76.82234pt\left(m^{*}_{V,j}\frac{\bm{C}_{V}+\sigma_{2}(\bm{B}^{*}_{j})\sigma_{1}(\bm{A}^{*}_{j})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B}^{*}_{j})\sigma_{1}(\bm{A}^{*}_{j})\|+\tau_{V}}\right)\bm{X},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS2.p3.5" class="ltx_p">for almost surely <math id="A3.SS2.SSS2.p3.m6" class="ltx_Math" alttext="{\bm{X}}" display="inline" intent=":literal"><semantics><mi>𝑿</mi><annotation encoding="application/x-tex">{\bm{X}}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS2.p4.1" class="ltx_p">Now, the index set <math id="A3.SS2.SSS2.p4.m1" class="ltx_Math" alttext="[L]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[L]</annotation></semantics></math> can be partitioned into <math id="A3.SS2.SSS2.p4.m2" class="ltx_Math" alttext="\tilde{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>m</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{m}</annotation></semantics></math> subsets <math id="A3.SS2.SSS2.p4.m3" class="ltx_Math" alttext="\tilde{K}_{1},\tilde{K}_{2},\ldots,\tilde{K}_{\tilde{m}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>K</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>K</mi><mo>~</mo></mover><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>K</mi><mo>~</mo></mover><mover accent="true"><mi>m</mi><mo>~</mo></mover></msub></mrow><annotation encoding="application/x-tex">\tilde{K}_{1},\tilde{K}_{2},\ldots,\tilde{K}_{\tilde{m}}</annotation></semantics></math> where <math id="A3.SS2.SSS2.p4.m4" class="ltx_Math" alttext="\tilde{m}\leq L" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>m</mi><mo>~</mo></mover><mo>≤</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">\tilde{m}\leq L</annotation></semantics></math>, such that <math id="A3.SS2.SSS2.p4.m5" class="ltx_Math" alttext="\exp{(c_{j})}=\exp{(c_{j^{\prime}}^{*{}})}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><msup><mi>j</mi><mo>′</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp{(c_{j})}=\exp{(c_{j^{\prime}}^{*{}})}</annotation></semantics></math> for any indices <math id="A3.SS2.SSS2.p4.m6" class="ltx_Math" alttext="j,j^{\prime}\in\tilde{K}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>,</mo><mrow><msup><mi>j</mi><mo>′</mo></msup><mo>∈</mo><msub><mover accent="true"><mi>K</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">j,j^{\prime}\in\tilde{K}_{i}</annotation></semantics></math> and <math id="A3.SS2.SSS2.p4.m7" class="ltx_Math" alttext="i\in[\tilde{m}]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>m</mi><mo>~</mo></mover><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[\tilde{m}]</annotation></semantics></math>. Thus, equation (<a href="#A3.E23" title="In C.2.2 Global Part ‣ C.2 Proof of Theorem ‣ Appendix C Proofs ‣ DoRAN: Stabilizing Weight-Decomposed Low-Rank Adaptation via Noise Injection and Auxiliary Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) can be rewritten as follows:</p>
<table id="A3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex167.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{\tilde{m}}\sum_{j\in\tilde{K}_{i}}\exp{(c^{*}_{j})}\exp\Bigg(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}\Bigg)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mover accent="true"><mi>m</mi><mo>~</mo></mover></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><msub><mover accent="true"><mi>K</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></munder></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{\tilde{m}}\sum_{j\in\tilde{K}_{i}}\exp{(c^{*}_{j})}\exp\Bigg(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}\Bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
