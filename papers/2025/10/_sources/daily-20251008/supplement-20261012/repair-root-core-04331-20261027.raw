<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex124.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{u}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u}m_{Q,j}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>u</mi></munder></mstyle><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mi>u</mi></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>n</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mi>u</mi></mrow></msub><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{u}\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{u}}\bm{X}\right)f_{\tilde{G}_{n}}(\bm{X})\widetilde{M}_{n,j,0,u}m_{Q,j}</annotation></semantics></math></td>
