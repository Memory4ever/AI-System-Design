<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex164.m1" class="ltx_Math" alttext="\displaystyle\mathrm{softmax}(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}+c_{j}^{*})" display="inline" intent=":literal"><semantics><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{softmax}(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}_{j}^{*})\sigma_{1}(\bm{A}_{j}^{*})\|+\tau_{Q}}\bm{X}+c_{j}^{*})</annotation></semantics></math></td>
