<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex58.m1" class="ltx_Math" alttext="\displaystyle\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X},\quad\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X},\quad\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59.m1" class="ltx_math_unparsed" alttext="\displaystyle\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X},\quad\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X}\;:\;j\in[\ell]\Bigg\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo rspace="1.167em">,</mo><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑩</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo>)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mrow><mo>∂</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mfrac></mstyle><mi>𝑿</mi><mo lspace="0.558em" rspace="0.558em">:</mo><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{A}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{B}^{(v)}}\bm{X},\quad\left(\bm{X}^{\top}\frac{\partial\bm{M}_{j}^{*}}{\partial\bm{B}^{(u)}}\bm{X}\right)\frac{\partial\bm{N}_{j}^{*}}{\partial\bm{A}^{(v)}}\bm{X}\;:\;j\in[\ell]\Bigg\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.1 </span>Local Part</h4>

<div id="A3.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p1.1" class="ltx_p">For the local part, we will prove that</p>
<table id="A3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex60.m1" class="ltx_math_unparsed" alttext="\lim_{\varepsilon\to 0}\inf_{\widetilde{G}\in\mathcal{G}_{L^{\prime}}(\Theta):\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})\leq\varepsilon}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ε</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><munder><mo lspace="0.167em" movablelimits="false" rspace="0em">inf</mo><mrow><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>ε</mi></mrow></mrow></munder><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>f</mi><mover accent="true"><mi>G</mi><mo>~</mo></mover></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><msub><mo lspace="0em" rspace="0em">∥</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\varepsilon\to 0}\inf_{\widetilde{G}\in\mathcal{G}_{L^{\prime}}(\Theta):\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})\leq\varepsilon}\|f_{\widetilde{G}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G},\widetilde{G}_{*})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.2" class="ltx_p">We will prove this by contradiction: assume that the above claim does not hold. This means we can find a sequence of mixing measures <math id="A3.SS2.SSS1.p1.m1" class="ltx_Math" alttext="\widetilde{G}_{n}:=\sum_{j=1}^{L^{\prime}}\exp(c_{n,j})\delta_{{\bm{B}}_{n,j}{\bm{A}}_{n,j}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>L</mi><mo>′</mo></msup></msubsup><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{G}_{n}:=\sum_{j=1}^{L^{\prime}}\exp(c_{n,j})\delta_{{\bm{B}}_{n,j}{\bm{A}}_{n,j}}</annotation></semantics></math> in <math id="A3.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>~</mo></mover><msup><mi>L</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{G}}_{L^{\prime}}(\Theta)</annotation></semantics></math> such that</p>
<table id="A3.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex61.m1" class="ltx_math_unparsed" alttext="\left\{\begin{matrix}\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0,\\
\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0.\end{matrix}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{matrix}\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0,\\
\|f_{\widetilde{G}_{n}}-f_{\widetilde{G}_{*}}\|_{L^{2}(\mu)}/\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0.\end{matrix}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.3" class="ltx_p">as <math id="A3.SS2.SSS1.p1.m3" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. We denote <math id="A3.SS2.SSS1.p1.m4" class="ltx_Math" alttext="\mathcal{V}_{j}^{n}:=\mathcal{V}_{j}(\widetilde{G}_{n})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi><mi>n</mi></msubsup><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}_{j}^{n}:=\mathcal{V}_{j}(\widetilde{G}_{n})</annotation></semantics></math> as a Voronoi cell of <math id="A3.SS2.SSS1.p1.m5" class="ltx_Math" alttext="\widetilde{G}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widetilde{G}_{n}</annotation></semantics></math> generated by the <math id="A3.SS2.SSS1.p1.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th components of <math id="A3.SS2.SSS1.p1.m7" class="ltx_Math" alttext="\widetilde{G}_{*}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><annotation encoding="application/x-tex">\widetilde{G}_{*}</annotation></semantics></math>. Without loss of generality, we may assume that those Voronoi cells do not depend on the sample size, i.e., <math id="A3.SS2.SSS1.p1.m8" class="ltx_Math" alttext="\mathcal{V}_{j}=\mathcal{V}_{j}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{V}_{j}=\mathcal{V}_{j}^{n}</annotation></semantics></math>. Therefore, the Voronoi loss can be rewritten as follows:</p>
<table id="A3.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\displaystyle\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})=\sum_{j=1}^{L}\Big|\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j^{\prime}}^{*})\Big|" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><msup><mi>j</mi><mo>′</mo></msup><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})=\sum_{j=1}^{L}\Big|\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j^{\prime}}^{*})\Big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex62.m2" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{j\in[L]:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{B}}_{n,ij}\|+\|\Delta{\bm{A}}_{n,ij}\|)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0.167em">∥</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{j\in[L]:|\mathcal{V}_{j}|=1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{B}}_{n,ij}\|+\|\Delta{\bm{A}}_{n,ij}\|)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{j\in[L]:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{B}}_{n,ij}\|^{2}+\|\Delta{\bm{A}}_{n,ij}\|^{2})," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi mathvariant="normal">Δ</mi><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{j\in[L]:|\mathcal{V}_{j}|&gt;1}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})(\|\Delta{\bm{B}}_{n,ij}\|^{2}+\|\Delta{\bm{A}}_{n,ij}\|^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.4" class="ltx_p">where <math id="A3.SS2.SSS1.p1.m9" class="ltx_Math" alttext="\Delta{\bm{B}}_{n,ij}:={\bm{B}}_{n,i}-{\bm{B}}_{j^{\prime}}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo>:=</mo><mrow><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mi>𝑩</mi><msup><mi>j</mi><mo>′</mo></msup><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta{\bm{B}}_{n,ij}:={\bm{B}}_{n,i}-{\bm{B}}_{j^{\prime}}^{*}</annotation></semantics></math> and <math id="A3.SS2.SSS1.p1.m10" class="ltx_Math" alttext="\Delta{\bm{A}}_{n,ij}:={\bm{A}}_{n,i}-{\bm{A}}_{j^{\prime}}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub></mrow><mo>:=</mo><mrow><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo>−</mo><msubsup><mi>𝑨</mi><msup><mi>j</mi><mo>′</mo></msup><mo>∗</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta{\bm{A}}_{n,ij}:={\bm{A}}_{n,i}-{\bm{A}}_{j^{\prime}}^{*}</annotation></semantics></math> for all <math id="A3.SS2.SSS1.p1.m11" class="ltx_Math" alttext="i\in\mathcal{V}_{j^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><msup><mi>j</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">i\in\mathcal{V}_{j^{\prime}}</annotation></semantics></math> and <math id="A3.SS2.SSS1.p1.m12" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p2.1" class="ltx_p">Since <math id="A3.SS2.SSS1.p2.m1" class="ltx_Math" alttext="\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{D}_{2}(\widetilde{G}_{n},\widetilde{G}_{*})\to 0</annotation></semantics></math>, we have <math id="A3.SS2.SSS1.p2.m2" class="ltx_Math" alttext="\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\to\exp(c^{*}_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\to\exp(c^{*}_{j})</annotation></semantics></math>, <math id="A3.SS2.SSS1.p2.m3" class="ltx_Math" alttext="{\bm{B}}_{n,i}\to{\bm{B}}_{j}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑩</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">→</mo><msubsup><mi>𝑩</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{B}}_{n,i}\to{\bm{B}}_{j}^{*}</annotation></semantics></math>, and <math id="A3.SS2.SSS1.p2.m4" class="ltx_Math" alttext="{\bm{A}}_{n,i}\to{\bm{A}}_{j}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑨</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">→</mo><msubsup><mi>𝑨</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">{\bm{A}}_{n,i}\to{\bm{A}}_{j}^{*}</annotation></semantics></math> for any <math id="A3.SS2.SSS1.p2.m5" class="ltx_Math" alttext="i\in\mathcal{V}_{j}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">i\in\mathcal{V}_{j}</annotation></semantics></math> and <math id="A3.SS2.SSS1.p2.m6" class="ltx_Math" alttext="j\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[L]</annotation></semantics></math>.
Now, the proof of the local part can be divided into three main steps as follows:</p>
</div>
<div id="A3.SS2.SSS1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p3.1" class="ltx_p"><span id="A3.SS2.SSS1.p3.1.1" class="ltx_text ltx_font_bold">Step 1 - Decompose the difference between regression functions.</span></p>
</div>
<div id="A3.SS2.SSS1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p4.1" class="ltx_p">Recall the notation,</p>
<table id="A3.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex64.m1" class="ltx_Math" alttext="\displaystyle\bm{M}" display="inline" intent=":literal"><semantics><mi>𝑴</mi><annotation encoding="application/x-tex">\displaystyle\bm{M}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex64.m2" class="ltx_Math" alttext="\displaystyle:=\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{Q}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle\bm{N}" display="inline" intent=":literal"><semantics><mi>𝑵</mi><annotation encoding="application/x-tex">\displaystyle\bm{N}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle:=\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑩</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>V</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\frac{\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})}{\|\bm{C}_{V}+\sigma_{2}(\bm{B})\sigma_{1}(\bm{A})\|+\tau_{V}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p4.2" class="ltx_p">and their subscripts will follow the subscripts of the matrices <math id="A3.SS2.SSS1.p4.m1" class="ltx_Math" alttext="\bm{A},\bm{B}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>,</mo><mi>𝑩</mi></mrow><annotation encoding="application/x-tex">\bm{A},\bm{B}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.SSS1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p5.1" class="ltx_p">First, we define</p>
<table id="A3.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex66.m1" class="ltx_Math" alttext="T_{n}(\bm{X}):=\left(\sum_{k=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,k}\underbrace{\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}^{*}_{k})\sigma_{1}(\bm{A}^{*}_{k})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}^{*}_{k})\sigma_{1}(\bm{A}^{*}_{k})\|+\tau_{Q}}}_{\bm{M}_{k}^{*}}\bm{X}+c^{*}_{k}\right)\right)\cdot[f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>k</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>k</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑩</mi><mi>k</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝑨</mi><mi>k</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>τ</mi><mi>Q</mi></msub></mrow></mfrac><mo stretchy="true">⏟</mo></munder><msubsup><mi>𝑴</mi><mi>k</mi><mo>∗</mo></msubsup></munder><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>+</mo><msubsup><mi>c</mi><mi>k</mi><mo>∗</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{n}(\bm{X}):=\left(\sum_{k=1}^{L}\exp\left(\bm{X}^{\top}m_{Q,k}\underbrace{\frac{\bm{C}_{Q}+\sigma_{2}(\bm{B}^{*}_{k})\sigma_{1}(\bm{A}^{*}_{k})}{\|\bm{C}_{Q}+\sigma_{2}(\bm{B}^{*}_{k})\sigma_{1}(\bm{A}^{*}_{k})\|+\tau_{Q}}}_{\bm{M}_{k}^{*}}\bm{X}+c^{*}_{k}\right)\right)\cdot[f_{\widetilde{G}_{n}}(\bm{X})-f_{\widetilde{G}_{*}}(\bm{X})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p5.2" class="ltx_p">Then, we can decompose the function <math id="A3.SS2.SSS1.p5.m1" class="ltx_Math" alttext="T_{n}({\bm{X}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{n}({\bm{X}})</annotation></semantics></math> as follows:</p>
<table id="A3.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\displaystyle T_{n}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{n}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67.m2" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{n,j}\bm{X}\right)\left(m_{V,j}\bm{N}_{n,j}\right)\bm{X}-\exp({\bm{X}}^{\top}m_{Q,j}\bm{M}_{j}^{*}{\bm{X}})(m_{V,j}\bm{N}_{j}^{*}){\bm{X}}\Big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑴</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑵</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>−</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑿</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{n,j}\bm{X}\right)\left(m_{V,j}\bm{N}_{n,j}\right)\bm{X}-\exp({\bm{X}}^{\top}m_{Q,j}\bm{M}_{j}^{*}{\bm{X}})(m_{V,j}\bm{N}_{j}^{*}){\bm{X}}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68.m1" class="ltx_math_unparsed" alttext="\displaystyle-\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{n,j}\bm{X}\right)-\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big]f_{\widetilde{G}_{n}}(\bm{X})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msub><mi>𝑴</mi><mrow><mi>n</mi><mo>,</mo><mi>j</mi></mrow></msub><mi>𝑿</mi><mo>)</mo></mrow><mo>−</mo><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo>)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\sum_{j=1}^{L}\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})\Big[\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{n,j}\bm{X}\right)-\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big]f_{\widetilde{G}_{n}}(\bm{X})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{j=1}^{L}\Big(\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})\Big)\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big[(m_{V,j}\bm{N}_{j}^{*})\bm{X}-f_{\widetilde{G}_{n}}(\bm{X})\Big]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.167em">)</mo></mrow><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑴</mi><mi>j</mi><mo>∗</mo></msubsup><mi>𝑿</mi><mo>)</mo></mrow><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><msubsup><mi>𝑵</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>𝑿</mi><mo>−</mo><msub><mi>f</mi><msub><mover accent="true"><mi>G</mi><mo>~</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{j=1}^{L}\Big(\sum_{i\in\mathcal{V}_{j}}\exp(c_{n,i})-\exp(c_{j}^{*})\Big)\exp\left(\bm{X}^{\top}m_{Q,j}\bm{M}_{j}^{*}\bm{X}\right)\Big[(m_{V,j}\bm{N}_{j}^{*})\bm{X}-f_{\widetilde{G}_{n}}(\bm{X})\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E13.m1" class="ltx_Math" alttext="\displaystyle:=\widetilde{A}_{n}(\bm{X})-\widetilde{B}_{n}(\bm{X})+\widetilde{C}_{n}(\bm{X})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>B</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\widetilde{A}_{n}(\bm{X})-\widetilde{B}_{n}(\bm{X})+\widetilde{C}_{n}(\bm{X}).</annotation></semantics></math></td>
