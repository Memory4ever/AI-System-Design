<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_math_unparsed" alttext="\displaystyle\hskip 85.35826pt+\sum_{j=1}^{L}\Big(\sum_{i\in\mathcal{V}_{j}}\exp(c^{n}_{i})-\exp(c_{j}^{*})\Big)\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>j</mi></msub></mrow></munder></mstyle><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>i</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>c</mi><mi>j</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.167em">)</mo></mrow><mi>exp</mi><mrow><mo>(</mo><msup><mi>𝑿</mi><mo>⊤</mo></msup><msub><mi>m</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>Q</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>Q</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><msub><mi>𝑪</mi><mi>K</mi></msub><mi>𝑿</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 85.35826pt+\sum_{j=1}^{L}\Big(\sum_{i\in\mathcal{V}_{j}}\exp(c^{n}_{i})-\exp(c_{j}^{*})\Big)\exp\left(\bm{X}^{\top}m_{Q,j}\frac{\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}}{\|\bm{C}_{Q}+\bm{B}^{*}_{Q,j}\bm{A}^{*}_{Q,j}\|}\bm{C}_{K}\bm{X}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_Math" alttext="\displaystyle\hskip 85.35826pt\times\Big[m_{V,j}\frac{\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}}{\|\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}\|}\bm{X}-f_{G_{n}}(\bm{X})\Big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="8.762em" rspace="0.222em">×</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>m</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑪</mi><mi>V</mi></msub><mo>+</mo><mrow><msubsup><mi>𝑩</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑨</mi><mrow><mi>V</mi><mo>,</mo><mi>j</mi></mrow><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑿</mi></mrow><mo>−</mo><mrow><msub><mi>f</mi><msub><mi>G</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑿</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 85.35826pt\times\Big[m_{V,j}\frac{\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}}{\|\bm{C}_{V}+\bm{B}^{*}_{V,j}\bm{A}^{*}_{V,j}\|}\bm{X}-f_{G_{n}}(\bm{X})\Big]</annotation></semantics></math></td>
