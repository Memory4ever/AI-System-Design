<td id="S4.T3.2.11.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.45pt 5.1pt;"><span id="S4.T3.2.11.4.1" class="ltx_text" style="font-size:80%;">0.0118</span></td>
