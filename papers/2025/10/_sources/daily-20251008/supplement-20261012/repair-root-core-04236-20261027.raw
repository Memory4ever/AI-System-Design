<td id="S4.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.7pt;"><span id="S4.T2.2.2.2.1" class="ltx_text" style="font-size:70%;">1</span></td>
<td id="S4.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.7pt;"><span id="S4.T2.2.2.3.1" class="ltx_text" style="font-size:70%;">1</span></td>
<td id="S4.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.7pt;"><span id="S4.T2.2.2.4.1" class="ltx_text" style="font-size:70%;">2</span></td>
<td id="S4.T2.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.7pt;"><span id="S4.T2.2.2.5.1" class="ltx_text" style="font-size:70%;">3</span></td>
<td id="S4.T2.2.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.7pt;"><span id="S4.T2.2.2.6.1" class="ltx_text" style="font-size:70%;">5</span></td>
<td id="S4.T2.2.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.7pt;"><span id="S4.T2.2.2.7.1" class="ltx_text" style="font-size:70%;">10</span></td>
