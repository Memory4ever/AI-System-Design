;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 75.82 0 M 75.82 0 L 75.82 9.32 L 80.87 9.32 L 80.87 0 Z M 80.87 9.32"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 80.87 0 M 80.87 0 L 80.87 9.65 L 85.92 9.65 L 85.92 0 Z M 85.92 9.65"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 85.92 0 M 85.92 0 L 85.92 10.52 L 90.98 10.52 L 90.98 0 Z M 90.98 10.52"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 90.98 0 M 90.98 0 L 90.98 10.3 L 96.03 10.3 L 96.03 0 Z M 96.03 10.3"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 96.03 0 M 96.03 0 L 96.03 10.95 L 101.08 10.95 L 101.08 0 Z M 101.08 10.95"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 101.08 0 M 101.08 0 L 101.08 10.82 L 106.14 10.82 L 106.14 0 Z M 106.14 10.82"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 106.14 0 M 106.14 0 L 106.14 12.09 L 111.19 12.09 L 111.19 0 Z M 111.19 12.09"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="M 111.19 0 M 111.19 0 L 111.19 12.71 L 116.25 12.71 L 116.25 0 Z M 116.25 12.71"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#8C96C6;" fill="#8C96C6" fill-opacity="0.8" stroke="#000000" stroke-opacity="0.8"><path d="