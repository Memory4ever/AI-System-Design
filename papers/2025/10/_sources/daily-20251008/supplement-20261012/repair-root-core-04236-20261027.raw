<td id="S4.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.7pt;" colspan="5"><span id="S4.T2.2.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">GSO-30</span></td>
