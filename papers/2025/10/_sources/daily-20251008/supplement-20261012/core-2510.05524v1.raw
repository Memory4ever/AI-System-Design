          <span class="ltx_tag ltx_tag_note">1</span>
          
          
          
        </span></span></span>
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">Email: </span><a href="mailto:"><span id="id3" class="ltx_text ltx_font_typewriter">jkarr@nd.edu</span></a>
</span></span></span></span>
