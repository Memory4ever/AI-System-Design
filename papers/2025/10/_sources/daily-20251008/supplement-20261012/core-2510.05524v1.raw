<span id="A6.T13.2.1.1.1.1.1.6.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">1</span>
<span id="A6.T13.2.1.1.1.1.1.6.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">8</span></span>
<span id="A6.T13.2.1.1.1.1.1.7" class="ltx_tr">
<span id="A6.T13.2.1.1.1.1.1.7.1" class="ltx_td ltx_align_left" style="padding-top:0.25pt;padding-bottom:0.25pt;">EVENT DISTANCE</span>
<span id="A6.T13.2.1.1.1.1.1.7.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">0</span>
<span id="A6.T13.2.1.1.1.1.1.7.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">1</span></span>
<span id="A6.T13.2.1.1.1.1.1.8" class="ltx_tr">
