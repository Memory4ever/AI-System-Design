<span id="A6.T13.2.1.1.1.1.1.8.2" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">13</span>
<span id="A6.T13.2.1.1.1.1.1.8.3" class="ltx_td ltx_align_center" style="padding-top:0.25pt;padding-bottom:0.25pt;">94</span></span>
<span id="A6.T13.2.1.1.1.1.1.9" class="ltx_tr">
