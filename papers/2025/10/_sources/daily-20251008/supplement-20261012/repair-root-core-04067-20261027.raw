<th id="S4.T2.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r">All</th>
<td id="S4.T2.2.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.6.2.1" class="ltx_text ltx_font_bold">0.0147</span></td>
