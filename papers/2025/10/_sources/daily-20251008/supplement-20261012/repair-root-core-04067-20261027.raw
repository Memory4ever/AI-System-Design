<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_center">0.0494</td>
<td id="S4.T2.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r">0.0059</td>
<td id="S4.T2.2.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.4.5.1" class="ltx_text ltx_font_bold">0.0038</span></td>
<td id="S4.T2.2.1.4.6" class="ltx_td ltx_align_center">0.0969</td>
<td id="S4.T2.2.1.4.7" class="ltx_td ltx_align_center ltx_border_r">0.0354</td>
<td id="S4.T2.2.1.4.8" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.4.8.1" class="ltx_text ltx_font_bold">0.0178</span></td>
<td id="S4.T2.2.1.4.9" class="ltx_td ltx_align_center">0.1171</td>
<td id="S4.T2.2.1.4.10" class="ltx_td ltx_align_center">0.0344</td></tr>
<tr id="S4.T2.2.1.5" class="ltx_tr">
<th id="S4.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">GPT2</th>
<td id="S4.T2.2.1.5.2" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.5.2.1" class="ltx_text ltx_font_bold">0.0069</span></td>
<td id="S4.T2.2.1.5.3" class="ltx_td ltx_align_center">0.1585</td>
<td id="S4.T2.2.1.5.4" class="ltx_td ltx_align_center ltx_border_r">0.1076</td>
<td id="S4.T2.2.1.5.5" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.5.5.1" class="ltx_text ltx_font_bold">0.0059</span></td>
<td id="S4.T2.2.1.5.6" class="ltx_td ltx_align_center">0.0904</td>
