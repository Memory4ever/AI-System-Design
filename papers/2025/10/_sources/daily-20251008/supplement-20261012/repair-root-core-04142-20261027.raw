<div id="A3.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A3.p4.pic1" class="ltx_picture" height="498.66" overflow="visible" version="1.1" viewBox="0 0 477.38 498.66" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,498.66) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#808080;" fill="#808080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 492.75 C 0 496.01 2.64 498.66 5.91 498.66 L 471.47 498.66 C 474.73 498.66 477.38 496.01 477.38 492.75 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 482.34 L 475.41 482.34 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g style="--ltx-fill-color:#808080;" fill="#808080" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 484.31 L 1.97 492.75 C 1.97 494.93 3.73 496.69 5.91 496.69 L 471.47 496.69 C 473.65 496.69 475.41 494.93 475.41 492.75 L 475.41 484.31 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 6.12 485.7)"><foreignObject style="--ltx-fo-width:33.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="465.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
