<td id="S3.T4.3.1.63.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T4.m187" class="ltx_Math" alttext="0.028_{\pm 0.002}" display="inline" intent=":literal"><semantics><msub><mn>0.028</mn><mrow><mo>±</mo><mn>0.002</mn></mrow></msub><annotation encoding="application/x-tex">0.028_{\pm 0.002}</annotation></semantics></math></td></tr>
