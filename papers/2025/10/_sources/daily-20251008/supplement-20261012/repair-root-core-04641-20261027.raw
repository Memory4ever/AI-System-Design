<td id="S3.T4.3.1.64.3" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T4.m189" class="ltx_Math" alttext="1.000_{\pm 0.000}" display="inline" intent=":literal"><semantics><msub><mn>1.000</mn><mrow><mo>±</mo><mn>0.000</mn></mrow></msub><annotation encoding="application/x-tex">1.000_{\pm 0.000}</annotation></semantics></math></td>
<td id="S3.T4.3.1.64.4" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S3.T4.m190" class="ltx_Math" alttext="0.000_{\pm 0.000}" display="inline" intent=":literal"><semantics><msub><mn>0.000</mn><mrow><mo>±</mo><mn>0.000</mn></mrow></msub><annotation encoding="application/x-tex">0.000_{\pm 0.000}</annotation></semantics></math></td></tr>
