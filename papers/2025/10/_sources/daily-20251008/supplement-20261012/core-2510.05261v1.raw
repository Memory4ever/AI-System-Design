            <span id="alg4.l7.3" class="ltx_text ltx_font_bold">if</span> <math id="alg4.l7.m1" class="ltx_Math" alttext="X_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">X_{i}&gt;0</annotation></semantics></math> <span id="alg4.l7.4" class="ltx_text ltx_font_bold">then</span>

