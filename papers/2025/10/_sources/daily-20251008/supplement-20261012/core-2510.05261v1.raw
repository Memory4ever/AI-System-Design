</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
                  <math id="alg1.l19.m1" class="ltx_Math" alttext="(\bm{\alpha}^{i,\mathrm{adj}})_{j}\leftarrow(\bm{\alpha}^{i})_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜶</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">(\bm{\alpha}^{i,\mathrm{adj}})_{j}\leftarrow(\bm{\alpha}^{i})_{j}</annotation></semantics></math>,  <math id="alg1.l19.m2" class="ltx_Math" alttext="(\bm{\beta}^{i,\mathrm{adj}})_{j}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\bm{\beta}^{i,\mathrm{adj}})_{j}\leftarrow 0</annotation></semantics></math>

