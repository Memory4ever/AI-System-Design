<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex42Xe.m2" class="ltx_Math" alttext="\displaystyle+[(x)_{\mathcal{J}_{i}}]^{T}\Big([(W_{i+1})_{(\bullet,\mathcal{J}_{i})}]^{T}(W_{i+1})_{(\bullet,\mathcal{M}_{i})}\Big)(x)_{\mathcal{M}_{i}}+[(x)_{\mathcal{M}_{i}}]^{T}\Big([(W_{i+1})_{(\bullet,\mathcal{M}_{i})}]^{T}(W_{i+1})_{(\bullet,\mathcal{J}_{i})}(x)_{\mathcal{J}_{i}}\Big)\;&gt;\;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∙</mo><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∙</mo><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub></msub></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∙</mo><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∙</mo><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn> 0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+[(x)_{\mathcal{J}_{i}}]^{T}\Big([(W_{i+1})_{(\bullet,\mathcal{J}_{i})}]^{T}(W_{i+1})_{(\bullet,\mathcal{M}_{i})}\Big)(x)_{\mathcal{M}_{i}}+[(x)_{\mathcal{M}_{i}}]^{T}\Big([(W_{i+1})_{(\bullet,\mathcal{M}_{i})}]^{T}(W_{i+1})_{(\bullet,\mathcal{J}_{i})}(x)_{\mathcal{J}_{i}}\Big)\;&gt;\;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p29.4" class="ltx_p">We denote the part dependent on <math id="A1.SS1.p29.m12" class="ltx_Math" alttext="(\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">(\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}</annotation></semantics></math> to be</p>
<table id="A1.Ex43" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex43X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex43X.m2" class="ltx_Math" alttext="\displaystyle G((\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G((\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex43X.m3" class="ltx_Math" alttext="\displaystyle\triangleq[(x)_{\mathcal{J}_{i}}]^{T}(\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}(x)_{\mathcal{J}_{i}}+[(W_{i}y)_{\mathcal{J}_{i}}]^{T}\!\Big(D_{\bm{\alpha}^{i}}\Lambda_{i}D_{\bm{\beta}^{i}}\Big)_{(\mathcal{J}_{i},\mathcal{J}_{i})}(W_{i}y)_{\mathcal{J}_{i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≜</mo><mrow><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\triangleq[(x)_{\mathcal{J}_{i}}]^{T}(\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}(x)_{\mathcal{J}_{i}}+[(W_{i}y)_{\mathcal{J}_{i}}]^{T}\!\Big(D_{\bm{\alpha}^{i}}\Lambda_{i}D_{\bm{\beta}^{i}}\Big)_{(\mathcal{J}_{i},\mathcal{J}_{i})}(W_{i}y)_{\mathcal{J}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex43Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex43Xa.m2" class="ltx_Math" alttext="\displaystyle+\frac{1}{2}\Big(x^{T}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Big)_{(\mathcal{J}_{i},\mathcal{J}_{i})}(W_{i}y)_{\mathcal{J}_{i}}+\frac{1}{2}[(W_{i}y)_{\mathcal{J}_{i}}]^{T}\Big((D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}x\Big)_{\mathcal{J}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mi>x</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{2}\Big(x^{T}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Big)_{(\mathcal{J}_{i},\mathcal{J}_{i})}(W_{i}y)_{\mathcal{J}_{i}}+\frac{1}{2}[(W_{i}y)_{\mathcal{J}_{i}}]^{T}\Big((D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}x\Big)_{\mathcal{J}_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex43Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex43Xb.m2" class="ltx_Math" alttext="\displaystyle=\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)^{T}\Lambda_{i}\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>+</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>+</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)^{T}\Lambda_{i}\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p29.5" class="ltx_p">The last equality holds by the definition of <math id="A1.SS1.p29.m13" class="ltx_Math" alttext="\mathcal{J}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{J}_{i}</annotation></semantics></math>, <math id="A1.SS1.p29.m14" class="ltx_Math" alttext="(D_{\bm{\alpha}^{i}})_{\mathcal{J}_{i}}=(D_{\bm{\beta}^{i}})_{\mathcal{J}_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">(D_{\bm{\alpha}^{i}})_{\mathcal{J}_{i}}=(D_{\bm{\beta}^{i}})_{\mathcal{J}_{i}}</annotation></semantics></math>.
Therefore for any <math id="A1.SS1.p29.m15" class="ltx_Math" alttext="\Lambda_{i}&gt;\Lambda_{i}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>&gt;</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\Lambda_{i}&gt;\Lambda_{i}^{*}</annotation></semantics></math>,</p>
<table id="A1.Ex44" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex44X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex44X.m2" class="ltx_Math" alttext="\displaystyle H(\Lambda_{i}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(\Lambda_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex44X.m3" class="ltx_Math" alttext="\displaystyle,c_{i}^{*})-H(\Lambda_{i}^{*},c_{i}^{*})" display="inline" intent=":literal"><semantics><mrow><mo>,</mo><mi>c</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">)</mo><mo>−</mo><mi>H</mi><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mo>,</mo><mi>c</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle,c_{i}^{*})-H(\Lambda_{i}^{*},c_{i}^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex44Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex44Xa.m2" class="ltx_Math" alttext="\displaystyle=G((\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})})-G((\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}^{*})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=G((\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})})-G((\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex44Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex44Xb.m2" class="ltx_Math" alttext="\displaystyle=\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)^{T}\Lambda_{i}\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)-\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)^{T}\Lambda_{i}^{*}\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>+</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>+</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>+</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo>+</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)^{T}\Lambda_{i}\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)-\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)^{T}\Lambda_{i}^{*}\left((x)_{\mathcal{J}_{i}}+D_{\bm{\alpha}^{i}}(W_{i}y)_{\mathcal{J}_{i}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex44Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex44Xc.m2" class="ltx_Math" alttext="\displaystyle\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p29.6" class="ltx_p">By the arbitrariness of <math id="A1.SS1.p29.m16" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="A1.SS1.p29.m17" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>, we conclude that constraints in (<a href="#S3.E13" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) are satisfied with any <math id="A1.SS1.p29.m18" class="ltx_Math" alttext="\Lambda_{i}&gt;\Lambda_{i}^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>&gt;</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><annotation encoding="application/x-tex">\Lambda_{i}&gt;\Lambda_{i}^{*}</annotation></semantics></math> while the optimum <math id="A1.SS1.p29.m19" class="ltx_Math" alttext="c_{i}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>i</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">c_{i}^{*}</annotation></semantics></math> is attained. Taking <math id="A1.SS1.p29.m20" class="ltx_Math" alttext="l=\max\limits_{j\in\mathbb{Z}_{d_{i}}}\left\{\left(\Lambda_{i}^{*}\right)_{(j,j)}\right\}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mrow><munder><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><msub><mi>ℤ</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow></munder><mo>⁡</mo><mrow><mo>{</mo><msub><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l=\max\limits_{j\in\mathbb{Z}_{d_{i}}}\left\{\left(\Lambda_{i}^{*}\right)_{(j,j)}\right\}</annotation></semantics></math> completes the proof.
∎</p>
</div>
<div id="A1.SS1.p30" class="ltx_para ltx_noindent">
<p id="A1.SS1.p30.1" class="ltx_p"><span id="A1.SS1.p30.1.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#Thmtheorem7" title="Theorem 7. ‣ 3.5 Theoretical Guarantees and Mathematical Intuition ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></span>.
Under the mild assumption <math id="A1.SS1.p30.m1" class="ltx_Math" alttext="\bm{\alpha}^{i}\otimes\bm{\beta}^{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝜶</mi><mi>i</mi></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>𝜷</mi><mi>i</mi></msup></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bm{\alpha}^{i}\otimes\bm{\beta}^{i}\geq 0</annotation></semantics></math> for all <math id="A1.SS1.p30.m2" class="ltx_Math" alttext="i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N-1}</annotation></semantics></math> and using the fact that <math id="A1.SS1.p30.m3" class="ltx_Math" alttext="M_{0}=I&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>=</mo><mi>I</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{0}=I&gt;0</annotation></semantics></math>, it suffices to show by induction that at layer <math id="A1.SS1.p30.m4" class="ltx_Math" alttext="\textit{L}_{i}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_italic">L</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textit{L}_{i}</annotation></semantics></math>, <math id="A1.SS1.p30.m5" class="ltx_Math" alttext="i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N-1}</annotation></semantics></math>, the following claims hold:</p>
<ol id="A1.I1" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A1.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I1.i1.p1.1" class="ltx_p">Given <math id="A1.I1.i1.p1.m1" class="ltx_Math" alttext="M_{i-1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i-1}&gt;0</annotation></semantics></math>, the feasible set of the SDP constraints in (<a href="#S3.E13" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) and (<a href="#S3.E14" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) is always nonempty and the closed-form solution (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) is always well-defined and positive.</p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p">Optimization problems (<a href="#S3.E13" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), (<a href="#S3.E14" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), and equation (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) can each yield a solution <math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\Lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Lambda_{i}</annotation></semantics></math> such that <math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="M_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i}&gt;0</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A1.SS1.p31" class="ltx_para ltx_noindent">
<p id="A1.SS1.p31.1" class="ltx_p">Since (<a href="#S3.E14" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) is a special case of (<a href="#S3.E13" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) with <math id="A1.SS1.p31.m1" class="ltx_Math" alttext="\Lambda_{i}=\lambda_{i}I" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{i}=\lambda_{i}I</annotation></semantics></math>, it suffices to prove feasibility and <math id="A1.SS1.p31.m2" class="ltx_Math" alttext="M_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i}&gt;0</annotation></semantics></math> for (<a href="#S3.E14" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>); the same conclusions for (<a href="#S3.E13" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) then follow directly, and no separate proof is required.</p>
</div>
<div id="A1.SS1.p32" class="ltx_para ltx_noindent">
<p id="A1.SS1.p32.1" class="ltx_p">Regarding (<a href="#S3.E14" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), we prove that at stage <math id="A1.SS1.p32.m1" class="ltx_Math" alttext="i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N-1}</annotation></semantics></math>, there exists a <math id="A1.SS1.p32.m2" class="ltx_Math" alttext="\lambda_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{i}\geq 0</annotation></semantics></math> and <math id="A1.SS1.p32.m3" class="ltx_Math" alttext="c_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}&gt;0</annotation></semantics></math>, such that</p>
<table id="A1.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E53.m1" class="ltx_Math" alttext="S_{i}\triangleq\begin{bmatrix}\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}\lambda_{i}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&amp;\tilde{M}_{i-1}\end{bmatrix}&gt;0,\quad\tilde{M}_{i}&gt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>≜</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{i}\triangleq\begin{bmatrix}\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}\lambda_{i}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&amp;\tilde{M}_{i-1}\end{bmatrix}&gt;0,\quad\tilde{M}_{i}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p32.2" class="ltx_p">where
<math id="A1.SS1.p32.m4" class="ltx_Math" alttext="\tilde{M}_{i}\triangleq\lambda_{i}I-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mi>i</mi></msub><mo>≜</mo><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{M}_{i}\triangleq\lambda_{i}I-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})</annotation></semantics></math>, <math id="A1.SS1.p32.m5" class="ltx_Math" alttext="i\in\mathbb{Z}_{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N}</annotation></semantics></math> and <math id="A1.SS1.p32.m6" class="ltx_Math" alttext="\tilde{M}_{0}=I" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mn>0</mn></msub><mo>=</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\tilde{M}_{0}=I</annotation></semantics></math>.</p>
</div>
<div id="A1.SS1.p33" class="ltx_para ltx_noindent">
<p id="A1.SS1.p33.1" class="ltx_p">Given <math id="A1.SS1.p33.m1" class="ltx_Math" alttext="\tilde{M}_{i-1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{M}_{i-1}&gt;0</annotation></semantics></math>, by the Schur complement, <math id="A1.SS1.p33.m2" class="ltx_Math" alttext="S_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S_{i}&gt;0</annotation></semantics></math> is equivalent to</p>
<table id="A1.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex45.m1" class="ltx_Math" alttext="T_{i}\triangleq\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\tilde{M}_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>≜</mo><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{i}\triangleq\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\tilde{M}_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p33.2" class="ltx_p">Let</p>
<table id="A1.E54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E54.m1" class="ltx_Math" alttext="\sigma_{i}=\sigma_{\max}\left((D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\tilde{M}_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\right)&gt;0,\qquad\eta_{i}=\sigma_{\max}(W_{i+1}^{T}W_{i+1})&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>η</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma_{i}=\sigma_{\max}\left((D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\tilde{M}_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\right)&gt;0,\qquad\eta_{i}=\sigma_{\max}(W_{i+1}^{T}W_{i+1})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p33.3" class="ltx_p">Choose <math id="A1.SS1.p33.m3" class="ltx_Math" alttext="\lambda_{i}=\frac{2}{\sigma_{i}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><mfrac><mn>2</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{i}=\frac{2}{\sigma_{i}}&gt;0</annotation></semantics></math> and <math id="A1.SS1.p33.m4" class="ltx_Math" alttext="c_{i}=\frac{0.9}{\sigma_{i}\eta_{i}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mfrac><mn>0.9</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>i</mi></msub></mrow></mfrac><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}=\frac{0.9}{\sigma_{i}\eta_{i}}&gt;0</annotation></semantics></math>. Then,</p>
<table id="A1.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex46.m1" class="ltx_Math" alttext="\displaystyle T_{i}\geq~" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo rspace="0.608em">≥</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle T_{i}\geq~</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex46.m2" class="ltx_Math" alttext="\displaystyle\frac{2}{\sigma_{i}}I-\frac{0.9}{\sigma_{i}\eta_{i}}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\frac{4}{\sigma_{i}^{2}}\sigma_{i}I" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>0.9</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{\sigma_{i}}I-\frac{0.9}{\sigma_{i}\eta_{i}}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\frac{4}{\sigma_{i}^{2}}\sigma_{i}I</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex47.m1" class="ltx_Math" alttext="\displaystyle=~" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=~</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex47.m2" class="ltx_Math" alttext="\displaystyle\frac{2}{\sigma_{i}}I-\frac{0.9}{\sigma_{i}\eta_{i}}W_{i+1}^{T}W_{i+1}-\frac{1}{\sigma_{i}}I" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>0.9</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{\sigma_{i}}I-\frac{0.9}{\sigma_{i}\eta_{i}}W_{i+1}^{T}W_{i+1}-\frac{1}{\sigma_{i}}I</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex48.m1" class="ltx_Math" alttext="\displaystyle\geq~" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\displaystyle\geq~</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex48.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{\sigma_{i}}I-\frac{0.9}{\sigma_{i}}I&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>0.9</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\sigma_{i}}I-\frac{0.9}{\sigma_{i}}I&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p33.4" class="ltx_p">where the last inequality uses <math id="A1.SS1.p33.m5" class="ltx_Math" alttext="W_{i+1}^{T}W_{i+1}\leq\eta_{i}I" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>≤</mo><mrow><msub><mi>η</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">W_{i+1}^{T}W_{i+1}\leq\eta_{i}I</annotation></semantics></math>.
Finally, <math id="A1.SS1.p33.m6" class="ltx_Math" alttext="\tilde{M}_{i}=T_{i}+c_{i}W_{i+1}^{T}W_{i+1}\geq T_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>≥</mo><msub><mi>T</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{M}_{i}=T_{i}+c_{i}W_{i+1}^{T}W_{i+1}\geq T_{i}&gt;0</annotation></semantics></math>.</p>
</div>
<div id="A1.SS1.p34" class="ltx_para ltx_noindent">
<p id="A1.SS1.p34.1" class="ltx_p">With (<a href="#A1.E53" title="In A.1 Proofs ‣ Appendix A Appendix ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>) being feasible for <math id="A1.SS1.p34.m1" class="ltx_Math" alttext="i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N-1}</annotation></semantics></math>, the LMI in (<a href="#S3.E14" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) is naturally
satisfied with <math id="A1.SS1.p34.m2" class="ltx_Math" alttext="\lambda_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{i}\geq 0</annotation></semantics></math> and <math id="A1.SS1.p34.m3" class="ltx_Math" alttext="c_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}&gt;0</annotation></semantics></math> because for <math id="A1.SS1.p34.m4" class="ltx_Math" alttext="i\in\mathbb{Z}_{N-2}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N-2}</annotation></semantics></math>,</p>
<table id="A1.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex49.m1" class="ltx_Math" alttext="\begin{bmatrix}\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}\lambda_{i}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&amp;\tilde{X}_{i-1}\end{bmatrix}=S_{i}+\begin{bmatrix}0&amp;0\\
0&amp;\lambda_{i+1}W_{i+1}^{T}D_{\bm{\alpha}^{i+1}}D_{\bm{\beta}^{i+1}}W_{i+1}\end{bmatrix}\geq S_{i}&gt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>=</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>+</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>≥</mo><msub><mi>S</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\begin{bmatrix}\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}\lambda_{i}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&amp;\tilde{X}_{i-1}\end{bmatrix}=S_{i}+\begin{bmatrix}0&amp;0\\
0&amp;\lambda_{i+1}W_{i+1}^{T}D_{\bm{\alpha}^{i+1}}D_{\bm{\beta}^{i+1}}W_{i+1}\end{bmatrix}\geq S_{i}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p34.2" class="ltx_p">and for <math id="A1.SS1.p34.m5" class="ltx_Math" alttext="i=N-1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=N-1</annotation></semantics></math>,</p>
<table id="A1.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex50.m1" class="ltx_Math" alttext="\begin{bmatrix}\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}\lambda_{i}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&amp;\tilde{X}_{i-1}\end{bmatrix}=S_{i}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>=</mo><msub><mi>S</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{bmatrix}\lambda_{i}I-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}\lambda_{i}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})&amp;\tilde{X}_{i-1}\end{bmatrix}=S_{i}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p35" class="ltx_para ltx_noindent">
<p id="A1.SS1.p35.1" class="ltx_p">Then we proceed to show that claims (i) and (ii) hold for the closed-form solution (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). Given that <math id="A1.SS1.p35.m1" class="ltx_Math" alttext="M_{i-1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i-1}&gt;0</annotation></semantics></math> at stage <math id="A1.SS1.p35.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) is well-defined and positive. So it suffices to show that using <math id="A1.SS1.p35.m3" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> as in (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">15</span></a>) always guarantees <math id="A1.SS1.p35.m5" class="ltx_Math" alttext="M_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i}&gt;0</annotation></semantics></math>, <math id="A1.SS1.p35.m6" class="ltx_Math" alttext="i\in\{0\}\cup\mathbb{Z}_{N-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>∪</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">i\in\{0\}\cup\mathbb{Z}_{N-1}.</annotation></semantics></math></p>
</div>
<div id="A1.SS1.p36" class="ltx_para ltx_noindent">
<p id="A1.SS1.p36.1" class="ltx_p">At stage <math id="A1.SS1.p36.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, recall that</p>
<table id="A1.Ex51" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex51X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex51X.m2" class="ltx_Math" alttext="\displaystyle M_{i}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\displaystyle M_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex51X.m3" class="ltx_Math" alttext="\displaystyle=\lambda_{i}I-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}X_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda_{i}I-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}X_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex51Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex51Xa.m2" class="ltx_Math" alttext="\displaystyle=\lambda_{i}I-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}M_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda_{i}I-\frac{1}{4}\lambda_{i}^{2}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}M_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p36.2" class="ltx_p">The second equality holds because <math id="A1.SS1.p36.m2" class="ltx_Math" alttext="D_{\bm{\alpha}^{i,\mathrm{adj}}}\bigotimes D_{\bm{\beta}^{i,\mathrm{adj}}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⨂</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D_{\bm{\alpha}^{i,\mathrm{adj}}}\bigotimes D_{\bm{\beta}^{i,\mathrm{adj}}}=0</annotation></semantics></math>.</p>
</div>
<div id="A1.SS1.p37" class="ltx_para ltx_noindent">
<p id="A1.SS1.p37.1" class="ltx_p">Let <math id="A1.SS1.p37.m1" class="ltx_Math" alttext="\bar{\sigma}_{i}=\sigma_{\max}\left((D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}M_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})\right)&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{\sigma}_{i}=\sigma_{\max}\left((D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}M_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})\right)&gt;0.</annotation></semantics></math>
For the closed-form solution (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">15</span></a>), <math id="A1.SS1.p37.m3" class="ltx_Math" alttext="\lambda_{i}=\frac{2}{\bar{\sigma}_{i}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>=</mo><mfrac><mn>2</mn><msub><mover accent="true"><mi>σ</mi><mo>¯</mo></mover><mi>i</mi></msub></mfrac><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{i}=\frac{2}{\bar{\sigma}_{i}}&gt;0</annotation></semantics></math>. By definition of <math id="A1.SS1.p37.m4" class="ltx_Math" alttext="\bar{\sigma_{i}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>σ</mi><mi>i</mi></msub><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\sigma_{i}}</annotation></semantics></math>, we have <math id="A1.SS1.p37.m5" class="ltx_Math" alttext="(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}M_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})\leq\bar{\sigma}_{i}I" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})W_{i}M_{i-1}^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i,\mathrm{adj}}}+D_{\bm{\beta}^{i,\mathrm{adj}}})\leq\bar{\sigma}_{i}I</annotation></semantics></math>. Therefore, <math id="A1.SS1.p37.m6" class="ltx_Math" alttext="M_{i}\geq\frac{2}{\bar{\sigma}_{i}}I-\frac{1}{\bar{\sigma}_{i}}I=\frac{1}{\bar{\sigma}_{i}}I&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>≥</mo><mrow><mrow><mfrac><mn>2</mn><msub><mover accent="true"><mi>σ</mi><mo>¯</mo></mover><mi>i</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><msub><mover accent="true"><mi>σ</mi><mo>¯</mo></mover><mi>i</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msub><mover accent="true"><mi>σ</mi><mo>¯</mo></mover><mi>i</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{i}\geq\frac{2}{\bar{\sigma}_{i}}I-\frac{1}{\bar{\sigma}_{i}}I=\frac{1}{\bar{\sigma}_{i}}I&gt;0.</annotation></semantics></math>
∎</p>
</div>
<div id="A1.SS1.p38" class="ltx_para ltx_noindent">
<p id="A1.SS1.p38.1" class="ltx_p"><span id="A1.SS1.p38.1.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#Thmtheorem8" title="Theorem 8. ‣ 3.5 Theoretical Guarantees and Mathematical Intuition ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a></span>.
Let <math id="A1.SS1.p38.m1" class="ltx_Math" alttext="\mathcal{Z}=\mathcal{B}(z_{c},\|\delta_{z}\|_{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>c</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>z</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}=\mathcal{B}(z_{c},\|\delta_{z}\|_{2})</annotation></semantics></math> be the input region. Consider any layer <math id="A1.SS1.p38.m2" class="ltx_Math" alttext="\textit{L}_{i},i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_italic">L</mtext><mi>i</mi></msub><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\textit{L}_{i},i\in\mathbb{Z}_{N-1}</annotation></semantics></math>. Given the validity of the Lipschitz constant <math id="A1.SS1.p38.m3" class="ltx_Math" alttext="\textbf{L}^{(i)}_{\bullet,l}" display="inline" intent=":literal"><semantics><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\textbf{L}^{(i)}_{\bullet,l}</annotation></semantics></math> for each <math id="A1.SS1.p38.m4" class="ltx_Math" alttext="l\in\mathbb{Z}_{d_{i-1}}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><msub><mi>ℤ</mi><msub><mi>d</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow><annotation encoding="application/x-tex">l\in\mathbb{Z}_{d_{i-1}}</annotation></semantics></math>, i.e., for any <math id="A1.SS1.p38.m5" class="ltx_Math" alttext="z_{1},z_{2}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><msub><mi>z</mi><mn>2</mn></msub></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">z_{1},z_{2}\in\mathcal{Z}</annotation></semantics></math>, the map from <math id="A1.SS1.p38.m6" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> to the <math id="A1.SS1.p38.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th component of <math id="A1.SS1.p38.m8" class="ltx_Math" alttext="z^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">z^{(i)}</annotation></semantics></math> satisfies</p>
<table id="A1.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex52.m1" class="ltx_Math" alttext="|z^{(i)}_{l}(z_{1})-z^{(i)}_{l}(z_{2})|\leq\textbf{L}^{(i)}_{\bullet,l}\|z_{1}-z_{2}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><msub><mi>z</mi><mn>2</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|z^{(i)}_{l}(z_{1})-z^{(i)}_{l}(z_{2})|\leq\textbf{L}^{(i)}_{\bullet,l}\|z_{1}-z_{2}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p38.2" class="ltx_p">In particular, taking <math id="A1.SS1.p38.m9" class="ltx_Math" alttext="z_{2}=z_{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>2</mn></msub><mo>=</mo><msub><mi>z</mi><mi>c</mi></msub></mrow><annotation encoding="application/x-tex">z_{2}=z_{c}</annotation></semantics></math> and arbitrary <math id="A1.SS1.p38.m10" class="ltx_Math" alttext="z_{1}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">z_{1}\in\mathcal{Z}</annotation></semantics></math>, and using the fact that <math id="A1.SS1.p38.m11" class="ltx_Math" alttext="\|z_{1}-z_{c}\|_{2}\leq\|\delta_{z}\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><msub><mi>z</mi><mi>c</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>z</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|z_{1}-z_{c}\|_{2}\leq\|\delta_{z}\|_{2}</annotation></semantics></math>, we have</p>
<table id="A1.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex53.m1" class="ltx_Math" alttext="|z^{(i)}_{l}(z)-z^{(i)}_{l}(z_{c})|\leq\textbf{L}^{(i)}_{\bullet,l}\|\delta_{z}\|_{2},\qquad\forall z\in\mathcal{Z}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>z</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>z</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|z^{(i)}_{l}(z)-z^{(i)}_{l}(z_{c})|\leq\textbf{L}^{(i)}_{\bullet,l}\|\delta_{z}\|_{2},\qquad\forall z\in\mathcal{Z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p38.3" class="ltx_p">Therefore, for each <math id="A1.SS1.p38.m12" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>,</p>
<table id="A1.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex54.m1" class="ltx_Math" alttext="z^{(i)}_{l}(z)\in\left[z^{(i)}_{l}(z_{c})-\textbf{L}^{(i)}_{\bullet,l}\|\delta_{z}\|_{2},\;z^{(i)}_{l}(z_{c})+\textbf{L}^{(i)}_{\bullet,l}\|\delta_{z}\|_{2}\right],\qquad\forall z\in\mathcal{Z}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo>[</mo><mrow><mrow><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>z</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mrow><msubsup><mi>z</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>z</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>z</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z^{(i)}_{l}(z)\in\left[z^{(i)}_{l}(z_{c})-\textbf{L}^{(i)}_{\bullet,l}\|\delta_{z}\|_{2},\;z^{(i)}_{l}(z_{c})+\textbf{L}^{(i)}_{\bullet,l}\|\delta_{z}\|_{2}\right],\qquad\forall z\in\mathcal{Z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p38.4" class="ltx_p">Thus, the region <math id="A1.SS1.p38.m13" class="ltx_Math" alttext="\mathcal{V}^{i}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathcal{V}^{i}</annotation></semantics></math> defined in Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is a valid enclosure for all <math id="A1.SS1.p38.m14" class="ltx_Math" alttext="v^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">v^{(i)}</annotation></semantics></math> over <math id="A1.SS1.p38.m15" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>. Next, by construction in Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the refined slope bounds are given by</p>
<table id="A1.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex55.m1" class="ltx_Math" alttext="\alpha^{i}_{l}=\inf_{v\in\mathcal{V}^{i}_{l}}\inf\partial\sigma(v),\qquad\beta^{i}_{l}=\sup_{v\in\mathcal{V}^{i}_{l}}\sup\partial\sigma(v)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mi>l</mi><mi>i</mi></msubsup><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em">inf</mo><mrow><mi>v</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>l</mi><mi>i</mi></msubsup></mrow></munder><mrow><mrow><mo lspace="0.0835em" movablelimits="false" rspace="0em">inf</mo><mo>∂</mo></mrow><mo>⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>β</mi><mi>l</mi><mi>i</mi></msubsup><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em">sup</mo><mrow><mi>v</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>l</mi><mi>i</mi></msubsup></mrow></munder><mrow><mrow><mo lspace="0.0835em" movablelimits="false" rspace="0em">sup</mo><mo>∂</mo></mrow><mo>⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha^{i}_{l}=\inf_{v\in\mathcal{V}^{i}_{l}}\inf\partial\sigma(v),\qquad\beta^{i}_{l}=\sup_{v\in\mathcal{V}^{i}_{l}}\sup\partial\sigma(v).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p38.5" class="ltx_p">Since <math id="A1.SS1.p38.m16" class="ltx_Math" alttext="v^{(i)}_{l}(z)\in\mathcal{V}^{i}_{l}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>v</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>l</mi><mi>i</mi></msubsup></mrow><annotation encoding="application/x-tex">v^{(i)}_{l}(z)\in\mathcal{V}^{i}_{l}</annotation></semantics></math> for all <math id="A1.SS1.p38.m17" class="ltx_Math" alttext="z\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">z\in\mathcal{Z}</annotation></semantics></math>, it follows that</p>
<table id="A1.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex56.m1" class="ltx_Math" alttext="\alpha^{i}_{l}\leq\inf\partial\sigma(v^{(i)}_{l}(z)),\qquad\beta^{i}_{l}\geq\sup\partial\sigma(v^{(i)}_{l}(z)),\qquad\forall z\in\mathcal{Z}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mi>l</mi><mi>i</mi></msubsup><mo rspace="0.1389em">≤</mo><mrow><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mo>∂</mo></mrow><mo>⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>v</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>β</mi><mi>l</mi><mi>i</mi></msubsup><mo rspace="0.1389em">≥</mo><mrow><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mo>∂</mo></mrow><mo>⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>v</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>z</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha^{i}_{l}\leq\inf\partial\sigma(v^{(i)}_{l}(z)),\qquad\beta^{i}_{l}\geq\sup\partial\sigma(v^{(i)}_{l}(z)),\qquad\forall z\in\mathcal{Z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p38.6" class="ltx_p">Thus, the refined slope bounds <math id="A1.SS1.p38.m18" class="ltx_Math" alttext="\bm{\alpha}^{i},\bm{\beta}^{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mi>i</mi></msup><mo>,</mo><msup><mi>𝜷</mi><mi>i</mi></msup></mrow><annotation encoding="application/x-tex">\bm{\alpha}^{i},\bm{\beta}^{i}</annotation></semantics></math> are valid for all <math id="A1.SS1.p38.m19" class="ltx_Math" alttext="z\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">z\in\mathcal{Z}</annotation></semantics></math>, as claimed.
∎</p>
</div>
<div id="A1.SS1.p39" class="ltx_para ltx_noindent">
<p id="A1.SS1.p39.1" class="ltx_p"><span id="A1.SS1.p39.1.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#Thmtheorem9" title="Theorem 9. ‣ 3.5 Theoretical Guarantees and Mathematical Intuition ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></span>.
Let <math id="A1.SS1.p39.m1" class="ltx_Math" alttext="z_{1}^{(i)}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">z_{1}^{(i)}</annotation></semantics></math>, <math id="A1.SS1.p39.m2" class="ltx_Math" alttext="z_{2}^{(i)}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">z_{2}^{(i)}</annotation></semantics></math> be the layer outputs for two arbitrary inputs, and define <math id="A1.SS1.p39.m3" class="ltx_Math" alttext="\Delta z^{(i)}=z_{1}^{(i)}-z_{2}^{(i)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><msubsup><mi>z</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>z</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta z^{(i)}=z_{1}^{(i)}-z_{2}^{(i)}</annotation></semantics></math>, <math id="A1.SS1.p39.m4" class="ltx_Math" alttext="\Delta v^{(i)}=v_{1}^{(i)}-v_{2}^{(i)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><msubsup><mi>v</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>v</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta v^{(i)}=v_{1}^{(i)}-v_{2}^{(i)}</annotation></semantics></math> for all <math id="A1.SS1.p39.m5" class="ltx_Math" alttext="i\in\{0\}\cup\mathbb{Z}_{N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>∪</mo><msub><mi>ℤ</mi><mi>N</mi></msub></mrow></mrow><annotation encoding="application/x-tex">i\in\{0\}\cup\mathbb{Z}_{N}</annotation></semantics></math>. We claim and prove by induction on the layer index <math id="A1.SS1.p39.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>:</p>
<ol id="A1.I2" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="A1.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I2.i1.p1.1" class="ltx_p"><math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="\sqrt{\sigma_{max}\left(\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)}(M_{i-1})^{-1}\right)}" display="inline" intent=":literal"><semantics><msqrt><mrow><msub><mi>σ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo>]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\sigma_{max}\left(\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)}(M_{i-1})^{-1}\right)}</annotation></semantics></math> are valid Lipschitz constants for <math id="A1.I2.i1.p1.m2" class="ltx_Math" alttext="\forall l\in\mathbb{Z}_{d_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">\forall l\in\mathbb{Z}_{d_{i}}</annotation></semantics></math> as defined in (<a href="#S3.E6" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>),</p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="A1.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A1.I2.i2.p1.1" class="ltx_p"><math id="A1.I2.i2.p1.m1" class="ltx_Math" alttext="X_{i-1}=M_{i-1}+W_{i}^{T}D_{\bm{\alpha}^{i}}\Lambda_{i}D_{\bm{\beta}^{i}}W_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">X_{i-1}=M_{i-1}+W_{i}^{T}D_{\bm{\alpha}^{i}}\Lambda_{i}D_{\bm{\beta}^{i}}W_{i}&gt;0</annotation></semantics></math>, and</p>
</div></li>
<li id="A1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="A1.I2.i3.p1" class="ltx_para">
<p id="A1.I2.i3.p1.1" class="ltx_p"><math id="A1.I2.i3.p1.m1" class="ltx_Math" alttext="M_{i}=\Lambda_{i}-\frac{1}{4}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i}=\Lambda_{i}-\frac{1}{4}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}&gt;0</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A1.SS1.p40" class="ltx_para ltx_noindent">
<p id="A1.SS1.p40.1" class="ltx_p">For the first layer (<math id="A1.SS1.p40.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>), we have</p>
<table id="A1.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex57.m1" class="ltx_Math" alttext="\Delta v^{(1)}=W_{1}\Delta z^{(0)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>=</mo><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta v^{(1)}=W_{1}\Delta z^{(0)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p40.2" class="ltx_p">For any neuron <math id="A1.SS1.p40.m2" class="ltx_Math" alttext="l\in\mathbb{Z}_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><msub><mi>ℤ</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">l\in\mathbb{Z}_{d_{1}}</annotation></semantics></math>, the <math id="A1.SS1.p40.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th entry is</p>
<table id="A1.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex58.m1" class="ltx_Math" alttext="\left(\Delta v^{(1)}\right)_{l}=(W_{1})_{(l,\bullet)}\Delta z^{(0)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><mi>l</mi></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\Delta v^{(1)}\right)_{l}=(W_{1})_{(l,\bullet)}\Delta z^{(0)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p40.3" class="ltx_p">By the Cauchy-Schwarz inequality,</p>
<table id="A1.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex59.m1" class="ltx_Math" alttext="\left|\left(\Delta v^{(1)}\right)_{l}\right|\leq\|(W_{1})_{(l,\bullet)}\|_{2}\,\|\Delta z^{(0)}\|_{2}=\sqrt{\sigma_{max}\left(\left[(W_{1})_{(l,\bullet)}\right]^{T}(W_{1})_{(l,\bullet)}\right)}\|\Delta z^{(0)}\|_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><msub><mrow><mo>(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo>)</mo></mrow><mi>l</mi></msub><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>=</mo><mrow><msqrt><mrow><msub><mi>σ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo>]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub></mrow><mo>)</mo></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\left(\Delta v^{(1)}\right)_{l}\right|\leq\|(W_{1})_{(l,\bullet)}\|_{2}\,\|\Delta z^{(0)}\|_{2}=\sqrt{\sigma_{max}\left(\left[(W_{1})_{(l,\bullet)}\right]^{T}(W_{1})_{(l,\bullet)}\right)}\|\Delta z^{(0)}\|_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p40.4" class="ltx_p">Since <math id="A1.SS1.p40.m4" class="ltx_Math" alttext="M_{0}=I" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>=</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">M_{0}=I</annotation></semantics></math>, the bound can be written equivalently as</p>
<table id="A1.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex60.m1" class="ltx_Math" alttext="\textbf{L}_{\bullet,l}^{(0,1)}=\sqrt{\sigma_{max}\left(\left[(W_{1})_{(l,\bullet)}\right]^{T}(W_{1})_{(l,\bullet)}(M_{0})^{-1}\right)}" display="block" intent=":literal"><semantics><mrow><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msqrt><mrow><msub><mi>σ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo>]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\textbf{L}_{\bullet,l}^{(0,1)}=\sqrt{\sigma_{max}\left(\left[(W_{1})_{(l,\bullet)}\right]^{T}(W_{1})_{(l,\bullet)}(M_{0})^{-1}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p40.5" class="ltx_p">From ECLipsE-Gen-Acc in (<a href="#S3.E13" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) at <math id="A1.SS1.p40.m5" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>, <math id="A1.SS1.p40.m6" class="ltx_Math" alttext="\Lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Lambda_{1}</annotation></semantics></math> satisfies</p>
<table id="A1.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex61.m1" class="ltx_Math" alttext="\begin{bmatrix}\Lambda_{1}-c_{1}W_{2}^{T}W_{2}&amp;\frac{1}{2}\Lambda_{1}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})W_{1}\\
\frac{1}{2}W_{1}^{T}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})\Lambda_{1}&amp;X_{0}\end{bmatrix}&gt;0,\Lambda_{1}\in\mathbb{D}_{+},\;c_{1}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo>−</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>2</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub></mrow></mrow></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>1</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></mrow></mtd><mtd><msub><mi>X</mi><mn>0</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo>∈</mo><msub><mi>𝔻</mi><mo>+</mo></msub></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{bmatrix}\Lambda_{1}-c_{1}W_{2}^{T}W_{2}&amp;\frac{1}{2}\Lambda_{1}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})W_{1}\\
\frac{1}{2}W_{1}^{T}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})\Lambda_{1}&amp;X_{0}\end{bmatrix}&gt;0,\Lambda_{1}\in\mathbb{D}_{+},\;c_{1}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p40.6" class="ltx_p">By Schur complement, this is equivalent to</p>
<table id="A1.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex62.m1" class="ltx_Math" alttext="X_{0}&gt;0,\quad\Lambda_{1}-c_{1}W_{2}^{T}W_{2}-\frac{1}{4}\Lambda_{1}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})W_{1}(X_{0})^{-1}W_{1}^{T}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})\Lambda_{1}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo>−</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>2</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>1</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X_{0}&gt;0,\quad\Lambda_{1}-c_{1}W_{2}^{T}W_{2}-\frac{1}{4}\Lambda_{1}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})W_{1}(X_{0})^{-1}W_{1}^{T}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})\Lambda_{1}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p40.7" class="ltx_p">Therefore, <math id="A1.SS1.p40.m7" class="ltx_Math" alttext="(X_{0})^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">(X_{0})^{-1}</annotation></semantics></math> is well-defined and with <math id="A1.SS1.p40.m8" class="ltx_Math" alttext="c_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{1}&gt;0</annotation></semantics></math>,</p>
<table id="A1.Ex63" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex63X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex63X.m2" class="ltx_Math" alttext="\displaystyle M_{1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle M_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex63X.m3" class="ltx_Math" alttext="\displaystyle=(\Lambda_{1}-c_{1}W_{2}^{T}W_{2}-\frac{1}{4}\Lambda_{1}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})W_{1}(X_{0})^{-1}W_{1}^{T}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})\Lambda_{1})+c_{1}W_{2}^{T}W_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo>−</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>2</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>1</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>2</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\Lambda_{1}-c_{1}W_{2}^{T}W_{2}-\frac{1}{4}\Lambda_{1}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})W_{1}(X_{0})^{-1}W_{1}^{T}(D_{\bm{\alpha}^{1}}+D_{\bm{\beta}^{1}})\Lambda_{1})+c_{1}W_{2}^{T}W_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex63Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex63Xa.m2" class="ltx_Math" alttext="\displaystyle&gt;c_{1}W_{2}^{T}W_{2}\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mn>2</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;c_{1}W_{2}^{T}W_{2}\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p41" class="ltx_para ltx_noindent">
<p id="A1.SS1.p41.1" class="ltx_p">Now by induction, assume that at layer <math id="A1.SS1.p41.m1" class="ltx_Math" alttext="\textit{L}_{i}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_italic">L</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textit{L}_{i}</annotation></semantics></math>, <math id="A1.SS1.p41.m2" class="ltx_Math" alttext="i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">i\in\mathbb{Z}_{N-1}</annotation></semantics></math>, we have <math id="A1.SS1.p41.m3" class="ltx_Math" alttext="X_{k}&gt;0,\ \forall k\in\mathbb{Z}_{i-2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>k</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">X_{k}&gt;0,\ \forall k\in\mathbb{Z}_{i-2}</annotation></semantics></math>, and <math id="A1.SS1.p41.m4" class="ltx_Math" alttext="M_{j}&gt;0,\ \forall j\in\mathbb{Z}_{i-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>M</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{j}&gt;0,\ \forall j\in\mathbb{Z}_{i-1}.</annotation></semantics></math></p>
</div>
<div id="A1.SS1.p42" class="ltx_para ltx_noindent">
<p id="A1.SS1.p42.1" class="ltx_p">By Theorem <a href="#Thmtheorem8" title="Theorem 8. ‣ 3.5 Theoretical Guarantees and Mathematical Intuition ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, <math id="A1.SS1.p42.m1" class="ltx_Math" alttext="\bm{\alpha}^{j},\bm{\beta}^{j}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜶</mi><mi>j</mi></msup><mo>,</mo><msup><mi>𝜷</mi><mi>j</mi></msup></mrow><annotation encoding="application/x-tex">\bm{\alpha}^{j},\bm{\beta}^{j}</annotation></semantics></math>, <math id="A1.SS1.p42.m2" class="ltx_Math" alttext="\forall j\in\mathbb{Z}_{i-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\forall j\in\mathbb{Z}_{i-1}</annotation></semantics></math>, are valid slope bounds. To show the validity of <math id="A1.SS1.p42.m3" class="ltx_Math" alttext="\textbf{L}_{\bullet,l}^{(0,i)}" display="inline" intent=":literal"><semantics><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\textbf{L}_{\bullet,l}^{(0,i)}</annotation></semantics></math>, by Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, it suffices to prove that there exists <math id="A1.SS1.p42.m4" class="ltx_Math" alttext="\tilde{\Lambda}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{\Lambda}_{j}</annotation></semantics></math>, <math id="A1.SS1.p42.m5" class="ltx_Math" alttext="j\in\mathbb{Z}_{i-1}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">j\in\mathbb{Z}_{i-1}</annotation></semantics></math> such that</p>
<table id="A1.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex64.m1" class="ltx_Math" alttext="\begin{bmatrix}\mathcal{P}_{1}&amp;\mathcal{R}_{2}&amp;0&amp;\cdots&amp;0\\
\mathcal{R}_{2}^{T}&amp;\mathcal{P}_{2}&amp;\mathcal{R}_{3}&amp;\cdots&amp;0\\
0&amp;\mathcal{R}_{3}^{T}&amp;\mathcal{P}_{3}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\vdots&amp;\ddots&amp;\mathcal{R}_{i}\\
0&amp;0&amp;0&amp;\mathcal{R}_{i}^{T}&amp;\mathcal{P}_{i}\end{bmatrix}&gt;0" display="block" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>1</mn></msub></mtd><mtd><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>2</mn></msub></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>2</mn><mi>T</mi></msubsup></mtd><mtd><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>2</mn></msub></mtd><mtd><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>3</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>3</mn><mi>T</mi></msubsup></mtd><mtd><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mn>3</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>i</mi><mi>T</mi></msubsup></mtd><mtd><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>i</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\begin{bmatrix}\mathcal{P}_{1}&amp;\mathcal{R}_{2}&amp;0&amp;\cdots&amp;0\\
\mathcal{R}_{2}^{T}&amp;\mathcal{P}_{2}&amp;\mathcal{R}_{3}&amp;\cdots&amp;0\\
0&amp;\mathcal{R}_{3}^{T}&amp;\mathcal{P}_{3}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\vdots&amp;\ddots&amp;\mathcal{R}_{i}\\
0&amp;0&amp;0&amp;\mathcal{R}_{i}^{T}&amp;\mathcal{P}_{i}\end{bmatrix}&gt;0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p42.2" class="ltx_p">where</p>
<table id="A1.Ex65" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex65X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex65X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{P}_{m}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{P}_{m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex65X.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\tilde{\Lambda}_{0}+W_{1}^{T}D_{\bm{\alpha}^{1}}\tilde{\Lambda}_{1}D_{\bm{\beta}^{1}}W_{1},&amp;m=1\\[8.61108pt]
\tilde{\Lambda}_{m-1}+W_{m}^{T}D_{\bm{\alpha}^{m}}\tilde{\Lambda}_{m}D_{\bm{\beta}^{m}}W_{m},&amp;2\leq m&lt;i\\[8.61108pt]
\tilde{\Lambda}_{i-1}-\tilde{F}\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)},&amp;m=i\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mn>0</mn></msub><mo>+</mo><mrow><msubsup><mi>W</mi><mn>1</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><msubsup><mi>W</mi><mi>m</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mi>m</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>m</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>m</mi></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>2</mn><mo>≤</mo><mi>m</mi><mo>&lt;</mo><mi>i</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo>]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>m</mi><mo>=</mo><mi>i</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\tilde{\Lambda}_{0}+W_{1}^{T}D_{\bm{\alpha}^{1}}\tilde{\Lambda}_{1}D_{\bm{\beta}^{1}}W_{1},&amp;m=1\\[8.61108pt]
\tilde{\Lambda}_{m-1}+W_{m}^{T}D_{\bm{\alpha}^{m}}\tilde{\Lambda}_{m}D_{\bm{\beta}^{m}}W_{m},&amp;2\leq m&lt;i\\[8.61108pt]
\tilde{\Lambda}_{i-1}-\tilde{F}\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)},&amp;m=i\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex65Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex65Xa.m2" class="ltx_Math" alttext="\displaystyle\mathcal{R}_{m}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>m</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{R}_{m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex65Xa.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}-\dfrac{1}{2}W_{m-1}^{T}(D_{\bm{\alpha}^{m-1}}+D_{\bm{\beta}^{m-1}})\tilde{\Lambda}_{m-1},&amp;2\leq m\leq i-1\\[8.61108pt]
-\dfrac{1}{2}W_{i-1}^{T}\left(D_{\bm{\alpha}^{i-1}}+D_{\bm{\beta}^{i-1}}\right)_{(l,l)}(\tilde{\Lambda}_{i-1})_{(l,l)},&amp;m=i\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>2</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></msub></mrow><mo>)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>m</mi><mo>=</mo><mi>i</mi></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}-\dfrac{1}{2}W_{m-1}^{T}(D_{\bm{\alpha}^{m-1}}+D_{\bm{\beta}^{m-1}})\tilde{\Lambda}_{m-1},&amp;2\leq m\leq i-1\\[8.61108pt]
-\dfrac{1}{2}W_{i-1}^{T}\left(D_{\bm{\alpha}^{i-1}}+D_{\bm{\beta}^{i-1}}\right)_{(l,l)}(\tilde{\Lambda}_{i-1})_{(l,l)},&amp;m=i\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p42.3" class="ltx_p">with</p>
<table id="A1.E55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E55.m1" class="ltx_Math" alttext="\tilde{F}=\frac{1}{\sigma_{\max}\left(\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)}(M_{i-1})^{-1}\right)}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>F</mi><mo>~</mo></mover><mo>=</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo>]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{F}=\frac{1}{\sigma_{\max}\left(\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)}(M_{i-1})^{-1}\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p43" class="ltx_para ltx_noindent">
<p id="A1.SS1.p43.1" class="ltx_p">According to Theorem <a href="#Thmtheorem4" title="Theorem 4. ‣ 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, it is equivalent to show that</p>
<table id="A1.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex66.m1" class="ltx_Math" alttext="\tilde{X}_{k}&gt;0,\quad\forall k\in\mathbb{Z}_{i-2},\qquad\tilde{X}_{i-1}-\tilde{F}(W_{i})_{(l,\bullet)}^{T}(W_{i})_{(l,\bullet)}&gt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>k</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{X}_{k}&gt;0,\quad\forall k\in\mathbb{Z}_{i-2},\qquad\tilde{X}_{i-1}-\tilde{F}(W_{i})_{(l,\bullet)}^{T}(W_{i})_{(l,\bullet)}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p43.2" class="ltx_p">where</p>
<table id="A1.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex67.m1" class="ltx_Math" alttext="\displaystyle\tilde{X}_{k}=\begin{cases}I+W_{1}^{T}D_{\bm{\alpha}^{1}}\tilde{\Lambda}_{i}D_{\bm{\beta}^{1}}W_{1}&amp;k=0\\
\tilde{\Lambda}_{k}-\frac{1}{4}\tilde{\Lambda}_{k}(D_{\bm{\alpha}^{k}}+D_{\bm{\beta}^{k}})W_{k}(X_{k-1})^{-1}W_{k}^{T}(D_{\bm{\alpha}^{k}}+D_{\bm{\beta}^{k}})\tilde{\Lambda}_{k}+W_{i+1}^{T}D_{\bm{\alpha}^{i+1}}\tilde{\Lambda}_{i+1}D_{\bm{\beta}^{i+1}}W_{i+1}\quad&amp;k\in\mathbb{Z}_{i-2}\\
\tilde{\Lambda}_{i-1}-\frac{1}{4}\tilde{\Lambda}_{i-1}(D_{\bm{\alpha}^{i-1}}+D_{\bm{\beta}^{i-1}})W_{i-1}(X_{i-2})^{-1}W_{i-1}^{T}(D_{\bm{\alpha}^{i-1}}+D_{\bm{\beta}^{i-1}})\tilde{\Lambda}_{i-1}\quad&amp;k=i-1\end{cases}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mi>k</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>I</mi><mo>+</mo><mrow><msubsup><mi>W</mi><mn>1</mn><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mn>1</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>1</mn></msub></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>k</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>k</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>k</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>k</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>k</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>k</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>k</mi></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>k</mi><mo>=</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{X}_{k}=\begin{cases}I+W_{1}^{T}D_{\bm{\alpha}^{1}}\tilde{\Lambda}_{i}D_{\bm{\beta}^{1}}W_{1}&amp;k=0\\
\tilde{\Lambda}_{k}-\frac{1}{4}\tilde{\Lambda}_{k}(D_{\bm{\alpha}^{k}}+D_{\bm{\beta}^{k}})W_{k}(X_{k-1})^{-1}W_{k}^{T}(D_{\bm{\alpha}^{k}}+D_{\bm{\beta}^{k}})\tilde{\Lambda}_{k}+W_{i+1}^{T}D_{\bm{\alpha}^{i+1}}\tilde{\Lambda}_{i+1}D_{\bm{\beta}^{i+1}}W_{i+1}\quad&amp;k\in\mathbb{Z}_{i-2}\\
\tilde{\Lambda}_{i-1}-\frac{1}{4}\tilde{\Lambda}_{i-1}(D_{\bm{\alpha}^{i-1}}+D_{\bm{\beta}^{i-1}})W_{i-1}(X_{i-2})^{-1}W_{i-1}^{T}(D_{\bm{\alpha}^{i-1}}+D_{\bm{\beta}^{i-1}})\tilde{\Lambda}_{i-1}\quad&amp;k=i-1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p44" class="ltx_para ltx_noindent">
<p id="A1.SS1.p44.1" class="ltx_p">Let <math id="A1.SS1.p44.m1" class="ltx_Math" alttext="\tilde{\Lambda}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{\Lambda}_{j}</annotation></semantics></math>, <math id="A1.SS1.p44.m2" class="ltx_Math" alttext="j\in\mathbb{Z}_{i-1}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">j\in\mathbb{Z}_{i-1}</annotation></semantics></math>, be decided according to Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> from the previous layer, that is, <math id="A1.SS1.p44.m3" class="ltx_Math" alttext="\tilde{\Lambda}_{j}=\Lambda_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>j</mi></msub><mo>=</mo><msub><mi mathvariant="normal">Λ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\Lambda}_{j}=\Lambda_{j}</annotation></semantics></math>, <math id="A1.SS1.p44.m4" class="ltx_Math" alttext="j\in\mathbb{Z}_{i-1}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">j\in\mathbb{Z}_{i-1}</annotation></semantics></math>.
Then <math id="A1.SS1.p44.m5" class="ltx_Math" alttext="\tilde{X}_{k}=X_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mi>k</mi></msub><mo>=</mo><msub><mi>X</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{X}_{k}=X_{k}</annotation></semantics></math>, <math id="A1.SS1.p44.m6" class="ltx_Math" alttext="k\in\mathbb{Z}_{i-2}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}_{i-2}</annotation></semantics></math> and <math id="A1.SS1.p44.m7" class="ltx_Math" alttext="\tilde{X}_{i-1}=M_{i-1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{X}_{i-1}=M_{i-1}</annotation></semantics></math>. Then the following statements hold:</p>
<ol id="A1.I3" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A1.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I3.i1.p1.1" class="ltx_p">(<a href="#A1.E55" title="In A.1 Proofs ‣ Appendix A Appendix ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>) is well-defined because by induction, <math id="A1.I3.i1.p1.m1" class="ltx_Math" alttext="M_{i-1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M_{i-1}&gt;0</annotation></semantics></math>,</p>
</div></li>
<li id="A1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="A1.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="A1.I3.i2.p1.1" class="ltx_p">by induction, <math id="A1.I3.i2.p1.m1" class="ltx_Math" alttext="\tilde{X}_{k}=X_{k}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mi>k</mi></msub><mo>=</mo><msub><mi>X</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{X}_{k}=X_{k}&gt;0</annotation></semantics></math>, <math id="A1.I3.i2.p1.m2" class="ltx_Math" alttext="k\in\mathbb{Z}_{i-2}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>i</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}_{i-2}</annotation></semantics></math>, and</p>
</div></li>
<li id="A1.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="A1.I3.i3.p1" class="ltx_para">
<p id="A1.I3.i3.p1.1" class="ltx_p">with <math id="A1.I3.i3.p1.m1" class="ltx_Math" alttext="\tilde{F}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>F</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{F}</annotation></semantics></math> from (<a href="#A1.E55" title="In A.1 Proofs ‣ Appendix A Appendix ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>), <math id="A1.I3.i3.p1.m2" class="ltx_Math" alttext="\tilde{X}_{i-1}-\tilde{F}(W_{i})_{(l,\bullet)}^{T}(W_{i})_{(l,\bullet)}=M_{i-1}-\tilde{F}(W_{i})_{(l,\bullet)}^{T}(W_{i})_{(l,\bullet)}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>=</mo><mrow><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><mover accent="true"><mi>F</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tilde{X}_{i-1}-\tilde{F}(W_{i})_{(l,\bullet)}^{T}(W_{i})_{(l,\bullet)}=M_{i-1}-\tilde{F}(W_{i})_{(l,\bullet)}^{T}(W_{i})_{(l,\bullet)}&gt;0</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A1.SS1.p45" class="ltx_para ltx_noindent">
<p id="A1.SS1.p45.1" class="ltx_p">Therefore, <math id="A1.SS1.p45.m1" class="ltx_Math" alttext="\sqrt{\sigma_{max}\left(\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)}(M_{i-1})^{-1}\right)}" display="inline" intent=":literal"><semantics><msqrt><mrow><msub><mi>σ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>[</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo>]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\sigma_{max}\left(\left[(W_{i})_{(l,\bullet)}\right]^{T}(W_{i})_{(l,\bullet)}(M_{i-1})^{-1}\right)}</annotation></semantics></math> are valid Lipschitz constants for <math id="A1.SS1.p45.m2" class="ltx_Math" alttext="\forall l\in\mathbb{Z}_{d_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">\forall l\in\mathbb{Z}_{d_{i}}</annotation></semantics></math> as in (<a href="#S3.E6" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>).</p>
</div>
<div id="A1.SS1.p46" class="ltx_para ltx_noindent">
<p id="A1.SS1.p46.1" class="ltx_p">Similarly,
the ECLipsE-Gen series of algorithms gives <math id="A1.SS1.p46.m1" class="ltx_Math" alttext="\Lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Lambda_{i}</annotation></semantics></math> that satisfy</p>
<table id="A1.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex68.m1" class="ltx_Math" alttext="\begin{bmatrix}\Lambda_{i}-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}&amp;X_{i-1}\end{bmatrix}&gt;0,\Lambda_{i}\in\mathbb{D}_{+}\;c_{i}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mtd><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub></mrow></mtd></mtr><mtr><mtd><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub></mrow></mtd><mtd><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>∈</mo><mrow><msub><mi>𝔻</mi><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\begin{bmatrix}\Lambda_{i}-c_{i}W_{i+1}^{T}W_{i+1}&amp;\frac{1}{2}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}\\
\frac{1}{2}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}&amp;X_{i-1}\end{bmatrix}&gt;0,\Lambda_{i}\in\mathbb{D}_{+}\;c_{i}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p46.2" class="ltx_p">By Schur complement, this is equivalent to</p>
<table id="A1.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex69.m1" class="ltx_Math" alttext="X_{i-1}&gt;0,\quad\Lambda_{i}-c_{i}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X_{i-1}&gt;0,\quad\Lambda_{i}-c_{i}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p46.3" class="ltx_p">Therefore, <math id="A1.SS1.p46.m2" class="ltx_Math" alttext="(X_{i-1})^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">(X_{i-1})^{-1}</annotation></semantics></math> is well-defined and with <math id="A1.SS1.p46.m3" class="ltx_Math" alttext="c_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}&gt;0</annotation></semantics></math>,</p>
<table id="A1.Ex70" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex70X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex70X.m2" class="ltx_Math" alttext="\displaystyle M_{i}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\displaystyle M_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex70X.m3" class="ltx_Math" alttext="\displaystyle=(\Lambda_{i}-c_{i}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i})+c_{i}W_{i+1}^{T}W_{i+1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>−</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>i</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><mo>+</mo><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\Lambda_{i}-c_{i}W_{i+1}^{T}W_{i+1}-\frac{1}{4}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})W_{i}(X_{i-1})^{-1}W_{i}^{T}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Lambda_{i})+c_{i}W_{i+1}^{T}W_{i+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex70Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex70Xa.m2" class="ltx_Math" alttext="\displaystyle&gt;c_{i}W_{i+1}^{T}W_{i+1}\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;c_{i}W_{i+1}^{T}W_{i+1}\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p46.4" class="ltx_p">This completes the proof of claims (i)-(iii). Proceeding, by Proposition <a href="#Thmproposition4" title="Proposition 4. ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> and Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <math id="A1.SS1.p46.m4" class="ltx_Math" alttext="\textbf{L}_{\bullet,l}^{(0,i)}" display="inline" intent=":literal"><semantics><msubsup><mtext class="ltx_mathvariant_bold">L</mtext><mrow><mo rspace="0em">∙</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\textbf{L}_{\bullet,l}^{(0,i)}</annotation></semantics></math> produced by Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is a strict upper bound for the local Lipschitz constant of the <math id="A1.SS1.p46.m5" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th neuron on layer <math id="A1.SS1.p46.m6" class="ltx_Math" alttext="\textit{L}_{i}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_italic">L</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textit{L}_{i}</annotation></semantics></math>, <math id="A1.SS1.p46.m7" class="ltx_Math" alttext="l\in\mathbb{Z}_{d_{i}},i\in\mathbb{Z}_{N-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>∈</mo><msub><mi>ℤ</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">l\in\mathbb{Z}_{d_{i}},i\in\mathbb{Z}_{N-1}</annotation></semantics></math>.</p>
</div>
<div id="A1.SS1.p47" class="ltx_para ltx_noindent">
<p id="A1.SS1.p47.1" class="ltx_p">For the final local Lipschitz constant <span id="A1.SS1.p47.1.1" class="ltx_text ltx_markedasmath ltx_font_bold">L</span> estimated by Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.3 ECLipsE-Gen-Local: Scalable and Accurate Algorithm for Local Lipschitz Estimates ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the proof follows identically to the neuron-wise case above, except that the final matrix inequality involves <math id="A1.SS1.p47.m2" class="ltx_Math" alttext="W_{N}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>N</mi></msub><annotation encoding="application/x-tex">W_{N}</annotation></semantics></math> instead of <math id="A1.SS1.p47.m3" class="ltx_Math" alttext="(W_{N})_{(l,\bullet)}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">(W_{N})_{(l,\bullet)}</annotation></semantics></math>. With <math id="A1.SS1.p47.m4" class="ltx_Math" alttext="F=1/\sigma_{\max}\left(W_{N}(M_{N-1})^{-1}W_{N}^{T}\right)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mrow><mn>1</mn><mo>/</mo><msub><mi>σ</mi><mi>max</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>N</mi><mi>T</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=1/\sigma_{\max}\left(W_{N}(M_{N-1})^{-1}W_{N}^{T}\right)</annotation></semantics></math>, we obtain <math id="A1.SS1.p47.m5" class="ltx_Math" alttext="\mathbf{L}=\sqrt{1/F}" display="inline" intent=":literal"><semantics><mrow><mi>𝐋</mi><mo>=</mo><msqrt><mrow><mn>1</mn><mo>/</mo><mi>F</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\mathbf{L}=\sqrt{1/F}</annotation></semantics></math> to be a valid Lipschitz constant (strict upper bound) for the entire network.
∎</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Algorithm</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p">We present the practical algorithm that enhances ECLipsE-Gen-Local with acceleration and stability here.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Enhanced ECLipsE-Gen-Local with Acceleration and Numerical Stability</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg2.l1.3" class="ltx_text ltx_font_bold">Input:</span> Weights <math id="alg2.l1.m1" class="ltx_Math" alttext="\{W_{i}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{W_{i}\}_{i=1}^{N}</annotation></semantics></math>, biases <math id="alg2.l1.m2" class="ltx_Math" alttext="\{b_{i}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>b</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{b_{i}\}_{i=1}^{N}</annotation></semantics></math>; activation function <math id="alg2.l1.m3" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>; input region <math id="alg2.l1.m4" class="ltx_Math" alttext="\mathcal{Z}=\mathcal{B}(z_{c},\delta_{z})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒵</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>c</mi></msub><mo>,</mo><msub><mi>δ</mi><mi>z</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Z}=\mathcal{B}(z_{c},\delta_{z})</annotation></semantics></math>; large scalar <math id="alg2.l1.m5" class="ltx_Math" alttext="Cap&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Cap&gt;0</annotation></semantics></math> for numerical upper bound; variant <math id="alg2.l1.m6" class="ltx_Math" alttext="\textsc{Algo}\in\{\texttt{Acc},\texttt{Fast},\texttt{CF}\}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Algo</mtext><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mtext class="ltx_mathvariant_monospace">Acc</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">Fast</mtext><mo>,</mo><mtext class="ltx_mathvariant_monospace">CF</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Algo}\in\{\texttt{Acc},\texttt{Fast},\texttt{CF}\}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg2.l2.3" class="ltx_text ltx_font_bold">Output:</span> Local Lipschitz estimate <math id="alg2.l2.m1" class="ltx_Math" alttext="\mathbf{L}" display="inline" intent=":literal"><semantics><mi>𝐋</mi><annotation encoding="application/x-tex">\mathbf{L}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
