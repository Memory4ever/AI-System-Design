<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex42X.m3" class="ltx_Math" alttext="\displaystyle\triangleq[(x)_{\mathcal{J}_{i}}]^{T}(\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}(x)_{\mathcal{J}_{i}}+[(x)_{\mathcal{M}_{i}}]^{T}(\Lambda_{i})_{(\mathcal{M}_{i},\mathcal{M}_{i})}(x)_{\mathcal{M}_{i}}+y^{T}M_{i-1}y" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≜</mo><mrow><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></msub></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">[</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub></msub><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub></msub></mrow><mo>+</mo><mrow><msup><mi>y</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\triangleq[(x)_{\mathcal{J}_{i}}]^{T}(\Lambda_{i})_{(\mathcal{J}_{i},\mathcal{J}_{i})}(x)_{\mathcal{J}_{i}}+[(x)_{\mathcal{M}_{i}}]^{T}(\Lambda_{i})_{(\mathcal{M}_{i},\mathcal{M}_{i})}(x)_{\mathcal{M}_{i}}+y^{T}M_{i-1}y</annotation></semantics></math></td>
