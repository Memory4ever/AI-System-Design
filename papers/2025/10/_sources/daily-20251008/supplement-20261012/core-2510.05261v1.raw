              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
               Obtain <math id="alg1.l22.m1" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math> via (<a href="#S3.E15" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) using <math id="alg1.l22.m2" class="ltx_Math" alttext="\bm{\alpha}^{i,\mathrm{adj}}" display="inline" intent=":literal"><semantics><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><annotation encoding="application/x-tex">\bm{\alpha}^{i,\mathrm{adj}}</annotation></semantics></math> and <math id="alg1.l22.m3" class="ltx_Math" alttext="\bm{\beta}^{i,\mathrm{adj}}" display="inline" intent=":literal"><semantics><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><annotation encoding="application/x-tex">\bm{\beta}^{i,\mathrm{adj}}</annotation></semantics></math>

</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
               Set <math id="alg1.l23.m1" class="ltx_Math" alttext="\Lambda_{i}\leftarrow\lambda_{i}I" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{i}\leftarrow\lambda_{i}I</annotation></semantics></math>

</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
               Compute <math id="alg1.l24.m1" class="ltx_Math" alttext="M_{i}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>i</mi></msub><annotation encoding="application/x-tex">M_{i}</annotation></semantics></math> as in (<a href="#S3.E17" title="In Proposition 1. ‣ 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) using <math id="alg1.l24.m2" class="ltx_Math" alttext="{\Lambda}_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\Lambda}_{i}</annotation></semantics></math>

</div>
