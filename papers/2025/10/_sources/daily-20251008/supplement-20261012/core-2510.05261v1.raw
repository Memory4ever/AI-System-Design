<br class="ltx_break">Model  <math id="A1.SS3.SSS4.p62.m1" class="ltx_Math" alttext="r=1/2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">r=1/2</annotation></semantics></math>  <math id="A1.SS3.SSS4.p62.m2" class="ltx_Math" alttext="r=1/2^{2}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msup><mn>2</mn><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">r=1/2^{2}</annotation></semantics></math>  <math id="A1.SS3.SSS4.p62.m3" class="ltx_Math" alttext="r=1/2^{3}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msup><mn>2</mn><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">r=1/2^{3}</annotation></semantics></math>  <math id="A1.SS3.SSS4.p62.m4" class="ltx_Math" alttext="r=1/2^{4}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msup><mn>2</mn><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">r=1/2^{4}</annotation></semantics></math>  <math id="A1.SS3.SSS4.p62.m5" class="ltx_Math" alttext="r=1/2^{5}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msup><mn>2</mn><mn>5</mn></msup></mrow></mrow><annotation encoding="application/x-tex">r=1/2^{5}</annotation></semantics></math>  <math id="A1.SS3.SSS4.p62.m6" class="ltx_Math" alttext="r=1/2^{6}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msup><mn>2</mn><mn>6</mn></msup></mrow></mrow><annotation encoding="application/x-tex">r=1/2^{6}</annotation></semantics></math>  <math id="A1.SS3.SSS4.p62.m7" class="ltx_Math" alttext="r=1/2^{7}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msup><mn>2</mn><mn>7</mn></msup></mrow></mrow><annotation en