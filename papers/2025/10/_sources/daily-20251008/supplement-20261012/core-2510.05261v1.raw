            <math id="alg4.l4.m1" class="ltx_Math" alttext="\bar{\lambda}_{i}\leftarrow\min\{Cap,\bar{\lambda}_{i}\}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\lambda}_{i}\leftarrow\min\{Cap,\bar{\lambda}_{i}\}</annotation></semantics></math>

</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            Set <math id="alg4.l5.m1" class="ltx_Math" alttext="\bar{\Lambda}_{i}\leftarrow\bar{\lambda}_{i}I" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mover accent="true"><mi>λ</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">\bar{\Lambda}_{i}\leftarrow\bar{\lambda}_{i}I</annotation></semantics></math>

</div>
