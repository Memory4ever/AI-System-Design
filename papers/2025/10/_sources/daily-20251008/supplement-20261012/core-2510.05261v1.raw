</div>
<div id="alg5.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg5.l3.3" class="ltx_text ltx_font_bold">Assert</span> <math id="alg5.l3.m1" class="ltx_Math" alttext="\bm{\alpha}^{i}\otimes\bm{\beta}^{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝜶</mi><mi>i</mi></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>𝜷</mi><mi>i</mi></msup></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bm{\alpha}^{i}\otimes\bm{\beta}^{i}\geq 0</annotation></semantics></math>

</div>
<div id="alg5.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
