<div id="alg2.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
            Using (<a href="#S3.E18" title="In 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>), compute final <math id="alg2.l24.m1" class="ltx_Math" alttext="\textbf{L}=\sqrt{1/F}=\sqrt{\sigma_{max}\left(W_{N}(X_{N-1})^{-1}W_{N}^{T}\right)}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">L</mtext><mo>=</mo><msqrt><mrow><mn>1</mn><mo>/</mo><mi>F</mi></mrow></msqrt><mo>=</mo><msqrt><mrow><msub><mi>σ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>N</mi><mi>T</mi></msubsup></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\textbf{L}=\sqrt{1/F}=\sqrt{\sigma_{max}\left(W_{N}(X_{N-1})^{-1}W_{N}^{T}\right)}</annotation></semantics></math> with <math id="alg2.l24.m2" class="ltx_Math" alttext="X_{N-1}=M_{N-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>M</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">X_{N-1}=M_{N-1}</annotation></semantics></math>
</div>
<div id="alg2.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
            <span id="alg2.l25.3" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l25.m1" class="ltx_Math" alttext="\mathbf{L}" display="inline" intent=":literal"><semantics><mi>𝐋</mi><annotation encoding="application/x-tex">\mathbf{L}</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.4" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Procedure <span id="alg3.5" class="ltx_text ltx_font_typewriter">Acc</span>: Obtain <math id="alg3.m2" class="ltx_Math" alttext="\Lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Lambda_{i}</annotation></semantics></math></figcaption>
<div id="alg3.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg3.l1.3" class="ltx_text ltx_font_bold">Input:</span> <math id="alg3.l1.m1" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math>, <math id="alg3.l1.m2" class="ltx_Math" alttext="M_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">M_{i-1}</annotation></semantics></math>, <math id="alg3.l1.m3" class="ltx_Math" alttext="D_{\bm{\alpha}^{i}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><annotation encoding="application/x-tex">D_{\bm{\alpha}^{i}}</annotation></semantics></math>, <math id="alg3.l1.m4" class="ltx_Math" alttext="D_{\bm{\beta}^{i}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub><annotation encoding="application/x-tex">D_{\bm{\beta}^{i}}</annotation></semantics></math>, index sets <math id="alg3.l1.m5" class="ltx_Math" alttext="\mathcal{J}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{J}_{i}</annotation></semantics></math>, <math id="alg3.l1.m6" class="ltx_Math" alttext="\mathcal{M}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{i}</annotation></semantics></math>, large scalar <math id="alg3.l1.m7" class="ltx_Math" alttext="Cap&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Cap&gt;0</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg3.l2.3" class="ltx_text ltx_font_bold">Output:</span> <math id="alg3.l2.m1" class="ltx_Math" alttext="(\Lambda_{i},c_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Lambda_{i},c_{i})</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            Solve (<a href="#S3.E30" title="In 3.4.2 Numerical Instability in Degenerate Slope Bounds ‣ 3.4 Acceleration and Stability Safeguards ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) on <math id="alg3.l3.m1" class="ltx_Math" alttext="\mathcal{M}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{i}</annotation></semantics></math> to get <math id="alg3.l3.m2" class="ltx_Math" alttext="(\Lambda_{i})_{(\mathcal{M}_{i},\mathcal{M}_{i})}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">(\Lambda_{i})_{(\mathcal{M}_{i},\mathcal{M}_{i})}</annotation></semantics></math> and <math id="alg3.l3.m3" class="ltx_Math" alttext="c_{i}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>i</mi></msub><annotation encoding="application/x-tex">c_{i}</annotation></semantics></math>

</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            Set <math id="alg3.l4.m1" class="ltx_Math" alttext="(\Lambda_{i})_{j,j}\leftarrow\frac{l_{i}}{|\mathcal{M}_{i}|}\sum_{m\in\mathcal{M}_{i}}(\Lambda_{i})_{(m,m)}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mfrac><msub><mi>l</mi><mi>i</mi></msub><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∑</mo><mrow><mi>m</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">(\Lambda_{i})_{j,j}\leftarrow\frac{l_{i}}{|\mathcal{M}_{i}|}\sum_{m\in\mathcal{M}_{i}}(\Lambda_{i})_{(m,m)}</annotation></semantics></math> for all <math id="alg3.l4.m2" class="ltx_Math" alttext="j\in\mathcal{J}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">j\in\mathcal{J}_{i}</annotation></semantics></math>   (cf. <a href="#S3.E31" title="In 3.4.2 Numerical Instability in Degenerate Slope Bounds ‣ 3.4 Acceleration and Stability Safeguards ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>)

</div>
<div id="alg3.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            <math id="alg3.l5.m1" class="ltx_Math" alttext="(\Lambda_{i})_{j,j}\leftarrow\min\{Cap,(\Lambda_{i})_{j,j}\}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\Lambda_{i})_{j,j}\leftarrow\min\{Cap,(\Lambda_{i})_{j,j}\}</annotation></semantics></math> for all <math id="alg3.l5.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>

</div>
<div id="alg3.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            Compute <math id="alg3.l6.m1" class="ltx_Math" alttext="X_{i}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>i</mi></msub><annotation encoding="application/x-tex">X_{i}</annotation></semantics></math> as in (<a href="#S3.E10" title="In Theorem 4. ‣ 3.1 SDP-based Lipschitz Estimates with General Slope Bounds and Arbitrary Input-Output Indices ‣ 3 Methodology ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) using <math id="alg3.l6.m2" class="ltx_Math" alttext="\Lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Lambda_{i}</annotation></semantics></math>

</div>
<div id="alg3.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg3.l7.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l7.m1" class="ltx_Math" alttext="X_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">X_{i}&gt;0</annotation></semantics></math> <span id="alg3.l7.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <span id="alg3.l8.3" class="ltx_text ltx_font_bold">return</span> <math id="alg3.l8.m1" class="ltx_Math" alttext="(\Lambda_{i},c_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Lambda_{i},c_{i})</annotation></semantics></math>

</div>
<div id="alg3.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
            <span id="alg3.l9.3" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg3.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
              <math id="alg3.l10.m1" class="ltx_Math" alttext="(\Lambda_{i}^{\mathrm{fast}},c_{i}^{\mathrm{fast}})\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mi>fast</mi></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>i</mi><mi>fast</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">(\Lambda_{i}^{\mathrm{fast}},c_{i}^{\mathrm{fast}})\leftarrow</annotation></semantics></math> <span id="alg3.l10.3" class="ltx_text ltx_font_bold">Algorithm</span> <a href="#alg4" title="Algorithm 4 ‣ A.2 Algorithm ‣ Appendix A Appendix ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>

</div>
<div id="alg3.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              <math id="alg3.l11.m1" class="ltx_Math" alttext="(\Lambda_{i}^{\mathrm{cf}},c_{i}^{\mathrm{cf}})\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mi>cf</mi></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>i</mi><mi>cf</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">(\Lambda_{i}^{\mathrm{cf}},c_{i}^{\mathrm{cf}})\leftarrow</annotation></semantics></math> <span id="alg3.l11.3" class="ltx_text ltx_font_bold">Algorithm</span> <a href="#alg5" title="Algorithm 5 ‣ A.2 Algorithm ‣ Appendix A Appendix ‣ ECLipsE-Gen-Local: Efficient Compositional Local Lipschitz Estimates for Deep Neural Networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>

</div>
<div id="alg3.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <span id="alg3.l12.3" class="ltx_text ltx_font_bold">return</span> the pair with larger <math id="alg3.l12.m1" class="ltx_Math" alttext="c_{i}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>i</mi></msub><annotation encoding="application/x-tex">c_{i}</annotation></semantics></math> among <math id="alg3.l12.m2" class="ltx_Math" alttext="\{(\Lambda_{i}^{\mathrm{fast}},c_{i}^{\mathrm{fast}}),\,(\Lambda_{i}^{\mathrm{cf}},c_{i}^{\mathrm{cf}})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mi>fast</mi></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>i</mi><mi>fast</mi></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.337em">,</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>i</mi><mi>cf</mi></msubsup><mo>,</mo><msubsup><mi>c</mi><mi>i</mi><mi>cf</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(\Lambda_{i}^{\mathrm{fast}},c_{i}^{\mathrm{fast}}),\,(\Lambda_{i}^{\mathrm{cf}},c_{i}^{\mathrm{cf}})\}</annotation></semantics></math>

</div>
<div id="alg3.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
            <span id="alg3.l13.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l13.4" class="ltx_text ltx_font_bold">if</span>
</div>
</div>
</figure>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.4" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Procedure <span id="alg4.5" class="ltx_text ltx_font_typewriter">Fast</span>: Obtain <math id="alg4.m2" class="ltx_Math" alttext="\Lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Lambda_{i}</annotation></semantics></math></figcaption>
<div id="alg4.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg4.l1.3" class="ltx_text ltx_font_bold">Input:</span> <math id="alg4.l1.m1" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math>, <math id="alg4.l1.m2" class="ltx_Math" alttext="M_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">M_{i-1}</annotation></semantics></math>, <math id="alg4.l1.m3" class="ltx_Math" alttext="D_{\bm{\alpha}^{i}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msup><mi>𝜶</mi><mi>i</mi></msup></msub><annotation encoding="application/x-tex">D_{\bm{\alpha}^{i}}</annotation></semantics></math>, <math id="alg4.l1.m4" class="ltx_Math" alttext="D_{\bm{\beta}^{i}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msup><mi>𝜷</mi><mi>i</mi></msup></msub><annotation encoding="application/x-tex">D_{\bm{\beta}^{i}}</annotation></semantics></math>, index set <math id="alg4.l1.m5" class="ltx_Math" alttext="\mathcal{M}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{i}</annotation></semantics></math>, large scalar <math id="alg4.l1.m6" class="ltx_Math" alttext="Cap&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Cap&gt;0</annotation></semantics></math>

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <span id="alg4.l2.3" class="ltx_text ltx_font_bold">Output:</span> <math id="alg4.l2.m1" class="ltx_Math" alttext="(\Lambda_{i},c_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Lambda_{i},c_{i})</annotation></semantics></math>

</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
