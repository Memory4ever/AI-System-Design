</div>
<div id="alg5.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
               <math id="alg5.l6.m1" class="ltx_Math" alttext="(\bm{\alpha}^{i,\mathrm{adj}})_{j}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\bm{\alpha}^{i,\mathrm{adj}})_{j}\leftarrow 0</annotation></semantics></math>,  <math id="alg5.l6.m2" class="ltx_Math" alttext="(\bm{\beta}^{i,\mathrm{adj}})_{j}\leftarrow(\bm{\beta}^{i})_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜷</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">(\bm{\beta}^{i,\mathrm{adj}})_{j}\leftarrow(\bm{\beta}^{i})_{j}</annotation></semantics></math>

</div>
<div id="alg5.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <span id="alg5.l7.3" class="ltx_text ltx_font_bold">else</span> <span id="alg5.l7.4" class="ltx_text ltx_font_bold">if</span> <math id="alg5.l7.m1" class="ltx_Math" alttext="(\bm{\alpha}^{i})_{j}\leq(\bm{\beta}^{i})_{j}\leq 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜶</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo>≤</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜷</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\bm{\alpha}^{i})_{j}\leq(\bm{\beta}^{i})_{j}\leq 0</annotation></semantics></math> <span id="alg5.l7.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg5.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
               <math id="alg5.l8.m1" class="ltx_Math" alttext="(\bm{\alpha}^{i,\mathrm{adj}})_{j}\leftarrow(\bm{\alpha}^{i})_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜶</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜶</mi><mi>i</mi></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">(\bm{\alpha}^{i,\mathrm{adj}})_{j}\leftarrow(\bm{\alpha}^{i})_{j}</annotation></semantics></math>,  <math id="alg5.l8.m2" class="ltx_Math" alttext="(\bm{\beta}^{i,\mathrm{adj}})_{j}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>𝜷</mi><mrow><mi>i</mi><mo>,</mo><mi>adj</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\bm{\beta}^{i,\mathrm{adj}})_{j}\leftarrow 0</annotation></semantics></math>

</div>
