><mi>i</mi></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∙</mo><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{2}\Big(x^{T}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Big)_{(\bullet,\mathcal{J}_{i})}(W_{i}y)_{\mathcal{J}_{i}}+\frac{1}{2}\Big(x^{T}\Lambda_{i}(D_{\bm{\alpha}^{i}}+D_{\bm{\beta}^{i}})\Big)_{(\bullet,\mathcal{M}_{i})}(W_{i}y)_{\mathcal{M}_{i}}</annotation></semantics></math></td>
