<span id="S3.T3.2.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.547</span>
<span id="S3.T3.2.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.487</span></span>
<span id="S3.T3.2.1.1.1.3" class="ltx_tr">
