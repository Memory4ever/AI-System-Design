<td id="S4.T1.4.1.5.6" class="ltx_td ltx_align_center">0.9234 <span id="S4.T1.4.1.5.6.1" class="ltx_text" style="--ltx-fg-color:#A6A6A6;">(-26.42%)</span></td>
