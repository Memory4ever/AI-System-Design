<td id="S4.T4.4.1.13.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T4.4.1.13.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">6.24<math id="S4.T4.m44" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td>
