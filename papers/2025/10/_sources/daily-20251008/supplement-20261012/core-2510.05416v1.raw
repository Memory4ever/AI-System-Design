<th id="S5.T2.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S5.T2.2.1.4.1" class="ltx_text ltx_font_smallcaps">DP-BandMF</span></th>
