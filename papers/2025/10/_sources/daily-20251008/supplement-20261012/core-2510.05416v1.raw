<span id="A4.T4.sf1.2.1.1.1.4.2" class="ltx_td ltx_align_left"><math id="A4.T4.sf1.m7" class="ltx_Math" alttext="32\to 64" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo stretchy="false">→</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">32\to 64</annotation></semantics></math>, kernel <math id="A4.T4.sf1.m8" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math>, stride <math id="A4.T4.sf1.m9" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></span></span>
