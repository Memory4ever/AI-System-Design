<span id="A4.T4.sf1.2.1.1.1.6.2" class="ltx_td ltx_align_left"><math id="A4.T4.sf1.m11" class="ltx_Math" alttext="256\to\texttt{dense\_size}" display="inline" intent=":literal"><semantics><mrow><mn>256</mn><mo stretchy="false">→</mo><mtext class="ltx_mathvariant_monospace">dense_size</mtext></mrow><annotation encoding="application/x-tex">256\to\texttt{dense\_size}</annotation></semantics></math></span></span>
