<span id="A4.T4.sf1.2.1.1.1.3.2" class="ltx_td ltx_align_left"><math id="A4.T4.sf1.m4" class="ltx_Math" alttext="16\to 32" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo stretchy="false">→</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">16\to 32</annotation></semantics></math>, kernel <math id="A4.T4.sf1.m5" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math>, stride <math id="A4.T4.sf1.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></span></span>
<span id="A4.T4.sf1.2.1.1.1.4" class="ltx_tr">
