<td id="S5.T1.8.1.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.8.1.5.1.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#F2F2F2;">Supervised Fine-tuning</span></td>
