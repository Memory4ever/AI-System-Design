<td id="S5.T1.8.1.6.6" class="ltx_td ltx_align_center">33.8</td>
<td id="S5.T1.8.1.6.7" class="ltx_td ltx_align_center">23.5</td>
<td id="S5.T1.8.1.6.8" class="ltx_td ltx_align_center">32.6</td>
<td id="S5.T1.8.1.6.9" class="ltx_td ltx_align_center">13403</td></tr>
<tr id="S5.T1.8.1.7" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<td id="S5.T1.8.1.7.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T1.8.1.7.1.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#F2F2F2;">Reinforcement Learning</span></td>
<td id="S5.T1.8.1.7.2" class="ltx_td ltx_border_t"></td>
<td id="S5.T1.8.1.7.3" class="ltx_td ltx_border_t"></td>
