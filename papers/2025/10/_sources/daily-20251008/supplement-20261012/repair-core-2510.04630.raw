<tr id="S3.T1.1.7" class="ltx_tr">
<th id="S3.T1.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">white_negative</th>
<td id="S3.T1.1.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">44,719 (34,310 + 6,650)</td>
<td id="S3.T1.1.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">783 (294 + 489)</td></tr>
<tr id="S3.T1.1.8" class="ltx_tr">
<th id="S3.T1.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">white_neutral</th>
<td id="S3.T1.1.8.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">40,960 (34,310 + 6,650)</td>
<td id="S3.T1.1.8.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">594 (280 + 314)</td></tr>
<tr id="S3.T1.1.9" class="ltx_tr">
<th id="S3.T1.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">white_scared</th>
