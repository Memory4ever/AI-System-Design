<th id="S3.T2.1.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">2</th>
<td id="S3.T2.1.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.3924</td>
<td id="S3.T2.1.6.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.8257</td></tr>
