<tr id="S4.T12.1.3" class="ltx_tr">
<th id="S4.T12.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Accuracy</th>
<td id="S4.T12.1.3.2" class="ltx_td ltx_align_center"><span id="S4.T12.1.3.2.1" class="ltx_text ltx_font_bold">0.9613</span></td></tr>
