<td id="S4.T12.1.5.2" class="ltx_td ltx_align_center"><span id="S4.T12.1.5.2.1" class="ltx_text ltx_font_bold">0.9619</span></td></tr>
<tr id="S4.T12.1.6" class="ltx_tr">
