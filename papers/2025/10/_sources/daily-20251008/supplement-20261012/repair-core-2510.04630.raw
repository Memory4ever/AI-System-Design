<td id="S3.T2.1.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.7792</td></tr>
<tr id="S3.T2.1.6" class="ltx_tr">
