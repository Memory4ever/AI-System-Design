<td id="S4.T12.1.7.2" class="ltx_td ltx_align_center"><span id="S4.T12.1.7.2.1" class="ltx_text ltx_font_bold">0.0388</span></td></tr>
<tr id="S4.T12.1.8" class="ltx_tr">
