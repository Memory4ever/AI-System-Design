<td id="A3.T7.5.1.10.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">41.0</td>
<td id="A3.T7.5.1.10.5" class="ltx_td ltx_align_center ltx_border_bb">20.4</td>
<td id="A3.T7.5.1.10.6" class="ltx_td ltx_align_center ltx_border_bb">33.7</td>
<td id="A3.T7.5.1.10.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">43.3</td>
