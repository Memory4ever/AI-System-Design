<th id="A4.T9.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Shape</th>
<th id="A4.T9.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Part</th>
<th id="A4.T9.5.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt">Style</th>
<th id="A4.T9.5.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Mean</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T9.5.1.2" class="ltx_tr">
<th id="A4.T9.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">10</th>
<td id="A4.T9.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">15.80</td>
<td id="A4.T9.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">8.15</td>
<td id="A4.T9.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">14.40</td>
<td id="A4.T9.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">6.49</td>
<td id="A4.T9.5.1.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">4.80</td>
<td id="A4.T9.5.1.2.7" class="ltx_td ltx_align_center ltx_border_t">9.93</td></tr>
<tr id="A4.T9.5.1.3" class="ltx_tr">
<th id="A4.T9.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">20</th>
<td id="A4.T9.5.1.3.2" class="ltx_td ltx_align_center">16.21</td>
<td id="A4.T9.5.1.3.3" class="ltx_td ltx_align_center">8.93</td>
<td id="A4.T9.5.1.3.4" class="ltx_td ltx_align_center">15.18</td>
<td id="A4.T9.5.1.3.5" class="ltx_td ltx_align_center">7.07</td>
<td id="A4.T9.5.1.3.6" class="ltx_td ltx_align_center ltx_border_r">5.06</td>
<td id="A4.T9.5.1.3.7" class="ltx_td ltx_align_center">10.52</td></tr>
<tr id="A4.T9.5.1.4" class="ltx_tr">
<th id="A4.T9.5.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">50</th>
<td id="A4.T9.5.1.4.2" class="ltx_td ltx_align_center">16.64</td>
<td id="A4.T9.5.1.4.3" class="ltx_td ltx_align_center">9.02</td>
