<td id="A5.T10.5.1.3.2" class="ltx_td ltx_align_center ltx_border_bb">53.34 ± 0.44</td>
<td id="A5.T10.5.1.3.3" class="ltx_td ltx_align_center ltx_border_bb">52.94 ± 0.40</td>
<td id="A5.T10.5.1.3.4" class="ltx_td ltx_align_center ltx_border_bb">52.93 ± 0.41</td>
<td id="A5.T10.5.1.3.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">53.43 ± 0.45</td>
