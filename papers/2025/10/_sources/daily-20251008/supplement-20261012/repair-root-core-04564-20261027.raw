<td id="A5.T10.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">43.80 ± 0.55</td>
<td id="A5.T10.5.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">43.75 ± 0.58</td>
<td id="A5.T10.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.59</td></tr>
