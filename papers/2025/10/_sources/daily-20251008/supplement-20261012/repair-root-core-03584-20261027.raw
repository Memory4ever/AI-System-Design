<td id="S5.T1.4.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S5.T1.4.1.1.7.1" class="ltx_text ltx_font_bold">EgoSchema</span></td>
<td id="S5.T1.4.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S5.T1.4.1.1.8.1" class="ltx_text ltx_font_bold">MLVU</span></td>
