<td id="S5.T1.4.1.6.11" class="ltx_td ltx_align_center">-</td></tr>
<tr id="S5.T1.4.1.7" class="ltx_tr">
<td id="S5.T1.4.1.7.1" class="ltx_td ltx_align_left">VideoLLaMA2-7B <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Cheng et al., 2024</a>)</cite></td>
<td id="S5.T1.4.1.7.2" class="ltx_td ltx_align_center">16</td>
<td id="S5.T1.4.1.7.3" class="ltx_td ltx_align_center">-</td>
<td id="S5.T1.4.1.7.4" class="ltx_td ltx_align_center">-</td>
<td id="S5.T1.4.1.7.5" class="ltx_td ltx_align_center">45.4</td>
