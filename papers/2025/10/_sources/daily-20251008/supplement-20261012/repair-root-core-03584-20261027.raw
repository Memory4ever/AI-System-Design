<td id="A4.T6.2.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_tt" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="A4.T6.2.1.2.1" class="ltx_text ltx_font_bold">Response formatting prompts</span></td></tr>
