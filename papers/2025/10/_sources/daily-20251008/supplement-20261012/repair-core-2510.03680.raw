<td id="S6.T4.2.1.5.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-top:0.75pt;padding-bottom:0.75pt;"><span id="S6.T4.2.1.5.2.1" class="ltx_text ltx_font_bold">36.2</span></td>
