<span id="A5.F21.pic2.2.2.1.1" class="ltx_text ltx_font_typewriter">&lt;eos&gt;&lt;pad<sub id="A5.F21.pic2.2.2.1.1.1" class="ltx_sub">0</sub>&gt;&lt;pad<sub id="A5.F21.pic2.2.2.1.1.2" class="ltx_sub">1</sub>&gt;&lt;pad<sub id="A5.F21.pic2.2.2.1.1.3" class="ltx_sub">2</sub>&gt;&lt;pad<sub id="A5.F21.pic2.2.2.1.1.4" class="ltx_sub">3</sub>&gt;</span>…</span></span>
