</div>
<div id="lstnumberx337" class="ltx_listingline">\[
</div>
<div id="lstnumberx338" class="ltx_listingline">(1<span id="lstnumberx338.1" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx338.2" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx338.3" class="ltx_text ltx_lst_identifier">frac</span>{1}{2}<span id="lstnumberx338.4" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx338.5" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx338.6" class="ltx_text ltx_lst_identifier">frac</span>{1}{4}<span id="lstnumberx338.7" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx338.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx338.9" class="ltx_text ltx_lst_identifier">y</span>^2)^2<span id="lstnumberx338.10" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx338.11" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx338.12" class="ltx_text ltx_lst_identifier">y</span><span id="lstnumberx338.13" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx338.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx338.15" class="ltx_text ltx_lst_identifier">y</span>)^2
</div>
