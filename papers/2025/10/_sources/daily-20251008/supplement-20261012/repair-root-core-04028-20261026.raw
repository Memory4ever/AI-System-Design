</div>
<div id="lstnumberx349" class="ltx_listingline"><span id="lstnumberx349.1" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx349.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx349.3" class="ltx_text ltx_lst_identifier">maximum</span><span id="lstnumberx349.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx349.5" class="ltx_text ltx_lst_identifier">imaginary</span><span id="lstnumberx349.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx349.7" class="ltx_text ltx_lst_identifier">part</span><span id="lstnumberx349.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx349.9" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx349.10" class="ltx_text ltx_lst_space"> </span>\(\<span id="lstnumberx349.11" class="ltx_text ltx_lst_identifier">frac</span>{\<span id="lstnumberx349.12" class="ltx_text ltx_lst_identifier">sqrt</span>{19}}{2}\).
</div>
<div id="lstnumberx350" class="ltx_listingline"><span id="lstnumberx350.1" class="ltx_text ltx_lst_identifier">Therefore</span>,<span id="lstnumberx350.2" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx350.3" class="ltx_text ltx_lst_identifier">m</span><span id="lstnumberx350.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx350.5" class="ltx_text ltx_lst_space"> </span>19\)<span id="lstnumberx350.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx350.7" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx350.8" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx350.9" class="ltx_text ltx_lst_identifier">n</span><span id="lstnumberx350.10" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx350.11" class="ltx_text ltx_lst_space"> </span>2\),<span id="lstnumberx350.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx350.13" class="ltx_text ltx_lst_identifier">so</span><span id="lstnumberx350.14" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx350.15" class="ltx_text ltx_lst_identifier">m</span><span id="lstnumberx350.16" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx350.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx350.18" class="ltx_text ltx_lst_identifier">n</span><span id="lstnumberx350.19" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx350.20" class="ltx_text ltx_lst_space"> </span>21\).
