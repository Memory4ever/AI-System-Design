<div id="lstnumberx316" class="ltx_listingline"><span id="lstnumberx316.1" class="ltx_text ltx_lst_identifier">The</span><span id="lstnumberx316.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.3" class="ltx_text ltx_lst_identifier">numerical</span><span id="lstnumberx316.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.5" class="ltx_text ltx_lst_identifier">method</span><span id="lstnumberx316.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.7" class="ltx_text ltx_lst_identifier">suggests</span><span id="lstnumberx316.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.9" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx316.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.11" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx316.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.13" class="ltx_text ltx_lst_identifier">maximum</span><span id="lstnumberx316.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.15" class="ltx_text ltx_lst_identifier">value</span><span id="lstnumberx316.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx316.17" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx316.18" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx316.19" class="ltx_text ltx_lst_identifier">y</span>\)
</div>
<div id="lstnumberx317" class="ltx_listingline"><span id="lstnumberx317.1" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx317.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx317.3" class="ltx_text ltx_lst_identifier">approximately</span><span id="lstnumberx317.4" class="ltx_text ltx_lst_space"> </span>\(-0.03\),<span id="lstnumberx317.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx317.6" class="ltx_text ltx_lst_identifier">which</span><span id="lstnumberx317.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx317.8" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx317.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx317.10" class="ltx_text ltx_lst_identifier">very</span><span id="lstnumberx317.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx317.12" class="ltx_text ltx_lst_identifier">close</span><span id="lstnumberx317.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx317.14" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx317.15" class="ltx_text ltx_lst_space"> </span>0.
</div>
<div id="lstnumberx318" class="ltx_listingline"><span id="lstnumberx318.1" class="ltx_text ltx_lst_identifier">This</span><span id="lstnumberx318.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.3" class="ltx_text ltx_lst_identifier">indicates</span><span id="lstnumberx318.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.5" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx318.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.7" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx318.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.9" class="ltx_text ltx_lst_identifier">maximum</span><span id="lstnumberx318.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.11" class="ltx_text ltx_lst_identifier">imaginary</span><span id="lstnumberx318.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.13" class="ltx_text ltx_lst_identifier">part</span><span id="lstnumberx318.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.15" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx318.16" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx318.17" class="ltx_text ltx_lst_identifier">z</span>\)<span id="lstnumberx318.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.19" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx318.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx318.21" class="ltx_text ltx_lst_identifier">likely</span><span id="lstnumberx318.22" class="ltx_text ltx_lst_space"> </span>0,
</div>
<div id="lstnumberx319" class="ltx_listingline"><span id="lstnumberx319.1" class="ltx_text ltx_lst_identifier">but</span><span id="lstnumberx319.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.3" class="ltx_text ltx_lst_identifier">let</span>’<span id="lstnumberx319.4" class="ltx_text ltx_lst_identifier">s</span><span id="lstnumberx319.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.6" class="ltx_text ltx_lst_identifier">verify</span><span id="lstnumberx319.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.8" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx319.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.10" class="ltx_text ltx_lst_identifier">by</span><span id="lstnumberx319.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.12" class="ltx_text ltx_lst_identifier">checking</span><span id="lstnumberx319.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.14" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx319.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.16" class="ltx_text ltx_lst_identifier">exact</span><span id="lstnumberx319.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.18" class="ltx_text ltx_lst_identifier">form</span><span id="lstnumberx319.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.20" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx319.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.22" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx319.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx319.24" class="ltx_text ltx_lst_identifier">solution</span>.
