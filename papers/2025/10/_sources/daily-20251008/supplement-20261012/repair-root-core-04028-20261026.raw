</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A3.F4.fig2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.04028v1/lamma_MATHTestEntropy.svg" id="A3.F4.g2" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:145/135;" width="145" height="135"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A3.F4.fig3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2510.04028v1/llama_ActorEntropyLoss.svg" id="A3.F4.g3" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:140/135;" width="140" height="135"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
