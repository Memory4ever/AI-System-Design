</div>
<div id="lstnumberx342" class="ltx_listingline">\[
</div>
<div id="lstnumberx343" class="ltx_listingline">\<span id="lstnumberx343.1" class="ltx_text ltx_lst_identifier">frac</span>{3}{4}<span id="lstnumberx343.2" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx343.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx343.4" class="ltx_text ltx_lst_identifier">y</span>^2<span id="lstnumberx343.5" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx343.6" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx343.7" class="ltx_text ltx_lst_identifier">pm</span><span id="lstnumberx343.8" class="ltx_text ltx_lst_space"> </span>4<span id="lstnumberx343.9" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx343.10" class="ltx_text ltx_lst_identifier">implies</span><span id="lstnumberx343.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx343.12" class="ltx_text ltx_lst_identifier">y</span>^2<span id="lstnumberx343.13" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx343.14" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx343.15" class="ltx_text ltx_lst_identifier">frac</span>{3}{4}<span id="lstnumberx343.16" class="ltx_text ltx_lst_space"> </span>\<span id="lstnumberx343.17" class="ltx_text ltx_lst_identifier">pm</span><span id="lstnumberx343.18" class="ltx_text ltx_lst_space"> </span>4
</div>
