</div>
<div id="lstnumberx345" class="ltx_listingline"><span id="lstnumberx345.1" class="ltx_text ltx_lst_identifier">Since</span><span id="lstnumberx345.2" class="ltx_text ltx_lst_space"> </span>\(<span id="lstnumberx345.3" class="ltx_text ltx_lst_identifier">y</span>^2\)<span id="lstnumberx345.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.5" class="ltx_text ltx_lst_identifier">must</span><span id="lstnumberx345.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.7" class="ltx_text ltx_lst_identifier">be</span><span id="lstnumberx345.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.9" class="ltx_text ltx_lst_identifier">non</span>-<span id="lstnumberx345.10" class="ltx_text ltx_lst_identifier">negative</span>,<span id="lstnumberx345.11" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.12" class="ltx_text ltx_lst_identifier">we</span><span id="lstnumberx345.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.14" class="ltx_text ltx_lst_identifier">take</span><span id="lstnumberx345.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.16" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx345.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.18" class="ltx_text ltx_lst_identifier">positive</span><span id="lstnumberx345.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx345.20" class="ltx_text ltx_lst_identifier">root</span>:
