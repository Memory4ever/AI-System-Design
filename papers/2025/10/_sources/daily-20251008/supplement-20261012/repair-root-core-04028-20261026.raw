</div>
<div id="lstnumberx326" class="ltx_listingline"><span id="lstnumberx326.1" class="ltx_text ltx_lst_identifier">Let</span>’<span id="lstnumberx326.2" class="ltx_text ltx_lst_identifier">s</span><span id="lstnumberx326.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx326.4" class="ltx_text ltx_lst_identifier">consider</span><span id="lstnumberx326.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx326.6" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx326.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx326.8" class="ltx_text ltx_lst_identifier">equation</span><span id="lstnumberx326.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx326.10" class="ltx_text ltx_lst_identifier">again</span>:
</div>
<div id="lstnumberx327" class="ltx_listingline">\[
</div>
<div id="lstnumberx328" class="ltx_listingline">(1<span id="lstnumberx328.1" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx328.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx328.3" class="ltx_text ltx_lst_identifier">x</span><span id="lstnumberx328.4" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx328.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx328.6" class="ltx_text ltx_lst_identifier">x</span>^2<span id="lstnumberx328.7" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx328.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx328.9" class="ltx_text ltx_lst_identifier">y</span>^2)^2<span id="lstnumberx328.10" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx328.11" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx328.12" class="ltx_text ltx_lst_identifier">y</span><span id="lstnumberx328.13" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx328.14" class="ltx_text ltx_lst_space"> </span>2<span id="lstnumberx328.15" class="ltx_text ltx_lst_identifier">xy</span>)^2<span id="lstnumberx328.16" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx328.17" class="ltx_text ltx_lst_space"> </span>16
