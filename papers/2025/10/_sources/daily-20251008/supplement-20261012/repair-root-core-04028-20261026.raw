</div>
<div id="lstnumberx321" class="ltx_listingline"><span id="lstnumberx321.1" class="ltx_text ltx_lst_identifier">To</span><span id="lstnumberx321.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.3" class="ltx_text ltx_lst_identifier">find</span><span id="lstnumberx321.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.5" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx321.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.7" class="ltx_text ltx_lst_identifier">exact</span><span id="lstnumberx321.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.9" class="ltx_text ltx_lst_identifier">maximum</span><span id="lstnumberx321.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.11" class="ltx_text ltx_lst_identifier">imaginary</span><span id="lstnumberx321.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.13" class="ltx_text ltx_lst_identifier">part</span>,<span id="lstnumberx321.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.15" class="ltx_text ltx_lst_identifier">we</span><span id="lstnumberx321.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.17" class="ltx_text ltx_lst_identifier">can</span><span id="lstnumberx321.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx321.19" class="ltx_text ltx_lst_identifier">use</span>
</div>
<div id="lstnumberx322" class="ltx_listingline"><span id="lstnumberx322.1" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx322.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.3" class="ltx_text ltx_lst_identifier">fact</span><span id="lstnumberx322.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.5" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx322.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.7" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx322.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.9" class="ltx_text ltx_lst_identifier">equation</span><span id="lstnumberx322.10" class="ltx_text ltx_lst_space"> </span>\(|1<span id="lstnumberx322.11" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx322.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.13" class="ltx_text ltx_lst_identifier">z</span><span id="lstnumberx322.14" class="ltx_text ltx_lst_space"> </span>+<span id="lstnumberx322.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.16" class="ltx_text ltx_lst_identifier">z</span>^2|<span id="lstnumberx322.17" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx322.18" class="ltx_text ltx_lst_space"> </span>4\)<span id="lstnumberx322.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx322.20" class="ltx_text ltx_lst_identifier">represents</span>
</div>
<div id="lstnumberx323" class="ltx_listingline"><span id="lstnumberx323.1" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx323.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx323.3" class="ltx_text ltx_lst_identifier">curve</span><span id="lstnumberx323.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx323.5" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx323.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx323.7" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx323.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx323.9" class="ltx_text ltx_lst_identifier">complex</span><span id="lstnumberx323.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx323.11" class="ltx_text ltx_lst_identifier">plane</span>.
</div>
<div id="lstnumberx324" class="ltx_listingline"><span id="lstnumberx324.1" class="ltx_text ltx_lst_identifier">We</span><span id="lstnumberx324.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.3" class="ltx_text ltx_lst_identifier">can</span><span id="lstnumberx324.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.5" class="ltx_text ltx_lst_identifier">analyze</span><span id="lstnumberx324.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.7" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx324.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.9" class="ltx_text ltx_lst_identifier">curve</span><span id="lstnumberx324.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.11" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx324.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.13" class="ltx_text ltx_lst_identifier">find</span><span id="lstnumberx324.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.15" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx324.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.17" class="ltx_text ltx_lst_identifier">maximum</span><span id="lstnumberx324.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.19" class="ltx_text ltx_lst_identifier">imaginary</span><span id="lstnumberx324.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.21" class="ltx_text ltx_lst_identifier">part</span><span id="lstnumberx324.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx324.23" class="ltx_text ltx_lst_identifier">analytically</span>.
</div>
