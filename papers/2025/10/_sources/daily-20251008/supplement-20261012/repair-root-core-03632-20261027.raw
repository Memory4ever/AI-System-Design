<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>ARC-Challenge</h3>

<section id="A3.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Prompt.</h4>

<div id="A3.SS2.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS0.Px1.p1.1" class="ltx_p">Here is an example prompt with question from the dataset ARC-Challenge.</p>
<div id="A3.SS2.SSS0.Px1.p1.2" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx42" class="ltx_listingline"><span id="lstnumberx42.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx42.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">need</span><span id="lstnumberx42.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx42.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx42.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx42.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question</span><span id="lstnumberx42.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">by</span><span id="lstnumberx42.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">choosing</span><span id="lstnumberx42.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">one</span><span id="lstnumberx42.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx42.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx42.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">given</span><span id="lstnumberx42.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx42.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">options</span><span id="lstnumberx42.26" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx43" class="ltx_listingline"><span id="lstnumberx43.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Let</span><span id="lstnumberx43.2" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx43.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx43.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">think</span><span id="lstnumberx43.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">this</span><span id="lstnumberx43.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question</span><span id="lstnumberx43.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">step</span><span id="lstnumberx43.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">by</span><span id="lstnumberx43.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">step</span><span id="lstnumberx43.16" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx43.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Finally</span><span id="lstnumberx43.19" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx43.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">please</span><span id="lstnumberx43.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx43.23" c