<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(c) </span>Results for Qwen3-32B.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S3.F3.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.04261v1/ds-v3.png" id="S3.F3.sf4.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/445;" width="476" height="445" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(d) </span>Results for DeepSeek-V3.</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F3.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.04261v1/ds-r1.png" id="S3.F3.sf5.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/445;" width="476" height="445" alt="Refer to caption">
