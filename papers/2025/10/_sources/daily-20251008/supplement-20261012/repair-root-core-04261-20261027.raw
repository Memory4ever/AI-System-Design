            <span id="algorithm1.6.18.2" class="ltx_text" style="--ltx-fg-color:#4DA666;">#Attacker extracts PII <math id="algorithm1.m22" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#4DA666;" mathcolor="#4DA666">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> from <math id="algorithm1.m23" class="ltx_math_unparsed" alttext="M_{\theta^{{}^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#4DA666;" mathcolor="#4DA666">M</mi><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#4DA666;" mathcolor="#4DA666">θ</mi><msup><mrow></mrow><msup><mrow></mrow><mo style="--ltx-fg-color:#4DA666;" mathcolor="#4DA666">′</mo></msup></msup></mrow></msub></mrow><annotation encoding="application/x-tex">M_{\theta^{{}^{\prime}}}</annotation></semantics></math>.</span>
</div>
