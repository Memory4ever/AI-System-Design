<td id="S5.T2.2.1.25.7" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m125" class="ltx_Math" alttext="52.49" display="inline" intent=":literal"><semantics><mn>52.49</mn><annotation encoding="application/x-tex">52.49</annotation></semantics></math></td>
