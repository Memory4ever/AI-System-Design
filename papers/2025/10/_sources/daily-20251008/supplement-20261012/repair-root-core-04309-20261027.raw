<td id="S5.T1.2.1.2.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="S5.T1.m7" class="ltx_Math" alttext="12.85\scriptscriptstyle{\pm 0.94}" display="inline" intent=":literal"><semantics><mrow><mn>12.85</mn><mo mathsize="0.500em">±</mo><mn mathsize="0.500em">0.94</mn></mrow><annotation encoding="application/x-tex">12.85\scriptscriptstyle{\pm 0.94}</annotation></semantics></math></td>
