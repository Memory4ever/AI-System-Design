<td id="S5.T2.2.1.24.3" class="ltx_td ltx_align_left" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m115" class="ltx_Math" alttext="28.64" display="inline" intent=":literal"><semantics><mn>28.64</mn><annotation encoding="application/x-tex">28.64</annotation></semantics></math></td>
<td id="S5.T2.2.1.24.4" class="ltx_td ltx_align_left" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m116" class="ltx_Math" alttext="67.50" display="inline" intent=":literal"><semantics><mn>67.50</mn><annotation encoding="application/x-tex">67.50</annotation></semantics></math></td>
<td id="S5.T2.2.1.24.5" class="ltx_td ltx_align_left" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m117" class="ltx_Math" alttext="79.20" display="inline" intent=":literal"><semantics><mn>79.20</mn><annotation encoding="application/x-tex">79.20</annotation></semantics></math></td>
