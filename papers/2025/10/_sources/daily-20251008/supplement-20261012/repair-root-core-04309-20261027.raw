<td id="S5.T2.2.1.24.8" class="ltx_td ltx_align_left" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m120" class="ltx_Math" alttext="81.20" display="inline" intent=":literal"><semantics><mn>81.20</mn><annotation encoding="application/x-tex">81.20</annotation></semantics></math></td>
<td id="S5.T2.2.1.24.9" class="ltx_td ltx_align_left" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m121" class="ltx_Math" alttext="71.15" display="inline" intent=":literal"><semantics><mn>71.15</mn><annotation encoding="application/x-tex">71.15</annotation></semantics></math></td></tr>
<tr id="S5.T2.2.1.25" class="ltx_tr">
<td id="S5.T2.2.1.25.1" class="ltx_td ltx_border_bb" style="padding:0.9pt 5.5pt;"></td>
<td id="S5.T2.2.1.25.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.9pt 5.5pt;">PID</td>
<td id="S5.T2.2.1.25.3" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.9pt 5.5pt;"><span id="S5.T2.2.1.25.3.1" class="ltx_text ltx_font_bold">79.50</span></td>
<td id="S5.T2.2.1.25.4" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m122" class="ltx_Math" alttext="67.91" display="inline" intent=":literal"><semantics><mn>67.91</mn><annotation encoding="application/x-tex">67.91</annotation></semantics></math></td>
<td id="S5.T2.2.1.25.5" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.9pt 5.5pt;"><math id="S5.T2.m123" class="ltx_Math" alttext="79.24" display="inline" intent=":literal"><semantics><mn>79.24</mn><annotation encoding="application/x-tex">79.24</annotation></semantics></math></td>
