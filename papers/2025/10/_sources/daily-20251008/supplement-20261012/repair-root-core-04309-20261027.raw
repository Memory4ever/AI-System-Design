<td id="S5.T2.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.9pt 5.5pt;"><span id="S5.T2.2.1.2.1.1" class="ltx_ERROR undefined">\Block</span>5-1¡<span id="S5.T2.2.1.2.1.2" class="ltx_ERROR undefined">\rotate</span>¿<span id="S5.T2.2.1.2.1.3" class="ltx_text ltx_font_bold">Qwen2.5-3B</span></td>
