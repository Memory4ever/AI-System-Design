<td id="S5.T4.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.5pt;padding-right:6.5pt;"><span id="S5.T4.2.1.2.7.1" class="ltx_text ltx_font_bold">C-II</span></td>
<td id="S5.T4.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.5pt;padding-right:6.5pt;"><span id="S5.T4.2.1.2.8.1" class="ltx_text ltx_font_bold">G</span></td></tr>
