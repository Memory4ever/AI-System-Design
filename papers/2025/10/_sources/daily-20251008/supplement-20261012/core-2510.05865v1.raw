<td id="S2.T1.2.1.17.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;">D</td>
<td id="S2.T1.2.1.17.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.5pt;padding-right:1.5pt;"><math id="S2.T1.m16" class="ltx_Math" alttext="(1\times 352\times 640)\times 93" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>352</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>640</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mn>93</mn></mrow><annotation encoding="application/x-tex">(1\times 352\times 640)\times 93</annotation></semantics></math></td>
