<td id="S5.T4.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.5pt;padding-right:6.5pt;">16.0</td>
<td id="S5.T4.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.5pt;padding-right:6.5pt;">46.5</td>
<td id="S5.T4.2.1.3.5" class="ltx_td ltx_border_t" style="padding-left:6.5pt;padding-right:6.5pt;"></td>
