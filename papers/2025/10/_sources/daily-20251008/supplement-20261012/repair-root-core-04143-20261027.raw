<tr id="S5.T5.4.2" class="ltx_tr">
<th id="S5.T5.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row"><span id="S5.T5.4.2.1.1" class="ltx_text" style="font-size:70%;">Model <math id="S5.T5.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></th>
<th id="S5.T5.4.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.2.1" class="ltx_text" style="font-size:70%;">A</span></th>
<th id="S5.T5.4.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.3.1" class="ltx_text" style="font-size:70%;">F1</span></th>
<th id="S5.T5.4.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.4.1" class="ltx_text" style="font-size:70%;">P</span></th>
<th id="S5.T5.4.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S5.T5.4.2.5.1" class="ltx_text" style="font-size:70%;">R</span></th>
<th id="S5.T5.4.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.6.1" class="ltx_text" style="font-size:70%;">A</span></th>
<th id="S5.T5.4.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.7.1" class="ltx_text" style="font-size:70%;">F1</span></th>
<th id="S5.T5.4.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.8.1" class="ltx_text" style="font-size:70%;">P</span></th>
<th id="S5.T5.4.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.T5.4.2.9.1" class="ltx_text" style="font-size:70%;">R</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T5.4.3" class="ltx_tr">
<th id="S5.T5.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S5.T5.4.3.1.1" class="ltx_text" style="font-size:70%;">CodeBERT<sub id="S5.T5.4.3.1.1.1" class="ltx_sub"><span id="S5.T5.4.3.1.1.1.1" class="ltx_text ltx_font_italic">B</span></sub> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></span></th>
<td id="S5.T5.4.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.4.3.2.1" class="ltx_text" style="font-size:70%;">56.6</span></td>
