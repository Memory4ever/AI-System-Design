<td id="S4.T3.2.1.4.1" class="ltx_td ltx_align_left">LAS only</td>
<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center">0.893</td>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center">0.355</td>
<td id="S4.T3.2.1.4.4" class="ltx_td ltx_align_center">0.844</td></tr>
<tr id="S4.T3.2.1.5" class="ltx_tr">
