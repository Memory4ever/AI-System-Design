<td id="S4.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.2.1" class="ltx_text ltx_font_bold">Pearson (<math id="S4.T4.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>)</span></td>
