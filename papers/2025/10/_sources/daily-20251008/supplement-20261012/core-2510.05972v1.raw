            <span id="alg1.l10.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l10.m1" class="ltx_math_unparsed" alttext="\it op{=}\wedge" display="inline" intent=":literal"><semantics><mrow><mi>𝑜𝑝</mi><mo rspace="0em">=</mo><mo lspace="0em">∧</mo></mrow><annotation encoding="application/x-tex">\it op{=}\wedge</annotation></semantics></math> <span id="alg1.l10.4" class="ltx_text ltx_font_bold">then</span> <math id="alg1.l10.m2" class="ltx_Math" alttext="\it\phi\leftarrow\bigwedge_{l\in literals}l" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>⋀</mo><mrow><mi>l</mi><mo>∈</mo><mi>𝑙𝑖𝑡𝑒𝑟𝑎𝑙𝑠</mi></mrow></msub><mi>l</mi></mrow></mrow><annotation encoding="application/x-tex">\it\phi\leftarrow\bigwedge_{l\in literals}l</annotation></semantics></math> <span id="alg1.l10.5" class="ltx_text ltx_font_bold">else</span> <math id="alg1.l10.m3" class="ltx_Math" alttext="\it\phi\leftarrow\bigvee_{l\in literals}l" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>⋁</mo><mrow><mi>l</mi><mo>∈</mo><mi>𝑙𝑖𝑡𝑒𝑟𝑎𝑙𝑠</mi></mrow></msub><mi>l</mi></mrow></mrow><annotation encoding="application/x-tex">\it\phi\leftarrow\bigvee_{l\in literals}l</annotation></semantics></math> 

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <math id="alg1.l11.m1" class="ltx_Math" alttext="\it q\leftarrow\mathsf{A}(\phi)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo stretchy="false">←</mo><mrow><mi>𝖠</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it q\leftarrow\mathsf{A}(\phi)</annotation></semantics></math> 

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="\it q^{\prime}\in C" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>∈</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\it q^{\prime}\in C</annotation></semantics></math> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">do</span> 

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <span id="alg1.l13.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l13.m1" class="ltx_Math" alttext="\it q^{\prime}{=}\mathsf{A}(\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝖠</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it q^{\prime}{=}\mathsf{A}(\phi^{\prime})</annotation></semantics></math> <span id="alg1.l13.4" class="ltx_text ltx_font_bold">and</span> (<math id="alg1.l13.m2" class="ltx_Math" alttext="\it D\models(\phi\rightarrow\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo stretchy="false">→</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\it D\models(\phi\rightarrow\phi^{\prime})</annotation></semantics></math> <span id="alg1.l13.5" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l13.m3" class="ltx_Math" alttext="\it D\models(\phi^{\prime}\rightarrow\phi)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mi>ϕ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\it D\models(\phi^{\prime}\rightarrow\phi)</annotation></semantics></math> <span id="alg1.l13.6" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l13.m4" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\phi^{\prime})</annotation></semantics></math>) <span id="alg1.l13.7" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l13.8" class="ltx_text ltx_font_bold">goto</span> <a href="#alg1.l3" title="In Algorithm 1 ‣ A.2 Constrained Planning Problem Generator ‣ Appendix A Reasoning Engine ‣ LexiCon: a Benchmark for Planningunder Temporal Constraints in Natural Language" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> 

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <span id="alg1.l14.3" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l14.4" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l14.m1" class="ltx_Math" alttext="\it q^{\prime}{=}\mathsf{S}(\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝖲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it q^{\prime}{=}\mathsf{S}(\phi^{\prime})</annotation></semantics></math> <span id="alg1.l14.5" class="ltx_text ltx_font_bold">and</span> (<math id="alg1.l14.m2" class="ltx_Math" alttext="\it D\models(\phi\rightarrow\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo stretchy="false">→</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\it D\models(\phi\rightarrow\phi^{\prime})</annotation></semantics></math> <span id="alg1.l14.6" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l14.m3" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\phi^{\prime})</annotation></semantics></math>) <span id="alg1.l14.7" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l14.8" class="ltx_text ltx_font_bold">goto</span> <a href="#alg1.l3" title="In Algorithm 1 ‣ A.2 Constrained Planning Problem Generator ‣ Appendix A Reasoning Engine ‣ LexiCon: a Benchmark for Planningunder Temporal Constraints in Natural Language" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> 

</div>
