              <span id="alg1.l15.3" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l15.4" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l15.m1" class="ltx_Math" alttext="\it q^{\prime}{=}\mathsf{AO}(\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝖠𝖮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it q^{\prime}{=}\mathsf{AO}(\phi^{\prime})</annotation></semantics></math> <span id="alg1.l15.5" class="ltx_text ltx_font_bold">and</span> (<math id="alg1.l15.m2" class="ltx_Math" alttext="\it D\models(\phi\rightarrow\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo stretchy="false">→</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\it D\models(\phi\rightarrow\phi^{\prime})</annotation></semantics></math> <span id="alg1.l15.6" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l15.m3" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\phi^{\prime})</annotation></semantics></math>) <span id="alg1.l15.7" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l15.8" class="ltx_text ltx_font_bold">goto</span> <a href="#alg1.l3" title="In Algorithm 1 ‣ A.2 Constrained Planning Problem Generator ‣ Appendix A Reasoning Engine ‣ LexiCon: a Benchmark for Planningunder Temporal Constraints in Natural Language" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> 

