</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
                         <span id="alg1.l17.3" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l17.m1" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\phi^{\prime})</annotation></semantics></math> <span id="alg1.l17.4" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l17.m2" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\psi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ψ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\psi^{\prime})</annotation></semantics></math>) <span id="alg1.l17.5" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l17.6" class="ltx_text ltx_font_bold">goto</span> <a href="#alg1.l3" title="In Algorithm 1 ‣ A.2 Constrained Planning Problem Generator ‣ Appendix A Reasoning Engine ‣ LexiCon: a Benchmark for Planningunder Temporal Constraints in Natural Language" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> 

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
              <span id="alg1.l18.3" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l18.4" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l18.m1" class="ltx_Math" alttext="\it q^{\prime}{=}\mathsf{SA}(\phi^{\prime},\psi^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝖲𝖠</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>ψ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it q^{\prime}{=}\mathsf{SA}(\phi^{\prime},\psi^{\prime})</annotation></semantics></math> <span id="alg1.l18.5" class="ltx_text ltx_font_bold">and</span> (<math id="alg1.l18.m2" class="ltx_Math" alttext="\it D\models(\phi\rightarrow\psi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo stretchy="false">→</mo><msup><mi>ψ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\it D\models(\phi\rightarrow\psi^{\prime})</annotation></semantics></math> <span id="alg1.l18.6" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l18.m3" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\phi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\phi^{\prime})</annotation></semantics></math> <span id="alg1.l18.7" class="ltx_text ltx_font_bold">or</span> <math id="alg1.l18.m4" class="ltx_Math" alttext="\it D\models\neg(\phi\wedge\psi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊧</mo><mrow><mo>¬</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>∧</mo><msup><mi>ψ</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\it D\models\neg(\phi\wedge\psi^{\prime})</annotation></semantics></math>) <span id="alg1.l18.8" class="ltx_text ltx_font_bold">then</span> 

</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
               <span id="alg1.l19.3" class="ltx_text ltx_font_bold">goto</span> <a href="#alg1.l3" title="In Algorithm 1 ‣ A.2 Constrained Planning Problem Generator ‣ Appendix A Reasoning Engine ‣ LexiCon: a Benchmark for Planningunder Temporal Constraints in Natural Language" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> 
  
</div>
<div id="alg1.l20" class="ltx_listingline">
