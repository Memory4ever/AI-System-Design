            <span id="alg1.l20.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l20.m1" class="ltx_Math" alttext="\it C\cup\{q\}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\it C\cup\{q\}</annotation></semantics></math> 

