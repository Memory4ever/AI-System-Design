<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center"><span id="S4.T2.2.3.2.1" class="ltx_text ltx_font_bold">91.5</span></td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.3.3.1" class="ltx_text ltx_underline">95.2</span></td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_center">3.2</td>
