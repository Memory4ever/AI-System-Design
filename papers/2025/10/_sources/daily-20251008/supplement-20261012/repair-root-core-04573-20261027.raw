<th id="S4.T2.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LLaMA 8B SFT</th>
<td id="S4.T2.2.5.2" class="ltx_td ltx_align_center">46.7</td>
<td id="S4.T2.2.5.3" class="ltx_td ltx_align_center">65.3</td>
<td id="S4.T2.2.5.4" class="ltx_td ltx_align_center">3.0</td>
