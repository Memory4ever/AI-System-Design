<td id="S4.T2.2.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.6.2.1" class="ltx_text ltx_underline">76.6</span></td>
<td id="S4.T2.2.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.6.3.1" class="ltx_text ltx_font_bold">96.4</span></td>
<td id="S4.T2.2.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.6.4.1" class="ltx_text ltx_font_bold">7.3</span></td>
<td id="S4.T2.2.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.6.5.1" class="ltx_text ltx_underline">38.5</span></td>
<td id="S4.T2.2.6.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.6.6.1" class="ltx_text ltx_font_bold">75.2</span></td>
<td id="S4.T2.2.6.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.6.7.1" class="ltx_text ltx_font_bold">8.9</span></td></tr>
