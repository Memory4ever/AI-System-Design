<td id="S4.T2.2.4.2" class="ltx_td ltx_align_center"><span id="S4.T2.2.4.2.1" class="ltx_text ltx_underline">51.2</span></td>
<td id="S4.T2.2.4.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.4.3.1" class="ltx_text ltx_underline">75.2</span></td>
<td id="S4.T2.2.4.4" class="ltx_td ltx_align_center"><span id="S4.T2.2.4.4.1" class="ltx_text ltx_underline">5.4</span></td>
<td id="S4.T2.2.4.5" class="ltx_td ltx_align_center"><span id="S4.T2.2.4.5.1" class="ltx_text ltx_underline">34.4</span></td>
<td id="S4.T2.2.4.6" class="ltx_td ltx_align_center"><span id="S4.T2.2.4.6.1" class="ltx_text ltx_underline">45.2</span></td>
<td id="S4.T2.2.4.7" class="ltx_td ltx_align_center"><span id="S4.T2.2.4.7.1" class="ltx_text ltx_underline">6.2</span></td></tr>
