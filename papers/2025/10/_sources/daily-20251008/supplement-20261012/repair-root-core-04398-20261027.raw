<td id="S3.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T3.5.2.4.1" class="ltx_text ltx_font_bold">Rec</span></td>
<td id="S3.T3.5.2.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T3.5.2.5.1" class="ltx_text ltx_font_bold">F1</span></td>
<td id="S3.T3.5.2.6" class="ltx_td ltx_align_center ltx_border_tt"><math id="S3.T3.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math></td></tr>
<tr id="S3.T3.5.3" class="ltx_tr">
<td id="S3.T3.5.3.1" class="ltx_td ltx_align_center ltx_border_t">Human A</td>
<td id="S3.T3.5.3.2" class="ltx_td ltx_align_center ltx_border_t">0.865</td>
<td id="S3.T3.5.3.3" class="ltx_td ltx_align_center ltx_border_t">0.774</td>
<td id="S3.T3.5.3.4" class="ltx_td ltx_align_center ltx_border_t">1.000</td>
<td id="S3.T3.5.3.5" class="ltx_td ltx_align_center ltx_border_t">0.873</td>
<td id="S3.T3.5.3.6" class="ltx_td ltx_align_center ltx_border_t">0.735</td></tr>
<tr id="S3.T3.5.4" class="ltx_tr">
<td id="S3.T3.5.4.1" class="ltx_td ltx_align_center ltx_border_bb">Human B</td>
