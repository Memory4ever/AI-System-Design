<td id="S3.T3.5.4.5" class="ltx_td ltx_align_center ltx_border_bb">0.808</td>
<td id="S3.T3.5.4.6" class="ltx_td ltx_align_center ltx_border_bb">0.629</td></tr>
</table></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
