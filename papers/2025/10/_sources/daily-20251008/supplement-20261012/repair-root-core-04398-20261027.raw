<td id="S3.T3.5.1.2" class="ltx_td"></td></tr>
<tr id="S3.T3.5.2" class="ltx_tr">
<td id="S3.T3.5.2.1" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T3.5.2.1.1" class="ltx_text ltx_font_bold">Baseline</span></td>
