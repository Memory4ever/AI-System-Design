<td id="S4.T1.4.2.6" class="ltx_td ltx_align_center ltx_border_t">0.880</td></tr>
<tr id="S4.T1.4.3" class="ltx_tr">
<th id="S4.T1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">CoT</th>
<td id="S4.T1.4.3.2" class="ltx_td ltx_align_center">0.905</td>
<td id="S4.T1.4.3.3" class="ltx_td ltx_align_center">1</td>
<td id="S4.T1.4.3.4" class="ltx_td ltx_align_center">0.377</td>
<td id="S4.T1.4.3.5" class="ltx_td ltx_align_center">1</td>
<td id="S4.T1.4.3.6" class="ltx_td ltx_align_center">0.761</td></tr>
