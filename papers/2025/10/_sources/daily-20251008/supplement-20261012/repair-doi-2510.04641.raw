{"data":{"id":"10.48550/arxiv.2510.04641","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.04641","prefix":"10.48550","suffix":"arxiv.2510.04641","identifiers":[{"identifier":"2510.04641","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.04641"}],"creators":[{"name":"Majumdar, Ayan","nameType":"Personal","givenName":"Ayan","familyName":"Majumdar","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Feihao","nameType":"Personal","givenName":"Feihao","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Jinghui","nameType":"Personal","givenName":"Jinghui","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xiaozhen","nameType":"Personal","givenName":"Xiaozhen","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating LLMs for Demographic-Targeted Social Bias Detection: A Comprehensive Benchmark Study"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computers and Society (cs.CY)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-06T09:45:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T01:23:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T15:04:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T02:02:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-09T11:53:02Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-10T00:48:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large-scale web-scraped text corpora used to train general-purpose AI models often contain harmful demographic-targeted social biases, creating a regulatory need for data auditing and developing scalable bias-detection methods. Although prior work has investigated biases in text datasets and related detection methods, these studies remain narrow in scope. They typically focus on a single content type (e.g., hate speech), cover limited demographic axes, overlook biases affecting multiple demographics simultaneously, and analyze limited techniques. Consequently, practitioners lack a holistic understanding of the strengths and limitations of recent large language models (LLMs) for automated bias detection. In this study, we conduct a comprehensive benchmark study on English texts to assess the ability of LLMs in detecting demographic-targeted social biases. To align with regulatory requirements, we frame bias detection as a multi-label task of detecting targeted identities using a demographic-focused taxonomy. We then systematically evaluate models across scales and techniques, including prompting, in-context learning, and fine-tuning. Using twelve datasets spanning diverse content types and demographics, our study demonstrates the promise of fine-tuned smaller models for scalable detection. However, our analyses also expose persistent gaps across demographic axes and multi-demographic targeted biases, underscoring the need for more effective and scalable detection frameworks.","descriptionType":"Abstract"},{"description":"19 pages","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.04641","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T03:19:27.000Z","registered":"2025-10-07T03:19:28.000Z","published":"2025","updated":"2026-04-10T02:24:33.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.04641","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}