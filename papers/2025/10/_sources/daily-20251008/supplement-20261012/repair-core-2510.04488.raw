<td id="A7.T12.2.3.3" class="ltx_td ltx_align_center">0.44</td>
<td id="A7.T12.2.3.4" class="ltx_td ltx_align_center">0.46</td>
<td id="A7.T12.2.3.5" class="ltx_td ltx_align_center">0.82</td>
<td id="A7.T12.2.3.6" class="ltx_td ltx_align_center">0.37</td></tr>
