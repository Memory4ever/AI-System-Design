</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F1.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2510.04488v1/FIG_G1_Q_Improv.png" id="S4.F1.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:673/153;" width="673" height="153" alt="Refer to caption">
