</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A1.F5.fig3" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2510.05598v1/tooldistribution_sports.svg" id="A1.F5.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
