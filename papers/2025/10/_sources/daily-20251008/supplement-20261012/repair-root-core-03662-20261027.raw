<th id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">o3 (zero-shot)</th>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_center">70%</td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_center">89%</td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_align_center">6.37</td></tr>
