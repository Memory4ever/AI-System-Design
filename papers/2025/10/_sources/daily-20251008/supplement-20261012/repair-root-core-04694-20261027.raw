<figure id="A1.F7" class="ltx_figure ltx_figure_panel ltx_align_center ltx_align_middle" style="width:198.7pt;"><img src="2510.04694v1/images/phimoe_entropy.png" id="A1.SS5.g3" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_landscape" style="aspect-ratio:274/204;" width="274" height="204" alt="Refer to caption">
