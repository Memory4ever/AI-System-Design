</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A1.F6" class="ltx_figure ltx_figure_panel ltx_align_center ltx_align_middle" style="width:198.7pt;"><img src="2510.04694v1/x1.png" id="A1.SS5.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:274/222;" width="274" height="222" alt="Refer to caption">
<br class="ltx_break ltx_break">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure A.6: </span>Caption for figure 4.</figcaption>
