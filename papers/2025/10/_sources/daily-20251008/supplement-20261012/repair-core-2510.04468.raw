<td id="S5.T6.5.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Bug Reports</td>
<td id="S5.T6.5.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S5.T6.m1" class="ltx_Math" alttext="q,d^{+}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>,</mo><msup><mi>d</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">q,d^{+}</annotation></semantics></math> Pairs</td>
<td id="S5.T6.5.1.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><math id="S5.T6.m2" class="ltx_Math" alttext="q,d^{-}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>,</mo><msup><mi>d</mi><mo>−</mo></msup></mrow><annotation encoding="application/x-tex">q,d^{-}</annotation></semantics></math> Pairs</td>
<td id="S5.T6.5.1.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Total</td></tr>
<tr id="S5.T6.5.2" class="ltx_tr">
<td id="S5.T6.5.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_tt">Training</td>
<td id="S5.T6.5.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">5,236</td>
<td id="S5.T6.5.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">12,727</td>
<td id="S5.T6.5.2.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">50,908</td>
<td id="S5.T6.5.2.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">63,635</td></tr>
<tr id="S5.T6.5.3" class="ltx_tr">
<td id="S5.T6.5.3.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t">Test</td>
<td id="S5.T6.5.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">1,501</td>
<td id="S5.T6.5.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">3,820</td>
<td id="S5.T6.5.3.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">15,280</td>
