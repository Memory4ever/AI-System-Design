<td id="S5.T4.5.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">748</td>
<td id="S5.T4.5.2.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">1,497</td>
<td id="S5.T4.5.2.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">7,483</td></tr>
<tr id="S5.T4.5.3" class="ltx_tr">
