<td id="S5.T7.5.1.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">HIT@5</td>
<td id="S5.T7.5.1.6" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">HIT@10</td></tr>
