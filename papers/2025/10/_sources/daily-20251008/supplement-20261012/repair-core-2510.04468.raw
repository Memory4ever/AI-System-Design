<td id="S5.T11.5.1.1.1.6.2" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T11.5.1.1.1.6.2.1" class="ltx_text" style="font-size:90%;">0.0228</span></td>
