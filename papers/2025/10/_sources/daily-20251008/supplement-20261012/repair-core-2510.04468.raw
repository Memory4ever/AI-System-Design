<td id="S5.T11.5.1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T11.5.1.1.1.1.1.1" class="ltx_text" style="font-size:90%;">IQLoc <span id="S5.T11.5.1.1.1.1.1.1.1" class="ltx_text ltx_font_italic">vs</span></span></td>
