<td id="S4.T1.6.1.6.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#ECECEC;"><span id="S4.T1.6.1.6.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">0.414</span></td></tr>
<tr id="S4.T1.6.1.7" class="ltx_tr">
<th id="S4.T1.6.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="4"><span id="S4.T1.6.1.7.1.1" class="ltx_text">
