<th id="A3.T8.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A3.T8.2.5.1.1" class="ltx_text ltx_font_typewriter">vi</span></th>
<td id="A3.T8.2.5.2" class="ltx_td ltx_nopad_r ltx_align_center">17,550</td></tr>
