<td id="S4.F5.1.3.3" class="ltx_td ltx_align_center ltx_border_t">59.4</td>
<td id="S4.F5.1.3.4" class="ltx_td ltx_align_center ltx_border_t">38.5</td>
<td id="S4.F5.1.3.5" class="ltx_td ltx_align_center ltx_border_t">43.3</td></tr>
<tr id="S4.F5.1.4" class="ltx_tr">
<td id="S4.F5.1.4.1" class="ltx_td ltx_align_center">QI</td>
<td id="S4.F5.1.4.2" class="ltx_td ltx_align_center">37.2</td>
<td id="S4.F5.1.4.3" class="ltx_td ltx_align_center">60.2</td>
<td id="S4.F5.1.4.4" class="ltx_td ltx_align_center">37.3</td>
<td id="S4.F5.1.4.5" class="ltx_td ltx_align_center">43.9</td></tr>
<tr id="S4.F5.1.5" class="ltx_tr">
