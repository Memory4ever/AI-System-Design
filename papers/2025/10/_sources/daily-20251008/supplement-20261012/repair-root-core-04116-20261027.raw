<td id="S4.F5.1.5.2" class="ltx_td ltx_align_center">50.0</td>
<td id="S4.F5.1.5.3" class="ltx_td ltx_align_center">66.2</td>
<td id="S4.F5.1.5.4" class="ltx_td ltx_align_center">45.7</td>
<td id="S4.F5.1.5.5" class="ltx_td ltx_align_center">47.1</td></tr>
