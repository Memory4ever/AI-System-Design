<td id="A3.T3.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"># Test</td>
<td id="A3.T3.1.1.5" class="ltx_td ltx_align_center ltx_border_tt">Description</td></tr>
<tr id="A3.T3.1.2" class="ltx_tr">
<td id="A3.T3.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="4"><span id="A3.T3.1.2.1.1" class="ltx_text">Math Q&amp;A</span></td>
<td id="A3.T3.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="4"><span id="A3.T3.1.2.2.1" class="ltx_text">5053</span></td>
<td id="A3.T3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">GSM8K</td>
<td id="A3.T3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">1319</td>
<td id="A3.T3.1.2.5" class="ltx_td ltx_align_left ltx_border_t">Grade school math.</td></tr>
<tr id="A3.T3.1.3" class="ltx_tr">
<td id="A3.T3.1.3.1" class="ltx_td ltx_align_center">MATH-500</td>
<td id="A3.T3.1.3.2" class="ltx_td ltx_align_center">500</td>
<td id="A3.T3.1.3.3" class="ltx_td ltx_align_left">High school math.</td></tr>
<tr id="A3.T3.1.4" class="ltx_tr">
<td id="A3.T3.1.4.1" class="ltx_td ltx_align_center">AMC</td>
<td id="A3.T3.1.4.2" class="ltx_td ltx_align_center">83</td>
