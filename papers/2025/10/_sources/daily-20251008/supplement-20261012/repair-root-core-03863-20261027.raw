<tr id="A3.T3.2.9" class="ltx_tr">
<td id="A3.T3.2.9.1" class="ltx_td ltx_align_left" style="padding-top:1.5pt;padding-bottom:1.5pt;">scene/script</td>
<td id="A3.T3.2.9.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="A3.T3.2.9.2.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="A3.T3.2.9.2.1.1" class="ltx_p"><math id="A3.T3.m6" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math></span>
</span></td>
<td id="A3.T3.2.9.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="A3.T3.2.9.3.1" class="ltx_inline-block ltx_align_top" style="width:247.5pt;">
<span id="A3.T3.2.9.3.1.1" class="ltx_p"><span id="A3.T3.2.9.3.1.1.1" class="ltx_text ltx_font_typewriter">"generate.py"</span></span>
