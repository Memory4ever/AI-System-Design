            <span id="lstnumberx22.2" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx22.3" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#7F0055;">"values"</span><span id="lstnumberx22.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx22.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.6" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx22.7" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#7F0055;">"1"</span><span id="lstnumberx22.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx22.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.10" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#7F0055;">"2"</span><span id="lstnumberx22.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx22.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.13" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#7F0055;">"3"</span><span id="lstnumberx22.14" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx22.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.16" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#7F0055;">"4"</span><span id="lstnumberx22.17" class="ltx_text ltx_font_typewriter">]</span>
</div>
