<td id="A4.T5.2.1.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-top:1.25pt;padding-bottom:1.25pt;"><math id="A4.T5.m12" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math></td>
