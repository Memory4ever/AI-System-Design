<td id="S4.T5.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">79.86</td>
<td id="S4.T5.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t">51.70</td>
<td id="S4.T5.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t">44.25</td>
<td id="S4.T5.2.1.3.10" class="ltx_td ltx_align_center ltx_border_t">73.99</td></tr>
<tr id="S4.T5.2.1.4" class="ltx_tr">
<td id="S4.T5.2.1.4.1" class="ltx_td ltx_align_center">AdaR</td>
