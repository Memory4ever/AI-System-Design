<td id="S2.T1.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">27</td>
<td id="S2.T1.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">73</td>
<td id="S2.T1.6.1.3.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S2.T1.m3" class="ltx_Math" alttext="7.70" display="inline" intent=":literal"><semantics><mn>7.70</mn><annotation encoding="application/x-tex">7.70</annotation></semantics></math></td>
<td id="S2.T1.6.1.3.6" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S2.T1.m4" class="ltx_Math" alttext="25.71" display="inline" intent=":literal"><semantics><mn>25.71</mn><annotation encoding="application/x-tex">25.71</annotation></semantics></math></td>
<td id="S2.T1.6.1.3.7" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S2.T1.m5" class="ltx_Math" alttext="2.39" display="inline" intent=":literal"><semantics><mn>2.39</mn><annotation encoding="application/x-tex">2.39</annotation></semantics></math></td></tr>
<tr id="S2.T1.6.1.4" class="ltx_tr">
<td id="S2.T1.6.1.4.1" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;">Long-form PopQA</td>
<td id="S2.T1.6.1.4.2" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S2.T1.m6" class="ltx_Math" alttext="25.41" display="inline" intent=":literal"><semantics><mn>25.41</mn><annotation encoding="application/x-tex">25.41</annotation></semantics></math></td>
<td id="S2.T1.6.1.4.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">27</td>
