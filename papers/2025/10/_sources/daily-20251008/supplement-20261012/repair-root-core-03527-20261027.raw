<tr id="S4.T3.6.1.3" class="ltx_tr">
<th id="S4.T3.6.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.6.1.3.1.1" class="ltx_text ltx_font_bold">Method</span></th>
<td id="S4.T3.6.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.6.1.3.2.1" class="ltx_text ltx_font_bold">R<math id="S4.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T3.6.1.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.6.1.3.3.1" class="ltx_text ltx_font_bold">H<math id="S4.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T3.6.1.3.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.6.1.3.4.1" class="ltx_text ltx_font_bold">R<math id="S4.T3.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T3.6.1.3.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.6.1.3.5.1" class="ltx_text ltx_font_bold">H<math id="S4.T3.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
