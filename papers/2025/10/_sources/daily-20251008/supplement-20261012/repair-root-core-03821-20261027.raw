<tr id="S5.T3.2.4" class="ltx_tr">
<th id="S5.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:5.0pt;padding-right:5.0pt;">NS <math id="S5.T3.m2" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math></th>
<th id="S5.T3.2.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-left:5.0pt;padding-right:5.0pt;">5e-05</th>
