<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex76Xf.m2" class="ltx_Math" alttext="\displaystyle+\|\sum_{\tau_{1}=0}^{M}\cdots\sum_{\tau_{n}=0}^{M}\tilde{\mathrm{H}}^{(n)}(\tau_{1},\ldots,\tau_{n})\big(\tilde{\bm{x}}_{t-\tau_{1}}\otimes\cdots\otimes\tilde{\bm{x}}_{t-\tau_{n}}\big)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msub><mi>τ</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>M</mi></msup><mo lspace="0.167em" rspace="0.167em">⋯</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msub><mi>τ</mi><mi>n</mi></msub><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mi>M</mi></msup><mover accent="true"><mi>H</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>τ</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>τ</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">(</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mover accent="true"><mi>𝒙</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\|\sum_{\tau_{1}=0}^{M}\cdots\sum_{\tau_{n}=0}^{M}\tilde{\mathrm{H}}^{(n)}(\tau_{1},\ldots,\tau_{n})\big(\tilde{\bm{x}}_{t-\tau_{1}}\otimes\cdots\otimes\tilde{\bm{x}}_{t-\tau_{n}}\big)</annotation></semantics></math></td>
