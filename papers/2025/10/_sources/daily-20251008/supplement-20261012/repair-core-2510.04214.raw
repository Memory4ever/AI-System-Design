<div id="lstnumberx133" class="ltx_listingline"><span id="lstnumberx133.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Output</span><span id="lstnumberx133.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">format</span><span id="lstnumberx133.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx133.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">strictly</span><span id="lstnumberx133.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">follow</span><span id="lstnumberx133.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx133.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">format</span><span id="lstnumberx133.13" class="ltx_text ltx_font_typewriter">;</span><span id="lstnumberx133.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx133.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">score</span><span id="lstnumberx133.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">only</span><span id="lstnumberx133.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">needs</span><span id="lstnumberx133.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx133.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">provide</span><span id="lstnumberx133.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx133.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">final</span><span id="lstnumberx133.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx133.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">score</span><span id="lstnumberx133.32" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx134" class="ltx_listingline"><span id="lstnumberx134.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Analysis</span><span id="lstnumberx134.2" class="ltx_text ltx_font_typewriter">:***</span>
</div>
<div id="lstnumberx135" class="ltx_listingline"><span id="lstnumberx135.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Total</span><span id="lstnumberx135.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">score</span><span id="lstnumberx135.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx135.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">x</span><span id="lstnumberx135.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.8" class="ltx_text ltx_font_typewriter">(0-100</span><span id="lstnumberx135.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx135.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">number</span><span id="lstnumberx135.11" class="ltx_text ltx_font_typewriter">)</span>
