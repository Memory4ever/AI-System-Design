<th id="S3.T3.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_t"><span id="S3.T3.2.1.1.2.1" class="ltx_text ltx_font_bold">Fine-tune Stage</span></th>
<th id="S3.T3.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S3.T3.2.1.1.3.1" class="ltx_text ltx_font_bold">ROUGE-L</span></th>
<th id="S3.T3.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S3.T3.2.1.1.4.1" class="ltx_text ltx_font_bold">BERTScore</span></th>
<th id="S3.T3.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T3.m1" class="ltx_Math" alttext="\textsc{SummaC}_{\text{ZS}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_font_smallcaps">SummaC</mtext><mtext class="ltx_mathvariant_bold">ZS</mtext></msub><annotation encoding="application/x-tex">\textsc{SummaC}_{\text{ZS}}</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T3.2.1.2" class="ltx_tr">
<th id="S3.T3.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">——</th>
<th id="S3.T3.2.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">Qwen2.5-7B</th>
<td id="S3.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.334</td>
<td id="S3.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.765</td>
<td id="S3.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.518</td></tr>
<tr id="S3.T3.2.1.3" class="ltx_tr">
<th id="S3.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">——</th>
<th id="S3.T3.2.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">LLaMA3.1-8B</th>
<td id="S3.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_r">0.339</td>
