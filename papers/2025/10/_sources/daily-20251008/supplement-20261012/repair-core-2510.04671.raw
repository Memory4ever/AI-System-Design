</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
                <math id="alg1.l10.m1" class="ltx_Math" alttext="s\leftarrow\text{Sim}(k_{n},k_{f})" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">←</mo><mrow><mtext>Sim</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>n</mi></msub><mo>,</mo><msub><mi>k</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\leftarrow\text{Sim}(k_{n},k_{f})</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
