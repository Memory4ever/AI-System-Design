<div id="A3.T9.fig2.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:163.0pt;height:85.1pt;vertical-align:-41.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-57.5pt,30.0pt) scale(0.586225001960867,0.586225001960867) ;">
<table id="A3.T9.fig2.1.1" class="ltx_tabular ltx_align_middle">
