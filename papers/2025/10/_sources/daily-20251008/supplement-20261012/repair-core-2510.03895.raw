<dt id="A1.I2.ix42" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A1.I2.ix42.1" class="ltx_text ltx_font_bold">Stack Bowl Three</span></span></dt>
<dd class="ltx_item">
