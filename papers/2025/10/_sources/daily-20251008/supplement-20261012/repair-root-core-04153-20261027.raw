<td id="S2.T1.5.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="S2.T1.5.1.2.2.1" class="ltx_text">Standalone</span></td>
<td id="S2.T1.5.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t">Server-Only <cite class="ltx_cite ltx_citemacro_cite ltx_markedasmath">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite></td>
<td id="S2.T1.5.1.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t">Text-to-Image</td>
<td id="S2.T1.5.1.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span class="ltx_inline-block"><svg id="S2.T1.m8.pic1" class="ltx_picture ltx_markedasmath" height="10.09" overflow="visible" version="1.1" viewBox="0 0 10.09 10.09" width="10.09"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,10.09) matrix(1 0 0 -1 0 0) translate(5.04,0) translate(0,5.04)"><path style="fill:none" d="M 0 0 M 4.77 0 C 4.77 2.63 2.63 4.77 0 4.77 C -2.63 4.77 -4.77 2.63 -4.77 0 C -4.77 -2.63 -2.63 -4.77 0 -4.77 C 2.63 -4.77 4.77 -2.63 4.77 0 Z M 0 0"></path></g></svg></span></td>
<td id="S2.T1.5.1.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span class="ltx_inline-block"><svg id="S2.T1.m9.pic1" class="ltx_picture ltx_markedasmath" height="10.09" overflow="visible" version="1.1" viewBox="0 0 10.09 10.09" width="10.09"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,10.09) matrix(1 0 0 -1 0 0) translate(5.04,0) translate(0,5.04)"><path style="fill:none" d="M 0 0 M 4.77 0 C 4.77 2.63 2.63 4.77 0 4.77 C -2.63 4.77 -4.77 2.63 -4.77 0 C -4.77 -2.63 -2.63 -4.77 0 -4.77 C 2.63 -4.77 4.77 -2.63 4.77 0 Z M 0 0"></path></g></svg></span></td>
