<div id="lstnumberx25" class="ltx_listingline"><span id="lstnumberx25.1" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx25.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Then</span><span id="lstnumberx25.4" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx25.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I</span><span id="lstnumberx25.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">label</span><span id="lstnumberx25.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Factual</span><span id="lstnumberx25.11" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx25.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Question</span><span id="lstnumberx25.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">as</span><span id="lstnumberx25.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.16" class="ltx_text ltx_font_typewriter">‘</span><span id="lstnumberx25.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Not</span><span id="lstnumberx25.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Factual</span><span id="lstnumberx25.20" class="ltx_text ltx_font_typewriter">‘</span>
