<tr id="S1.T1.4.7" class="ltx_tr">
<td id="S1.T1.4.7.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_r" style="padding-left:1.0pt;padding-right:1.0pt;">MMLONG <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">Ma et al., 2024b</a>)</cite></td>
<td id="S1.T1.4.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_border_r" style="padding-left:1.0pt;padding-right:1.0pt;">multiple</td>
