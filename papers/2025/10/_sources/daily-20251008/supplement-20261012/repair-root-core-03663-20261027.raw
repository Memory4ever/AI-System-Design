</div>
<div id="lstnumberx51" class="ltx_listingline"><span id="lstnumberx51.1" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx51.2" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx51.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question</span><span id="lstnumberx51.4" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx51.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.6" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx51.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">What</span><span id="lstnumberx51.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">businesses</span><span id="lstnumberx51.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx51.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">located</span><span id="lstnumberx51.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">near</span><span id="lstnumberx51.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx51.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">proposed</span><span id="lstnumberx51.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx51.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">development</span><span id="lstnumberx51.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnum