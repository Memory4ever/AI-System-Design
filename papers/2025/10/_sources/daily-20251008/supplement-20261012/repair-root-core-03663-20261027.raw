<td id="S1.T1.4.10.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S1.T1.4.10.6.1" class="ltx_text" style="--ltx-fg-color:#006400;">✓</span></td>
