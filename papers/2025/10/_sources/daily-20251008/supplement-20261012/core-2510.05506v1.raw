<span id="S3.SS3.fig1.1.1.1.1.1" class="ltx_p"><span id="S3.SS3.fig1.1.1.1.1.1.1" class="ltx_text"><span class="ltx_inline-block"><svg id="S3.SS3.pic1" class="ltx_picture" height="527.3" overflow="visible" version="1.1" viewBox="0 0 1167.13 527.3" width="1167.13"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,527.3) matrix(1 0 0 -1 0 0) translate(150.69,0) translate(0,401.73)"><g stroke-width="0.4pt"><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M -150.41 -125.3 h 300.83 v 250.6 h -300.83 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -145.8 -3.46)"><foreignObject style="--ltx-fo-width:21.07em;--ltx-fo-height:8.97em;--ltx-fo-depth:8.47em;font-size:10pt;" height="241.38" overflow="visible" transform="matrix(1 0 0 -1 0 124.15)" width="291.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
