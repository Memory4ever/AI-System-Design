<td id="S3.SS1.pic1.2.1.1" class="ltx_td ltx_align_center">Instance/Part Segmentations</td></tr>
<tr id="S3.SS1.pic1.2.2" class="ltx_tr">
<td id="S3.SS1.pic1.2.2.1" class="ltx_td ltx_align_center"><img src="2510.05506v1/im2.png" id="S3.SS1.pic1.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:236/197;" width="236" height="197" alt="Refer to caption"></td></tr>
</table></span></span></foreignObject></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 636.99 -113.9 h 266.44 v 227.81 h -266.44 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 641.6 -3.46)"><foreignObject style="--ltx-fo-width:18.59em;--ltx-fo-height:8.15em;--ltx-fo-depth:7.65em;font-size:10pt;" height="218.59" overflow="visible" transform="matrix(1 0 0 -1 0 112.75)" width="257.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<table id="S3.SS1.pic1.3" class="ltx_tabular ltx_align_middle">
<tr id="S3.SS1.pic1.3.1" class="ltx_tr">
<td id="S3.SS1.pic1.3.1.1" class="ltx_td ltx_align_center">Instance Mask Denoising</td></tr>
<tr id="S3.SS1.pic1.3.2" class="ltx_tr">
