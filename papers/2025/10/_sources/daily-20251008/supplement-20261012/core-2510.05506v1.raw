</table></span></span></foreignObject></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 251.88 -113.9 h 266.44 v 227.81 h -266.44 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 256.5 -3.46)"><foreignObject style="--ltx-fo-width:18.59em;--ltx-fo-height:8.15em;--ltx-fo-depth:7.65em;font-size:10pt;" height="218.59" overflow="visible" transform="matrix(1 0 0 -1 0 112.75)" width="257.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
