</table></span></span></foreignObject></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 269.08 -98.43 h 275.59 v 196.85 h -275.59 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 313.12 -29.73)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 73.81)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 45.12)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 16.11 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 45.12)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 39.54)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 45.12)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.61)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 40.21 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 19.61)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.61)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:2.55em;--ltx-fo-height:0.67em;--ltx-fo-depth:0em;font-size:21.2pt;" height="19.61" overflow="visible" transform="matrix(1 0 0 -1 0 19.61)" width="74.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.2" class="ltx_text ltx_font_italic" style="font-size:207%;">T-Net</span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 39.54)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.51em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:20.74pt;" height="25.51" overflow="visible" transform="matrix(1 0 0 -1 0 19.93)" width="158.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.3" class="ltx_text ltx_font_italic" style="font-size:207%;">Embeddings<span id="S3.SS3.pic1.3.1" class="ltx_text ltx_font_upright"> </span></span></span></span></foreignObject></g></g></g></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 66.64)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.53em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:20.74pt;" height="28.7" overflow="visible" transform="matrix(1 0 0 -1 0 21.52)" width="187.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.4" class="ltx_text ltx_font_italic" style="font-size:207%;">(B, T, N, 2C)<span id="S3.SS3.pic1.4.1" class="ltx_text ltx_font_upright"> </span></span></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 663.33 -98.43 h 275.59 v 196.85 h -275.59 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 669.66 -92.6)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 185.2)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 182.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 185.2)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.93)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:9.04em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:21.2pt;" height="25.51" overflow="visible" transform="matrix(1 0 0 -1 0 19.93)" width="265.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.5" class="ltx_text ltx_font_italic" style="font-size:207%;">Input Voxel Mapping</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 182.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 51.05 0)"><foreignObject style="--ltx-fo-width:11.62em;--ltx-fo-height:11.35em;--ltx-fo-depth:0.19em;font-size:10pt;" height="159.69" overflow="visible" transform="matrix(1 0 0 -1 0 157)" width="160.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2510.05506v1/im14.png" id="S3.SS3.pic1.g2" class="ltx_graphics ltx_img_square" style="aspect-ratio:157/157;" width="157" height="157" alt="Refer to caption">;</span></span></foreignObject></g></g></g></g></g></g></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M -137.8 -401.45 h 275.59 v 196.85 h -275.59 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -95.26 -325.58)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 45.12)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 25.19)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 49.93 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 25.19)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.61)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:3.21em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:20.74pt;" height="25.19" overflow="visible" transform="matrix(1 0 0 -1 0 19.61)" width="92.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.6" class="ltx_text ltx_font_italic" style="font-size:207%;">Sparse<span id="S3.SS3.pic1.6.1" class="ltx_text ltx_font_upright"> </span></span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 45.12)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.54em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:21.2pt;" height="19.93" overflow="visible" transform="matrix(1 0 0 -1 0 19.93)" width="191.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.7" class="ltx_text ltx_font_italic" style="font-size:207%;">CNN Backbone</span></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 256.46 -401.45 h 352.84 v 196.85 h -352.84 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 261.07 -394.27)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 182.51)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 19.93)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:11.97em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:20.74pt;" height="25.51" overflow="visible" transform="matrix(1 0 0 -1 0 19.93)" width="343.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.8" class="ltx_text" style="font-size:207%;">Sparse Global Max Pooling</span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 182.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 73.31 0)"><foreignObject style="--ltx-fo-width:14.24em;--ltx-fo-height:11.35em;--ltx-fo-depth:0em;font-size:10pt;" height="157" overflow="visible" transform="matrix(1 0 0 -1 0 157)" width="197"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2510.05506v1/im15.png" id="S3.SS3.pic1.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:197/157;" width="197" height="157" alt="Refer to caption"></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF"><path d="M 727.97 -401.45 h 288.2 v 196.85 h -288.2 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 732.58 -341.37)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 76.7)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 28.7)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 28.7)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.52)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:7.92em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:20.74pt;" height="28.7" overflow="visible" transform="matrix(1 0 0 -1 0 21.52)" width="227.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.SS3.pic1.9" class="ltx_text" style="font-size:207%;">FC Layer: (1024 <math id="S3.SS3.pic1.m1" class="ltx_Math" alttext="\rightarrow Cl" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><annotation encoding="application/x-tex">\rightarrow Cl</annotation></semantics></math>)</span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 76.7)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 19.18 0)"><foreignObject style="--ltx-fo-width:17.39em;--ltx-fo-height:3.47em;--ltx-fo-depth:0em;font-size:10pt;" height="48" overflow="visible" transform="matrix(1 0 0 -1 0 48)" width="240.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2510.05506v1/im16.png" id="S3.SS3.pic1.g4" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:236/48;" width="236" height="48" alt="Refer to caption"></span></span></foreignObject></g></g></g></g></g><g fill-opacity="0.5" stroke-opacity="0.5" stroke-width="1.42264pt"><path style="fill:none" d="M 150.69 0 L 267.28 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.1381pt" transform="matrix(1.0 0.0 0.0 1.0 267.28 0)"><path style="fill:none" d="M -2.93 3.91 C -2.69 2.44 0 0.24 0.73 0 C 0 -0.24 -2.69 -2.44 -2.93 -3.91"></path></g></g><g fill-opacity="0.5" stroke-opacity="0.5" stroke-width="1.42264pt"><path style="fill:none" d="M 544.95 0 L 661.53 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.1381pt" transform="matrix(1.0 0.0 0.0 1.0 661.53 0)"><path style="fill:none" d="M -2.93 3.91 C -2.69 2.44 0 0.24 0.73 0 C 0 -0.24 -2.69 -2.44 -2.93 -3.91"></path></g></g><g fill-opacity="0.5" stroke-opacity="0.5" stroke-width="1.42264pt"><path style="fill:none" d="M 663.06 -98.7 L 139.56 -204.02"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.1381pt" transform="matrix(-0.98036 -0.19724 0.19724 -0.98036 139.56 -204.02)"><path style="fill:none" d="M -2.93 3.91 C -2.69 2.44 0 0.24 0.73 0 C 0 -0.24 -2.69 -2.44 -2.93 -3.91"></path></g></g><g fill-opacity="0.5" stroke-opacity="0.5" stroke-width="1.42264pt"><path style="fill:none" d="M 138.07 -303.02 L 254.66 -303.02"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.1381pt" transform="matrix(1.0 0.0 0.0 1.0 254.66 -303.02)"><path style="fill:none" d="M -2.93 3.91 C -2.69 2.44 0 0.24 0.73 0 C 0 -0.24 -2.69 -2.44 -2.93 -3.91"></path></g></g><g fill-opacity="0.5" stroke-opacity="0.5" stroke-width="1.42264pt"><path style="fill:none" d="M 609.58 -303.02 L 726.17 -303.02"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.1381pt" transform="matrix(1.0 0.0 0.0 1.0 726.17 -303.02)"><path style="fill:none" d="M -2.93 3.91 C -2.69 2.44 0 0.24 0.73 0 C 0 -0.24 -2.69 -2.44 -2.93 -3.91"></path></g></g></g></svg></span></span></span>
</span></span></span></p>
</span></div>
<figcaption class="ltx_caption ltx_font_italic">Figure 3: The proposed model for action recognition from human point clouds over time, where <math id="S3.SS3.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is the number of frames, <math id="S3.SS3.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> the numbers of points, <math id="S3.SS3.m3" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> the number of input channels, <math id="S3.SS3.m4" class="ltx_Math" alttext="Cl" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">Cl</annotation></semantics></math> the number of action class labels, and <math id="S3.SS3.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is the batch size.</figcaption>
</figure>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">The overall architecture consists of a frame-wise T-Net (Transformation Net) embedding layer, followed by a sparse convolutional neural network, global sparse max pooling in voxel-space, and a fully connected layer for classification, to be trained with a standard cross-entropy loss.
<br class="ltx_break"></p>
</div>
<section id="S3.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS3.SSS1.4" class="ltx_text">III-C</span>1 </span>T-Net Embeddings</h4>

<div id="S3.SS3.SSS1.p1" class="ltx_para">
<p id="S3.SS3.SSS1.p1.1" class="ltx_p">In order to obtain per-frame, per-point embeddings, in this work the T-Net model is adopted from PointNet <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>. The T-Net module predicts a transformation matrix <math id="S3.SS3.SSS1.p1.m1" class="ltx_Math" alttext="T\in\mathbb{R}^{C\times C}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow></msup></mrow><annotation encoding="application/x-tex">T\in\mathbb{R}^{C\times C}</annotation></semantics></math> for global aggregation of features from point clouds. Given an input <math id="S3.SS3.SSS1.p1.m2" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{R}^{B^{\prime}\times N\times C}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{R}^{B^{\prime}\times N\times C}</annotation></semantics></math>, with batch size <math id="S3.SS3.SSS1.p1.m3" class="ltx_Math" alttext="B^{\prime}=B*T" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">B^{\prime}=B*T</annotation></semantics></math> consisting of all individual frames in a sequence flattened over all sequences, the input is first transposed to <math id="S3.SS3.SSS1.p1.m4" class="ltx_Math" alttext="\mathbf{x}^{\top}\in\mathbb{R}^{B^{\prime}\times C\times N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}^{\top}\in\mathbb{R}^{B^{\prime}\times C\times N}</annotation></semantics></math>. Then, a series of multi-layer perceptron (MLP) operations with batch normalization (BN) and ReLU activations are applied, using weight matrices and bias values <math id="S3.SS3.SSS1.p1.m5" class="ltx_Math" alttext="W_{i},b_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>i</mi></msub><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">W_{i},b_{i}</annotation></semantics></math> for <math id="S3.SS3.SSS1.p1.m6" class="ltx_Math" alttext="1\leq i\leq 6" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">1\leq i\leq 6</annotation></semantics></math>:</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\mathbf{h}_{1}=\text{ReLU}(\text{BN}(\text{Conv1D}(\mathbf{x}^{\top};W_{1},b_{1})))\quad\text{$(B^{\prime}\times 64\times N$)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐡</mi><mn>1</mn></msub><mo>=</mo><mrow><mtext>ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>BN</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>Conv1D</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mo>⊤</mo></msup><mo>,</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>64</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{1}=\text{ReLU}(\text{BN}(\text{Conv1D}(\mathbf{x}^{\top};W_{1},b_{1})))\quad\text{$(B^{\prime}\times 64\times N$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\mathbf{h}_{2}=\text{ReLU}(\text{BN}(\text{Conv1D}(\mathbf{h}_{1};W_{2},b_{2})))\quad\text{$(B^{\prime}\times 128\times N$)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐡</mi><mn>2</mn></msub><mo>=</mo><mrow><mtext>ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>BN</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>Conv1D</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐡</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><msub><mi>b</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>128</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{2}=\text{ReLU}(\text{BN}(\text{Conv1D}(\mathbf{h}_{1};W_{2},b_{2})))\quad\text{$(B^{\prime}\times 128\times N$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\mathbf{h}_{3}=\text{ReLU}(\text{BN}(\text{Conv1D}(\mathbf{h}_{2};W_{3},b_{3})))\quad\text{ $(B^{\prime}\times 1024\times N$)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐡</mi><mn>3</mn></msub><mo>=</mo><mrow><mtext>ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>BN</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>Conv1D</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐡</mi><mn>2</mn></msub><mo>,</mo><msub><mi>W</mi><mn>3</mn></msub><mo>,</mo><msub><mi>b</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext> </mtext><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1024</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>N</mi></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{3}=\text{ReLU}(\text{BN}(\text{Conv1D}(\mathbf{h}_{2};W_{3},b_{3})))\quad\text{ $(B^{\prime}\times 1024\times N$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p1.2" class="ltx_p">A global feature vector is obtained using max pooling:</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_math_unparsed" alttext="\mathbf{g}=\max_{n=1,\dots,N}\mathbf{h}_{3}[:,:,n]\quad\text{($B^{\prime}\times 1024$)}" display="block" intent=":literal"><semantics><mrow><mi>𝐠</mi><mo>=</mo><munder><mi>max</mi><mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi></mrow></munder><msub><mi>𝐡</mi><mn>3</mn></msub><mrow><mo stretchy="false">[</mo><mo rspace="0em">:</mo><mo>,</mo><mo rspace="0em">:</mo><mo>,</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mrow><mtext>(</mtext><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1024</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\mathbf{g}=\max_{n=1,\dots,N}\mathbf{h}_{3}[:,:,n]\quad\text{($B^{\prime}\times 1024$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<br class="ltx_break">
<p id="S3.SS3.SSS1.p1.3" class="ltx_p">Three fully connected layers are used to predict a flattened transformation matrix:</p>
<table id="S3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\mathbf{z}_{1}=\text{ReLU}(\text{BN}(\text{FC}(\mathbf{g};W_{4},b_{4})))\quad\text{($B^{\prime}\times 512$)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐳</mi><mn>1</mn></msub><mo>=</mo><mrow><mtext>ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>BN</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>FC</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐠</mi><mo>,</mo><msub><mi>W</mi><mn>4</mn></msub><mo>,</mo><msub><mi>b</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>(</mtext><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>512</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{1}=\text{ReLU}(\text{BN}(\text{FC}(\mathbf{g};W_{4},b_{4})))\quad\text{($B^{\prime}\times 512$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="\mathbf{z}_{2}=\text{ReLU}(\text{BN}(\text{FC}(\mathbf{z}_{1};W_{5},b_{5})))\quad\text{($B^{\prime}\times 256$)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐳</mi><mn>2</mn></msub><mo>=</mo><mrow><mtext>ReLU</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>BN</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>FC</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>5</mn></msub><mo>,</mo><msub><mi>b</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>(</mtext><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mn>256</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}_{2}=\text{ReLU}(\text{BN}(\text{FC}(\mathbf{z}_{1};W_{5},b_{5})))\quad\text{($B^{\prime}\times 256$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="T_{\text{flat}}=\text{FC}(\mathbf{z}_{2};W_{6},b_{6})\quad\text{($B^{\prime}\times(C\cdot C)$)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mtext>flat</mtext></msub><mo>=</mo><mrow><mtext>FC</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mn>2</mn></msub><mo>,</mo><msub><mi>W</mi><mn>6</mn></msub><mo>,</mo><msub><mi>b</mi><mn>6</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>(</mtext><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">T_{\text{flat}}=\text{FC}(\mathbf{z}_{2};W_{6},b_{6})\quad\text{($B^{\prime}\times(C\cdot C)$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p1.4" class="ltx_p">The flattened matrix <math id="S3.SS3.SSS1.p1.m7" class="ltx_Math" alttext="T_{\text{flat}}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mtext>flat</mtext></msub><annotation encoding="application/x-tex">T_{\text{flat}}</annotation></semantics></math> is reshaped into <math id="S3.SS3.SSS1.p1.m8" class="ltx_Math" alttext="T\in\mathbb{R}^{B^{\prime}\times C\times C}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow></msup></mrow><annotation encoding="application/x-tex">T\in\mathbb{R}^{B^{\prime}\times C\times C}</annotation></semantics></math>
The transformation matrix is initialized as:</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="T_{\text{final}}=T+\mathbf{I}_{C}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mtext>final</mtext></msub><mo>=</mo><mrow><mi>T</mi><mo>+</mo><msub><mi>𝐈</mi><mi>C</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T_{\text{final}}=T+\mathbf{I}_{C},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p1.5" class="ltx_p">where <math id="S3.SS3.SSS1.p1.m9" class="ltx_Math" alttext="\mathbf{I}_{C}" display="inline" intent=":literal"><semantics><msub><mi>𝐈</mi><mi>C</mi></msub><annotation encoding="application/x-tex">\mathbf{I}_{C}</annotation></semantics></math> is the <math id="S3.SS3.SSS1.p1.m10" class="ltx_Math" alttext="C\times C" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">C\times C</annotation></semantics></math> identity matrix.</p>
</div>
<div id="S3.SS3.SSS1.p2" class="ltx_para">
<p id="S3.SS3.SSS1.p2.1" class="ltx_p">The output <math id="S3.SS3.SSS1.p2.m1" class="ltx_Math" alttext="T_{\text{final}}\in\mathbb{R}^{B^{\prime}\times C\times C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mtext>final</mtext></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow></msup></mrow><annotation encoding="application/x-tex">T_{\text{final}}\in\mathbb{R}^{B^{\prime}\times C\times C}</annotation></semantics></math> is used to transform the input point cloud using batch matrix multiplication, after which we concatenate the original features to retain both local and global information, i.e.</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_math_unparsed" alttext="y=x^{T}||(T\circ x^{T})" display="block" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><msup><mi>x</mi><mi>T</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>x</mi><mi>T</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y=x^{T}||(T\circ x^{T})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p2.2" class="ltx_p">where <math id="S3.SS3.SSS1.p2.m2" class="ltx_Math" alttext="\circ" display="inline" intent=":literal"><semantics><mo>∘</mo><annotation encoding="application/x-tex">\circ</annotation></semantics></math> denotes batch matrix multiplication and <math id="S3.SS3.SSS1.p2.m3" class="ltx_Math" alttext="||" display="inline" intent=":literal"><semantics><mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">⁣</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">||</annotation></semantics></math> denotes the concatenation operator, applied along the channel axis. The output is subsequently reshaped to <math id="S3.SS3.SSS1.p2.m4" class="ltx_Math" alttext="(B,T,N,2C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>T</mi><mo>,</mo><mi>N</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(B,T,N,2C)</annotation></semantics></math>. T-Net embeddings allow the model, at each frame, to obtain global point cloud information, which is difficult to obtain with sparse convolution without a large receptive field, requiring many layers or large kernel sizes. In the next model stage, voxel mapping is applied to the first three channels of <math id="S3.SS3.SSS1.p2.m5" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> corresponding to the original 3D coordinates.
<br class="ltx_break"></p>
</div>
</section>
<section id="S3.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS3.SSS2.4" class="ltx_text">III-C</span>2 </span>Sparse CNN Backbone</h4>

<div id="S3.SS3.SSS2.p1" class="ltx_para">
<p id="S3.SS3.SSS2.p1.1" class="ltx_p">Before presenting the proposed sparse CNN backbone, we first review sub-manifold sparse convolution <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite>, in 3D for completeness. We opt for the sub-manifold variant due to its computational efficiency, reducing the dilution effect of regular sparse convolution, which we restrict to sparse max pooling operations. For a grid size <math id="S3.SS3.SSS2.p1.m1" class="ltx_Math" alttext="(g_{x},g_{y},g_{z})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>x</mi></msub><mo>,</mo><msub><mi>g</mi><mi>y</mi></msub><mo>,</mo><msub><mi>g</mi><mi>z</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g_{x},g_{y},g_{z})</annotation></semantics></math>, each point <math id="S3.SS3.SSS2.p1.m2" class="ltx_Math" alttext="p=(p_{x},p_{y},p_{z})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>x</mi></msub><mo>,</mo><msub><mi>p</mi><mi>y</mi></msub><mo>,</mo><msub><mi>p</mi><mi>z</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p=(p_{x},p_{y},p_{z})</annotation></semantics></math> in each frame is mapped to a voxel location <math id="S3.SS3.SSS2.p1.m3" class="ltx_Math" alttext="(x^{\prime},y^{\prime},z^{\prime})\in\mathbb{Z}_{+}^{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>ℤ</mi><mo>+</mo><mn>3</mn></msubsup></mrow><annotation encoding="application/x-tex">(x^{\prime},y^{\prime},z^{\prime})\in\mathbb{Z}_{+}^{3}</annotation></semantics></math> by coordinate division by the grid size, rounding down. 
<br class="ltx_break">For a set of voxel-mapped points <math id="S3.SS3.SSS2.p1.m4" class="ltx_Math" alttext="P=\{p_{1},\ldots p_{N}\}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>N</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P=\{p_{1},\ldots p_{N}\}</annotation></semantics></math>, and a multi-channel kernel <math id="S3.SS3.SSS2.p1.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, for each point <math id="S3.SS3.SSS2.p1.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> mapped to a given voxel grid location <math id="S3.SS3.SSS2.p1.m7" class="ltx_Math" alttext="(x^{\prime},y^{\prime},z^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x^{\prime},y^{\prime},z^{\prime})</annotation></semantics></math>, sparse sub-manifold convolution enacts on point <math id="S3.SS3.SSS2.p1.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with kernel <math id="S3.SS3.SSS2.p1.m9" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> for output channel <math id="S3.SS3.SSS2.p1.m10" class="ltx_Math" alttext="c^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>′</mo></msup><annotation encoding="application/x-tex">c^{\prime}</annotation></semantics></math> for <math id="S3.SS3.SSS2.p1.m11" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> input channels as</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="p_{c}^{\prime}=\sum_{c=1}^{C}\sum_{k\in O(K)}K(k)_{c^{\prime},c}*A((x^{\prime},y^{\prime},z^{\prime})+k,c)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>c</mi><mo>′</mo></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><mi>C</mi></munderover><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>k</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>,</mo><mi>c</mi></mrow></msub></mrow></mrow></mrow><mo rspace="0.222em">∗</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>k</mi></mrow><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{c}^{\prime}=\sum_{c=1}^{C}\sum_{k\in O(K)}K(k)_{c^{\prime},c}*A((x^{\prime},y^{\prime},z^{\prime})+k,c)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S3.SS3.SSS2.p1.2" class="ltx_p">where <math id="S3.SS3.SSS2.p1.m12" class="ltx_Math" alttext="O(K)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(K)</annotation></semantics></math> are the offset location of kernel <math id="S3.SS3.SSS2.p1.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> with non-empty voxels relative to center location <math id="S3.SS3.SSS2.p1.m14" class="ltx_Math" alttext="(x^{\prime},y^{\prime},z^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo>,</mo><msup><mi>z</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x^{\prime},y^{\prime},z^{\prime})</annotation></semantics></math>, and <math id="S3.SS3.SSS2.p1.m15" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is an aggregation operation for all points falling into a given voxel for channel <math id="S3.SS3.SSS2.p1.m16" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, typically the mean or max value. For all sparse convolutions in the following, we assume the sub-manifold formulation, with no dilation, and zero-padding voxels to preserve the input resolution.
<br class="ltx_break">The proposed backbone is detailed in Table 1, with layer descriptions to follow, where we refer to the corresponding architecture as SP-HP-ConvoT (Sparse Convolution for Human Point Clouds over Time). Note that in Table 1, and Figure 4, output shapes are shown in dense voxelized form, but the sparse convolution data structure stores features per point, and their respective spatio-temporal grid and batch indices.</p>
</div>
<figure id="S3.SS3.SSS2.tab1" class="ltx_table">
<div id="S3.SS3.SSS2.tab1.1" class="ltx_inline-block ltx_transformed_outer" style="width:345.0pt;height:84.3pt;vertical-align:-41.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-359.7pt,87.9pt) scale(0.3,0.3) ;">
<p id="S3.SS3.SSS2.tab1.1.1" class="ltx_p"><span id="S3.SS3.SSS2.tab1.1.1.1" class="ltx_text">
<span id="S3.SS3.SSS2.tab1.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:1064.5pt;height:260pt;vertical-align:-127.5pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
