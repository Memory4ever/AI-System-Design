<th id="S4.T2.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T2.3.6.1.1" class="ltx_text" style="font-size:90%;">Center position (x-axis)</span></th>
<td id="S4.T2.3.6.2" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><math id="S4.T2.m5" class="ltx_Math" alttext="\bar{x}_{j}=(x^{(j)}_{0}+x^{(j)}_{1})/(2W)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathsize="0.900em">x</mi><mo>¯</mo></mover><mi mathsize="0.900em">j</mi></msub><mo mathsize="0.900em">=</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">x</mi><mn mathsize="0.900em">0</mn><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">j</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">x</mi><mn mathsize="0.900em">1</mn><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">j</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">W</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{x}_{j}=(x^{(j)}_{0}+x^{(j)}_{1})/(2W)</annotation></semantics></math></td></tr>
<tr id="S4.T2.3.7" class="ltx_tr">
<th id="S4.T2.3.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T2.3.7.1.1" class="ltx_text" style="font-size:90%;">Center position (y-axis)</span></th>
<td id="S4.T2.3.7.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><math id="S4.T2.m6" class="ltx_Math" alttext="\bar{y}_{j}=(y^{(j)}_{0}+y^{(j)}_{1})/(2H)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathsize="0.900em">y</mi><mo>¯</mo></mover><mi mathsize="0.900em">j</mi></msub><mo mathsize="0.900em">=</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">y</mi><mn mathsize="0.900em">0</mn><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">j</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">y</mi><mn mathsize="0.900em">1</mn><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">j</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">H</mi></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{y}_{j}=(y^{(j)}_{0}+y^{(j)}_{1})/(2H)</annotation></semantics></math></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:90%;"><span class="ltx_tag ltx_tag_table">Table 2: </span>Low-level features extracted from the sequence of bounding boxes <math id="S4.T2.m10" class="ltx_Math" alttext="\bm{b}_{j}=(x^{(j)}_{0},x^{(j)}_{1},y^{(j)}_{0},y^{(j)}_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒃</mi><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>y</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{b}_{j}=(x^{(j)}_{0},x^{(j)}_{1},y^{(j)}_{0},y^{(j)}_{1})</annotation></semantics></math>. <math id="S4.T2.m11" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> and <math id="S4.T2.m12" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> denotes the width and height of the input image.</figcaption>
</figure>
