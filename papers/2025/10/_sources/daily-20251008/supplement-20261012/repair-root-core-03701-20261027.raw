<td id="S4.T2.3.5.2" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><math id="S4.T2.m4" class="ltx_Math" alttext="h_{j}=(h^{(j)}_{1}-h^{(j)}_{0})/H" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">j</mi></msub><mo mathsize="0.900em">=</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msubsup><mi mathsize="0.900em">h</mi><mn mathsize="0.900em">1</mn><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">j</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em">−</mo><msubsup><mi mathsize="0.900em">h</mi><mn mathsize="0.900em">0</mn><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">j</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true" symmetric="true">/</mo><mi mathsize="0.900em">H</mi></mrow></mrow><annotation encoding="application/x-tex">h_{j}=(h^{(j)}_{1}-h^{(j)}_{0})/H</annotation></semantics></math></td></tr>
