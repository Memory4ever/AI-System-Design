<figure id="S4.F6.fig1" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:86.5pt;"><object type="image/svg+xml" data="2510.03701v1/fig_piza_arc_v4.svg" id="S4.F6.g1" class="ltx_graphics ltx_img_portrait" style="aspect-ratio:120/162;" width="120" height="162"></object>
