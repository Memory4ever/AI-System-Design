<td id="S3.T1.4.3.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.T1.m6" class="ltx_Math" alttext="0.93\pm 0.012" display="inline" intent=":literal"><semantics><mrow><mn>0.93</mn><mo>±</mo><mn>0.012</mn></mrow><annotation encoding="application/x-tex">0.93\pm 0.012</annotation></semantics></math></td>
<td id="S3.T1.4.3.3" class="ltx_td ltx_align_center ltx_border_r">83K</td></tr>
<tr id="S3.T1.4.4" class="ltx_tr">
<td id="S3.T1.4.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="S3.T1.4.4.1.1" class="ltx_text">24</span></td>
<td id="S3.T1.4.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">U-Net <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite></td>
<td id="S3.T1.4.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S3.T1.m7" class="ltx_Math" alttext="0.84\pm 0.097" display="inline" intent=":literal"><semantics><mrow><mn>0.84</mn><mo>±</mo><mn>0.097</mn></mrow><annotation encoding="application/x-tex">0.84\pm 0.097</annotation></semantics></math></td>
<td id="S3.T1.4.4.4" class="ltx_td ltx_align_center ltx_border_r">7.7M</td></tr>
