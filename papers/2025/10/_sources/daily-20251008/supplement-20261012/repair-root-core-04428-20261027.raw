<tr id="S4.T4.1.1.3" class="ltx_tr" style="--ltx-bg-color:#DFDFDF;">
<td id="S4.T4.1.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-2pt;padding-bottom:-2pt;"><span id="S4.T4.1.1.3.1.1" class="ltx_text" style="--ltx-bg-color:#DFDFDF;">2</span></td>
<td id="S4.T4.1.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-2pt;padding-bottom:-2pt;"><span id="S4.T4.1.1.3.2.1" class="ltx_text ltx_font_bold ltx_font_italic" style="--ltx-bg-color:#DFDFDF;">A.I.R.</span><span id="S4.T4.1.1.3.2.2" class="ltx_text" style="--ltx-bg-color:#DFDFDF;"> (Our full method)</span></td>
<td id="S4.T4.1.1.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-2pt;padding-bottom:-2pt;"><math id="S4.SS3.m3" class="ltx_Math" style="--ltx-bg-color:#DFDFDF;" alttext="24.8" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#DFDFDF;" mathbackground="#DFDFDF">24.8</mn><annotation encoding="application/x-tex">24.8</annotation></semantics></math></td>
<td id="S4.T4.1.1.3.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-2pt;padding-bottom:-2pt;"><math id="S4.SS3.m4" class="ltx_Math" style="--ltx-bg-color:#DFDFDF;" alttext="68.2" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#DFDFDF;" mathbackground="#DFDFDF">68.2</mn><annotation encoding="application/x-tex">68.2</annotation></semantics></math></td></tr>
<tr id="S4.T4.1.1.4" class="ltx_tr">
<td id="S4.T4.1.1.4.1" class="ltx_td ltx_align_center" style="padding-top:-2pt;padding-bottom:-2pt;">3</td>
