    <script>




        // Call the function on page load and window resize
        window.addEventListener('resize', updateImage);
        window.addEventListener('load', updateImage);

        const hamburger = document.querySelector('.hamburger');
        const fullscreenMenu = document.getElementById('fullscreen-menu');
        const closeMenuBtn = document.getElementById('close-menu');

        hamburger.addEventListener('click', () => {
            fullscreenMenu.classList.add('active');
        });

        closeMenuBtn.addEventListener('click', () => {
            fullscreenMenu.classList.remove('active');
        });

        function closeMenu() {
            fullscreenMenu.classList.remove('active');
        }



        function initMap() {
            const map = new google.maps.Map(document.getElementById("map"), {
                center: { lat: 45.44179506274163, lng: 12.329906252234844 }, // Ca' Tron coordinates
                zoom: 12,
                styles: mapstyle,
            });
        }

        // Load the map when the page finishes loading
        window.onload = initMap;

        // Add click event listener to the accordion header
        document.querySelectorAll('.accordion-header').forEach(header => {
            header.addEventListener('click', function () {
                const accordion = this.parentElement;

                // Toggle the "open" class
                accordion.classList.toggle('open');
            });
        });

        const typingSpeed = 100; // milliseconds per character
        const delayBetweenElements = 1000; // delay before starting the next element

        // Get all containers
        const containers = document.querySelectorAll('.typewriter-container');

        // Function to type text for a specific container
        function typeText(container, callback) {
            const originalText = container.querySelector('.typewriter-original').textContent;
            const displayElement = container.querySelector('.typewriter-text');
            let i = 0;

            // Clear any existing text
            displayElement.textContent = '';

            function typeChar() {
                if (i < originalText.length) {
                    displayElement.textContent += originalText.charAt(i);
                    i++;
                    setTimeout(typeChar, typingSpeed);
                } else {
                    // Typing complete
                    if (callback) setTimeout(callback, delayBetweenElements);
                }
            }

            // Start typing
            typeChar();
        }

        // Start typing sequentially
        function startTypewriters() {
            let index = 0;

            function typeNext() {
                if (index < containers.length) {
                    typeText(containers[index], typeNext);
                    index++;
                }
            }

            // Start with the first element
            typeNext();
        }

        // Initialize on page load
        window.addEventListener('load', startTypewriters);

        // Define scroll points and corresponding images - place this outside the functions
        const scrollPoints = [
            { point: 0, image: 'img/imgdesktop.svg' },
            { point: 800, image: 'img/animated_text_01.svg' },
            { point: 1500, image: 'img/animated_text_02.svg' },
            { point: 2200, image: 'img/animated_text_03.svg' },
            { point: 2900, image: 'img/animated_text_04.svg' },
            { point: 3600, image: 'img/animated_text_05.svg' },
            { point: 4300, image: 'img/animated_text_06.svg' }
        ];

        function handleScroll() {
            const image = document.getElementById('responsive-img');
            const scrollPosition = window.scrollY;

            // Skip scroll-based logic if on mobile
            if (window.innerWidth <= 1080) {
                image.src = 'img/posterminimal_tru.svg';
                return;
            }

            // Find the appropriate image based on scroll position
            let activePoint = scrollPoints[0]; // Default to first image

            for (const point of scrollPoints) {
                if (scrollPosition >= point.point) {
                    activePoint = point;
                } else {
                    break;
                }
            }

            // Update image source
            image.src = activePoint.image;
        }

        function updateImage() {
            // Call handleScroll which now contains all the image selection logic
            handleScroll();
        }

        // Call the functions on page load and window resize
        window.addEventListener('resize', updateImage);
        window.addEventListener('load', updateImage);
        window.addEventListener('scroll', handleScroll);

        // Function to create a looping typewriter effect for the nav title
        function createLoopingTypewriter() {
            // Get the original text from the hidden element
            const originalElement = document.querySelector('.nav-title .typewriter-original');
            const originalText = originalElement.textContent.trim(); // Ensure no extra spaces
            const displayElement = document.getElementById('titolo');

            // Configure timings
            const typingSpeed = 200;        // Speed of typing (ms per character)
            const deletingSpeed = 100;       // Speed of deleting (ms per character)
            const pauseBeforeDelete = 5000; // Pause before deletion starts (3 seconds)
            const pauseBeforeRestart = 1000; // Pause before retyping starts (1 second)

            // State tracking
            let isDeleting = false;
            let textIndex = 0;
            let timer;

            // Hide the original element and ensure display element is empty
            originalElement.style.display = 'none';
            displayElement.textContent = '';

            function animateText() {
                // Calculate the current substring of text to display
                const currentText = originalText.substring(0, textIndex);

                // Update the text in the display element
                displayElement.textContent = currentText;

                // Determine next action based on current state
                if (isDeleting) {
                    // When deleting, decrease the text index
                    textIndex--;
                } else {
                    // When typing, increase the text index
                    textIndex++;
                }

                // Determine the speed for the next iteration
                let nextDelay = isDeleting ? deletingSpeed : typingSpeed;

                // Handle state transitions
                if (!isDeleting && textIndex > originalText.length) {
                    // We've finished typing all characters
                    isDeleting = true;
                    textIndex = originalText.length; // Ensure we start deleting from the correct position
                    nextDelay = pauseBeforeDelete;
                } else if (isDeleting && textIndex < 0) {
                    // We've finished deleting all characters
                    isDeleting = false;
                    textIndex = 0; // Ensure we start typing from the beginning
                    nextDelay = pauseBeforeRestart;
                }

                // Schedule the next animation step
                timer = setTimeout(animateText, nextDelay);

                // For debugging
                console.log(`State: ${isDeleting ? 'Deleting' : 'Typing'}, Index: ${textIndex}, Text: "${currentText}"`);
            }

            // Start the animation
            animateText();

            // Return a function to stop the animation if needed
            return function () {
                clearTimeout(timer);
            };
        }

        // Start the animation when the page is fully loaded
        window.addEventListener('load', function () {
            createLoopingTypewriter();
        });

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener("click", function (e) {
                e.preventDefault(); // Prevent default jump
                const targetId = this.getAttribute("href").substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    const offset = 0; // Adjust this value as needed
                    const elementPosition = targetElement.getBoundingClientRect().top + window.scrollY;
                    window.scrollTo({
                        top: elementPosition - offset,
                        behavior: "smooth"
                    });
                }

                if (targetElement && window.innerWidth <= 1080) {
                    const offset = 60; // Adjust this value as needed
                    const elementPosition = targetElement.getBoundingClientRect().top + window.scrollY;
                    window.scrollTo({
                        top: elementPosition - offset,
                        behavior: "smooth"
                    });
                }
            });
        });
    </script>
</body>

</html>