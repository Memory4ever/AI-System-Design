<td id="S5.T2.3.1.3" class="ltx_td ltx_align_center ltx_border_t">LLM Baseline</td>
<td id="S5.T2.3.1.4" class="ltx_td ltx_align_center ltx_border_t">Manual Workflow</td></tr>
<tr id="S5.T2.3.2" class="ltx_tr">
<td id="S5.T2.3.2.1" class="ltx_td ltx_align_left ltx_border_t">Task 1</td>
<td id="S5.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t">4/4</td>
