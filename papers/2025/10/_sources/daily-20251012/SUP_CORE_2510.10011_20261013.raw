<td id="A1.T5.3.26.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.3.26.3.1" class="ltx_text" style="--ltx-fg-color:#009F6B;">✔</span></td>
<td id="A1.T5.3.26.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.3.26.4.1" class="ltx_text" style="--ltx-fg-color:#009F6B;">✔</span></td>
<td id="A1.T5.3.26.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.3.26.5.1" class="ltx_text" style="--ltx-fg-color:#009F6B;">✔</span></td>
<td id="A1.T5.3.26.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.3.26.6.1" class="ltx_text" style="--ltx-fg-color:#009F6B;">✔</span></td>
<td id="A1.T5.3.26.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="A1.T5.3.26.7.1" class="ltx_text" style="--ltx-fg-color:#009F6B;">✔</span></td>
