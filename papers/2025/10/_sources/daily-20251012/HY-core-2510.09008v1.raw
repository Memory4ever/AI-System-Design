<th id="A7.T8.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">CHAIR</th>
<th id="A7.T8.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3">POPE</th></tr>
<tr id="A7.T8.6.2" class="ltx_tr">
