<th id="S4.T1.7.1.2.16" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;"><math id="S4.T1.m9" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>%</th></tr>
