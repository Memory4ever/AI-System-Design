<th id="S4.T1.7.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">+Ours</th>
<th id="S4.T1.7.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 5.0pt;"><math id="S4.T1.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>%</th>
<th id="S4.T1.7.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">Orig.</th>
<th id="S4.T1.7.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">+Ours</th>
<th id="S4.T1.7.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 5.0pt;"><math id="S4.T1.m6" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>%</th>
<th id="S4.T1.7.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">Orig.</th>
<th id="S4.T1.7.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">+Ours</th>
<th id="S4.T1.7.1.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 5.0pt;"><math id="S4.T1.m7" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>%</th>
<th id="S4.T1.7.1.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">Orig.</th>
<th id="S4.T1.7.1.2.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 5.0pt;">+Ours</th>
<th id="S4.T1.7.1.2.13" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding:1pt 5.0pt;"><math id="S4.T1.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>%</th>
