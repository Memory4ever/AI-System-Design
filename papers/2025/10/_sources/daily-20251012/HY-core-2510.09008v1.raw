<td id="A7.T6.6.2.2" class="ltx_td ltx_align_center ltx_border_t">9.518<math id="A7.T6.m1" class="ltx_Math" alttext="\pm 0.011" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.011</mn></mrow><annotation encoding="application/x-tex">\pm 0.011</annotation></semantics></math></td></tr>
