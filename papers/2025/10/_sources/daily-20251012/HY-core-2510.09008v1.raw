<tbody class="ltx_tbody">
<tr id="S4.T1.7.1.3" class="ltx_tr">
<th id="S4.T1.7.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding:1pt 5.0pt;" rowspan="6"><span id="S4.T1.7.1.3.1.1" class="ltx_text">
<span id="S4.T1.7.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.8pt;height:62.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:62.9pt;transform:translate(-28.0pt,-28.0pt) rotate(-90deg) ;">
<span id="S4.T1.7.1.3.1.1.1.1" class="ltx_p">LLaVA-1.5-7B</span>
</span></span></span></th>
<th id="S4.T1.7.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:1pt 5.0pt;"><math id="S4.T1.m10" class="ltx_Math" alttext="C_{s}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>s</mi></msub><annotation encoding="application/x-tex">C_{s}</annotation></semantics></math> <math id="S4.T1.m11" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<td id="S4.T1.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 5.0pt;">47.4</td>
<td id="S4.T1.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFFFCC;padding:1pt 5.0pt;"><span id="S4.T1.7.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFCC;">29.2</span></td>
