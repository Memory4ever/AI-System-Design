<td id="S5.T2.10.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.10.1.2.7.1" class="ltx_text ltx_font_bold">Avg.</span></td>
<td id="S5.T2.10.1.2.8" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T2.10.1.2.8.1" class="ltx_text ltx_font_typewriter">Dolly</span></td>
<td id="S5.T2.10.1.2.9" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T2.10.1.2.9.1" class="ltx_text ltx_font_typewriter">Alpaca-GPT4</span></td>
