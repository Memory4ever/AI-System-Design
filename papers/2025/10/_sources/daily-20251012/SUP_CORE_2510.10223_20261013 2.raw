<span id="S4.Ex4"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex4.m1" class="ltx_math_unparsed" alttext="\displaystyle Z^{\mathrm{ref}}_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">Z</mi><msup><mrow></mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">ref</mi></msup><msub><mrow></mrow><mrow><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">1</mn><mo style="--ltx-bg-color:#F2F2F2;" lspace="0.278em" mathbackground="#F2F2F2" rspace="0.278em">:</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle Z^{\mathrm{ref}}_{1:k}</annotation></semantics></math></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex4.m2" class="ltx_Math" alttext="\displaystyle=\textsc{Logits}(p_{\theta},\mathbf{X},\tilde{\mathbf{y}},k)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">=</mo><mrow><mtext style="--ltx-bg-color:#F2F2F2;" class="ltx_font_smallcaps" mathbackground="#F2F2F2">Logits</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">(</mo><msub><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">p</mi><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">θ</mi></msub><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐗</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo><mover accent="true"><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐲</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">~</mo></mover><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">k</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\textsc{Logits}(p_{\theta},\mathbf{X},\tilde{\mathbf{y}},k)</annotation></semantics></math></span>
