<td id="S5.T2.10.1.2.2" class="ltx_td ltx_align_left"><span id="S5.T2.10.1.2.2.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="S5.T2.10.1.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T2.10.1.2.3.1" class="ltx_text ltx_font_typewriter">Agriculture</span></td>
