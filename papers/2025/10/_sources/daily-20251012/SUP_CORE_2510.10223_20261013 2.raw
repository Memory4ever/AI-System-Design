<span id="alg1.l10.2" class="ltx_inline-block ltx_minipage" style="width:178.9pt;">
<span id="alg1.l10.2.1" class="ltx_p"><span id="alg1.l10.2.1.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;">
<span id="alg1.l10.2.1.1.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:169.9pt;--ltx-bg-color:#F2F2F2;">
<span id="alg1.l10.2.1.1.1.1" class="ltx_p"><span id="alg1.l10.2.1.1.1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Static-Ref</span></span>
<span id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="S4.Ex1"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathbf{y}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐲</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">~</mo></mover><annotation encoding="application/x-tex">\displaystyle\tilde{\mathbf{y}}</annotation></semantics></math></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex1.m2" class="ltx_Math" alttext="\displaystyle=(\tilde{y}(x))_{x\in\mathbf{X}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">=</mo><msub><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">(</mo><mrow><mover accent="true"><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">y</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">(</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">x</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">)</mo></mrow><mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">x</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">∈</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐗</mi></mrow></msub></mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(\tilde{y}(x))_{x\in\mathbf{X}},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
<span id="S4.Ex2"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex2.m1" class="ltx_math_unparsed" alttext="\displaystyle Z^{\mathrm{ref}}_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">Z</mi><msup><mrow></mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">ref</mi></msup><msub><mrow></mrow><mrow><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">1</mn><mo style="--ltx-bg-color:#F2F2F2;" lspace="0.278em" mathbackground="#F2F2F2" rspace="0.278em">:</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle Z^{\mathrm{ref}}_{1:k}</annotation></semantics></math></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex2.m2" class="ltx_math_unparsed" alttext="\displaystyle=(z^{\mathrm{ref}}_{1:k}(x))_{x\in\mathbf{X}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">=</mo><msub><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">(</mo><msubsup><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">z</mi><mrow><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">1</mn><mo style="--ltx-bg-color:#F2F2F2;" lspace="0.278em" mathbackground="#F2F2F2" rspace="0.278em">:</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">k</mi></mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">ref</mi></msubsup><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">(</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">x</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">)</mo></mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">)</mo></mrow><mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">x</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">∈</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐗</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle=(z^{\mathrm{ref}}_{1:k}(x))_{x\in\mathbf{X}}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
