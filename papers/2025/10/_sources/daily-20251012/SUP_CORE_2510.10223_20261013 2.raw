<span id="alg1.l10.3.1.1" class="ltx_p"><span id="alg1.l10.3.1.1.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;">
<span id="alg1.l10.3.1.1.1.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:169.9pt;--ltx-bg-color:#F2F2F2;">
<span id="alg1.l10.3.1.1.1.1.1" class="ltx_p"><span id="alg1.l10.3.1.1.1.1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Dynamic-Ref</span></span>
