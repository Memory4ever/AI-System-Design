</span>
</span></span></span>
</span>
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
              Run <math id="alg1.l11.m1" class="ltx_Math" alttext="p_{\theta^{\prime}}(\mathbf{X},\tilde{\mathbf{y}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><msup><mi>θ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo>,</mo><mover accent="true"><mi>𝐲</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta^{\prime}}(\mathbf{X},\tilde{\mathbf{y}})</annotation></semantics></math>
<span id="alg1.l11.2" class="ltx_text" style="float:right;"><span id="alg1.l11.2.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#808080;">// base-model-forced (<span id="alg1.l11.2.1.1" class="ltx_text ltx_font_italic">Static-Ref</span>) / generated prefix (<span id="alg1.l11.2.1.2" class="ltx_text ltx_font_italic">Dynamic-Ref</span>)</span>
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
              Compute losses:
<math id="alg1.l12.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{IDA}},\mathcal{L}_{\mathrm{OCS}},\mathcal{L}_{\mathrm{KL}}\in\mathbb{R}^{B}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>IDA</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>OCS</mi></msub><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>KL</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>B</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{IDA}},\mathcal{L}_{\mathrm{OCS}},\mathcal{L}_{\mathrm{KL}}\in\mathbb{R}^{B}</annotation></semantics></math>
