<span id="S4.Ex3"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex3.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mathbf{y}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐲</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">~</mo></mover><annotation encoding="application/x-tex">\displaystyle\tilde{\mathbf{y}}</annotation></semantics></math></span>
<span class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex3.m2" class="ltx_Math" alttext="\displaystyle=\textsc{GenPrefix}(p_{\theta},\mathbf{X},k)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">=</mo><mrow><mtext style="--ltx-bg-color:#F2F2F2;" class="ltx_font_smallcaps" mathbackground="#F2F2F2">GenPrefix</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">(</mo><msub><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">p</mi><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">θ</mi></msub><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">𝐗</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">k</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\textsc{GenPrefix}(p_{\theta},\mathbf{X},k),</annotation></semantics></math></span>
