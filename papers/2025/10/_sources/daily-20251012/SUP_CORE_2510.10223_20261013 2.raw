<tr id="S5.T2.10.1.3" class="ltx_tr">
<td id="S5.T2.10.1.3.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="10"><span id="S5.T2.10.1.3.1.1" class="ltx_text ltx_font_smallcaps">Llama-3.2-3B</span></td>
<td id="S5.T2.10.1.3.2" class="ltx_td ltx_align_left ltx_border_t">Base Model</td>
<td id="S5.T2.10.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m3" class="ltx_Math" alttext="8.34" display="inline" intent=":literal"><semantics><mn>8.34</mn><annotation encoding="application/x-tex">8.34</annotation></semantics></math></td>
<td id="S5.T2.10.1.3.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m4" class="ltx_Math" alttext="22.02" display="inline" intent=":literal"><semantics><mn>22.02</mn><annotation encoding="application/x-tex">22.02</annotation></semantics></math></td>
<td id="S5.T2.10.1.3.5" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m5" class="ltx_Math" alttext="14.13" display="inline" intent=":literal"><semantics><mn>14.13</mn><annotation encoding="application/x-tex">14.13</annotation></semantics></math></td>
