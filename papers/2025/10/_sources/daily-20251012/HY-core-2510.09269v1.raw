<div id="S2.T1.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:60.1pt;vertical-align:-28.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-83.0pt,12.6pt) scale(0.705493413197751,0.705493413197751) ;">
