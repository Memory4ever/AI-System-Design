<td id="S5.T4.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T4.m8" class="ltx_Math" alttext="97.5\pm 0.8\%" display="inline" intent=":literal"><semantics><mrow><mn>97.5</mn><mo>±</mo><mrow><mn>0.8</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">97.5\pm 0.8\%</annotation></semantics></math></td>
