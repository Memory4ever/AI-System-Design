<td id="S5.T4.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><math id="S5.T4.m10" class="ltx_Math" alttext="32.5\pm 2.3\%" display="inline" intent=":literal"><semantics><mrow><mn>32.5</mn><mo>±</mo><mrow><mn>2.3</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">32.5\pm 2.3\%</annotation></semantics></math></td>
