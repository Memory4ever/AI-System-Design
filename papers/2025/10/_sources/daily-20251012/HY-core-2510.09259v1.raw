<th id="A2.T5.4.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CDD<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Dong et al., 2024</a>)</cite></th>
<td id="A2.T5.4.1.7.2" class="ltx_td ltx_align_center">0.67</td>
<td id="A2.T5.4.1.7.3" class="ltx_td ltx_align_center">0.51</td>
<td id="A2.T5.4.1.7.4" class="ltx_td ltx_align_center">0.67</td>
<td id="A2.T5.4.1.7.5" class="ltx_td ltx_align_center">0.43</td>
