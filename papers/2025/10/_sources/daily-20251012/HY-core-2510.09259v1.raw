<th id="S5.T4.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S5.T4.m7" class="ltx_Math" alttext="K\!=\!3" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.108em">=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">K\!=\!3</annotation></semantics></math></th>
<th id="S5.T4.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S5.T4.m8" class="ltx_Math" alttext="K\!=\!5" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.108em">=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">K\!=\!5</annotation></semantics></math></th>
<th id="S5.T4.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S5.T4.m9" class="ltx_Math" alttext="K\!=\!10" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.108em">=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">K\!=\!10</annotation></semantics></math></th>
<th id="S5.T4.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S5.T4.m10" class="ltx_Math" alttext="K\!=\!20" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.108em">=</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">K\!=\!20</annotation></semantics></math></th>
<th id="S5.T4.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S5.T4.m11" class="ltx_Math" alttext="K\!=\!50" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0.108em">=</mo><mn>50</mn></mrow><annotation encoding="application/x-tex">K\!=\!50</annotation></semantics></math></th>
<th id="S5.T4.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T4.2.1.7.1" class="ltx_text ltx_font_bold">Variance</span></th></tr>
