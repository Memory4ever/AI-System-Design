<tr id="A2.T5.4.1.6" class="ltx_tr">
<th id="A2.T5.4.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Recall<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib43" title="" class="ltx_ref">Xie et al., 2024b</a>)</cite></th>
