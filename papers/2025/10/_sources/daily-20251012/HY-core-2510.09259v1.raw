<td id="A2.T5.4.1.10.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T5.4.1.10.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6FF;">0.74 (<math id="A2.T5.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#408827;--ltx-bg-color:#E6E6FF;" mathbackground="#E6E6FF" mathcolor="#408827" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math><span id="A2.T5.4.1.10.6.1.1" class="ltx_text" style="--ltx-fg-color:#408827;"> 30%</span>)</span></td></tr>
