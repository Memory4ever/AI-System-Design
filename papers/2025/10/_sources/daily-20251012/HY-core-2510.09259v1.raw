<td id="A2.T5.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.60</td>
<td id="A2.T5.4.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.55</td>
<td id="A2.T5.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T5.4.1.3.6.1" class="ltx_text ltx_underline">0.57</span></td></tr>
<tr id="A2.T5.4.1.4" class="ltx_tr">
<th id="A2.T5.4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Min-K%<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Shi et al., 2024</a>)</cite></th>
<td id="A2.T5.4.1.4.2" class="ltx_td ltx_align_center">0.72</td>
