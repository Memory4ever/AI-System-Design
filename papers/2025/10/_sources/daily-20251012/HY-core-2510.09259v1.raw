<td id="A2.T5.4.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="A2.T5.4.1.1.2.1" class="ltx_text ltx_font_bold">AIME24</span></td>
<td id="A2.T5.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="A2.T5.4.1.1.3.1" class="ltx_text ltx_font_bold">AIME25</span></td>
<td id="A2.T5.4.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A2.T5.4.1.1.4.1" class="ltx_text ltx_font_bold">AVG</span></td></tr>
<tr id="A2.T5.4.1.2" class="ltx_tr">
<td id="A2.T5.4.1.2.1" class="ltx_td ltx_align_center ltx_border_t">F1 score</td>
