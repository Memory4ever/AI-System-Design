<td id="S5.T4.2.2.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m12" class="ltx_Math" alttext="2.39\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>2.39</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2.39\times 10^{-5}</annotation></semantics></math></td></tr>
