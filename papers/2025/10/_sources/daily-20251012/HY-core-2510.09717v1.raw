<td id="S4.T1.6.1.14.11" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.6.1.14.11.1" class="ltx_text ltx_font_bold">0.41</span></td></tr>
</tbody>
</table>
</span></div>
</figure>
