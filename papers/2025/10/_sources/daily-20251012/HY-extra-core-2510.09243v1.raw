<td id="A9.T14.2.2.2" class="ltx_td ltx_align_center ltx_border_t">0.248</td>
<td id="A9.T14.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.075</td>
<td id="A9.T14.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.048</td>
