<th id="A9.T14.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A9.T14.2.1.2.1" class="ltx_text ltx_font_bold">R1</span></th>
<th id="A9.T14.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A9.T14.2.1.3.1" class="ltx_text ltx_font_bold">R2</span></th>
<th id="A9.T14.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A9.T14.2.1.4.1" class="ltx_text ltx_font_bold">B</span></th>
<th id="A9.T14.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A9.T14.2.1.5.1" class="ltx_text ltx_font_bold">BS</span></th></tr>
