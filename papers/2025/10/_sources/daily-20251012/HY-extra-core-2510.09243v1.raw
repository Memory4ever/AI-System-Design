<td id="A6.T12.2.2.5" class="ltx_td ltx_align_left ltx_border_t">6.09e<sup id="A6.T12.2.2.5.1" class="ltx_sup"><span id="A6.T12.2.2.5.1.1" class="ltx_text ltx_font_italic">-35</span></sup></td></tr>
<tr id="A6.T12.2.3" class="ltx_tr">
<td id="A6.T12.2.3.1" class="ltx_td ltx_align_left"><span id="A6.T12.2.3.1.1" class="ltx_text ltx_font_smallcaps">Inst<sup id="A6.T12.2.3.1.1.1" class="ltx_sup"><span id="A6.T12.2.3.1.1.1.1" class="ltx_text ltx_font_upright">
</span>
<span id="A6.T12.2.3.1.1.1.2" class="ltx_inline-block fa fa-thumbs-o-down" aria-hidden="true">
</span></sup></span></td>
<td id="A6.T12.2.3.2" class="ltx_td ltx_align_left">86.84%</td>
<td id="A6.T12.2.3.3" class="ltx_td ltx_align_left">1.48e<sup id="A6.T12.2.3.3.1" class="ltx_sup"><span id="A6.T12.2.3.3.1.1" class="ltx_text ltx_font_italic">-11</span></sup></td>
<td id="A6.T12.2.3.4" class="ltx_td ltx_align_left">93.24%</td>
<td id="A6.T12.2.3.5" class="ltx_td ltx_align_left">9.17e<sup id="A6.T12.2.3.5.1" class="ltx_sup"><span id="A6.T12.2.3.5.1.1" class="ltx_text ltx_font_italic">-16</span></sup></td></tr>
<tr id="A6.T12.2.4" class="ltx_tr">
