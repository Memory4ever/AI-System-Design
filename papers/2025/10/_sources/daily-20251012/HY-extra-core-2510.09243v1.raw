<td id="A6.T12.2.5.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A6.T12.2.5.1.1" class="ltx_text ltx_font_smallcaps">All<sup id="A6.T12.2.5.1.1.1" class="ltx_sup"><span id="A6.T12.2.5.1.1.1.1" class="ltx_text ltx_font_upright">
</span>
<span id="A6.T12.2.5.1.1.1.2" class="ltx_inline-block fa fa-thumbs-o-down" aria-hidden="true">
</span></sup></span></td>
<td id="A6.T12.2.5.2" class="ltx_td ltx_align_left ltx_border_bb">98.25%</td>
<td id="A6.T12.2.5.3" class="ltx_td ltx_align_left ltx_border_bb">4.02e<sup id="A6.T12.2.5.3.1" class="ltx_sup"><span id="A6.T12.2.5.3.1.1" class="ltx_text ltx_font_italic">-16</span></sup></td>
