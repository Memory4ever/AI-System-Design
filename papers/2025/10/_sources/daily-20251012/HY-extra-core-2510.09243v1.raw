<tr id="S6.T9.2.3" class="ltx_tr">
<th id="S6.T9.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T9.2.3.1.1" class="ltx_text ltx_font_smallcaps">All<sup id="S6.T9.2.3.1.1.1" class="ltx_sup"><span id="S6.T9.2.3.1.1.1.1" class="ltx_text ltx_font_upright">
