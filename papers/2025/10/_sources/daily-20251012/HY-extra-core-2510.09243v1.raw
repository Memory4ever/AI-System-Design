<td id="A9.T14.2.3.2" class="ltx_td ltx_align_center"><span id="A9.T14.2.3.2.1" class="ltx_text ltx_font_bold">0.304</span></td>
<td id="A9.T14.2.3.3" class="ltx_td ltx_align_center"><span id="A9.T14.2.3.3.1" class="ltx_text ltx_font_bold">0.098</span></td>
<td id="A9.T14.2.3.4" class="ltx_td ltx_align_center">0.060</td>
