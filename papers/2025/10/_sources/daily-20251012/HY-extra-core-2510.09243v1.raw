<td id="A6.T12.2.2.2" class="ltx_td ltx_align_left ltx_border_t">93.61%</td>
<td id="A6.T12.2.2.3" class="ltx_td ltx_align_left ltx_border_t">5.58e<sup id="A6.T12.2.2.3.1" class="ltx_sup"><span id="A6.T12.2.2.3.1.1" class="ltx_text ltx_font_italic">-45</span></sup></td>
