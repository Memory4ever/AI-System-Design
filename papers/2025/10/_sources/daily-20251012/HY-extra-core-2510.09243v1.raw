<td id="A6.T12.2.4.3" class="ltx_td ltx_align_left">1.37e<sup id="A6.T12.2.4.3.1" class="ltx_sup"><span id="A6.T12.2.4.3.1.1" class="ltx_text ltx_font_italic">-21</span></sup></td>
<td id="A6.T12.2.4.4" class="ltx_td ltx_align_left">80.23%</td>
