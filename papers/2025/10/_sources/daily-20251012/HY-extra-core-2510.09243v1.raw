</span></sup><sub id="S6.T9.2.3.1.1.2" class="ltx_sub"><span id="S6.T9.2.3.1.1.2.1" class="ltx_text ltx_font_upright">pe-zs</span></sub></span></th>
<th id="S6.T9.2.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">0.270</th>
<td id="S6.T9.2.3.3" class="ltx_td ltx_align_center">0.078</td>
<td id="S6.T9.2.3.4" class="ltx_td ltx_align_center">0.047</td>
<td id="S6.T9.2.3.5" class="ltx_td ltx_align_center">0.593</td></tr>
<tr id="S6.T9.2.4" class="ltx_tr">
<th id="S6.T9.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T9.2.4.1.1" class="ltx_text ltx_font_smallcaps">All<sup id="S6.T9.2.4.1.1.1" class="ltx_sup"><span id="S6.T9.2.4.1.1.1.1" class="ltx_text ltx_font_upright">
