<td id="S6.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.238</td>
<td id="S6.T6.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.786</td></tr>
<tr id="S6.T6.2.3" class="ltx_tr">
<th id="S6.T6.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Alert<sub id="S6.T6.2.3.1.1" class="ltx_sub">Inst</sub></th>
<td id="S6.T6.2.3.2" class="ltx_td ltx_align_center">0.508</td>
<td id="S6.T6.2.3.3" class="ltx_td ltx_align_center">0.309</td>
<td id="S6.T6.2.3.4" class="ltx_td ltx_align_center">0.236</td>
<td id="S6.T6.2.3.5" class="ltx_td ltx_align_center">0.779</td></tr>
<tr id="S6.T6.2.4" class="ltx_tr">
<th id="S6.T6.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Alert<sub id="S6.T6.2.4.1.1" class="ltx_sub"><math id="S6.T6.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></sub></th>
