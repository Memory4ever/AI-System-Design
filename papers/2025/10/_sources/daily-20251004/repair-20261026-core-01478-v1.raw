<th id="S4.T1.4.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.4.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<td id="S4.T1.4.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.4.1.2.1" class="ltx_text ltx_font_bold">#Parameters</span></td>
<td id="S4.T1.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T1.4.1.3.1" class="ltx_text ltx_font_bold">FID <math id="S4.T1.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
<tr id="S4.T1.4.2" class="ltx_tr">
<th id="S4.T1.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;" colspan="3"><span id="S4.T1.4.2.1.1" class="ltx_text ltx_font_italic">Autoregressive &amp; Masked Generative Models</span></th></tr>
<tr id="S4.T1.4.3" class="ltx_tr">
<th id="S4.T1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:5.0pt;padding-right:5.0pt;">  VQGAN <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Esser et al., 2021</a>)</cite></th>
<td id="S4.T1.4.3.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">1.4B</td>
<td id="S4.T1.4.3.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">5.20</td></tr>
<tr id="S4.T1.4.4" class="ltx_tr">
<th id="S4.T1.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:5.0pt;padding-right:5.0pt;">  ViT-VQGAN <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib52" title="" class="ltx_ref">Yu et al., 2021</a>)</cite></th>
<td id="S4.T1.4.4.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">1.7B</td>
