<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T1.2.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;--ltx-bg-color:#FFFFFF;">
<span id="S3.T1.2.1.2.2.1.1" class="ltx_p">Yes</span>
</span></td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">
