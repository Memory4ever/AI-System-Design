/mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{T}_{3}:={\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}-\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=({\bm{\beta}}_{*}^{\top}{\bm{u}})\,{\bm{u}}_{\beta}^{\top}(I-{\bm{\Sigma}}{\bm{\Sigma}}^{\dagger}){\bm{b}}-\mu_{\tilde{T}_{3}}({\bm{u}}_{\beta}^{\top}{\bm{u}}_{\beta})</annotation></semantics></math></p>
