<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex371.m1" class="ltx_Math" alttext="\displaystyle+{\bm{\beta}}_{*}^{\top}\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}\left({\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{s}}{\bm{h}}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{s}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right){\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+{\bm{\beta}}_{*}^{\top}\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}\left({\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{s}}{\bm{h}}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{s}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right){\bm{\beta}}_{*}</annotation></semantics></math></td>
