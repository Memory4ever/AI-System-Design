<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex374.m1" class="ltx_Math" alttext="\displaystyle=\ " display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex374.m2" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right]{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right]{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex375"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex375.m1" class="ltx_Math" alttext="\displaystyle=\ " display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex375.m2" class="ltx_Math" alttext="\displaystyle({\bm{\beta}}_{*}^{\top}{\bm{u}})\left(\frac{\eta\xi}{\gamma_{2}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right)\quad\text{since $\gamma_{2}=\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}$}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>)</mo></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>since </mtext><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle({\bm{\beta}}_{*}^{\top}{\bm{u}})\left(\frac{\eta\xi}{\gamma_{2}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right)\quad\text{since $\gamma_{2}=\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p8.4" class="ltx_p"><span id="A4.SS5.SSS6.p8.4.1" class="ltx_text">We need to evaluate two following expectations. Similar to <math id="A4.SS5.SSS6.p8.m6" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>,</span></p>
<table id="A4.Ex376" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex376.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex377"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex377.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex377.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{h}}\|^{2}\right]\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)O\left(\frac{1}{n}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{h}}\|^{2}\right]\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)O\left(\frac{1}{n}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex378"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex378.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex379"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex379.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})}{c-1}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})}{c-1}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p8.5" class="ltx_p"><span id="A4.SS5.SSS6.p8.5.1" class="ltx_text">Finally, we have that:</span></p>
<table id="A4.Ex380" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex380.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{1}{c-1}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{1}{c-1}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p8.6" class="ltx_p"><span id="A4.SS5.SSS6.p8.6.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma29" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma29.2" class="ltx_text ltx_font_bold">Lemma 29</span></span><span id="Thmlemma29.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma29.p1" class="ltx_para">
<p id="Thmlemma29.p1.1" class="ltx_p"><span id="Thmlemma29.p1.1.1" class="ltx_text ltx_font_italic">In the same setting as <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have that,</span></p>
<table id="A4.Ex381" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex381.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]=\begin{cases}\tau_{\varepsilon}^{2}\left(\frac{cd}{\rho^{2}(1-c)}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}c+\rho^{2})}\frac{c^{2}}{1-c}\right)+o\left(\frac{n}{\rho^{2}}\right)+O\left(\frac{1}{\rho^{2}n}\right),&amp;c&lt;1\\
\tau_{\varepsilon}^{2}\left(\frac{d}{\rho^{2}(c-1)}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}+\rho^{2})}\frac{c}{c-1}\right)+o\left(\frac{n}{\rho^{2}}\right)+O\left(\frac{1}{\rho^{2}n}\right),&amp;c&gt;1\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mi>n</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="false"><mfrac><mi>d</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mi>n</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]=\begin{cases}\tau_{\varepsilon}^{2}\left(\frac{cd}{\rho^{2}(1-c)}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}c+\rho^{2})}\frac{c^{2}}{1-c}\right)+o\left(\frac{n}{\rho^{2}}\right)+O\left(\frac{1}{\rho^{2}n}\right),&amp;c&lt;1\\
\tau_{\varepsilon}^{2}\left(\frac{d}{\rho^{2}(c-1)}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}+\rho^{2})}\frac{c}{c-1}\right)+o\left(\frac{n}{\rho^{2}}\right)+O\left(\frac{1}{\rho^{2}n}\right),&amp;c&gt;1\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS5.SSS6.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.SSS6.p9" class="ltx_para">
<p id="A4.SS5.SSS6.p9.1" class="ltx_p"><span id="A4.SS5.SSS6.p9.1.1" class="ltx_text">For <math id="A4.SS5.SSS6.p9.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, we first expand this term using Theorem <a href="#Thmtheorem6" title="Theorem 6 (Theorems 3, 5 of []). ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>:</span></p>
<table id="A4.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex382"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex382.m1" class="ltx_Math" alttext="\displaystyle{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({{\bm{Z}}}+{{\bm{A}}})^{\dagger\top}{{\bm{\varepsilon}}}=\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo rspace="0.778em">=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({{\bm{Z}}}+{{\bm{A}}})^{\dagger\top}{{\bm{\varepsilon}}}=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex382.m2" class="ltx_Math" alttext="\displaystyle{{\bm{\varepsilon}}}^{\top}\left({{\bm{A}}}^{\dagger}+\frac{\eta}{{\xi}}{{\bm{t}}}^{\top}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}-\frac{{\xi}}{\gamma_{1}}{\bm{p}}_{1}{\bm{q}}_{1}^{\top}\right)\left({{\bm{A}}}^{\dagger}+\frac{\eta}{{\xi}}{{\bm{t}}}^{\top}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}-\frac{{\xi}}{\gamma_{1}}{\bm{p}}_{1}{\bm{q}}_{1}^{\top}\right)^{\top}{{\bm{\varepsilon}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>1</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><annotation encoding="application/x-tex">\displaystyle{{\bm{\varepsilon}}}^{\top}\left({{\bm{A}}}^{\dagger}+\frac{\eta}{{\xi}}{{\bm{t}}}^{\top}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}-\frac{{\xi}}{\gamma_{1}}{\bm{p}}_{1}{\bm{q}}_{1}^{\top}\right)\left({{\bm{A}}}^{\dagger}+\frac{\eta}{{\xi}}{{\bm{t}}}^{\top}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}-\frac{{\xi}}{\gamma_{1}}{\bm{p}}_{1}{\bm{q}}_{1}^{\top}\right)^{\top}{{\bm{\varepsilon}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex383"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex383.m1" class="ltx_Math" alttext="\displaystyle=\ " display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex383.m2" class="ltx_Math" alttext="\displaystyle{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{\varepsilon}}}+\frac{2\eta}{{\xi}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}{{\bm{t}}}{{\bm{\varepsilon}}}-\frac{2{\xi}}{\gamma_{1}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{\varepsilon}}}+\frac{2\eta}{{\xi}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}{{\bm{t}}}{{\bm{\varepsilon}}}-\frac{2{\xi}}{\gamma_{1}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex384"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex384.m1" class="ltx_Math" alttext="\displaystyle+\frac{\eta^{2}}{{\xi}^{2}}\left({{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}\right){{\bm{\varepsilon}}}^{\top}{{\bm{t}}}^{\top}{{\bm{t}}}{{\bm{\varepsilon}}}-\frac{2\eta}{\gamma_{1}}{{\bm{\varepsilon}}}^{\top}{{\bm{t}}}^{\top}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}+\frac{{\xi}^{2}}{\gamma_{1}^{2}}{{\bm{\varepsilon}}}^{\top}{\bm{p}}_{1}{\bm{q}}_{1}^{\top}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>ξ</mi><mn>2</mn></msup><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\eta^{2}}{{\xi}^{2}}\left({{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}\right){{\bm{\varepsilon}}}^{\top}{{\bm{t}}}^{\top}{{\bm{t}}}{{\bm{\varepsilon}}}-\frac{2\eta}{\gamma_{1}}{{\bm{\varepsilon}}}^{\top}{{\bm{t}}}^{\top}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}+\frac{{\xi}^{2}}{\gamma_{1}^{2}}{{\bm{\varepsilon}}}^{\top}{\bm{p}}_{1}{\bm{q}}_{1}^{\top}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p9.2" class="ltx_p"><span id="A4.SS5.SSS6.p9.2.1" class="ltx_text">Note that Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> and the fact that <math id="A4.SS5.SSS6.p9.m2" class="ltx_Math" alttext="{\bm{t}}{\bm{A}}^{\dagger}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{t}}{\bm{A}}^{\dagger}=\bm{0}</annotation></semantics></math> imply that the second term has zero expectation:</span></p>
<table id="A4.Ex385" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex385.m1" class="ltx_Math" alttext="\mathbb{E}_{{\bm{\varepsilon}}}\left[\frac{2\eta}{{\xi}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}{{\bm{t}}}{\varepsilon}\right]=\frac{2\eta\tau_{\varepsilon}^{2}}{{\xi}}{\bm{t}}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝜺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><mi>ξ</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\bm{\varepsilon}}}\left[\frac{2\eta}{{\xi}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}{{\bm{t}}}{\varepsilon}\right]=\frac{2\eta\tau_{\varepsilon}^{2}}{{\xi}}{\bm{t}}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p9.3" class="ltx_p"><span id="A4.SS5.SSS6.p9.3.1" class="ltx_text">Simiarly, we will later use:</span></p>
<table id="A4.Ex386" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex386.m1" class="ltx_Math" alttext="\mathbb{E}_{{\bm{\varepsilon}}}\left[{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{h}}}^{\top}{\bm{t}}{{\bm{\varepsilon}}}\right]=\tau_{\varepsilon}^{2}{\bm{t}}{{\bm{A}}}^{\dagger}{\bm{h}}^{\top}=0,\quad\mathbb{E}_{{\bm{\varepsilon}}}\left[{{\bm{\varepsilon}}}^{\top}{\bm{t}}^{\top}{\bm{k}}^{\top}{{\bm{\varepsilon}}}\right]=\tau_{\varepsilon}^{2}Tr({\bm{t}}^{\top}{\bm{k}}^{\top})=\tau_{\varepsilon}^{2}Tr({\bm{k}}{\bm{t}})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝜺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>𝔼</mi><mi>𝜺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{{\bm{\varepsilon}}}\left[{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{h}}}^{\top}{\bm{t}}{{\bm{\varepsilon}}}\right]=\tau_{\varepsilon}^{2}{\bm{t}}{{\bm{A}}}^{\dagger}{\bm{h}}^{\top}=0,\quad\mathbb{E}_{{\bm{\varepsilon}}}\left[{{\bm{\varepsilon}}}^{\top}{\bm{t}}^{\top}{\bm{k}}^{\top}{{\bm{\varepsilon}}}\right]=\tau_{\varepsilon}^{2}Tr({\bm{t}}^{\top}{\bm{k}}^{\top})=\tau_{\varepsilon}^{2}Tr({\bm{k}}{\bm{t}})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p9.4" class="ltx_p"><span id="A4.SS5.SSS6.p9.4.1" class="ltx_text">Note that these equalities are exact without taking the expectation over other sources of randomness besides <math id="A4.SS5.SSS6.p9.m3" class="ltx_Math" alttext="{\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mi>𝜺</mi><annotation encoding="application/x-tex">{\bm{\varepsilon}}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS5.SSS6.p10" class="ltx_para">
<p id="A4.SS5.SSS6.p10.1" class="ltx_p"><span id="A4.SS5.SSS6.p10.1.1" class="ltx_text">We now expand the other terms one by one and compute their expectations along the way. We start by eliminating zero expectations and taking expectations w.r.t. <math id="A4.SS5.SSS6.p10.m1" class="ltx_Math" alttext="{\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mi>𝜺</mi><annotation encoding="application/x-tex">{\bm{\varepsilon}}</annotation></semantics></math> using Lemma <a href="#Thmlemma21" title="Lemma 21. ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>.</span></p>
</div>
<div id="A4.SS5.SSS6.p11" class="ltx_para">
<table id="A4.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex387"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex387.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}}{{\xi}^{2}}\left({{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}\right){{\bm{\varepsilon}}}^{\top}{{\bm{t}}}^{\top}{{\bm{t}}}{{\bm{\varepsilon}}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒕</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}}{{\xi}^{2}}\left({{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}\right){{\bm{\varepsilon}}}^{\top}{{\bm{t}}}^{\top}{{\bm{t}}}{{\bm{\varepsilon}}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex387.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}\tau_{\varepsilon}^{2}}{{\xi}^{2}}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}\tau_{\varepsilon}^{2}}{{\xi}^{2}}{{\bm{k}}}^{\top}{{\bm{A}}}^{\dagger}{{\bm{A}}}^{\dagger\top}{{\bm{k}}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex389"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex389.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[-\frac{2{\xi}}{\gamma_{1}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[-\frac{2{\xi}}{\gamma_{1}}{{\bm{\varepsilon}}}^{\top}{{\bm{A}}}^{\dagger}{\bm{q}}_{1}{\bm{p}}_{1}^{\top}{{\bm{\varepsilon}}}\right]</annotation></semantics></math></td>
