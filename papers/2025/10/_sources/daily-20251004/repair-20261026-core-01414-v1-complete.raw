<tbody id="A4.Ex436"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex436.m1" class="ltx_Math" alttext="\displaystyle\tau_{\varepsilon}^{2}\left(\frac{2\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}\xi}-\frac{2\eta^{3}\|{{\bm{s}}}\|^{2}\|{{\bm{h}}}\|^{2}}{\gamma_{2}{\xi}}-\frac{2\eta\xi}{\gamma_{2}}\right)=-\tau_{\varepsilon}^{2}\frac{2\eta\xi}{\gamma_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\varepsilon}^{2}\left(\frac{2\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}\xi}-\frac{2\eta^{3}\|{{\bm{s}}}\|^{2}\|{{\bm{h}}}\|^{2}}{\gamma_{2}{\xi}}-\frac{2\eta\xi}{\gamma_{2}}\right)=-\tau_{\varepsilon}^{2}\frac{2\eta\xi}{\gamma_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p12.6" class="ltx_p">Combining these terms together, we have:</p>
<table id="A4.Ex437" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex437.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]=\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{\eta^{2}\|{\bm{s}}\|^{2}\tau_{\varepsilon}^{2}}{\gamma_{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\frac{2\eta\xi\tau_{\varepsilon}^{2}}{\gamma_{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>−</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]=\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{\eta^{2}\|{\bm{s}}\|^{2}\tau_{\varepsilon}^{2}}{\gamma_{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\frac{2\eta\xi\tau_{\varepsilon}^{2}}{\gamma_{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p12.7" class="ltx_p">Similarly, replicating the proof with the <math id="A4.SS5.SSS6.p12.m4" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math> counterparts, we have the following:</p>
<table id="A4.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex438"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex438.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}\right]=\tau_{\varepsilon}^{2}\mathbb{E}\left[Tr({\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top})\right]=\tau_{\varepsilon}^{2}n\mathbb{E}\left[\frac{1}{\lambda}\right]=\tau_{\varepsilon}^{2}\frac{d}{\rho^{2}(c-1)}+o\left(\frac{d}{\rho^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}\right]=\tau_{\varepsilon}^{2}\mathbb{E}\left[Tr({\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top})\right]=\tau_{\varepsilon}^{2}n\mathbb{E}\left[\frac{1}{\lambda}\right]=\tau_{\varepsilon}^{2}\frac{d}{\rho^{2}(c-1)}+o\left(\frac{d}{\rho^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex439"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex439.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{c^{2}}{\rho^{2}(c-1)^{2}}+o\left(1\right)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{c^{2}}{\rho^{2}(c-1)^{2}}+o\left(1\right)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex440"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex440.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex441"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex441.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right]=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{c}{\rho^{2}(c-1)^{2}}+o\left(1\right)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}\right]=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{c}{\rho^{2}(c-1)^{2}}+o\left(1\right)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p12.8" class="ltx_p">After simple algebra, the result follows.</p>
</div>
<div id="A4.SS5.SSS6.p13" class="ltx_para">
<p id="A4.SS5.SSS6.p13.1" class="ltx_p"><span id="A4.SS5.SSS6.p13.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A4.SS5.SSS7" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.5.7 </span>Target Alignment: Helper Lemmas</h4>

<div id="Thmlemma30" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma30.2" class="ltx_text ltx_font_bold">Lemma 30</span></span><span id="Thmlemma30.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma30.p1" class="ltx_para">
<p id="Thmlemma30.p1.1" class="ltx_p"><span id="Thmlemma30.p1.1.1" class="ltx_text ltx_font_italic">In the same setting as <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have that</span></p>
<table id="A4.Ex442" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex442.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}^{\top}{\bm{\beta}}_{*}\right]=\begin{cases}\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)&amp;c&lt;1\\
\frac{\eta^{2}}{\eta^{2}+\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}^{\top}{\bm{\beta}}_{*}\right]=\begin{cases}\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)&amp;c&lt;1\\
\frac{\eta^{2}}{\eta^{2}+\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS5.SSS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.SSS7.p1" class="ltx_para">
<p id="A4.SS5.SSS7.p1.1" class="ltx_p"><span id="A4.SS5.SSS7.p1.1.1" class="ltx_text">For <math id="A4.SS5.SSS7.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, from <a href="#Thmprop1" title="Proposition 1 (Proposition 2 from []). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>, we get that</span></p>
<table id="A4.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex443"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex443.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}^{\top}{\bm{\beta}}_{*}=\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}^{\top}{\bm{\beta}}_{*}=\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p1.2" class="ltx_p"><span id="A4.SS5.SSS7.p1.2.1" class="ltx_text">To begin, we start estimating</span></p>
<table id="A4.Ex444" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex444.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p1.3" class="ltx_p"><span id="A4.SS5.SSS7.p1.3.1" class="ltx_text">Using our Spherical Hypercontractivity, we have that <math id="A4.SS5.SSS7.p1.m2" class="ltx_Math" alttext="\frac{\xi}{\eta}" display="inline" intent=":literal"><semantics><mfrac><mi>ξ</mi><mi>η</mi></mfrac><annotation encoding="application/x-tex">\frac{\xi}{\eta}</annotation></semantics></math> and <math id="A4.SS5.SSS7.p1.m3" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math> satisfy the assumptions for Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>. Then using Lemma <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> we have that</span></p>
<table id="A4.Ex445" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex445.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}\right]=\frac{1}{\eta}\quad\text{ and }\quad\mathrm{Var}\left(\frac{1}{\eta}\right)=O\left(\frac{1}{\rho^{2}d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mi>η</mi></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>η</mi></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}\right]=\frac{1}{\eta}\quad\text{ and }\quad\mathrm{Var}\left(\frac{1}{\eta}\right)=O\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p1.4" class="ltx_p"><span id="A4.SS5.SSS7.p1.4.1" class="ltx_text">and Lemma <a href="#Thmlemma11" title="Lemma 11 (Zero Expectation). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, we have that</span></p>
<table id="A4.Ex446" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex446.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p1.5" class="ltx_p"><span id="A4.SS5.SSS7.p1.5.1" class="ltx_text">Thus, using Lemma <a href="#Thmlemma37" title="Lemma 37 (Expectation of Product vs. Product of Expectations). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we have that</span></p>
<table id="A4.Ex447" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex447.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p1.6" class="ltx_p"><span id="A4.SS5.SSS7.p1.6.1" class="ltx_text">and using Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>, since all the means are <math id="A4.SS5.SSS7.p1.m4" class="ltx_Math" alttext="O(1)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1)</annotation></semantics></math>, we have that</span></p>
<table id="A4.Ex448" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex448.m1" class="ltx_Math" alttext="\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\max\left(\mathrm{Var}\left(\frac{\xi}{\eta}\right),\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)\right)\right)=O\left(\frac{1}{\rho^{2}n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\max\left(\mathrm{Var}\left(\frac{\xi}{\eta}\right),\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)\right)\right)=O\left(\frac{1}{\rho^{2}n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p1.7" class="ltx_p"><span id="A4.SS5.SSS7.p1.7.1" class="ltx_text">Then Lemma <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> gives mean and variance of <math id="A4.SS5.SSS7.p1.m5" class="ltx_Math" alttext="\frac{\eta^{2}}{\gamma_{i}}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mi>i</mi></msub></mfrac><annotation encoding="application/x-tex">\frac{\eta^{2}}{\gamma_{i}}</annotation></semantics></math>. Since <math id="A4.SS5.SSS7.p1.m6" class="ltx_Math" alttext="\frac{\eta^{2}}{\gamma_{i}}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mi>i</mi></msub></mfrac><annotation encoding="application/x-tex">\frac{\eta^{2}}{\gamma_{i}}</annotation></semantics></math> does not satisfy the higher moment bound, and cannot be directly included in the product, we can include it via the classical bound:</span></p>
<table id="A4.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E18.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]+\sqrt{\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)}=O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]+\sqrt{\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)}=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS5.SSS7.p2" class="ltx_para ltx_noindent">
<p id="A4.SS5.SSS7.p2.1" class="ltx_p">For the second term, we begin with</p>
<table id="A4.Ex449" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex449.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p2.2" class="ltx_p">Lemma <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> tells us that</p>
<table id="A4.Ex450" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex450.m1" class="ltx_Math" alttext="\mathbb{E}[\|t\|^{2}]=1-c\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{t}}\|^{2}\right)=O\left(\frac{1}{n}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>t</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|t\|^{2}]=1-c\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{t}}\|^{2}\right)=O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p2.3" class="ltx_p">and Lemma <a href="#Thmlemma10" title="Lemma 10 (General Terms). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> tells us</p>
<table id="A4.Ex451" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex451.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=\frac{1}{\rho^{2}}\frac{c}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)\quad\text{ and }\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{4}d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=\frac{1}{\rho^{2}}\frac{c}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)\quad\text{ and }\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{4}d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p2.4" class="ltx_p">Thus using Lemmas <a href="#Thmlemma37" title="Lemma 37 (Expectation of Product vs. Product of Expectations). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a> and Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>, we get that</p>
<table id="A4.Ex452" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex452.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{n}\right)\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{n}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{n}\right)\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p2.5" class="ltx_p">Recalling the mean and variance for <math id="A4.SS5.SSS7.p2.m1" class="ltx_Math" alttext="\frac{\eta^{2}}{\gamma_{1}}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac><annotation encoding="application/x-tex">\frac{\eta^{2}}{\gamma_{1}}</annotation></semantics></math> from <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>, we have that</p>
<table id="A4.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex453"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex453.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex453.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]+\sqrt{O\left(\frac{1}{n}\right)\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\|{\bm{t}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger\top}{\bm{k}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]+\sqrt{O\left(\frac{1}{n}\right)\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex454"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex454.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}c+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{n}\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}c+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{n}\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E19.m1" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p2.6" class="ltx_p">Combining these two terms yields the first result.</p>
</div>
<div id="A4.SS5.SSS7.p3" class="ltx_para ltx_noindent">
<p id="A4.SS5.SSS7.p3.1" class="ltx_p">Similarly, for <math id="A4.SS5.SSS7.p3.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, <a href="#Thmprop1" title="Proposition 1 (Proposition 2 from []). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a> gives the expansion:</p>
<table id="A4.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex455"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex455.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒁</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex455.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}\right)^{\top}{\bm{\beta}}_{*}=\frac{\eta\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}\left(\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{u}}{\bm{s}}^{\top}\right)^{\top}{\bm{\beta}}_{*}=\frac{\eta\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.2" class="ltx_p">For the first term, we begin with</p>
<table id="A4.Ex456" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex456.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.3" class="ltx_p">Recalling form Lemma <a href="#Thmlemma11" title="Lemma 11 (Zero Expectation). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, we see that</p>
<table id="A4.Ex457" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex457.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.4" class="ltx_p">Thus again using Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a> and Lemma <a href="#Thmlemma37" title="Lemma 37 (Expectation of Product vs. Product of Expectations). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we see that</p>
<table id="A4.Ex458" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex458.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.5" class="ltx_p">Next using the standard covariance bound on the expectation of the product. We see that</p>
<table id="A4.Ex459" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex459.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)+O\left(\frac{1}{n}\right)=O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)+O\left(\frac{1}{n}\right)=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.6" class="ltx_p">For the second term, we begin with</p>
<table id="A4.Ex460" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex460.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.7" class="ltx_p">Recall from Lemma <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> we have that</p>
<table id="A4.Ex461" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex461.m1" class="ltx_Math" alttext="\mathbb{E}[\|{\bm{h}}\|^{2}]=\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\quad\text{ and }\quad\mathrm{Var}(\|{\bm{h}}\|^{2})=O\left(\frac{1}{\rho^{4}n}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|{\bm{h}}\|^{2}]=\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\quad\text{ and }\quad\mathrm{Var}(\|{\bm{h}}\|^{2})=O\left(\frac{1}{\rho^{4}n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.8" class="ltx_p">and from Lemma <a href="#Thmlemma10" title="Lemma 10 (General Terms). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a></p>
<table id="A4.Ex462" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex462.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right]=\left(1-\frac{1}{c}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right]=\left(1-\frac{1}{c}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.9" class="ltx_p">Thus using Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a> and Lemma <a href="#Thmlemma37" title="Lemma 37 (Expectation of Product vs. Product of Expectations). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we get that</p>
<table id="A4.Ex463" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex463.m1" class="ltx_Math" alttext="\mathbb{E}\left[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right]=\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right]=\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.10" class="ltx_p">Recalling the mean and variance for <math id="A4.SS5.SSS7.p3.m2" class="ltx_Math" alttext="\frac{\eta^{2}}{\gamma_{2}}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac><annotation encoding="application/x-tex">\frac{\eta^{2}}{\gamma_{2}}</annotation></semantics></math> from Lemma <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> and using the classical covariance bound for the expectation of the product, we get that</p>
<table id="A4.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex464"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex464.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex464.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]+\sqrt{O\left(\frac{1}{n}\right)\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}\right]+\sqrt{O\left(\frac{1}{n}\right)\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex465"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex465.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{d}\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{d}\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex466"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex466.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p3.11" class="ltx_p">Then adding the two together, we get the result for <math id="A4.SS5.SSS7.p3.m3" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math> as well.
∎</p>
</div>
</div>
<div id="Thmlemma31" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma31.2" class="ltx_text ltx_font_bold">Lemma 31</span></span><span id="Thmlemma31.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma31.p1" class="ltx_para">
<p id="Thmlemma31.p1.1" class="ltx_p"><span id="Thmlemma31.p1.1.1" class="ltx_text ltx_font_italic">In the same setting as <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have that, for <math id="Thmlemma31.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math></span></p>
<table id="A4.Ex467" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex467.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]=\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]=\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma31.p1.2" class="ltx_p"><span id="Thmlemma31.p1.2.1" class="ltx_text ltx_font_italic">and for <math id="Thmlemma31.p1.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math></span></p>
<table id="A4.Ex468" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex468.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]=\frac{1}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}+\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)+o(1)+O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]=\frac{1}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}+\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS5.SSS7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.SSS7.p4" class="ltx_para">
<p id="A4.SS5.SSS7.p4.1" class="ltx_p"><span id="A4.SS5.SSS7.p4.1.1" class="ltx_text">For <math id="A4.SS5.SSS7.p4.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, using the expectation from Lemma <a href="#Thmlemma30" title="Lemma 30. ‣ D.5.7 Target Alignment: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>, we get</span></p>
<table id="A4.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex469"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex469.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex469.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}\left({\bm{I}}-{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\right)^{\top}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}\left({\bm{I}}-{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}\right)^{\top}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex470"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex470.m1" class="ltx_Math" alttext="\displaystyle=\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(1\right)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(1\right)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS5.SSS7.p5" class="ltx_para ltx_noindent">
<p id="A4.SS5.SSS7.p5.1" class="ltx_p">For <math id="A4.SS5.SSS7.p5.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, using <a href="#Thmlemma2" title="Lemma 2. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we get</p>
<table id="A4.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex471"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex471.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex471.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}\left({\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}-\frac{\eta\xi}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right)^{\top}{\bm{\beta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}\left({\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}-\frac{\eta\xi}{\gamma_{2}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right)^{\top}{\bm{\beta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p5.2" class="ltx_p">We then compute the expectation of each term above. To begin, we have that</p>
<table id="A4.Ex472" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex472.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=\frac{1}{c}\|{\bm{\beta}}_{*}\|^{2}\quad\text{by Equation \ref{eq:bAAb}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>by Equation </mtext><mtext><a href="#A4.E13" title="Equation 13 ‣ Proof. ‣ D.5.5 Bias: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a></mtext></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=\frac{1}{c}\|{\bm{\beta}}_{*}\|^{2}\quad\text{by Equation \ref{eq:bAAb}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p5.3" class="ltx_p">Next, we recall from Lemma <a href="#Thmlemma11" title="Lemma 11 (Zero Expectation). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a> that</p>
<table id="A4.Ex473" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex473.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}]=0\text{ and }\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*})=O\left(\frac{1}{\rho^{2}d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}]=0\text{ and }\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*})=O\left(\frac{1}{\rho^{2}d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p5.4" class="ltx_p">and from Lemma <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> that</p>
<table id="A4.Ex474" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex474.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}\right]=\frac{1}{\eta}+o\left(\frac{1}{\rho^{2}}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}\right)=O\left(\frac{1}{\rho^{2}n}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}\right]=\frac{1}{\eta}+o\left(\frac{1}{\rho^{2}}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}\right)=O\left(\frac{1}{\rho^{2}n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p5.5" class="ltx_p">Thus, using Lemmas <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a> and Lemma <a href="#Thmlemma37" title="Lemma 37 (Expectation of Product vs. Product of Expectations). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we have that</p>
<table id="A4.Ex475" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex475.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{\rho^{2}n}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{\rho^{2}n}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS5.SSS7.p6" class="ltx_para">
<p id="A4.SS5.SSS7.p6.1" class="ltx_p"><span id="A4.SS5.SSS7.p6.1.1" class="ltx_text">Then recalling the mean and variance of <math id="A4.SS5.SSS7.p6.m1" class="ltx_Math" alttext="\eta^{2}/\gamma_{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>/</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\eta^{2}/\gamma_{2}</annotation></semantics></math> from <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>, using the standard covariance bound on the difference between the product of the expectation and the expectation of the product, we get that</span></p>
<table id="A4.Ex476" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex476.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right)\text{ and }\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right)\text{ and }\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.2" class="ltx_p"><span id="A4.SS5.SSS7.p6.2.1" class="ltx_text">Furthermore, for the next three terms, recall from Lemma <a href="#Thmlemma10" title="Lemma 10 (General Terms). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> that</span></p>
<table id="A4.Ex477" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex477.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{c}{\rho^{2}(c-1)}+o\left(\frac{1}{\rho^{2}d}\right)\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d^{2}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{c}{\rho^{2}(c-1)}+o\left(\frac{1}{\rho^{2}d}\right)\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.3" class="ltx_p"><span id="A4.SS5.SSS7.p6.3.1" class="ltx_text">and</span></p>
<table id="A4.Ex478" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex478.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right]=\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right)=O\left({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}\frac{1}{d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>d</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right]=\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}\right)=O\left({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}\frac{1}{d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.4" class="ltx_p"><span id="A4.SS5.SSS7.p6.4.1" class="ltx_text">and from Lemma <a href="#Thmlemma11" title="Lemma 11 (Zero Expectation). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a></span></p>
<table id="A4.Ex479" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex479.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}]=0\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}]=0\quad\text{ and }\quad\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.5" class="ltx_p"><span id="A4.SS5.SSS7.p6.5.1" class="ltx_text">Then recalling from Lemma <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, we have that</span></p>
<table id="A4.Ex480" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex480.m1" class="ltx_Math" alttext="\mathbb{E}[\|{\bm{s}}\|^{2}]=1-\frac{1}{c}\quad\text{ and }\quad\mathrm{Var}(\|{\bm{s}}\|^{2})=O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|{\bm{s}}\|^{2}]=1-\frac{1}{c}\quad\text{ and }\quad\mathrm{Var}(\|{\bm{s}}\|^{2})=O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.6" class="ltx_p"><span id="A4.SS5.SSS7.p6.6.1" class="ltx_text">Then using Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a> and Lemma <a href="#Thmlemma37" title="Lemma 37 (Expectation of Product vs. Product of Expectations). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we have that for third term</span></p>
<table id="A4.Ex481" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex481.m1" class="ltx_Math" alttext="\mathbb{E}[\|{\bm{s}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\frac{1}{\rho^{2}d}\|{\bm{\beta}}_{*}\|^{2}+o\left(\frac{1}{\rho^{2}d}\right)+O\left(\frac{1}{d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{s}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|{\bm{s}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\frac{1}{\rho^{2}d}\|{\bm{\beta}}_{*}\|^{2}+o\left(\frac{1}{\rho^{2}d}\right)+O\left(\frac{1}{d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\|{\bm{s}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.7" class="ltx_p"><span id="A4.SS5.SSS7.p6.7.1" class="ltx_text">for the fourth term</span></p>
<table id="A4.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex482"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex482.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex482.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)\right)+O\left(\frac{1}{\rho^{2}d}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>c</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)\right)+O\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex483"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex483.m1" class="ltx_Math" alttext="\displaystyle=\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}c}+o(1)+O\left(\frac{1}{\rho^{2}d}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}c}+o(1)+O\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.8" class="ltx_p"><span id="A4.SS5.SSS7.p6.8.1" class="ltx_text">with variance</span></p>
<table id="A4.Ex484" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex484.m1" class="ltx_Math" alttext="\mathrm{Var}(\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top})=O\left(\frac{1}{\rho^{2}d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\|{\bm{h}}\|^{2}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top})=O\left(\frac{1}{\rho^{2}d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.9" class="ltx_p"><span id="A4.SS5.SSS7.p6.9.1" class="ltx_text">For the first term, we have that</span></p>
<table id="A4.Ex485" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex485.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right]=0+O\left(\frac{1}{\rho^{2}d}\right)\quad\text{ and }\quad\mathrm{Var}\left(\frac{\xi}{\eta}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right)=O\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.10" class="ltx_p"><span id="A4.SS5.SSS7.p6.10.1" class="ltx_text">Adding the last three terms and using Lemma <a href="#Thmlemma34" title="Lemma 34 (Variance of a sum). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a> twice, we get that</span></p>
<table id="A4.EGx123" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex486"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex486.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}\left(\|{\bm{s}}\|^{2}{\bm{h}}^{\top}{\bm{h}}+|{\bm{h}}\|^{2}\top{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}+\frac{\xi}{\eta}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right){\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo>[</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mrow><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝒔</mi><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><msup><mi>𝒉</mi><mo>⊤</mo></msup><mi>𝒉</mi><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒉</mi><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.222em">⊤</mo><mi>𝑨</mi><msup><mi>𝑨</mi><mo>†</mo></msup><mi>𝒖</mi><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mi>𝑨</mi><msup><mi>𝑨</mi><mo>†</mo></msup><mi>𝒖</mi><mi>𝒉</mi><mo>)</mo></mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}\left(\|{\bm{s}}\|^{2}{\bm{h}}^{\top}{\bm{h}}+|{\bm{h}}\|^{2}\top{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}+\frac{\xi}{\eta}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right){\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex486.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\rho^{2}d}\|{\bm{\beta}}_{*}\|^{2}+\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}c}+0+o(1)+O\left(\frac{1}{d}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mstyle><mo>+</mo><mn>0</mn><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\rho^{2}d}\|{\bm{\beta}}_{*}\|^{2}+\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{\rho^{2}c}+0+o(1)+O\left(\frac{1}{d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.11" class="ltx_p"><span id="A4.SS5.SSS7.p6.11.1" class="ltx_text">With variance</span></p>
<table id="A4.Ex487" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex487.m1" class="ltx_math_unparsed" alttext="\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}\left(\|{\bm{s}}\|^{2}{\bm{h}}^{\top}{\bm{h}}+|{\bm{h}}\|^{2}\top{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}+\frac{\xi}{\eta}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right){\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right)" display="block" intent=":literal"><semantics><mrow><mi>Var</mi><mrow><mo>(</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mrow><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝒔</mi><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><msup><mi>𝒉</mi><mo>⊤</mo></msup><mi>𝒉</mi><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒉</mi><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.222em">⊤</mo><mi>𝑨</mi><msup><mi>𝑨</mi><mo>†</mo></msup><mi>𝒖</mi><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo>+</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mi>𝑨</mi><msup><mi>𝑨</mi><mo>†</mo></msup><mi>𝒖</mi><mi>𝒉</mi><mo>)</mo></mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>)</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}\left({\bm{\beta}}_{*}^{\top}\left(\|{\bm{s}}\|^{2}{\bm{h}}^{\top}{\bm{h}}+|{\bm{h}}\|^{2}\top{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}+\frac{\xi}{\eta}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right){\bm{\beta}}_{*}\right)=O\left(\frac{1}{d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.12" class="ltx_p"><span id="A4.SS5.SSS7.p6.12.1" class="ltx_text">Then recalling the mean and variance of <math id="A4.SS5.SSS7.p6.m2" class="ltx_Math" alttext="\eta^{2}/\gamma_{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>/</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\eta^{2}/\gamma_{2}</annotation></semantics></math> from Lemma <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>, and using the covariance bound for the expectation of products, we get that</span></p>
<table id="A4.Ex488" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex488.m1" class="ltx_math_unparsed" alttext="\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}\left(\|{\bm{s}}\|^{2}{\bm{h}}^{\top}{\bm{h}}+|{\bm{h}}\|^{2}\top{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}+\frac{\xi}{\eta}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right){\bm{\beta}}_{*}\right]=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}+\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)+o(1)+O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo>[</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mrow><mo>(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝒔</mi><msup><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msup><msup><mi>𝒉</mi><mo>⊤</mo></msup><mi>𝒉</mi><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝒉</mi><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.222em">⊤</mo><mi>𝑨</mi><msup><mi>𝑨</mi><mo>†</mo></msup><mi>𝒖</mi><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo>+</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mi>𝑨</mi><msup><mi>𝑨</mi><mo>†</mo></msup><mi>𝒖</mi><mi>𝒉</mi><mo>)</mo></mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>]</mo></mrow><mo>=</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mrow><mo>(</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo>+</mo><mfrac><mn>1</mn><mi>c</mi></mfrac><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝒖</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>O</mi><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}\left(\|{\bm{s}}\|^{2}{\bm{h}}^{\top}{\bm{h}}+|{\bm{h}}\|^{2}\top{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}+\frac{\xi}{\eta}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}\right){\bm{\beta}}_{*}\right]=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}+\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.13" class="ltx_p"><span id="A4.SS5.SSS7.p6.13.1" class="ltx_text">Adding all five terms, we get that</span></p>
<table id="A4.Ex489" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex489.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]=\frac{1}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}+\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)+o(1)+O\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right]=\frac{1}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}+\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS7.p6.14" class="ltx_p"><span id="A4.SS5.SSS7.p6.14.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A4.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.6 </span>Step 5: Upscaling and Asymptotic Risk Formulas</h3>

<div id="A4.SS6.p1" class="ltx_para">
<p id="A4.SS6.p1.1" class="ltx_p">In the previous step we derived downscaled expressions for the four constituent terms of the risk: <span id="A4.SS6.p1.1.1" class="ltx_text ltx_font_bold">Bias, Variance, Data Noise, and Target Alignment</span>. We stop our abuse of notation and are explicit again about douwnscaled vs. upscaled.</p>
</div>
<section id="A4.SS6.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bias (downscaled).</h5>

<div id="A4.SS6.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px1.p1.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px1.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, the bias term is</p>
<table id="A4.Ex490" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex490.m1" class="ltx_Math" alttext="\frac{\tilde{\eta}^{2}}{\tilde{n}}\!\left(\Big[(\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\eta^{2}c+\rho^{2}}(\alpha_{Z}-\alpha_{A})\Big]^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\tau_{\varepsilon,r}^{2}\,\frac{c}{1-c}\,\frac{1}{\eta^{2}c+\rho^{2}}\right)+o\left(\frac{1}{\tilde{n}}\right)+o\left(\frac{1}{n}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mover accent="true"><mi>η</mi><mo>~</mo></mover><mn>2</mn></msup><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\eta}^{2}}{\tilde{n}}\!\left(\Big[(\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\eta^{2}c+\rho^{2}}(\alpha_{Z}-\alpha_{A})\Big]^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\tau_{\varepsilon,r}^{2}\,\frac{c}{1-c}\,\frac{1}{\eta^{2}c+\rho^{2}}\right)+o\left(\frac{1}{\tilde{n}}\right)+o\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px1.p1.2" class="ltx_p">For <math id="A4.SS6.SSS0.Px1.p1.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the bias term is</p>
<table id="A4.Ex491" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex491.m1" class="ltx_Math" alttext="\begin{split}\frac{\tilde{\eta}^{2}}{\tilde{n}}\!\left[({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\eta^{2}+\rho^{2}}\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\right)^{\!2}+\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\Big(\tfrac{c-1}{c}\Big)\frac{\eta^{2}\rho^{2}}{(\eta^{2}+\rho^{2})^{2}}\right.\quad\quad\\
\quad\quad\left.+\frac{\tau_{\varepsilon,r}^{2}}{c-1}\,\frac{\eta^{2}c+\rho^{2}}{(\eta^{2}+\rho^{2})^{2}}\right].+o\left(\frac{1}{\tilde{n}}\right)+o\left(\frac{1}{n}\right)\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><msup><mover accent="true"><mi>η</mi><mo>~</mo></mover><mn>2</mn></msup><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo>[</mo><mo stretchy="false">(</mo><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒖</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mo stretchy="false">(</mo><mover accent="true"><mi>α</mi><mo>~</mo></mover><msub><mrow></mrow><mi>Z</mi></msub><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>Z</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>α</mi><msub><mrow></mrow><mi>Z</mi></msub><mo>−</mo><mstyle displaystyle="false"><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo><mo>)</mo><msup><mrow></mrow><mn>2</mn></msup><mo>+</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mi>c</mi></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>+</mo><mfrac><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mfrac><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>]</mo><mo lspace="0em" rspace="0em">.</mo><mo lspace="0em">+</mo><mi>o</mi><mo>(</mo><mfrac><mn>1</mn><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo>)</mo><mo>+</mo><mi>o</mi><mo>(</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\frac{\tilde{\eta}^{2}}{\tilde{n}}\!\left[({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\eta^{2}+\rho^{2}}\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\right)^{\!2}+\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\Big(\tfrac{c-1}{c}\Big)\frac{\eta^{2}\rho^{2}}{(\eta^{2}+\rho^{2})^{2}}\right.\quad\quad\\
\quad\quad\left.+\frac{\tau_{\varepsilon,r}^{2}}{c-1}\,\frac{\eta^{2}c+\rho^{2}}{(\eta^{2}+\rho^{2})^{2}}\right].+o\left(\frac{1}{\tilde{n}}\right)+o\left(\frac{1}{n}\right)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Variance (downscaled).</h5>

<div id="A4.SS6.SSS0.Px2.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px2.p1.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px2.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, the variance term is</p>
<table id="A4.Ex492" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex492.m1" class="ltx_Math" alttext="\begin{split}\frac{\tilde{\rho}^{2}}{d}\!\left[\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\alpha_{Z}-\alpha_{A})^{2}\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\,\frac{c^{2}}{1-c}+2\alpha_{A}(\alpha_{Z}-\alpha_{A})\,\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}\right)\right.\quad\quad\\
\quad\quad\left.+\tau_{\varepsilon,r}^{2}\!\left(\frac{c}{1-c}\frac{d}{\rho^{2}}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}c+\rho^{2})}\,\frac{c^{2}}{1-c}\right)\right].\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac><mo>[</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mo stretchy="false">(</mo><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒖</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mo stretchy="false">(</mo><mi>α</mi><msub><mrow></mrow><mi>Z</mi></msub><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><mo stretchy="false">(</mo><mi>α</mi><msub><mrow></mrow><mi>Z</mi></msub><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><mo rspace="0.340em" stretchy="false">)</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>+</mo><mpadded style="width:0.380em;" width="0.380em"><mi>τ</mi></mpadded><msub><mrow></mrow><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mfrac><mi>d</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>−</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo>)</mo><mo>]</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\frac{\tilde{\rho}^{2}}{d}\!\left[\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\alpha_{Z}-\alpha_{A})^{2}\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\,\frac{c^{2}}{1-c}+2\alpha_{A}(\alpha_{Z}-\alpha_{A})\,\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}\right)\right.\quad\quad\\
\quad\quad\left.+\tau_{\varepsilon,r}^{2}\!\left(\frac{c}{1-c}\frac{d}{\rho^{2}}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}c+\rho^{2})}\,\frac{c^{2}}{1-c}\right)\right].\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px2.p1.2" class="ltx_p">For <math id="A4.SS6.SSS0.Px2.p1.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the variance term is</p>
<table id="A4.Ex493" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex493.m1" class="ltx_Math" alttext="\frac{\tilde{\rho}^{2}}{d}\!\left[\|{\bm{\beta}}_{*}\|^{2}\!\left(\frac{\alpha_{A}^{2}}{c}-\frac{\alpha_{A}^{2}}{d}\,\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\right)+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{c}{c-1}\,\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\,\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)^{2}+\tau_{\varepsilon,r}^{2}\!\left(\frac{d}{\rho^{2}}\frac{1}{c-1}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}+\rho^{2})}\,\frac{c}{c-1}\right)\right]." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mi>c</mi></mfrac><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mi>d</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mstyle displaystyle="false"><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mi>d</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>−</mo><mrow><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\rho}^{2}}{d}\!\left[\|{\bm{\beta}}_{*}\|^{2}\!\left(\frac{\alpha_{A}^{2}}{c}-\frac{\alpha_{A}^{2}}{d}\,\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\right)+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{c}{c-1}\,\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\,\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)^{2}+\tau_{\varepsilon,r}^{2}\!\left(\frac{d}{\rho^{2}}\frac{1}{c-1}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}+\rho^{2})}\,\frac{c}{c-1}\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Data noise (downscaled).</h5>

<div id="A4.SS6.SSS0.Px3.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px3.p1.1" class="ltx_p">The data noise term is</p>
<table id="A4.Ex494" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex494.m1" class="ltx_Math" alttext="\frac{\tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2}}{d}\,\|{\bm{\beta}}_{*}\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0.170em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mi>d</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2}}{d}\,\|{\bm{\beta}}_{*}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Target alignment (downscaled).</h5>

<div id="A4.SS6.SSS0.Px4.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px4.p1.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px4.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, the alignment term is</p>
<table id="A4.Ex495" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex495.m1" class="ltx_Math" alttext="-\frac{2\tilde{\alpha}_{A}\tilde{\rho}^{2}}{d}\left(\alpha_{A}\|{\bm{\beta}}_{*}\|^{2}+(\alpha_{Z}-\alpha_{A})\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-\frac{2\tilde{\alpha}_{A}\tilde{\rho}^{2}}{d}\left(\alpha_{A}\|{\bm{\beta}}_{*}\|^{2}+(\alpha_{Z}-\alpha_{A})\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px4.p1.2" class="ltx_p">For <math id="A4.SS6.SSS0.Px4.p1.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the alignment term is</p>
<table id="A4.Ex496" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex496.m1" class="ltx_Math" alttext="-\frac{2\tilde{\alpha}_{A}\tilde{\rho}^{2}}{d}\left(\frac{\alpha_{A}}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\alpha_{A}}{d}\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\,\|{\bm{\beta}}_{*}\|^{2}+\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mstyle displaystyle="false"><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-\frac{2\tilde{\alpha}_{A}\tilde{\rho}^{2}}{d}\left(\frac{\alpha_{A}}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\alpha_{A}}{d}\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\,\|{\bm{\beta}}_{*}\|^{2}+\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px4.p1.3" class="ltx_p">These formulas are expressed in terms of the concentrated building blocks, but still at the “microscopic” scale in which <math id="A4.SS6.SSS0.Px4.p1.m3" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is <math id="A4.SS6.SSS0.Px4.p1.m4" class="ltx_Math" alttext="O(\sqrt{d})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>d</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\sqrt{d})</annotation></semantics></math>, <math id="A4.SS6.SSS0.Px4.p1.m5" class="ltx_Math" alttext="\rho=\Theta(1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho=\Theta(1)</annotation></semantics></math>, and <math id="A4.SS6.SSS0.Px4.p1.m6" class="ltx_Math" alttext="\tau_{\varepsilon,r}^{2}=O(1/d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{\varepsilon,r}^{2}=O(1/d)</annotation></semantics></math>.</p>
</div>
<div id="A4.SS6.SSS0.Px4.p2" class="ltx_para">
<p id="A4.SS6.SSS0.Px4.p2.1" class="ltx_p">In this section we return to the macroscopic, or upscaled, version of the problem. Specifically, we multiply each term by <math id="A4.SS6.SSS0.Px4.p2.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and reparametrize according to</p>
<table id="A4.Ex497" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex497.m1" class="ltx_Math" alttext="\theta^{2}\;=\;\frac{d}{n}\eta^{2},\qquad\tilde{\theta}^{2}\;=\;\frac{d}{\tilde{n}}\tilde{\eta}^{2},\qquad\tau_{\varepsilon}^{2}\;=\;d\,\tau_{\varepsilon,r}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mfrac><mi>d</mi><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mn>2</mn></msup><mo rspace="0.558em">=</mo><mrow><mfrac><mi>d</mi><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>η</mi><mo>~</mo></mover><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo rspace="0.558em">=</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta^{2}\;=\;\frac{d}{n}\eta^{2},\qquad\tilde{\theta}^{2}\;=\;\frac{d}{\tilde{n}}\tilde{\eta}^{2},\qquad\tau_{\varepsilon}^{2}\;=\;d\,\tau_{\varepsilon,r}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px4.p2.2" class="ltx_p">while keeping <math id="A4.SS6.SSS0.Px4.p2.m2" class="ltx_Math" alttext="\rho,\tilde{\rho}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>,</mo><mover accent="true"><mi>ρ</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\rho,\tilde{\rho}</annotation></semantics></math> fixed. This normalization ensures that the effective spike strength <math id="A4.SS6.SSS0.Px4.p2.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, isotropic noise level <math id="A4.SS6.SSS0.Px4.p2.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, and label noise <math id="A4.SS6.SSS0.Px4.p2.m5" class="ltx_Math" alttext="\tau_{\varepsilon,r}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{\varepsilon,r}</annotation></semantics></math> are all of order one. In this scaling, the risk is <math id="A4.SS6.SSS0.Px4.p2.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> times larger than in the downscaled representation, and the resulting formulas cleanly separate the contributions of the four terms.</p>
</div>
<div id="A4.SS6.SSS0.Px4.p3" class="ltx_para">
<p id="A4.SS6.SSS0.Px4.p3.1" class="ltx_p">The terms change as follows</p>
</div>
</section>
<section id="A4.SS6.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Front factors (after multiplying by <math id="A4.SS6.SSS0.Px5.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>).</h5>

<div id="A4.SS6.SSS0.Px5.p1" class="ltx_para">
<table id="A4.EGx124" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E20.m1" class="ltx_Math" alttext="\displaystyle\frac{\tilde{\eta}^{2}}{\tilde{n}}\ \xrightarrow{\ \times d\ }\ \tilde{\theta}^{2},\qquad\frac{\tilde{\rho}^{2}}{d}\ \xrightarrow{\ \times d\ }\ \tilde{\rho}^{2},\qquad\frac{\tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2}}{d}\ \xrightarrow{\ \times d\ }\ \tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2},\qquad d\,\tau_{\varepsilon,r}^{2}\ \to\ \tau_{\varepsilon}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>η</mi><mo>~</mo></mover><mn>2</mn></msup><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac></mstyle><mover accent="true"><mo lspace="0.778em">→</mo><mrow><mphantom></mphantom><mo lspace="0.632em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">d</mi></mrow></mover><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mo rspace="2.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mover accent="true"><mo lspace="0.778em">→</mo><mrow><mphantom></mphantom><mo lspace="0.632em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">d</mi></mrow></mover><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mo rspace="2.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0.170em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mi>d</mi></mfrac></mstyle><mover accent="true"><mo lspace="0.778em">→</mo><mrow><mphantom></mphantom><mo lspace="0.632em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">d</mi></mrow></mover><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup></mrow><mo rspace="0.778em" stretchy="false">→</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\tilde{\eta}^{2}}{\tilde{n}}\ \xrightarrow{\ \times d\ }\ \tilde{\theta}^{2},\qquad\frac{\tilde{\rho}^{2}}{d}\ \xrightarrow{\ \times d\ }\ \tilde{\rho}^{2},\qquad\frac{\tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2}}{d}\ \xrightarrow{\ \times d\ }\ \tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2},\qquad d\,\tau_{\varepsilon,r}^{2}\ \to\ \tau_{\varepsilon}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Denominator identities.</h5>

<div id="A4.SS6.SSS0.Px6.p1" class="ltx_para">
<table id="A4.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E21.m1" class="ltx_Math" alttext="\displaystyle\eta^{2}c+\rho^{2}\;=\;\theta^{2}+\rho^{2},\qquad\eta^{2}+\rho^{2}\;=\;\frac{\theta^{2}+c\,\rho^{2}}{c}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo rspace="0.558em">=</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo rspace="0.558em">=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mi>c</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta^{2}c+\rho^{2}\;=\;\theta^{2}+\rho^{2},\qquad\eta^{2}+\rho^{2}\;=\;\frac{\theta^{2}+c\,\rho^{2}}{c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px7" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Frequently used ratios and their upscaled forms.</h5>

<div id="A4.SS6.SSS0.Px7.p1" class="ltx_para">
<table id="A4.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E22.m1" class="ltx_Math" alttext="\displaystyle\frac{\rho^{2}}{\eta^{2}c+\rho^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\rho^{2}}{\eta^{2}c+\rho^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E22.m2" class="ltx_Math" alttext="\displaystyle=\frac{\rho^{2}}{\theta^{2}+\rho^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\rho^{2}}{\theta^{2}+\rho^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="A4.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E23.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E23.m2" class="ltx_Math" alttext="\displaystyle=\frac{\theta^{2}}{\theta^{2}+\rho^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\theta^{2}}{\theta^{2}+\rho^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A4.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E24.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}}{\eta^{2}+\rho^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}}{\eta^{2}+\rho^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E24.m2" class="ltx_Math" alttext="\displaystyle=\frac{\theta^{2}}{\theta^{2}+c\,\rho^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\theta^{2}}{\theta^{2}+c\,\rho^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
<tbody id="A4.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E25.m1" class="ltx_Math" alttext="\displaystyle\frac{\rho^{2}}{\eta^{2}+\rho^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\rho^{2}}{\eta^{2}+\rho^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E25.m2" class="ltx_Math" alttext="\displaystyle=\frac{c\,\rho^{2}}{\theta^{2}+c\,\rho^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{c\,\rho^{2}}{\theta^{2}+c\,\rho^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
<tbody id="A4.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E26.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}\,\rho^{2}}{(\eta^{2}+\rho^{2})^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}\,\rho^{2}}{(\eta^{2}+\rho^{2})^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E26.m2" class="ltx_Math" alttext="\displaystyle=\frac{\theta^{2}\,\rho^{2}}{(\theta^{2}+c\,\rho^{2})^{2}}\;c," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.280em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\theta^{2}\,\rho^{2}}{(\theta^{2}+c\,\rho^{2})^{2}}\;c,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
<tbody id="A4.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E27.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\,\frac{c^{2}}{1-c}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\,\frac{c^{2}}{1-c}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E27.m2" class="ltx_Math" alttext="\displaystyle=\frac{\theta^{2}(\theta^{2}+c\,\rho^{2})}{(\theta^{2}+\rho^{2})^{2}}\,\frac{1}{1-c}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\theta^{2}(\theta^{2}+c\,\rho^{2})}{(\theta^{2}+\rho^{2})^{2}}\,\frac{1}{1-c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px8" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Noise terms with aspect-ratio factors.</h5>

<div id="A4.SS6.SSS0.Px8.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px8.p1.1" class="ltx_p">After multiplying by <math id="A4.SS6.SSS0.Px8.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and substituting <math id="A4.SS6.SSS0.Px8.p1.m2" class="ltx_Math" alttext="\tau_{\varepsilon}^{2}=d\,\tau_{\varepsilon,r}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo>=</mo><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\tau_{\varepsilon}^{2}=d\,\tau_{\varepsilon,r}^{2}</annotation></semantics></math>:</p>
<table id="A4.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E28.m1" class="ltx_Math" alttext="\displaystyle\tau_{\varepsilon,r}^{2}\left(\frac{c}{1-c}\frac{d}{\rho^{2}}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}c+\rho^{2})}\frac{c^{2}}{1-c}\right)\ \longrightarrow\ \tau_{\varepsilon}^{2}\left(\frac{1}{\rho^{2}}\frac{c}{1-c}-\frac{\theta^{2}}{\rho^{2}(\theta^{2}+\rho^{2})}\frac{c}{1-c}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow></mrow><mo rspace="0.500em">)</mo></mrow></mrow><mo rspace="0.778em" stretchy="false">⟶</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\varepsilon,r}^{2}\left(\frac{c}{1-c}\frac{d}{\rho^{2}}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}c+\rho^{2})}\frac{c^{2}}{1-c}\right)\ \longrightarrow\ \tau_{\varepsilon}^{2}\left(\frac{1}{\rho^{2}}\frac{c}{1-c}-\frac{\theta^{2}}{\rho^{2}(\theta^{2}+\rho^{2})}\frac{c}{1-c}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
<tbody id="A4.E29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E29.m1" class="ltx_Math" alttext="\displaystyle\tau_{\varepsilon,r}^{2}\left(\frac{d}{\rho^{2}}\frac{1}{c-1}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}+\rho^{2})}\frac{c}{c-1}\right)\ \longrightarrow\ \tau_{\varepsilon}^{2}\left(\frac{1}{\rho^{2}}\frac{1}{c-1}-\frac{\theta^{2}}{\rho^{2}(\theta^{2}+c\,\rho^{2})}\frac{c}{c-1}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>τ</mi><mrow><mi>ε</mi><mo>,</mo><mi>r</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo rspace="0.500em">)</mo></mrow></mrow><mo rspace="0.778em" stretchy="false">⟶</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\varepsilon,r}^{2}\left(\frac{d}{\rho^{2}}\frac{1}{c-1}-\frac{\eta^{2}}{\rho^{2}(\eta^{2}+\rho^{2})}\frac{c}{c-1}\right)\ \longrightarrow\ \tau_{\varepsilon}^{2}\left(\frac{1}{\rho^{2}}\frac{1}{c-1}-\frac{\theta^{2}}{\rho^{2}(\theta^{2}+c\,\rho^{2})}\frac{c}{c-1}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px9" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Alignment-specific identities.</h5>

<div id="A4.SS6.SSS0.Px9.p1" class="ltx_para">
<table id="A4.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E30.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}c}{\rho^{2}+\eta^{2}c}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E30.m2" class="ltx_Math" alttext="\displaystyle=\frac{\theta^{2}}{\rho^{2}+\theta^{2}},\qquad\frac{\eta^{2}}{\eta^{2}+\rho^{2}}=\frac{\theta^{2}}{\theta^{2}+c\,\rho^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>θ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo rspace="2.167em">,</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\theta^{2}}{\rho^{2}+\theta^{2}},\qquad\frac{\eta^{2}}{\eta^{2}+\rho^{2}}=\frac{\theta^{2}}{\theta^{2}+c\,\rho^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS6.SSS0.Px9.p2" class="ltx_para">
<p id="A4.SS6.SSS0.Px9.p2.1" class="ltx_p">We now state the explicit upscaled limits for each component. As before, we present results separately in the underparametrized regime (<math id="A4.SS6.SSS0.Px9.p2.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>) and the overparametrized regime (<math id="A4.SS6.SSS0.Px9.p2.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>). Each term has a little <math id="A4.SS6.SSS0.Px9.p2.m3" class="ltx_Math" alttext="o(1)" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(1)</annotation></semantics></math> error term.</p>
</div>
</section>
<section id="A4.SS6.SSS0.Px10" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bias.</h5>

<div id="A4.SS6.SSS0.Px10.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px10.p1.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px10.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, the bias contribution is</p>
<table id="A4.Ex498" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex498.m1" class="ltx_Math" alttext="\tilde{\theta}^{2}\!\left(\Big[(\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\theta^{2}+\rho^{2}}(\alpha_{Z}-\alpha_{A})\Big]^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{\tau_{\varepsilon}^{2}}{d}\,\frac{c}{1-c}\,\frac{1}{\theta^{2}+\rho^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mfrac><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mi>d</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\theta}^{2}\!\left(\Big[(\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\theta^{2}+\rho^{2}}(\alpha_{Z}-\alpha_{A})\Big]^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{\tau_{\varepsilon}^{2}}{d}\,\frac{c}{1-c}\,\frac{1}{\theta^{2}+\rho^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS6.SSS0.Px10.p2" class="ltx_para">
<p id="A4.SS6.SSS0.Px10.p2.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px10.p2.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the bias is</p>
<table id="A4.Ex499" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex499.m1" class="ltx_Math" alttext="\tilde{\theta}^{2}\!\left[({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\tfrac{\theta^{2}}{c}+\rho^{2}}\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\right)^{\!2}+\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\left(\frac{c-1}{c}\right)\frac{\tfrac{\theta^{2}}{c}\rho^{2}}{\big(\tfrac{\theta^{2}}{c}+\rho^{2}\big)^{2}}+\frac{\tau_{\varepsilon}^{2}}{d}\,\frac{1}{c-1}\,\frac{\theta^{2}+\rho^{2}}{\big(\tfrac{\theta^{2}}{c}+\rho^{2}\big)^{2}}\right]." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mrow><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mi>c</mi></mfrac><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mstyle displaystyle="false"><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mi>c</mi></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mi>c</mi></mfrac><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mrow><mfrac><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mi>d</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mi>c</mi></mfrac><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\theta}^{2}\!\left[({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\tilde{\alpha}_{Z}-\alpha_{Z})+\frac{\rho^{2}}{\tfrac{\theta^{2}}{c}+\rho^{2}}\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\right)^{\!2}+\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\left(\frac{c-1}{c}\right)\frac{\tfrac{\theta^{2}}{c}\rho^{2}}{\big(\tfrac{\theta^{2}}{c}+\rho^{2}\big)^{2}}+\frac{\tau_{\varepsilon}^{2}}{d}\,\frac{1}{c-1}\,\frac{\theta^{2}+\rho^{2}}{\big(\tfrac{\theta^{2}}{c}+\rho^{2}\big)^{2}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px11" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Variance.</h5>

<div id="A4.SS6.SSS0.Px11.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px11.p1.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px11.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, the variance contribution is</p>
<table id="A4.Ex500" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex500.m1" class="ltx_Math" alttext="\begin{split}\tilde{\rho}^{2}\!\left[\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\alpha_{Z}-\alpha_{A})^{2}\,\frac{\theta^{2}(\theta^{2}+c\rho^{2})}{(\theta^{2}+\rho^{2})^{2}}\,\frac{1}{1-c}+2\alpha_{A}(\alpha_{Z}-\alpha_{A})\,\frac{\theta^{2}}{\theta^{2}+\rho^{2}}\right)\right.\\
\left.+\tau_{\varepsilon}^{2}\!\left(\frac{1}{\rho^{2}}\,\frac{c}{1-c}-\frac{1}{d}\,\frac{\theta^{2}}{\rho^{2}(\theta^{2}+\rho^{2})}\cdot\frac{c}{1-c}\right)\right].\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><msup><mrow></mrow><mn>2</mn></msup><mo>[</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mo stretchy="false">(</mo><mi>𝜷</mi><msub><mrow></mrow><mo>∗</mo></msub><msup><mrow></mrow><mo>⊤</mo></msup><mi>𝒖</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mo stretchy="false">(</mo><mi>α</mi><msub><mrow></mrow><mi>Z</mi></msub><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><mo rspace="0.170em" stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mfrac><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><mo stretchy="false">(</mo><mi>α</mi><msub><mrow></mrow><mi>Z</mi></msub><mo>−</mo><mi>α</mi><msub><mrow></mrow><mi>A</mi></msub><mo rspace="0.340em" stretchy="false">)</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>+</mo><mpadded style="width:0.380em;" width="0.380em"><mi>τ</mi></mpadded><msub><mrow></mrow><mi>ε</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo>)</mo><mo>]</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\tilde{\rho}^{2}\!\left[\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\!\left((\alpha_{Z}-\alpha_{A})^{2}\,\frac{\theta^{2}(\theta^{2}+c\rho^{2})}{(\theta^{2}+\rho^{2})^{2}}\,\frac{1}{1-c}+2\alpha_{A}(\alpha_{Z}-\alpha_{A})\,\frac{\theta^{2}}{\theta^{2}+\rho^{2}}\right)\right.\\
\left.+\tau_{\varepsilon}^{2}\!\left(\frac{1}{\rho^{2}}\,\frac{c}{1-c}-\frac{1}{d}\,\frac{\theta^{2}}{\rho^{2}(\theta^{2}+\rho^{2})}\cdot\frac{c}{1-c}\right)\right].\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS6.SSS0.Px11.p2" class="ltx_para">
<p id="A4.SS6.SSS0.Px11.p2.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px11.p2.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the variance is</p>
<table id="A4.Ex501" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex501.m1" class="ltx_Math" alttext="\tilde{\rho}^{2}\!\left[\|{\bm{\beta}}_{*}\|^{2}\!\left(\frac{\alpha_{A}^{2}}{c}-\frac{\alpha_{A}^{2}}{d}\,\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\right)+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{c}{c-1}\,\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)^{\!2}+\tau_{\varepsilon}^{2}\!\left(\frac{1}{\rho^{2}}\,\frac{1}{c-1}-\frac{1}{d}\,\frac{\theta^{2}}{\rho^{2}(\theta^{2}+c\rho^{2})}\cdot\frac{c}{c-1}\right)\right]." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mi>c</mi></mfrac><mo>−</mo><mrow><mfrac><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mi>d</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mstyle displaystyle="false"><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>−</mo><mrow><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\rho}^{2}\!\left[\|{\bm{\beta}}_{*}\|^{2}\!\left(\frac{\alpha_{A}^{2}}{c}-\frac{\alpha_{A}^{2}}{d}\,\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\right)+({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{c}{c-1}\,\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)^{\!2}+\tau_{\varepsilon}^{2}\!\left(\frac{1}{\rho^{2}}\,\frac{1}{c-1}-\frac{1}{d}\,\frac{\theta^{2}}{\rho^{2}(\theta^{2}+c\rho^{2})}\cdot\frac{c}{c-1}\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px12" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Data Noise.</h5>

<div id="A4.SS6.SSS0.Px12.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px12.p1.1" class="ltx_p">The data noise term is independent of <math id="A4.SS6.SSS0.Px12.p1.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>:</p>
<table id="A4.Ex502" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex502.m1" class="ltx_Math" alttext="\tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2}\,\|{\bm{\beta}}_{*}\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0.170em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\alpha}_{A}^{2}\,\tilde{\rho}^{2}\,\|{\bm{\beta}}_{*}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4.SS6.SSS0.Px13" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Target Alignment.</h5>

<div id="A4.SS6.SSS0.Px13.p1" class="ltx_para">
<p id="A4.SS6.SSS0.Px13.p1.1" class="ltx_p">For <math id="A4.SS6.SSS0.Px13.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, the target alignment contribution is</p>
<table id="A4.Ex503" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex503.m1" class="ltx_Math" alttext="-2\tilde{\alpha}_{A}\tilde{\rho}^{2}\left(\alpha_{A}\|{\bm{\beta}}_{*}\|^{2}+(\alpha_{Z}-\alpha_{A})\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{\theta^{2}}{\rho^{2}+\theta^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>θ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-2\tilde{\alpha}_{A}\tilde{\rho}^{2}\left(\alpha_{A}\|{\bm{\beta}}_{*}\|^{2}+(\alpha_{Z}-\alpha_{A})\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\,\frac{\theta^{2}}{\rho^{2}+\theta^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px13.p1.2" class="ltx_p">For <math id="A4.SS6.SSS0.Px13.p1.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the alignment term is</p>
<table id="A4.Ex504" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex504.m1" class="ltx_Math" alttext="-2\tilde{\alpha}_{A}\tilde{\rho}^{2}\left(\frac{\alpha_{A}}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\alpha_{A}}{d}\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\|{\bm{\beta}}_{*}\|^{2}+\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\,\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mstyle displaystyle="false"><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mrow></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-2\tilde{\alpha}_{A}\tilde{\rho}^{2}\left(\frac{\alpha_{A}}{c}\|{\bm{\beta}}_{*}\|^{2}-\frac{\alpha_{A}}{d}\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\|{\bm{\beta}}_{*}\|^{2}+\Big(\alpha_{Z}-\tfrac{\alpha_{A}}{c}\Big)\,\frac{\theta^{2}}{\theta^{2}+c\rho^{2}}\,({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.SSS0.Px13.p1.3" class="ltx_p">Lastly, replacing <math id="A4.SS6.SSS0.Px13.p1.m3" class="ltx_Math" alttext="\tilde{\rho}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ρ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\rho}</annotation></semantics></math>, <math id="A4.SS6.SSS0.Px13.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> with <math id="A4.SS6.SSS0.Px13.p1.m5" class="ltx_Math" alttext="\tilde{\tau}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>τ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\tau}</annotation></semantics></math>, <math id="A4.SS6.SSS0.Px13.p1.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> and using <math id="A4.SS6.SSS0.Px13.p1.m7" class="ltx_Math" alttext="d/n\to c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">→</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">d/n\to c</annotation></semantics></math> yield the detailed expressions in Theorem <a href="#Thmtheorem5" title="Theorem 5 (Generalization Risk). ‣ 3.4 General Theorem ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, up to simple algebra (rearranging terms and simplifying the fractions).</p>
</div>
</section>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Probability Lemmas</h2>

<div id="Thmprop2" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmprop2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop2.p1" class="ltx_para">
<p id="Thmprop2.p1.1" class="ltx_p"><span id="Thmprop2.p1.1.1" class="ltx_text ltx_font_italic">If <math id="Thmprop2.p1.m1" class="ltx_Math" alttext="{\bm{u}},{\bm{v}}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐮</mi><mo>,</mo><mi>𝐯</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{u}},{\bm{v}}\in\mathbb{R}^{d}</annotation></semantics></math> are fixed unit norm vector and <math id="Thmprop2.p1.m2" class="ltx_Math" alttext="{\bm{A}}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}\in\mathbb{R}^{d\times n}</annotation></semantics></math> is a Gaussian matrix with i.i.d. <math id="Thmprop2.p1.m3" class="ltx_Math" alttext="\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,1)</annotation></semantics></math> entries. If <math id="Thmprop2.p1.m4" class="ltx_Math" alttext="d&gt;n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&gt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d&gt;n</annotation></semantics></math>, then we have that</span></p>
<table id="A5.Ex505" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex505.m1" class="ltx_Math" alttext="\mathbb{E}[({\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{v}})^{2}]=\frac{n}{d(d+2)}\left[({\bm{u}}^{\top}{\bm{v}})^{2}(n+2)+\frac{(1-({\bm{u}}^{\top}{\bm{v}})^{2})(d-n)}{d-1}\right]=\frac{1}{c^{2}}({\bm{u}}^{\top}{\bm{v}})^{2}+o(1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi>n</mi><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[({\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{v}})^{2}]=\frac{n}{d(d+2)}\left[({\bm{u}}^{\top}{\bm{v}})^{2}(n+2)+\frac{(1-({\bm{u}}^{\top}{\bm{v}})^{2})(d-n)}{d-1}\right]=\frac{1}{c^{2}}({\bm{u}}^{\top}{\bm{v}})^{2}+o(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex506" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex506.m1" class="ltx_Math" alttext="\mathrm{Var}\left({\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{v}})^{2}\right)=O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\left({\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{v}})^{2}\right)=O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p"><span id="A5.p1.1.1" class="ltx_text">Let <math id="A5.p1.m1" class="ltx_Math" alttext="{\bm{P}}:={\bm{A}}{\bm{A}}^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><mo>:=</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{P}}:={\bm{A}}{\bm{A}}^{\dagger}</annotation></semantics></math>. This is the orthogonal projection matrix onto the column space of <math id="A5.p1.m2" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>, denoted <math id="A5.p1.m3" class="ltx_Math" alttext="C({\bm{A}})=\text{Range}({\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>Range</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C({\bm{A}})=\text{Range}({\bm{A}})</annotation></semantics></math>. The subspace <math id="A5.p1.m4" class="ltx_Math" alttext="C({\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\bm{A}})</annotation></semantics></math> is an <math id="A5.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional subspace of <math id="A5.p1.m6" class="ltx_Math" alttext="\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{R}^{d}</annotation></semantics></math>. Because the entries <math id="A5.p1.m7" class="ltx_Math" alttext="A_{ij}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">A_{ij}</annotation></semantics></math> are i.i.d. <math id="A5.p1.m8" class="ltx_Math" alttext="\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,1)</annotation></semantics></math>, the distribution of the random subspace <math id="A5.p1.m9" class="ltx_Math" alttext="C({\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\bm{A}})</annotation></semantics></math> is isotropic (or rotationally invariant). Consequently, the distribution of the random projection matrix <math id="A5.p1.m10" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> is also rotationally invariant. That is, for any fixed <math id="A5.p1.m11" class="ltx_Math" alttext="d\times d" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d\times d</annotation></semantics></math> orthogonal matrix <math id="A5.p1.m12" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi>𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math>, the distribution of <math id="A5.p1.m13" class="ltx_Math" alttext="{\bm{Q}}{\bm{P}}{\bm{Q}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{Q}}{\bm{P}}{\bm{Q}}^{\top}</annotation></semantics></math> is the same as the distribution of <math id="A5.p1.m14" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p"><span id="A5.p2.1.1" class="ltx_text">We are interested in <math id="A5.p2.m1" class="ltx_Math" alttext="\mathbb{E}[({\bm{u}}^{\top}{\bm{P}}{\bm{v}})^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[({\bm{u}}^{\top}{\bm{P}}{\bm{v}})^{2}]</annotation></semantics></math>. Let <math id="A5.p2.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> be the angle between <math id="A5.p2.m3" class="ltx_Math" alttext="{\bm{u}}" display="inline" intent=":literal"><semantics><mi>𝒖</mi><annotation encoding="application/x-tex">{\bm{u}}</annotation></semantics></math> and <math id="A5.p2.m4" class="ltx_Math" alttext="{\bm{v}}" display="inline" intent=":literal"><semantics><mi>𝒗</mi><annotation encoding="application/x-tex">{\bm{v}}</annotation></semantics></math>, such that <math id="A5.p2.m5" class="ltx_Math" alttext="\cos(\theta)={\bm{u}}^{\top}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">\cos(\theta)={\bm{u}}^{\top}{\bm{v}}</annotation></semantics></math> (since they are unit vectors). Due to the rotational invariance of the distribution of <math id="A5.p2.m6" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math>, we can choose an orthonormal basis without loss of generality. Let <math id="A5.p2.m7" class="ltx_Math" alttext="{\bm{Q}}" display="inline" intent=":literal"><semantics><mi>𝑸</mi><annotation encoding="application/x-tex">{\bm{Q}}</annotation></semantics></math> be an orthogonal matrix such that <math id="A5.p2.m8" class="ltx_Math" alttext="{\bm{u}}^{\prime}={\bm{Q}}{\bm{u}}={\bm{e}}_{1}=(1,0,\dots,0)^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒖</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>=</mo><msub><mi>𝒆</mi><mn>1</mn></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{u}}^{\prime}={\bm{Q}}{\bm{u}}={\bm{e}}_{1}=(1,0,\dots,0)^{\top}</annotation></semantics></math> and <math id="A5.p2.m9" class="ltx_Math" alttext="{\bm{v}}^{\prime}={\bm{Q}}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒗</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\prime}={\bm{Q}}{\bm{v}}</annotation></semantics></math> lies in the span of <math id="A5.p2.m10" class="ltx_Math" alttext="{\bm{e}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝒆</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{e}}_{1}</annotation></semantics></math> and <math id="A5.p2.m11" class="ltx_Math" alttext="{\bm{e}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝒆</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\bm{e}}_{2}</annotation></semantics></math>. Specifically, <math id="A5.p2.m12" class="ltx_Math" alttext="{\bm{v}}^{\prime}=\cos(\theta){\bm{e}}_{1}+\sin(\theta){\bm{e}}_{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒗</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\prime}=\cos(\theta){\bm{e}}_{1}+\sin(\theta){\bm{e}}_{2}</annotation></semantics></math>. Let <math id="A5.p2.m13" class="ltx_Math" alttext="{\bm{P}}^{\prime}={\bm{Q}}{\bm{P}}{\bm{Q}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑷</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{P}}^{\prime}={\bm{Q}}{\bm{P}}{\bm{Q}}^{\top}</annotation></semantics></math>. <math id="A5.p2.m14" class="ltx_Math" alttext="{\bm{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\bm{P}}^{\prime}</annotation></semantics></math> has the same distribution as <math id="A5.p2.m15" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math>. Then,</span></p>
<table id="A5.Ex507" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex507.m1" class="ltx_Math" alttext="{\bm{u}}^{\top}{\bm{P}}{\bm{v}}=({\bm{Q}}^{\top}{\bm{u}}^{\prime})^{\top}{\bm{P}}({\bm{Q}}^{\top}{\bm{v}}^{\prime})=({\bm{u}}^{\prime})^{\top}({\bm{Q}}{\bm{P}}{\bm{Q}}^{\top}){\bm{v}}^{\prime}=({\bm{u}}^{\prime})^{\top}{\bm{P}}^{\prime}{\bm{v}}^{\prime}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑸</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝒖</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑸</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑸</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>′</mo></msup></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝒖</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}^{\top}{\bm{P}}{\bm{v}}=({\bm{Q}}^{\top}{\bm{u}}^{\prime})^{\top}{\bm{P}}({\bm{Q}}^{\top}{\bm{v}}^{\prime})=({\bm{u}}^{\prime})^{\top}({\bm{Q}}{\bm{P}}{\bm{Q}}^{\top}){\bm{v}}^{\prime}=({\bm{u}}^{\prime})^{\top}{\bm{P}}^{\prime}{\bm{v}}^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.2" class="ltx_p"><span id="A5.p2.2.1" class="ltx_text">Substituting <math id="A5.p2.m16" class="ltx_Math" alttext="{\bm{u}}^{\prime}={\bm{e}}_{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒖</mi><mo>′</mo></msup><mo>=</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\bm{u}}^{\prime}={\bm{e}}_{1}</annotation></semantics></math> and <math id="A5.p2.m17" class="ltx_Math" alttext="{\bm{v}}^{\prime}=\cos(\theta){\bm{e}}_{1}+\sin(\theta){\bm{e}}_{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒗</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\prime}=\cos(\theta){\bm{e}}_{1}+\sin(\theta){\bm{e}}_{2}</annotation></semantics></math>:</span></p>
<table id="A5.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex508"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex508.m1" class="ltx_Math" alttext="\displaystyle{\bm{u}}^{\top}{\bm{P}}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{u}}^{\top}{\bm{P}}{\bm{v}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex508.m2" class="ltx_Math" alttext="\displaystyle={\bm{e}}_{1}^{\top}{\bm{P}}^{\prime}(\cos(\theta){\bm{e}}_{1}+\sin(\theta){\bm{e}}_{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝒆</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{e}}_{1}^{\top}{\bm{P}}^{\prime}(\cos(\theta){\bm{e}}_{1}+\sin(\theta){\bm{e}}_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex509"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex509.m1" class="ltx_Math" alttext="\displaystyle=\cos(\theta)({\bm{e}}_{1}^{\top}{\bm{P}}^{\prime}{\bm{e}}_{1})+\sin(\theta)({\bm{e}}_{1}^{\top}{\bm{P}}^{\prime}e_{2})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝒆</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝒆</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cos(\theta)({\bm{e}}_{1}^{\top}{\bm{P}}^{\prime}{\bm{e}}_{1})+\sin(\theta)({\bm{e}}_{1}^{\top}{\bm{P}}^{\prime}e_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex510"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex510.m1" class="ltx_Math" alttext="\displaystyle=\cos(\theta)P^{\prime}_{11}+\sin(\theta)P^{\prime}_{12}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>11</mn><mo>′</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mo>′</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cos(\theta)P^{\prime}_{11}+\sin(\theta)P^{\prime}_{12}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.3" class="ltx_p"><span id="A5.p2.3.1" class="ltx_text">where <math id="A5.p2.m18" class="ltx_Math" alttext="P^{\prime}_{ij}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">P^{\prime}_{ij}</annotation></semantics></math> are the elements of <math id="A5.p2.m19" class="ltx_Math" alttext="{\bm{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\bm{P}}^{\prime}</annotation></semantics></math>. Since <math id="A5.p2.m20" class="ltx_Math" alttext="{\bm{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\bm{P}}^{\prime}</annotation></semantics></math> has the same distribution as <math id="A5.p2.m21" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math>, we can drop the prime for calculating expectations involving the elements. Let <math id="A5.p2.m22" class="ltx_Math" alttext="{\bm{X}}={\bm{u}}^{\top}{\bm{P}}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑿</mi><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{X}}={\bm{u}}^{\top}{\bm{P}}{\bm{v}}</annotation></semantics></math>. We then need <math id="A5.p2.m23" class="ltx_Math" alttext="\mathbb{E}[X^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{2}]</annotation></semantics></math>.</span></p>
<table id="A5.EGx130" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex511"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex511.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[X^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[X^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex511.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[(\cos(\theta)P_{11}+\sin(\theta)P_{12})^{2}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>11</mn></msub></mrow><mo>+</mo><mrow><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[(\cos(\theta)P_{11}+\sin(\theta)P_{12})^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex512"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex512.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[\cos^{2}(\theta)P_{11}^{2}+\sin^{2}(\theta)P_{12}^{2}+2\cos(\theta)\sin(\theta)P_{11}P_{12}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\cos^{2}(\theta)P_{11}^{2}+\sin^{2}(\theta)P_{12}^{2}+2\cos(\theta)\sin(\theta)P_{11}P_{12}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex513"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex513.m1" class="ltx_Math" alttext="\displaystyle=\cos^{2}(\theta)\mathbb{E}[P_{11}^{2}]+\sin^{2}(\theta)\mathbb{E}[P_{12}^{2}]+2\cos(\theta)\sin(\theta)\mathbb{E}[P_{11}P_{12}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cos^{2}(\theta)\mathbb{E}[P_{11}^{2}]+\sin^{2}(\theta)\mathbb{E}[P_{12}^{2}]+2\cos(\theta)\sin(\theta)\mathbb{E}[P_{11}P_{12}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p3" class="ltx_para">
<p id="A5.p3.1" class="ltx_p"><span id="A5.p3.1.1" class="ltx_text ltx_font_bold">Calculation of Moments.<span id="A5.p3.1.1.1" class="ltx_text ltx_font_medium"> We need to compute <math id="A5.p3.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{2}]</annotation></semantics></math>, <math id="A5.p3.m2" class="ltx_Math" alttext="\mathbb{E}[P_{12}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{12}^{2}]</annotation></semantics></math>, and <math id="A5.p3.m3" class="ltx_Math" alttext="\mathbb{E}[P_{11}P_{12}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}P_{12}]</annotation></semantics></math>.</span></span></p>
</div>
<div id="A5.p4" class="ltx_para">
<p id="A5.p4.1" class="ltx_p"><span id="A5.p4.1.1" class="ltx_text">Consider a reflection matrix <math id="A5.p4.m1" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> that maps <math id="A5.p4.m2" class="ltx_Math" alttext="{\bm{e}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝒆</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\bm{e}}_{2}</annotation></semantics></math> to <math id="A5.p4.m3" class="ltx_Math" alttext="-{\bm{e}}_{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>𝒆</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">-{\bm{e}}_{2}</annotation></semantics></math> and leaves other basis vectors unchanged (i.e., <math id="A5.p4.m4" class="ltx_Math" alttext="{\bm{R}}=\text{diag}(1,-1,1,\dots,1)" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}=\text{diag}(1,-1,1,\dots,1)</annotation></semantics></math>). Since the distribution of <math id="A5.p4.m5" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> is isotropic, it is invariant under reflection. Let <math id="A5.p4.m6" class="ltx_Math" alttext="{\bm{P}}^{*}={\bm{R}}{\bm{P}}{\bm{R}}^{\top}={\bm{R}}{\bm{P}}{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑷</mi><mo>∗</mo></msup><mo>=</mo><mrow><mi>𝑹</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑹</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><mi>𝑹</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{P}}^{*}={\bm{R}}{\bm{P}}{\bm{R}}^{\top}={\bm{R}}{\bm{P}}{\bm{R}}</annotation></semantics></math>. <math id="A5.p4.m7" class="ltx_Math" alttext="{\bm{P}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>𝑷</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\bm{P}}^{*}</annotation></semantics></math> has the same distribution as <math id="A5.p4.m8" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math>.
The components are related:</span></p>
<table id="A5.Ex514" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex514.m1" class="ltx_Math" alttext="P^{*}_{11}=(RPR)_{11}=R_{11}P_{11}R_{11}=P_{11}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>11</mn><mo>∗</mo></msubsup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>11</mn></msub><mo>=</mo><mrow><msub><mi>R</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>11</mn></msub></mrow><mo>=</mo><msub><mi>P</mi><mn>11</mn></msub></mrow><annotation encoding="application/x-tex">P^{*}_{11}=(RPR)_{11}=R_{11}P_{11}R_{11}=P_{11}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.2" class="ltx_p"><span id="A5.p4.2.1" class="ltx_text">and</span></p>
<table id="A5.Ex515" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex515.m1" class="ltx_Math" alttext="P^{*}_{12}=(RPR)_{12}=R_{11}P_{12}R_{22}=(1)P_{12}(-1)=-P_{12}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mn>12</mn><mo>∗</mo></msubsup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mn>12</mn></msub><mo>=</mo><mrow><msub><mi>R</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mn>22</mn></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><msub><mi>P</mi><mn>12</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P^{*}_{12}=(RPR)_{12}=R_{11}P_{12}R_{22}=(1)P_{12}(-1)=-P_{12}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.3" class="ltx_p"><span id="A5.p4.3.1" class="ltx_text">Therefore,</span></p>
<table id="A5.Ex516" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex516.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}P_{12}]=\mathbb{E}[P^{*}_{11}P^{*}_{12}]=\mathbb{E}[P_{11}(-P_{12})]=-\mathbb{E}[P_{11}P_{12}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>P</mi><mn>11</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}P_{12}]=\mathbb{E}[P^{*}_{11}P^{*}_{12}]=\mathbb{E}[P_{11}(-P_{12})]=-\mathbb{E}[P_{11}P_{12}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.4" class="ltx_p"><span id="A5.p4.4.1" class="ltx_text">This implies <math id="A5.p4.m9" class="ltx_Math" alttext="2\mathbb{E}[P_{11}P_{12}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2\mathbb{E}[P_{11}P_{12}]=0</annotation></semantics></math>, so <math id="A5.p4.m10" class="ltx_Math" alttext="\mathbb{E}[P_{11}P_{12}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}P_{12}]=0</annotation></semantics></math>.</span></p>
</div>
<div id="A5.p5" class="ltx_para">
<p id="A5.p5.1" class="ltx_p"><span id="A5.p5.1.1" class="ltx_text">The diagonal element <math id="A5.p5.m1" class="ltx_Math" alttext="P_{11}={\bm{e}}_{1}^{\top}{\bm{P}}{\bm{e}}_{1}=\|{\bm{P}}{\bm{e}}_{1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>11</mn></msub><mo>=</mo><mrow><msubsup><mi>𝒆</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒆</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">P_{11}={\bm{e}}_{1}^{\top}{\bm{P}}{\bm{e}}_{1}=\|{\bm{P}}{\bm{e}}_{1}\|_{2}^{2}</annotation></semantics></math> represents the squared norm of the projection of the fixed unit vector <math id="A5.p5.m2" class="ltx_Math" alttext="{\bm{e}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝒆</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{e}}_{1}</annotation></semantics></math> onto the random <math id="A5.p5.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional subspace <math id="A5.p5.m4" class="ltx_Math" alttext="C({\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\bm{A}})</annotation></semantics></math>. This variable follows a Beta distribution:</span></p>
<table id="A5.Ex517" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex517.m1" class="ltx_Math" alttext="P_{11}\sim\text{Beta}\left(\frac{n}{2},\frac{d-n}{2}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>11</mn></msub><mo>∼</mo><mrow><mtext>Beta</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo>,</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{11}\sim\text{Beta}\left(\frac{n}{2},\frac{d-n}{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.2" class="ltx_p"><span id="A5.p5.2.1" class="ltx_text">The mean and variance of a <math id="A5.p5.m5" class="ltx_Math" alttext="\text{Beta}(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mtext>Beta</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Beta}(\alpha,\beta)</annotation></semantics></math> distribution are <math id="A5.p5.m6" class="ltx_Math" alttext="\frac{\alpha}{\alpha+\beta}" display="inline" intent=":literal"><semantics><mfrac><mi>α</mi><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow></mfrac><annotation encoding="application/x-tex">\frac{\alpha}{\alpha+\beta}</annotation></semantics></math> and <math id="A5.p5.m7" class="ltx_Math" alttext="\frac{\alpha\beta}{(\alpha+\beta)^{2}(\alpha+\beta+1)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>+</mo><mi>β</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\alpha\beta}{(\alpha+\beta)^{2}(\alpha+\beta+1)}</annotation></semantics></math>, respectively.
Here, <math id="A5.p5.m8" class="ltx_Math" alttext="\alpha=n/2" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=n/2</annotation></semantics></math> and <math id="A5.p5.m9" class="ltx_Math" alttext="\beta=(d-n)/2" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\beta=(d-n)/2</annotation></semantics></math>, so <math id="A5.p5.m10" class="ltx_Math" alttext="\alpha+\beta=d/2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow><mo>=</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha+\beta=d/2</annotation></semantics></math>.</span></p>
<table id="A5.Ex518" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex518.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}]=\frac{n/2}{d/2}=\frac{n}{d}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>P</mi><mn>11</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mi>n</mi><mi>d</mi></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}]=\frac{n/2}{d/2}=\frac{n}{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.3" class="ltx_p"><span id="A5.p5.3.1" class="ltx_text">Next</span></p>
<table id="A5.Ex519" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex519.m1" class="ltx_Math" alttext="\mathrm{Var}(P_{11})=\frac{(n/2)((d-n)/2)}{(d/2)^{2}(d/2+1)}=\frac{n(d-n)/4}{(d^{2}/4)((d+2)/2)}=\frac{n(d-n)\cdot 8}{4d^{2}(d+2)}=\frac{2n(d-n)}{d^{2}(d+2)}" display="block" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>11</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>4</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>/</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mn>8</mn></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathrm{Var}(P_{11})=\frac{(n/2)((d-n)/2)}{(d/2)^{2}(d/2+1)}=\frac{n(d-n)/4}{(d^{2}/4)((d+2)/2)}=\frac{n(d-n)\cdot 8}{4d^{2}(d+2)}=\frac{2n(d-n)}{d^{2}(d+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.4" class="ltx_p"><span id="A5.p5.4.1" class="ltx_text">Now we find <math id="A5.p5.m11" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{2}]</annotation></semantics></math> using <math id="A5.p5.m12" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{2}]=\mathrm{Var}(P_{11})+(\mathbb{E}[P_{11}])^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>11</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>P</mi><mn>11</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{2}]=\mathrm{Var}(P_{11})+(\mathbb{E}[P_{11}])^{2}</annotation></semantics></math>:</span></p>
<table id="A5.EGx131" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex520"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex520.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[P_{11}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[P_{11}^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex520.m2" class="ltx_Math" alttext="\displaystyle=\frac{2n(d-n)}{d^{2}(d+2)}+\left(\frac{n}{d}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>n</mi><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2n(d-n)}{d^{2}(d+2)}+\left(\frac{n}{d}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex521"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex521.m1" class="ltx_Math" alttext="\displaystyle=\frac{2n(d-n)+n^{2}(d+2)}{d^{2}(d+2)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2n(d-n)+n^{2}(d+2)}{d^{2}(d+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex522"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex522.m1" class="ltx_Math" alttext="\displaystyle=\frac{2nd-2n^{2}+n^{2}d+2n^{2}}{d^{2}(d+2)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2nd-2n^{2}+n^{2}d+2n^{2}}{d^{2}(d+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex523"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex523.m1" class="ltx_Math" alttext="\displaystyle=\frac{2nd+n^{2}d}{d^{2}(d+2)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2nd+n^{2}d}{d^{2}(d+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex524"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex524.m1" class="ltx_Math" alttext="\displaystyle=\frac{n(n+2)}{d(d+2)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n(n+2)}{d(d+2)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p6" class="ltx_para">
<p id="A5.p6.1" class="ltx_p"><span id="A5.p6.1.1" class="ltx_text">We use the property that <math id="A5.p6.m1" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> is a projection matrix, so <math id="A5.p6.m2" class="ltx_Math" alttext="{\bm{P}}^{2}={\bm{P}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑷</mi><mn>2</mn></msup><mo>=</mo><mi>𝑷</mi></mrow><annotation encoding="application/x-tex">{\bm{P}}^{2}={\bm{P}}</annotation></semantics></math>. The trace is <math id="A5.p6.m3" class="ltx_Math" alttext="\Tr({\bm{P}})=n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\Tr({\bm{P}})=n</annotation></semantics></math>. Also <math id="A5.p6.m4" class="ltx_Math" alttext="\Tr({\bm{P}}^{2})=\Tr({\bm{P}})=n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝑷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\Tr({\bm{P}}^{2})=\Tr({\bm{P}})=n</annotation></semantics></math>.
We can write <math id="A5.p6.m5" class="ltx_Math" alttext="\Tr({\bm{P}}^{2})=\Tr({\bm{P}}{\bm{P}}^{\top})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑷</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{P}}^{2})=\Tr({\bm{P}}{\bm{P}}^{\top})</annotation></semantics></math> since <math id="A5.p6.m6" class="ltx_Math" alttext="{\bm{P}}" display="inline" intent=":literal"><semantics><mi>𝑷</mi><annotation encoding="application/x-tex">{\bm{P}}</annotation></semantics></math> is symmetric.</span></p>
<table id="A5.Ex525" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex525.m1" class="ltx_Math" alttext="\Tr({\bm{P}}^{2})=\sum_{i=1}^{d}\sum_{j=1}^{d}(P_{ij})^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\Tr({\bm{P}}^{2})=\sum_{i=1}^{d}\sum_{j=1}^{d}(P_{ij})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p6.2" class="ltx_p"><span id="A5.p6.2.1" class="ltx_text">Taking the expectation:</span></p>
<table id="A5.Ex526" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex526.m1" class="ltx_Math" alttext="\mathbb{E}[\Tr({\bm{P}}^{2})]=\mathbb{E}\left[\sum_{i,j}P_{ij}^{2}\right]=\sum_{i,j}\mathbb{E}[P_{ij}^{2}]=n" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝑷</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}[\Tr({\bm{P}}^{2})]=\mathbb{E}\left[\sum_{i,j}P_{ij}^{2}\right]=\sum_{i,j}\mathbb{E}[P_{ij}^{2}]=n</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p6.3" class="ltx_p"><span id="A5.p6.3.1" class="ltx_text">By rotational symmetry, <math id="A5.p6.m7" class="ltx_Math" alttext="\mathbb{E}[P_{ii}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{ii}^{2}]</annotation></semantics></math> is the same for all <math id="A5.p6.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and <math id="A5.p6.m9" class="ltx_Math" alttext="\mathbb{E}[P_{ij}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{ij}^{2}]</annotation></semantics></math> is the same for all <math id="A5.p6.m10" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>.</span></p>
<table id="A5.Ex527" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex527.m1" class="ltx_Math" alttext="\sum_{i=1}^{d}\mathbb{E}[P_{ii}^{2}]+\sum_{i\neq j}\mathbb{E}[P_{ij}^{2}]=n." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>=</mo><mi>n</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{d}\mathbb{E}[P_{ii}^{2}]+\sum_{i\neq j}\mathbb{E}[P_{ij}^{2}]=n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p6.4" class="ltx_p"><span id="A5.p6.4.1" class="ltx_text">There are <math id="A5.p6.m11" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> diagonal terms and <math id="A5.p6.m12" class="ltx_Math" alttext="d(d-1)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(d-1)</annotation></semantics></math> off-diagonal terms.</span></p>
<table id="A5.Ex528" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex528.m1" class="ltx_Math" alttext="d\,\mathbb{E}[P_{11}^{2}]+d(d-1)\,\mathbb{E}[P_{12}^{2}]=n" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d\,\mathbb{E}[P_{11}^{2}]+d(d-1)\,\mathbb{E}[P_{12}^{2}]=n</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p6.5" class="ltx_p"><span id="A5.p6.5.1" class="ltx_text">Substitute the value for <math id="A5.p6.m13" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{2}]</annotation></semantics></math> (assuming <math id="A5.p6.m14" class="ltx_Math" alttext="d&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d&gt;1</annotation></semantics></math>):</span></p>
<table id="A5.Ex529" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex529.m1" class="ltx_Math" alttext="d\left(\frac{n(n+2)}{d(d+2)}\right)+d(d-1)\,\mathbb{E}[P_{12}^{2}]=n" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d\left(\frac{n(n+2)}{d(d+2)}\right)+d(d-1)\,\mathbb{E}[P_{12}^{2}]=n</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex530" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex530.m1" class="ltx_Math" alttext="\frac{n(n+2)}{d+2}+d(d-1)\,\mathbb{E}[P_{12}^{2}]=n" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow></mfrac><mo>+</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\frac{n(n+2)}{d+2}+d(d-1)\,\mathbb{E}[P_{12}^{2}]=n</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex531" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex531.m1" class="ltx_Math" alttext="d(d-1)\,\mathbb{E}[P_{12}^{2}]=n-\frac{n(n+2)}{d+2}=\frac{n(d+2)-n(n+2)}{d+2}=\frac{nd+2n-n^{2}-2n}{d+2}=\frac{n(d-n)}{d+2}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>n</mi><mo>−</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mrow><mo>=</mo><mfrac><mrow><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo>−</mo><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">d(d-1)\,\mathbb{E}[P_{12}^{2}]=n-\frac{n(n+2)}{d+2}=\frac{n(d+2)-n(n+2)}{d+2}=\frac{nd+2n-n^{2}-2n}{d+2}=\frac{n(d-n)}{d+2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex532" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex532.m1" class="ltx_Math" alttext="\mathbb{E}[P_{12}^{2}]=\frac{n(d-n)}{d(d-1)(d+2)}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{12}^{2}]=\frac{n(d-n)}{d(d-1)(d+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p7" class="ltx_para">
<p id="A5.p7.1" class="ltx_p"><span id="A5.p7.1.1" class="ltx_text">Substitute the moments back into the expression for <math id="A5.p7.m1" class="ltx_Math" alttext="\mathbb{E}[X^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{2}]</annotation></semantics></math>:</span></p>
<table id="A5.Ex533" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex533.m1" class="ltx_Math" alttext="\mathbb{E}[X^{2}]=\cos^{2}(\theta)\mathbb{E}[P_{11}^{2}]+\sin^{2}(\theta)\mathbb{E}[P_{12}^{2}]+2\cos(\theta)\sin(\theta)\cdot 0" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mn>0</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{2}]=\cos^{2}(\theta)\mathbb{E}[P_{11}^{2}]+\sin^{2}(\theta)\mathbb{E}[P_{12}^{2}]+2\cos(\theta)\sin(\theta)\cdot 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p7.2" class="ltx_p"><span id="A5.p7.2.1" class="ltx_text">Using <math id="A5.p7.m2" class="ltx_Math" alttext="\cos(\theta)={\bm{u}}^{\top}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">\cos(\theta)={\bm{u}}^{\top}{\bm{v}}</annotation></semantics></math>, <math id="A5.p7.m3" class="ltx_Math" alttext="\cos^{2}(\theta)=({\bm{u}}^{\top}{\bm{v}})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\cos^{2}(\theta)=({\bm{u}}^{\top}{\bm{v}})^{2}</annotation></semantics></math>, and <math id="A5.p7.m4" class="ltx_Math" alttext="\sin^{2}(\theta)=1-\cos^{2}(\theta)=1-({\bm{u}}^{\top}{\bm{v}})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\sin^{2}(\theta)=1-\cos^{2}(\theta)=1-({\bm{u}}^{\top}{\bm{v}})^{2}</annotation></semantics></math>:</span></p>
<table id="A5.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex534"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex534.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[(u^{\top}AA^{\dagger}v)^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[(u^{\top}AA^{\dagger}v)^{2}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex534.m2" class="ltx_Math" alttext="\displaystyle=({\bm{u}}^{\top}{\bm{v}})^{2}\left(\frac{n(n+2)}{d(d+2)}\right)+(1-({\bm{u}}^{\top}{\bm{v}})^{2})\left(\frac{n(d-n)}{d(d-1)(d+2)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{u}}^{\top}{\bm{v}})^{2}\left(\frac{n(n+2)}{d(d+2)}\right)+(1-({\bm{u}}^{\top}{\bm{v}})^{2})\left(\frac{n(d-n)}{d(d-1)(d+2)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex535"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex535.m1" class="ltx_Math" alttext="\displaystyle=\frac{n}{d(d+2)}\left[({\bm{u}}^{\top}{\bm{v}})^{2}(n+2)+\frac{(1-({\bm{u}}^{\top}{\bm{v}})^{2})(d-n)}{d-1}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{n}{d(d+2)}\left[({\bm{u}}^{\top}{\bm{v}})^{2}(n+2)+\frac{(1-({\bm{u}}^{\top}{\bm{v}})^{2})(d-n)}{d-1}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex536"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex536.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{c^{2}}({\bm{u}}^{\top}{\bm{v}})^{2}+O\left(\frac{1}{d}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>c</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{c^{2}}({\bm{u}}^{\top}{\bm{v}})^{2}+O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p8" class="ltx_para">
<p id="A5.p8.1" class="ltx_p"><span id="A5.p8.1.1" class="ltx_text ltx_font_bold">Calculation of Variance. <span id="A5.p8.1.1.1" class="ltx_text ltx_font_medium"> Recall that reflection <math id="A5.p8.m1" class="ltx_Math" alttext="{\bm{R}}=\mathrm{diag}(1,-1,1,\dots,1)" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}=\mathrm{diag}(1,-1,1,\dots,1)</annotation></semantics></math> implies <math id="A5.p8.m2" class="ltx_Math" alttext="{\bm{P}}\stackrel{{\scriptstyle d}}{{=}}{\bm{R}}{\bm{P}}{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑷</mi><mover><mo>=</mo><mi>d</mi></mover><mrow><mi>𝑹</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑷</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑹</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{P}}\stackrel{{\scriptstyle d}}{{=}}{\bm{R}}{\bm{P}}{\bm{R}}</annotation></semantics></math> (equal in distribution) and thus <math id="A5.p8.m3" class="ltx_Math" alttext="\mathbb{E}[P_{11}P_{12}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mn>12</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}P_{12}]=0</annotation></semantics></math>, and in general any mixed moment with an odd power of <math id="A5.p8.m4" class="ltx_Math" alttext="P_{12}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>12</mn></msub><annotation encoding="application/x-tex">P_{12}</annotation></semantics></math> vanishes.
Therefore, we have the following expansion:</span></span></p>
<table id="A5.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E31.m1" class="ltx_Math" alttext="\mathbb{E}[X^{4}]=\cos^{4}\theta\,\mathbb{E}[P_{11}^{4}]+6\cos^{2}\theta\sin^{2}\theta\,\mathbb{E}[P_{11}^{2}P_{12}^{2}]+\sin^{4}\theta\,\mathbb{E}[P_{12}^{4}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>cos</mi><mn>4</mn></msup><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>sin</mi><mn>4</mn></msup><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{4}]=\cos^{4}\theta\,\mathbb{E}[P_{11}^{4}]+6\cos^{2}\theta\sin^{2}\theta\,\mathbb{E}[P_{11}^{2}P_{12}^{2}]+\sin^{4}\theta\,\mathbb{E}[P_{12}^{4}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
</div>
<div id="A5.p9" class="ltx_para">
<p id="A5.p9.1" class="ltx_p"><span id="A5.p9.1.1" class="ltx_text">We start with <math id="A5.p9.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{4}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{4}]</annotation></semantics></math>. Since <math id="A5.p9.m2" class="ltx_Math" alttext="P_{11}\sim\mathrm{Beta}(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>11</mn></msub><mo>∼</mo><mrow><mi>Beta</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{11}\sim\mathrm{Beta}(\alpha,\beta)</annotation></semantics></math> with <math id="A5.p9.m3" class="ltx_Math" alttext="\alpha=\frac{n}{2}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mfrac><mi>n</mi><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\alpha=\frac{n}{2}</annotation></semantics></math>, <math id="A5.p9.m4" class="ltx_Math" alttext="\beta=\frac{d-n}{2}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\beta=\frac{d-n}{2}</annotation></semantics></math>. We need the higher moments for the Beta distribution: for <math id="A5.p9.m5" class="ltx_Math" alttext="m\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m\geq 1</annotation></semantics></math>,</span></p>
<table id="A5.Ex537" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex537.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[P_{11}^{m}]=\frac{\alpha^{(m)}}{(\alpha+\beta)^{(m)}}=\frac{(\frac{n}{2})^{(m)}}{(\frac{d}{2})^{(m)}},\qquad x^{(m)}:=x(x+1)\cdots(x+m-1)." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mi>m</mi></msubsup><mo stretchy="false">]</mo></mrow><mo>=</mo><mfrac><msup><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mfrac><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup></mfrac><mo rspace="2.167em">,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>m</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{m}]=\frac{\alpha^{(m)}}{(\alpha+\beta)^{(m)}}=\frac{(\frac{n}{2})^{(m)}}{(\frac{d}{2})^{(m)}},\qquad x^{(m)}:=x(x+1)\cdots(x+m-1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p9.2" class="ltx_p"><span id="A5.p9.2.1" class="ltx_text">In particular, we have the following third and fourth moments:</span></p>
<table id="A5.Ex538" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex538.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{3}]=\frac{(\frac{n}{2})^{(3)}}{(\frac{d}{2})^{(3)}}=\frac{1}{c^{3}}+O\left(\frac{1}{d}\right),\quad\mathbb{E}[P_{11}^{4}]=\frac{(\frac{n}{2})^{(4)}}{(\frac{d}{2})^{(4)}}=\frac{1}{c^{4}}+O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>3</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>3</mn></msup></mfrac><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{3}]=\frac{(\frac{n}{2})^{(3)}}{(\frac{d}{2})^{(3)}}=\frac{1}{c^{3}}+O\left(\frac{1}{d}\right),\quad\mathbb{E}[P_{11}^{4}]=\frac{(\frac{n}{2})^{(4)}}{(\frac{d}{2})^{(4)}}=\frac{1}{c^{4}}+O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p9.3" class="ltx_p"><span id="A5.p9.3.1" class="ltx_text">We now move on to <math id="A5.p9.m6" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{2}P_{12}^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{2}P_{12}^{2}]</annotation></semantics></math>.From idempotency, <math id="A5.p9.m7" class="ltx_Math" alttext="(P^{2})_{11}=P_{11}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mn>11</mn></msub><mo>=</mo><msub><mi>P</mi><mn>11</mn></msub></mrow><annotation encoding="application/x-tex">(P^{2})_{11}=P_{11}</annotation></semantics></math> gives the row identity <math id="A5.p9.m8" class="ltx_Math" alttext="P_{11}=\sum_{k=1}^{d}P_{1k}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>11</mn></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msubsup><mi>P</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">P_{11}=\sum_{k=1}^{d}P_{1k}^{2}</annotation></semantics></math>. Multiplying by <math id="A5.p9.m9" class="ltx_Math" alttext="P_{11}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">P_{11}^{2}</annotation></semantics></math> and taking expectations, we have that</span></p>
<table id="A5.Ex539" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex539.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{3}]=\mathbb{E}[P_{11}^{4}]+\sum_{k=2}^{d}\mathbb{E}[P_{11}^{2}P_{1k}^{2}]=\mathbb{E}[P_{11}^{4}]+(d-1)\,\mathbb{E}[P_{11}^{2}P_{12}^{2}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>3</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>d</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{3}]=\mathbb{E}[P_{11}^{4}]+\sum_{k=2}^{d}\mathbb{E}[P_{11}^{2}P_{1k}^{2}]=\mathbb{E}[P_{11}^{4}]+(d-1)\,\mathbb{E}[P_{11}^{2}P_{12}^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex540" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex540.m1" class="ltx_Math" alttext="\mathbb{E}[P_{11}^{2}P_{12}^{2}]=\frac{\mathbb{E}[P_{11}^{3}]-\mathbb{E}[P_{11}^{4}]}{d-1}=\frac{1}{d-1}\left(\frac{(\frac{n}{2})^{(3)}}{(\frac{d}{2})^{(3)}}-\frac{(\frac{n}{2})^{(4)}}{(\frac{d}{2})^{(4)}}\right)=\frac{1}{d-1}\!\left(\frac{1}{c^{3}}-\frac{1}{c^{4}}+O\left(\frac{1}{d}\right)\right)=O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>P</mi><mn>12</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>3</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></msup></mfrac><mo>−</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>3</mn></msup></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mi>c</mi><mn>4</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{11}^{2}P_{12}^{2}]=\frac{\mathbb{E}[P_{11}^{3}]-\mathbb{E}[P_{11}^{4}]}{d-1}=\frac{1}{d-1}\left(\frac{(\frac{n}{2})^{(3)}}{(\frac{d}{2})^{(3)}}-\frac{(\frac{n}{2})^{(4)}}{(\frac{d}{2})^{(4)}}\right)=\frac{1}{d-1}\!\left(\frac{1}{c^{3}}-\frac{1}{c^{4}}+O\left(\frac{1}{d}\right)\right)=O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p10" class="ltx_para">
<p id="A5.p10.1" class="ltx_p"><span id="A5.p10.1.1" class="ltx_text">We still need to evaluate or upper bound <math id="A5.p10.m1" class="ltx_Math" alttext="\mathbb{E}[P_{12}^{4}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{12}^{4}]</annotation></semantics></math>. From <math id="A5.p10.m2" class="ltx_Math" alttext="P_{11}=\sum_{k=1}^{d}P_{1k}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>11</mn></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><msubsup><mi>P</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">P_{11}=\sum_{k=1}^{d}P_{1k}^{2}</annotation></semantics></math> we have <math id="A5.p10.m3" class="ltx_Math" alttext="\sum_{k=2}^{d}P_{1k}^{2}=P_{11}-P_{11}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>d</mi></msubsup><msubsup><mi>P</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo>−</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=2}^{d}P_{1k}^{2}=P_{11}-P_{11}^{2}</annotation></semantics></math>. By Cauchy–Schwarz,</span></p>
<table id="A5.Ex541" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex541.m1" class="ltx_Math" alttext="\sum_{k=2}^{d}P_{1k}^{4}=\left(\sum_{k=2}^{d}P_{1k}^{2}\right)^{2}=(P_{11}-P_{11}^{2})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>d</mi></munderover><msubsup><mi>P</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>4</mn></msubsup></mrow><mo>=</mo><msup><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>d</mi></munderover><msubsup><mi>P</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></msubsup></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo>−</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=2}^{d}P_{1k}^{4}=\left(\sum_{k=2}^{d}P_{1k}^{2}\right)^{2}=(P_{11}-P_{11}^{2})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p10.2" class="ltx_p"><span id="A5.p10.2.1" class="ltx_text">Taking expectations, we get:</span></p>
<table id="A5.Ex542" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex542.m1" class="ltx_Math" alttext="(d-1)\mathbb{E}[P_{12}^{4}]\leq\mathbb{E}[(P_{11}-P_{11}^{2})^{2}]=\mathbb{E}[P_{11}^{2}]-2\mathbb{E}[P_{11}^{3}]+\mathbb{E}[P_{11}^{4}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mn>11</mn></msub><mo>−</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>3</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>11</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(d-1)\mathbb{E}[P_{12}^{4}]\leq\mathbb{E}[(P_{11}-P_{11}^{2})^{2}]=\mathbb{E}[P_{11}^{2}]-2\mathbb{E}[P_{11}^{3}]+\mathbb{E}[P_{11}^{4}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A5.Ex543" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex543.m1" class="ltx_Math" alttext="\mathbb{E}[P_{12}^{4}]\leq\frac{1}{d-1}\!\left(\frac{1}{c^{2}}-\frac{2}{c^{3}}+\frac{1}{c^{4}}\right)+O\left(\frac{1}{d^{2}}\right)=O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>P</mi><mn>12</mn><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo>−</mo><mfrac><mn>2</mn><msup><mi>c</mi><mn>3</mn></msup></mfrac></mrow><mo>+</mo><mfrac><mn>1</mn><msup><mi>c</mi><mn>4</mn></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>d</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[P_{12}^{4}]\leq\frac{1}{d-1}\!\left(\frac{1}{c^{2}}-\frac{2}{c^{3}}+\frac{1}{c^{4}}\right)+O\left(\frac{1}{d^{2}}\right)=O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p10.3" class="ltx_p"><span id="A5.p10.3.1" class="ltx_text">We can now plug these expectation bounds into Equation <a href="#A5.E31" title="Equation 31 ‣ Proof. ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref ltx_markedasmath ltx_font_italic"><span class="ltx_text ltx_ref_tag">31</span></a>:</span></p>
<table id="A5.EGx133" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex544"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex544.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[X^{4}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[X^{4}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex544.m2" class="ltx_Math" alttext="\displaystyle=\cos^{4}\theta\frac{(\frac{n}{2})^{(4)}}{(\frac{d}{2})^{(4)}}+O\left(\frac{1}{d}\right)6\cos^{2}\theta\sin^{2}\theta\ +O\left(\frac{1}{d}\right)\sin^{4}\theta" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>cos</mi><mn>4</mn></msup><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>n</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>d</mi><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msup></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mn>6</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow><mo lspace="0.722em">+</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi>sin</mi><mn>4</mn></msup><mo lspace="0.167em">⁡</mo><mi>θ</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\cos^{4}\theta\frac{(\frac{n}{2})^{(4)}}{(\frac{d}{2})^{(4)}}+O\left(\frac{1}{d}\right)6\cos^{2}\theta\sin^{2}\theta\ +O\left(\frac{1}{d}\right)\sin^{4}\theta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex545"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex545.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{c^{4}}({\bm{u}}^{\top}{\bm{v}})^{4}+O\left(\frac{1}{d}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>c</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{c^{4}}({\bm{u}}^{\top}{\bm{v}})^{4}+O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p11" class="ltx_para">
<p id="A5.p11.1" class="ltx_p"><span id="A5.p11.1.1" class="ltx_text">Recall from the prior proof that:</span></p>
<table id="A5.Ex546" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex546.m1" class="ltx_Math" alttext="\mathbb{E}[X^{2}]=\cos^{2}\theta\,\frac{n(n+2)}{d(d+2)}+\sin^{2}\theta\,\frac{n(d-n)}{d(d-1)(d+2)}=\frac{1}{c^{2}}({\bm{u}}^{\top}{\bm{v}})^{2}+O\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>+</mo><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><mrow><mi>θ</mi><mo lspace="0.170em" rspace="0em">​</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{2}]=\cos^{2}\theta\,\frac{n(n+2)}{d(d+2)}+\sin^{2}\theta\,\frac{n(d-n)}{d(d-1)(d+2)}=\frac{1}{c^{2}}({\bm{u}}^{\top}{\bm{v}})^{2}+O\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p11.2" class="ltx_p"><span id="A5.p11.2.1" class="ltx_text">Finally, we have that the variance is of order:</span></p>
<table id="A5.Ex547" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex547.m1" class="ltx_Math" alttext="\mathrm{Var}(X^{2})=\mathbb{E}[X^{4}]-\big(\mathbb{E}[X^{2}]\big)^{2}=O\!\left(\frac{1}{d}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(X^{2})=\mathbb{E}[X^{4}]-\big(\mathbb{E}[X^{2}]\big)^{2}=O\!\left(\frac{1}{d}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p11.3" class="ltx_p"><span id="A5.p11.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma32" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma32.2" class="ltx_text ltx_font_bold">Lemma 32</span></span><span id="Thmlemma32.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma32.p1" class="ltx_para">
<p id="Thmlemma32.p1.1" class="ltx_p"><span id="Thmlemma32.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma32.p1.m1" class="ltx_Math" alttext="a\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\neq 0</annotation></semantics></math> be a constant and suppose that <math id="Thmlemma32.p1.m2" class="ltx_Math" alttext="\zeta=a+o(f(n))" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta=a+o(f(n))</annotation></semantics></math> as <math id="Thmlemma32.p1.m3" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. Then,</span></p>
<table id="A5.Ex548" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex548.m1" class="ltx_Math" alttext="\frac{1}{\zeta}=\frac{1}{a}+o(f(n))." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>ζ</mi></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\zeta}=\frac{1}{a}+o(f(n)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p12" class="ltx_para">
<p id="A5.p12.1" class="ltx_p"><span id="A5.p12.1.1" class="ltx_text">Write <math id="A5.p12.m1" class="ltx_Math" alttext="\zeta=a+r_{n}" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>=</mo><mrow><mi>a</mi><mo>+</mo><msub><mi>r</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\zeta=a+r_{n}</annotation></semantics></math> with <math id="A5.p12.m2" class="ltx_Math" alttext="r_{n}=o(f(n))" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{n}=o(f(n))</annotation></semantics></math>. Then</span></p>
<table id="A5.Ex549" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex549.m1" class="ltx_Math" alttext="\frac{1}{\zeta}=\frac{1}{a+r_{n}}=\frac{1}{a}\cdot\frac{1}{1+\frac{r_{n}}{a}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>ζ</mi></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mi>a</mi><mo>+</mo><msub><mi>r</mi><mi>n</mi></msub></mrow></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><mi>a</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mfrac><msub><mi>r</mi><mi>n</mi></msub><mi>a</mi></mfrac></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\zeta}=\frac{1}{a+r_{n}}=\frac{1}{a}\cdot\frac{1}{1+\frac{r_{n}}{a}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p12.2" class="ltx_p"><span id="A5.p12.2.1" class="ltx_text">Using the expansion</span></p>
<table id="A5.Ex550" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex550.m1" class="ltx_Math" alttext="\frac{1}{1+u}=1-u+O(u^{2})\quad\text{as }u\to 0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>u</mi></mrow></mfrac><mo>=</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>as </mtext><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{1+u}=1-u+O(u^{2})\quad\text{as }u\to 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p12.3" class="ltx_p"><span id="A5.p12.3.1" class="ltx_text">with <math id="A5.p12.m3" class="ltx_Math" alttext="u=r_{n}/a" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>/</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">u=r_{n}/a</annotation></semantics></math>, we obtain</span></p>
<table id="A5.Ex551" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex551.m1" class="ltx_Math" alttext="\frac{1}{\zeta}=\frac{1}{a}\Big(1-\frac{r_{n}}{a}+O\!\big((r_{n}/a)^{2}\big)\Big)=\frac{1}{a}-\frac{r_{n}}{a^{2}}+O(r_{n}^{2})." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>ζ</mi></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><mi>a</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mfrac><msub><mi>r</mi><mi>n</mi></msub><mi>a</mi></mfrac></mrow><mo>+</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>/</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>−</mo><mfrac><msub><mi>r</mi><mi>n</mi></msub><msup><mi>a</mi><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>n</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\zeta}=\frac{1}{a}\Big(1-\frac{r_{n}}{a}+O\!\big((r_{n}/a)^{2}\big)\Big)=\frac{1}{a}-\frac{r_{n}}{a^{2}}+O(r_{n}^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p12.4" class="ltx_p"><span id="A5.p12.4.1" class="ltx_text">Since <math id="A5.p12.m4" class="ltx_Math" alttext="r_{n}=o(f(n))" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{n}=o(f(n))</annotation></semantics></math> and <math id="A5.p12.m5" class="ltx_Math" alttext="f(n)\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(n)\to 0</annotation></semantics></math>, we have <math id="A5.p12.m6" class="ltx_Math" alttext="r_{n}^{2}=o(f(n))" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>n</mi><mn>2</mn></msubsup><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{n}^{2}=o(f(n))</annotation></semantics></math>. Therefore</span></p>
<table id="A5.Ex552" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex552.m1" class="ltx_Math" alttext="\frac{1}{\zeta}=\frac{1}{a}+o\!\big(f(n)\big)," display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>ζ</mi></mfrac><mo>=</mo><mrow><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{\zeta}=\frac{1}{a}+o\!\big(f(n)\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p12.5" class="ltx_p"><span id="A5.p12.5.1" class="ltx_text">which is the desired expansion.
∎</span></p>
</div>
</div>
<div id="Thmlemma33" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma33.2" class="ltx_text ltx_font_bold">Lemma 33</span></span><span id="Thmlemma33.3" class="ltx_text ltx_font_bold"> </span>(Variance of a reciprocal)<span id="Thmlemma33.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma33.p1" class="ltx_para">
<p id="Thmlemma33.p1.1" class="ltx_p"><span id="Thmlemma33.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma33.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a random variable satisfying</span></p>
<table id="A5.Ex553" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex553.m1" class="ltx_Math" alttext="E[X]=a&gt;0\quad\text{and}\quad\mathrm{Var}(X)=\sigma^{2}=o(1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">E[X]=a&gt;0\quad\text{and}\quad\mathrm{Var}(X)=\sigma^{2}=o(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma33.p1.2" class="ltx_p"><span id="Thmlemma33.p1.2.1" class="ltx_text ltx_font_italic">and assume that <math id="Thmlemma33.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is bounded away from zero with high probability. That is, there exists <math id="Thmlemma33.p1.m3" class="ltx_Math" alttext="C\in(0,a)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C\in(0,a)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex554" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex554.m1" class="ltx_math_unparsed" alttext="\Pr[X\geq C]=1-o(1)" display="block" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo stretchy="false">[</mo><mi>X</mi><mo>≥</mo><mi>C</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>1</mn><mo>−</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Pr[X\geq C]=1-o(1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma33.p1.3" class="ltx_p"><span id="Thmlemma33.p1.3.1" class="ltx_text ltx_font_italic">If there exists an <math id="Thmlemma33.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> such that</span></p>
<table id="A5.Ex555" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex555.m1" class="ltx_Math" alttext="\mathbb{E}\left[X^{-8}\right]\leq M\quad\text{ and }\quad\mathbb{E}\left[\left(X-\mathbb{E}[X]\right)^{4}\right]=O(\sigma^{4})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>X</mi><mrow><mo>−</mo><mn>8</mn></mrow></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mi>M</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic"> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mi>X</mi><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>σ</mi><mn>4</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[X^{-8}\right]\leq M\quad\text{ and }\quad\mathbb{E}\left[\left(X-\mathbb{E}[X]\right)^{4}\right]=O(\sigma^{4})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma33.p1.4" class="ltx_p"><span id="Thmlemma33.p1.4.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A5.Ex556" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex556.m1" class="ltx_Math" alttext="\mathrm{Var}\left(\frac{1}{X}\right)=\frac{1}{a^{4}}\mathrm{Var}(X)+o\left(\mathrm{Var}(X)\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>X</mi></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\left(\frac{1}{X}\right)=\frac{1}{a^{4}}\mathrm{Var}(X)+o\left(\mathrm{Var}(X)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma33.p1.5" class="ltx_p"><span id="Thmlemma33.p1.5.1" class="ltx_text ltx_font_italic">so in particular, <math id="Thmlemma33.p1.m5" class="ltx_Math" alttext="\mathrm{Var}(1/X)=o(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(1/X)=o(1)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p13" class="ltx_para">
<p id="A5.p13.1" class="ltx_p"><span id="A5.p13.1.1" class="ltx_text">Let <math id="A5.p13.m1" class="ltx_Math" alttext="Y:=X-a" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>:=</mo><mrow><mi>X</mi><mo>−</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">Y:=X-a</annotation></semantics></math>. Then</span></p>
<table id="A5.Ex557" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex557.m1" class="ltx_Math" alttext="\mathbb{E}\left[Y\right]=0,\qquad\mathbb{E}\left[Y^{2}\right]=\sigma^{2},\qquad\mathbb{E}\left[Y^{4}\right]=O\!\left(\sigma^{4}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>Y</mi><mo>]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>4</mn></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Y\right]=0,\qquad\mathbb{E}\left[Y^{2}\right]=\sigma^{2},\qquad\mathbb{E}\left[Y^{4}\right]=O\!\left(\sigma^{4}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p13.2" class="ltx_p"><span id="A5.p13.2.1" class="ltx_text">By Taylor’s theorem with Lagrange remainder for <math id="A5.p13.m2" class="ltx_Math" alttext="f(x)=1/x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=1/x</annotation></semantics></math>, there exists <math id="A5.p13.m3" class="ltx_Math" alttext="\theta=\theta(X)\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta=\theta(X)\in(0,1)</annotation></semantics></math> such that</span></p>
<table id="A5.Ex558" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex558.m1" class="ltx_Math" alttext="\frac{1}{X}=\frac{1}{a}-\frac{Y}{a^{2}}+Z,\qquad Z:=\frac{Y^{2}}{\left(a+\theta Y\right)^{3}}\ \geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>X</mi></mfrac><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>−</mo><mfrac><mi>Y</mi><msup><mi>a</mi><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mi>Z</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>Z</mi><mo>:=</mo><mfrac><msup><mi>Y</mi><mn>2</mn></msup><msup><mrow><mo>(</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow><mo>)</mo></mrow><mn>3</mn></msup></mfrac><mo lspace="0.778em">≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{X}=\frac{1}{a}-\frac{Y}{a^{2}}+Z,\qquad Z:=\frac{Y^{2}}{\left(a+\theta Y\right)^{3}}\ \geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p13.3" class="ltx_p"><span id="A5.p13.3.1" class="ltx_text">Write <math id="A5.p13.m4" class="ltx_Math" alttext="\Delta:=\frac{1}{X}-\frac{1}{a}=-\frac{Y}{a^{2}}+Z" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>X</mi></mfrac><mo>−</mo><mfrac><mn>1</mn><mi>a</mi></mfrac></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mfrac><mi>Y</mi><msup><mi>a</mi><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mi>Z</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta:=\frac{1}{X}-\frac{1}{a}=-\frac{Y}{a^{2}}+Z</annotation></semantics></math>. Then</span></p>
<table id="A5.Ex559" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex559.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(\frac{1}{X}\right)=\mathbb{E}\left[\Delta^{2}\right]-\left(\mathbb{E}\left[\Delta\right]\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>X</mi></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(\frac{1}{X}\right)=\mathbb{E}\left[\Delta^{2}\right]-\left(\mathbb{E}\left[\Delta\right]\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p13.4" class="ltx_p"><span id="A5.p13.4.1" class="ltx_text">We will show</span></p>
<table id="A5.Ex560" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex560.m1" class="ltx_Math" alttext="\mathbb{E}\left[\Delta^{2}\right]=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right)\quad\text{and}\quad\left(\mathbb{E}\left[\Delta\right]\right)^{2}=o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\Delta^{2}\right]=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right)\quad\text{and}\quad\left(\mathbb{E}\left[\Delta\right]\right)^{2}=o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p14" class="ltx_para">
<p id="A5.p14.1" class="ltx_p"><span id="A5.p14.1.1" class="ltx_text">Let <math id="A5.p14.m1" class="ltx_math_unparsed" alttext="G:=\{X\geq C\}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>X</mi><mo>≥</mo><mi>C</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G:=\{X\geq C\}</annotation></semantics></math> and <math id="A5.p14.m2" class="ltx_math_unparsed" alttext="B:=\{X&lt;C\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>X</mi><mo>&lt;</mo><mi>C</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B:=\{X&lt;C\}</annotation></semantics></math>. Since <math id="A5.p14.m3" class="ltx_Math" alttext="C&lt;a" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&lt;</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">C&lt;a</annotation></semantics></math> and <math id="A5.p14.m4" class="ltx_Math" alttext="\mathbb{E}\left[Y^{2}\right]=\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Y^{2}\right]=\sigma^{2}</annotation></semantics></math>,
Chebyshev gives the quantitative bound</span></p>
<table id="A5.Ex561" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex561.m1" class="ltx_math_unparsed" alttext="\Pr\left[B\right]=\Pr\left[\,|Y|\geq a-C\,\right]\leq\frac{\mathbb{E}\left[Y^{2}\right]}{(a-C)^{2}}=\frac{\sigma^{2}}{(a-C)^{2}}=O\!\left(\sigma^{2}\right)=o(1)." display="block" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow><mo>=</mo><mi>Pr</mi><mrow><mo rspace="0.170em">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Y</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≥</mo><mi>a</mi><mo>−</mo><mi>C</mi><mo lspace="0.170em">]</mo></mrow><mo>≤</mo><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>−</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow><mo>=</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pr\left[B\right]=\Pr\left[\,|Y|\geq a-C\,\right]\leq\frac{\mathbb{E}\left[Y^{2}\right]}{(a-C)^{2}}=\frac{\sigma^{2}}{(a-C)^{2}}=O\!\left(\sigma^{2}\right)=o(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p15" class="ltx_para ltx_noindent">
<p id="A5.p15.1" class="ltx_p"><span id="A5.p15.1.1" class="ltx_text ltx_font_bold">Second moment <math id="A5.p15.m1" class="ltx_Math" alttext="\mathbb{E}\left[\Delta^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\Delta^{2}\right]</annotation></semantics></math>.</span>
We split over <math id="A5.p15.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="A5.p15.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.</p>
</div>
<div id="A5.p16" class="ltx_para">
<p id="A5.p16.1" class="ltx_p"><em id="A5.p16.1.1" class="ltx_emph ltx_font_italic">On <math id="A5.p16.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</em><span id="A5.p16.1.2" class="ltx_text"> Since <math id="A5.p16.m2" class="ltx_Math" alttext="a+\theta Y=\theta X+(1-\theta)a\geq C" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow><mo>=</mo><mrow><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>≥</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">a+\theta Y=\theta X+(1-\theta)a\geq C</annotation></semantics></math>, we have</span></p>
<table id="A5.Ex562" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex562.m1" class="ltx_Math" alttext="\left|Z\right|\leq\frac{Y^{2}}{C^{3}},\qquad Z^{2}\leq\frac{Y^{4}}{C^{6}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mi>Z</mi><mo>|</mo></mrow><mo>≤</mo><mfrac><msup><mi>Y</mi><mn>2</mn></msup><msup><mi>C</mi><mn>3</mn></msup></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><msup><mi>Z</mi><mn>2</mn></msup><mo>≤</mo><mfrac><msup><mi>Y</mi><mn>4</mn></msup><msup><mi>C</mi><mn>6</mn></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|Z\right|\leq\frac{Y^{2}}{C^{3}},\qquad Z^{2}\leq\frac{Y^{4}}{C^{6}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p16.2" class="ltx_p"><span id="A5.p16.2.1" class="ltx_text">Therefore</span></p>
<table id="A5.Ex563" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex563.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left(-\frac{Y}{a^{2}}+Z\right)^{\!2}\mathbf{1}_{G}\right]=\frac{1}{a^{4}}\,\mathbb{E}\left[Y^{2}\mathbf{1}_{G}\right]-\frac{2}{a^{2}}\,\mathbb{E}\left[YZ\,\mathbf{1}_{G}\right]+\mathbb{E}\left[Z^{2}\mathbf{1}_{G}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mfrac><mi>Y</mi><msup><mi>a</mi><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mi>Z</mi></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>2</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>Z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left(-\frac{Y}{a^{2}}+Z\right)^{\!2}\mathbf{1}_{G}\right]=\frac{1}{a^{4}}\,\mathbb{E}\left[Y^{2}\mathbf{1}_{G}\right]-\frac{2}{a^{2}}\,\mathbb{E}\left[YZ\,\mathbf{1}_{G}\right]+\mathbb{E}\left[Z^{2}\mathbf{1}_{G}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p16.3" class="ltx_p"><span id="A5.p16.3.1" class="ltx_text">We bound each term as follows.</span></p>
<table id="A5.Ex564" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex564.m1" class="ltx_Math" alttext="\mathbb{E}\left[Z^{2}\mathbf{1}_{G}\right]\leq\frac{1}{C^{6}}\,\mathbb{E}\left[Y^{4}\right]=O\!\left(\sigma^{4}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>Z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>C</mi><mn>6</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>4</mn></msup><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Z^{2}\mathbf{1}_{G}\right]\leq\frac{1}{C^{6}}\,\mathbb{E}\left[Y^{4}\right]=O\!\left(\sigma^{4}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p16.4" class="ltx_p"><span id="A5.p16.4.1" class="ltx_text">and, using <math id="A5.p16.m3" class="ltx_Math" alttext="\mathbf{1}_{G}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mn>𝟏</mn><mi>G</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{1}_{G}\leq 1</annotation></semantics></math> and Lyapunov/monotonicity of <math id="A5.p16.m4" class="ltx_Math" alttext="L^{p}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi>p</mi></msup><annotation encoding="application/x-tex">L^{p}</annotation></semantics></math> norms,</span></p>
<table id="A5.Ex565" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex565.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left|YZ\right|\mathbf{1}_{G}\right]\leq\frac{1}{C^{3}}\,\mathbb{E}\left[\left|Y\right|^{3}\right]\leq\frac{1}{C^{3}}\left(\mathbb{E}\left[Y^{4}\right]\right)^{3/4}=O\!\left(\sigma^{3}\right)=o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>|</mo><mrow><mi>Y</mi><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>C</mi><mn>3</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>|</mo><mi>Y</mi><mo>|</mo></mrow><mn>3</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>C</mi><mn>3</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>3</mn></msup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left|YZ\right|\mathbf{1}_{G}\right]\leq\frac{1}{C^{3}}\,\mathbb{E}\left[\left|Y\right|^{3}\right]\leq\frac{1}{C^{3}}\left(\mathbb{E}\left[Y^{4}\right]\right)^{3/4}=O\!\left(\sigma^{3}\right)=o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p16.5" class="ltx_p"><span id="A5.p16.5.1" class="ltx_text">Moreover,</span></p>
<table id="A5.Ex566" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex566.m1" class="ltx_Math" alttext="\mathbb{E}\left[Y^{2}\mathbf{1}_{G}\right]=\sigma^{2}-\mathbb{E}\left[Y^{2}\mathbf{1}_{B}\right],\qquad\mathbb{E}\left[Y^{2}\mathbf{1}_{B}\right]\leq\left(\mathbb{E}\left[Y^{4}\right]\right)^{1/2}\Pr\left[B\right]^{1/2}=O\!\left(\sigma^{2}\right)\Pr\left[B\right]^{1/2}=o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>Y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>Y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>Y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>=</mo><mrow><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>=</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Y^{2}\mathbf{1}_{G}\right]=\sigma^{2}-\mathbb{E}\left[Y^{2}\mathbf{1}_{B}\right],\qquad\mathbb{E}\left[Y^{2}\mathbf{1}_{B}\right]\leq\left(\mathbb{E}\left[Y^{4}\right]\right)^{1/2}\Pr\left[B\right]^{1/2}=O\!\left(\sigma^{2}\right)\Pr\left[B\right]^{1/2}=o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p16.6" class="ltx_p"><span id="A5.p16.6.1" class="ltx_text">Hence</span></p>
<table id="A5.Ex567" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex567.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left(-\frac{Y}{a^{2}}+Z\right)^{\!2}\mathbf{1}_{G}\right]=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>(</mo><mrow><mrow><mo>−</mo><mfrac><mi>Y</mi><msup><mi>a</mi><mn>2</mn></msup></mfrac></mrow><mo>+</mo><mi>Z</mi></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left(-\frac{Y}{a^{2}}+Z\right)^{\!2}\mathbf{1}_{G}\right]=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p17" class="ltx_para">
<p id="A5.p17.1" class="ltx_p"><em id="A5.p17.1.1" class="ltx_emph ltx_font_italic">On <math id="A5.p17.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.</em><span id="A5.p17.1.2" class="ltx_text"> Using the algebraic identity</span></p>
<table id="A5.Ex568" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex568.m1" class="ltx_Math" alttext="\left(\frac{1}{X}-\frac{1}{a}\right)^{2}=\frac{Y^{2}}{a^{2}X^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>X</mi></mfrac><mo>−</mo><mfrac><mn>1</mn><mi>a</mi></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mfrac><msup><mi>Y</mi><mn>2</mn></msup><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left(\frac{1}{X}-\frac{1}{a}\right)^{2}=\frac{Y^{2}}{a^{2}X^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p17.2" class="ltx_p"><span id="A5.p17.2.1" class="ltx_text">Cauchy–Schwarz and Hölder (with exponents <math id="A5.p17.m2" class="ltx_Math" alttext="2,2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2,2</annotation></semantics></math>) give</span></p>
<table id="A5.Ex569" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex569.m1" class="ltx_Math" alttext="\mathbb{E}\left[\Delta^{2}\mathbf{1}_{B}\right]=\frac{1}{a^{2}}\,\mathbb{E}\left[\frac{Y^{2}}{X^{2}}\,\mathbf{1}_{B}\right]\leq\frac{1}{a^{2}}\left(\mathbb{E}\left[Y^{4}\right]\right)^{1/2}\left(\mathbb{E}\left[X^{-4}\mathbf{1}_{B}\right]\right)^{1/2}\leq\frac{1}{a^{2}}\,O\!\left(\sigma^{2}\right)\left(\mathbb{E}\left[X^{-8}\right]\right)^{1/4}\Pr\left[B\right]^{1/4}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mfrac><msup><mi>Y</mi><mn>2</mn></msup><msup><mi>X</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>X</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>a</mi><mn>2</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>X</mi><mrow><mo>−</mo><mn>8</mn></mrow></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\Delta^{2}\mathbf{1}_{B}\right]=\frac{1}{a^{2}}\,\mathbb{E}\left[\frac{Y^{2}}{X^{2}}\,\mathbf{1}_{B}\right]\leq\frac{1}{a^{2}}\left(\mathbb{E}\left[Y^{4}\right]\right)^{1/2}\left(\mathbb{E}\left[X^{-4}\mathbf{1}_{B}\right]\right)^{1/2}\leq\frac{1}{a^{2}}\,O\!\left(\sigma^{2}\right)\left(\mathbb{E}\left[X^{-8}\right]\right)^{1/4}\Pr\left[B\right]^{1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p17.3" class="ltx_p"><span id="A5.p17.3.1" class="ltx_text">Under the lemma’s assumption <math id="A5.p17.m3" class="ltx_Math" alttext="\mathbb{E}\left[X^{-8}\right]\leq M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>X</mi><mrow><mo>−</mo><mn>8</mn></mrow></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[X^{-8}\right]\leq M</annotation></semantics></math>, we get</span></p>
<table id="A5.Ex570" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex570.m1" class="ltx_Math" alttext="\mathbb{E}\left[\Delta^{2}\mathbf{1}_{B}\right]=O\!\left(\sigma^{2}\right)\Pr\left[B\right]^{1/4}=o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Pr</mi><mo>⁡</mo><msup><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\Delta^{2}\mathbf{1}_{B}\right]=O\!\left(\sigma^{2}\right)\Pr\left[B\right]^{1/4}=o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p17.4" class="ltx_p"><span id="A5.p17.4.1" class="ltx_text">Combining the <math id="A5.p17.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="A5.p17.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> parts,</span></p>
<table id="A5.Ex571" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex571.m1" class="ltx_Math" alttext="\mathbb{E}\left[\Delta^{2}\right]=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\Delta^{2}\right]=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p18" class="ltx_para ltx_noindent">
<p id="A5.p18.1" class="ltx_p"><span id="A5.p18.1.1" class="ltx_text ltx_font_bold">Mean correction <math id="A5.p18.m1" class="ltx_Math" alttext="\left(\mathbb{E}\left[\Delta\right]\right)^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\left(\mathbb{E}\left[\Delta\right]\right)^{2}</annotation></semantics></math>.</span>
Since <math id="A5.p18.m2" class="ltx_Math" alttext="\mathbb{E}\left[Y\right]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>Y</mi><mo>]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Y\right]=0</annotation></semantics></math>, we have</p>
<table id="A5.Ex572" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex572.m1" class="ltx_Math" alttext="\mathbb{E}\left[\Delta\right]=\mathbb{E}\left[Z\right]=\mathbb{E}\left[Z\,\mathbf{1}_{G}\right]+\mathbb{E}\left[Z\,\mathbf{1}_{B}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>Z</mi><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\Delta\right]=\mathbb{E}\left[Z\right]=\mathbb{E}\left[Z\,\mathbf{1}_{G}\right]+\mathbb{E}\left[Z\,\mathbf{1}_{B}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p18.2" class="ltx_p">On <math id="A5.p18.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, <math id="A5.p18.m4" class="ltx_Math" alttext="Z\leq Y^{2}/C^{3}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>≤</mo><mrow><msup><mi>Y</mi><mn>2</mn></msup><mo>/</mo><msup><mi>C</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">Z\leq Y^{2}/C^{3}</annotation></semantics></math>, so</p>
<table id="A5.Ex573" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex573.m1" class="ltx_Math" alttext="\mathbb{E}\left[Z\,\mathbf{1}_{G}\right]\leq\frac{1}{C^{3}}\,\mathbb{E}\left[Y^{2}\mathbf{1}_{G}\right]\leq\frac{1}{C^{3}}\,\sigma^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>C</mi><mn>3</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>Y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>G</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mi>C</mi><mn>3</mn></msup></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Z\,\mathbf{1}_{G}\right]\leq\frac{1}{C^{3}}\,\mathbb{E}\left[Y^{2}\mathbf{1}_{G}\right]\leq\frac{1}{C^{3}}\,\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p18.3" class="ltx_p">On <math id="A5.p18.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, The inequality</p>
<table id="A5.Ex574" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex574.m1" class="ltx_Math" alttext="Z=\frac{Y^{2}}{a+\theta Y)^{3}}\leq\frac{X^{2}}{Y^{3}}" display="block" intent=":literal"><semantics><mrow><mi>Z</mi><mo>=</mo><mfrac><msup><mi>Y</mi><mn>2</mn></msup><msup><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mi>a</mi><mo>+</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac><mo>≤</mo><mfrac><msup><mi>X</mi><mn>2</mn></msup><msup><mi>Y</mi><mn>3</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">Z=\frac{Y^{2}}{a+\theta Y)^{3}}\leq\frac{X^{2}}{Y^{3}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p18.4" class="ltx_p">holds on set <math id="A5.p18.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> because on this set as <math id="A5.p18.m7" class="ltx_Math" alttext="X&lt;a" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>&lt;</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">X&lt;a</annotation></semantics></math>, meaning the point <math id="A5.p18.m8" class="ltx_Math" alttext="a+\theta Y" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>+</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">a+\theta Y</annotation></semantics></math> lies between <math id="A5.p18.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A5.p18.m10" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, so <math id="A5.p18.m11" class="ltx_Math" alttext="a+\theta Y&gt;X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow><mo>&gt;</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">a+\theta Y&gt;X</annotation></semantics></math>. Thus, using Cauchy–Schwarz and Hölder,</p>
<table id="A5.Ex575" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex575.m1" class="ltx_Math" alttext="\mathbb{E}\left[Z\,\mathbf{1}_{B}\right]\leq\mathbb{E}\left[\frac{Y^{2}}{X^{3}}\,\mathbf{1}_{B}\right]\leq\left(\mathbb{E}\left[Y^{4}\right]\right)^{1/2}\left(\mathbb{E}\left[X^{-6}\mathbf{1}_{B}\right]\right)^{1/2}\leq O\!\left(\sigma^{2}\right)\left(\mathbb{E}\left[X^{-12}\right]\right)^{1/4}\Pr\left[B\right]^{1/4}=o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>Z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><msup><mi>Y</mi><mn>2</mn></msup><msup><mi>X</mi><mn>3</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>Y</mi><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>X</mi><mrow><mo>−</mo><mn>6</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><mi>B</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>≤</mo><mrow><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi>X</mi><mrow><mo>−</mo><mn>12</mn></mrow></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>Pr</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><mo>=</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[Z\,\mathbf{1}_{B}\right]\leq\mathbb{E}\left[\frac{Y^{2}}{X^{3}}\,\mathbf{1}_{B}\right]\leq\left(\mathbb{E}\left[Y^{4}\right]\right)^{1/2}\left(\mathbb{E}\left[X^{-6}\mathbf{1}_{B}\right]\right)^{1/2}\leq O\!\left(\sigma^{2}\right)\left(\mathbb{E}\left[X^{-12}\right]\right)^{1/4}\Pr\left[B\right]^{1/4}=o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p18.5" class="ltx_p">Thus <math id="A5.p18.m12" class="ltx_Math" alttext="\left|\mathbb{E}\left[\Delta\right]\right|=O\!\left(\sigma^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}\left[\Delta\right]\right|=O\!\left(\sigma^{2}\right)</annotation></semantics></math> and therefore</p>
<table id="A5.Ex576" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex576.m1" class="ltx_Math" alttext="\left(\mathbb{E}\left[\Delta\right]\right)^{2}=O\!\left(\sigma^{4}\right)=o\!\left(\sigma^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>4</mn></msup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\mathbb{E}\left[\Delta\right]\right)^{2}=O\!\left(\sigma^{4}\right)=o\!\left(\sigma^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p19" class="ltx_para">
<p id="A5.p19.1" class="ltx_p"><span id="A5.p19.1.1" class="ltx_text">Putting the two steps together,</span></p>
<table id="A5.Ex577" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex577.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(\frac{1}{X}\right)=\mathbb{E}\left[\Delta^{2}\right]-\left(\mathbb{E}\left[\Delta\right]\right)^{2}=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right)=\frac{1}{a^{4}}\mathrm{Var}\!\left(X\right)+o\!\left(\mathrm{Var}\!\left(X\right)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mi>X</mi></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mi mathvariant="normal">Δ</mi><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi mathvariant="normal">Δ</mi><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mi>σ</mi><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>a</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>X</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>X</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(\frac{1}{X}\right)=\mathbb{E}\left[\Delta^{2}\right]-\left(\mathbb{E}\left[\Delta\right]\right)^{2}=\frac{\sigma^{2}}{a^{4}}+o\!\left(\sigma^{2}\right)=\frac{1}{a^{4}}\mathrm{Var}\!\left(X\right)+o\!\left(\mathrm{Var}\!\left(X\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p19.2" class="ltx_p"><span id="A5.p19.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma34" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma34.2" class="ltx_text ltx_font_bold">Lemma 34</span></span><span id="Thmlemma34.3" class="ltx_text ltx_font_bold"> </span>(Variance of a sum)<span id="Thmlemma34.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma34.p1" class="ltx_para">
<p id="Thmlemma34.p1.1" class="ltx_p"><span id="Thmlemma34.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma34.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="Thmlemma34.p1.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> be any random variables with finite variances <math id="Thmlemma34.p1.m3" class="ltx_Math" alttext="V(A)=\mathrm{Var}(A)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V(A)=\mathrm{Var}(A)</annotation></semantics></math> and <math id="Thmlemma34.p1.m4" class="ltx_Math" alttext="V(B)=\mathrm{Var}(B)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V(B)=\mathrm{Var}(B)</annotation></semantics></math>. Then,</span></p>
<table id="A5.Ex578" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex578.m1" class="ltx_Math" alttext="\mathrm{Var}(A+B)\leq\left(\sqrt{V(A)}+\sqrt{V(B)}\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mrow><mo>(</mo><mrow><msqrt><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(A+B)\leq\left(\sqrt{V(A)}+\sqrt{V(B)}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p20" class="ltx_para">
<p id="A5.p20.1" class="ltx_p"><span id="A5.p20.1.1" class="ltx_text">Recall that</span></p>
<table id="A5.Ex579" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex579.m1" class="ltx_Math" alttext="\mathrm{Var}(A+B)=\mathrm{Var}(A)+\mathrm{Var}(B)+2\,\operatorname{Cov}(A,B)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(A+B)=\mathrm{Var}(A)+\mathrm{Var}(B)+2\,\operatorname{Cov}(A,B).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p20.2" class="ltx_p"><span id="A5.p20.2.1" class="ltx_text">By the Cauchy–Schwarz inequality, we have</span></p>
<table id="A5.Ex580" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex580.m1" class="ltx_Math" alttext="\left|\operatorname{Cov}(A,B)\right|\leq\sqrt{V(A)V(B)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msqrt><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\operatorname{Cov}(A,B)\right|\leq\sqrt{V(A)V(B)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p20.3" class="ltx_p"><span id="A5.p20.3.1" class="ltx_text">Thus,</span></p>
<table id="A5.Ex581" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex581.m1" class="ltx_Math" alttext="\mathrm{Var}(A+B)\leq V(A)+V(B)+2\sqrt{V(A)V(B)}=\left(\sqrt{V(A)}+\sqrt{V(B)}\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>=</mo><msup><mrow><mo>(</mo><mrow><msqrt><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}(A+B)\leq V(A)+V(B)+2\sqrt{V(A)V(B)}=\left(\sqrt{V(A)}+\sqrt{V(B)}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p20.4" class="ltx_p"><span id="A5.p20.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma35" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma35.2" class="ltx_text ltx_font_bold">Lemma 35</span></span><span id="Thmlemma35.3" class="ltx_text ltx_font_bold"> </span>(Variance of one product)<span id="Thmlemma35.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma35.p1" class="ltx_para">
<p id="Thmlemma35.p1.1" class="ltx_p"><span id="Thmlemma35.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma35.p1.m1" class="ltx_Math" alttext="A,B" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">A,B</annotation></semantics></math> be real random variables with means <math id="Thmlemma35.p1.m2" class="ltx_Math" alttext="a=\mathbb{E}\left[A\right]" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>A</mi><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a=\mathbb{E}\left[A\right]</annotation></semantics></math>, <math id="Thmlemma35.p1.m3" class="ltx_Math" alttext="b=\mathbb{E}\left[B\right]" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mi>B</mi><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=\mathbb{E}\left[B\right]</annotation></semantics></math> and finite variances. Assume</span></p>
<table id="A5.Ex582" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex582.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left(A-a\right)^{4}\right]\leq K_{A}\,\mathrm{Var}\!\left(A\right)^{2},\qquad\mathbb{E}\left[\left(B-b\right)^{4}\right]\leq K_{B}\,\mathrm{Var}\!\left(B\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mi>A</mi><mo>−</mo><mi>a</mi></mrow><mo>)</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>K</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mi>B</mi><mo>−</mo><mi>b</mi></mrow><mo>)</mo></mrow><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>K</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left(A-a\right)^{4}\right]\leq K_{A}\,\mathrm{Var}\!\left(A\right)^{2},\qquad\mathbb{E}\left[\left(B-b\right)^{4}\right]\leq K_{B}\,\mathrm{Var}\!\left(B\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma35.p1.2" class="ltx_p"><span id="Thmlemma35.p1.2.1" class="ltx_text ltx_font_italic">Then, with <math id="Thmlemma35.p1.m4" class="ltx_Math" alttext="C_{4}:=(K_{A}K_{B})^{1/4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>B</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">C_{4}:=(K_{A}K_{B})^{1/4}</annotation></semantics></math>,</span></p>
<table id="A5.Ex583" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex583.m1" class="ltx_Math" alttext="\sqrt{\mathrm{Var}\!\left(AB\right)}\;\leq\;|a|\,\sqrt{\mathrm{Var}\!\left(B\right)}\;+\;|b|\,\sqrt{\mathrm{Var}\!\left(A\right)}\;+\;C_{4}\,\sqrt{\mathrm{Var}\!\left(A\right)\mathrm{Var}\!\left(B\right)}." display="block" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow></msqrt><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>a</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mrow><mo stretchy="false">|</mo><mi>b</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sqrt{\mathrm{Var}\!\left(AB\right)}\;\leq\;|a|\,\sqrt{\mathrm{Var}\!\left(B\right)}\;+\;|b|\,\sqrt{\mathrm{Var}\!\left(A\right)}\;+\;C_{4}\,\sqrt{\mathrm{Var}\!\left(A\right)\mathrm{Var}\!\left(B\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma35.p1.3" class="ltx_p"><span id="Thmlemma35.p1.3.1" class="ltx_text ltx_font_italic">Moreover, as <math id="Thmlemma35.p1.m5" class="ltx_Math" alttext="\mathrm{Var}\!\left(A\right),\mathrm{Var}\!\left(B\right)\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(A\right),\mathrm{Var}\!\left(B\right)\to 0</annotation></semantics></math>,</span></p>
<table id="A5.Ex584" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex584.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(AB\right)=O\left(a^{2}\mathrm{Var}\!\left(B\right)\right)+O\left(b^{2}\mathrm{Var}\!\left(A\right)\right)+o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(AB\right)=O\left(a^{2}\mathrm{Var}\!\left(B\right)\right)+O\left(b^{2}\mathrm{Var}\!\left(A\right)\right)+o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma35.p1.4" class="ltx_p"><span id="Thmlemma35.p1.4.1" class="ltx_text ltx_font_italic">It directly follows that if all the means are <math id="Thmlemma35.p1.m6" class="ltx_Math" alttext="O(1)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1)</annotation></semantics></math>,</span></p>
<table id="A5.EGx134" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex585"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex585.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\!\left(AB\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\!\left(AB\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex585.m2" class="ltx_Math" alttext="\displaystyle=O\left(\mathrm{Var}\!\left(B\right)\right)+O\left(\mathrm{Var}\!\left(A\right)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=O\left(\mathrm{Var}\!\left(B\right)\right)+O\left(\mathrm{Var}\!\left(A\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex586"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex586.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\!\left(ABC\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\!\left(ABC\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex586.m2" class="ltx_math_unparsed" alttext="\displaystyle=O\left(\mathrm{Var}\!\left(C\right)\right)+O\left(\mathrm{Var}\!\left(B\right)\right)+O\left(\mathrm{Var}\!\left(A\right)\right)\quad\text{and so on by induction}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>O</mi><mrow><mo>(</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo>(</mo><mi>C</mi><mo>)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi>O</mi><mrow><mo>(</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi>O</mi><mrow><mo>(</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow><mo>)</mo></mrow><mtext class="ltx_mathvariant_italic">and so on by induction</mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=O\left(\mathrm{Var}\!\left(C\right)\right)+O\left(\mathrm{Var}\!\left(B\right)\right)+O\left(\mathrm{Var}\!\left(A\right)\right)\quad\text{and so on by induction}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p21" class="ltx_para">
<p id="A5.p21.1" class="ltx_p"><span id="A5.p21.1.1" class="ltx_text">Write</span></p>
<table id="A5.Ex587" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex587.m1" class="ltx_Math" alttext="AB-ab=a\,\tilde{B}+b\,\tilde{A}+\tilde{A}\tilde{B}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>−</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><mo>=</mo><mrow><mrow><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">AB-ab=a\,\tilde{B}+b\,\tilde{A}+\tilde{A}\tilde{B}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p21.2" class="ltx_p"><span id="A5.p21.2.1" class="ltx_text">Using <math id="A5.p21.m1" class="ltx_Math" alttext="\mathrm{Var}(U+V)=\mathrm{Var}(U)+\mathrm{Var}(V)+2\,\mathrm{Cov}(U,V)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>+</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><mi>Cov</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(U+V)=\mathrm{Var}(U)+\mathrm{Var}(V)+2\,\mathrm{Cov}(U,V)</annotation></semantics></math> and
<math id="A5.p21.m2" class="ltx_Math" alttext="|\mathrm{Cov}(U,V)|\leq\sqrt{\mathrm{Var}(U)\mathrm{Var}(V)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">|\mathrm{Cov}(U,V)|\leq\sqrt{\mathrm{Var}(U)\mathrm{Var}(V)}</annotation></semantics></math>, we get</span></p>
<table id="A5.EGx135" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex588"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex588.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\!\left(AB\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\!\left(AB\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex588.m2" class="ltx_Math" alttext="\displaystyle=\mathrm{Var}\!\left(a\tilde{B}+b\tilde{A}+\tilde{A}\tilde{B}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{Var}\!\left(a\tilde{B}+b\tilde{A}+\tilde{A}\tilde{B}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex589"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex589.m1" class="ltx_Math" alttext="\displaystyle\;\leq\;\left(\,|a|\sqrt{\mathrm{Var}\!\left(\tilde{B}\right)}\;+\;|b|\sqrt{\mathrm{Var}\!\left(\tilde{A}\right)}\;+\;\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\,\right)^{\!2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.558em" rspace="0.558em">≤</mo><msup><mrow><mo rspace="0.170em">(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>a</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mrow><mo stretchy="false">|</mo><mi>b</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.170em">)</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;\leq\;\left(\,|a|\sqrt{\mathrm{Var}\!\left(\tilde{B}\right)}\;+\;|b|\sqrt{\mathrm{Var}\!\left(\tilde{A}\right)}\;+\;\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\,\right)^{\!2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p21.3" class="ltx_p"><span id="A5.p21.3.1" class="ltx_text">Since <math id="A5.p21.m3" class="ltx_Math" alttext="\mathrm{Var}(\tilde{A})=\mathrm{Var}(A)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\tilde{A})=\mathrm{Var}(A)</annotation></semantics></math> and <math id="A5.p21.m4" class="ltx_Math" alttext="\mathrm{Var}(\tilde{B})=\mathrm{Var}(B)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\tilde{B})=\mathrm{Var}(B)</annotation></semantics></math>, it remains to bound
<math id="A5.p21.m5" class="ltx_Math" alttext="\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)</annotation></semantics></math>. By Cauchy–Schwarz (Hölder with <math id="A5.p21.m6" class="ltx_Math" alttext="p=q=2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mi>q</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p=q=2</annotation></semantics></math>),</span></p>
<table id="A5.Ex590" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex590.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)\;\leq\;\mathbb{E}\!\left[\tilde{A}^{2}\tilde{B}^{2}\right]\;\leq\;\left(\mathbb{E}\!\left[\tilde{A}^{4}\right]\right)^{1/2}\left(\mathbb{E}\!\left[\tilde{B}^{4}\right]\right)^{1/2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mo rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)\;\leq\;\mathbb{E}\!\left[\tilde{A}^{2}\tilde{B}^{2}\right]\;\leq\;\left(\mathbb{E}\!\left[\tilde{A}^{4}\right]\right)^{1/2}\left(\mathbb{E}\!\left[\tilde{B}^{4}\right]\right)^{1/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p21.4" class="ltx_p"><span id="A5.p21.4.1" class="ltx_text">Since we assume fourth–moment control
<math id="A5.p21.m7" class="ltx_Math" alttext="\mathbb{E}\!\left[\tilde{A}^{4}\right]\leq K_{A}\,\mathrm{Var}(A)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>K</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\tilde{A}^{4}\right]\leq K_{A}\,\mathrm{Var}(A)^{2}</annotation></semantics></math> and
<math id="A5.p21.m8" class="ltx_Math" alttext="\mathbb{E}\!\left[\tilde{B}^{4}\right]\leq K_{B}\,\mathrm{Var}(B)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><msup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>K</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\tilde{B}^{4}\right]\leq K_{B}\,\mathrm{Var}(B)^{2}</annotation></semantics></math>, then</span></p>
<table id="A5.Ex591" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex591.m1" class="ltx_Math" alttext="\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\;\leq\;(K_{A}K_{B})^{1/4}\,\sqrt{\mathrm{Var}(A)\mathrm{Var}(B)}." display="block" intent=":literal"><semantics><mrow><mrow><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></msqrt><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>B</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\;\leq\;(K_{A}K_{B})^{1/4}\,\sqrt{\mathrm{Var}(A)\mathrm{Var}(B)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p21.5" class="ltx_p"><span id="A5.p21.5.1" class="ltx_text">Hence</span></p>
<table id="A5.Ex592" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex592.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(AB\right)\;\leq\;\Big(\,|a|\sqrt{\mathrm{Var}(B)}\;+\;|b|\sqrt{\mathrm{Var}(A)}\;+\;C_{4}\,\sqrt{\mathrm{Var}(A)\mathrm{Var}(B)}\,\Big)^{\!2},\qquad C_{4}:=(K_{A}K_{B})^{1/4}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">≤</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.170em">(</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>a</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mrow><mo stretchy="false">|</mo><mi>b</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0.170em" maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>K</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>K</mi><mi>B</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(AB\right)\;\leq\;\Big(\,|a|\sqrt{\mathrm{Var}(B)}\;+\;|b|\sqrt{\mathrm{Var}(A)}\;+\;C_{4}\,\sqrt{\mathrm{Var}(A)\mathrm{Var}(B)}\,\Big)^{\!2},\qquad C_{4}:=(K_{A}K_{B})^{1/4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p22" class="ltx_para">
<p id="A5.p22.1" class="ltx_p"><span id="A5.p22.1.1" class="ltx_text">For the moreover part, using the exact variance–covariance expansion,</span></p>
<table id="A5.Ex593" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex593.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(AB\right)=a^{2}\mathrm{Var}\!\left(B\right)+b^{2}\mathrm{Var}\!\left(A\right)+2ab\,\mathrm{Cov}\!\left(A,B\right)+\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)+2a\,\mathrm{Cov}\!\left(\tilde{B},\tilde{A}\tilde{B}\right)+2b\,\mathrm{Cov}\!\left(\tilde{A},\tilde{A}\tilde{B}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(AB\right)=a^{2}\mathrm{Var}\!\left(B\right)+b^{2}\mathrm{Var}\!\left(A\right)+2ab\,\mathrm{Cov}\!\left(A,B\right)+\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)+2a\,\mathrm{Cov}\!\left(\tilde{B},\tilde{A}\tilde{B}\right)+2b\,\mathrm{Cov}\!\left(\tilde{A},\tilde{A}\tilde{B}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p22.2" class="ltx_p"><span id="A5.p22.2.1" class="ltx_text">we bound the three remainder terms using Cauchy–Schwarz and the fourth–moment control:</span></p>
<table id="A5.EGx136" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex594"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex594.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex594.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}\left[\tilde{A}^{2}\tilde{B}^{2}\right]\leq\left(\mathbb{E}\left[\tilde{A}^{4}\right]\right)^{1/2}\left(\mathbb{E}\left[\tilde{B}^{4}\right]\right)^{1/2}\leq C_{4}^{2}\,\mathrm{Var}\!\left(A\right)\mathrm{Var}\!\left(B\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mover accent="true"><mi>A</mi><mo>~</mo></mover><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mn>4</mn></msup><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>≤</mo><mrow><msubsup><mi>C</mi><mn>4</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\left[\tilde{A}^{2}\tilde{B}^{2}\right]\leq\left(\mathbb{E}\left[\tilde{A}^{4}\right]\right)^{1/2}\left(\mathbb{E}\left[\tilde{B}^{4}\right]\right)^{1/2}\leq C_{4}^{2}\,\mathrm{Var}\!\left(A\right)\mathrm{Var}\!\left(B\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex595"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex595.m1" class="ltx_Math" alttext="\displaystyle\left|\mathrm{Cov}\!\left(\tilde{B},\tilde{A}\tilde{B}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathrm{Cov}\!\left(\tilde{B},\tilde{A}\tilde{B}\right)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex595.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\mathrm{Var}\!\left(\tilde{B}\right)}\,\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\leq C_{4}\,\mathrm{Var}\!\left(B\right)\sqrt{\mathrm{Var}\!\left(A\right)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\mathrm{Var}\!\left(\tilde{B}\right)}\,\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\leq C_{4}\,\mathrm{Var}\!\left(B\right)\sqrt{\mathrm{Var}\!\left(A\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex596"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex596.m1" class="ltx_Math" alttext="\displaystyle\left|\mathrm{Cov}\!\left(\tilde{A},\tilde{A}\tilde{B}\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>,</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\mathrm{Cov}\!\left(\tilde{A},\tilde{A}\tilde{B}\right)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex596.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\mathrm{Var}\!\left(\tilde{A}\right)}\,\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\leq C_{4}\,\mathrm{Var}\!\left(A\right)\sqrt{\mathrm{Var}\!\left(B\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo>)</mo></mrow></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mover accent="true"><mi>A</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover></mrow><mo>)</mo></mrow></mrow></msqrt></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\mathrm{Var}\!\left(\tilde{A}\right)}\,\sqrt{\mathrm{Var}\!\left(\tilde{A}\tilde{B}\right)}\leq C_{4}\,\mathrm{Var}\!\left(A\right)\sqrt{\mathrm{Var}\!\left(B\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p22.3" class="ltx_p"><span id="A5.p22.3.1" class="ltx_text">As <math id="A5.p22.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(A\right),\mathrm{Var}\!\left(B\right)\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(A\right),\mathrm{Var}\!\left(B\right)\to 0</annotation></semantics></math>, each of these is
<math id="A5.p22.m2" class="ltx_Math" alttext="o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right)</annotation></semantics></math>.</span></p>
</div>
<div id="A5.p23" class="ltx_para">
<p id="A5.p23.1" class="ltx_p"><span id="A5.p23.1.1" class="ltx_text">For the covariance term, Cauchy–Schwarz and the inequality
<math id="A5.p23.m1" class="ltx_Math" alttext="2uv\leq\varepsilon u^{2}+\varepsilon^{-1}v^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>≤</mo><mrow><mrow><mi>ε</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>ε</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">2uv\leq\varepsilon u^{2}+\varepsilon^{-1}v^{2}</annotation></semantics></math> (for any <math id="A5.p23.m2" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>) with
<math id="A5.p23.m3" class="ltx_Math" alttext="u:=|a|\sqrt{\mathrm{Var}\!\left(B\right)}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>a</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">u:=|a|\sqrt{\mathrm{Var}\!\left(B\right)}</annotation></semantics></math>, <math id="A5.p23.m4" class="ltx_Math" alttext="v:=|b|\sqrt{\mathrm{Var}\!\left(A\right)}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>:=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>b</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">v:=|b|\sqrt{\mathrm{Var}\!\left(A\right)}</annotation></semantics></math> give</span></p>
<table id="A5.Ex597" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex597.m1" class="ltx_Math" alttext="\left|\,2ab\,\mathrm{Cov}\!\left(A,B\right)\right|\leq 2|ab|\sqrt{\mathrm{Var}\!\left(A\right)\mathrm{Var}\!\left(B\right)}\leq\varepsilon\,a^{2}\mathrm{Var}\!\left(B\right)+\varepsilon^{-1}b^{2}\mathrm{Var}\!\left(A\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mpadded style="width:1.622em;" width="1.622em"><mi>Cov</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></msqrt></mrow><mo>≤</mo><mrow><mrow><mi>ε</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>ε</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\,2ab\,\mathrm{Cov}\!\left(A,B\right)\right|\leq 2|ab|\sqrt{\mathrm{Var}\!\left(A\right)\mathrm{Var}\!\left(B\right)}\leq\varepsilon\,a^{2}\mathrm{Var}\!\left(B\right)+\varepsilon^{-1}b^{2}\mathrm{Var}\!\left(A\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p23.2" class="ltx_p"><span id="A5.p23.2.1" class="ltx_text">Therefore,</span></p>
<table id="A5.Ex598" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex598.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(AB\right)\leq(1+\varepsilon)\,a^{2}\mathrm{Var}\!\left(B\right)+(1+\varepsilon^{-1})\,b^{2}\mathrm{Var}\!\left(A\right)+o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>ε</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(AB\right)\leq(1+\varepsilon)\,a^{2}\mathrm{Var}\!\left(B\right)+(1+\varepsilon^{-1})\,b^{2}\mathrm{Var}\!\left(A\right)+o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p23.3" class="ltx_p"><span id="A5.p23.3.1" class="ltx_text">Choosing, e.g., <math id="A5.p23.m5" class="ltx_Math" alttext="\varepsilon=1" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varepsilon=1</annotation></semantics></math> yields</span></p>
<table id="A5.Ex599" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex599.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(AB\right)=O\!\left(a^{2}\mathrm{Var}\!\left(B\right)\right)+O\!\left(b^{2}\mathrm{Var}\!\left(A\right)\right)+o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>a</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mi>b</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:0.315em;" width="0.315em"><mi>o</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mi>B</mi><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(AB\right)=O\!\left(a^{2}\mathrm{Var}\!\left(B\right)\right)+O\!\left(b^{2}\mathrm{Var}\!\left(A\right)\right)+o\!\left(\mathrm{Var}\!\left(A\right)+\mathrm{Var}\!\left(B\right)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p23.4" class="ltx_p"><span id="A5.p23.4.1" class="ltx_text">which proves the moreover statement.
∎</span></p>
</div>
</div>
<div id="Thmlemma36" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma36.2" class="ltx_text ltx_font_bold">Lemma 36</span></span><span id="Thmlemma36.3" class="ltx_text ltx_font_bold"> </span>(Variance of general product)<span id="Thmlemma36.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma36.p1" class="ltx_para">
<p id="Thmlemma36.p1.1" class="ltx_p"><span id="Thmlemma36.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma36.p1.m1" class="ltx_Math" alttext="m\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">m\geq 2</annotation></semantics></math> and let <math id="Thmlemma36.p1.m2" class="ltx_Math" alttext="X_{1},\dots,X_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">X_{1},\dots,X_{m}</annotation></semantics></math> be real random variables with nonzero means <math id="Thmlemma36.p1.m3" class="ltx_Math" alttext="\mu_{i}:=\mathbb{E}[X_{i}]\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo>:=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu_{i}:=\mathbb{E}[X_{i}]\neq 0</annotation></semantics></math> and variances <math id="Thmlemma36.p1.m4" class="ltx_Math" alttext="f_{i}(n):=\mathrm{Var}(X_{i})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{i}(n):=\mathrm{Var}(X_{i})\to 0</annotation></semantics></math> as <math id="Thmlemma36.p1.m5" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.
Assume that for some integer <math id="Thmlemma36.p1.m6" class="ltx_Math" alttext="M\geq m" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≥</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">M\geq m</annotation></semantics></math> (it is enough to take <math id="Thmlemma36.p1.m7" class="ltx_Math" alttext="M=m" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">M=m</annotation></semantics></math>),</span></p>
<table id="A5.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E32.m1" class="ltx_Math" alttext="\mathbb{E}\!\left[\,|X_{i}-\mu_{i}|^{2M}\,\right]\;=\;O\!\left(\mathrm{Var}(X_{i})^{M}\right)\qquad\text{for each }i=1,\dots,m." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo rspace="0.170em">[</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><mo rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>M</mi></msup></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for each </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\!\left[\,|X_{i}-\mu_{i}|^{2M}\,\right]\;=\;O\!\left(\mathrm{Var}(X_{i})^{M}\right)\qquad\text{for each }i=1,\dots,m.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="Thmlemma36.p1.2" class="ltx_p"><span id="Thmlemma36.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A5.Ex600" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex600.m1" class="ltx_Math" alttext="\mathrm{Var}\!\left(\,\prod_{i=1}^{m}X_{i}\,\right)\;=\;O\!\left(\Big(\sum_{i=1}^{m}\sqrt{f_{i}(n)}\Big)^{2}\right)\;=\;O\left(\max_{1\leq i\leq m}f_{i}(n)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mo rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>m</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\left(\,\prod_{i=1}^{m}X_{i}\,\right)\;=\;O\!\left(\Big(\sum_{i=1}^{m}\sqrt{f_{i}(n)}\Big)^{2}\right)\;=\;O\left(\max_{1\leq i\leq m}f_{i}(n)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.7" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p24" class="ltx_para">
<p id="A5.p24.1" class="ltx_p"><span id="A5.p24.1.1" class="ltx_text">Write <math id="A5.p24.m1" class="ltx_Math" alttext="\Delta_{i}:=X_{i}-\mu_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>:=</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta_{i}:=X_{i}-\mu_{i}</annotation></semantics></math> so that <math id="A5.p24.m2" class="ltx_Math" alttext="\mathbb{E}[\Delta_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\Delta_{i}]=0</annotation></semantics></math> and <math id="A5.p24.m3" class="ltx_Math" alttext="\|\Delta_{i}\|_{L_{2}}=\sigma_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub><mo>=</mo><msub><mi>σ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\|\Delta_{i}\|_{L_{2}}=\sigma_{i}</annotation></semantics></math>.
By assumption Equation <a href="#A5.E32" title="Equation 32 ‣ Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a> with <math id="A5.p24.m4" class="ltx_Math" alttext="M\geq m" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≥</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">M\geq m</annotation></semantics></math> and monotonicity of <math id="A5.p24.m5" class="ltx_Math" alttext="L_{p}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>p</mi></msub><annotation encoding="application/x-tex">L_{p}</annotation></semantics></math> norms,</span></p>
<table id="A5.Ex601" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex601.m1" class="ltx_Math" alttext="\|\Delta_{i}\|_{L_{2k}}\;=\;O\left(\sqrt{f_{i}(n)}\right)\qquad\text{for every }1\leq k\leq m,\ i=1,\dots,m." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext>for every </mtext><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>m</mi></mrow><mo rspace="0.667em">,</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Delta_{i}\|_{L_{2k}}\;=\;O\left(\sqrt{f_{i}(n)}\right)\qquad\text{for every }1\leq k\leq m,\ i=1,\dots,m.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p24.2" class="ltx_p"><span id="A5.p24.2.1" class="ltx_text">Expand the product multilinearly:</span></p>
<table id="A5.Ex602" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex602.m1" class="ltx_Math" alttext="\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}=\sum_{\emptyset\neq S\subseteq[m]}\ \left(\prod_{j\in S^{c}}\mu_{j}\right)\ \left(\prod_{i\in S}\Delta_{i}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi mathvariant="normal">∅</mi><mo>≠</mo><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>j</mi><mo>∈</mo><msup><mi>S</mi><mi>c</mi></msup></mrow></munder><msub><mi>μ</mi><mi>j</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}=\sum_{\emptyset\neq S\subseteq[m]}\ \left(\prod_{j\in S^{c}}\mu_{j}\right)\ \left(\prod_{i\in S}\Delta_{i}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p24.3" class="ltx_p"><span id="A5.p24.3.1" class="ltx_text">Taking <math id="A5.p24.m6" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> norms and using the triangle inequality,</span></p>
<table id="A5.Ex603" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex603.m1" class="ltx_Math" alttext="\left\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}\right\|_{L_{2}}\ \leq\ \sum_{\emptyset\neq S\subseteq[m]}\ \left(\prod_{j\in S^{c}}|\mu_{j}|\right)\ \left\|\prod_{i\in S}\Delta_{i}\right\|_{L_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub><mo lspace="0.778em" rspace="0.611em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi mathvariant="normal">∅</mi><mo>≠</mo><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>∈</mo><msup><mi>S</mi><mi>c</mi></msup></mrow></munder><mrow><mo stretchy="false">|</mo><msub><mi>μ</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}\right\|_{L_{2}}\ \leq\ \sum_{\emptyset\neq S\subseteq[m]}\ \left(\prod_{j\in S^{c}}|\mu_{j}|\right)\ \left\|\prod_{i\in S}\Delta_{i}\right\|_{L_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p24.4" class="ltx_p"><span id="A5.p24.4.1" class="ltx_text">For a fixed nonempty <math id="A5.p24.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with <math id="A5.p24.m8" class="ltx_Math" alttext="|S|=k" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">|S|=k</annotation></semantics></math>, apply Hölder with exponents all equal to <math id="A5.p24.m9" class="ltx_Math" alttext="2k" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">2k</annotation></semantics></math>:</span></p>
<table id="A5.Ex604" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex604.m1" class="ltx_Math" alttext="\left\|\prod_{i\in S}\Delta_{i}\right\|_{L_{2}}\ \leq\ \prod_{i\in S}\left\|\Delta_{i}\right\|_{L_{2k}}\ =\ O\!\left(\prod_{i\in S}\sqrt{f_{i}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub><mo lspace="0.778em" rspace="0.611em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></msub></mrow><mo rspace="0.778em">=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msqrt><msub><mi>f</mi><mi>i</mi></msub></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\prod_{i\in S}\Delta_{i}\right\|_{L_{2}}\ \leq\ \prod_{i\in S}\left\|\Delta_{i}\right\|_{L_{2k}}\ =\ O\!\left(\prod_{i\in S}\sqrt{f_{i}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p24.5" class="ltx_p"><span id="A5.p24.5.1" class="ltx_text">where we used <math id="A5.p24.m10" class="ltx_Math" alttext="\|\Delta_{i}\|_{L_{2k}}=O(\sqrt{f_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><msub><mi>f</mi><mi>i</mi></msub></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\Delta_{i}\|_{L_{2k}}=O(\sqrt{f_{i}})</annotation></semantics></math> for <math id="A5.p24.m11" class="ltx_Math" alttext="k\leq m" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">k\leq m</annotation></semantics></math>.</span></p>
</div>
<div id="A5.p25" class="ltx_para">
<p id="A5.p25.1" class="ltx_p"><span id="A5.p25.1.1" class="ltx_text">Let <math id="A5.p25.m1" class="ltx_Math" alttext="c_{i}:=\sqrt{f_{i}(n)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>:=</mo><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">c_{i}:=\sqrt{f_{i}(n)}</annotation></semantics></math>. Summing over subsets <math id="A5.p25.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> shows</span></p>
<table id="A5.Ex605" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex605.m1" class="ltx_Math" alttext="\left\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}\right\|_{L_{2}}\ \leq\ A\,\Big(\prod_{i=1}^{m}(1+c_{i})-1\Big)\ \leq\ A\,(e^{\Xi}-1)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><mi>A</mi><mo lspace="0.170em">⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.500em">)</mo></mrow></mrow><mo rspace="0.778em">≤</mo><mrow><mi>A</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}\right\|_{L_{2}}\ \leq\ A\,\Big(\prod_{i=1}^{m}(1+c_{i})-1\Big)\ \leq\ A\,(e^{\Xi}-1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p25.2" class="ltx_p"><span id="A5.p25.2.1" class="ltx_text">where <math id="A5.p25.m3" class="ltx_Math" alttext="\Xi:=\sum_{i=1}^{m}c_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ξ</mi><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mi>c</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Xi:=\sum_{i=1}^{m}c_{i}</annotation></semantics></math> and <math id="A5.p25.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is a constant depending only on <math id="A5.p25.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, <math id="A5.p25.m6" class="ltx_Math" alttext="\{\mu_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mu_{i}\}</annotation></semantics></math>, and the moment constants (not on <math id="A5.p25.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>).
Hence</span></p>
<table id="A5.Ex606" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex606.m1" class="ltx_Math" alttext="\mathrm{Var}\!\Big(\prod_{i=1}^{m}X_{i}\Big)\ \leq\ \left\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}\right\|_{L_{2}}^{\,2}\ =\ O(\Xi^{2})\ =\ O\!\left(\Big(\sum_{i=1}^{m}\sqrt{f_{i}(n)}\Big)^{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:1.643em;" width="1.643em"><mi>Var</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.500em">)</mo></mrow></mrow><mo rspace="0.778em">≤</mo><msubsup><mrow><mo>‖</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>μ</mi><mi>i</mi></msub></mrow></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub><mn> 2</mn></msubsup><mo rspace="0.778em">=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ξ</mi><mn>2</mn></msup><mo rspace="0.500em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.778em">=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\!\Big(\prod_{i=1}^{m}X_{i}\Big)\ \leq\ \left\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mu_{i}\right\|_{L_{2}}^{\,2}\ =\ O(\Xi^{2})\ =\ O\!\left(\Big(\sum_{i=1}^{m}\sqrt{f_{i}(n)}\Big)^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p25.3" class="ltx_p"><span id="A5.p25.3.1" class="ltx_text">Since <math id="A5.p25.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is fixed, <math id="A5.p25.m9" class="ltx_Math" alttext="(\sum_{i=1}^{m}\sqrt{f_{i}})^{2}\leq m^{2}\max_{i}f_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msqrt><msub><mi>f</mi><mi>i</mi></msub></msqrt></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><msup><mi>m</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>max</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>f</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(\sum_{i=1}^{m}\sqrt{f_{i}})^{2}\leq m^{2}\max_{i}f_{i}</annotation></semantics></math>, giving the claimed bound.
∎</span></p>
</div>
</div>
<div id="Thmcorollary1" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmcorollary1.2" class="ltx_text ltx_font_bold">Corollary 1</span></span><span id="Thmcorollary1.3" class="ltx_text ltx_font_bold"> </span>(Higher moments of the centered product)<span id="Thmcorollary1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmcorollary1.p1" class="ltx_para">
<p id="Thmcorollary1.p1.1" class="ltx_p"><span id="Thmcorollary1.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmcorollary1.p1.m1" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>. Under the hypotheses of Lemma <a href="#Thmlemma36" title="Lemma 36 (Variance of general product). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>, then</span></p>
<table id="A5.Ex607" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex607.m1" class="ltx_Math" alttext="\Big\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mathbb{E}[X_{i}]\Big\|_{L_{2p}}\;\leq\;C_{p,m}\sum_{\emptyset\neq S\subseteq[m]}\ \Big(\prod_{j\in S^{c}}|\mathbb{E}[X_{j}]|\Big)\ \prod_{i\in S}\sqrt{f_{i}}\;=\;o(1)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><msub><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><msub><mi>C</mi><mrow><mi>p</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi mathvariant="normal">∅</mi><mo>≠</mo><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>∈</mo><msup><mi>S</mi><mi>c</mi></msup></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.667em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msqrt><msub><mi>f</mi><mi>i</mi></msub></msqrt></mrow></mrow></mrow></mrow><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Big\|\prod_{i=1}^{m}X_{i}-\prod_{i=1}^{m}\mathbb{E}[X_{i}]\Big\|_{L_{2p}}\;\leq\;C_{p,m}\sum_{\emptyset\neq S\subseteq[m]}\ \Big(\prod_{j\in S^{c}}|\mathbb{E}[X_{j}]|\Big)\ \prod_{i\in S}\sqrt{f_{i}}\;=\;o(1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmcorollary1.p1.2" class="ltx_p"><span id="Thmcorollary1.p1.2.1" class="ltx_text ltx_font_italic">and hence <math id="Thmcorollary1.p1.m2" class="ltx_Math" alttext="\mathbb{E}\big|\prod_{i=1}^{m}X_{i}-\mathbb{E}\prod_{i=1}^{m}X_{i}\big|^{2p}=o(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msubsup><mo lspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msup></mrow><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\big|\prod_{i=1}^{m}X_{i}-\mathbb{E}\prod_{i=1}^{m}X_{i}\big|^{2p}=o(1)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmlemma37" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma37.2" class="ltx_text ltx_font_bold">Lemma 37</span></span><span id="Thmlemma37.3" class="ltx_text ltx_font_bold"> </span>(Expectation of Product vs. Product of Expectations)<span id="Thmlemma37.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma37.p1" class="ltx_para">
<p id="Thmlemma37.p1.1" class="ltx_p"><span id="Thmlemma37.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmlemma37.p1.m1" class="ltx_Math" alttext="k\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k\geq 2</annotation></semantics></math>. Let <math id="Thmlemma37.p1.m2" class="ltx_Math" alttext="X_{1},\dots,X_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">X_{1},\dots,X_{k}</annotation></semantics></math> be random variables. Assume:</span></p>
<ol id="A5.I1" class="ltx_enumerate">
<li id="A5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A5.I1.i1.p1" class="ltx_para">
<p id="A5.I1.i1.p1.1" class="ltx_p"><span id="A5.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">Uniformly bounded means: </span><math id="A5.I1.i1.p1.m1" class="ltx_Math" alttext="\sup_{n,i}|\mathbb{E}[X_{i}]|\leq M&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mi>n</mi><mo>,</mo><mi>i</mi></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mi>M</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sup_{n,i}|\mathbb{E}[X_{i}]|\leq M&lt;\infty</annotation></semantics></math><span id="A5.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A5.I1.i2.p1" class="ltx_para">
<p id="A5.I1.i2.p1.1" class="ltx_p"><span id="A5.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">Vanishing variances: </span><math id="A5.I1.i2.p1.m1" class="ltx_Math" alttext="\mathrm{Var}(X_{i})=f_{i}(n)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(X_{i})=f_{i}(n)</annotation></semantics></math><span id="A5.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="A5.I1.i2.p1.m2" class="ltx_Math" alttext="f_{i}(n)\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{i}(n)\to 0</annotation></semantics></math><span id="A5.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> as </span><math id="A5.I1.i2.p1.m3" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math><span id="A5.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> for each </span><math id="A5.I1.i2.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A5.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A5.I1.i3.p1" class="ltx_para">
<p id="A5.I1.i3.p1.1" class="ltx_p"><span id="A5.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">Moment control up to order </span><math id="A5.I1.i3.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="A5.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">: For each </span><math id="A5.I1.i3.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="A5.I1.i3.p1.1.3" class="ltx_text ltx_font_italic"> and every </span><math id="A5.I1.i3.p1.m3" class="ltx_Math" alttext="p\in\{2,\dots,k\}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">p\in\{2,\dots,k\}</annotation></semantics></math><span id="A5.I1.i3.p1.1.4" class="ltx_text ltx_font_italic">,</span></p>
<table id="A5.Ex608" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex608.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left|X_{i}-\mathbb{E}[X_{i}]\right|^{p}\right]\ \leq\ C_{p}\;\mathrm{Var}(X_{i})^{p/2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>|</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mi>p</mi></msup><mo rspace="0.500em">]</mo></mrow></mrow><mo rspace="0.778em">≤</mo><mrow><msub><mi>C</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left|X_{i}-\mathbb{E}[X_{i}]\right|^{p}\right]\ \leq\ C_{p}\;\mathrm{Var}(X_{i})^{p/2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.I1.i3.p1.2" class="ltx_p"><span id="A5.I1.i3.p1.2.1" class="ltx_text ltx_font_italic">with constants </span><math id="A5.I1.i3.p1.m4" class="ltx_Math" alttext="C_{p}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>p</mi></msub><annotation encoding="application/x-tex">C_{p}</annotation></semantics></math><span id="A5.I1.i3.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="Thmlemma37.p1.2" class="ltx_p"><span id="Thmlemma37.p1.2.1" class="ltx_text ltx_font_italic">Then for finite <math id="Thmlemma37.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, we have:</span></p>
<table id="A5.Ex609" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex609.m1" class="ltx_Math" alttext="\left|\,\mathbb{E}\!\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\,\right|\ =\ O\!\left(\left(\sum_{i=1}^{k}\sqrt{f_{i}(n)}\right)^{2}\right)=O\!\left(\max_{1\leq i\leq k}f_{i}(n)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.170em">|</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow></mrow><mo rspace="0.500em">|</mo></mrow><mo rspace="0.778em">=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>k</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\,\mathbb{E}\!\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\,\right|\ =\ O\!\left(\left(\sum_{i=1}^{k}\sqrt{f_{i}(n)}\right)^{2}\right)=O\!\left(\max_{1\leq i\leq k}f_{i}(n)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.8" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p26" class="ltx_para">
<p id="A5.p26.1" class="ltx_p"><span id="A5.p26.1.1" class="ltx_text">Set <math id="A5.p26.m1" class="ltx_Math" alttext="\Delta_{i}:=X_{i}-\mathbb{E}[X_{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>:=</mo><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{i}:=X_{i}-\mathbb{E}[X_{i}]</annotation></semantics></math>, so <math id="A5.p26.m2" class="ltx_Math" alttext="\mathbb{E}\Delta_{i}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}\Delta_{i}=0</annotation></semantics></math>, <math id="A5.p26.m3" class="ltx_Math" alttext="\mathrm{Var}(X_{i})=\mathrm{Var}(\Delta_{i})=f_{i}(n)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(X_{i})=\mathrm{Var}(\Delta_{i})=f_{i}(n)</annotation></semantics></math>, and by assumption</span></p>
<table id="A5.Ex610" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex610.m1" class="ltx_math_unparsed" alttext="\left\|\Delta_{i}\right\|_{L_{p}}:=\left(\mathbb{E}\left[|\Delta_{i}|^{p}\right]\right)^{1/p}\ \leq\ C_{p}^{1/p}\,f_{i}(n)^{1/2},\qquad p=2,\dots,k." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><mo>:=</mo><msup><mrow><mo>(</mo><mi>𝔼</mi><mrow><mo>[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi></msup><mo>]</mo></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msup><mo rspace="0.778em">≤</mo><msubsup><mi>C</mi><mi>p</mi><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msubsup><msub><mi>f</mi><mi>i</mi></msub><msup><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="2.167em">,</mo><mi>p</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|\Delta_{i}\right\|_{L_{p}}:=\left(\mathbb{E}\left[|\Delta_{i}|^{p}\right]\right)^{1/p}\ \leq\ C_{p}^{1/p}\,f_{i}(n)^{1/2},\qquad p=2,\dots,k.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p26.2" class="ltx_p"><span id="A5.p26.2.1" class="ltx_text">Using the multilinearity of expectation,</span></p>
<table id="A5.Ex611" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex611.m1" class="ltx_Math" alttext="\prod_{i=1}^{k}X_{i}=\prod_{i=1}^{k}\left(\mathbb{E}[X_{i}]+\Delta_{i}\right)=\sum_{S\subseteq[k]}\left(\prod_{i\in S}\Delta_{i}\right)\left(\prod_{j\notin S}\mathbb{E}[X_{j}]\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mo>(</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>j</mi><mo>∉</mo><mi>S</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{k}X_{i}=\prod_{i=1}^{k}\left(\mathbb{E}[X_{i}]+\Delta_{i}\right)=\sum_{S\subseteq[k]}\left(\prod_{i\in S}\Delta_{i}\right)\left(\prod_{j\notin S}\mathbb{E}[X_{j}]\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p26.3" class="ltx_p"><span id="A5.p26.3.1" class="ltx_text">Thus,</span></p>
<table id="A5.Ex612" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex612.m1" class="ltx_Math" alttext="\prod_{i=1}^{k}X_{i}-\prod_{i=1}^{k}\mathbb{E}[X_{i}]=\sum_{\emptyset\neq S\subseteq[k]}\left[\prod_{i\in S}\Delta_{i}\right]\prod_{j\notin S}\mathbb{E}[X_{j}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi mathvariant="normal">∅</mi><mo>≠</mo><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>∉</mo><mi>S</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{k}X_{i}-\prod_{i=1}^{k}\mathbb{E}[X_{i}]=\sum_{\emptyset\neq S\subseteq[k]}\left[\prod_{i\in S}\Delta_{i}\right]\prod_{j\notin S}\mathbb{E}[X_{j}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p26.4" class="ltx_p"><span id="A5.p26.4.1" class="ltx_text">Then taking the expectation and noting that <math id="A5.p26.m4" class="ltx_Math" alttext="\prod_{j\notin S}\mathbb{E}[X_{j}]" display="inline" intent=":literal"><semantics><mrow><msub><mo>∏</mo><mrow><mi>j</mi><mo>∉</mo><mi>S</mi></mrow></msub><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\prod_{j\notin S}\mathbb{E}[X_{j}]</annotation></semantics></math> is a constant, we get</span></p>
<table id="A5.Ex613" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex613.m1" class="ltx_Math" alttext="\mathbb{E}\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}[X_{i}]=\sum_{\emptyset\neq S\subseteq[k]}\mathbb{E}\left[\prod_{i\in S}\Delta_{i}\right]\prod_{j\notin S}\mathbb{E}[X_{j}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">∅</mi><mo>≠</mo><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>∉</mo><mi>S</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}[X_{i}]=\sum_{\emptyset\neq S\subseteq[k]}\mathbb{E}\left[\prod_{i\in S}\Delta_{i}\right]\prod_{j\notin S}\mathbb{E}[X_{j}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p26.5" class="ltx_p"><span id="A5.p26.5.1" class="ltx_text">If <math id="A5.p26.m5" class="ltx_Math" alttext="S=\{\ell\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{\ell\}</annotation></semantics></math> then <math id="A5.p26.m6" class="ltx_Math" alttext="\mathbb{E}\left[\prod_{i\in S}\Delta_{i}\right]=\mathbb{E}[\Delta_{\ell}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mo lspace="0em">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></msub><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\prod_{i\in S}\Delta_{i}\right]=\mathbb{E}[\Delta_{\ell}]=0</annotation></semantics></math>. Hence every singleton term vanishes exactly, and the sum begins at <math id="A5.p26.m7" class="ltx_Math" alttext="|S|=2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|S|=2</annotation></semantics></math>. From the bounded means assumption,</span></p>
<table id="A5.Ex614" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex614.m1" class="ltx_Math" alttext="\left|\prod_{j\notin S}\mathbb{E}[X_{j}]\right|\ \leq\ M^{\,k-|S|},\qquad\forall S\subseteq[k]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>j</mi><mo>∉</mo><mi>S</mi></mrow></munder><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>j</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo></mrow><mo rspace="0.778em">≤</mo><msup><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>S</mi></mrow><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\prod_{j\notin S}\mathbb{E}[X_{j}]\right|\ \leq\ M^{\,k-|S|},\qquad\forall S\subseteq[k].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p26.6" class="ltx_p"><span id="A5.p26.6.1" class="ltx_text">Fix a nonempty subset <math id="A5.p26.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with <math id="A5.p26.m9" class="ltx_Math" alttext="|S|=m\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>m</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|S|=m\geq 2</annotation></semantics></math>. By generalized Hölder with all exponents equal to <math id="A5.p26.m10" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> (so <math id="A5.p26.m11" class="ltx_Math" alttext="\sum_{i\in S}\tfrac{1}{m}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></msub><mfrac><mn>1</mn><mi>m</mi></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i\in S}\tfrac{1}{m}=1</annotation></semantics></math>),</span></p>
<table id="A5.Ex615" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex615.m1" class="ltx_Math" alttext="\left|\mathbb{E}\!\left[\prod_{i\in S}\Delta_{i}\right]\right|\leq\prod_{i\in S}\|\Delta_{i}\|_{L_{m}}\leq\prod_{i\in S}\left(C_{m}^{1/m}\,f_{i}(n)^{1/2}\right)=C_{m}\prod_{i\in S}\sqrt{f_{i}(n)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>|</mo></mrow><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>m</mi></msub></msub></mrow><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><mrow><mo>(</mo><mrow><msubsup><mi>C</mi><mi>m</mi><mrow><mn>1</mn><mo>/</mo><mi>m</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}\!\left[\prod_{i\in S}\Delta_{i}\right]\right|\leq\prod_{i\in S}\|\Delta_{i}\|_{L_{m}}\leq\prod_{i\in S}\left(C_{m}^{1/m}\,f_{i}(n)^{1/2}\right)=C_{m}\prod_{i\in S}\sqrt{f_{i}(n)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p26.7" class="ltx_p"><span id="A5.p26.7.1" class="ltx_text">Therefore, for every <math id="A5.p26.m12" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> with <math id="A5.p26.m13" class="ltx_Math" alttext="|S|=m\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>m</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|S|=m\geq 2</annotation></semantics></math>,</span></p>
<table id="A5.Ex616" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex616.m1" class="ltx_Math" alttext="\left|\mathbb{E}\!\left[\prod_{i\in S}\Delta_{i}\right]\prod_{j\notin S}\mathbb{E}X_{j}\right|\leq M^{\,k-m}\,C_{m}\prod_{i\in S}\sqrt{f_{i}(n)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>∉</mo><mi>S</mi></mrow></munder><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>j</mi></msub></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msup><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}\!\left[\prod_{i\in S}\Delta_{i}\right]\prod_{j\notin S}\mathbb{E}X_{j}\right|\leq M^{\,k-m}\,C_{m}\prod_{i\in S}\sqrt{f_{i}(n)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p27" class="ltx_para">
<p id="A5.p27.1" class="ltx_p"><span id="A5.p27.1.1" class="ltx_text">Let <math id="A5.p27.m1" class="ltx_Math" alttext="c_{i}:=\sqrt{f_{i}(n)}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>:=</mo><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}:=\sqrt{f_{i}(n)}\geq 0</annotation></semantics></math>. Denote by</span></p>
<table id="A5.Ex617" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex617.m1" class="ltx_Math" alttext="e_{m}(c_{1},\dots,c_{k}):=\sum_{\begin{subarray}{c}S\subseteq[k]\\
|S|=m\end{subarray}}\ \prod_{i\in S}c_{i}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>m</mi></mrow></mtd></mtr></mtable></munder><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>∈</mo><mi>S</mi></mrow></munder><msub><mi>c</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{m}(c_{1},\dots,c_{k}):=\sum_{\begin{subarray}{c}S\subseteq[k]\\
|S|=m\end{subarray}}\ \prod_{i\in S}c_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.2" class="ltx_p"><span id="A5.p27.2.1" class="ltx_text">the <math id="A5.p27.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>-th elementary symmetric polynomial. Summing the bound from, we get</span></p>
<table id="A5.Ex618" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex618.m1" class="ltx_Math" alttext="\left|\,\mathbb{E}\!\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\,\right|\leq\sum_{m=2}^{k}M^{\,k-m}C_{m}\,e_{m}(c_{1},\dots,c_{k})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.170em">|</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>|</mo></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>k</mi></munderover><mrow><msup><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\,\mathbb{E}\!\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\,\right|\leq\sum_{m=2}^{k}M^{\,k-m}C_{m}\,e_{m}(c_{1},\dots,c_{k}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.3" class="ltx_p"><span id="A5.p27.3.1" class="ltx_text">Let <math id="A5.p27.m3" class="ltx_Math" alttext="M_{\star}:=\max_{2\leq m\leq k}M^{\,k-m}C_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mo>⋆</mo></msub><mo>:=</mo><mrow><mrow><msub><mi>max</mi><mrow><mn>2</mn><mo>≤</mo><mi>m</mi><mo>≤</mo><mi>k</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msup><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>m</mi></msub></mrow></mrow><annotation encoding="application/x-tex">M_{\star}:=\max_{2\leq m\leq k}M^{\,k-m}C_{m}</annotation></semantics></math>. Since <math id="A5.p27.m4" class="ltx_Math" alttext="e_{m}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mi>m</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e_{m}\geq 0</annotation></semantics></math> for <math id="A5.p27.m5" class="ltx_Math" alttext="c_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}\geq 0</annotation></semantics></math>,</span></p>
<table id="A5.Ex619" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex619.m1" class="ltx_Math" alttext="\sum_{m=2}^{k}M^{\,k-m}C_{m}\,e_{m}\ \leq\ M_{\star}\sum_{m=2}^{k}e_{m}(c_{1},\dots,c_{k})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>k</mi></munderover><mrow><msup><mi>M</mi><mrow><mi>k</mi><mo>−</mo><mi>m</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>m</mi></msub></mrow></mrow><mo rspace="0.778em">≤</mo><mrow><msub><mi>M</mi><mo>⋆</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>e</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{m=2}^{k}M^{\,k-m}C_{m}\,e_{m}\ \leq\ M_{\star}\sum_{m=2}^{k}e_{m}(c_{1},\dots,c_{k}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.4" class="ltx_p"><span id="A5.p27.4.1" class="ltx_text">Recall the identity</span></p>
<table id="A5.Ex620" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex620.m1" class="ltx_Math" alttext="\prod_{i=1}^{k}(1+c_{i})=\sum_{m=0}^{k}e_{m}(c_{1},\dots,c_{k})=1+\sum_{m=1}^{k}e_{m}(c_{1},\dots,c_{k})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>e</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>e</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{k}(1+c_{i})=\sum_{m=0}^{k}e_{m}(c_{1},\dots,c_{k})=1+\sum_{m=1}^{k}e_{m}(c_{1},\dots,c_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.5" class="ltx_p"><span id="A5.p27.5.1" class="ltx_text">so that <math id="A5.p27.m6" class="ltx_Math" alttext="\sum_{m=2}^{k}e_{m}=\prod_{i=1}^{k}(1+c_{i})-1-\sum_{i=1}^{k}c_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>k</mi></msubsup><msub><mi>e</mi><mi>m</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><msub><mi>c</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{m=2}^{k}e_{m}=\prod_{i=1}^{k}(1+c_{i})-1-\sum_{i=1}^{k}c_{i}</annotation></semantics></math>. Hence</span></p>
<table id="A5.Ex621" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex621.m1" class="ltx_Math" alttext="\left|\,\mathbb{E}\!\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\,\right|\leq M_{\star}\!\left(\prod_{i=1}^{k}(1+c_{i})-1-\sum_{i=1}^{k}c_{i}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.170em">|</mo><mrow><mrow><mpadded style="width:0.497em;" width="0.497em"><mi>𝔼</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><msub><mi>M</mi><mo>⋆</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>c</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\,\mathbb{E}\!\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\,\right|\leq M_{\star}\!\left(\prod_{i=1}^{k}(1+c_{i})-1-\sum_{i=1}^{k}c_{i}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.6" class="ltx_p"><span id="A5.p27.6.1" class="ltx_text">Let <math id="A5.p27.m7" class="ltx_Math" alttext="\Xi:=\sum_{i=1}^{k}c_{i}\to 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ξ</mi><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Xi:=\sum_{i=1}^{k}c_{i}\to 0</annotation></semantics></math> as <math id="A5.p27.m8" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>. Since <math id="A5.p27.m9" class="ltx_Math" alttext="\log(1+u)\leq u" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">\log(1+u)\leq u</annotation></semantics></math> for <math id="A5.p27.m10" class="ltx_Math" alttext="u\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u\geq 0</annotation></semantics></math>,</span></p>
<table id="A5.Ex622" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex622.m1" class="ltx_Math" alttext="\prod_{i=1}^{k}(1+c_{i})=\exp\left(\sum_{i=1}^{k}\log(1+c_{i})\right)\leq\exp(\Xi)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{i=1}^{k}(1+c_{i})=\exp\left(\sum_{i=1}^{k}\log(1+c_{i})\right)\leq\exp(\Xi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.7" class="ltx_p"><span id="A5.p27.7.1" class="ltx_text">Thus, the difference is at most <math id="A5.p27.m11" class="ltx_Math" alttext="M_{\star}(e^{\Xi}-1-\Xi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mo>⋆</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup><mo>−</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">Ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{\star}(e^{\Xi}-1-\Xi)</annotation></semantics></math>.
By Taylor’s theorem, <math id="A5.p27.m12" class="ltx_Math" alttext="e^{\Xi}=1+\Xi+\frac{1}{2}\Xi^{2}e^{\xi}" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi mathvariant="normal">Ξ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Ξ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>ξ</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">e^{\Xi}=1+\Xi+\frac{1}{2}\Xi^{2}e^{\xi}</annotation></semantics></math> for some <math id="A5.p27.m13" class="ltx_Math" alttext="\xi\in[0,\Xi]" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">Ξ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\xi\in[0,\Xi]</annotation></semantics></math>, so <math id="A5.p27.m14" class="ltx_Math" alttext="e^{\Xi}-1-\Xi=\frac{1}{2}\Xi^{2}e^{\xi}\leq\frac{1}{2}\Xi^{2}e^{\Xi}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup><mo>−</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">Ξ</mi></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Ξ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi>ξ</mi></msup></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Ξ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup></mrow></mrow><annotation encoding="application/x-tex">e^{\Xi}-1-\Xi=\frac{1}{2}\Xi^{2}e^{\xi}\leq\frac{1}{2}\Xi^{2}e^{\Xi}</annotation></semantics></math> (since <math id="A5.p27.m15" class="ltx_Math" alttext="\xi\leq\Xi" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>≤</mo><mi mathvariant="normal">Ξ</mi></mrow><annotation encoding="application/x-tex">\xi\leq\Xi</annotation></semantics></math> and <math id="A5.p27.m16" class="ltx_Math" alttext="e^{\xi}\leq e^{\Xi}" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mi>ξ</mi></msup><mo>≤</mo><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup></mrow><annotation encoding="application/x-tex">e^{\xi}\leq e^{\Xi}</annotation></semantics></math>).
Therefore,</span></p>
<table id="A5.Ex623" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex623.m1" class="ltx_Math" alttext="\left|\mathbb{E}\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\right|\leq\frac{M_{\star}}{2}\Xi^{2}e^{\Xi}=O(\Xi^{2})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><msub><mi>X</mi><mi>i</mi></msub></mrow><mo>]</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><msub><mi>M</mi><mo>⋆</mo></msub><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Ξ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ξ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\mathbb{E}\left[\prod_{i=1}^{k}X_{i}\right]-\prod_{i=1}^{k}\mathbb{E}X_{i}\right|\leq\frac{M_{\star}}{2}\Xi^{2}e^{\Xi}=O(\Xi^{2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p27.8" class="ltx_p"><span id="A5.p27.8.1" class="ltx_text">as <math id="A5.p27.m17" class="ltx_Math" alttext="\Xi\to 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ξ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Xi\to 0</annotation></semantics></math> and <math id="A5.p27.m18" class="ltx_Math" alttext="e^{\Xi}\to 1" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mi mathvariant="normal">Ξ</mi></msup><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">e^{\Xi}\to 1</annotation></semantics></math>. Since <math id="A5.p27.m19" class="ltx_Math" alttext="\Xi=O\left(\sum_{i=1}^{k}\sqrt{f_{i}(n)}\right)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ξ</mi><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><msqrt><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Xi=O\left(\sum_{i=1}^{k}\sqrt{f_{i}(n)}\right)</annotation></semantics></math>, we get the result.
∎</span></p>
</div>
</div>
<div id="Thmlemma38" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma38.2" class="ltx_text ltx_font_bold">Lemma 38</span></span><span id="Thmlemma38.3" class="ltx_text ltx_font_bold"> </span>(Moment preservation under monomial <math id="Thmlemma38.m1" class="ltx_Math" alttext="\leftrightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↔</mo><annotation encoding="application/x-tex">\leftrightarrow</annotation></semantics></math> Hermite change of basis)<span id="Thmlemma38.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma38.p1" class="ltx_para">
<p id="Thmlemma38.p1.1" class="ltx_p"><span id="Thmlemma38.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmlemma38.p1.m1" class="ltx_Math" alttext="M\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">M\in\mathbb{N}</annotation></semantics></math> and degree <math id="Thmlemma38.p1.m2" class="ltx_Math" alttext="r\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">r\in\mathbb{N}</annotation></semantics></math>. Let</span></p>
<table id="A5.Ex624" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex624.m1" class="ltx_math_unparsed" alttext="\mathcal{M}:=\{x^{\gamma}:\ \gamma\in\mathbb{N}^{M},\ |\gamma|\leq r\},\qquad\mathcal{H}:=\{{\bm{H}}_{\alpha}:\ \alpha\in\mathbb{N}^{M},\ |\alpha|\leq r\}," display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><msup><mi>x</mi><mi>γ</mi></msup><mo lspace="0.278em" rspace="0.778em">:</mo><mi>γ</mi><mo>∈</mo><msup><mi>ℕ</mi><mi>M</mi></msup><mo rspace="0.667em">,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>γ</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>r</mi><mo stretchy="false">}</mo></mrow><mo rspace="2.167em">,</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0.278em" rspace="0.778em">:</mo><mi>α</mi><mo>∈</mo><msup><mi>ℕ</mi><mi>M</mi></msup><mo rspace="0.667em">,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>α</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>r</mi><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{M}:=\{x^{\gamma}:\ \gamma\in\mathbb{N}^{M},\ |\gamma|\leq r\},\qquad\mathcal{H}:=\{{\bm{H}}_{\alpha}:\ \alpha\in\mathbb{N}^{M},\ |\alpha|\leq r\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma38.p1.2" class="ltx_p"><span id="Thmlemma38.p1.2.1" class="ltx_text ltx_font_italic">with <math id="Thmlemma38.p1.m3" class="ltx_Math" alttext="{\bm{H}}_{\alpha}(x)=\prod_{j=1}^{M}H_{\alpha_{j}}(x_{j})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐇</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mrow><msub><mi>H</mi><msub><mi>α</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{H}}_{\alpha}(x)=\prod_{j=1}^{M}H_{\alpha_{j}}(x_{j})</annotation></semantics></math> the probabilists’ Hermite basis.
For any (random) coefficients <math id="Thmlemma38.p1.m4" class="ltx_Math" alttext="\{a_{\gamma}\}_{|\gamma|\leq r}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mi>γ</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>γ</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\{a_{\gamma}\}_{|\gamma|\leq r}</annotation></semantics></math> define the random polynomial
<math id="Thmlemma38.p1.m5" class="ltx_Math" alttext="P(x)=\sum_{|\gamma|\leq r}a_{\gamma}\,x^{\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>γ</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></msub><mrow><msub><mi>a</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>γ</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">P(x)=\sum_{|\gamma|\leq r}a_{\gamma}\,x^{\gamma}</annotation></semantics></math>. Then there is a deterministic, invertible matrix
<math id="Thmlemma38.p1.m6" class="ltx_Math" alttext="T=T(M,r)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T=T(M,r)</annotation></semantics></math> such that the Hermite coefficients <math id="Thmlemma38.p1.m7" class="ltx_Math" alttext="c=\{c_{\alpha}\}_{|\alpha|\leq r}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">c=\{c_{\alpha}\}_{|\alpha|\leq r}</annotation></semantics></math> in
<math id="Thmlemma38.p1.m8" class="ltx_Math" alttext="P(x)=\sum_{|\alpha|\leq r}c_{\alpha}\,{\bm{H}}_{\alpha}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></msub><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐇</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P(x)=\sum_{|\alpha|\leq r}c_{\alpha}\,{\bm{H}}_{\alpha}(x)</annotation></semantics></math> satisfy</span></p>
<table id="A5.Ex625" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex625.m1" class="ltx_Math" alttext="c\;=\;T\,a." display="block" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mi>T</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c\;=\;T\,a.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma38.p1.3" class="ltx_p"><span id="Thmlemma38.p1.3.1" class="ltx_text ltx_font_italic">Consequently, for any <math id="Thmlemma38.p1.m9" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>,</span></p>
<table id="A5.Ex626" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex626.m1" class="ltx_Math" alttext="\|c_{\alpha}\|_{L_{p}}\;\leq\;\sum_{|\gamma|\leq r}|T_{\alpha\gamma}|\,\|a_{\gamma}\|_{L_{p}}\quad\text{for all }\alpha," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><mo lspace="0.558em" rspace="0.391em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>γ</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><mrow><mo stretchy="false">|</mo><msub><mi>T</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>a</mi><mi>γ</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|c_{\alpha}\|_{L_{p}}\;\leq\;\sum_{|\gamma|\leq r}|T_{\alpha\gamma}|\,\|a_{\gamma}\|_{L_{p}}\quad\text{for all }\alpha,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma38.p1.4" class="ltx_p"><span id="Thmlemma38.p1.4.1" class="ltx_text ltx_font_italic">so if each <math id="Thmlemma38.p1.m10" class="ltx_Math" alttext="a_{\gamma}\in L_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>γ</mi></msub><mo>∈</mo><msub><mi>L</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">a_{\gamma}\in L_{p}</annotation></semantics></math> then each <math id="Thmlemma38.p1.m11" class="ltx_Math" alttext="c_{\alpha}\in L_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>∈</mo><msub><mi>L</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">c_{\alpha}\in L_{p}</annotation></semantics></math>.
Moreover, since <math id="Thmlemma38.p1.m12" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is invertible, the converse also holds: if each <math id="Thmlemma38.p1.m13" class="ltx_Math" alttext="c_{\alpha}\in L_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>α</mi></msub><mo>∈</mo><msub><mi>L</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">c_{\alpha}\in L_{p}</annotation></semantics></math> then each
<math id="Thmlemma38.p1.m14" class="ltx_Math" alttext="a_{\gamma}\in L_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>γ</mi></msub><mo>∈</mo><msub><mi>L</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">a_{\gamma}\in L_{p}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A5.9" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p28" class="ltx_para">
<p id="A5.p28.1" class="ltx_p"><span id="A5.p28.1.1" class="ltx_text">In one dimension, each monomial admits a finite Hermite expansion
<math id="A5.p28.m1" class="ltx_Math" alttext="x^{m}=\sum_{j=0}^{\lfloor m/2\rfloor}t_{m,j}\,H_{m-2j}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>m</mi></msup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mo stretchy="false">⌊</mo><mrow><mi>m</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">⌋</mo></mrow></msubsup><mrow><msub><mi>t</mi><mrow><mi>m</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>m</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{m}=\sum_{j=0}^{\lfloor m/2\rfloor}t_{m,j}\,H_{m-2j}(x)</annotation></semantics></math> with deterministic coefficients
<math id="A5.p28.m2" class="ltx_Math" alttext="t_{m,j}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mrow><mi>m</mi><mo>,</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">t_{m,j}</annotation></semantics></math>; in several dimensions, take tensor products to obtain
<math id="A5.p28.m3" class="ltx_Math" alttext="x^{\gamma}=\sum_{|\alpha|\leq|\gamma|}T_{\alpha\gamma}\,{\bm{H}}_{\alpha}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>γ</mi></msup><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>γ</mi><mo stretchy="false">|</mo></mrow></mrow></msub><mrow><msub><mi>T</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{\gamma}=\sum_{|\alpha|\leq|\gamma|}T_{\alpha\gamma}\,{\bm{H}}_{\alpha}(x)</annotation></semantics></math>.
Ordering multi-indices by total degree yields a block upper-triangular, deterministic,
invertible matrix <math id="A5.p28.m4" class="ltx_Math" alttext="T=T(M,r)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T=T(M,r)</annotation></semantics></math>. Linearity gives <math id="A5.p28.m5" class="ltx_Math" alttext="c=Ta" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">c=Ta</annotation></semantics></math>. For <math id="A5.p28.m6" class="ltx_Math" alttext="p\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p\geq 1</annotation></semantics></math>, Minkowski’s inequality
yields
<math id="A5.p28.m7" class="ltx_Math" alttext="\|c_{\alpha}\|_{L_{p}}=\big\|\sum_{\gamma}T_{\alpha\gamma}a_{\gamma}\big\|_{L_{p}}\leq\sum_{\gamma}|T_{\alpha\gamma}|\,\|a_{\gamma}\|_{L_{p}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><mo>=</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mo lspace="0em">∑</mo><mi>γ</mi></msub><mrow><msub><mi>T</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>γ</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><mo rspace="0.111em">≤</mo><mrow><msub><mo rspace="0em">∑</mo><mi>γ</mi></msub><mrow><mrow><mo stretchy="false">|</mo><msub><mi>T</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>a</mi><mi>γ</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\|c_{\alpha}\|_{L_{p}}=\big\|\sum_{\gamma}T_{\alpha\gamma}a_{\gamma}\big\|_{L_{p}}\leq\sum_{\gamma}|T_{\alpha\gamma}|\,\|a_{\gamma}\|_{L_{p}}</annotation></semantics></math>,
so finiteness of all <math id="A5.p28.m8" class="ltx_Math" alttext="\|a_{\gamma}\|_{L_{p}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>a</mi><mi>γ</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><annotation encoding="application/x-tex">\|a_{\gamma}\|_{L_{p}}</annotation></semantics></math> implies finiteness of all <math id="A5.p28.m9" class="ltx_Math" alttext="\|c_{\alpha}\|_{L_{p}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><annotation encoding="application/x-tex">\|c_{\alpha}\|_{L_{p}}</annotation></semantics></math>.
Invertibility gives the converse using <math id="A5.p28.m10" class="ltx_Math" alttext="a=T^{-1}c" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">a=T^{-1}c</annotation></semantics></math> and the same argument with <math id="A5.p28.m11" class="ltx_Math" alttext="T^{-1}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">T^{-1}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Proof of Specific Cases and Overfitting</h2>

<section id="A6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.1 </span>Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Well-Specified Risk). ‣ 3.1 Well Specified Problem ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</h3>

<div id="A6.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS1.p1" class="ltx_para">
<p id="A6.SS1.p1.1" class="ltx_p"><span id="A6.SS1.p1.1.1" class="ltx_text">We set <math id="A6.SS1.p1.m1" class="ltx_Math" alttext="\alpha_{Z}=\alpha_{A}=\tilde{\alpha}_{Z}=\tilde{\alpha}_{A}=\alpha" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mi>α</mi><mi>A</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo>=</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">\alpha_{Z}=\alpha_{A}=\tilde{\alpha}_{Z}=\tilde{\alpha}_{A}=\alpha</annotation></semantics></math>, <math id="A6.SS1.p1.m2" class="ltx_Math" alttext="\tilde{\theta}=\theta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>=</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\tilde{\theta}=\theta</annotation></semantics></math>, <math id="A6.SS1.p1.m3" class="ltx_Math" alttext="\tilde{\tau}=\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mo>=</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\tilde{\tau}=\tau</annotation></semantics></math> in the above Theorem <a href="#Thmtheorem5" title="Theorem 5 (Generalization Risk). ‣ 3.4 General Theorem ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and note that it
greatly simplifies each term. Algebra shows that for <math id="A6.SS1.p1.m4" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math></span></p>
<table id="A6.Ex627" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex627.m1" class="ltx_Math" alttext="\text{Bias}=\tau_{\varepsilon}^{2}\frac{c}{1-c}\frac{\theta^{2}}{d(\theta^{2}+\tau^{2})},\quad\text{ Variance}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}+\tau_{\varepsilon}^{2}\frac{c}{1-c}\left[1-\frac{\theta^{2}}{d(\theta^{2}+\tau^{2})}\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext> Variance</mtext><mo>=</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}=\tau_{\varepsilon}^{2}\frac{c}{1-c}\frac{\theta^{2}}{d(\theta^{2}+\tau^{2})},\quad\text{ Variance}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}+\tau_{\varepsilon}^{2}\frac{c}{1-c}\left[1-\frac{\theta^{2}}{d(\theta^{2}+\tau^{2})}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex628" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex628.m1" class="ltx_Math" alttext="\text{Data Noise}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},\quad\text{ Target Alignment}=-2\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Data Noise</mtext><mo>=</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext> Target Alignment</mtext><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Data Noise}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},\quad\text{ Target Alignment}=-2\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p1.2" class="ltx_p"><span id="A6.SS1.p1.2.1" class="ltx_text">While for <math id="A6.SS1.p1.m5" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, we can first send <math id="A6.SS1.p1.m6" class="ltx_Math" alttext="d,n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">d,n\to\infty</annotation></semantics></math> and many terms become asymptotically <math id="A6.SS1.p1.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. In the end, we get that:</span></p>
<table id="A6.Ex629" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex629.m1" class="ltx_Math" alttext="\text{Bias}=\alpha^{2}{\theta}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(1-\frac{1}{c}\right)^{2}\left(\frac{\tau^{2}c}{\theta^{2}+\tau^{2}c}\right)^{2},\quad\text{Data Noise}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>Data Noise</mtext><mo>=</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}=\alpha^{2}{\theta}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(1-\frac{1}{c}\right)^{2}\left(\frac{\tau^{2}c}{\theta^{2}+\tau^{2}c}\right)^{2},\quad\text{Data Noise}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex630" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex630.m1" class="ltx_Math" alttext="\text{Variance}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}\frac{1}{c}+\alpha^{2}\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}\left(1-\frac{1}{c}\right)+\tau_{\varepsilon}^{2}\frac{1}{c-1}." display="block" intent=":literal"><semantics><mrow><mrow><mtext>Variance</mtext><mo>=</mo><mrow><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Variance}=\alpha^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}\frac{1}{c}+\alpha^{2}\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}\left(1-\frac{1}{c}\right)+\tau_{\varepsilon}^{2}\frac{1}{c-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex631" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex631.m1" class="ltx_Math" alttext="\text{ Target Alignment}=-2\alpha^{2}{\tau}^{2}\left(\left(1-\frac{1}{c}\right)\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\|{\bm{\beta}}_{*}\|^{2}\frac{1}{c}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mtext> Target Alignment</mtext><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{ Target Alignment}=-2\alpha^{2}{\tau}^{2}\left(\left(1-\frac{1}{c}\right)\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\|{\bm{\beta}}_{*}\|^{2}\frac{1}{c}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS1.p1.3" class="ltx_p"><span id="A6.SS1.p1.3.1" class="ltx_text">Adding these terms together, we see with simple algebra that many terms cancel or can be combined, establishing the stated formula.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2 (Misspecified). ‣ 3.2 Misspecified Case and no Covariate Shift ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</h3>

<div id="A6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p"><span id="A6.SS2.p1.1.1" class="ltx_text">We set <math id="A6.SS2.p1.m1" class="ltx_Math" alttext="\alpha_{Z}=\tilde{\alpha}_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{Z}=\tilde{\alpha}_{Z}</annotation></semantics></math>, <math id="A6.SS2.p1.m2" class="ltx_Math" alttext="\alpha_{A}=\tilde{\alpha}_{A}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>A</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{A}=\tilde{\alpha}_{A}</annotation></semantics></math>, <math id="A6.SS2.p1.m3" class="ltx_Math" alttext="\tilde{\theta}=\theta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>=</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\tilde{\theta}=\theta</annotation></semantics></math>, <math id="A6.SS2.p1.m4" class="ltx_Math" alttext="\tilde{\tau}=\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mo>=</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\tilde{\tau}=\tau</annotation></semantics></math>, and send <math id="A6.SS2.p1.m5" class="ltx_Math" alttext="d,n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">d,n\to\infty</annotation></semantics></math> in Theorem <a href="#Thmtheorem5" title="Theorem 5 (Generalization Risk). ‣ 3.4 General Theorem ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. Recall that <math id="A6.SS2.p1.m6" class="ltx_Math" alttext="\Delta_{c}=\alpha_{Z}-\frac{\alpha_{A}}{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>c</mi></msub><mo>=</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow></mrow><annotation encoding="application/x-tex">\Delta_{c}=\alpha_{Z}-\frac{\alpha_{A}}{c}</annotation></semantics></math> and <math id="A6.SS2.p1.m7" class="ltx_Math" alttext="\Delta_{1}=\alpha_{Z}-\alpha_{A}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta_{1}=\alpha_{Z}-\alpha_{A}</annotation></semantics></math>. Then some algebra shows that for <math id="A6.SS2.p1.m8" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>,</span></p>
<table id="A6.Ex632" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex632.m1" class="ltx_Math" alttext="\text{Bias}=\theta^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{1}^{2}\left(\frac{\tau^{2}}{\theta^{2}+\tau^{2}}\right)^{2},\quad\text{Data Noise}=\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><msup><mi>τ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>Data Noise</mtext><mo>=</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}=\theta^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{1}^{2}\left(\frac{\tau^{2}}{\theta^{2}+\tau^{2}}\right)^{2},\quad\text{Data Noise}=\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex633" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex633.m1" class="ltx_Math" alttext="\text{ Target Alignment}=-2\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}\ -2\alpha_{A}\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{1}\frac{\theta^{2}}{\theta^{2}+\tau^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mtext> Target Alignment</mtext><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{ Target Alignment}=-2\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}\ -2\alpha_{A}\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{1}\frac{\theta^{2}}{\theta^{2}+\tau^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex634" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex634.m1" class="ltx_Math" alttext="\text{Variance}=\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}+\tau^{2}_{\varepsilon}\frac{c}{1-c}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left[\frac{1}{1-c}\frac{\theta^{4}+\theta^{2}\tau^{2}c}{(\theta^{2}+\tau^{2})^{2}}\Delta_{1}^{2}+2\alpha_{A}\Delta_{1}\frac{\theta^{2}}{\theta^{2}+\tau^{2}}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mtext>Variance</mtext><mo>=</mo><mrow><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mi>θ</mi><mn>4</mn></msup><mo>+</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Variance}=\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}+\tau^{2}_{\varepsilon}\frac{c}{1-c}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left[\frac{1}{1-c}\frac{\theta^{4}+\theta^{2}\tau^{2}c}{(\theta^{2}+\tau^{2})^{2}}\Delta_{1}^{2}+2\alpha_{A}\Delta_{1}\frac{\theta^{2}}{\theta^{2}+\tau^{2}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.2" class="ltx_p"><span id="A6.SS2.p1.2.1" class="ltx_text">For <math id="A6.SS2.p1.m9" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, we have that</span></p>
<table id="A6.Ex635" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex635.m1" class="ltx_Math" alttext="\text{Bias}=\theta^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{c}^{2}\left(\frac{\tau^{2}c}{\theta^{2}+\tau^{2}c}\right)^{2},\quad\text{Data Noise}=\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>c</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>Data Noise</mtext><mo>=</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}=\theta^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{c}^{2}\left(\frac{\tau^{2}c}{\theta^{2}+\tau^{2}c}\right)^{2},\quad\text{Data Noise}=\alpha_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex636" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex636.m1" class="ltx_Math" alttext="\text{ Target Alignment}=-2\alpha_{A}^{2}\tau^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}-2\alpha_{A}\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{c}\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}," display="block" intent=":literal"><semantics><mrow><mrow><mtext> Target Alignment</mtext><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{ Target Alignment}=-2\alpha_{A}^{2}\tau^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}-2\alpha_{A}\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\Delta_{c}\frac{\theta^{2}}{\theta^{2}+\tau^{2}c},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex637" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex637.m1" class="ltx_Math" alttext="\text{Variance}=\alpha_{A}^{2}\tau^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}+\tau^{2}_{\varepsilon}\frac{1}{c-1}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{1-c}\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}\Delta_{c}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mtext>Variance</mtext><mo>=</mo><mrow><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>θ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>c</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Variance}=\alpha_{A}^{2}\tau^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}+\tau^{2}_{\varepsilon}\frac{1}{c-1}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{1-c}\frac{\theta^{2}}{\theta^{2}+\tau^{2}c}\Delta_{c}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS2.p1.3" class="ltx_p"><span id="A6.SS2.p1.3.1" class="ltx_text">We proceed by adding these terms together and the results follow from algebra.
∎</span></p>
</div>
</div>
</section>
<section id="A6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.3 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 3.3 Misspecified Target and Covariate Shift ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</h3>

<div id="A6.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS3.p1" class="ltx_para">
<p id="A6.SS3.p1.1" class="ltx_p"><span id="A6.SS3.p1.1.1" class="ltx_text">We set <math id="A6.SS3.p1.m1" class="ltx_Math" alttext="\tilde{\theta}=\theta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>=</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\tilde{\theta}=\theta</annotation></semantics></math> and <math id="A6.SS3.p1.m2" class="ltx_Math" alttext="\tilde{\tau}=\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mo>=</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\tilde{\tau}=\tau</annotation></semantics></math> in Theorem <a href="#Thmtheorem5" title="Theorem 5 (Generalization Risk). ‣ 3.4 General Theorem ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and have the regime of equal operator norm <math id="A6.SS3.p1.m3" class="ltx_Math" alttext="\theta^{2}=\gamma\tau^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{2}=\gamma\tau^{2}</annotation></semantics></math>. Since we are interested in the limit <math id="A6.SS3.p1.m4" class="ltx_Math" alttext="c\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">c\to\infty</annotation></semantics></math>, we only consider the overparameterized case <math id="A6.SS3.p1.m5" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>. We first take the limit <math id="A6.SS3.p1.m6" class="ltx_Math" alttext="d,n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">d,n\to\infty</annotation></semantics></math> and have that:</span></p>
<table id="A6.Ex638" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex638.m1" class="ltx_Math" alttext="\text{Bias}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\sqrt{\gamma}(\tilde{\alpha}_{Z}-\alpha_{Z})+\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{c\sqrt{\gamma}}{\gamma+c}\right)^{2},\quad\text{Data Noise}=\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msqrt><mi>γ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>γ</mi></msqrt></mrow><mrow><mi>γ</mi><mo>+</mo><mi>c</mi></mrow></mfrac></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>Data Noise</mtext><mo>=</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\sqrt{\gamma}(\tilde{\alpha}_{Z}-\alpha_{Z})+\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{c\sqrt{\gamma}}{\gamma+c}\right)^{2},\quad\text{Data Noise}=\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex639" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex639.m1" class="ltx_Math" alttext="\text{Target Alignment}=-2\tilde{\alpha}_{A}{\tau}^{2}\left(\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{\gamma}{\gamma+c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mtext>Target Alignment</mtext><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>γ</mi><mrow><mi>γ</mi><mo>+</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Target Alignment}=-2\tilde{\alpha}_{A}{\tau}^{2}\left(\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{\gamma}{\gamma+c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex640" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex640.m1" class="ltx_Math" alttext="\text{Variance}=\tau^{2}\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{(c-1)}\frac{\gamma}{\gamma+c}\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)^{2}+\tau_{\varepsilon}^{2}\left(\frac{1}{c-1}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mtext>Variance</mtext><mo>=</mo><mrow><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>γ</mi><mrow><mi>γ</mi><mo>+</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Variance}=\tau^{2}\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{(c-1)}\frac{\gamma}{\gamma+c}\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)^{2}+\tau_{\varepsilon}^{2}\left(\frac{1}{c-1}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.2" class="ltx_p"><span id="A6.SS3.p1.2.1" class="ltx_text">The rest follows from simple calculus: if <math id="A6.SS3.p1.m7" class="ltx_Math" alttext="\tilde{\alpha}_{Z}\neq\alpha_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>≠</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\alpha}_{Z}\neq\alpha_{Z}</annotation></semantics></math>, <math id="A6.SS3.p1.m8" class="ltx_Math" alttext="\gamma=\omega_{c}(1)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><msub><mi>ω</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=\omega_{c}(1)</annotation></semantics></math>, and <math id="A6.SS3.p1.m9" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{u}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{u}}\neq 0</annotation></semantics></math>, the bias will diverge and other terms are controlled, yielding catastrophic. If <math id="A6.SS3.p1.m10" class="ltx_Math" alttext="\tilde{\alpha}_{Z}=\alpha_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>=</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\alpha}_{Z}=\alpha_{Z}</annotation></semantics></math>, <math id="A6.SS3.p1.m11" class="ltx_Math" alttext="\omega_{c}(1)\leq\gamma\leq o_{c}(c^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ω</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>γ</mi><mo>≤</mo><mrow><msub><mi>o</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega_{c}(1)\leq\gamma\leq o_{c}(c^{2})</annotation></semantics></math>, and <math id="A6.SS3.p1.m12" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{u}}\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{u}}\neq 0</annotation></semantics></math>, a similar thing happens. In other cases, all of these terms are controlled and become finite values in the limit <math id="A6.SS3.p1.m13" class="ltx_Math" alttext="\lim_{c\to\infty}\mathcal{R}_{c}-\tau_{\varepsilon}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>c</mi></msub></mrow><mo>−</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\lim_{c\to\infty}\mathcal{R}_{c}-\tau_{\varepsilon}^{2}</annotation></semantics></math>, giving us tempered overfitting.</span></p>
<table id="A6.Ex641" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex641.m1" class="ltx_Math" alttext="\lim_{c\to\infty}\mathcal{R}_{c}=\begin{cases}\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}&{\bm{\beta}}\perp u\\[5.0pt]
\tau^{2}\left[\gamma\tilde{\alpha}_{Z}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\tilde{\alpha}_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}\right]&{\bm{\beta}}\not\perp u,\gamma=\Theta_{c}(1)\\[5.0pt]
\infty&amp;\alpha_{Z}\neq\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\gamma=\omega(1)\\[5.0pt]
\infty&amp;\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\omega(1)\leq\gamma\leq o(c^{2})\\[5.0pt]
\tau^{2}\left[\left(\frac{\phi}{(\phi+1)^{2}}\,\alpha_{Z}^{2}-2\tilde{\alpha}_{A}\alpha_{Z}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}\right]&amp;\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\gamma=\phi c^{2}\\[5.0pt]
\tau^{2}\left[(\alpha_{Z}^{2}-2\tilde{\alpha}_{A}\alpha_{Z})({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}\right]&amp;\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\gamma=\omega(c^{2})\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>c</mi></msub></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝜷</mi><mo>⟂</mo><mi>u</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>]</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝜷</mi><mo>⟂̸</mo><mi>u</mi></mrow><mo>,</mo><mrow><mi>γ</mi><mo>=</mo><mrow><msub><mi mathvariant="normal">Θ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∞</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>≠</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>u</mi></mrow><mo>,</mo><mrow><mi>γ</mi><mo>=</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∞</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>u</mi></mrow><mo>,</mo><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>γ</mi><mo>≤</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="false"><mfrac><mi>ϕ</mi><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>Z</mi><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>]</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>u</mi></mrow><mo>,</mo><mrow><mi>γ</mi><mo>=</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>c</mi><mn>2</mn></msup></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>α</mi><mi>Z</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>]</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><mo>,</mo><mrow><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>⟂̸</mo><mi>u</mi></mrow><mo>,</mo><mrow><mi>γ</mi><mo>=</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\lim_{c\to\infty}\mathcal{R}_{c}=\begin{cases}\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}&amp;{\bm{\beta}}\perp u\\[5.0pt]
\tau^{2}\left[\gamma\tilde{\alpha}_{Z}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\tilde{\alpha}_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}\right]&amp;{\bm{\beta}}\not\perp u,\gamma=\Theta_{c}(1)\\[5.0pt]
\infty&amp;\alpha_{Z}\neq\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\gamma=\omega(1)\\[5.0pt]
\infty&amp;\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\omega(1)\leq\gamma\leq o(c^{2})\\[5.0pt]
\tau^{2}\left[\left(\frac{\phi}{(\phi+1)^{2}}\,\alpha_{Z}^{2}-2\tilde{\alpha}_{A}\alpha_{Z}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}\right]&amp;\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\gamma=\phi c^{2}\\[5.0pt]
\tau^{2}\left[(\alpha_{Z}^{2}-2\tilde{\alpha}_{A}\alpha_{Z})({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}^{2}\|{\bm{\beta}}_{*}\|^{2}\right]&amp;\alpha_{Z}=\tilde{\alpha}_{Z},{\bm{\beta}}_{*}\not\perp u,\gamma=\omega(c^{2})\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.p1.3" class="ltx_p"><span id="A6.SS3.p1.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.4 </span>Proof of Theorem <a href="#Thmtheorem4" title="Theorem 4. ‣ Equal Frobenius Norm. ‣ 3.3 Misspecified Target and Covariate Shift ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</h3>

<div id="A6.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p1" class="ltx_para">
<p id="A6.SS4.p1.1" class="ltx_p"><span id="A6.SS4.p1.1.1" class="ltx_text">We start with the first part and assume that <math id="A6.SS4.p1.m1" class="ltx_Math" alttext="\alpha_{Z}\neq\tilde{\alpha}_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>≠</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{Z}\neq\tilde{\alpha}_{Z}</annotation></semantics></math>. Similarly, we have that <math id="A6.SS4.p1.m2" class="ltx_Math" alttext="\tilde{\theta}=\theta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>θ</mi><mo>~</mo></mover><mo>=</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\tilde{\theta}=\theta</annotation></semantics></math> and <math id="A6.SS4.p1.m3" class="ltx_Math" alttext="\tilde{\tau}=\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mo>=</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\tilde{\tau}=\tau</annotation></semantics></math> in Theorem <a href="#Thmtheorem5" title="Theorem 5 (Generalization Risk). ‣ 3.4 General Theorem ‣ 3 Theoretical Results ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. To achieve equal Frobenius norm, we set <math id="A6.SS4.p1.m4" class="ltx_Math" alttext="\theta^{2}=d\tau^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\theta^{2}=d\tau^{2}</annotation></semantics></math> and send <math id="A6.SS4.p1.m5" class="ltx_Math" alttext="d,n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">d,n\to\infty</annotation></semantics></math> so several terms would vanish.</span></p>
</div>
<div id="A6.SS4.p2" class="ltx_para">
<p id="A6.SS4.p2.1" class="ltx_p"><span id="A6.SS4.p2.1.1" class="ltx_text">In particular, for <math id="A6.SS4.p2.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, we have that</span></p>
<table id="A6.Ex642" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex642.m1" class="ltx_Math" alttext="\text{Bias}={\theta}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\tilde{\alpha}_{Z}-\alpha_{Z}+(\alpha_{Z}-\alpha_{A})\frac{\tau^{2}}{\theta^{2}+\tau^{2}}\right)^{2}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\sqrt{d}(\tilde{\alpha}_{Z}-\alpha_{Z})+(\alpha_{Z}-\alpha_{A})\frac{\sqrt{d}}{d+1}\right)^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>τ</mi><mn>2</mn></msup><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msqrt><mi>d</mi></msqrt><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}={\theta}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\tilde{\alpha}_{Z}-\alpha_{Z}+(\alpha_{Z}-\alpha_{A})\frac{\tau^{2}}{\theta^{2}+\tau^{2}}\right)^{2}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\sqrt{d}(\tilde{\alpha}_{Z}-\alpha_{Z})+(\alpha_{Z}-\alpha_{A})\frac{\sqrt{d}}{d+1}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p2.2" class="ltx_p"><span id="A6.SS4.p2.2.1" class="ltx_text">It is clear that this term becomes <math id="A6.SS4.p2.m2" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math> since the term inside the parentheses scales with <math id="A6.SS4.p2.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Note that the variance and data noise are non-negative, and target alignment is controlled. We have that <math id="A6.SS4.p2.m4" class="ltx_Math" alttext="\mathcal{R}_{c}=\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>c</mi></msub><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mathcal{R}_{c}=\infty</annotation></semantics></math> for <math id="A6.SS4.p2.m5" class="ltx_Math" alttext="c\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c\in(0,1)</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS4.p3" class="ltx_para">
<p id="A6.SS4.p3.1" class="ltx_p"><span id="A6.SS4.p3.1.1" class="ltx_text">For <math id="A6.SS4.p3.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, the same logic follows, and we also note that:</span></p>
<table id="A6.Ex643" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex643.m1" class="ltx_Math" alttext="\text{Bias}={\theta}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\tilde{\alpha}_{Z}-\alpha_{Z}+\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{\tau^{2}c}{\theta^{2}+\tau^{2}c}\right)^{2}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\sqrt{d}(\tilde{\alpha}_{Z}-\alpha_{Z})+\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{\sqrt{d}c}{d+c}\right)^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><msup><mi>θ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></mfrac></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mi>d</mi><mo>+</mo><mi>c</mi></mrow></mfrac></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}={\theta}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\tilde{\alpha}_{Z}-\alpha_{Z}+\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{\tau^{2}c}{\theta^{2}+\tau^{2}c}\right)^{2}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\sqrt{d}(\tilde{\alpha}_{Z}-\alpha_{Z})+\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{\sqrt{d}c}{d+c}\right)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p3.2" class="ltx_p"><span id="A6.SS4.p3.2.1" class="ltx_text">which scales with <math id="A6.SS4.p3.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> with other terms controlled. Hence, <math id="A6.SS4.p3.m3" class="ltx_Math" alttext="\mathcal{R}_{c}=\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>c</mi></msub><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mathcal{R}_{c}=\infty</annotation></semantics></math> for all <math id="A6.SS4.p3.m4" class="ltx_Math" alttext="c\neq 1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≠</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c\neq 1</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS4.p4" class="ltx_para">
<p id="A6.SS4.p4.1" class="ltx_p"><span id="A6.SS4.p4.1.1" class="ltx_text">Now assume that <math id="A6.SS4.p4.m1" class="ltx_Math" alttext="\alpha_{Z}=\tilde{\alpha}_{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>=</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>Z</mi></msub></mrow><annotation encoding="application/x-tex">\alpha_{Z}=\tilde{\alpha}_{Z}</annotation></semantics></math>. Since we are interested in <math id="A6.SS4.p4.m2" class="ltx_Math" alttext="c\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">c\to\infty</annotation></semantics></math>, we only consider <math id="A6.SS4.p4.m3" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>. First, from algebra and taking the limit for <math id="A6.SS4.p4.m4" class="ltx_Math" alttext="d,n" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d,n</annotation></semantics></math>, we have that:</span></p>
<table id="A6.Ex644" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex644.m1" class="ltx_Math" alttext="\text{Bias}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{c\sqrt{d}}{d+c}\right)^{2}\to 0,\quad\text{Data Noise}=\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>Bias</mtext><mo>=</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mrow><mi>d</mi><mo>+</mo><mi>c</mi></mrow></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mtext>Data Noise</mtext><mo>=</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Bias}={\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)\frac{c\sqrt{d}}{d+c}\right)^{2}\to 0,\quad\text{Data Noise}=\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex645" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex645.m1" class="ltx_Math" alttext="\text{Target Alignment}=-2\tilde{\alpha}_{A}{\tau}^{2}\left(\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mtext>Target Alignment</mtext><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{Target Alignment}=-2\tilde{\alpha}_{A}{\tau}^{2}\left(\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\alpha_{A}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A6.Ex646" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex646.m1" class="ltx_Math" alttext="\text{Variance}=\tau^{2}\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{(c-1)}\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)^{2}+\tau_{\varepsilon}^{2}\left(\frac{1}{c-1}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mtext>Variance</mtext><mo>=</mo><mrow><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mfrac><msub><mi>α</mi><mi>A</mi></msub><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{Variance}=\tau^{2}\alpha_{A}^{2}\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\frac{c}{(c-1)}\left(\alpha_{Z}-\frac{\alpha_{A}}{c}\right)^{2}+\tau_{\varepsilon}^{2}\left(\frac{1}{c-1}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p4.2" class="ltx_p"><span id="A6.SS4.p4.2.1" class="ltx_text">We now take <math id="A6.SS4.p4.m5" class="ltx_Math" alttext="c\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">c\to\infty</annotation></semantics></math> and many terms vanish in this limit, yielding:</span></p>
<table id="A6.Ex647" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex647.m1" class="ltx_Math" alttext="\lim_{c\to\infty}\mathcal{R}_{c}=-2\tilde{\alpha}_{A}\alpha_{Z}{\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\alpha_{Z}^{2}+\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}=\tau^{2}\left[({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}(\alpha_{Z}^{2}-2\tilde{\alpha}_{A}\alpha_{Z})+\|{\bm{\beta}}_{*}\|^{2}\tilde{\alpha}_{A}^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>c</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>Z</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>α</mi><mi>Z</mi><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>α</mi><mo>~</mo></mover><mi>A</mi><mn>2</mn></msubsup></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{c\to\infty}\mathcal{R}_{c}=-2\tilde{\alpha}_{A}\alpha_{Z}{\tau}^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\tau^{2}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\alpha_{Z}^{2}+\tilde{\alpha}_{A}^{2}\tau^{2}\|{\bm{\beta}}_{*}\|^{2}=\tau^{2}\left[({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}(\alpha_{Z}^{2}-2\tilde{\alpha}_{A}\alpha_{Z})+\|{\bm{\beta}}_{*}\|^{2}\tilde{\alpha}_{A}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p4.3" class="ltx_p"><span id="A6.SS4.p4.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmprop3" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmprop3.2" class="ltx_text ltx_font_bold">Proposition 3</span></span><span id="Thmprop3.3" class="ltx_text ltx_font_bold"> </span>(Non–existence of a canceling scale parameter)<span id="Thmprop3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmprop3.p1" class="ltx_para">
<p id="Thmprop3.p1.1" class="ltx_p"><span id="Thmprop3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmprop3.p1.m1" class="ltx_Math" alttext="\alpha_{A},\alpha_{Z}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>A</mi></msub><mo>,</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha_{A},\alpha_{Z}&gt;0</annotation></semantics></math> be fixed scalars, let <math id="Thmprop3.p1.m2" class="ltx_Math" alttext="{\bm{u}},{\bm{\beta}}_{*}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐮</mi><mo>,</mo><mrow><msub><mi>𝛃</mi><mo>∗</mo></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}},{\bm{\beta}}_{*}\in\mathbb{R}^{d}</annotation></semantics></math> be
fixed vectors, and set</span></p>
<table id="A6.Ex648" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex648.m1" class="ltx_Math" alttext="a\;:=\|{\bm{\beta}}_{*}\|^{2}&gt;0,\qquad b\;:=\bigl({\bm{\beta}}_{*}^{\!\top}{\bm{u}}\bigr)^{2}\in[0,a]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo lspace="0.558em">:=</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="2.167em">,</mo><mrow><mi>b</mi><mo lspace="0.558em">:=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>a</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a\;:=\|{\bm{\beta}}_{*}\|^{2}&gt;0,\qquad b\;:=\bigl({\bm{\beta}}_{*}^{\!\top}{\bm{u}}\bigr)^{2}\in[0,a].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmprop3.p1.2" class="ltx_p"><span id="Thmprop3.p1.2.1" class="ltx_text ltx_font_italic">For every positive real number <math id="Thmprop3.p1.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> define</span></p>
<table id="A6.Ex649" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex649.m1" class="ltx_Math" alttext="f(\phi)\;=\;\alpha_{A}^{2}\,a\;+\;\Bigl(\alpha_{Z}^{2}\!\Bigl(1+\frac{1}{\phi}\Bigr)-2\alpha_{Z}\alpha_{A}\Bigr)\,b." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo lspace="0.502em" rspace="0.502em">+</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msubsup><mi>α</mi><mi>Z</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>ϕ</mi></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>b</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(\phi)\;=\;\alpha_{A}^{2}\,a\;+\;\Bigl(\alpha_{Z}^{2}\!\Bigl(1+\frac{1}{\phi}\Bigr)-2\alpha_{Z}\alpha_{A}\Bigr)\,b.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmprop3.p1.3" class="ltx_p"><span id="Thmprop3.p1.3.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="A6.Ex650" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex650.m1" class="ltx_Math" alttext="f(\phi)&gt;0\quad\text{for all }\phi&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(\phi)&gt;0\quad\text{for all }\phi&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmprop3.p1.4" class="ltx_p"><span id="Thmprop3.p1.4.1" class="ltx_text ltx_font_italic">Consequently the equation <math id="Thmprop3.p1.m4" class="ltx_Math" alttext="f(\phi)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(\phi)=0</annotation></semantics></math> has no solution with
<math id="Thmprop3.p1.m5" class="ltx_Math" alttext="\phi\in(0,\infty)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi\in(0,\infty)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A6.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A6.SS4.p5" class="ltx_para">
<p id="A6.SS4.p5.1" class="ltx_p"><span id="A6.SS4.p5.1.1" class="ltx_text">If <math id="A6.SS4.p5.m1" class="ltx_Math" alttext="b=0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b=0</annotation></semantics></math> (i.e. <math id="A6.SS4.p5.m2" class="ltx_Math" alttext="{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝜷</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\beta}}_{*}</annotation></semantics></math> is orthogonal to <math id="A6.SS4.p5.m3" class="ltx_Math" alttext="{\bm{u}}" display="inline" intent=":literal"><semantics><mi>𝒖</mi><annotation encoding="application/x-tex">{\bm{u}}</annotation></semantics></math>) we have
<math id="A6.SS4.p5.m4" class="ltx_Math" alttext="f(\phi)=\alpha_{A}^{2}a&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(\phi)=\alpha_{A}^{2}a&gt;0</annotation></semantics></math>, so no positive <math id="A6.SS4.p5.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> can cancel the
expression. Hence assume <math id="A6.SS4.p5.m6" class="ltx_Math" alttext="b&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A6.SS4.p6" class="ltx_para">
<p id="A6.SS4.p6.1" class="ltx_p"><span id="A6.SS4.p6.1.1" class="ltx_text">Writing <math id="A6.SS4.p6.m1" class="ltx_Math" alttext="r:=b/a\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>:=</mo><mrow><mi>b</mi><mo>/</mo><mi>a</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">r:=b/a\in(0,1]</annotation></semantics></math> we obtain</span></p>
<table id="A6.Ex651" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex651.m1" class="ltx_Math" alttext="f(\phi)=a\Bigl[\alpha_{A}^{2}+\alpha_{Z}(\alpha_{Z}-2\alpha_{A})\,r+\frac{\alpha_{Z}^{2}r}{\phi}\Bigr]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>a</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mfrac><mrow><msubsup><mi>α</mi><mi>Z</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>ϕ</mi></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(\phi)=a\Bigl[\alpha_{A}^{2}+\alpha_{Z}(\alpha_{Z}-2\alpha_{A})\,r+\frac{\alpha_{Z}^{2}r}{\phi}\Bigr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.SS4.p7" class="ltx_para">
<p id="A6.SS4.p7.1" class="ltx_p"><span id="A6.SS4.p7.1.1" class="ltx_text">Since <math id="A6.SS4.p7.m1" class="ltx_Math" alttext="r\leq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\leq 1</annotation></semantics></math>,</span></p>
<table id="A6.Ex653" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex653.m1" class="ltx_Math" alttext="\alpha_{A}^{2}+\alpha_{Z}(\alpha_{Z}-2\alpha_{A})\,r\;\geq\;\alpha_{A}^{2}+\alpha_{Z}(\alpha_{Z}-2\alpha_{A})\;=\;\bigl(\alpha_{A}-\alpha_{Z}\bigr)^{2}\;\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo lspace="0.558em" rspace="0.558em">≥</mo><mrow><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup><mo>+</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>α</mi><mi>Z</mi></msub><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub></mrow></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.558em">=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo>−</mo><msub><mi>α</mi><mi>Z</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{A}^{2}+\alpha_{Z}(\alpha_{Z}-2\alpha_{A})\,r\;\geq\;\alpha_{A}^{2}+\alpha_{Z}(\alpha_{Z}-2\alpha_{A})\;=\;\bigl(\alpha_{A}-\alpha_{Z}\bigr)^{2}\;\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS4.p7.2" class="ltx_p"><span id="A6.SS4.p7.2.1" class="ltx_text">Thus the square bracket in <math id="A6.SS4.p7.m2" class="ltx_Math" alttext="(\ast)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\ast)</annotation></semantics></math> is the sum of a non–negative
term and a strictly positive term.</span></p>
</div>
<div id="A6.SS4.p8" class="ltx_para">
<p id="A6.SS4.p8.1" class="ltx_p"><span id="A6.SS4.p8.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
