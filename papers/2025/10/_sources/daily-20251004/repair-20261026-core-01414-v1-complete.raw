<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex337.m1" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\frac{\rho^{4}\eta^{4}}{(\eta^{2}c+\rho^{2})^{2}}+o(1)\right)(1-c)^{2}\left(\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>4</mn></msup></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\frac{\rho^{4}\eta^{4}}{(\eta^{2}c+\rho^{2})^{2}}+o(1)\right)(1-c)^{2}\left(\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
