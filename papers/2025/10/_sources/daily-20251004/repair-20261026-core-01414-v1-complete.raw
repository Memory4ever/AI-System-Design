<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p11.2" class="ltx_p"><span id="A4.SS5.SSS6.p11.2.1" class="ltx_text">We combine like terms and simplify the coefficients. For the term <math id="A4.SS5.SSS6.p11.m1" class="ltx_Math" alttext="{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><annotation encoding="application/x-tex">{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}</annotation></semantics></math>,</span></p>
<table id="A4.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex403"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex403.m1" class="ltx_Math" alttext="\displaystyle\tau_{\varepsilon}^{2}\left(\frac{\eta^{4}\|{\bm{t}}\|^{4}\|{\bm{k}}\|^{2}}{\gamma_{1}\xi^{2}}-\frac{2\eta^{4}\|{{\bm{t}}}\|^{4}\|{{\bm{k}}}\|^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2\eta^{2}\|{{\bm{t}}}\|^{2}}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\xi^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\varepsilon}^{2}\left(\frac{\eta^{4}\|{\bm{t}}\|^{4}\|{\bm{k}}\|^{2}}{\gamma_{1}\xi^{2}}-\frac{2\eta^{4}\|{{\bm{t}}}\|^{4}\|{{\bm{k}}}\|^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2\eta^{2}\|{{\bm{t}}}\|^{2}}{\gamma_{1}}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\xi^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex403.m2" class="ltx_Math" alttext="\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{t}}\|^{2}\left(\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}\xi^{2}}-\frac{2\eta^{2}\|{{\bm{t}}}\|^{2}\|{{\bm{k}}}\|^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2}{\gamma_{1}}+\frac{1}{\xi^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{t}}\|^{2}\left(\frac{\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}\xi^{2}}-\frac{2\eta^{2}\|{{\bm{t}}}\|^{2}\|{{\bm{k}}}\|^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2}{\gamma_{1}}+\frac{1}{\xi^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex404"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex404.m1" class="ltx_Math" alttext="\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{t}}\|^{2}\left(-\frac{\gamma_{1}-\xi^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2}{\gamma_{1}}+\frac{1}{\xi^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>−</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{t}}\|^{2}\left(-\frac{\gamma_{1}-\xi^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2}{\gamma_{1}}+\frac{1}{\xi^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex405"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex405.m1" class="ltx_Math" alttext="\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{t}}\|^{2}\left(-\frac{\gamma_{1}-\xi^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2\xi^{2}}{\gamma_{1}\xi^{2}}+\frac{\gamma_{1}}{\gamma_{1}\xi^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>−</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{t}}\|^{2}\left(-\frac{\gamma_{1}-\xi^{2}}{\gamma_{1}{\xi}^{2}}-\frac{2\xi^{2}}{\gamma_{1}\xi^{2}}+\frac{\gamma_{1}}{\gamma_{1}\xi^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex406"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex406.m1" class="ltx_Math" alttext="\displaystyle=-\tau_{\varepsilon}^{2}\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\tau_{\varepsilon}^{2}\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p11.3" class="ltx_p"><span id="A4.SS5.SSS6.p11.3.1" class="ltx_text">For the term <math id="A4.SS5.SSS6.p11.m2" class="ltx_Math" alttext="{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}</annotation></semantics></math>,</span></p>
<table id="A4.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex407"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex407.m1" class="ltx_Math" alttext="\displaystyle\tau_{\varepsilon}^{2}\left(\frac{2\eta^{3}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}\xi}-\frac{2\eta^{3}\|{{\bm{k}}}\|^{2}\|{{\bm{t}}}\|^{2}}{\gamma_{1}{\xi}}-\frac{2\eta\xi}{\gamma_{1}}\right)=-\tau_{\varepsilon}^{2}\frac{2\eta\xi}{\gamma_{1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{\varepsilon}^{2}\left(\frac{2\eta^{3}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{1}\xi}-\frac{2\eta^{3}\|{{\bm{k}}}\|^{2}\|{{\bm{t}}}\|^{2}}{\gamma_{1}{\xi}}-\frac{2\eta\xi}{\gamma_{1}}\right)=-\tau_{\varepsilon}^{2}\frac{2\eta\xi}{\gamma_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p11.4" class="ltx_p"><span id="A4.SS5.SSS6.p11.4.1" class="ltx_text">Combining these terms together, we have:</span></p>
<table id="A4.Ex408" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex408.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]=\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{\eta^{2}\|{\bm{t}}\|^{2}\tau_{\varepsilon}^{2}}{\gamma_{1}}k^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}-\frac{2\eta\xi\tau_{\varepsilon}^{2}}{\gamma_{1}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{1}}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>−</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>k</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>−</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow></mrow><mo>+</mo><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]=\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{\eta^{2}\|{\bm{t}}\|^{2}\tau_{\varepsilon}^{2}}{\gamma_{1}}k^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}-\frac{2\eta\xi\tau_{\varepsilon}^{2}}{\gamma_{1}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{1}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p11.5" class="ltx_p"><span id="A4.SS5.SSS6.p11.5.1" class="ltx_text">Similarly, using Lemmas <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, <a href="#Thmlemma10" title="Lemma 10 (General Terms). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, <a href="#Thmlemma11" title="Lemma 11 (Zero Expectation). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>, <a href="#Thmlemma21" title="Lemma 21. ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>, we have the following:</span></p>
<table id="A4.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex409"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex409.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}\right]=\tau_{\varepsilon}^{2}\mathbb{E}\left[Tr({\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top})\right]=\tau_{\varepsilon}^{2}n\mathbb{E}\left[\frac{1}{\lambda}\right]=\tau_{\varepsilon}^{2}\frac{cd}{\rho^{2}(1-c)}+o\left(\frac{d}{\rho^{2}}\right)\quad\text{by Equation \ref{eq:inverse_eig}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>by Equation </mtext><mtext><a href="#A4.E11" title="Equation 11 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a></mtext></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}\right]=\tau_{\varepsilon}^{2}\mathbb{E}\left[Tr({\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top})\right]=\tau_{\varepsilon}^{2}n\mathbb{E}\left[\frac{1}{\lambda}\right]=\tau_{\varepsilon}^{2}\frac{cd}{\rho^{2}(1-c)}+o\left(\frac{d}{\rho^{2}}\right)\quad\text{by Equation \ref{eq:inverse_eig}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex410"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex410.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex410.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\|{\bm{t}}\|^{2}\right]\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)O\left(\frac{1}{n}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\|{\bm{t}}\|^{2}\right]\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)O\left(\frac{1}{n}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex411"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex411.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}c+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)(1-c)\left(\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}c+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)(1-c)\left(\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex412"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex412.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}}{\eta^{2}c+\rho^{2}}\frac{c^{2}}{\rho^{2}(1-c)^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}}{\eta^{2}c+\rho^{2}}\frac{c^{2}}{\rho^{2}(1-c)^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex413"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex413.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\frac{\xi}{\eta}\right]\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)O\left(\frac{1}{n}\right)}=O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\frac{\xi}{\eta}\right]\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)O\left(\frac{1}{n}\right)}=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex414"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex414.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{1}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{k}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{1}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex414.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\|{\bm{k}}\|^{2}\right]\mathbb{E}\left[\|{\bm{h}}\|\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)O\left(\frac{1}{n}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\mathbb{E}\left[\|{\bm{k}}\|^{2}\right]\mathbb{E}\left[\|{\bm{h}}\|\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{1}}\right)O\left(\frac{1}{n}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex415"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex415.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}c+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c^{2}}{1-c}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c}{1-c}+o\left(\frac{1}{\rho^{2}}\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}c+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c^{2}}{1-c}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c}{1-c}+o\left(\frac{1}{\rho^{2}}\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex416"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex416.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}}{\eta^{2}c+\rho^{2}}\frac{c^{3}}{\rho^{2}(1-c)^{2}}+o\left(1\right)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>3</mn></msup><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}}{\eta^{2}c+\rho^{2}}\frac{c^{3}}{\rho^{2}(1-c)^{2}}+o\left(1\right)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p11.6" class="ltx_p"><span id="A4.SS5.SSS6.p11.6.1" class="ltx_text">After simple algebra, the result follows from here.</span></p>
</div>
<div id="A4.SS5.SSS6.p12" class="ltx_para ltx_noindent">
<p id="A4.SS5.SSS6.p12.1" class="ltx_p">For <math id="A4.SS5.SSS6.p12.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, we can expand similarly using Theorem <a href="#Thmtheorem6" title="Theorem 6 (Theorems 3, 5 of []). ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>,</p>
<table id="A4.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex417"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex417.m1" class="ltx_Math" alttext="\displaystyle{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex417.m2" class="ltx_Math" alttext="\displaystyle={\bm{\varepsilon}}^{\top}\left({\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}\right)\left({\bm{A}}^{\dagger\top}+\frac{\eta}{\xi}{\bm{s}}{\bm{h}}{\bm{A}}^{\dagger\top}-\frac{\xi}{\gamma_{2}}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}\right){\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\varepsilon}}^{\top}\left({\bm{A}}^{\dagger}+\frac{\eta}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}-\frac{\xi}{\gamma_{2}}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}\right)\left({\bm{A}}^{\dagger\top}+\frac{\eta}{\xi}{\bm{s}}{\bm{h}}{\bm{A}}^{\dagger\top}-\frac{\xi}{\gamma_{2}}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}\right){\bm{\varepsilon}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex418"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex418.m1" class="ltx_Math" alttext="\displaystyle={\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}+\frac{2\eta}{\xi}\,{\bm{\varepsilon}}^{\top}\underbrace{{\bm{A}}^{\dagger}{\bm{s}}}_{0}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{2\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}{\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi></mrow><mo stretchy="true">⏟</mo></munder><mn>0</mn></munder><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}+\frac{2\eta}{\xi}\,{\bm{\varepsilon}}^{\top}\underbrace{{\bm{A}}^{\dagger}{\bm{s}}}_{0}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{2\xi}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}{\bm{\varepsilon}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex419"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex419.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi^{2}}\,{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{2\eta}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}{\bm{\varepsilon}}+\frac{\xi^{2}}{\gamma_{2}^{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}{\bm{\varepsilon}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>ξ</mi><mn>2</mn></msup><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒑</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒒</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒒</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒑</mi><mn>2</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝜺</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi^{2}}\,{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{\varepsilon}}-\frac{2\eta}{\gamma_{2}}{\bm{\varepsilon}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}{\bm{s}}^{\top}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}{\bm{\varepsilon}}+\frac{\xi^{2}}{\gamma_{2}^{2}}{\bm{\varepsilon}}^{\top}{\bm{p}}_{2}{\bm{q}}_{2}^{\top}{\bm{q}}_{2}{\bm{p}}_{2}^{\top}{\bm{\varepsilon}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
