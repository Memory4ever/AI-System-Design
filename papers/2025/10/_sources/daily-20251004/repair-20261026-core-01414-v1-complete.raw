<p id="A4.SS3.SSS5.p15.2" class="ltx_p"><span id="A4.SS3.SSS5.p15.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold"> </span>(Preliminary Expansion of Variance)<span id="Thmlemma8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p"><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">In the setting of <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have</span></p>
<table id="A4.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex110.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.0pt\mathbb{E}\left[\frac{1}{\tilde{n}}\left\|{\bm{\beta}}_{int}^{\top}\tilde{{\bm{A}}}\right\|_{F}^{2}\right]=\mathbb{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.0pt\mathbb{E}\left[\frac{1}{\tilde{n}}\left\|{\bm{\beta}}_{int}^{\top}\tilde{{\bm{A}}}\right\|_{F}^{2}\right]=\mathbb{E}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex110.m2" class="ltx_math_unparsed" alttext="\displaystyle\left[\frac{\tilde{\tau}^{2}\alpha_{z}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}\alpha_{A}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right." display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>z</mi><mn>2</mn></msubsup></mrow><mi>d</mi></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝒁</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mi>𝒁</mi><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup></mrow><mi>d</mi></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝑨</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>𝑨</mi><mo>⊤</mo></msup><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left[\frac{\tilde{\tau}^{2}\alpha_{z}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}\alpha_{A}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex111.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.+\frac{2\tilde{\tau}^{2}\alpha_{A}\alpha_{z}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}}{d}{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>z</mi></msub></mrow><mi>d</mi></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝒁</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>𝑨</mi><mo>⊤</mo></msup><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><msup><mi>𝜺</mi><mo>⊤</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mi>𝜺</mi><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\frac{2\tilde{\tau}^{2}\alpha_{A}\alpha_{z}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}}{d}{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmlemma8.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="Thmlemma8.p2" class="ltx_para">
<p id="Thmlemma8.p2.1" class="ltx_p"><span id="Thmlemma8.p2.1.1" class="ltx_text">Since <math id="Thmlemma8.p2.m1" class="ltx_Math" alttext="\tilde{{\bm{A}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{{\bm{A}}}</annotation></semantics></math> is independent of the other terms, we replace <math id="Thmlemma8.p2.m2" class="ltx_Math" alttext="\tilde{{\bm{A}}}\tilde{{\bm{A}}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\tilde{{\bm{A}}}\tilde{{\bm{A}}}^{\top}</annotation></semantics></math> with its expectation <math id="Thmlemma8.p2.m3" class="ltx_Math" alttext="\frac{\tilde{\tau}^{2}\tilde{n}}{d}{\bm{I}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>n</mi><mo>~</mo></mover></mrow><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow><annotation encoding="application/x-tex">\frac{\tilde{\tau}^{2}\tilde{n}}{d}{\bm{I}}</annotation></semantics></math>.</span></p>
<table id="A4.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex112.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{1}{\tilde{n}}\left\|{\bm{\beta}}_{int}^{\top}\tilde{{\bm{A}}}\right\|_{F}^{2}\right]=\mathbb{E}\left[\frac{1}{\tilde{n}}{\bm{\beta}}_{int}^{\top}\tilde{{\bm{A}}}\tilde{{\bm{A}}}^{\top}{\bm{\beta}}_{int}\right]=\frac{1}{\tilde{n}}\frac{\tilde{\tau}^{2}\tilde{n}}{d}\mathbb{E}\left[{\bm{\beta}}_{int}^{\top}{\bm{\beta}}_{int}\right]=\frac{\tilde{\tau}^{2}}{d}\mathbb{E}\left[\|{\bm{\beta}}_{int}\|^{2}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mn>1</mn><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><mn>1</mn><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mover accent="true"><mi>n</mi><mo>~</mo></mover></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>n</mi><mo>~</mo></mover></mrow><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{1}{\tilde{n}}\left\|{\bm{\beta}}_{int}^{\top}\tilde{{\bm{A}}}\right\|_{F}^{2}\right]=\mathbb{E}\left[\frac{1}{\tilde{n}}{\bm{\beta}}_{int}^{\top}\tilde{{\bm{A}}}\tilde{{\bm{A}}}^{\top}{\bm{\beta}}_{int}\right]=\frac{1}{\tilde{n}}\frac{\tilde{\tau}^{2}\tilde{n}}{d}\mathbb{E}\left[{\bm{\beta}}_{int}^{\top}{\bm{\beta}}_{int}\right]=\frac{\tilde{\tau}^{2}}{d}\mathbb{E}\left[\|{\bm{\beta}}_{int}\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma8.p2.2" class="ltx_p"><span id="Thmlemma8.p2.2.1" class="ltx_text">We now plug in the expression for <math id="Thmlemma8.p2.m4" class="ltx_Math" alttext="{\bm{\beta}}_{int}" display="inline" intent=":literal"><semantics><msub><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{\beta}}_{int}</annotation></semantics></math>. Since <math id="Thmlemma8.p2.m5" class="ltx_Math" alttext="{\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mi>𝜺</mi><annotation encoding="application/x-tex">{\bm{\varepsilon}}</annotation></semantics></math> is a zero-mean vector and independent from other random variables, terms with only one <math id="Thmlemma8.p2.m6" class="ltx_Math" alttext="{\bm{\varepsilon}}" display="inline" intent=":literal"><semantics><mi>𝜺</mi><annotation encoding="application/x-tex">{\bm{\varepsilon}}</annotation></semantics></math> have zero expectation. A straightforward expansion gives:</span></p>
<table id="A4.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex113.m1" class="ltx_Math" alttext="\displaystyle\frac{\tilde{\tau}^{2}}{d}\|{\bm{\beta}}_{int}\|_{F}^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\tilde{\tau}^{2}}{d}\|{\bm{\beta}}_{int}\|_{F}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex113.m2" class="ltx_Math" alttext="\displaystyle=\frac{\tilde{\tau}^{2}}{d}({\bm{\beta}}_{*}^{\top}(\alpha_{z}{\bm{Z}}+\alpha_{A}{\bm{A}})+{\bm{\varepsilon}}^{\top})({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}({\bm{\beta}}_{*}^{\top}(\alpha_{z}{\bm{Z}}+\alpha_{A}{\bm{A}})+{\bm{\varepsilon}}^{\top})^{\top}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi></mrow><mo>+</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>α</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi></mrow><mo>+</mo><mrow><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>𝜺</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\tilde{\tau}^{2}}{d}({\bm{\beta}}_{*}^{\top}(\alpha_{z}{\bm{Z}}+\alpha_{A}{\bm{A}})+{\bm{\varepsilon}}^{\top})({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}({\bm{\beta}}_{*}^{\top}(\alpha_{z}{\bm{Z}}+\alpha_{A}{\bm{A}})+{\bm{\varepsilon}}^{\top})^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma8.p2.3" class="ltx_p"><span id="Thmlemma8.p2.3.1" class="ltx_text">After eliminating zero expectations as above, the expectation becomes:</span></p>
<table id="A4.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex115.m1" class="ltx_Math" alttext="\displaystyle\hskip 10.0pt\mathbb{E}\left[\frac{\tilde{\tau}^{2}}{d}\|{\bm{\beta}}_{int}\|_{F}^{2}\right]=\mathbb{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">\displaystyle\hskip 10.0pt\mathbb{E}\left[\frac{\tilde{\tau}^{2}}{d}\|{\bm{\beta}}_{int}\|_{F}^{2}\right]=\mathbb{E}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex115.m2" class="ltx_math_unparsed" alttext="\displaystyle\left[\frac{\tilde{\tau}^{2}\alpha_{z}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}\alpha_{A}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right." display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>z</mi><mn>2</mn></msubsup></mrow><mi>d</mi></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝒁</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mi>𝒁</mi><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>A</mi><mn>2</mn></msubsup></mrow><mi>d</mi></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝑨</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>𝑨</mi><mo>⊤</mo></msup><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left[\frac{\tilde{\tau}^{2}\alpha_{z}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}\alpha_{A}^{2}}{d}{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex116.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.+\frac{2\tilde{\tau}^{2}\alpha_{A}\alpha_{z}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}}{d}{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>z</mi></msub></mrow><mi>d</mi></mfrac></mstyle><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝒁</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><msup><mi>𝑨</mi><mo>⊤</mo></msup><msub><mi>𝜷</mi><mo>∗</mo></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mover accent="true"><mi>τ</mi><mo>~</mo></mover><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><msup><mi>𝜺</mi><mo>⊤</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><msup><mrow><mo stretchy="false">(</mo><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mi>𝜺</mi><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\frac{2\tilde{\tau}^{2}\alpha_{A}\alpha_{z}}{d}{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}^{\top}{\bm{\beta}}_{*}+\frac{\tilde{\tau}^{2}}{d}{\bm{\varepsilon}}^{\top}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{\varepsilon}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma8.p2.4" class="ltx_p"><span id="Thmlemma8.p2.4.1" class="ltx_text">∎</span></p>
</div>
</div>
</div>
</section>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4 </span>Step 3: Random Matrix Theory Estimates</h3>

<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p">To do the estimates we recall the set up. In particular, we have that</p>
<table id="A4.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex117.m1" class="ltx_Math" alttext="{\bm{Z}}=\eta{\bm{u}}{\bm{v}}^{\top},\quad\text{where $\theta=\frac{\eta}{\sqrt{n}}$ and $\|{\bm{v}}\|=1$}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝒁</mi><mo>=</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>where </mtext><mrow><mi>θ</mi><mo>=</mo><mfrac><mi>η</mi><msqrt><mi>n</mi></msqrt></mfrac></mrow><mtext> and </mtext><mrow><mrow><mo stretchy="false">‖</mo><mi>𝒗</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{Z}}=\eta{\bm{u}}{\bm{v}}^{\top},\quad\text{where $\theta=\frac{\eta}{\sqrt{n}}$ and $\|{\bm{v}}\|=1$},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p1.2" class="ltx_p">and the entries of</p>
<table id="A4.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex118.m1" class="ltx_Math" alttext="A_{ij}=\mathcal{N}\left(0,\frac{\rho^{2}}{d}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mfrac><msup><mi>ρ</mi><mn>2</mn></msup><mi>d</mi></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{ij}=\mathcal{N}\left(0,\frac{\rho^{2}}{d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p1.3" class="ltx_p">Recall the following definition <math id="A4.SS4.p1.m1" class="ltx_Math" alttext="{\bm{h}}={\bm{v}}^{\top}{\bm{A}}^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo>=</mo><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{h}}={\bm{v}}^{\top}{\bm{A}}^{\dagger}</annotation></semantics></math>, <math id="A4.SS4.p1.m2" class="ltx_Math" alttext="{\bm{k}}={\bm{A}}^{\dagger}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒌</mi><mo>=</mo><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{k}}={\bm{A}}^{\dagger}{\bm{u}}</annotation></semantics></math>, <math id="A4.SS4.p1.m3" class="ltx_Math" alttext="{\bm{t}}={\bm{v}}^{\top}({\bm{I}}-{\bm{A}}^{\dagger}{\bm{A}})" display="inline" intent=":literal"><semantics><mrow><mi>𝒕</mi><mo>=</mo><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{t}}={\bm{v}}^{\top}({\bm{I}}-{\bm{A}}^{\dagger}{\bm{A}})</annotation></semantics></math>, <math id="A4.SS4.p1.m4" class="ltx_Math" alttext="\xi=1+\eta{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi=1+\eta{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}</annotation></semantics></math>, <math id="A4.SS4.p1.m5" class="ltx_Math" alttext="{\bm{s}}=({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒔</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{s}}=({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}</annotation></semantics></math>, <math id="A4.SS4.p1.m6" class="ltx_Math" alttext="\gamma_{1}=\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}+\xi^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma_{1}=\eta^{2}\|{\bm{t}}\|^{2}\|{\bm{k}}\|^{2}+\xi^{2}</annotation></semantics></math>, <math id="A4.SS4.p1.m7" class="ltx_Math" alttext="\gamma_{2}=\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\gamma_{2}=\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2}</annotation></semantics></math> and</p>
<table id="A4.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex119.m1" class="ltx_Math" alttext="\displaystyle{\bm{p}}_{1}=-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}-\eta{\bm{k}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒑</mi><mn>1</mn></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒕</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{p}}_{1}=-\frac{\eta^{2}\|{\bm{k}}\|^{2}}{\xi}{\bm{t}}^{\top}-\eta{\bm{k}},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex119.m2" class="ltx_Math" alttext="\displaystyle{\bm{q}}_{1}^{\top}=-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}-{\bm{h}}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒒</mi><mn>1</mn><mo>⊤</mo></msubsup><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>−</mo><mi>𝒉</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{q}}_{1}^{\top}=-\frac{\eta\|{\bm{t}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}-{\bm{h}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex120.m1" class="ltx_Math" alttext="\displaystyle{\bm{p}}_{2}=-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\eta{\bm{k}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒑</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{p}}_{2}=-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\xi}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\eta{\bm{k}},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex120.m2" class="ltx_Math" alttext="\displaystyle{\bm{q}}_{2}^{\top}=-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒒</mi><mn>2</mn><mo>⊤</mo></msubsup><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mi>𝒉</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{q}}_{2}^{\top}=-\frac{\eta\|{\bm{h}}\|^{2}}{\xi}{\bm{s}}^{\top}-{\bm{h}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.p2" class="ltx_para">
<p id="A4.SS4.p2.1" class="ltx_p">To show that each of the four terms, bias, variance, data noise, and target alignment concentrate in the limit, we do this in two steps.</p>
<ol id="A4.I4" class="ltx_enumerate">
<li id="A4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A4.I4.i1.p1" class="ltx_para">
<p id="A4.I4.i1.p1.1" class="ltx_p">First, we compute the mean and variance for basic building blocks such as <math id="A4.I4.i1.p1.m1" class="ltx_Math" alttext="\|{\bm{h}}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|{\bm{h}}\|^{2}</annotation></semantics></math> and other variables. Section <a href="#A4.SS4.SSS1" title="D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4.1</span></a>.</p>
</div></li>
<li id="A4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="A4.I4.i2.p1" class="ltx_para">
<p id="A4.I4.i2.p1.1" class="ltx_p">Second, we provide bounds on the higher moments. Section <a href="#A4.SS4.SSS2" title="D.4.2 Step 3(b): Bounding the Higher Moments ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4.2</span></a>.</p>
</div></li>
<li id="A4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="A4.I4.i3.p1" class="ltx_para">
<p id="A4.I4.i3.p1.1" class="ltx_p">Next, we prove bounds on the moments of <math id="A4.I4.i3.p1.m1" class="ltx_Math" alttext="\gamma_{i}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\gamma_{i}</annotation></semantics></math>. Section <a href="#A4.SS4.SSS3" title="D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4.3</span></a>.</p>
</div></li>
</ol>
</div>
<section id="A4.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.4.1 </span>Step 3(a): Showing that basic building blocks concentrate</h4>

<div id="A4.SS4.SSS1.p1" class="ltx_para">
<p id="A4.SS4.SSS1.p1.1" class="ltx_p">We begin by bounding the mean and variance.</p>
</div>
<div id="Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmlemma9.3" class="ltx_text ltx_font_bold"> </span>(Generalized version of Lemma 7 from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite>)<span id="Thmlemma9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma9.p1" class="ltx_para">
<p id="Thmlemma9.p1.1" class="ltx_p"><span id="Thmlemma9.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="Thmlemma9.p1.m1" class="ltx_Math" alttext="A_{ij}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">A_{ij}</annotation></semantics></math> have mean 0 and variance <math id="Thmlemma9.p1.m2" class="ltx_Math" alttext="\rho^{2}/d" display="inline" intent=":literal"><semantics><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>/</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\rho^{2}/d</annotation></semantics></math>, the entries are uncorrelated, have finite fourth moment, the distribution is invariant under left and right orthogonal transformation and the empirical spectral distribution of <math id="Thmlemma9.p1.m3" class="ltx_Math" alttext="\frac{1}{\rho^{2}}{\bm{A}}{\bm{A}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝐀</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐀</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\frac{1}{\rho^{2}}{\bm{A}}{\bm{A}}^{\top}</annotation></semantics></math> converges to the Marchenko-Pastur law. Additionally, if <math id="Thmlemma9.p1.m4" class="ltx_Math" alttext="{\bm{u}}" display="inline" intent=":literal"><semantics><mi>𝐮</mi><annotation encoding="application/x-tex">{\bm{u}}</annotation></semantics></math> and <math id="Thmlemma9.p1.m5" class="ltx_Math" alttext="{\bm{v}}" display="inline" intent=":literal"><semantics><mi>𝐯</mi><annotation encoding="application/x-tex">{\bm{v}}</annotation></semantics></math> are fixed unit norm vectors. Then we have that</span></p>
<ol id="A4.I5" class="ltx_enumerate">
<li id="A4.I5.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I5.ix1.p1" class="ltx_para">
<p id="A4.I5.ix1.p1.1" class="ltx_p"><math id="A4.I5.ix1.p1.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|{\bm{h}}\|^{2}]=\begin{cases}\frac{1}{\rho^{2}}\frac{c^{2}}{1-c}&amp;c&lt;1\\
\frac{1}{\rho^{2}}\frac{c}{c-1}&amp;c&gt;1\end{cases}+o\left(\frac{1}{\rho^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|{\bm{h}}\|^{2}]=\begin{cases}\frac{1}{\rho^{2}}\frac{c^{2}}{1-c}&amp;c&lt;1\\
\frac{1}{\rho^{2}}\frac{c}{c-1}&amp;c&gt;1\end{cases}+o\left(\frac{1}{\rho^{2}}\right)</annotation></semantics></math><span id="A4.I5.ix1.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="A4.I5.ix1.p1.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\|{\bm{h}}\|^{2})=O\left(\frac{1}{\rho^{4}n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\|{\bm{h}}\|^{2})=O\left(\frac{1}{\rho^{4}n}\right).</annotation></semantics></math></p>
</div></li>
<li id="A4.I5.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I5.ix2.p1" class="ltx_para">
<p id="A4.I5.ix2.p1.1" class="ltx_p"><math id="A4.I5.ix2.p1.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|{\bm{k}}\|^{2}]=\frac{1}{\rho^{2}}\frac{c}{1-c}+o\left(\frac{1}{\rho^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|{\bm{k}}\|^{2}]=\frac{1}{\rho^{2}}\frac{c}{1-c}+o\left(\frac{1}{\rho^{2}}\right)</annotation></semantics></math><span id="A4.I5.ix2.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="A4.I5.ix2.p1.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\|{\bm{k}}\|^{2})=O\left(\frac{1}{\rho^{4}n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\|{\bm{k}}\|^{2})=O\left(\frac{1}{\rho^{4}n}\right).</annotation></semantics></math></p>
</div></li>
<li id="A4.I5.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A4.I5.ix3.p1" class="ltx_para">
<p id="A4.I5.ix3.p1.1" class="ltx_p"><math id="A4.I5.ix3.p1.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|{\bm{s}}\|^{2}]=1-\frac{1}{c}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|{\bm{s}}\|^{2}]=1-\frac{1}{c}</annotation></semantics></math><span id="A4.I5.ix3.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="A4.I5.ix3.p1.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\|{\bm{s}}\|^{2})=O\left(\frac{1}{d}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\|{\bm{s}}\|^{2})=O\left(\frac{1}{d}\right).</annotation></semantics></math></p>
</div></li>
<li id="A4.I5.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A4.I5.ix4.p1" class="ltx_para">
<p id="A4.I5.ix4.p1.1" class="ltx_p"><math id="A4.I5.ix4.p1.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\|{\bm{t}}\|^{2}]=1-c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\|{\bm{t}}\|^{2}]=1-c</annotation></semantics></math><span id="A4.I5.ix4.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="A4.I5.ix4.p1.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}(\|{\bm{t}}\|^{2})=O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}(\|{\bm{t}}\|^{2})=O\left(\frac{1}{n}\right).</annotation></semantics></math></p>
</div></li>
<li id="A4.I5.ix5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="A4.I5.ix5.p1" class="ltx_para">
<p id="A4.I5.ix5.p1.1" class="ltx_p"><math id="A4.I5.ix5.p1.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\xi}{\eta}\right]=\frac{1}{\eta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>η</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\xi}{\eta}\right]=\frac{1}{\eta}</annotation></semantics></math><span id="A4.I5.ix5.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="A4.I5.ix5.p1.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\left(\frac{\xi}{\eta}\right)=O\left(\frac{1}{\max(n,d)}\frac{1}{\rho^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\left(\frac{\xi}{\eta}\right)=O\left(\frac{1}{\max(n,d)}\frac{1}{\rho^{2}}\right).</annotation></semantics></math></p>
</div></li>
<li id="A4.I5.ix6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">6.</span> 
<div id="A4.I5.ix6.p1" class="ltx_para">
<p id="A4.I5.ix6.p1.1" class="ltx_p"><math id="A4.I5.ix6.p1.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\xi^{2}}{\eta^{2}}\right]=\frac{1}{\eta^{2}}+\frac{1}{\max(n,d)}\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\max(n,d)\rho^{2}}\right)=\frac{1}{\eta^{2}}+O\left(\frac{1}{\max(n,d)\rho^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>ξ</mi><mn>2</mn></msup><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\xi^{2}}{\eta^{2}}\right]=\frac{1}{\eta^{2}}+\frac{1}{\max(n,d)}\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\max(n,d)\rho^{2}}\right)=\frac{1}{\eta^{2}}+O\left(\frac{1}{\max(n,d)\rho^{2}}\right)</annotation></semantics></math><span id="A4.I5.ix6.p1.1.1" class="ltx_text ltx_font_italic"> and
</span><math id="A4.I5.ix6.p1.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Var}\left(\frac{\xi^{2}}{\eta^{2}}\right)=O\left(\frac{1}{\max(d,n)\rho^{4}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>ξ</mi><mn>2</mn></msup><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Var}\left(\frac{\xi^{2}}{\eta^{2}}\right)=O\left(\frac{1}{\max(d,n)\rho^{4}}\right).</annotation></semantics></math></p>
</div></li>
</ol>
<p id="Thmlemma9.p1.2" class="ltx_p"><span id="Thmlemma9.p1.2.1" class="ltx_text ltx_font_italic">Note that here <math id="Thmlemma9.p1.m6" class="ltx_Math" alttext="\max(d,n)" display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\max(d,n)</annotation></semantics></math>, <math id="Thmlemma9.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, <math id="Thmlemma9.p1.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> are interchangeable in the variance big-Oh terms since they only differ by an absolute constant <math id="Thmlemma9.p1.m9" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>. We include the details for completion.</span></p>
</div>
</div>
<div id="A4.SS4.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS1.p2" class="ltx_para">
<p id="A4.SS4.SSS1.p2.1" class="ltx_p"><span id="A4.SS4.SSS1.p2.1.1" class="ltx_text">Items <math id="A4.SS4.SSS1.p2.m1" class="ltx_Math" alttext="1-5" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">1-5</annotation></semantics></math> come from the original statement, which assumes unit variance. Here our variance parameter <math id="A4.SS4.SSS1.p2.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> simply induces a multiplicative change. We now focus on item <math id="A4.SS4.SSS1.p2.m3" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math>. 
<br class="ltx_break"></span></p>
</div>
<div id="A4.SS4.SSS1.p3" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p3.1" class="ltx_p">Let <math id="A4.SS4.SSS1.p3.m1" class="ltx_Math" alttext="\zeta=\xi/\eta=1/\eta+{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>=</mo><mrow><mi>ξ</mi><mo>/</mo><mi>η</mi></mrow><mo>=</mo><mrow><mrow><mn>1</mn><mo>/</mo><mi>η</mi></mrow><mo>+</mo><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta=\xi/\eta=1/\eta+{\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{u}}</annotation></semantics></math>. With <math id="A4.SS4.SSS1.p3.m2" class="ltx_Math" alttext="{\bm{A}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑽</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\top}</annotation></semantics></math> (SVD), <math id="A4.SS4.SSS1.p3.m3" class="ltx_Math" alttext="{\bm{A}}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bm{A}}\in\mathbb{R}^{d\times n}</annotation></semantics></math> having i.i.d. <math id="A4.SS4.SSS1.p3.m4" class="ltx_Math" alttext="\mathcal{N}(0,\rho^{2}/d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(0,\rho^{2}/d)</annotation></semantics></math> entries, and <math id="A4.SS4.SSS1.p3.m5" class="ltx_Math" alttext="{\bm{u}},{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>,</mo><mi>𝒗</mi></mrow><annotation encoding="application/x-tex">{\bm{u}},{\bm{v}}</annotation></semantics></math> fixed unit vectors, we have <math id="A4.SS4.SSS1.p3.m6" class="ltx_Math" alttext="\zeta=\frac{1}{\eta}+\sum_{i=1}^{r}\frac{1}{\sigma_{i}}b_{i}a_{i}" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mfrac><mn>1</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta=\frac{1}{\eta}+\sum_{i=1}^{r}\frac{1}{\sigma_{i}}b_{i}a_{i}</annotation></semantics></math>, where <math id="A4.SS4.SSS1.p3.m7" class="ltx_Math" alttext="r=\min(d,n)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r=\min(d,n)</annotation></semantics></math>, <math id="A4.SS4.SSS1.p3.m8" class="ltx_Math" alttext="{\bm{a}}={\bm{V}}^{\top}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒂</mi><mo>=</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{a}}={\bm{V}}^{\top}{\bm{v}}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p3.m9" class="ltx_Math" alttext="{\bm{b}}={\bm{U}}^{\top}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒃</mi><mo>=</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{b}}={\bm{U}}^{\top}{\bm{u}}</annotation></semantics></math> are uniformly random on <math id="A4.SS4.SSS1.p3.m10" class="ltx_Math" alttext="S^{n-1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">S^{n-1}</annotation></semantics></math> and <math id="A4.SS4.SSS1.p3.m11" class="ltx_Math" alttext="S^{d-1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">S^{d-1}</annotation></semantics></math> respectively since <math id="A4.SS4.SSS1.p3.m12" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p3.m13" class="ltx_Math" alttext="{\bm{V}}" display="inline" intent=":literal"><semantics><mi>𝑽</mi><annotation encoding="application/x-tex">{\bm{V}}</annotation></semantics></math> are random rotations.
<br class="ltx_break"></p>
</div>
<div id="A4.SS4.SSS1.p4" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p4.1" class="ltx_p">Since <math id="A4.SS4.SSS1.p4.m1" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> has zero-mean entries, only the non-cross terms remain in the expectation, and the fourth moment is</p>
<table id="A4.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex121.m1" class="ltx_Math" alttext="\mathbb{E}[\zeta^{4}]=\frac{1}{\eta^{4}}+\frac{6}{\eta^{2}}\sum_{i,j}\mathbb{E}\left[\frac{1}{\sigma_{i}\sigma_{j}}\right]\mathbb{E}[b_{i}b_{j}]\mathbb{E}[a_{i}a_{j}]+\sum_{i,j,k,l}\mathbb{E}\left[\frac{1}{\sigma_{i}\sigma_{j}\sigma_{k}\sigma_{l}}\right]\mathbb{E}[b_{i}b_{j}b_{k}b_{l}]\mathbb{E}[a_{i}a_{j}a_{k}a_{l}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mfrac><mn>6</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>j</mi></msub></mrow></mfrac><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>l</mi></msub></mrow></mfrac><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>l</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>l</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\zeta^{4}]=\frac{1}{\eta^{4}}+\frac{6}{\eta^{2}}\sum_{i,j}\mathbb{E}\left[\frac{1}{\sigma_{i}\sigma_{j}}\right]\mathbb{E}[b_{i}b_{j}]\mathbb{E}[a_{i}a_{j}]+\sum_{i,j,k,l}\mathbb{E}\left[\frac{1}{\sigma_{i}\sigma_{j}\sigma_{k}\sigma_{l}}\right]\mathbb{E}[b_{i}b_{j}b_{k}b_{l}]\mathbb{E}[a_{i}a_{j}a_{k}a_{l}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p4.2" class="ltx_p">Furthermore, non-zero expectation terms require paired indices (since odd moments of the uniformly random vector on the sphere equals <math id="A4.SS4.SSS1.p4.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>). In particular, using exact spherical moments, we have <math id="A4.SS4.SSS1.p4.m3" class="ltx_Math" alttext="\mathbb{E}[a_{i}^{4}]=\frac{3}{n(n+2)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>a</mi><mi>i</mi><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[a_{i}^{4}]=\frac{3}{n(n+2)}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p4.m4" class="ltx_Math" alttext="\mathbb{E}[a_{i}^{2}]=\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[a_{i}^{2}]=\frac{1}{n}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p4.m5" class="ltx_Math" alttext="\mathbb{E}[a_{i}^{2}a_{j}^{2}]=\frac{1}{n(n+2)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>j</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[a_{i}^{2}a_{j}^{2}]=\frac{1}{n(n+2)}</annotation></semantics></math> (<math id="A4.SS4.SSS1.p4.m6" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>), <math id="A4.SS4.SSS1.p4.m7" class="ltx_Math" alttext="\mathbb{E}[b_{i}^{4}]=\frac{3}{d(d+2)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>i</mi><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mn>3</mn><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[b_{i}^{4}]=\frac{3}{d(d+2)}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p4.m8" class="ltx_Math" alttext="\mathbb{E}[b_{i}^{2}]=\frac{1}{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mi>d</mi></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[b_{i}^{2}]=\frac{1}{d}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p4.m9" class="ltx_Math" alttext="\mathbb{E}[b_{i}^{2}b_{j}^{2}]=\frac{1}{d(d+2)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mi>j</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}[b_{i}^{2}b_{j}^{2}]=\frac{1}{d(d+2)}</annotation></semantics></math> (<math id="A4.SS4.SSS1.p4.m10" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>):</p>
<table id="A4.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex122.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\zeta^{4}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\zeta^{4}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex122.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta^{4}}+\frac{6}{\eta^{2}}\sum_{i=1}^{r}\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}}\right]\frac{1}{dn}+\sum_{i=1}^{r}\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}}\right]\frac{9}{d(d+2)n(n+2)}+3\sum_{i\neq k}\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}\sigma_{k}^{2}}\right]\frac{1}{d(d+2)n(n+2)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>6</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>9</mn><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≠</mo><mi>k</mi></mrow></munder></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta^{4}}+\frac{6}{\eta^{2}}\sum_{i=1}^{r}\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}}\right]\frac{1}{dn}+\sum_{i=1}^{r}\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}}\right]\frac{9}{d(d+2)n(n+2)}+3\sum_{i\neq k}\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}\sigma_{k}^{2}}\right]\frac{1}{d(d+2)n(n+2)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex123.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta^{4}}+\underbrace{\frac{9\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{4}]}{d(d+2)n(n+2)}}_{\text{$I_{1}$}}+\underbrace{\frac{3\sum_{i\neq k}\mathbb{E}[1/(\sigma_{i}^{2}\sigma_{k}^{2})]}{d(d+2)n(n+2)}}_{\text{$I_{2}$}}+\underbrace{\frac{6}{\eta^{2}}\frac{\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}]}{dn}}_{\text{$I_{3}$}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac></mstyle><mo>+</mo><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><msub><mi>I</mi><mn mathsize="0.980em">1</mn></msub></munder><mo>+</mo><munder><munder accentunder="true"><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>≠</mo><mi>k</mi></mrow></msub><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="true">⏟</mo></munder><msub><mi>I</mi><mn mathsize="0.980em">2</mn></msub></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mn>6</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>I</mi><mn mathsize="0.980em">3</mn></msub></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta^{4}}+\underbrace{\frac{9\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{4}]}{d(d+2)n(n+2)}}_{\text{$I_{1}$}}+\underbrace{\frac{3\sum_{i\neq k}\mathbb{E}[1/(\sigma_{i}^{2}\sigma_{k}^{2})]}{d(d+2)n(n+2)}}_{\text{$I_{2}$}}+\underbrace{\frac{6}{\eta^{2}}\frac{\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}]}{dn}}_{\text{$I_{3}$}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.SSS1.p5" class="ltx_para">
<p id="A4.SS4.SSS1.p5.1" class="ltx_p"><span id="A4.SS4.SSS1.p5.1.1" class="ltx_text ltx_font_bold">Leading Order Scaling and Mean.<span id="A4.SS4.SSS1.p5.1.1.1" class="ltx_text ltx_font_medium">
Let <math id="A4.SS4.SSS1.p5.m1" class="ltx_Math" alttext="N=\max(d,n)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N=\max(d,n)</annotation></semantics></math>, assume <math id="A4.SS4.SSS1.p5.m2" class="ltx_Math" alttext="n,d\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mrow><mi>d</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">n,d\to\infty</annotation></semantics></math> with <math id="A4.SS4.SSS1.p5.m3" class="ltx_Math" alttext="d/n\to c\neq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow><mo stretchy="false">→</mo><mi>c</mi><mo>≠</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d/n\to c\neq 1</annotation></semantics></math>. Lemma 5 from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite> implies that if <math id="A4.SS4.SSS1.p5.m4" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> has unit variance entries, the moments of its inverse eigenvalue are expressions of <math id="A4.SS4.SSS1.p5.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and are hence <math id="A4.SS4.SSS1.p5.m6" class="ltx_Math" alttext="O(1)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1)</annotation></semantics></math>. In our case, it will just scale with <math id="A4.SS4.SSS1.p5.m7" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> instead:</span></span></p>
<table id="A4.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex124.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[1/\sigma_{i}^{4}]=O(1/\rho^{4}),\quad\mathbb{E}[1/(\sigma_{i}^{2}\sigma_{k}^{2})]=O(1/\rho^{4}),\quad\text{and }\ \ \ \mathbb{E}[1/\sigma_{i}^{8}]=O(1/\rho^{8})\ \ \text{ etc}." display="block" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><msup><mi>ρ</mi><mn>4</mn></msup><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><msubsup><mi>σ</mi><mi>k</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><msup><mi>ρ</mi><mn>4</mn></msup><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mtext>and </mtext><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>8</mn></msubsup><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>O</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><msup><mi>ρ</mi><mn>8</mn></msup><mo stretchy="false">)</mo></mrow><mtext> etc</mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[1/\sigma_{i}^{4}]=O(1/\rho^{4}),\quad\mathbb{E}[1/(\sigma_{i}^{2}\sigma_{k}^{2})]=O(1/\rho^{4}),\quad\text{and }\ \ \ \mathbb{E}[1/\sigma_{i}^{8}]=O(1/\rho^{8})\ \ \text{ etc}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p5.2" class="ltx_p"><span id="A4.SS4.SSS1.p5.2.1" class="ltx_text">In particular, we also need the following exact expectation from the same lemma:</span></p>
<table id="A4.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E8.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}}\right]=\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\rho^{2}}\right)=O\left(\frac{1}{\rho^{2}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}}\right]=\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\rho^{2}}\right)=O\left(\frac{1}{\rho^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p5.3" class="ltx_p"><span id="A4.SS4.SSS1.p5.3.1" class="ltx_text">Since the above <math id="A4.SS4.SSS1.p5.m8" class="ltx_Math" alttext="I_{1}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mn>1</mn></msub><annotation encoding="application/x-tex">I_{1}</annotation></semantics></math>, <math id="A4.SS4.SSS1.p5.m9" class="ltx_Math" alttext="I_{3}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mn>3</mn></msub><annotation encoding="application/x-tex">I_{3}</annotation></semantics></math> have <math id="A4.SS4.SSS1.p5.m10" class="ltx_Math" alttext="r=\min(d,n)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r=\min(d,n)</annotation></semantics></math> summands, this implies</span></p>
<table id="A4.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex125.m1" class="ltx_Math" alttext="I_{1}=O\left(\frac{r}{N^{4}\rho^{4}}\right)=O\left(\frac{1}{N^{3}\rho^{4}}\right),\quad I_{3}=O\left(\frac{r}{\eta^{2}N^{2}\rho^{2}}\right)=O\left(\frac{1}{N\rho^{4}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>I</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><mrow><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>N</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>I</mi><mn>3</mn></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>r</mi><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">I_{1}=O\left(\frac{r}{N^{4}\rho^{4}}\right)=O\left(\frac{1}{N^{3}\rho^{4}}\right),\quad I_{3}=O\left(\frac{r}{\eta^{2}N^{2}\rho^{2}}\right)=O\left(\frac{1}{N\rho^{4}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p5.4" class="ltx_p"><span id="A4.SS4.SSS1.p5.4.1" class="ltx_text">Similarly, <math id="A4.SS4.SSS1.p5.m11" class="ltx_Math" alttext="I_{2}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mn>2</mn></msub><annotation encoding="application/x-tex">I_{2}</annotation></semantics></math> has <math id="A4.SS4.SSS1.p5.m12" class="ltx_Math" alttext="r(r-1)\approx r^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≈</mo><msup><mi>r</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">r(r-1)\approx r^{2}</annotation></semantics></math> summands, and</span></p>
<table id="A4.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex126.m1" class="ltx_Math" alttext="I_{2}=O\left(\frac{r^{2}}{N^{4}\rho^{4}}\right)=O\left(\frac{1}{N^{2}\rho^{4}}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msup><mi>r</mi><mn>2</mn></msup><mrow><msup><mi>N</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>N</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{2}=O\left(\frac{r^{2}}{N^{4}\rho^{4}}\right)=O\left(\frac{1}{N^{2}\rho^{4}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E9.m1" class="ltx_math_unparsed" alttext="\implies\mathbb{E}[\zeta^{4}]=\frac{1}{\eta^{4}}+I_{1}+I_{2}+I_{3}=\frac{1}{\eta^{4}}+O\left(\frac{1}{\max(d,n)\rho^{4}}\right)\quad\text{since $I_{3}$ dominates}." display="block" intent=":literal"><semantics><mrow><mo stretchy="false">⟹</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow><mo>=</mo><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac><mo>+</mo><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><msub><mi>I</mi><mn>2</mn></msub><mo>+</mo><msub><mi>I</mi><mn>3</mn></msub><mo>=</mo><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac><mo>+</mo><mi>O</mi><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow><mrow><mtext>since </mtext><msub><mi>I</mi><mn>3</mn></msub><mtext> dominates</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\implies\mathbb{E}[\zeta^{4}]=\frac{1}{\eta^{4}}+I_{1}+I_{2}+I_{3}=\frac{1}{\eta^{4}}+O\left(\frac{1}{\max(d,n)\rho^{4}}\right)\quad\text{since $I_{3}$ dominates}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p5.5" class="ltx_p"><span id="A4.SS4.SSS1.p5.5.1" class="ltx_text">With a similar expansion for the second moment and taking spherical moments, we get that</span></p>
<table id="A4.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex127.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\zeta^{2}]=\frac{1}{\eta^{2}}+\sum_{i,j}\mathbb{E}\left[\frac{1}{\sigma_{i}\sigma_{j}}\right]\mathbb{E}[b_{i}b_{j}]\mathbb{E}[a_{i}a_{j}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\zeta^{2}]=\frac{1}{\eta^{2}}+\sum_{i,j}\mathbb{E}\left[\frac{1}{\sigma_{i}\sigma_{j}}\right]\mathbb{E}[b_{i}b_{j}]\mathbb{E}[a_{i}a_{j}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex127.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta^{2}}+\frac{\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}]}{dn}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta^{2}}+\frac{\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}]}{dn}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex128.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta^{2}}+\frac{\min(d,n)}{dn}\left(\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\rho^{2}}\right)\right)\text{ by Equation \ref{eq:one_over_lambda}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> by Equation </mtext><mtext><a href="#A4.E8" title="Equation 8 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a></mtext></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta^{2}}+\frac{\min(d,n)}{dn}\left(\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\rho^{2}}\right)\right)\text{ by Equation \ref{eq:one_over_lambda}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex129.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\eta^{2}}+\frac{1}{\max(d,n)}\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\max(d,n)\rho^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\eta^{2}}+\frac{1}{\max(d,n)}\frac{c}{\rho^{2}|1-c|}+o\left(\frac{1}{\max(d,n)\rho^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p5.6" class="ltx_p"><span id="A4.SS4.SSS1.p5.6.1" class="ltx_text">This gives us the mean. Furthermore,</span></p>
<table id="A4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E10.m1" class="ltx_Math" alttext="(\mathbb{E}[\zeta^{2}])^{2}=\frac{1}{\eta^{4}}+\frac{2}{\eta^{2}}\frac{\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}]}{dn}+\frac{(\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}])^{2}}{d^{2}n^{2}}=\frac{1}{\eta^{4}}+O\left(\frac{1}{\max(d,n)\rho^{4}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mfrac><mn>2</mn><msup><mi>η</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo>+</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mi>η</mi><mn>4</mn></msup></mfrac><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\mathbb{E}[\zeta^{2}])^{2}=\frac{1}{\eta^{4}}+\frac{2}{\eta^{2}}\frac{\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}]}{dn}+\frac{(\sum_{i=1}^{r}\mathbb{E}[1/\sigma_{i}^{2}])^{2}}{d^{2}n^{2}}=\frac{1}{\eta^{4}}+O\left(\frac{1}{\max(d,n)\rho^{4}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.SSS1.p6" class="ltx_para">
<p id="A4.SS4.SSS1.p6.1" class="ltx_p"><span id="A4.SS4.SSS1.p6.1.1" class="ltx_text ltx_font_bold">Variance.<span id="A4.SS4.SSS1.p6.1.1.1" class="ltx_text ltx_font_medium">
<math id="A4.SS4.SSS1.p6.m1" class="ltx_Math" alttext="\mathrm{Var}(\zeta^{2})=\mathbb{E}[\zeta^{4}]-(\mathbb{E}[\zeta^{2}])^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ζ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>4</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>ζ</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}(\zeta^{2})=\mathbb{E}[\zeta^{4}]-(\mathbb{E}[\zeta^{2}])^{2}</annotation></semantics></math>. From Equations <a href="#A4.E9" title="Equation 9 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, <a href="#A4.E10" title="Equation 10 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, the overall scaling is determined by the dominant term:</span></span></p>
<table id="A4.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex130.m1" class="ltx_Math" alttext="\mathrm{Var}\left(\left(\frac{\xi}{\eta}\right)^{2}\right)=O\left(\frac{1}{\max(d,n)\rho^{4}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mfrac><mi>ξ</mi><mi>η</mi></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Var}\left(\left(\frac{\xi}{\eta}\right)^{2}\right)=O\left(\frac{1}{\max(d,n)\rho^{4}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p6.2" class="ltx_p"><span id="A4.SS4.SSS1.p6.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold"> </span>(General Terms)<span id="Thmlemma10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para">
<p id="Thmlemma10.p1.1" class="ltx_p"><span id="Thmlemma10.p1.1.1" class="ltx_text ltx_font_italic">In the setting of <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a> we have the following expectations:</span></p>
<ol id="A4.I6" class="ltx_enumerate">
<li id="A4.I6.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I6.ix1.p1" class="ltx_para">
<p id="A4.I6.ix1.p1.1" class="ltx_p"><span id="A4.I6.ix1.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix1.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math><span id="A4.I6.ix1.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix1.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}]=\frac{c}{\rho^{2}(1-c)}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}]=\frac{c}{\rho^{2}(1-c)}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)</annotation></semantics></math><span id="A4.I6.ix1.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix1.p1.m3" class="ltx_Math" alttext="O(1/(\rho^{4}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{4}d))</annotation></semantics></math><span id="A4.I6.ix1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I6.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I6.ix2.p1" class="ltx_para">
<p id="A4.I6.ix2.p1.1" class="ltx_p"><span id="A4.I6.ix2.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix2.p1.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math><span id="A4.I6.ix2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix2.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}]=\frac{c^{2}}{\rho^{4}(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}]=\frac{c^{2}}{\rho^{4}(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)</annotation></semantics></math><span id="A4.I6.ix2.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix2.p1.m3" class="ltx_Math" alttext="O(1/(\rho^{8}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{8}d))</annotation></semantics></math><span id="A4.I6.ix2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I6.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A4.I6.ix3.p1" class="ltx_para">
<p id="A4.I6.ix3.p1.1" class="ltx_p"><span id="A4.I6.ix3.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix3.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I6.ix3.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix3.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}]=\frac{c-1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}]=\frac{c-1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}</annotation></semantics></math><span id="A4.I6.ix3.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix3.p1.m3" class="ltx_Math" alttext="O(1/d)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d)</annotation></semantics></math><span id="A4.I6.ix3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I6.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A4.I6.ix4.p1" class="ltx_para">
<p id="A4.I6.ix4.p1.1" class="ltx_p"><span id="A4.I6.ix4.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix4.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I6.ix4.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix4.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}]=\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}]=\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)</annotation></semantics></math><span id="A4.I6.ix4.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix4.p1.m3" class="ltx_Math" alttext="O(1/d)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d)</annotation></semantics></math><span id="A4.I6.ix4.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I6.ix5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="A4.I6.ix5.p1" class="ltx_para">
<p id="A4.I6.ix5.p1.1" class="ltx_p"><span id="A4.I6.ix5.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix5.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I6.ix5.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix5.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{c}{\rho^{2}(c-1)}+o\left(\frac{1}{\rho^{2}d}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{c}{\rho^{2}(c-1)}+o\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math><span id="A4.I6.ix5.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix5.p1.m3" class="ltx_Math" alttext="O(1/(\rho^{4}d^{2}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{4}d^{2}))</annotation></semantics></math><span id="A4.I6.ix5.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I6.ix6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">6.</span> 
<div id="A4.I6.ix6.p1" class="ltx_para">
<p id="A4.I6.ix6.p1.1" class="ltx_p"><span id="A4.I6.ix6.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix6.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I6.ix6.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix6.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}]=\frac{1}{\rho^{4}}\frac{c^{3}}{(c-1)^{3}}+o\left(\frac{1}{\rho^{4}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>c</mi><mn>3</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}]=\frac{1}{\rho^{4}}\frac{c^{3}}{(c-1)^{3}}+o\left(\frac{1}{\rho^{4}}\right)</annotation></semantics></math><span id="A4.I6.ix6.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix6.p1.m3" class="ltx_Math" alttext="O(1/(\rho^{8}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{8}d))</annotation></semantics></math><span id="A4.I6.ix6.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I6.ix7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">7.</span> 
<div id="A4.I6.ix7.p1" class="ltx_para">
<p id="A4.I6.ix7.p1.1" class="ltx_p"><span id="A4.I6.ix7.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="A4.I6.ix7.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I6.ix7.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I6.ix7.p1.m2" class="ltx_Math" alttext="\mathbb{E}[\|{\bm{k}}\|^{2}]=\frac{1}{\rho^{2}}\frac{1}{c-1}+o\left(\frac{1}{\rho^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\|{\bm{k}}\|^{2}]=\frac{1}{\rho^{2}}\frac{1}{c-1}+o\left(\frac{1}{\rho^{2}}\right)</annotation></semantics></math><span id="A4.I6.ix7.p1.1.3" class="ltx_text ltx_font_italic"> and the variance is </span><math id="A4.I6.ix7.p1.m3" class="ltx_Math" alttext="O(1/(\rho^{4}n))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{4}n))</annotation></semantics></math></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.SS4.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS1.p7" class="ltx_para">
<p id="A4.SS4.SSS1.p7.1" class="ltx_p"><span id="A4.SS4.SSS1.p7.1.1" class="ltx_text">For all these terms, we evaluate the expectation using the SVD <math id="A4.SS4.SSS1.p7.m1" class="ltx_Math" alttext="{\bm{A}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑽</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\top}</annotation></semantics></math>, with <math id="A4.SS4.SSS1.p7.m2" class="ltx_Math" alttext="{\bm{A}}^{\dagger}={\bm{V}}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>=</mo><mrow><mi>𝑽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\dagger}={\bm{V}}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}</annotation></semantics></math>, and important expectations from Lemma 5 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite> regarding the spectrum of <math id="A4.SS4.SSS1.p7.m3" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math>: suppose <math id="A4.SS4.SSS1.p7.m4" class="ltx_Math" alttext="\tilde{{\bm{A}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{{\bm{A}}}</annotation></semantics></math> has unit variance (general <math id="A4.SS4.SSS1.p7.m5" class="ltx_Math" alttext="\rho^{2}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\rho^{2}</annotation></semantics></math> is a multiplicative change), and let <math id="A4.SS4.SSS1.p7.m6" class="ltx_Math" alttext="\sigma_{i}(\tilde{{\bm{A}}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{i}(\tilde{{\bm{A}}})</annotation></semantics></math> denote the <math id="A4.SS4.SSS1.p7.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th singular value. We have</span></p>
<table id="A4.Ex131" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex131.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}(\tilde{{\bm{A}}})}\right]=\begin{cases}\frac{c}{1-c}+o(1)&amp;c&lt;1\\
\frac{c}{c-1}+o(1)&amp;c&gt;1\end{cases},\quad\quad\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}(\tilde{{\bm{A}}})}\right]=\begin{cases}\frac{c^{2}}{(1-c)^{3}}+o(1)&amp;c&lt;1\\
\frac{c^{3}}{(c-1)^{3}}+o(1)&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>3</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}(\tilde{{\bm{A}}})}\right]=\begin{cases}\frac{c}{1-c}+o(1)&amp;c&lt;1\\
\frac{c}{c-1}+o(1)&amp;c&gt;1\end{cases},\quad\quad\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}(\tilde{{\bm{A}}})}\right]=\begin{cases}\frac{c^{2}}{(1-c)^{3}}+o(1)&amp;c&lt;1\\
\frac{c^{3}}{(c-1)^{3}}+o(1)&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E11.m1" class="ltx_Math" alttext="\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}({{\bm{A}}})}\right]=\begin{cases}\frac{1}{\rho^{2}}\frac{c}{1-c}+o\left(\frac{1}{\rho^{2}}\right)&amp;c&lt;1\\
\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)&amp;c&gt;1\end{cases},\quad\quad\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}({{\bm{A}}})}\right]=\begin{cases}\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)&amp;c&lt;1\\
\frac{1}{\rho^{4}}\frac{c^{3}}{(c-1)^{3}}+o\left(\frac{1}{\rho^{4}}\right)&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>3</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}({{\bm{A}}})}\right]=\begin{cases}\frac{1}{\rho^{2}}\frac{c}{1-c}+o\left(\frac{1}{\rho^{2}}\right)&amp;c&lt;1\\
\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)&amp;c&gt;1\end{cases},\quad\quad\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}({{\bm{A}}})}\right]=\begin{cases}\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)&amp;c&lt;1\\
\frac{1}{\rho^{4}}\frac{c^{3}}{(c-1)^{3}}+o\left(\frac{1}{\rho^{4}}\right)&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
<div id="A4.SS4.SSS1.p8" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p8.1" class="ltx_p"><span id="A4.SS4.SSS1.p8.1.1" class="ltx_text ltx_font_bold">For the first term</span>, we note that</p>
<table id="A4.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex132.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}A^{\dagger}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}A^{\dagger}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex132.m2" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{u}}^{\top}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{u}}^{\top}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex133.m1" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{u}}^{\top}{\bm{U}}{\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{u}}^{\top}{\bm{U}}{\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex134.m1" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{d}({\bm{u}}^{\top}{\bm{U}})_{i}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}^{2}({\bm{A}})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{d}({\bm{u}}^{\top}{\bm{U}})_{i}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}^{2}({\bm{A}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex135.m1" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{d}({\bm{u}}^{\top}{\bm{u}}_{i})({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})\frac{1}{\sigma_{i}^{2}({\bm{A}})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{d}({\bm{u}}^{\top}{\bm{u}}_{i})({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})\frac{1}{\sigma_{i}^{2}({\bm{A}})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p8.2" class="ltx_p">where <math id="A4.SS4.SSS1.p8.m1" class="ltx_Math" alttext="{\bm{u}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒖</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{u}}_{i}</annotation></semantics></math> denotes the <math id="A4.SS4.SSS1.p8.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th column of <math id="A4.SS4.SSS1.p8.m3" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math>. We further note that <math id="A4.SS4.SSS1.p8.m4" class="ltx_Math" alttext="{\bm{u}}^{\top}{\bm{\beta}}_{*}={\bm{u}}^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{u}}^{\top}{\bm{\beta}}_{*}={\bm{u}}^{\top}{\bm{U}}{\bm{U}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math>. Since permuting columns of an orthogonal matrix does not break orthogonality and <math id="A4.SS4.SSS1.p8.m5" class="ltx_Math" alttext="{\bm{U}}" display="inline" intent=":literal"><semantics><mi>𝑼</mi><annotation encoding="application/x-tex">{\bm{U}}</annotation></semantics></math> is uniformly random, we have that the marginals <math id="A4.SS4.SSS1.p8.m6" class="ltx_Math" alttext="{\bm{u}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒖</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\bm{u}}_{i}</annotation></semantics></math> are identical. Thus, we have that</p>
<table id="A4.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex136.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{u}}^{\top}{\bm{u}}_{1}{\bm{\beta}}_{*}^{\top}{\bm{u}}_{1}]=\ldots=\mathbb{E}[{\bm{u}}^{\top}{\bm{u}}_{d}{\bm{\beta}}_{*}^{\top}{\bm{u}}_{d}]=\frac{1}{d}({\bm{u}}^{\top}{\bm{\beta}}_{*})\quad\text{since $\mathbb{E}[{\bm{u}}_{i}{\bm{u}}_{i}^{\top}]=\frac{1}{d}{\bm{I}}$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mi mathvariant="normal">…</mi><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>since </mtext><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝒖</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝒖</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝑰</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{u}}^{\top}{\bm{u}}_{1}{\bm{\beta}}_{*}^{\top}{\bm{u}}_{1}]=\ldots=\mathbb{E}[{\bm{u}}^{\top}{\bm{u}}_{d}{\bm{\beta}}_{*}^{\top}{\bm{u}}_{d}]=\frac{1}{d}({\bm{u}}^{\top}{\bm{\beta}}_{*})\quad\text{since $\mathbb{E}[{\bm{u}}_{i}{\bm{u}}_{i}^{\top}]=\frac{1}{d}{\bm{I}}$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p8.3" class="ltx_p">It follows from here that</p>
<table id="A4.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex137.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex137.m2" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{d}\mathbb{E}[{\bm{u}}^{\top}{\bm{u}}_{i}{\bm{\beta}}_{*}^{\top}{\bm{u}}_{i}]\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}({\bm{A}})}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{d}\mathbb{E}[{\bm{u}}^{\top}{\bm{u}}_{i}{\bm{\beta}}_{*}^{\top}{\bm{u}}_{i}]\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}({\bm{A}})}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex138.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\sum_{i=1}^{d}\frac{1}{d}\left(\frac{c}{1-c}+o(1)\right)\quad\text{by Equation \ref{eq:inverse_eig}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mi>𝒖</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mrow><mtext>by Equation </mtext><mtext><a href="#A4.E11" title="Equation 11 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a></mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\sum_{i=1}^{d}\frac{1}{d}\left(\frac{c}{1-c}+o(1)\right)\quad\text{by Equation \ref{eq:inverse_eig}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex139.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{\rho^{2}}\frac{c}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\rho^{2}}\frac{c}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(\frac{1}{\rho^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p8.4" class="ltx_p">Since <math id="A4.SS4.SSS1.p8.m7" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is isotropic Gaussian, we have that <math id="A4.SS4.SSS1.p8.m8" class="ltx_Math" alttext="{\bm{U}},{\bm{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>,</mo><mi>𝑽</mi></mrow><annotation encoding="application/x-tex">{\bm{U}},{\bm{V}}</annotation></semantics></math> are uniformly random orthogonal matrices. Thus, <math id="A4.SS4.SSS1.p8.m9" class="ltx_Math" alttext="{\bm{u}}^{\top}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><annotation encoding="application/x-tex">{\bm{u}}^{\top}{\bm{U}}</annotation></semantics></math> and <math id="A4.SS4.SSS1.p8.m10" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math> are uniformly random vectors on the spheres of radius <math id="A4.SS4.SSS1.p8.m11" class="ltx_Math" alttext="\|{\bm{u}}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mi>𝒖</mi><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|{\bm{u}}\|</annotation></semantics></math> and <math id="A4.SS4.SSS1.p8.m12" class="ltx_Math" alttext="\|{\bm{\beta}}_{*}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|{\bm{\beta}}_{*}\|</annotation></semantics></math> respectively.</p>
</div>
<div id="A4.SS4.SSS1.p9" class="ltx_para">
<p id="A4.SS4.SSS1.p9.1" class="ltx_p"><span id="A4.SS4.SSS1.p9.1.1" class="ltx_text">Hence, when we consider the squared terms to compute the variance, the term from the two uniform vectors will contribute <math id="A4.SS4.SSS1.p9.m1" class="ltx_Math" alttext="O(1/d^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d^{2})</annotation></semantics></math>. Together with the singular value term (now squared to have <math id="A4.SS4.SSS1.p9.m2" class="ltx_Math" alttext="O(1/\rho^{4})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>ρ</mi><mn>4</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/\rho^{4})</annotation></semantics></math>) and the summation, the variance is of order <math id="A4.SS4.SSS1.p9.m3" class="ltx_Math" alttext="O(1/(\rho^{4}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{4}d))</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.SSS1.p10" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p10.1" class="ltx_p"><span id="A4.SS4.SSS1.p10.1.1" class="ltx_text ltx_font_bold">For the second term</span>, we have that by Equation <a href="#A4.E11" title="Equation 11 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>,</p>
<table id="A4.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex140.m1" class="ltx_Math" alttext="\displaystyle{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex140.m2" class="ltx_Math" alttext="\displaystyle={\bm{u}}^{\top}(({\bm{A}}{\bm{A}}^{\top})^{\dagger})^{2}{\bm{u}}={\bm{u}}^{\top}{\bm{U}}(({\bm{\Sigma}}{\bm{\Sigma}}^{\top})^{\dagger})^{2}{\bm{U}}^{\top}{\bm{u}}=\sum_{i=1}^{d}({\bm{u}}^{\top}{\bm{u}}_{i})^{2}\frac{1}{\sigma_{i}^{4}({\bm{A}})}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>=</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{u}}^{\top}(({\bm{A}}{\bm{A}}^{\top})^{\dagger})^{2}{\bm{u}}={\bm{u}}^{\top}{\bm{U}}(({\bm{\Sigma}}{\bm{\Sigma}}^{\top})^{\dagger})^{2}{\bm{U}}^{\top}{\bm{u}}=\sum_{i=1}^{d}({\bm{u}}^{\top}{\bm{u}}_{i})^{2}\frac{1}{\sigma_{i}^{4}({\bm{A}})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex141.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}]=\sum_{i=1}^{d}\mathbb{E}[({\bm{u}}^{\top}{\bm{u}}_{i})^{2}]\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}(A)}\right]=\sum_{i=1}^{d}\frac{1}{\rho^{4}}\frac{1}{d}\left(\frac{c^{2}}{(1-c)^{3}}+o(1)\right)=\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>c</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>c</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}]=\sum_{i=1}^{d}\mathbb{E}[({\bm{u}}^{\top}{\bm{u}}_{i})^{2}]\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}(A)}\right]=\sum_{i=1}^{d}\frac{1}{\rho^{4}}\frac{1}{d}\left(\frac{c^{2}}{(1-c)^{3}}+o(1)\right)=\frac{1}{\rho^{4}}\frac{c^{2}}{(1-c)^{3}}+o\left(\frac{1}{\rho^{4}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p10.2" class="ltx_p">where we again use <math id="A4.SS4.SSS1.p10.m1" class="ltx_Math" alttext="\mathbb{E}[({\bm{u}}^{\top}{\bm{u}}_{i})^{2}]=1/d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[({\bm{u}}^{\top}{\bm{u}}_{i})^{2}]=1/d</annotation></semantics></math> since it is the entry of a uniformly random vector of length <math id="A4.SS4.SSS1.p10.m2" class="ltx_Math" alttext="\|{\bm{u}}\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>𝒖</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|{\bm{u}}\|=1</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p11" class="ltx_para">
<p id="A4.SS4.SSS1.p11.1" class="ltx_p"><span id="A4.SS4.SSS1.p11.1.1" class="ltx_text">Similarly, the variance is <math id="A4.SS4.SSS1.p11.m1" class="ltx_Math" alttext="O(1/(\rho^{8}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{8}d))</annotation></semantics></math> from the summation of <math id="A4.SS4.SSS1.p11.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> independent variances each of <math id="A4.SS4.SSS1.p11.m3" class="ltx_Math" alttext="O(1/(\rho^{8}d^{2}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{8}d^{2}))</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.SSS1.p12" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p12.1" class="ltx_p"><span id="A4.SS4.SSS1.p12.1.1" class="ltx_text ltx_font_bold">For the third term</span>, we have that</p>
<table id="A4.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex142.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex142.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}({\bm{u}}^{\top}{\bm{\beta}}_{*})=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}-({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{n}({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})({\bm{u}}^{\top}{\bm{u}}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}({\bm{u}}^{\top}{\bm{\beta}}_{*})=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}-({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{n}({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})({\bm{u}}^{\top}{\bm{u}}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p12.2" class="ltx_p">Similarly, we take the expectation (in particular, <math id="A4.SS4.SSS1.p12.m1" class="ltx_Math" alttext="\mathbb{E}[({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})({\bm{u}}^{\top}{\bm{u}}_{i})]=1/d({\bm{\beta}}_{*}^{\top}{\bm{u}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})({\bm{u}}^{\top}{\bm{u}}_{i})]=1/d({\bm{\beta}}_{*}^{\top}{\bm{u}})</annotation></semantics></math>) and have</p>
<table id="A4.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex143.m1" class="ltx_Math" alttext="({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left[1-\sum_{i=1}^{n}\frac{1}{d}\right]=\left(1-\frac{1}{c}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><mi>d</mi></mfrac></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>c</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left[1-\sum_{i=1}^{n}\frac{1}{d}\right]=\left(1-\frac{1}{c}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p12.3" class="ltx_p">The variance for this term is <math id="A4.SS4.SSS1.p12.m2" class="ltx_Math" alttext="O(1/d)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d)</annotation></semantics></math> from summation of <math id="A4.SS4.SSS1.p12.m3" class="ltx_Math" alttext="n=d/c" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mi>d</mi><mo>/</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">n=d/c</annotation></semantics></math> terms of <math id="A4.SS4.SSS1.p12.m4" class="ltx_Math" alttext="O(1/d^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d^{2})</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p13" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p13.1" class="ltx_p"><span id="A4.SS4.SSS1.p13.1.1" class="ltx_text ltx_font_bold">For the fourth term</span>, we plug in <math id="A4.SS4.SSS1.p13.m1" class="ltx_Math" alttext="{\bm{s}}=({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒔</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{s}}=({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}</annotation></semantics></math> and have</p>
<table id="A4.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex144.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex144.m2" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}-({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}-({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p13.2" class="ltx_p">From previous calculations, we have that</p>
<table id="A4.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex145.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}]=\mathbb{E}\left[\sum_{i=1}^{n}({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})({\bm{u}}^{\top}{\bm{u}}_{i})\right]=\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}]=\mathbb{E}\left[\sum_{i=1}^{n}({\bm{\beta}}_{*}^{\top}{\bm{u}}_{i})({\bm{u}}^{\top}{\bm{u}}_{i})\right]=\frac{1}{c}({\bm{\beta}}_{*}^{\top}{\bm{u}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p13.3" class="ltx_p">Using <a href="#Thmprop2" title="Proposition 2. ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2</span></a> and this result, we can then show</p>
<table id="A4.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex146.m1" class="ltx_Math" alttext="\mathbb{E}[({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}})^{2}]=\frac{1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}})^{2}]=\frac{1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p13.4" class="ltx_p">It follows that</p>
<table id="A4.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex147.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}]=\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><msup><mi>c</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{s}}^{\top}{\bm{\beta}}_{*}]=\frac{c-1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p13.5" class="ltx_p">The variance for this term is <math id="A4.SS4.SSS1.p13.m2" class="ltx_Math" alttext="O(1/d)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d)</annotation></semantics></math>, where the dominant term is a summation of <math id="A4.SS4.SSS1.p13.m3" class="ltx_Math" alttext="n=d/c" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mi>d</mi><mo>/</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">n=d/c</annotation></semantics></math> terms of <math id="A4.SS4.SSS1.p13.m4" class="ltx_Math" alttext="O(1/d^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/d^{2})</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p14" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p14.1" class="ltx_p"><span id="A4.SS4.SSS1.p14.1.1" class="ltx_text ltx_font_bold">For the fifth term</span>, we have</p>
<table id="A4.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex148.m1" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}=({\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger}{\bm{v}})^{2}=\sum_{i,j}^{n}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{i}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{j}\frac{1}{\sigma_{i}({\bm{A}})\sigma_{j}({\bm{A}})}({\bm{V}}^{\top}{\bm{v}})_{i}({\bm{V}}^{\top}{\bm{v}})_{j}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mi>n</mi></munderover><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}=({\bm{\beta}}_{*}^{\top}{\bm{A}}^{\dagger}{\bm{v}})^{2}=\sum_{i,j}^{n}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{i}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{j}\frac{1}{\sigma_{i}({\bm{A}})\sigma_{j}({\bm{A}})}({\bm{V}}^{\top}{\bm{v}})_{i}({\bm{V}}^{\top}{\bm{v}})_{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p14.2" class="ltx_p">Since <math id="A4.SS4.SSS1.p14.m1" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{U}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{U}}</annotation></semantics></math> (and <math id="A4.SS4.SSS1.p14.m2" class="ltx_Math" alttext="{\bm{V}}^{\top}{\bm{v}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><annotation encoding="application/x-tex">{\bm{V}}^{\top}{\bm{v}}</annotation></semantics></math>) are uniformly random and independent of everything else, we only have the diagonal terms when we take the expectation. By Equation <a href="#A4.E11" title="Equation 11 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>,</p>
<table id="A4.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex149.m1" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\sum_{i=1}^{n}\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{1}{n}\frac{1}{\rho^{2}}\left(\frac{c}{c-1}+o(1)\right)=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}d}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}]=\sum_{i=1}^{n}\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{1}{n}\frac{1}{\rho^{2}}\left(\frac{c}{c-1}+o(1)\right)=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}d}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p14.3" class="ltx_p">The variance for this term is <math id="A4.SS4.SSS1.p14.m3" class="ltx_Math" alttext="O(1/(\rho^{4}d^{2}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{4}d^{2}))</annotation></semantics></math> from <math id="A4.SS4.SSS1.p14.m4" class="ltx_Math" alttext="O(d^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(d^{2})</annotation></semantics></math> terms of individual variances of <math id="A4.SS4.SSS1.p14.m5" class="ltx_Math" alttext="O(1/(\rho^{4}d^{4}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>4</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{4}d^{4}))</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p15" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p15.1" class="ltx_p"><span id="A4.SS4.SSS1.p15.1.1" class="ltx_text ltx_font_bold">For the sixth term</span>, by expansion and Equation <a href="#A4.E11" title="Equation 11 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, similar to above,</p>
<table id="A4.Ex150" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex150.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=\sum_{i=1}^{n}\mathbb{E}\left[({\bm{V}}^{\top}{\bm{v}})_{i}^{2}\right]\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}({\bm{A}})}\right]=\sum_{i=1}^{n}\frac{1}{n}\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}({\bm{A}})}\right]=\frac{1}{\rho^{4}}\frac{c^{3}}{(c-1)^{3}}+o\left(\frac{1}{\rho^{4}}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>c</mi><mn>3</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>4</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]=\sum_{i=1}^{n}\mathbb{E}\left[({\bm{V}}^{\top}{\bm{v}})_{i}^{2}\right]\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}({\bm{A}})}\right]=\sum_{i=1}^{n}\frac{1}{n}\mathbb{E}\left[\frac{1}{\sigma_{i}^{4}({\bm{A}})}\right]=\frac{1}{\rho^{4}}\frac{c^{3}}{(c-1)^{3}}+o\left(\frac{1}{\rho^{4}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p15.2" class="ltx_p">The variance is <math id="A4.SS4.SSS1.p15.m1" class="ltx_Math" alttext="O\left(1/(\rho^{8}d)\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(1/(\rho^{8}d)\right)</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p16" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p16.1" class="ltx_p"><span id="A4.SS4.SSS1.p16.1.1" class="ltx_text ltx_font_bold">For the final term</span>, by expansion and Equation <a href="#A4.E11" title="Equation 11 ‣ Proof. ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>,</p>
<table id="A4.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex151.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\|{\bm{k}}\|^{2}\right]=\sum_{i=1}^{n}\mathbb{E}\left[({\bm{u}}^{\top}{\bm{U}})_{i}^{2}\right]\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}({\bm{A}})}\right]=\frac{1}{\rho^{2}}\frac{n}{d}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)=\frac{1}{\rho^{2}}\frac{1}{c-1}+o\left(\frac{1}{\rho^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>n</mi><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\|{\bm{k}}\|^{2}\right]=\sum_{i=1}^{n}\mathbb{E}\left[({\bm{u}}^{\top}{\bm{U}})_{i}^{2}\right]\mathbb{E}\left[\frac{1}{\sigma_{i}^{2}({\bm{A}})}\right]=\frac{1}{\rho^{2}}\frac{n}{d}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)=\frac{1}{\rho^{2}}\frac{1}{c-1}+o\left(\frac{1}{\rho^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p16.2" class="ltx_p">The variance is <math id="A4.SS4.SSS1.p16.m1" class="ltx_Math" alttext="O\left(1/(\rho^{4}n)\right)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">O\left(1/(\rho^{4}n)\right)</annotation></semantics></math>.
∎</p>
</div>
</div>
<div id="Thmlemma11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma11.2" class="ltx_text ltx_font_bold">Lemma 11</span></span><span id="Thmlemma11.3" class="ltx_text ltx_font_bold"> </span>(Zero Expectation)<span id="Thmlemma11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma11.p1" class="ltx_para">
<p id="Thmlemma11.p1.1" class="ltx_p"><span id="Thmlemma11.p1.1.1" class="ltx_text ltx_font_italic">In the setting of <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have the following expectations for</span></p>
<ol id="A4.I7" class="ltx_enumerate">
<li id="A4.I7.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I7.ix1.p1" class="ltx_para">
<p id="A4.I7.ix1.p1.1" class="ltx_p"><math id="A4.I7.ix1.p1.m1" class="ltx_Math" alttext="\forall c" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\forall c</annotation></semantics></math><span id="A4.I7.ix1.p1.1.1" class="ltx_text ltx_font_italic">, </span><math id="A4.I7.ix1.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}]=0</annotation></semantics></math><span id="A4.I7.ix1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A4.I7.ix1.p1.m3" class="ltx_Math" alttext="\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*})=O(1/(\rho^{2}d))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*})=O(1/(\rho^{2}d))</annotation></semantics></math></p>
</div></li>
<li id="A4.I7.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I7.ix2.p1" class="ltx_para">
<p id="A4.I7.ix2.p1.1" class="ltx_p"><span id="A4.I7.ix2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A4.I7.ix2.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I7.ix2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I7.ix2.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}]=0</annotation></semantics></math><span id="A4.I7.ix2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="A4.I7.ix2.p1.m3" class="ltx_Math" alttext="\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*})=O(1/(\rho^{2}d^{2}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*})=O(1/(\rho^{2}d^{2}))</annotation></semantics></math></p>
</div></li>
<li id="A4.I7.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A4.I7.ix3.p1" class="ltx_para">
<p id="A4.I7.ix3.p1.1" class="ltx_p"><span id="A4.I7.ix3.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A4.I7.ix3.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I7.ix3.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I7.ix3.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{h}}{\bm{\beta}}_{*}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{h}}{\bm{\beta}}_{*}]=0</annotation></semantics></math><span id="A4.I7.ix3.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="A4.I7.ix3.p1.m3" class="ltx_Math" alttext="\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{h}}{\bm{\beta}}_{*})=O(1/(\rho^{2}d))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}({\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{h}}{\bm{\beta}}_{*})=O(1/(\rho^{2}d))</annotation></semantics></math></p>
</div></li>
<li id="A4.I7.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4. </span> 
<div id="A4.I7.ix4.p1" class="ltx_para">
<p id="A4.I7.ix4.p1.1" class="ltx_p"><math id="A4.I7.ix4.p1.m1" class="ltx_Math" alttext="\forall c" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\forall c</annotation></semantics></math><span id="A4.I7.ix4.p1.1.1" class="ltx_text ltx_font_italic">, </span><math id="A4.I7.ix4.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}]=0</annotation></semantics></math><span id="A4.I7.ix4.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A4.I7.ix4.p1.m3" class="ltx_Math" alttext="\mathrm{Var}({\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top})=O(1/(\rho^{6}d))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}({\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top})=O(1/(\rho^{6}d))</annotation></semantics></math></p>
</div></li>
<li id="A4.I7.ix5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5. </span> 
<div id="A4.I7.ix5.p1" class="ltx_para">
<p id="A4.I7.ix5.p1.1" class="ltx_p"><span id="A4.I7.ix5.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="A4.I7.ix5.p1.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math><span id="A4.I7.ix5.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A4.I7.ix5.p1.m2" class="ltx_Math" alttext="\mathbb{E}[{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}]=0</annotation></semantics></math><span id="A4.I7.ix5.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="A4.I7.ix5.p1.m3" class="ltx_Math" alttext="\mathrm{Var}({\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*})=O(1/(\rho^{2}d))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Var}({\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*})=O(1/(\rho^{2}d))</annotation></semantics></math></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.SS4.SSS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS1.p17" class="ltx_para">
<p id="A4.SS4.SSS1.p17.1" class="ltx_p"><span id="A4.SS4.SSS1.p17.1.1" class="ltx_text">Similar to Lemma <a href="#Thmlemma10" title="Lemma 10 (General Terms). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, for all these terms, we evaluate the expectation using the SVD <math id="A4.SS4.SSS1.p17.m1" class="ltx_Math" alttext="{\bm{A}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>=</mo><mrow><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑽</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}={\bm{U}}{\bm{\Sigma}}{\bm{V}}^{\top}</annotation></semantics></math>, with <math id="A4.SS4.SSS1.p17.m2" class="ltx_Math" alttext="{\bm{A}}^{\dagger}={\bm{V}}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑨</mi><mo>†</mo></msup><mo>=</mo><mrow><mi>𝑽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">{\bm{A}}^{\dagger}={\bm{V}}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.SSS1.p18" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p18.1" class="ltx_p"><span id="A4.SS4.SSS1.p18.1.1" class="ltx_text ltx_font_bold">For the first term</span>, we note that</p>
<table id="A4.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex152.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}^{\top}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex152.m2" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{v}}^{\top}{\bm{V}}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}{\bm{\beta}}_{*}=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{\min(n,d)}({\bm{v}}^{\top}{\bm{V}})_{i}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}({\bm{A}})}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑽</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{v}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}=({\bm{\beta}}_{*}^{\top}{\bm{u}}){\bm{v}}^{\top}{\bm{V}}{\bm{\Sigma}}^{\dagger}{\bm{U}}^{\top}{\bm{\beta}}_{*}=({\bm{\beta}}_{*}^{\top}{\bm{u}})\sum_{i=1}^{\min(n,d)}({\bm{v}}^{\top}{\bm{V}})_{i}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}({\bm{A}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p18.2" class="ltx_p">Since <math id="A4.SS4.SSS1.p18.m1" class="ltx_Math" alttext="{\bm{A}}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">{\bm{A}}</annotation></semantics></math> is isotropic Gaussian, again we have that <math id="A4.SS4.SSS1.p18.m2" class="ltx_Math" alttext="{\bm{U}},{\bm{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>,</mo><mi>𝑽</mi></mrow><annotation encoding="application/x-tex">{\bm{U}},{\bm{V}}</annotation></semantics></math> are uniformly random orthogonal matrices. Thus, <math id="A4.SS4.SSS1.p18.m3" class="ltx_Math" alttext="{\bm{v}}^{\top}{\bm{V}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑽</mi></mrow><annotation encoding="application/x-tex">{\bm{v}}^{\top}{\bm{V}}</annotation></semantics></math> and <math id="A4.SS4.SSS1.p18.m4" class="ltx_Math" alttext="{\bm{U}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">{\bm{U}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math> are uniformly random vectors on a spheres of radius <math id="A4.SS4.SSS1.p18.m5" class="ltx_Math" alttext="\|{\bm{v}}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><mi>𝒗</mi><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|{\bm{v}}\|</annotation></semantics></math> and <math id="A4.SS4.SSS1.p18.m6" class="ltx_Math" alttext="\|{\bm{\beta}}_{*}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|{\bm{\beta}}_{*}\|</annotation></semantics></math> respectively. In particular, they are independent and have mean zero, which implies</p>
<table id="A4.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex153.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}^{\top}\right]=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}^{\top}\right]=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p18.3" class="ltx_p">The variance will be <math id="A4.SS4.SSS1.p18.m7" class="ltx_Math" alttext="O(1/(\rho^{2}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{2}d))</annotation></semantics></math> as a summation of <math id="A4.SS4.SSS1.p18.m8" class="ltx_Math" alttext="O(d)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(d)</annotation></semantics></math> terms of <math id="A4.SS4.SSS1.p18.m9" class="ltx_Math" alttext="O(1/(\rho^{2}d^{2}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{2}d^{2}))</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p19" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p19.1" class="ltx_p"><span id="A4.SS4.SSS1.p19.1.1" class="ltx_text ltx_font_bold">For the second term</span>, we note that</p>
<table id="A4.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex154.m1" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}=\sum_{i=1}^{\min(n,d)}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{i}({\bm{U}}^{\top}{\bm{u}})_{i}\quad\text{ and }\quad{\bm{h}}{\bm{\beta}}_{*}=\sum_{i=1}^{\min(n,d)}({\bm{v}}^{\top}{\bm{V}})_{i}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}({\bm{A}})}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑽</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}=\sum_{i=1}^{\min(n,d)}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{i}({\bm{U}}^{\top}{\bm{u}})_{i}\quad\text{ and }\quad{\bm{h}}{\bm{\beta}}_{*}=\sum_{i=1}^{\min(n,d)}({\bm{v}}^{\top}{\bm{V}})_{i}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}({\bm{A}})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p19.2" class="ltx_p">Multiplying the two together yields</p>
<table id="A4.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex155.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}=\sum_{i,j}^{\min(n,d)}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{i}({\bm{U}}^{\top}{\bm{u}})_{i}({\bm{v}}^{\top}{\bm{V}})_{j}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{j}\frac{1}{\sigma_{i}({\bm{A}})}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒗</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑽</mi></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}=\sum_{i,j}^{\min(n,d)}({\bm{\beta}}_{*}^{\top}{\bm{U}})_{i}({\bm{U}}^{\top}{\bm{u}})_{i}({\bm{v}}^{\top}{\bm{V}})_{j}({\bm{U}}^{\top}{\bm{\beta}}_{*})_{j}\frac{1}{\sigma_{i}({\bm{A}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p19.3" class="ltx_p">We note that <math id="A4.SS4.SSS1.p19.m1" class="ltx_Math" alttext="v^{\top}V" display="inline" intent=":literal"><semantics><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v^{\top}V</annotation></semantics></math> is a uniformly random mean zero vector independent of everything else in the summation. Hence, the expectation is equal to zero, and similar to Lemma <span class="ltx_ref ltx_missing_label ltx_ref_self"></span>, the variance of this term is <math id="A4.SS4.SSS1.p19.m2" class="ltx_Math" alttext="O(1/(\rho^{2}d^{2}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{2}d^{2}))</annotation></semantics></math> (a summation of <math id="A4.SS4.SSS1.p19.m3" class="ltx_Math" alttext="O(d^{2})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(d^{2})</annotation></semantics></math> terms of <math id="A4.SS4.SSS1.p19.m4" class="ltx_Math" alttext="O(1/(\rho^{2}d^{4}))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>4</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{2}d^{4}))</annotation></semantics></math>).</p>
</div>
<div id="A4.SS4.SSS1.p20" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p20.1" class="ltx_p"><span id="A4.SS4.SSS1.p20.1.1" class="ltx_text ltx_font_bold">For the third term</span>, we have that</p>
<table id="A4.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex156.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{h}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{s}}{\bm{h}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex156.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}{\bm{h}}{\bm{\beta}}_{*}={\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}-{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝑰</mi><mo>−</mo><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>=</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}({\bm{I}}-{\bm{A}}{\bm{A}}^{\dagger}){\bm{u}}{\bm{h}}{\bm{\beta}}_{*}={\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}-{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p20.2" class="ltx_p">Then using the previous two parts, we get that each term has mean zero. Thus, we get the needed result. Using <a href="#Thmlemma34" title="Lemma 34 (Variance of a sum). ‣ Appendix E Probability Lemmas ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">34</span></a> and the first two terms, the variance of this term is <math id="A4.SS4.SSS1.p20.m1" class="ltx_Math" alttext="O(1/(\rho^{2}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{2}d))</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p21" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p21.1" class="ltx_p"><span id="A4.SS4.SSS1.p21.1.1" class="ltx_text ltx_font_bold">For the fourth term</span>, we have that:</p>
<table id="A4.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex157.m1" class="ltx_Math" alttext="{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}={\bm{u}}{\bm{U}}{\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}{\bm{\Sigma}}^{\dagger\top}{\bm{V}}^{\top}{\bm{v}}=\sum_{i=1}^{\min(n,d)}({\bm{u}}^{\top}{\bm{U}})_{i}\,({\bm{V}}^{\top}{\bm{v}})_{i}\frac{1}{\sigma_{i}({\bm{A}})^{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>=</mo><mrow><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></munderover><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑼</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow><mn>3</mn></msup></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}={\bm{u}}{\bm{U}}{\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}{\bm{\Sigma}}^{\dagger\top}{\bm{V}}^{\top}{\bm{v}}=\sum_{i=1}^{\min(n,d)}({\bm{u}}^{\top}{\bm{U}})_{i}\,({\bm{V}}^{\top}{\bm{v}})_{i}\frac{1}{\sigma_{i}({\bm{A}})^{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p21.2" class="ltx_p">Similarly, using the independence of <math id="A4.SS4.SSS1.p21.m1" class="ltx_Math" alttext="{\bm{U}},{\bm{\Sigma}},{\bm{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>,</mo><mi>𝚺</mi><mo>,</mo><mi>𝑽</mi></mrow><annotation encoding="application/x-tex">{\bm{U}},{\bm{\Sigma}},{\bm{V}}</annotation></semantics></math> and uniformly random entries, we get mean zero and variance <math id="A4.SS4.SSS1.p21.m2" class="ltx_Math" alttext="O(1/(\rho^{6}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{6}d))</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS1.p22" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS1.p22.1" class="ltx_p"><span id="A4.SS4.SSS1.p22.1.1" class="ltx_text ltx_font_bold">For the last term</span>, we have that:</p>
<table id="A4.Ex158" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex158.m1" class="ltx_Math" alttext="{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}=\sum_{i=\min(n,d)}^{r}({\bm{V}}^{\top}{\bm{v}})_{i}\,({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}({\bm{A}})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>r</mi></munderover><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝑨</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}=\sum_{i=\min(n,d)}^{r}({\bm{V}}^{\top}{\bm{v}})_{i}\,({\bm{U}}^{\top}{\bm{\beta}}_{*})_{i}\frac{1}{\sigma_{i}({\bm{A}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS1.p22.2" class="ltx_p">Using the independence of <math id="A4.SS4.SSS1.p22.m1" class="ltx_Math" alttext="{\bm{U}},{\bm{\Sigma}},{\bm{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>,</mo><mi>𝚺</mi><mo>,</mo><mi>𝑽</mi></mrow><annotation encoding="application/x-tex">{\bm{U}},{\bm{\Sigma}},{\bm{V}}</annotation></semantics></math> and uniformly random entries, we get mean zero and variance <math id="A4.SS4.SSS1.p22.m2" class="ltx_Math" alttext="O(1/(\rho^{2}d))" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(1/(\rho^{2}d))</annotation></semantics></math>.
∎</p>
</div>
</div>
</section>
<section id="A4.SS4.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.4.2 </span>Step 3(b): Bounding the Higher Moments</h4>

<div id="A4.SS4.SSS2.p1" class="ltx_para">
<p id="A4.SS4.SSS2.p1.1" class="ltx_p">To bound the higher moments, we will the following Gaussian hypercontractivity lemma.</p>
</div>
<div id="Thmlemma12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma12.2" class="ltx_text ltx_font_bold">Lemma 12</span></span><span id="Thmlemma12.3" class="ltx_text ltx_font_bold"> </span>(Gaussian Hypercontractivity Inequality)<span id="Thmlemma12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma12.p1" class="ltx_para">
<p id="Thmlemma12.p1.1" class="ltx_p"><span id="Thmlemma12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma12.p1.m1" class="ltx_Math" alttext="G\sim\mathcal{N}(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\sim\mathcal{N}(0,1)</annotation></semantics></math> be a standard Gaussian random variable. Let <math id="Thmlemma12.p1.m2" class="ltx_Math" alttext="f:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> be a degree <math id="Thmlemma12.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> polynomial.
Then, for any <math id="Thmlemma12.p1.m4" class="ltx_Math" alttext="q\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q\geq 2</annotation></semantics></math>, the <math id="Thmlemma12.p1.m5" class="ltx_Math" alttext="L_{q}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>q</mi></msub><annotation encoding="application/x-tex">L_{q}</annotation></semantics></math> norm of <math id="Thmlemma12.p1.m6" class="ltx_Math" alttext="f(G)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(G)</annotation></semantics></math> is bounded by its <math id="Thmlemma12.p1.m7" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> norm as follows:</span></p>
<table id="A4.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex159.m1" class="ltx_Math" alttext="\|f(G)\|_{L_{q}}\leq(q-1)^{k/2}\|f(G)\|_{L_{2}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|f(G)\|_{L_{q}}\leq(q-1)^{k/2}\|f(G)\|_{L_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma12.p1.2" class="ltx_p"><span id="Thmlemma12.p1.2.1" class="ltx_text ltx_font_italic">where the <math id="Thmlemma12.p1.m8" class="ltx_Math" alttext="L_{p}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>p</mi></msub><annotation encoding="application/x-tex">L_{p}</annotation></semantics></math> norm of a random variable <math id="Thmlemma12.p1.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is defined as <math id="Thmlemma12.p1.m10" class="ltx_Math" alttext="\|X\|_{L_{p}}=(\mathbb{E}[|X|^{p}])^{1/p}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">|</mo><mi>X</mi><mo stretchy="false">|</mo></mrow><mi>p</mi></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\|X\|_{L_{p}}=(\mathbb{E}[|X|^{p}])^{1/p}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS4.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS2.p2" class="ltx_para">
<p id="A4.SS4.SSS2.p2.1" class="ltx_p"><span id="A4.SS4.SSS2.p2.1.1" class="ltx_text">Follows directly from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>, Lemma 20]</cite>.
∎</span></p>
</div>
</div>
<div id="Thmlemma13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma13.2" class="ltx_text ltx_font_bold">Lemma 13</span></span><span id="Thmlemma13.3" class="ltx_text ltx_font_bold"> </span>(Multivariate Gaussian Hypercontractivity)<span id="Thmlemma13.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma13.p1" class="ltx_para">
<p id="Thmlemma13.p1.1" class="ltx_p"><span id="Thmlemma13.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma13.p1.m1" class="ltx_Math" alttext="G=(G_{1},\ldots,G_{M})\sim\mathcal{N}(0,I_{M})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>G</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G=(G_{1},\ldots,G_{M})\sim\mathcal{N}(0,I_{M})</annotation></semantics></math> and let <math id="Thmlemma13.p1.m2" class="ltx_Math" alttext="P:\mathbb{R}^{M}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>M</mi></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">P:\mathbb{R}^{M}\to\mathbb{R}</annotation></semantics></math> be a polynomial of total degree <math id="Thmlemma13.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. Consider the Hermite expansion of <math id="Thmlemma13.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math></span></p>
<table id="A4.Ex160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex160.m1" class="ltx_Math" alttext="P(x)=\sum_{\alpha\in\mathbb{N}^{m},|\alpha|\leq r}c_{\alpha}{\bm{H}}_{\alpha}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>α</mi><mo>∈</mo><msup><mi>ℕ</mi><mi>m</mi></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></mrow></munder><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(x)=\sum_{\alpha\in\mathbb{N}^{m},|\alpha|\leq r}c_{\alpha}{\bm{H}}_{\alpha}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p1.2" class="ltx_p"><span id="Thmlemma13.p1.2.1" class="ltx_text ltx_font_italic">with coefficient random and independent of <math id="Thmlemma13.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Then there exists a constant <math id="Thmlemma13.p1.m6" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> that is only dependent on <math id="Thmlemma13.p1.m7" class="ltx_Math" alttext="M,r" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>,</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">M,r</annotation></semantics></math> such that for any <math id="Thmlemma13.p1.m8" class="ltx_Math" alttext="q\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q\geq 2</annotation></semantics></math>,</span></p>
<table id="A4.Ex161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex161.m1" class="ltx_Math" alttext="\|P(G)\|_{L_{q}}\leq C(q-1)^{r/2}\left(\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}^{2}\alpha!\right)^{1/2}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>!</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\|P(G)\|_{L_{q}}\leq C(q-1)^{r/2}\left(\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}^{2}\alpha!\right)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p1.3" class="ltx_p"><span id="Thmlemma13.p1.3.1" class="ltx_text ltx_font_italic">Further, if for all <math id="Thmlemma13.p1.m9" class="ltx_Math" alttext="|\alpha|\leq r" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">|\alpha|\leq r</annotation></semantics></math>, we have that <math id="Thmlemma13.p1.m10" class="ltx_Math" alttext="\|c_{\alpha}\|_{L_{q}}^{2}\leq C_{q}^{2}\|c_{\alpha}\|_{L_{2}}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mi>C</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\|c_{\alpha}\|_{L_{q}}^{2}\leq C_{q}^{2}\|c_{\alpha}\|_{L_{2}}^{2}</annotation></semantics></math>, then</span></p>
<table id="A4.Ex162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex162.m1" class="ltx_Math" alttext="\|P(G)\|_{L_{q}}\leq C(q-1)^{r/2}\|P(G)\|_{L_{2}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\|P(G)\|_{L_{q}}\leq C(q-1)^{r/2}\|P(G)\|_{L_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma13.p1.4" class="ltx_p"><span id="Thmlemma13.p1.4.1" class="ltx_text ltx_font_italic">Where the <math id="Thmlemma13.p1.m11" class="ltx_Math" alttext="L_{p}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>p</mi></msub><annotation encoding="application/x-tex">L_{p}</annotation></semantics></math> norm is over all of the randomness. Furthermore,</span></p>
</div>
</div>
<div id="A4.SS4.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS2.p3" class="ltx_para">
<p id="A4.SS4.SSS2.p3.1" class="ltx_p"><span id="A4.SS4.SSS2.p3.1.1" class="ltx_text">Let <math id="A4.SS4.SSS2.p3.m1" class="ltx_Math" alttext="H_{k}:\mathbb{R}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>k</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">H_{k}:\mathbb{R}\to\mathbb{R}</annotation></semantics></math> be the probabilist Hermite polynomial. Given <math id="A4.SS4.SSS2.p3.m2" class="ltx_Math" alttext="\alpha\in\mathbb{N}^{M}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><msup><mi>ℕ</mi><mi>M</mi></msup></mrow><annotation encoding="application/x-tex">\alpha\in\mathbb{N}^{M}</annotation></semantics></math>, define</span></p>
<table id="A4.Ex163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex163.m1" class="ltx_Math" alttext="{\bm{H}}_{\alpha}(x):=\prod_{j=1}^{M}H_{\alpha_{j}}(x_{j})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mrow><msub><mi>H</mi><msub><mi>α</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{H}}_{\alpha}(x):=\prod_{j=1}^{M}H_{\alpha_{j}}(x_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p3.2" class="ltx_p"><span id="A4.SS4.SSS2.p3.2.1" class="ltx_text">Then since <math id="A4.SS4.SSS2.p3.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is degree <math id="A4.SS4.SSS2.p3.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, then we can decompose</span></p>
<table id="A4.Ex164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex164.m1" class="ltx_Math" alttext="P(x)=\sum_{\alpha\in\mathbb{N}^{m},|\alpha|\leq r}c_{\alpha}{\bm{H}}_{\alpha}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>α</mi><mo>∈</mo><msup><mi>ℕ</mi><mi>m</mi></msup></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></mrow></munder><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(x)=\sum_{\alpha\in\mathbb{N}^{m},|\alpha|\leq r}c_{\alpha}{\bm{H}}_{\alpha}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p3.3" class="ltx_p"><span id="A4.SS4.SSS2.p3.3.1" class="ltx_text">Here <math id="A4.SS4.SSS2.p3.m5" class="ltx_Math" alttext="|\alpha|=\sum_{j}\alpha_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><msub><mi>α</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">|\alpha|=\sum_{j}\alpha_{j}</annotation></semantics></math>. Since the Hermite polynomials are orthogonal, we can see that</span></p>
<table id="A4.Ex165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex165.m1" class="ltx_Math" alttext="\int_{\mathbb{R}^{M}}{\bm{H}}_{\alpha}(x){\bm{H}}_{\tilde{\alpha}}(x)\gamma_{M}(x)=\delta_{\alpha\tilde{\alpha}}\prod_{j=1}^{M}\alpha_{j}!," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>M</mi></msup></msub><mrow><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mover accent="true"><mi>α</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>δ</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>α</mi><mo>~</mo></mover></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mrow><msub><mi>α</mi><mi>j</mi></msub><mo>!</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int_{\mathbb{R}^{M}}{\bm{H}}_{\alpha}(x){\bm{H}}_{\tilde{\alpha}}(x)\gamma_{M}(x)=\delta_{\alpha\tilde{\alpha}}\prod_{j=1}^{M}\alpha_{j}!,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p3.4" class="ltx_p"><span id="A4.SS4.SSS2.p3.4.1" class="ltx_text">where <math id="A4.SS4.SSS2.p3.m6" class="ltx_Math" alttext="\gamma_{M}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>M</mi></msub><annotation encoding="application/x-tex">\gamma_{M}</annotation></semantics></math> is the density for an <math id="A4.SS4.SSS2.p3.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>-dimensional standard normal distribution.</span></p>
<table id="A4.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex166"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex166.m1" class="ltx_Math" alttext="\displaystyle\|P(x)\|_{L_{2}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\|P(x)\|_{L_{2}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex166.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{{\bm{\Sigma}}}\left[\int_{\mathbb{R}^{M}}|P(x)|^{2}\gamma_{M}(x)dx\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝚺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>M</mi></msup></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{{\bm{\Sigma}}}\left[\int_{\mathbb{R}^{M}}|P(x)|^{2}\gamma_{M}(x)dx\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex167"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex167.m1" class="ltx_Math" alttext="\displaystyle=\sum_{|\alpha|\leq r}\sum_{|\tilde{\alpha}|\leq r}\mathbb{E}_{{\bm{\Sigma}}}\left[c_{\alpha}c_{\tilde{\alpha}}\right]\int{\bm{H}}_{\alpha}(x){\bm{H}}_{\tilde{\alpha}}(x)\gamma_{M}(x)dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mover accent="true"><mi>α</mi><mo>~</mo></mover><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder></mstyle><mrow><msub><mi>𝔼</mi><mi>𝚺</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mover accent="true"><mi>α</mi><mo>~</mo></mover></msub></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mover accent="true"><mi>α</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{|\alpha|\leq r}\sum_{|\tilde{\alpha}|\leq r}\mathbb{E}_{{\bm{\Sigma}}}\left[c_{\alpha}c_{\tilde{\alpha}}\right]\int{\bm{H}}_{\alpha}(x){\bm{H}}_{\tilde{\alpha}}(x)\gamma_{M}(x)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex168"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex168.m1" class="ltx_Math" alttext="\displaystyle=\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{2}}^{2}\alpha!" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder></mstyle><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>!</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{2}}^{2}\alpha!</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p3.5" class="ltx_p"><span id="A4.SS4.SSS2.p3.5.1" class="ltx_text">where <math id="A4.SS4.SSS2.p3.m8" class="ltx_Math" alttext="\displaystyle\alpha!:=\prod_{j=1}^{M}\alpha_{j}!" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>!</mo></mrow><mo>:=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><msub><mi>α</mi><mi>j</mi></msub><mo>!</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha!:=\prod_{j=1}^{M}\alpha_{j}!</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.SSS2.p4" class="ltx_para ltx_noindent">
<p id="A4.SS4.SSS2.p4.1" class="ltx_p">Then using the 1D Gaussian Hypercontractivity (Lemma <a href="#Thmlemma12" title="Lemma 12 (Gaussian Hypercontractivity Inequality). ‣ D.4.2 Step 3(b): Bounding the Higher Moments ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>, we see that</p>
<table id="A4.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex169"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex169.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{H}}_{\alpha}(x)\|_{L_{q}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><annotation encoding="application/x-tex">\displaystyle\|{\bm{H}}_{\alpha}(x)\|_{L_{q}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex169.m2" class="ltx_Math" alttext="\displaystyle=\prod_{j=1}^{M}\|H_{\alpha_{j}}(x_{j})\|_{L_{q}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>H</mi><msub><mi>α</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\prod_{j=1}^{M}\|H_{\alpha_{j}}(x_{j})\|_{L_{q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex170"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex170.m1" class="ltx_Math" alttext="\displaystyle\leq\prod_{j=1}^{M}(q-1)^{\alpha_{j}/2}\|H_{\alpha_{j}}(x_{j})\|_{L_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><msub><mi>α</mi><mi>j</mi></msub><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>H</mi><msub><mi>α</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\prod_{j=1}^{M}(q-1)^{\alpha_{j}/2}\|H_{\alpha_{j}}(x_{j})\|_{L_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex171"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex171.m1" class="ltx_Math" alttext="\displaystyle=(q-1)^{|\alpha|/2}\prod_{j=1}^{M}\sqrt{\alpha_{j}!}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><msqrt><mrow><msub><mi>α</mi><mi>j</mi></msub><mo>!</mo></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(q-1)^{|\alpha|/2}\prod_{j=1}^{M}\sqrt{\alpha_{j}!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex172"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex172.m1" class="ltx_Math" alttext="\displaystyle=(q-1)^{|\alpha|/2}\sqrt{\alpha!}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>α</mi><mo>!</mo></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(q-1)^{|\alpha|/2}\sqrt{\alpha!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.2" class="ltx_p">Thus, using the triangle inequality we get that</p>
<table id="A4.Ex173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex173.m1" class="ltx_Math" alttext="\|P(x)\|_{L_{q}}\leq\sum_{|\alpha|\leq r}\|c_{\alpha}{\bm{H}}_{\alpha}(x)\|_{L_{q}}=\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}\|{\bm{H}}_{\alpha}(x)\|_{L_{q}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\|P(x)\|_{L_{q}}\leq\sum_{|\alpha|\leq r}\|c_{\alpha}{\bm{H}}_{\alpha}(x)\|_{L_{q}}=\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}\|{\bm{H}}_{\alpha}(x)\|_{L_{q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.3" class="ltx_p">Thus</p>
<table id="A4.Ex174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex174.m1" class="ltx_Math" alttext="\|P(x)\|_{L_{q}}\leq\sum_{|\alpha|\leq r}\|c_{\alpha}{\bm{H}}_{\alpha}(x)\|_{L_{q}}\leq\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}(q-1)^{|\alpha|/2}\sqrt{\alpha!}\leq(q-1)^{r/2}\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}\sqrt{\alpha!}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>c</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑯</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub></mrow><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>α</mi><mo>!</mo></mrow></msqrt></mrow></mrow><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>α</mi><mo>!</mo></mrow></msqrt></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\|P(x)\|_{L_{q}}\leq\sum_{|\alpha|\leq r}\|c_{\alpha}{\bm{H}}_{\alpha}(x)\|_{L_{q}}\leq\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}(q-1)^{|\alpha|/2}\sqrt{\alpha!}\leq(q-1)^{r/2}\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}\sqrt{\alpha!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.4" class="ltx_p">Then using Cauchy-Schwartz, we get that</p>
<table id="A4.Ex175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex175.m1" class="ltx_Math" alttext="\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}\sqrt{\alpha!}\leq\left(\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}^{2}\alpha!\right)^{1/2}\left(\sum_{|\alpha|\leq r}1\right)^{1/2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>α</mi><mo>!</mo></mrow></msqrt></mrow></mrow><mo>≤</mo><mrow><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>!</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mn>1</mn></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}\sqrt{\alpha!}\leq\left(\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}^{2}\alpha!\right)^{1/2}\left(\sum_{|\alpha|\leq r}1\right)^{1/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.5" class="ltx_p">Finally, we note that</p>
<table id="A4.Ex176" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex176.m1" class="ltx_Math" alttext="C_{M,r}:=\left(\sum_{|\alpha|\leq r}1\right)^{1/2}" display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>M</mi><mo>,</mo><mi>r</mi></mrow></msub><mo>:=</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mn>1</mn></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">C_{M,r}:=\left(\sum_{|\alpha|\leq r}1\right)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.6" class="ltx_p">is some universal constant that only depends on <math id="A4.SS4.SSS2.p4.m1" class="ltx_Math" alttext="M,r" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>,</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">M,r</annotation></semantics></math>. Thus, we get that</p>
<table id="A4.Ex177" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex177.m1" class="ltx_Math" alttext="\|P(x)\|_{L_{q}}\leq C_{M,r}\,(q-1)^{r/2}\,\left(\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}^{2}\alpha!\right)^{1/2}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mi>M</mi><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">|</mo><mi>α</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>r</mi></mrow></munder><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>!</mo></mrow></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\|P(x)\|_{L_{q}}\leq C_{M,r}\,(q-1)^{r/2}\,\left(\sum_{|\alpha|\leq r}\|c_{\alpha}\|_{L_{q}}^{2}\alpha!\right)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.7" class="ltx_p">Using the assumption</p>
<table id="A4.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex178.m1" class="ltx_Math" alttext="\|c_{\alpha}\|_{L_{q}}^{2}\leq C_{q}^{2}\|c_{\alpha}\|_{L_{2}}^{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub><mn>2</mn></msubsup><mo>≤</mo><mrow><msubsup><mi>C</mi><mi>q</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\|c_{\alpha}\|_{L_{q}}^{2}\leq C_{q}^{2}\|c_{\alpha}\|_{L_{2}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.8" class="ltx_p">Then we get</p>
<table id="A4.Ex179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex179.m1" class="ltx_Math" alttext="\|P(x)\|_{L_{q}}\leq C_{M,r}C_{q}\,(q-1)^{r/2}\,\|P(x)\|_{L_{2}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mi>M</mi><mo>,</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\|P(x)\|_{L_{q}}\leq C_{M,r}C_{q}\,(q-1)^{r/2}\,\|P(x)\|_{L_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p4.9" class="ltx_p">∎</p>
</div>
</div>
<div id="Thmlemma14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma14.2" class="ltx_text ltx_font_bold">Lemma 14</span></span><span id="Thmlemma14.3" class="ltx_text ltx_font_bold"> </span>(Product Spherical Hypercontractivity)<span id="Thmlemma14.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma14.p1" class="ltx_para">
<p id="Thmlemma14.p1.1" class="ltx_p"><span id="Thmlemma14.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma14.p1.m1" class="ltx_Math" alttext="l_{1},l_{2},l_{3}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>,</mo><msub><mi>l</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>l</mi><mn>3</mn></msub><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">l_{1},l_{2},l_{3}\geq 0</annotation></semantics></math>, let <math id="Thmlemma14.p1.m2" class="ltx_Math" alttext="\Theta_{1}\sim\mathrm{Unif}(S^{l_{1}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><msub><mi>l</mi><mn>1</mn></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta_{1}\sim\mathrm{Unif}(S^{l_{1}})</annotation></semantics></math>, <math id="Thmlemma14.p1.m3" class="ltx_Math" alttext="\Theta_{2}\sim\mathrm{Unif}(S^{l_{2}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><msub><mi>l</mi><mn>2</mn></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta_{2}\sim\mathrm{Unif}(S^{l_{2}})</annotation></semantics></math>, <math id="Thmlemma14.p1.m4" class="ltx_Math" alttext="\Theta_{3}\sim\mathrm{Unif}(S^{l_{3}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><msub><mi>l</mi><mn>3</mn></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta_{3}\sim\mathrm{Unif}(S^{l_{3}})</annotation></semantics></math> be independent, and let <math id="Thmlemma14.p1.m5" class="ltx_Math" alttext="H:\mathbb{R}^{l_{1}+1}\times\mathbb{R}^{l_{2}+1}\times\mathbb{R}^{l_{3}+1}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><msub><mi>l</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><msub><mi>l</mi><mn>3</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">H:\mathbb{R}^{l_{1}+1}\times\mathbb{R}^{l_{2}+1}\times\mathbb{R}^{l_{3}+1}\to\mathbb{R}</annotation></semantics></math> be a multi-homogeneous polynomial of total degree <math id="Thmlemma14.p1.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. Then for every <math id="Thmlemma14.p1.m7" class="ltx_Math" alttext="q\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q\geq 2</annotation></semantics></math>,</span></p>
<table id="A4.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex180.m1" class="ltx_Math" alttext="\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{q}}\ \leq\ C_{r,q}(q-1)^{r/2}\,\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{2}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{q}}\ \leq\ C_{r,q}(q-1)^{r/2}\,\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma14.p1.2" class="ltx_p"><span id="Thmlemma14.p1.2.1" class="ltx_text ltx_font_italic">where the norms are with respect to the product measure. For homogeneous polynomials, the constant is independent of the dimension.</span></p>
</div>
</div>
<div id="A4.SS4.SSS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS2.p5" class="ltx_para">
<p id="A4.SS4.SSS2.p5.1" class="ltx_p"><math id="A4.SS4.SSS2.p5.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="A4.SS4.SSS2.p5.1.1" class="ltx_text"> is multi-homogeneous of degrees <math id="A4.SS4.SSS2.p5.m2" class="ltx_Math" alttext="r_{1},r_{2},r_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>r</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">r_{1},r_{2},r_{3}</annotation></semantics></math> with <math id="A4.SS4.SSS2.p5.m3" class="ltx_Math" alttext="r_{1}+r_{2}+r_{3}=r" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>+</mo><msub><mi>r</mi><mn>2</mn></msub><mo>+</mo><msub><mi>r</mi><mn>3</mn></msub></mrow><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r_{1}+r_{2}+r_{3}=r</annotation></semantics></math>. Let <math id="A4.SS4.SSS2.p5.m4" class="ltx_Math" alttext="G_{1}\sim\mathcal{N}(0,I_{l_{1}+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mn>1</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{1}\sim\mathcal{N}(0,I_{l_{1}+1})</annotation></semantics></math>, <math id="A4.SS4.SSS2.p5.m5" class="ltx_Math" alttext="G_{2}\sim\mathcal{N}(0,I_{l_{2}+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mn>2</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mrow><msub><mi>l</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{2}\sim\mathcal{N}(0,I_{l_{2}+1})</annotation></semantics></math>, <math id="A4.SS4.SSS2.p5.m6" class="ltx_Math" alttext="G_{3}\sim\mathcal{N}(0,I_{l_{3}+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mn>3</mn></msub><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mrow><msub><mi>l</mi><mn>3</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{3}\sim\mathcal{N}(0,I_{l_{3}+1})</annotation></semantics></math> be independent with polar decompositions <math id="A4.SS4.SSS2.p5.m7" class="ltx_Math" alttext="G_{i}=R_{i}\Theta_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>R</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">G_{i}=R_{i}\Theta_{i}</annotation></semantics></math>, where the <math id="A4.SS4.SSS2.p5.m8" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math>’s are independent of each other and of the <math id="A4.SS4.SSS2.p5.m9" class="ltx_Math" alttext="\Theta_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Theta_{i}</annotation></semantics></math>’s. Then</span></p>
<table id="A4.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex181.m1" class="ltx_Math" alttext="H(G_{1},G_{2},G_{3})=R_{1}^{r_{1}}R_{2}^{r_{2}}R_{3}^{r_{3}}H(\Theta_{1},\Theta_{2},\Theta_{3})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>R</mi><mn>1</mn><msub><mi>r</mi><mn>1</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mn>2</mn><msub><mi>r</mi><mn>2</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mn>3</mn><msub><mi>r</mi><mn>3</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">H(G_{1},G_{2},G_{3})=R_{1}^{r_{1}}R_{2}^{r_{2}}R_{3}^{r_{3}}H(\Theta_{1},\Theta_{2},\Theta_{3}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.2" class="ltx_p"><span id="A4.SS4.SSS2.p5.2.1" class="ltx_text">so for any <math id="A4.SS4.SSS2.p5.m10" class="ltx_Math" alttext="p&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p&gt;0</annotation></semantics></math>,</span></p>
<table id="A4.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex182.m1" class="ltx_Math" alttext="\mathbb{E}\left[\left|H(G_{1},G_{2},G_{3})\right|^{p}\right]=\left(\prod_{i=1}^{3}\mathbb{E}\left[R_{i}^{pr_{i}}\right]\right)\,\mathbb{E}\left[\left|H(\Theta_{1},\Theta_{2},\Theta_{3})\right|^{p}\right]" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>|</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mi>p</mi></msup><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>|</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mi>p</mi></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\left|H(G_{1},G_{2},G_{3})\right|^{p}\right]=\left(\prod_{i=1}^{3}\mathbb{E}\left[R_{i}^{pr_{i}}\right]\right)\,\mathbb{E}\left[\left|H(\Theta_{1},\Theta_{2},\Theta_{3})\right|^{p}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.3" class="ltx_p"><span id="A4.SS4.SSS2.p5.3.1" class="ltx_text">Then we have that</span></p>
<table id="A4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E12.m1" class="ltx_Math" alttext="\left\|H(G_{1},G_{2},G_{3})\right\|_{L_{p}}=\left(\prod_{i}(\mathbb{E}\left[R_{i}^{pr_{i}}\right])^{1/p}\right)\,\left\|H(\Theta_{1},\Theta_{2},\Theta_{3})\right\|_{L_{p}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub><mo>=</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∏</mo><mi>i</mi></munder><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>p</mi></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><msub><mi>L</mi><mi>p</mi></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\|H(G_{1},G_{2},G_{3})\right\|_{L_{p}}=\left(\prod_{i}(\mathbb{E}\left[R_{i}^{pr_{i}}\right])^{1/p}\right)\,\left\|H(\Theta_{1},\Theta_{2},\Theta_{3})\right\|_{L_{p}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.4" class="ltx_p"><span id="A4.SS4.SSS2.p5.4.1" class="ltx_text">Apply Gaussian hypercontractivity (Lemma <a href="#Thmlemma12" title="Lemma 12 (Gaussian Hypercontractivity Inequality). ‣ D.4.2 Step 3(b): Bounding the Higher Moments ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) to <math id="A4.SS4.SSS2.p5.m11" class="ltx_Math" alttext="H(G_{1},G_{2},G_{3})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(G_{1},G_{2},G_{3})</annotation></semantics></math> (total degree <math id="A4.SS4.SSS2.p5.m12" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>):</span></p>
<table id="A4.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex183.m1" class="ltx_Math" alttext="\|H(G_{1},G_{2},G_{3})\|_{L_{q}}\ \leq\ C(q-1)^{r/2}\,\|H(G_{1},G_{2},G_{3})\|_{L_{2}},\qquad q\geq 2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>q</mi><mo>≥</mo><mn>2</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|H(G_{1},G_{2},G_{3})\|_{L_{q}}\ \leq\ C(q-1)^{r/2}\,\|H(G_{1},G_{2},G_{3})\|_{L_{2}},\qquad q\geq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.5" class="ltx_p"><span id="A4.SS4.SSS2.p5.5.1" class="ltx_text">Using Equation <a href="#A4.E12" title="Equation 12 ‣ Proof. ‣ D.4.2 Step 3(b): Bounding the Higher Moments ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a> with <math id="A4.SS4.SSS2.p5.m13" class="ltx_Math" alttext="p=q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p=q</annotation></semantics></math> and <math id="A4.SS4.SSS2.p5.m14" class="ltx_Math" alttext="p=2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p=2</annotation></semantics></math> yields</span></p>
<table id="A4.Ex184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex184.m1" class="ltx_Math" alttext="\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{q}}\ \leq\ C(q-1)^{r/2}\,\left(\prod_{i}\frac{(\mathbb{E}\left[R_{i}^{2r_{i}}\right])^{1/2}}{(\mathbb{E}\left[R_{i}^{qr_{i}}\right])^{1/q}}\right)\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∏</mo><mi>i</mi></munder><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{q}}\ \leq\ C(q-1)^{r/2}\,\left(\prod_{i}\frac{(\mathbb{E}\left[R_{i}^{2r_{i}}\right])^{1/2}}{(\mathbb{E}\left[R_{i}^{qr_{i}}\right])^{1/q}}\right)\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.6" class="ltx_p"><span id="A4.SS4.SSS2.p5.6.1" class="ltx_text">For each <math id="A4.SS4.SSS2.p5.m15" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, since <math id="A4.SS4.SSS2.p5.m16" class="ltx_Math" alttext="q\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q\geq 2</annotation></semantics></math> and <math id="A4.SS4.SSS2.p5.m17" class="ltx_Math" alttext="R_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R_{i}\geq 0</annotation></semantics></math>, monotonicity of <math id="A4.SS4.SSS2.p5.m18" class="ltx_Math" alttext="L_{p}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>p</mi></msub><annotation encoding="application/x-tex">L_{p}</annotation></semantics></math> norms implies
<math id="A4.SS4.SSS2.p5.m19" class="ltx_Math" alttext="(\mathbb{E}\left[R_{i}^{qr_{i}}\right])^{1/(qr_{i})}\geq(\mathbb{E}\left[R_{i}^{2r_{i}}\right])^{1/(2r_{i})}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">(\mathbb{E}\left[R_{i}^{qr_{i}}\right])^{1/(qr_{i})}\geq(\mathbb{E}\left[R_{i}^{2r_{i}}\right])^{1/(2r_{i})}</annotation></semantics></math>, hence</span></p>
<table id="A4.Ex185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex185.m1" class="ltx_Math" alttext="\frac{(\mathbb{E}\left[R_{i}^{2r_{i}}\right])^{1/2}}{(\mathbb{E}\left[R_{i}^{qr_{i}}\right])^{1/q}}\ \leq\ 1." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>R</mi><mi>i</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow></msubsup><mo>]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>q</mi></mrow></msup></mfrac><mo lspace="0.778em">≤</mo><mn> 1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{(\mathbb{E}\left[R_{i}^{2r_{i}}\right])^{1/2}}{(\mathbb{E}\left[R_{i}^{qr_{i}}\right])^{1/q}}\ \leq\ 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.7" class="ltx_p"><span id="A4.SS4.SSS2.p5.7.1" class="ltx_text">Thus the product is less than 1, so</span></p>
<table id="A4.Ex186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex186.m1" class="ltx_Math" alttext="\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{q}}\ \leq\ C(q-1)^{r/2}\,\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo lspace="0.778em" rspace="0.778em">≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{q}}\ \leq\ C(q-1)^{r/2}\,\|H(\Theta_{1},\Theta_{2},\Theta_{3})\|_{L_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p5.8" class="ltx_p"><span id="A4.SS4.SSS2.p5.8.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmlemma15" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma15.2" class="ltx_text ltx_font_bold">Lemma 15</span></span><span id="Thmlemma15.3" class="ltx_text ltx_font_bold"> </span>(Product spherical hypercontractivity with random coefficients)<span id="Thmlemma15.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma15.p1" class="ltx_para">
<p id="Thmlemma15.p1.1" class="ltx_p"><span id="Thmlemma15.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma15.p1.m1" class="ltx_Math" alttext="l_{1},l_{2},l_{3}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>,</mo><msub><mi>l</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>l</mi><mn>3</mn></msub><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">l_{1},l_{2},l_{3}\geq 0</annotation></semantics></math> and let <math id="Thmlemma15.p1.m2" class="ltx_Math" alttext="\Theta_{i}\sim\mathrm{Unif}(S^{l_{i}})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><msub><mi>l</mi><mi>i</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta_{i}\sim\mathrm{Unif}(S^{l_{i}})</annotation></semantics></math> be independent. Let <math id="Thmlemma15.p1.m3" class="ltx_Math" alttext="r\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">r\in\mathbb{N}</annotation></semantics></math> and let <math id="Thmlemma15.p1.m4" class="ltx_Math" alttext="H:\mathbb{R}^{l_{1}+1}\times\mathbb{R}^{l_{2}+1}\times\mathbb{R}^{l_{3}+1}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>ℝ</mi><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><msub><mi>l</mi><mn>2</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mrow><msub><mi>l</mi><mn>3</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">H:\mathbb{R}^{l_{1}+1}\times\mathbb{R}^{l_{2}+1}\times\mathbb{R}^{l_{3}+1}\to\mathbb{R}</annotation></semantics></math> be a multi-homogeneous polynomial of total degree at most <math id="Thmlemma15.p1.m5" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. Suppose the coefficients of <math id="Thmlemma15.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> are random on an auxiliary probability space and are independent of <math id="Thmlemma15.p1.m7" class="ltx_Math" alttext="(\Theta_{1},\Theta_{2},\Theta_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Theta_{1},\Theta_{2},\Theta_{3})</annotation></semantics></math>. If the random coefficients satisfy <math id="Thmlemma15.p1.m8" class="ltx_Math" alttext="\|c_{\alpha}\|_{L_{q}}\leq K_{q}\|c_{\alpha}\|_{L_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><msub><mi>K</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>c</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\|c_{\alpha}\|_{L_{q}}\leq K_{q}\|c_{\alpha}\|_{L_{2}}</annotation></semantics></math> in the Hermite basis expansion, then for all <math id="Thmlemma15.p1.m9" class="ltx_Math" alttext="q\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q\geq 2</annotation></semantics></math>:</span></p>
<table id="A4.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex187.m1" class="ltx_Math" alttext="\|H\|_{L_{q}}\leq C_{r,q}\,(q-1)^{r/2}\,\|H\|_{L_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mi>q</mi></msub></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mi>r</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>r</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><msub><mi>L</mi><mn>2</mn></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|H\|_{L_{q}}\leq C_{r,q}\,(q-1)^{r/2}\,\|H\|_{L_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS4.SSS2.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.SSS2.p6" class="ltx_para">
<p id="A4.SS4.SSS2.p6.1" class="ltx_p"><span id="A4.SS4.SSS2.p6.1.1" class="ltx_text">The proof is identical to that of Lemma <a href="#Thmlemma14" title="Lemma 14 (Product Spherical Hypercontractivity). ‣ D.4.2 Step 3(b): Bounding the Higher Moments ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>, except we begin with the version of Gaussian hypercontractivity that handles random coefficients satisfying the stated assumption.
∎</span></p>
</div>
</div>
<div id="A4.SS4.SSS2.p7" class="ltx_para">
<p id="A4.SS4.SSS2.p7.1" class="ltx_p">Recall</p>
<table id="A4.Ex188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex188.m1" class="ltx_Math" alttext="{\bm{a}}:={\bm{V}}^{\top}{\bm{v}}\in\mathbb{R}^{n}\,\quad{\bm{b}}:={\bm{U}}^{\top}{\bm{u}}\in\mathbb{R}^{d},\quad\text{ and }\quad{\bm{u}}_{\beta}={\bm{U}}^{\top}{\bm{\beta}}_{*}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝒂</mi><mo>:=</mo><mrow><msup><mi>𝑽</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒗</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><mspace style="width:1.17em;" width="1.17em"></mspace><mrow><mi>𝒃</mi><mo>:=</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo rspace="1.167em">,</mo><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>𝒖</mi><mi>β</mi></msub><mo>=</mo><mrow><msup><mi>𝑼</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{a}}:={\bm{V}}^{\top}{\bm{v}}\in\mathbb{R}^{n}\,\quad{\bm{b}}:={\bm{U}}^{\top}{\bm{u}}\in\mathbb{R}^{d},\quad\text{ and }\quad{\bm{u}}_{\beta}={\bm{U}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.SSS2.p7.2" class="ltx_p">Then, since <math id="A4.SS4.SSS2.p7.m1" class="ltx_Math" alttext="{\bm{u}},{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒖</mi><mo>,</mo><mi>𝒖</mi></mrow><annotation encoding="application/x-tex">{\bm{u}},{\bm{u}}</annotation></semantics></math> are fixed, and <math id="A4.SS4.SSS2.p7.m2" class="ltx_Math" alttext="{\bm{U}},{\bm{V}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑼</mi><mo>,</mo><mi>𝑽</mi></mrow><annotation encoding="application/x-tex">{\bm{U}},{\bm{V}}</annotation></semantics></math> are independent Haar orthogonal matrices, we have that <math id="A4.SS4.SSS2.p7.m3" class="ltx_Math" alttext="{\bm{a}},{\bm{b}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒂</mi><mo>,</mo><mi>𝒃</mi></mrow><annotation encoding="application/x-tex">{\bm{a}},{\bm{b}}</annotation></semantics></math> are all uniformly random vectors on their respective spheres. Additionally, using the assumption that <math id="A4.SS4.SSS2.p7.m4" class="ltx_Math" alttext="{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><msub><mi>𝜷</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">{\bm{\beta}}_{*}</annotation></semantics></math> is uniformly random such that <math id="A4.SS4.SSS2.p7.m5" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{u}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{u}}</annotation></semantics></math> is constant. <math id="A4.SS4.SSS2.p7.m6" class="ltx_Math" alttext="{\bm{u}}_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>𝒖</mi><mi>β</mi></msub><annotation encoding="application/x-tex">{\bm{u}}_{\beta}</annotation></semantics></math> is uniformly random on a sphere <math id="A4.SS4.SSS2.p7.m7" class="ltx_Math" alttext="\mathbb{S}^{d-2}" display="inline" intent=":literal"><semantics><msup><mi>𝕊</mi><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{S}^{d-2}</annotation></semantics></math>.</p>
</div>
<div id="A4.SS4.SSS2.p8" class="ltx_para">
<p id="A4.SS4.SSS2.p8.1" class="ltx_p">Consider the following centered versions and polynomial representations.</p>
<ol id="A4.I8" class="ltx_enumerate">
<li id="A4.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I8.i1.p1" class="ltx_para">
<p id="A4.I8.i1.p1.1" class="ltx_p"><math id="A4.I8.i1.p1.m1" class="ltx_Math" alttext="\displaystyle Y_{h}:=\|{\bm{h}}\|^{2}-\mathbb{E}\left[\|{\bm{h}}\|^{2}\right]={\bm{a}}^{\top}\left({\bm{\Sigma}}^{\dagger}{\bm{\Sigma}}^{\dagger\top}-\mu_{h}\right){\bm{a}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>h</mi></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒂</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup></mrow><mo>−</mo><msub><mi>μ</mi><mi>h</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒂</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y_{h}:=\|{\bm{h}}\|^{2}-\mathbb{E}\left[\|{\bm{h}}\|^{2}\right]={\bm{a}}^{\top}\left({\bm{\Sigma}}^{\dagger}{\bm{\Sigma}}^{\dagger\top}-\mu_{h}\right){\bm{a}}</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I8.i2.p1" class="ltx_para">
<p id="A4.I8.i2.p1.1" class="ltx_p"><math id="A4.I8.i2.p1.m1" class="ltx_Math" alttext="\displaystyle Y_{k}:=\|{\bm{k}}\|^{2}-\mathbb{E}\left[\|{\bm{k}}\|^{2}\right]={\bm{b}}^{\top}\left({\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}-\mu_{k}\right){\bm{b}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>k</mi></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒃</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup></mrow><mo>−</mo><msub><mi>μ</mi><mi>k</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y_{k}:=\|{\bm{k}}\|^{2}-\mathbb{E}\left[\|{\bm{k}}\|^{2}\right]={\bm{b}}^{\top}\left({\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}-\mu_{k}\right){\bm{b}}</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A4.I8.i3.p1" class="ltx_para">
<p id="A4.I8.i3.p1.1" class="ltx_p"><math id="A4.I8.i3.p1.m1" class="ltx_Math" alttext="\displaystyle Y_{t}:=\|{\bm{t}}\|^{2}-\mathbb{E}\left[\|{\bm{t}}\|^{2}\right]={\bm{a}}^{\top}\left((I-{\bm{\Sigma}}^{\dagger}{\bm{\Sigma}})-\mu_{t}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒂</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>−</mo><mrow><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>μ</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y_{t}:=\|{\bm{t}}\|^{2}-\mathbb{E}\left[\|{\bm{t}}\|^{2}\right]={\bm{a}}^{\top}\left((I-{\bm{\Sigma}}^{\dagger}{\bm{\Sigma}})-\mu_{t}\right)</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A4.I8.i4.p1" class="ltx_para">
<p id="A4.I8.i4.p1.1" class="ltx_p"><math id="A4.I8.i4.p1.m1" class="ltx_Math" alttext="\displaystyle Y_{s}:=\|{\bm{s}}\|^{2}-\mathbb{E}\left[\|{\bm{s}}\|^{2}\right]={\bm{b}}^{\top}\left((I-{\bm{\Sigma}}{\bm{\Sigma}}^{\dagger})-\mu_{t}\right){\bm{b}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>s</mi></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒃</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>−</mo><mrow><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>μ</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y_{s}:=\|{\bm{s}}\|^{2}-\mathbb{E}\left[\|{\bm{s}}\|^{2}\right]={\bm{b}}^{\top}\left((I-{\bm{\Sigma}}{\bm{\Sigma}}^{\dagger})-\mu_{t}\right){\bm{b}}</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="A4.I8.i5.p1" class="ltx_para">
<p id="A4.I8.i5.p1.1" class="ltx_p"><math id="A4.I8.i5.p1.m1" class="ltx_Math" alttext="\displaystyle Y_{\xi}:=\frac{\xi}{\eta}-\mathbb{E}\left[\frac{\xi}{\eta}\right]={\bm{a}}^{\top}{\bm{\Sigma}}{\bm{b}}={\bm{a}}^{\top}{\bm{\Sigma}}^{\dagger}{\bm{b}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>ξ</mi></msub><mo>:=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒂</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝚺</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi></mrow><mo>=</mo><mrow><msup><mi>𝒂</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y_{\xi}:=\frac{\xi}{\eta}-\mathbb{E}\left[\frac{\xi}{\eta}\right]={\bm{a}}^{\top}{\bm{\Sigma}}{\bm{b}}={\bm{a}}^{\top}{\bm{\Sigma}}^{\dagger}{\bm{b}}</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">6.</span> 
<div id="A4.I8.i6.p1" class="ltx_para">
<p id="A4.I8.i6.p1.1" class="ltx_p"><math id="A4.I8.i6.p1.m1" class="ltx_Math" alttext="\displaystyle\tilde{T}_{1}:={\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=({\bm{\beta}}_{*}^{\top}{\bm{u}})\,{\bm{b}}^{\top}({\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}){\bm{u}}_{\beta}-\mu_{\tilde{T}_{1}}({\bm{b}}^{\top}{\bm{b}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>T</mi><mo>~</mo></mover><mn>1</mn></msub><mo>:=</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>𝒃</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒖</mi><mi>β</mi></msub></mrow><mo>−</mo><mrow><msub><mi>μ</mi><msub><mover accent="true"><mi>T</mi><mo>~</mo></mover><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒃</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{T}_{1}:={\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=({\bm{\beta}}_{*}^{\top}{\bm{u}})\,{\bm{b}}^{\top}({\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}){\bm{u}}_{\beta}-\mu_{\tilde{T}_{1}}({\bm{b}}^{\top}{\bm{b}})</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">7.</span> 
<div id="A4.I8.i7.p1" class="ltx_para">
<p id="A4.I8.i7.p1.1" class="ltx_p"><math id="A4.I8.i7.p1.m1" class="ltx_Math" alttext="\displaystyle\tilde{T}_{2}:={\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}-\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}\right]={\bm{b}}^{\top}\left(\left({\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}\right)^{2}-\mu_{\tilde{T}_{2}}\right){\bm{b}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>T</mi><mo>~</mo></mover><mn>2</mn></msub><mo>:=</mo><mrow><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>𝒃</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><msup><mi>𝚺</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝚺</mi><mo>†</mo></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo>−</mo><msub><mi>μ</mi><msub><mover accent="true"><mi>T</mi><mo>~</mo></mover><mn>2</mn></msub></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝒃</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{T}_{2}:={\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}-\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}}\right]={\bm{b}}^{\top}\left(\left({\bm{\Sigma}}^{\dagger\top}{\bm{\Sigma}}^{\dagger}\right)^{2}-\mu_{\tilde{T}_{2}}\right){\bm{b}}</annotation></semantics></math></p>
</div></li>
<li id="A4.I8.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">8.</span> 
<div id="A4.I8.i8.p1" class="ltx_para">
