<p id="A4.SS5.SSS6.p4.3" class="ltx_p"><span id="A4.SS5.SSS6.p4.3.1" class="ltx_text">and</span></p>
<table id="A4.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex339"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex339.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{3}\|{\bm{t}}\|^{2}\xi}{\gamma_{1}^{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{3}\|{\bm{t}}\|^{2}\xi}{\gamma_{1}^{2}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex339.m2" class="ltx_Math" alttext="\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\right)^{2}\mathbb{E}\left[\frac{\xi}{\eta}\right]\mathbb{E}\left[\|{\bm{t}}\|^{2}\right]\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]+O\left(\frac{1}{n}\right)=O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}\left(\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{1}}\right]\right)^{2}\mathbb{E}\left[\frac{\xi}{\eta}\right]\mathbb{E}\left[\|{\bm{t}}\|^{2}\right]\mathbb{E}\left[{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}\right]+O\left(\frac{1}{n}\right)=O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p4.4" class="ltx_p"><span id="A4.SS5.SSS6.p4.4.1" class="ltx_text">Now we have the expectations and errors for the three terms. Combining them yields the Lemma statement.</span></p>
</div>
<div id="A4.SS5.SSS6.p5" class="ltx_para ltx_noindent">
<p id="A4.SS5.SSS6.p5.1" class="ltx_p">For <math id="A4.SS5.SSS6.p5.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, we recall that <math id="A4.SS5.SSS6.p5.m2" class="ltx_Math" alttext="{\bm{h}}{\bm{s}}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{h}}{\bm{s}}=\bm{0}</annotation></semantics></math>, and Proposition <a href="#Thmprop1" title="Proposition 1 (Proposition 2 from []). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> implies</p>
<table id="A4.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex340"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex340.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex340.m2" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{2\eta^{3}\|{\bm{h}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{2\eta^{3}\|{\bm{h}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{s}}{\bm{u}}^{\top}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex341"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex341.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\eta^{2}\|{\bm{h}}\|^{2}(\xi^{2}+\eta^{2}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2})}{\gamma_{2}^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ξ</mi><mn>2</mn></msup><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\eta^{2}\|{\bm{h}}\|^{2}(\xi^{2}+\eta^{2}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2})}{\gamma_{2}^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex342"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex342.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\eta^{2}\|{\bm{h}}\|^{2}\gamma_{2}}{\gamma_{2}^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\eta^{2}\|{\bm{h}}\|^{2}\gamma_{2}}{\gamma_{2}^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex343"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex343.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p5.2" class="ltx_p">Hence, we can take expectation:</p>
<table id="A4.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex344"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex344.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{Z}}{\bm{\beta}}_{*}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex344.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{h}}\|^{2}\right]({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{h}}\|^{2}\right]({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex345"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex345.m1" class="ltx_Math" alttext="\displaystyle=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{c}{c-1}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{c}{c-1}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p5.3" class="ltx_p">∎</p>
</div>
</div>
<div id="Thmlemma27" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma27.2" class="ltx_text ltx_font_bold">Lemma 27</span></span><span id="Thmlemma27.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma27.p1" class="ltx_para">
<p id="Thmlemma27.p1.1" class="ltx_p"><span id="Thmlemma27.p1.1.1" class="ltx_text ltx_font_italic">In the same setting as <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have that,</span></p>
<table id="A4.Ex346" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex346.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=\begin{cases}\|{\bm{\beta}}_{*}\|^{2}+\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}-\frac{2\eta^{2}c}{\eta^{2}c+\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)&amp;c&lt;1\\
\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}-\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{c(c-1)}\right)+o(1)+O\left(\frac{1}{n}\right)&amp;c&gt;1\end{cases}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="false"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>c</mi></mfrac></mstyle><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="false"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mo>−</mo><mstyle displaystyle="false"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=\begin{cases}\|{\bm{\beta}}_{*}\|^{2}+\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}-\frac{2\eta^{2}c}{\eta^{2}c+\rho^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)&amp;c&lt;1\\
\frac{\|{\bm{\beta}}_{*}\|^{2}}{c}-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}-\frac{({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}}{c(c-1)}\right)+o(1)+O\left(\frac{1}{n}\right)&amp;c&gt;1\end{cases}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS5.SSS6.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.SSS6.p6" class="ltx_para">
<p id="A4.SS5.SSS6.p6.1" class="ltx_p"><span id="A4.SS5.SSS6.p6.1.1" class="ltx_text">We use similar expansions that follow from Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</span></p>
<table id="A4.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex347"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex347.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex347.m2" class="ltx_Math" alttext="\displaystyle=\|{\bm{\beta}}_{*}\|^{2}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{\eta^{4}\|{\bm{t}}\|^{4}}{\gamma_{1}^{2}}({\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}})({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\|{\bm{\beta}}_{*}\|^{2}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+\frac{\eta^{4}\|{\bm{t}}\|^{4}}{\gamma_{1}^{2}}({\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}})({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex348"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex348.m1" class="ltx_Math" alttext="\displaystyle+\frac{2\eta^{3}\|{\bm{t}}\|^{2}\xi}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\frac{2\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{2\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{2\eta^{3}\|{\bm{t}}\|^{2}\xi}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}-\frac{2\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{2\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p6.2" class="ltx_p"><span id="A4.SS5.SSS6.p6.2.1" class="ltx_text">Lemma <a href="#Thmlemma26" title="Lemma 26. ‣ D.5.6 Variance: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a> gives the expectation of the first four terms:</span></p>
<table id="A4.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex349"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex349.m1" class="ltx_Math" alttext="\displaystyle\|{\bm{\beta}}_{*}^{2}\|^{2}+\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mn>2</mn></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|{\bm{\beta}}_{*}^{2}\|^{2}+\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p6.3" class="ltx_p"><span id="A4.SS5.SSS6.p6.3.1" class="ltx_text">We have done the following expectations in Equations <a href="#A4.E18" title="Equation 18 ‣ Proof. ‣ D.5.7 Target Alignment: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>, <a href="#A4.Ex453" title="In Proof. ‣ D.5.7 Target Alignment: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>:</span></p>
<table id="A4.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex350"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex350.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right),\quad\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}\right]=O\left(\frac{1}{n}\right),\quad\mathbb{E}\left[\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}\right]=\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p6.4" class="ltx_p"><span id="A4.SS5.SSS6.p6.4.1" class="ltx_text">Combining these results yields the lemma statement.</span></p>
</div>
<div id="A4.SS5.SSS6.p7" class="ltx_para ltx_noindent">
<p id="A4.SS5.SSS6.p7.1" class="ltx_p">For <math id="A4.SS5.SSS6.p7.m1" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, with <math id="A4.SS5.SSS6.p7.m2" class="ltx_Math" alttext="{\bm{h}}{\bm{s}}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{h}}{\bm{s}}=\bm{0}</annotation></semantics></math>, <math id="A4.SS5.SSS6.p7.m3" class="ltx_Math" alttext="{\bm{s}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{s}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}=\bm{0}</annotation></semantics></math>, <math id="A4.SS5.SSS6.p7.m4" class="ltx_Math" alttext="{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}={\bm{h}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>=</mo><mi>𝒉</mi></mrow><annotation encoding="application/x-tex">{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}={\bm{h}}</annotation></semantics></math>, we have the following expansion by Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>:</p>
<table id="A4.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex351"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex351.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex351.m2" class="ltx_Math" alttext="\displaystyle={\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}+\frac{\eta^{4}\|{\bm{s}}\|^{4}\|{\bm{h}}\|^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{s}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}+\frac{\eta^{4}\|{\bm{s}}\|^{4}\|{\bm{h}}\|^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex352"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex352.m1" class="ltx_Math" alttext="\displaystyle+\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex353"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex353.m1" class="ltx_Math" alttext="\displaystyle-\frac{2\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}-\frac{2\eta\xi}{\gamma_{2}}{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{2\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}-\frac{2\eta\xi}{\gamma_{2}}{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex354"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex354.m1" class="ltx_Math" alttext="\displaystyle-\frac{2\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{2\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p7.2" class="ltx_p">We can combine the coefficients as:</p>
<table id="A4.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex355"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex355.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{2}\|{\bm{s}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}+\frac{\eta^{4}\|{\bm{s}}\|^{4}\|{\bm{h}}\|^{2}}{\gamma_{2}^{2}}-\frac{2\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}=\frac{\eta^{2}\|{\bm{s}}\|^{2}(\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2})-2\eta^{2}\|{\bm{s}}\|^{2}\gamma_{2}}{\gamma_{2}^{2}}=-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>=</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{2}\|{\bm{s}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}+\frac{\eta^{4}\|{\bm{s}}\|^{4}\|{\bm{h}}\|^{2}}{\gamma_{2}^{2}}-\frac{2\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}=\frac{\eta^{2}\|{\bm{s}}\|^{2}(\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2})-2\eta^{2}\|{\bm{s}}\|^{2}\gamma_{2}}{\gamma_{2}^{2}}=-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A4.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex356"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex356.m1" class="ltx_Math" alttext="\displaystyle\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}=\frac{\eta^{2}\|{\bm{h}}\|^{2}(\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2})}{\gamma_{2}^{2}}=\frac{\eta^{2}\|{\bm{h}}\|^{2}\gamma_{2}}{\gamma_{2}^{2}}=\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}=\frac{\eta^{2}\|{\bm{h}}\|^{2}(\eta^{2}\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}+\xi^{2})}{\gamma_{2}^{2}}=\frac{\eta^{2}\|{\bm{h}}\|^{2}\gamma_{2}}{\gamma_{2}^{2}}=\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p7.3" class="ltx_p">Then we have that:</p>
<table id="A4.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex357"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex357.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex358"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex358.m1" class="ltx_Math" alttext="\displaystyle=\ " display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex358.m2" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{2\eta\xi}{\gamma_{2}}{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{2\eta\xi}{\gamma_{2}}{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p7.4" class="ltx_p">Recall from Equation <a href="#A4.E13" title="Equation 13 ‣ Proof. ‣ D.5.5 Bias: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> that <math id="A4.SS5.SSS6.p7.m5" class="ltx_Math" alttext="\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}]=\|{\bm{\beta}}_{*}\|^{2}/c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>/</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}]=\|{\bm{\beta}}_{*}\|^{2}/c</annotation></semantics></math>. We then proceed similarly with the other expectations using Lemmas <a href="#Thmlemma9" title="Lemma 9 (Generalized version of Lemma 7 from []). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, <a href="#Thmlemma10" title="Lemma 10 (General Terms). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, <a href="#Thmlemma11" title="Lemma 11 (Zero Expectation). ‣ D.4.1 Step 3(a): Showing that basic building blocks concentrate ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, <a href="#Thmlemma19" title="Lemma 19 (Moments of 𝜂^2/𝛾_𝑖). ‣ D.4.3 Step 3(c): Bounding 𝛾_𝑖 moments. ‣ D.4 Step 3: Random Matrix Theory Estimates ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>:</p>
<table id="A4.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex359"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex359.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex359.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{s}}\|^{2}\right]\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)O\left(\frac{1}{n}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\|{\bm{s}}\|^{2}\right]\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{h}}^{\top}{\bm{h}}{\bm{\beta}}_{*}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)O\left(\frac{1}{n}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex360"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex360.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(1-\frac{1}{c}\right)\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{c}{\rho^{2}(c-1)}+o\left(\frac{1}{d\rho^{2}}\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>c</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(1-\frac{1}{c}\right)\left(\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{c}{\rho^{2}(c-1)}+o\left(\frac{1}{d\rho^{2}}\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex361"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex361.m1" class="ltx_Math" alttext="\displaystyle=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{d}\right)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><msub><mi>𝜷</mi><mo>∗</mo></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mi>d</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>d</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\|{\bm{\beta}}_{*}\|^{2}}{d}\frac{\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{d}\right)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
