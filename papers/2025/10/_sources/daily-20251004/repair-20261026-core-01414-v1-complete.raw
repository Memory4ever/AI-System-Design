<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex431.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[{\tau_{\varepsilon}^{2}}\left(\frac{\eta^{4}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{4}}{\gamma_{2}\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{2}}\right)\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[{\tau_{\varepsilon}^{2}}\left(\frac{\eta^{4}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{4}}{\gamma_{2}\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{\eta^{2}\|{\bm{h}}\|^{2}\|{\bm{k}}\|^{2}}{\gamma_{2}}\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p12.4" class="ltx_p">Similarly, we combine the coefficients: For the term <math id="A4.SS5.SSS6.p12.m2" class="ltx_Math" alttext="{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}</annotation></semantics></math>,</p>
