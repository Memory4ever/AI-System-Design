<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex434.m1" class="ltx_Math" alttext="\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{s}}\|^{2}\left(-\frac{\gamma_{2}-\xi^{2}}{\gamma_{2}{\xi}^{2}}-\frac{2\xi^{2}}{\gamma_{2}\xi^{2}}+\frac{\gamma_{2}}{\gamma_{2}\xi^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>−</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>2</mn></msub><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\tau_{\varepsilon}^{2}\eta^{2}\|{\bm{s}}\|^{2}\left(-\frac{\gamma_{2}-\xi^{2}}{\gamma_{2}{\xi}^{2}}-\frac{2\xi^{2}}{\gamma_{2}\xi^{2}}+\frac{\gamma_{2}}{\gamma_{2}\xi^{2}}\right)</annotation></semantics></math></td>
