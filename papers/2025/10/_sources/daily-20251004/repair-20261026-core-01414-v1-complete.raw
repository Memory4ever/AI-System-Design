</table>
<table id="A4.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex365"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex365.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\frac{\eta\xi}{\gamma_{2}}{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex365.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\frac{\xi}{\eta}\right]\mathbb{E}\left[{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)O\left(\frac{1}{n}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mi>ξ</mi><mi>η</mi></mfrac></mstyle><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><msqrt><mrow><mrow><mi>Var</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>η</mi><mn>2</mn></msup><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{\eta^{2}}{\gamma_{2}}\right]\mathbb{E}\left[\frac{\xi}{\eta}\right]\mathbb{E}\left[{{\bm{\beta}}_{*}^{\top}{\bm{A}}{\bm{A}}^{\dagger}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}}\right]+\sqrt{\mathrm{Var}\left(\frac{\eta^{2}}{\gamma_{2}}\right)O\left(\frac{1}{n}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E17.m1" class="ltx_Math" alttext="\displaystyle=0+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=0+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p7.5" class="ltx_p">We combine these results to produce the lemma statement.
∎</p>
</div>
</div>
<div id="Thmlemma28" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma28.2" class="ltx_text ltx_font_bold">Lemma 28</span></span><span id="Thmlemma28.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma28.p1" class="ltx_para">
<p id="Thmlemma28.p1.1" class="ltx_p"><span id="Thmlemma28.p1.1.1" class="ltx_text ltx_font_italic">In the same setting as <a href="#S2" title="2 Problem Setting ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we have that</span></p>
<table id="A4.Ex366" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex366.m1" class="ltx_Math" alttext="\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=\begin{cases}-\left(\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}-\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right),&amp;c&lt;1\\
-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{1}{c-1}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right),&amp;c&gt;1\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="false"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><msup><mi>η</mi><mn>2</mn></msup><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=\begin{cases}-\left(\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}-\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right),&amp;c&lt;1\\
-\frac{\eta^{2}}{\eta^{2}+\rho^{2}}\frac{1}{c-1}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right),&amp;c&gt;1\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS5.SSS6.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.SSS6.p8" class="ltx_para">
<p id="A4.SS5.SSS6.p8.1" class="ltx_p"><span id="A4.SS5.SSS6.p8.1.1" class="ltx_text">For <math id="A4.SS5.SSS6.p8.m1" class="ltx_Math" alttext="c&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;1</annotation></semantics></math>, we expand it using <a href="#Thmprop1" title="Proposition 1 (Proposition 2 from []). ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#Thmlemma2" title="Lemma 2. ‣ D.3.5 Helper Lemmas ‣ D.3 Step 2: Simplifying Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2</span></a>. Note that all of the relevant expectations have been evaluated in the proofs of Lemmas <a href="#Thmlemma26" title="Lemma 26. ‣ D.5.6 Variance: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>, <a href="#Thmlemma27" title="Lemma 27. ‣ D.5.6 Variance: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>,</span></p>
<table id="A4.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex367"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex367.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex367.m2" class="ltx_Math" alttext="\displaystyle=\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{2\eta^{3}\|{\bm{t}}\|^{2}\xi}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{k}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\eta\xi}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{h}}{\bm{\beta}}_{*}+\frac{\eta^{2}\|{\bm{t}}\|^{2}}{\gamma_{1}}{\bm{\beta}}_{*}^{\top}{\bm{u}}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{\beta}}_{*}-\frac{2\eta^{3}\|{\bm{t}}\|^{2}\xi}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{k}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex368"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex368.m1" class="ltx_Math" alttext="\displaystyle-\frac{\eta^{4}\|{\bm{t}}\|^{4}}{\gamma_{1}^{2}}({\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}})({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}-\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒕</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒌</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>1</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{\eta^{4}\|{\bm{t}}\|^{4}}{\gamma_{1}^{2}}({\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{A}}^{\dagger\top}{\bm{k}})({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}-\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{1}^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p8.2" class="ltx_p"><span id="A4.SS5.SSS6.p8.2.1" class="ltx_text">The expectation of the last three terms is given by Lemma <a href="#Thmlemma26" title="Lemma 26. ‣ D.5.6 Variance: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>. The first two expectations come from Equations <a href="#A4.E18" title="Equation 18 ‣ Proof. ‣ D.5.7 Target Alignment: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>, <a href="#A4.Ex453" title="In Proof. ‣ D.5.7 Target Alignment: Helper Lemmas ‣ D.5 Step 4: Bounding the Expectation of Products of Dependent Terms ‣ Appendix D Proof of Theorem ‣ Risk Phase Transitions in Spiked Regression: Alignment Driven Benign and Catastrophic Overfitting" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> respectively. We can plug them in and compute the expectation:</span></p>
<table id="A4.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex369"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex369.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=-\left(\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}-\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>c</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><mi>c</mi></mrow></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}\right]=-\left(\frac{\eta^{2}(\eta^{2}+\rho^{2})}{(\eta^{2}c+\rho^{2})^{2}}\frac{c^{2}}{1-c}-\frac{\eta^{2}c}{\eta^{2}c+\rho^{2}}\right)({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o(1)+O\left(\frac{1}{n}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.SSS6.p8.3" class="ltx_p"><span id="A4.SS5.SSS6.p8.3.1" class="ltx_text">For <math id="A4.SS5.SSS6.p8.m2" class="ltx_Math" alttext="c&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&gt;1</annotation></semantics></math>, again with <math id="A4.SS5.SSS6.p8.m3" class="ltx_Math" alttext="{\bm{h}}{\bm{s}}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{h}}{\bm{s}}=\bm{0}</annotation></semantics></math> and <math id="A4.SS5.SSS6.p8.m4" class="ltx_Math" alttext="{\bm{s}}^{\top}{\bm{A}}=\bm{0}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝒔</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi></mrow><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">{\bm{s}}^{\top}{\bm{A}}=\bm{0}</annotation></semantics></math>, <math id="A4.SS5.SSS6.p8.m5" class="ltx_Math" alttext="{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒁</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝒁</mi><mo>+</mo><mi>𝑨</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">{\bm{\beta}}_{*}^{\top}{\bm{Z}}({\bm{Z}}+{\bm{A}})^{\dagger}({\bm{Z}}+{\bm{A}})^{\dagger\top}{\bm{A}}{\bm{\beta}}_{*}</annotation></semantics></math> becomes:</span></p>
<table id="A4.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex370"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex370.m1" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}\left({\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{s}}{\bm{h}}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{s}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right){\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒔</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}\left({\bm{A}}{\bm{A}}^{\dagger}+\frac{\eta\xi}{\gamma_{2}}{\bm{s}}{\bm{h}}-\frac{\eta^{2}\|{\bm{s}}\|^{2}}{\gamma_{2}}{\bm{h}}^{\top}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}}{\bm{s}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta\xi}{\gamma_{2}}{\bm{h}}^{\top}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right){\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
