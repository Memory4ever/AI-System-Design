<tbody id="A4.Ex372"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex372.m1" class="ltx_Math" alttext="\displaystyle=\ " display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex372.m2" class="ltx_Math" alttext="\displaystyle{\bm{\beta}}_{*}^{\top}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta^{3}\xi\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right]{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ξ</mi><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\displaystyle{\bm{\beta}}_{*}^{\top}\left[\frac{\eta\xi}{\gamma_{2}}{\bm{u}}{\bm{h}}{\bm{A}}{\bm{A}}^{\dagger}-\frac{\eta^{3}\xi\|{\bm{s}}\|^{2}\|{\bm{h}}\|^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{h}}-\frac{\eta^{2}\|{\bm{h}}\|^{2}\xi^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right]{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex373"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex373.m1" class="ltx_Math" alttext="\displaystyle\ +{\bm{\beta}}_{*}^{\top}\left[\frac{\eta^{3}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{u}}{\bm{h}}-\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right]{\bm{\beta}}_{*}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒖</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑨</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup></mrow></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝜷</mi><mo>∗</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ +{\bm{\beta}}_{*}^{\top}\left[\frac{\eta^{3}\|{\bm{h}}\|^{2}\|{\bm{s}}\|^{2}\xi}{\gamma_{2}^{2}}{\bm{u}}{\bm{h}}-\frac{\eta^{4}\|{\bm{h}}\|^{4}\|{\bm{s}}\|^{2}}{\gamma_{2}^{2}}{\bm{u}}{\bm{u}}^{\top}{\bm{A}}{\bm{A}}^{\dagger}\right]{\bm{\beta}}_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex374"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
