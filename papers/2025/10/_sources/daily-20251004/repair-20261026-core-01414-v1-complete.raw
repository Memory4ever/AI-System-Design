<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex430.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\left[\frac{{\xi}^{2}\tau_{\varepsilon}^{2}}{\gamma_{2}^{2}}\left(\frac{\|{\bm{h}}\|^{2}}{\xi^{2}}\gamma_{2}\right)\left(\frac{\eta^{4}\|{\bm{s}}\|^{4}}{\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta^{2}\|{\bm{k}}\|^{2}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ξ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ε</mi><mn>2</mn></msubsup></mrow><msubsup><mi>γ</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">‖</mo><mi>𝒉</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>4</mn></msup></mrow><msup><mi>ξ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝒉</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mrow><mo>†</mo><mo lspace="0em">⁣</mo><mo>⊤</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒔</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mi>ξ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑨</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝒉</mi><mo>⊤</mo></msup></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>𝒌</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\left[\frac{{\xi}^{2}\tau_{\varepsilon}^{2}}{\gamma_{2}^{2}}\left(\frac{\|{\bm{h}}\|^{2}}{\xi^{2}}\gamma_{2}\right)\left(\frac{\eta^{4}\|{\bm{s}}\|^{4}}{\xi^{2}}{\bm{h}}{\bm{A}}^{\dagger\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\frac{2\eta^{3}\|{\bm{s}}\|^{2}}{\xi}{\bm{k}}^{\top}{\bm{A}}^{\dagger}{\bm{h}}^{\top}+\eta^{2}\|{\bm{k}}\|^{2}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
