<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex363.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(1\right)\right)+O\left(\frac{1}{n}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ρ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>c</mi><mrow><mi>c</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>ρ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>c</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝜷</mi><mo>∗</mo><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝒖</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mn>1</mn><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{\rho^{2}\eta^{2}}{\eta^{2}+\rho^{2}}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{\rho^{2}}\frac{c}{c-1}+o\left(\frac{1}{\rho^{2}}\right)\right)\left(\frac{1}{c^{2}}({\bm{\beta}}_{*}^{\top}{\bm{u}})^{2}+o\left(1\right)\right)+O\left(\frac{1}{n}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex364"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
