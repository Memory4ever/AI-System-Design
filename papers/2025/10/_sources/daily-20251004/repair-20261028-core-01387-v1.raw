<td id="S1.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="S1.T1.m7" class="ltx_Math" alttext="\widetilde{\mathcal{O}}(\min\{\sqrt{n^{L}K^{L}A^{2L}L},\,K^{n}\}\sqrt{T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><msqrt><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msqrt><mo rspace="0.337em">,</mo><msup><mi>K</mi><mi>n</mi></msup><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{O}}(\min\{\sqrt{n^{L}K^{L}A^{2L}L},\,K^{n}\}\sqrt{T})</annotation></semantics></math></td></tr>
<tr id="S1.T1.2.4" class="ltx_tr">
<th id="S1.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S1.T1.2.4.1.1" class="ltx_text ltx_font_bold">Low. Bound</span></th>
<td id="S1.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="S1.T1.m8" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,\,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,\,nK\}T})</annotation></semantics></math></td>
<td id="S1.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="S1.T1.m9" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,\,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,\,nK\}T})</annotation></semantics></math></td>
<td id="S1.T1.2.4.4" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="S1.T1.m10" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,nK\}T})</annotation></semantics></math></td></tr>
