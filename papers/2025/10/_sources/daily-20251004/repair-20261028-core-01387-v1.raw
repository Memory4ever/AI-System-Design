<td id="S1.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><math id="S1.T1.m5" class="ltx_Math" alttext="\widetilde{\mathcal{O}}(\sqrt{\min\{L,\,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{O}}(\sqrt{\min\{L,\,nK\}T})</annotation></semantics></math></td>
