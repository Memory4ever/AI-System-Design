<tbody id="A2.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\displaystyle r(t)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle r(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m2" class="ltx_Math" alttext="\displaystyle=U(x^{*},\bm{\mathcal{D}})-U(x^{t},\bm{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=U(x^{*},\bm{\mathcal{D}})-U(x^{t},\bm{\mathcal{D}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\displaystyle=U(x^{*},\bm{\mathcal{D}})-U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})+U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})-U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})+U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})-U(x^{t},\bm{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=U(x^{*},\bm{\mathcal{D}})-U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})+U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})-U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})+U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})-U(x^{t},\bm{\mathcal{D}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E4.m1" class="ltx_Math" alttext="\displaystyle\leq U(x^{*},\bm{\mathcal{D}})-U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})+0+U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})-U(x^{t},\bm{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>0</mn><mo>+</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq U(x^{*},\bm{\mathcal{D}})-U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})+0+U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})-U(x^{t},\bm{\mathcal{D}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p2.1" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p2.1.1" class="ltx_text">where (<a href="#A2.E4" title="In Proof. ‣ Analysis of 𝒪(√𝐾^𝑛⁢𝑇) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) follows from <math id="A2.SS2.SSS0.Px1.p2.m1" class="ltx_Math" alttext="U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})\;-\;U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.502em">−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})\;-\;U(x^{t},\hat{\bm{\mathcal{D}}}^{t-1})\leq 0</annotation></semantics></math> because <math id="A2.SS2.SSS0.Px1.p2.m2" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math> maximizes <math id="A2.SS2.SSS0.Px1.p2.m3" class="ltx_Math" alttext="U(x,\hat{\bm{\mathcal{D}}}^{t-1})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(x,\hat{\bm{\mathcal{D}}}^{t-1})</annotation></semantics></math>. We bound the first term in Equation (<a href="#A2.E4" title="In Proof. ‣ Analysis of 𝒪(√𝐾^𝑛⁢𝑇) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) as follows:</span></p>
<table id="A2.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\displaystyle U(x^{*},\bm{\mathcal{D}})\,-\,U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.392em">−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle U(x^{*},\bm{\mathcal{D}})\,-\,U(x^{*},\hat{\bm{\mathcal{D}}}^{t-1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\theta\in\Theta}\bm{\mathcal{D}}(\bm{\theta})\,u\bigl(x,{\bm{\mathrm{br}}}(\bm{\theta},x)\bigr)\,-\,\sum_{\bm{\theta}\in\Theta}\hat{\bm{\mathcal{D}}}^{t-1}(\theta)\,u\bigl(x,{\bm{\mathrm{br}}}(\bm{\theta},x)\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><mrow><mi>𝐛𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">)</mo></mrow></mrow></mrow><mo rspace="0.392em">−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><mrow><mi>𝐛𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\theta\in\Theta}\bm{\mathcal{D}}(\bm{\theta})\,u\bigl(x,{\bm{\mathrm{br}}}(\bm{\theta},x)\bigr)\,-\,\sum_{\bm{\theta}\in\Theta}\hat{\bm{\mathcal{D}}}^{t-1}(\theta)\,u\bigl(x,{\bm{\mathrm{br}}}(\bm{\theta},x)\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle=\sum_{\bm{\theta}\in\Theta}\Bigl(\bm{\mathcal{D}}(\bm{\theta})-\hat{\bm{\mathcal{D}}}^{t-1}(\bm{\theta})\Bigr)\,u\bigl(x,{\bm{\mathrm{br}}}(\bm{\theta},x)\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><mrow><mi>𝐛𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\bm{\theta}\in\Theta}\Bigl(\bm{\mathcal{D}}(\bm{\theta})-\hat{\bm{\mathcal{D}}}^{t-1}(\bm{\theta})\Bigr)\,u\bigl(x,{\bm{\mathrm{br}}}(\bm{\theta},x)\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{\bm{\theta}\in\Theta}\Bigl|\bm{\mathcal{D}}(\bm{\theta})-\hat{\bm{\mathcal{D}}}^{t-1}(\bm{\theta})\Bigr|\,u(x,{\bm{\mathrm{br}}}(\bm{\theta},x))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>𝐛𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\bm{\theta}\in\Theta}\Bigl|\bm{\mathcal{D}}(\bm{\theta})-\hat{\bm{\mathcal{D}}}^{t-1}(\bm{\theta})\Bigr|\,u(x,{\bm{\mathrm{br}}}(\bm{\theta},x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{\bm{\theta}\in\Theta}\Bigl|\bm{\mathcal{D}}(\bm{\theta})-\hat{\bm{\mathcal{D}}}^{t-1}(\bm{\theta})\Bigr|\cdot 1~=~2\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em" stretchy="true">|</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mn>1</mn></mrow><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\bm{\theta}\in\Theta}\Bigl|\bm{\mathcal{D}}(\bm{\theta})-\hat{\bm{\mathcal{D}}}^{t-1}(\bm{\theta})\Bigr|\cdot 1~=~2\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p2.2" class="ltx_p"><span id="A2.SS2.SSS0.Px1.p2.2.1" class="ltx_text">By a symmetrical argument, the second term in Equation (<a href="#A2.E4" title="In Proof. ‣ Analysis of 𝒪(√𝐾^𝑛⁢𝑇) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) is also bounded by <math id="A2.SS2.SSS0.Px1.p2.m4" class="ltx_Math" alttext="2\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.SS2.SSS0.Px1.p3" class="ltx_para">
<p id="A2.SS2.SSS0.Px1.p3.1" class="ltx_p">Using Claim <a href="#A2.Thmclaim1" title="Claim B.1. ‣ Analysis of 𝒪(√𝐾^𝑛⁢𝑇) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a> and taking expectation, we have</p>
<table id="A2.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[r(t)]~\leq~4\mathbb{E}[\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[r(t)]~\leq~4\mathbb{E}[\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px1.p3.2" class="ltx_p">According to <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib8" title="" class="ltx_ref">Canonne [2020]</a></cite>, for distributions with support size <math id="A2.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="K^{n}" display="inline" intent=":literal"><semantics><msup><mi>K</mi><mi>n</mi></msup><annotation encoding="application/x-tex">K^{n}</annotation></semantics></math>, <math id="A2.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\mathbb{E}[\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})]\leq\mathcal{O}(\sqrt{\frac{K^{n}}{t-1}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mfrac><msup><mi>K</mi><mi>n</mi></msup><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})]\leq\mathcal{O}(\sqrt{\frac{K^{n}}{t-1}})</annotation></semantics></math>. Thus, we have <math id="A2.SS2.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\mathbb{E}[r(t)]\leq\mathcal{O}\big(\sqrt{\frac{K^{n}}{t-1}}\big)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msqrt><mfrac><msup><mi>K</mi><mi>n</mi></msup><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[r(t)]\leq\mathcal{O}\big(\sqrt{\frac{K^{n}}{t-1}}\big)</annotation></semantics></math>.
Using the inequality <math id="A2.SS2.SSS0.Px1.p3.m4" class="ltx_Math" alttext="\sum_{t=1}^{T}\frac{1}{\sqrt{t}}\leq 2\sqrt{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mfrac><mn>1</mn><msqrt><mi>t</mi></msqrt></mfrac></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\frac{1}{\sqrt{t}}\leq 2\sqrt{T}</annotation></semantics></math>, we obtain</p>
<table id="A2.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\sum_{t=1}^{T}\mathbb{E}[r(t)]~\leq~\mathcal{O}\left(\sum_{t=1}^{T}\sqrt{\frac{K^{n}}{t}}\right)~\leq~\mathcal{O}(2\sqrt{K^{n}T})~=~\mathcal{O}(\sqrt{K^{n}T})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msqrt><mstyle displaystyle="true"><mfrac><msup><mi>K</mi><mi>n</mi></msup><mi>t</mi></mfrac></mstyle></msqrt></mrow><mo rspace="0.330em">)</mo></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\sum_{t=1}^{T}\mathbb{E}[r(t)]~\leq~\mathcal{O}\left(\sum_{t=1}^{T}\sqrt{\frac{K^{n}}{t}}\right)~\leq~\mathcal{O}(2\sqrt{K^{n}T})~=~\mathcal{O}(\sqrt{K^{n}T}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Analysis of <math id="A2.SS2.SSS0.Px2.m1" class="ltx_Math" alttext="\mathcal{O}(\sqrt{LT\log(nKAT})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\sqrt{LT\log(nKAT})</annotation></semantics></math> Regret:</h4>

<div id="A2.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS2.SSS0.Px2.p1.1" class="ltx_p">Consider round <math id="A2.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="t\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">t\geq 2</annotation></semantics></math>. By Lemma <a href="#S4.Thmlemma1" title="Lemma 4.1. ‣ General Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, we have that with probability at least <math id="A2.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>:</p>
<table id="A2.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle\Big|\,U_{\bm{\mathcal{D}}}(x)-\hat{U}^{t}(x)\,\Big|~\leq~\mathcal{O}\bigg(\sqrt{\frac{L\log t}{t}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t}}\bigg),\quad\forall x\in\Delta(\mathcal{L})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.170em" stretchy="true">|</mo><mrow><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.330em" stretchy="true">|</mo></mrow><mo rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow></mrow><mi>t</mi></mfrac></mstyle></msqrt><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac></mstyle></msqrt></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>x</mi></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\,U_{\bm{\mathcal{D}}}(x)-\hat{U}^{t}(x)\,\Big|~\leq~\mathcal{O}\bigg(\sqrt{\frac{L\log t}{t}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t}}\bigg),\quad\forall x\in\Delta(\mathcal{L}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px2.p1.2" class="ltx_p">Suppose this event happens. Then, the regret of the algorithm at round <math id="A2.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is bounded as follows:</p>
<table id="A2.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle r(t)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle r(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m2" class="ltx_Math" alttext="\displaystyle~=~\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}\big[u(x^{*},{\bm{\mathrm{br}}}(\bm{\theta},x^{*}))-u(x^{t},{\bm{\mathrm{br}}}(\bm{\theta},x^{t}))\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝜽</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mrow><mi>𝐛𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>𝐛𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo>,</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}\big[u(x^{*},{\bm{\mathrm{br}}}(\bm{\theta},x^{*}))-u(x^{t},{\bm{\mathrm{br}}}(\bm{\theta},x^{t}))\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex29.m1" class="ltx_Math" alttext="\displaystyle~=~U_{\bm{\mathcal{D}}}(x^{*})-U_{\bm{\mathcal{D}}}(x^{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~U_{\bm{\mathcal{D}}}(x^{*})-U_{\bm{\mathcal{D}}}(x^{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30.m1" class="ltx_Math" alttext="\displaystyle~=~U_{\bm{\mathcal{D}}}(x^{*})-\hat{U}^{t-1}(x^{*})+\hat{U}^{t-1}(x^{*})-\hat{U}^{t-1}(x^{t})+\hat{U}^{t-1}(x^{t})-U_{\bm{\mathcal{D}}}(x^{t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mrow><mrow><mrow><mrow><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~U_{\bm{\mathcal{D}}}(x^{*})-\hat{U}^{t-1}(x^{*})+\hat{U}^{t-1}(x^{*})-\hat{U}^{t-1}(x^{t})+\hat{U}^{t-1}(x^{t})-U_{\bm{\mathcal{D}}}(x^{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\displaystyle~\leq~\hat{U}^{t-1}(x^{*})-\hat{U}^{t-1}(x^{t})+2\cdot\mathcal{O}\bigg(\sqrt{\frac{L\log(t-1)}{t-1}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t-1}}\bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mrow><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></msqrt><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></msqrt></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\leq~\hat{U}^{t-1}(x^{*})-\hat{U}^{t-1}(x^{t})+2\cdot\mathcal{O}\bigg(\sqrt{\frac{L\log(t-1)}{t-1}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t-1}}\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle~\leq~0+2\cdot\mathcal{O}\bigg(\sqrt{\frac{L\log(t-1)}{t-1}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t-1}}\bigg)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mn>0</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></msqrt><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></msqrt></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\leq~0+2\cdot\mathcal{O}\bigg(\sqrt{\frac{L\log(t-1)}{t-1}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t-1}}\bigg),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS0.Px2.p1.3" class="ltx_p">where the last inequality follows from <math id="A2.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\hat{U}^{t-1}(x^{*})-\hat{U}^{t-1}(x^{t})\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\hat{U}^{t-1}(x^{*})-\hat{U}^{t-1}(x^{t})\leq 0</annotation></semantics></math> because the algorithm selects the strategy <math id="A2.SS2.SSS0.Px2.p1.m5" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math> that maximizes the empirical utility <math id="A2.SS2.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\hat{U}^{t-1}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{U}^{t-1}(x)</annotation></semantics></math>. Then:</p>
<table id="A2.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\text{Reg}(T)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>Reg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\text{Reg}(T)]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\bigg[\sum_{t=1}^{T}r(t)\bigg]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\bigg[\sum_{t=1}^{T}r(t)\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E5.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=1}^{T}(1-\delta)\cdot\mathcal{O}\bigg(\sqrt{\frac{L\log t}{t}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t}}\bigg)+\delta T" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>t</mi></mrow></mrow><mi>t</mi></mfrac></mstyle></msqrt><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac></mstyle></msqrt></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=1}^{T}(1-\delta)\cdot\mathcal{O}\bigg(\sqrt{\frac{L\log t}{t}}+\sqrt{\frac{L\log(nKA)+\log(\frac{1}{\delta})}{t}}\bigg)+\delta T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
<tbody id="A2.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E6.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\bigg(\sqrt{TL\log T}+\sqrt{T\big(L\log(nKA)+\log(\frac{1}{\delta})\big)}\bigg)+\delta T" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msqrt><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mi>T</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></msqrt></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\bigg(\sqrt{TL\log T}+\sqrt{T\big(L\log(nKA)+\log(\frac{1}{\delta})\big)}\bigg)+\delta T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
<tbody id="A2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\big(\sqrt{TL(\log T+\log(nKA))}\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msqrt><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\big(\sqrt{TL(\log T+\log(nKA))}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle=\mathcal{O}\big(\sqrt{TL\log(nKAT)}\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msqrt><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{O}\big(\sqrt{TL\log(nKAT)}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.SSS0.Px2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS0.Px2.p2.1" class="ltx_p">Equation (<a href="#A2.E5" title="In Analysis of 𝒪(√𝐿⁢𝑇⁢log(𝑛⁢𝐾⁢𝐴⁢𝑇CLOSE) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) follows from the law of total expectation and the fact that the single-round regret is bounded by 1. Equation (<a href="#A2.E6" title="In Analysis of 𝒪(√𝐿⁢𝑇⁢log(𝑛⁢𝐾⁢𝐴⁢𝑇CLOSE) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) follows from the known inequality <math id="A2.SS2.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\frac{1}{\sqrt{t}}\leq 2\sqrt{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mfrac><mn>1</mn><msqrt><mi>t</mi></msqrt></mfrac></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\frac{1}{\sqrt{t}}\leq 2\sqrt{T}</annotation></semantics></math>. We set <math id="A2.SS2.SSS0.Px2.p2.m2" class="ltx_Math" alttext="\delta=\frac{1}{T}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mfrac><mn>1</mn><mi>T</mi></mfrac></mrow><annotation encoding="application/x-tex">\delta=\frac{1}{T}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS2.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Runtime Analysis:</h4>

<div id="A2.SS2.SSS0.Px3.p1" class="ltx_para">
<p id="A2.SS2.SSS0.Px3.p1.1" class="ltx_p">As for the computational complexity of this algorithm, note that Lemma <a href="#S3.Thmlemma2" title="Lemma 3.2. ‣ 3.3 Enumerating Best-Response Regions and Computing the Offline Optimal ‣ 3 Best Response Regions: A Geometric Perspective ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> states that the number of non-empty best-response regions is <math id="A2.SS2.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\mathcal{O}(n^{L}K^{L}A^{2L})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(n^{L}K^{L}A^{2L})</annotation></semantics></math>. As shown by Equation (<a href="#S4.E3" title="In General Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), we can compute the optimal strategy within each best-response region using a linear program with <math id="A2.SS2.SSS0.Px3.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> variables and at most <math id="A2.SS2.SSS0.Px3.p1.m3" class="ltx_Math" alttext="\mathrm{poly}(n^{L},K^{L},A^{L},L,T)" display="inline" intent=":literal"><semantics><mrow><mi>poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mi>L</mi></msup><mo>,</mo><msup><mi>K</mi><mi>L</mi></msup><mo>,</mo><msup><mi>A</mi><mi>L</mi></msup><mo>,</mo><mi>L</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{poly}(n^{L},K^{L},A^{L},L,T)</annotation></semantics></math> number of constraints. Further, evaluating each constraint and the objective function can also be accomplished in this time. Since each linear program can be solved in <math id="A2.SS2.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\mathrm{poly}(n^{L},K^{L},A^{L},L,T)" display="inline" intent=":literal"><semantics><mrow><mi>poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mi>L</mi></msup><mo>,</mo><msup><mi>K</mi><mi>L</mi></msup><mo>,</mo><msup><mi>A</mi><mi>L</mi></msup><mo>,</mo><mi>L</mi><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{poly}(n^{L},K^{L},A^{L},L,T)</annotation></semantics></math> time, and we run <math id="A2.SS2.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\mathcal{O}(n^{L}K^{L}A^{2L})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(n^{L}K^{L}A^{2L})</annotation></semantics></math> linear programs at each round, with at most <math id="A2.SS2.SSS0.Px3.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> rounds, Algorithm <a href="#algorithm1" title="In General Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> runs <math id="A2.SS2.SSS0.Px3.p1.m7" class="ltx_Math" alttext="\mathrm{poly}((nKA)^{L}LT)" display="inline" intent=":literal"><semantics><mrow><mi>poly</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{poly}((nKA)^{L}LT)</annotation></semantics></math> time.</p>
</div>
</section>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Proof of Theorem <a href="#S4.Thmtheorem2" title="Theorem 4.2. ‣ Independent Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a></h3>

<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p"><span id="A2.SS3.p1.1.1" class="ltx_text">Let <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\bm{\mathcal{D}}=\prod_{i=1}^{n}\mathcal{D}_{i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathcal{D}}=\prod_{i=1}^{n}\mathcal{D}_{i}</annotation></semantics></math> denote the distribution over independent types.
According to Claim <a href="#A2.Thmclaim1" title="Claim B.1. ‣ Analysis of 𝒪(√𝐾^𝑛⁢𝑇) Regret: ‣ B.2 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, the single-round regret <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="r(t)=U(x^{*},\bm{\mathcal{D}})-U(x^{t},\bm{\mathcal{D}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r(t)=U(x^{*},\bm{\mathcal{D}})-U(x^{t},\bm{\mathcal{D}})</annotation></semantics></math> satisfies</span></p>
<table id="A2.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex37.m1" class="ltx_Math" alttext="\displaystyle r(t)~\leq~\mathcal{O}(\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1}))," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle r(t)~\leq~\mathcal{O}(\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t-1})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p"><span id="A2.SS3.p1.2.1" class="ltx_text">where <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="\hat{\bm{\mathcal{D}}}^{t-1}=\prod_{i=1}^{n}\hat{\mathcal{D}}^{t-1}_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{\mathcal{D}}}^{t-1}=\prod_{i=1}^{n}\hat{\mathcal{D}}^{t-1}_{i}</annotation></semantics></math> is the product of the empirically computed marginal type distributions. We will use the following properties of Hellinger Distance (Definition <a href="#A2.Thmdefinition2" title="Definition B.2 (Hellinger distance). ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>):</span></p>
<ul id="A2.I2" class="ltx_itemize" style="--ltx-enum-leftmargin:1.5em;">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i1.p1" class="ltx_para">
<p id="A2.I2.i1.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib18" title="" class="ltx_ref">Guo et al., 2020</a>]</cite> For any two distributions <math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="\bm{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝓓</mi><annotation encoding="application/x-tex">\bm{\mathcal{D}}</annotation></semantics></math> and <math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="\hat{\bm{\mathcal{D}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\bm{\mathcal{D}}}</annotation></semantics></math>,</p>
<table id="A2.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E7.m1" class="ltx_Math" alttext="H^{2}(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}})\leq\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}})\leq\sqrt{2}H(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{2}(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}})\leq\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}})\leq\sqrt{2}H(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i2.p1" class="ltx_para">
<p id="A2.I2.i2.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib18" title="" class="ltx_ref">Guo et al., 2020</a>]</cite> If both <math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="\bm{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝓓</mi><annotation encoding="application/x-tex">\bm{\mathcal{D}}</annotation></semantics></math> and <math id="A2.I2.i2.p1.m2" class="ltx_Math" alttext="\hat{\bm{\mathcal{D}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\bm{\mathcal{D}}}</annotation></semantics></math> are product distributions, i.e. <math id="A2.I2.i2.p1.m3" class="ltx_Math" alttext="\bm{\mathcal{D}}=\prod_{i=1}^{n}\mathcal{D}_{i}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathcal{D}}=\prod_{i=1}^{n}\mathcal{D}_{i}</annotation></semantics></math> and <math id="A2.I2.i2.p1.m4" class="ltx_Math" alttext="\hat{\bm{\mathcal{D}}}=\prod_{i=1}^{n}\hat{\mathcal{D}}_{i}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\bm{\mathcal{D}}}=\prod_{i=1}^{n}\hat{\mathcal{D}}_{i}</annotation></semantics></math>, then:</p>
<table id="A2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E8.m1" class="ltx_Math" alttext="H^{2}(\mathbf{\bm{\mathcal{D}}},\hat{\bm{\mathcal{D}}})\leq\sum_{i=1}^{n}H^{2}\left(\mathcal{D}_{i},\hat{\mathcal{D}}_{i}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>i</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{2}(\mathbf{\bm{\mathcal{D}}},\hat{\bm{\mathcal{D}}})\leq\sum_{i=1}^{n}H^{2}\left(\mathcal{D}_{i},\hat{\mathcal{D}}_{i}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div></li>
<li id="A2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i3.p1" class="ltx_para">
<p id="A2.I2.i3.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib8" title="" class="ltx_ref">Canonne, 2020</a>]</cite> For a distribution <math id="A2.I2.i3.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> with support size <math id="A2.I2.i3.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, the empirical distribution <math id="A2.I2.i3.p1.m3" class="ltx_Math" alttext="\hat{\mathcal{D}}^{t}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>t</mi></msup><annotation encoding="application/x-tex">\hat{\mathcal{D}}^{t}</annotation></semantics></math> over <math id="A2.I2.i3.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> samples from <math id="A2.I2.i3.p1.m5" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> satisfies:</p>
<table id="A2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E9.m1" class="ltx_Math" alttext="\mathbb{E}[H^{2}(\mathcal{D},\hat{\mathcal{D}}^{t})]\leq\frac{K}{2t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mfrac><mi>K</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[H^{2}(\mathcal{D},\hat{\mathcal{D}}^{t})]\leq\frac{K}{2t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="A2.SS3.p1.3" class="ltx_p"><span id="A2.SS3.p1.3.1" class="ltx_text">We now upper bound the single-round regret <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="r(t+1)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(t+1)</annotation></semantics></math> in expectation:</span></p>
<table id="A2.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[r(t+1)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[r(t+1)]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38.m2" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\bigl(\mathbb{E}\big[\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t})\big]\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\bigl(\mathbb{E}\big[\delta(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t})\big]\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\big(\mathbb{E}\big[H(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t})\big]\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\big(\mathbb{E}\big[H(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t})\big]\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex39.1" class="ltx_text">by (<a href="#A2.E7" title="In 1st item ‣ Proof. ‣ B.3 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></span>)</span></td></tr></tbody>
<tbody id="A2.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex40.m4" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\big(\sqrt{\mathbb{E}\big[H^{2}(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t})\big]}\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>,</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>^</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></msqrt><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\big(\sqrt{\mathbb{E}\big[H^{2}(\bm{\mathcal{D}},\hat{\bm{\mathcal{D}}}^{t})\big]}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex40.1" class="ltx_text">because <math id="A2.Ex40.m1" class="ltx_Math" alttext="\mathbb{E}[X^{2}]\geq(\mathbb{E}[X])^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi>X</mi><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>X</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}[X^{2}]\geq(\mathbb{E}[X])^{2}</annotation></semantics></math></span></span></td></tr></tbody>
<tbody id="A2.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex41.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\sqrt{\mathbb{E}\Big[\sum_{i=1}^{n}H^{2}(\mathcal{D}_{i},\hat{\mathcal{D}}_{i}^{t})\Big]}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></msqrt><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\sqrt{\mathbb{E}\Big[\sum_{i=1}^{n}H^{2}(\mathcal{D}_{i},\hat{\mathcal{D}}_{i}^{t})\Big]}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex41.1" class="ltx_text">by (<a href="#A2.E8" title="In 2nd item ‣ Proof. ‣ B.3 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a></span>)</span></td></tr></tbody>
<tbody id="A2.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex42.m1" class="ltx_Math" alttext="\displaystyle\leq\mathcal{O}\left(\sqrt{\frac{nK}{2t}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></msqrt><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{O}\left(\sqrt{\frac{nK}{2t}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><span id="A2.Ex42.1" class="ltx_text">by (<a href="#A2.E9" title="In 3rd item ‣ Proof. ‣ B.3 Proof of Theorem ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></span>)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p1.4" class="ltx_p"><span id="A2.SS3.p1.4.1" class="ltx_text">Using the inequality <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="\sum_{t=1}^{T}\frac{1}{\sqrt{t}}\leq 2\sqrt{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mfrac><mn>1</mn><msqrt><mi>t</mi></msqrt></mfrac></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\frac{1}{\sqrt{t}}\leq 2\sqrt{T}</annotation></semantics></math>, we obtain</span></p>
<table id="A2.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex43.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\sum_{t=1}^{T}\mathbb{E}[r(t)]~\leq~\sum_{t=1}^{T}\mathcal{O}\left(\sqrt{\frac{nK}{t}}\right)~\leq~\mathcal{O}(\sqrt{nKT})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mi>t</mi></mfrac></mstyle></msqrt><mo rspace="0.330em">)</mo></mrow></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\sum_{t=1}^{T}\mathbb{E}[r(t)]~\leq~\sum_{t=1}^{T}\mathcal{O}\left(\sqrt{\frac{nK}{t}}\right)~\leq~\mathcal{O}(\sqrt{nKT}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.5" class="ltx_p"><span id="A2.SS3.p1.5.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span><math id="A2.SS4.m1" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,K\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,K\}T})</annotation></semantics></math> Lower Bound in the Single-Follower Case</h3>

<div id="A2.SS4.p1" class="ltx_para">
<p id="A2.SS4.p1.1" class="ltx_p">In this section, we prove a lower bound of <math id="A2.SS4.p1.m1" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,K\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,K\}T})</annotation></semantics></math> on the expected regret of any algorithm in the case of a single-follower <math id="A2.SS4.p1.m2" class="ltx_Math" alttext="(n=1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n=1)</annotation></semantics></math>, formalized in Theorem <a href="#A2.Thmtheorem2" title="Theorem B.2. ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>.</p>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p"><span id="A2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">For single-follower Bayesian Stackelberg games where the follower has <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> types and the leader has <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> actions, the expected regret of any type-feedback online learning algorithm is at least <math id="A2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,K\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,K\}T})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS4.p2" class="ltx_para">
<p id="A2.SS4.p2.1" class="ltx_p">At a high level, the proof Theorem <a href="#A2.Thmtheorem2" title="Theorem B.2. ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> is a reduction from the <span id="A2.SS4.p2.1.1" class="ltx_text ltx_font_italic">distribution learning problem</span>.
Without loss of generality, assume that <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="\min\{K,L\}=2c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>K</mi><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">\min\{K,L\}=2c</annotation></semantics></math> is an even number. Further assume that <math id="A2.SS4.p2.m2" class="ltx_Math" alttext="K=L=2c" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mi>L</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">K=L=2c</annotation></semantics></math>.<span id="footnote4" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">4</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">4</sup>
              <span class="ltx_tag ltx_tag_note">4</span>
              
              
              
            If <math id="footnote4.m1" class="ltx_Math" alttext="K&gt;2c" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">K&gt;2c</annotation></semantics></math>, we can let the additional types to have probability <math id="footnote4.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. If <math id="footnote4.m3" class="ltx_Math" alttext="L&gt;2c" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">L&gt;2c</annotation></semantics></math>, we can let the additional actions of the leader to have very low utility. </span></span></span>
The single follower has <math id="A2.SS4.p2.m3" class="ltx_Math" alttext="K=2c" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">K=2c</annotation></semantics></math> types, with type space <math id="A2.SS4.p2.m4" class="ltx_Math" alttext="\Theta=\{\pm 1,\pm 2,...,\pm c\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>±</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>±</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo>±</mo><mi>c</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=\{\pm 1,\pm 2,...,\pm c\}</annotation></semantics></math>. Consider a class <math id="A2.SS4.p2.m5" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> of distributions over <math id="A2.SS4.p2.m6" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> defined as follows:</p>
</div>
<div id="A2.Thmdefinition4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition4.2" class="ltx_text ltx_font_bold">Definition B.4</span></span><span id="A2.Thmdefinition4.3" class="ltx_text ltx_font_bold"> </span>(Class of Distributions <math id="A2.Thmdefinition4.m1" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>)<span id="A2.Thmdefinition4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition4.p1" class="ltx_para">
<p id="A2.Thmdefinition4.p1.1" class="ltx_p"><span id="A2.Thmdefinition4.p1.1.1" class="ltx_text ltx_font_italic">A distribution <math id="A2.Thmdefinition4.p1.m1" class="ltx_Math" alttext="\mathcal{D}=\mathcal{D}_{\bm{\sigma}}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>𝛔</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}=\mathcal{D}_{\bm{\sigma}}\in\mathcal{C}</annotation></semantics></math> is specified by a vector <math id="A2.Thmdefinition4.p1.m2" class="ltx_Math" alttext="\bm{\sigma}=(\sigma_{1},\ldots,\sigma_{c})\in\{\pm 1\}^{c}" display="inline" intent=":literal"><semantics><mrow><mi>𝛔</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>σ</mi><mi>c</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mo>±</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\bm{\sigma}=(\sigma_{1},\ldots,\sigma_{c})\in\{\pm 1\}^{c}</annotation></semantics></math>. For each <math id="A2.Thmdefinition4.p1.m3" class="ltx_Math" alttext="j=1,\ldots,c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">j=1,\ldots,c</annotation></semantics></math>,</span></p>
<table id="A2.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E10.m1" class="ltx_Math" alttext="\mathcal{D}_{\bm{\sigma}}(+j)=\frac{1}{2c}(1+\sigma_{j}{\epsilon}),\quad\mathcal{D}_{\bm{\sigma}}(-j)=\frac{1}{2c}(1-\sigma_{j}{\epsilon})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>𝝈</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>𝝈</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\bm{\sigma}}(+j)=\frac{1}{2c}(1+\sigma_{j}{\epsilon}),\quad\mathcal{D}_{\bm{\sigma}}(-j)=\frac{1}{2c}(1-\sigma_{j}{\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A2.Thmdefinition4.p1.2" class="ltx_p"><span id="A2.Thmdefinition4.p1.2.1" class="ltx_text ltx_font_italic">for some <math id="A2.Thmdefinition4.p1.m4" class="ltx_Math" alttext="{\epsilon}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\epsilon}&gt;0</annotation></semantics></math>. Note that <math id="A2.Thmdefinition4.p1.m5" class="ltx_Math" alttext="\mathcal{D}_{\bm{\sigma}}(+j)&gt;\mathcal{D}_{\bm{\sigma}}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>𝛔</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>𝛔</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{\bm{\sigma}}(+j)&gt;\mathcal{D}_{\bm{\sigma}}(-j)</annotation></semantics></math> if and only if <math id="A2.Thmdefinition4.p1.m6" class="ltx_Math" alttext="\sigma_{j}=+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo>=</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\sigma_{j}=+1</annotation></semantics></math>. The class <math id="A2.Thmdefinition4.p1.m7" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> consists of <math id="A2.Thmdefinition4.p1.m8" class="ltx_Math" alttext="2^{c}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>c</mi></msup><annotation encoding="application/x-tex">2^{c}</annotation></semantics></math> distributions.</span></p>
</div>
</div>
<div id="A2.SS4.p3" class="ltx_para">
<p id="A2.SS4.p3.1" class="ltx_p">In the distribution learning problem, given <math id="A2.SS4.p3.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> samples <math id="A2.SS4.p3.m2" class="ltx_Math" alttext="\theta^{1},...,\theta^{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>θ</mi><mi>t</mi></msup></mrow><annotation encoding="application/x-tex">\theta^{1},...,\theta^{t}</annotation></semantics></math> from an unknown distribution <math id="A2.SS4.p3.m3" class="ltx_Math" alttext="\mathcal{D}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}\in\mathcal{C}</annotation></semantics></math>, the goal is to construct an estimator <math id="A2.SS4.p3.m4" class="ltx_Math" alttext="\hat{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathcal{D}}</annotation></semantics></math> specified by a vector <math id="A2.SS4.p3.m5" class="ltx_Math" alttext="\hat{\sigma}\in\{\pm 1\}^{c}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mo>±</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\hat{\sigma}\in\{\pm 1\}^{c}</annotation></semantics></math> such that the expected total variation distance (Definition <a href="#A2.Thmdefinition1" title="Definition B.1 (Total variation distance). ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>) satisfies <math id="A2.SS4.p3.m6" class="ltx_Math" alttext="\mathbb{E}[\delta(\mathcal{D},\hat{\mathcal{D}})]\leq\mathcal{O}({\epsilon})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\delta(\mathcal{D},\hat{\mathcal{D}})]\leq\mathcal{O}({\epsilon})</annotation></semantics></math>. It is known that solving this problem requires at least <math id="A2.SS4.p3.m7" class="ltx_Math" alttext="\Omega(\frac{2c}{{\epsilon}^{2}})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\frac{2c}{{\epsilon}^{2}})</annotation></semantics></math> samples.</p>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(e.g., <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib23" title="" class="ltx_ref">Lee and Chen, 2020</a>, <a href="#bib.bib15" title="" class="ltx_ref">Diakonikolas and Kontonis, 2019</a>]</cite>)<span id="A2.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">When <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> is uniformly sampled from the class <math id="A2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math>, any algorithm that constructs estimator <math id="A2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\hat{\mathcal{D}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathcal{D}}</annotation></semantics></math> using <math id="A2.Thmtheorem3.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> samples from <math id="A2.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> has expected error at least <math id="A2.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\mathbb{E}[\delta(\hat{\mathcal{D}},\mathcal{D})]\geq\Omega({\epsilon})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\delta(\hat{\mathcal{D}},\mathcal{D})]\geq\Omega({\epsilon})</annotation></semantics></math> if <math id="A2.Thmtheorem3.p1.m7" class="ltx_Math" alttext="t\leq\mathcal{O}(\frac{2c}{{\epsilon}^{2}})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\leq\mathcal{O}(\frac{2c}{{\epsilon}^{2}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A2.SS4.p4" class="ltx_para"><span id="A2.SS4.p4.1" class="ltx_inline-logical-block ltx_framed ltx_framed_rectangle">
<span id="A2.SS4.p4.p1" class="ltx_para ltx_noindent">
<span id="A2.SS4.p4.p1.1" class="ltx_p"><span id="A2.SS4.p4.p1.1.1" class="ltx_text ltx_font_bold">Distribution learning instance</span>: An unknown distribution <math id="A2.SS4.p4.p1.m1" class="ltx_Math" alttext="\mathcal{D}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}\in\mathcal{C}</annotation></semantics></math>.</span>
</span>
<span id="A2.SS4.p4.p2" class="ltx_para ltx_noindent">
<span id="A2.SS4.p4.p2.1" class="ltx_p"><span id="A2.SS4.p4.p2.1.1" class="ltx_text ltx_font_bold">Bayesian Stackelberg game instance</span>: A single follower with type space <math id="A2.SS4.p4.p2.m1" class="ltx_Math" alttext="\Theta=\{\pm 1,\pm 2,\ldots,\pm c\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>±</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>±</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo>±</mo><mi>c</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=\{\pm 1,\pm 2,\ldots,\pm c\}</annotation></semantics></math> and an unknown type distribution <math id="A2.SS4.p4.p2.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>. The follower has binary action set <math id="A2.SS4.p4.p2.m3" class="ltx_Math" alttext="\mathcal{A}=\{\text{Good},\text{Bad}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>Good</mtext><mo>,</mo><mtext>Bad</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}=\{\text{Good},\text{Bad}\}</annotation></semantics></math>. The leader has action set <math id="A2.SS4.p4.p2.m4" class="ltx_Math" alttext="\mathcal{L}=\Theta=\{\pm 1,\pm 2,\ldots,\pm c\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>±</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>±</mo><mn>2</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo>±</mo><mi>c</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\Theta=\{\pm 1,\pm 2,\ldots,\pm c\}</annotation></semantics></math>. The utility functions of the two players are:</span>
<span id="A2.I3" class="ltx_itemize">
<span id="A2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I3.i1.p1" class="ltx_para">
<span id="A2.I3.i1.p1.1" class="ltx_p">Follower’s utility function:</span>
<span id="A2.E11" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.E11.m1" class="ltx_Math" alttext="v(\ell,a,\theta)=\begin{cases}1&amp;\text{if }\theta=+j,\ell=+j,a=\text{Good}\\
1&amp;\text{if }\theta=+j,\ell=-j,a=\text{Bad}\\
1&amp;\text{if }\theta=-j,\ell=-j,a=\text{Good}\\
1&amp;\text{if }\theta=-j,\ell=+j,a=\text{Bad}\\
0&amp;\text{otherwise}.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>=</mo><mrow><mo>+</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>+</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo>=</mo><mtext>Good</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>=</mo><mrow><mo>+</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo>=</mo><mtext>Bad</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>=</mo><mrow><mo>−</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>−</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo>=</mo><mtext>Good</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo>=</mo><mrow><mo>−</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo>+</mo><mi>j</mi></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo>=</mo><mtext>Bad</mtext></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>otherwise</mtext><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">v(\ell,a,\theta)=\begin{cases}1&amp;\text{if }\theta=+j,\ell=+j,a=\text{Good}\\
1&amp;\text{if }\theta=+j,\ell=-j,a=\text{Bad}\\
1&amp;\text{if }\theta=-j,\ell=-j,a=\text{Good}\\
1&amp;\text{if }\theta=-j,\ell=+j,a=\text{Bad}\\
0&amp;\text{otherwise}.\end{cases}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span>
<span rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></span></span></span>
</span>
</span></span>
<span id="A2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I3.i2.p1" class="ltx_para">
<span id="A2.I3.i2.p1.1" class="ltx_p">Leader’s utility function: For any action <math id="A2.I3.i2.p1.m1" class="ltx_Math" alttext="\ell\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">\ell\in\mathcal{L}</annotation></semantics></math>,</span>
<span id="A2.E12" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.E12.m1" class="ltx_Math" alttext="u(\ell,\mathrm{Good})=1,\quad u(\ell,\mathrm{Bad})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>Good</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>Bad</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u(\ell,\mathrm{Good})=1,\quad u(\ell,\mathrm{Bad})=0.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span>
<span rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></span></span></span>
</span>
<span id="A2.I3.i2.p1.2" class="ltx_p">Note that for any mixed strategy <math id="A2.I3.i2.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, <math id="A2.I3.i2.p1.m3" class="ltx_Math" alttext="u(x,\mathrm{Good})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>Good</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">u(x,\mathrm{Good})=1</annotation></semantics></math> and <math id="A2.I3.i2.p1.m4" class="ltx_Math" alttext="u(x,\mathrm{Bad})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>Bad</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u(x,\mathrm{Bad})=0</annotation></semantics></math>.</span>
</span></span>
</span>
</span>
<span id="A2.SS4.p4.p3" class="ltx_para ltx_noindent">
<span id="A2.SS4.p4.p3.1" class="ltx_p"><span id="A2.SS4.p4.p3.1.1" class="ltx_text ltx_font_bold">Reduction:</span> 
<br class="ltx_break">Given an online learning algorithm <math id="A2.SS4.p4.p3.m1" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math> for Bayesian Stackelberg game with type feedback, we use it to construct an online learning algorithm for the distribution learning problem as follows: At each round <math id="A2.SS4.p4.p3.m2" class="ltx_Math" alttext="t=1,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\ldots,T</annotation></semantics></math>,</span>
<span id="A2.I4" class="ltx_enumerate">
<span id="A2.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A2.I4.i1.p1" class="ltx_para">
<span id="A2.I4.i1.p1.1" class="ltx_p">Receive the leader’s mixed strategy <math id="A2.I4.i1.p1.m1" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math> from <math id="A2.I4.i1.p1.m2" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math>.</span>
</span></span>
<span id="A2.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A2.I4.i2.p1" class="ltx_para">
<span id="A2.I4.i2.p1.1" class="ltx_p">Construct an estimated distribution <math id="A2.I4.i2.p1.m1" class="ltx_Math" alttext="\hat{\mathcal{D}}_{x^{t}}=\mathcal{D}_{\bm{\sigma}(x^{t})}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><msup><mi>x</mi><mi>t</mi></msup></msub><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>𝝈</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\hat{\mathcal{D}}_{x^{t}}=\mathcal{D}_{\bm{\sigma}(x^{t})}\in\mathcal{C}</annotation></semantics></math> based on vector <math id="A2.I4.i2.p1.m2" class="ltx_Math" alttext="\bm{\sigma}(x^{t})" display="inline" intent=":literal"><semantics><mrow><mi>𝝈</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\sigma}(x^{t})</annotation></semantics></math> defined as follows:</span>
<span id="A2.E13" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.E13.m1" class="ltx_Math" alttext="\sigma_{j}(x^{t})=\begin{cases}+1,&amp;\text{if }x^{t}(+j)\geq x^{t}(-j)\\
-1,&amp;\text{if }x^{t}(+j)&lt;x^{t}(-j).\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\sigma_{j}(x^{t})=\begin{cases}+1,&amp;\text{if }x^{t}(+j)\geq x^{t}(-j)\\
-1,&amp;\text{if }x^{t}(+j)&lt;x^{t}(-j).\end{cases}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span>
<span rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></span></span></span>
</span>
</span></span>
<span id="A2.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<span id="A2.I4.i3.p1" class="ltx_para">
<span id="A2.I4.i3.p1.1" class="ltx_p">Observe sample <math id="A2.I4.i3.p1.m1" class="ltx_Math" alttext="\theta^{t}\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mi>t</mi></msup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\theta^{t}\sim\mathcal{D}</annotation></semantics></math> and feed <math id="A2.I4.i3.p1.m2" class="ltx_Math" alttext="\theta^{t}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\theta^{t}</annotation></semantics></math> to <math id="A2.I4.i3.p1.m3" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math>.</span>
</span></span>
</span>
</span></span>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A2.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma B.2</span></span><span id="A2.Thmlemma2.3" class="ltx_text ltx_font_bold"> </span>(Follower’s Best Response)<span id="A2.Thmlemma2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma2.p1" class="ltx_para">
<p id="A2.Thmlemma2.p1.1" class="ltx_p"><span id="A2.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Given the leader’s mixed strategy <math id="A2.Thmlemma2.p1.m1" class="ltx_Math" alttext="x\in\Delta(\Theta)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in\Delta(\Theta)</annotation></semantics></math>, for each <math id="A2.Thmlemma2.p1.m2" class="ltx_Math" alttext="j\in\{1,\ldots,c\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\ldots,c\}</annotation></semantics></math>, the best-response function of a follower with type <math id="A2.Thmlemma2.p1.m3" class="ltx_Math" alttext="+j" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">+j</annotation></semantics></math> or <math id="A2.Thmlemma2.p1.m4" class="ltx_Math" alttext="-j" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">-j</annotation></semantics></math> is:</span></p>
<table id="A2.EGx24" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A2.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex44.m1" class="ltx_Math" alttext="\displaystyle\mathrm{br}(+j,x)\;=\;\begin{cases}\mathrm{Good},&amp;\text{if }x(+j)\geq x(-j),\\
\mathrm{Bad},&amp;\text{if }x(+j)&lt;x(-j),\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>br</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo>,</mo><mi>x</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>Good</mi><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>Bad</mi><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{br}(+j,x)\;=\;\begin{cases}\mathrm{Good},&amp;\text{if }x(+j)\geq x(-j),\\
\mathrm{Bad},&amp;\text{if }x(+j)&lt;x(-j),\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex45.m1" class="ltx_Math" alttext="\displaystyle\mathrm{br}(-j,x)\;=\;\begin{cases}\mathrm{Good},&amp;\text{if }x(+j)&lt;x(-j),\\
\mathrm{Bad},&amp;\text{if }x(+j)\geq x(-j).\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>br</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo>,</mo><mi>x</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>Good</mi><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>Bad</mi><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{br}(-j,x)\;=\;\begin{cases}\mathrm{Good},&amp;\text{if }x(+j)&lt;x(-j),\\
\mathrm{Bad},&amp;\text{if }x(+j)\geq x(-j).\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.p5" class="ltx_para">
<p id="A2.SS4.p5.1" class="ltx_p"><span id="A2.SS4.p5.1.1" class="ltx_text">For a follower with type <math id="A2.SS4.p5.m1" class="ltx_Math" alttext="+j" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">+j</annotation></semantics></math>, their utility for choosing action Good is given by</span></p>
<table id="A2.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex46.m1" class="ltx_Math" alttext="v(x,\text{Good},+j)=\mathbb{E}_{\ell\sim x}[v(\ell,\text{Good},+j)]=\sum_{\ell\in\mathcal{L}}x(\ell)v(\ell,\text{Good},+j)=x(+j)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mtext>Good</mtext><mo>,</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>∼</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mtext>Good</mtext><mo>,</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mtext>Good</mtext><mo>,</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v(x,\text{Good},+j)=\mathbb{E}_{\ell\sim x}[v(\ell,\text{Good},+j)]=\sum_{\ell\in\mathcal{L}}x(\ell)v(\ell,\text{Good},+j)=x(+j).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p5.2" class="ltx_p"><span id="A2.SS4.p5.2.1" class="ltx_text">Similarly, their utility for choosing action Bad is:</span></p>
<table id="A2.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex47.m1" class="ltx_Math" alttext="v(x,\text{Bad},+j)=x(-j)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mtext>Bad</mtext><mo>,</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">v(x,\text{Bad},+j)=x(-j).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p6" class="ltx_para">
<p id="A2.SS4.p6.1" class="ltx_p"><span id="A2.SS4.p6.1.1" class="ltx_text">Thus, by definition, the follower with type <math id="A2.SS4.p6.m1" class="ltx_Math" alttext="+j" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">+j</annotation></semantics></math> best responds with <span id="A2.SS4.p6.1.1.1" class="ltx_text ltx_markedasmath">Good</span> if <math id="A2.SS4.p6.m3" class="ltx_Math" alttext="x(+j)\geq x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)\geq x(-j)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.p7" class="ltx_para">
<p id="A2.SS4.p7.1" class="ltx_p"><span id="A2.SS4.p7.1.1" class="ltx_text">Likewise, for a follower with type <math id="A2.SS4.p7.m1" class="ltx_Math" alttext="-j" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">-j</annotation></semantics></math>,</span></p>
<table id="A2.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex48.m1" class="ltx_Math" alttext="\displaystyle v(x,\text{Good},-j)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mtext>Good</mtext><mo>,</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle v(x,\text{Good},-j)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex48.m2" class="ltx_Math" alttext="\displaystyle=x(-j)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x(-j),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex49.m1" class="ltx_Math" alttext="\displaystyle v(x,\text{Bad},-j)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mtext>Bad</mtext><mo>,</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle v(x,\text{Bad},-j)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49.m2" class="ltx_Math" alttext="\displaystyle=x(+j)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x(+j).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p7.2" class="ltx_p"><span id="A2.SS4.p7.2.1" class="ltx_text">Thus, a follower with type <math id="A2.SS4.p7.m2" class="ltx_Math" alttext="-j" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">-j</annotation></semantics></math> best responds with <span id="A2.SS4.p7.2.1.1" class="ltx_text">Bad</span> if <math id="A2.SS4.p7.m3" class="ltx_Math" alttext="x(+j)\geq x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)\geq x(-j)</annotation></semantics></math>, <span id="A2.SS4.p7.2.1.2" class="ltx_text">Good</span> otherwise.
∎</span></p>
</div>
</div>
<div id="A2.SS4.p8" class="ltx_para">
<p id="A2.SS4.p8.1" class="ltx_p">We define <math id="A2.SS4.p8.m1" class="ltx_Math" alttext="U(x,\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(x,\mathcal{D})</annotation></semantics></math> as the expected utility of the leader when using mixed strategy <math id="A2.SS4.p8.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> under the type distribution <math id="A2.SS4.p8.m3" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>. By Lemma <a href="#A2.Thmlemma2" title="Lemma B.2 (Follower’s Best Response). ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, we have</p>
<table id="A2.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex50.m1" class="ltx_Math" alttext="\displaystyle U(x,\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle U(x,\mathcal{D})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\theta\in\Theta}\mathcal{D}(\theta)\,u\bigl(x,\mathrm{br}(\theta,x)\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><mrow><mi>br</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\theta\in\Theta}\mathcal{D}(\theta)\,u\bigl(x,\mathrm{br}(\theta,x)\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex51.m1" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{c}\Bigl[\mathcal{D}(+j)\,u\bigl(x,\mathrm{br}(+j,x)\bigr)+\mathcal{D}(-j)\,u\bigl(x,\mathrm{br}(-j,x)\bigr)\Bigr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><mrow><mi>br</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo>,</mo><mrow><mi>br</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{c}\Bigl[\mathcal{D}(+j)\,u\bigl(x,\mathrm{br}(+j,x)\bigr)+\mathcal{D}(-j)\,u\bigl(x,\mathrm{br}(-j,x)\bigr)\Bigr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{j=1}^{c}\Big(\frac{1+\sigma_{j}{\epsilon}}{2c}\,\mathds{1}\left[x(+j)\geq x(-j)\right]+\frac{1-\sigma_{j}{\epsilon}}{2c}\mathds{1}\left[x(+j)&lt;x(-j)\right]\Big)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mstyle><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><mrow><mo>[</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mstyle><mn>𝟙</mn><mrow><mo>[</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{c}\Big(\frac{1+\sigma_{j}{\epsilon}}{2c}\,\mathds{1}\left[x(+j)\geq x(-j)\right]+\frac{1-\sigma_{j}{\epsilon}}{2c}\mathds{1}\left[x(+j)&lt;x(-j)\right]\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
</div>
<div id="A2.Thmdefinition5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition5.2" class="ltx_text ltx_font_bold">Definition B.5</span></span><span id="A2.Thmdefinition5.3" class="ltx_text ltx_font_bold"> </span>(Disagreement Function)<span id="A2.Thmdefinition5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition5.p1" class="ltx_para">
<p id="A2.Thmdefinition5.p1.1" class="ltx_p"><span id="A2.Thmdefinition5.p1.1.1" class="ltx_text ltx_font_italic">The disagreement function <math id="A2.Thmdefinition5.p1.m1" class="ltx_Math" alttext="\mathrm{Disagree}(x,\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Disagree}(x,\mathcal{D})</annotation></semantics></math> is the number of <math id="A2.Thmdefinition5.p1.m2" class="ltx_Math" alttext="j\in\{1,\ldots,c\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\ldots,c\}</annotation></semantics></math> where the indicators <math id="A2.Thmdefinition5.p1.m3" class="ltx_math_unparsed" alttext="\mathds{1}\left[x(+j)\geq x(-j)\right]" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo>[</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathds{1}\left[x(+j)\geq x(-j)\right]</annotation></semantics></math> and
<math id="A2.Thmdefinition5.p1.m4" class="ltx_math_unparsed" alttext="\mathds{1}\left[\mathcal{D}(+j)\geq\mathcal{D}(-j)\right]" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo>[</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathds{1}\left[\mathcal{D}(+j)\geq\mathcal{D}(-j)\right]</annotation></semantics></math> differ:</span></p>
<table id="A2.Ex52" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex52X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex52X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{Disagree}\bigl(x,\mathcal{D}\bigr)" display="inline" intent=":literal"><semantics><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>x</mi><mo mathsize="1.200em">,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Disagree}\bigl(x,\mathcal{D}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex52X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{c}\mathds{1}\Big[\mathds{1}\left[x(+j)\geq x(-j)\right]\;\neq\;\mathds{1}\left[\mathcal{D}(+j)\geq\mathcal{D}(-j)\right]\Big]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>c</mi></msup><mn>𝟙</mn><mo maxsize="1.600em" minsize="1.600em">[</mo><mn>𝟙</mn><mo>[</mo><mi>x</mi><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo><mo>≥</mo><mi>x</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo><mo rspace="0.280em">]</mo><mo>≠</mo><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><mo>[</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo><mo>≥</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo><mo>]</mo><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{c}\mathds{1}\Big[\mathds{1}\left[x(+j)\geq x(-j)\right]\;\neq\;\mathds{1}\left[\mathcal{D}(+j)\geq\mathcal{D}(-j)\right]\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex52Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex52Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{j=1}^{c}\mathds{1}\Big[\mathds{1}\left[x(+j)\geq x(-j)\right]\;\neq\;\mathds{1}\left[\sigma_{j}=+1\right]\Big]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>c</mi></msup><mn>𝟙</mn><mo maxsize="1.600em" minsize="1.600em">[</mo><mn>𝟙</mn><mo>[</mo><mi>x</mi><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo><mo>≥</mo><mi>x</mi><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo><mo rspace="0.280em">]</mo><mo>≠</mo><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><mo>[</mo><mi>σ</mi><msub><mrow></mrow><mi>j</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">+</mo><mn>1</mn><mo>]</mo><mo maxsize="1.600em" minsize="1.600em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=1}^{c}\mathds{1}\Big[\mathds{1}\left[x(+j)\geq x(-j)\right]\;\neq\;\mathds{1}\left[\sigma_{j}=+1\right]\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma B.3</span></span><span id="A2.Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma3.p1" class="ltx_para">
<p id="A2.Thmlemma3.p1.1" class="ltx_p"><math id="A2.Thmlemma3.p1.m1" class="ltx_Math" alttext="U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mi>ϵ</mi><mi>c</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})</annotation></semantics></math><span id="A2.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">. In particular, the optimal strategy for the leader is <math id="A2.Thmlemma3.p1.m2" class="ltx_Math" alttext="x^{*}=\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mo>∗</mo></msup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">x^{*}=\mathcal{D}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.p9" class="ltx_para">
<table id="A2.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\displaystyle U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})=\sum_{j=1}^{c}\Bigg(" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})=\sum_{j=1}^{c}\Bigg(</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex53.m2" class="ltx_math_unparsed" alttext="\displaystyle\frac{1+\sigma_{j}{\epsilon}}{2c}\Big(\mathds{1}\big[\mathcal{D}(+j)\geq\mathcal{D}(-j)\big]-\mathds{1}\big[x(+j)\geq x(-j)\big]\Big)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mn>𝟙</mn><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1+\sigma_{j}{\epsilon}}{2c}\Big(\mathds{1}\big[\mathcal{D}(+j)\geq\mathcal{D}(-j)\big]-\mathds{1}\big[x(+j)\geq x(-j)\big]\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex54.m1" class="ltx_math_unparsed" alttext="\displaystyle+\frac{1-\sigma_{j}{\epsilon}}{2c}\Big(\mathds{1}\big[\mathcal{D}(+j)&lt;\mathcal{D}(-j)\big]-\mathds{1}\big[x(+j)&lt;x(-j)\big]\Big)\Bigg)." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mn>𝟙</mn><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">+</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1-\sigma_{j}{\epsilon}}{2c}\Big(\mathds{1}\big[\mathcal{D}(+j)&lt;\mathcal{D}(-j)\big]-\mathds{1}\big[x(+j)&lt;x(-j)\big]\Big)\Bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p10" class="ltx_para">
<p id="A2.SS4.p10.1" class="ltx_p"><span id="A2.SS4.p10.1.1" class="ltx_text">For each term in the summation where <math id="A2.SS4.p10.m1" class="ltx_Math" alttext="\mathcal{D}(+j)\geq\mathcal{D}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}(+j)\geq\mathcal{D}(-j)</annotation></semantics></math> and <math id="A2.SS4.p10.m2" class="ltx_Math" alttext="x(+j)\geq x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)\geq x(-j)</annotation></semantics></math> agree, the term evaluates to <math id="A2.SS4.p10.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. When they disagree, there are two possible cases:</span></p>
<ol id="A2.I5" class="ltx_enumerate">
<li id="A2.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I5.i1.p1" class="ltx_para">
<p id="A2.I5.i1.p1.1" class="ltx_p"><math id="A2.I5.i1.p1.m1" class="ltx_Math" alttext="\mathcal{D}(+j)\geq\mathcal{D}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}(+j)\geq\mathcal{D}(-j)</annotation></semantics></math> but <math id="A2.I5.i1.p1.m2" class="ltx_Math" alttext="x(+j)&lt;x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)&lt;x(-j)</annotation></semantics></math>. Since <math id="A2.I5.i1.p1.m3" class="ltx_Math" alttext="\mathcal{D}(+j)\geq\mathcal{D}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}(+j)\geq\mathcal{D}(-j)</annotation></semantics></math> implies <math id="A2.I5.i1.p1.m4" class="ltx_Math" alttext="\sigma_{j}=+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo>=</mo><mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\sigma_{j}=+1</annotation></semantics></math>, the term simplifies to</p>
<table id="A2.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\frac{1+{\epsilon}}{2c}-\frac{1-{\epsilon}}{2c}=\frac{{\epsilon}}{c}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo>=</mo><mfrac><mi>ϵ</mi><mi>c</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1+{\epsilon}}{2c}-\frac{1-{\epsilon}}{2c}=\frac{{\epsilon}}{c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I5.i2.p1" class="ltx_para">
<p id="A2.I5.i2.p1.1" class="ltx_p"><math id="A2.I5.i2.p1.m1" class="ltx_Math" alttext="\mathcal{D}(+j)&lt;\mathcal{D}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}(+j)&lt;\mathcal{D}(-j)</annotation></semantics></math> but <math id="A2.I5.i2.p1.m2" class="ltx_Math" alttext="x(+j)\geq x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)\geq x(-j)</annotation></semantics></math>. Here, <math id="A2.I5.i2.p1.m3" class="ltx_Math" alttext="\sigma_{j}=-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\sigma_{j}=-1</annotation></semantics></math>, so the term simplifies to</p>
<table id="A2.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex56.m1" class="ltx_Math" alttext="-\frac{1-{\epsilon}}{2c}+\frac{1+{\epsilon}}{2c}=\frac{{\epsilon}}{c}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo>+</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo>=</mo><mfrac><mi>ϵ</mi><mi>c</mi></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-\frac{1-{\epsilon}}{2c}+\frac{1+{\epsilon}}{2c}=\frac{{\epsilon}}{c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
<div id="A2.SS4.p11" class="ltx_para">
<p id="A2.SS4.p11.1" class="ltx_p"><span id="A2.SS4.p11.1.1" class="ltx_text">Thus, we conclude that</span></p>
<table id="A2.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex57.m1" class="ltx_Math" alttext="U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mi>ϵ</mi><mi>c</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p11.2" class="ltx_p"><span id="A2.SS4.p11.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma4.2" class="ltx_text ltx_font_bold">Lemma B.4</span></span><span id="A2.Thmlemma4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma4.p1" class="ltx_para">
<p id="A2.Thmlemma4.p1.1" class="ltx_p"><span id="A2.Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmlemma4.p1.m1" class="ltx_Math" alttext="\hat{\mathcal{D}}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{D}}_{x}</annotation></semantics></math> be the estimated distribution constructed from <math id="A2.Thmlemma4.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> according to Equation (<a href="#A2.E13" title="In item 2 ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>). The total variation distance between <math id="A2.Thmlemma4.p1.m3" class="ltx_Math" alttext="\hat{\mathcal{D}}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{D}}_{x}</annotation></semantics></math> and <math id="A2.Thmlemma4.p1.m4" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> is given by</span></p>
<table id="A2.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex58.m1" class="ltx_Math" alttext="\delta(\hat{\mathcal{D}}_{x},\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi>ϵ</mi><mi>c</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta(\hat{\mathcal{D}}_{x},\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS4.p12" class="ltx_para">
<p id="A2.SS4.p12.1" class="ltx_p"><span id="A2.SS4.p12.1.1" class="ltx_text">By definition,</span></p>
<table id="A2.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\displaystyle\delta\bigl(\hat{\mathcal{D}}_{x},\mathcal{D}\bigr)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\delta\bigl(\hat{\mathcal{D}}_{x},\mathcal{D}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex59.m2" class="ltx_Math" alttext="\displaystyle\;=\;\frac{1}{2}\sum_{j=1}^{c}\bigg(\Bigl|\hat{\mathcal{D}}_{x}(+j)-\mathcal{D}(+j)\Bigr|+\Bigl|\hat{\mathcal{D}}_{x}(-j)-\mathcal{D}(-j)\Bigr|\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;=\;\frac{1}{2}\sum_{j=1}^{c}\bigg(\Bigl|\hat{\mathcal{D}}_{x}(+j)-\mathcal{D}(+j)\Bigr|+\Bigl|\hat{\mathcal{D}}_{x}(-j)-\mathcal{D}(-j)\Bigr|\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p12.2" class="ltx_p"><span id="A2.SS4.p12.2.1" class="ltx_text">If <math id="A2.SS4.p12.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="A2.SS4.p12.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> agree at <math id="A2.SS4.p12.m3" class="ltx_Math" alttext="(+j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(+j)</annotation></semantics></math> and <math id="A2.SS4.p12.m4" class="ltx_Math" alttext="(-j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(-j)</annotation></semantics></math>, the corresponding term in the total variation sum is <math id="A2.SS4.p12.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. Consequently, we only need to consider the case when a disagreement occurs.</span></p>
<ol id="A2.I6" class="ltx_enumerate">
<li id="A2.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I6.i1.p1" class="ltx_para">
<p id="A2.I6.i1.p1.1" class="ltx_p"><math id="A2.I6.i1.p1.m1" class="ltx_Math" alttext="x(+j)&lt;x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)&lt;x(-j)</annotation></semantics></math> while <math id="A2.I6.i1.p1.m2" class="ltx_Math" alttext="\mathcal{D}(+j)\geq\mathcal{D}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}(+j)\geq\mathcal{D}(-j)</annotation></semantics></math>.
In this case,</p>
<table id="A2.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex60.m1" class="ltx_Math" alttext="\hat{\mathcal{D}}_{x}(+j)=\frac{1-{\epsilon}}{2c},\quad\hat{\mathcal{D}}_{x}(-j)=\frac{1+{\epsilon}}{2c},\quad\mathcal{D}(+j)=\frac{1+{\epsilon}}{2c},\quad\mathcal{D}(-j)=\frac{1-{\epsilon}}{2c}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\mathcal{D}}_{x}(+j)=\frac{1-{\epsilon}}{2c},\quad\hat{\mathcal{D}}_{x}(-j)=\frac{1+{\epsilon}}{2c},\quad\mathcal{D}(+j)=\frac{1+{\epsilon}}{2c},\quad\mathcal{D}(-j)=\frac{1-{\epsilon}}{2c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I6.i1.p1.2" class="ltx_p">Hence,</p>
<table id="A2.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61.m1" class="ltx_Math" alttext="\displaystyle\Bigl|\hat{\mathcal{D}}_{x}(+j)-\mathcal{D}(+j)\Bigr|+\Bigl|\hat{\mathcal{D}}_{x}(-j)-\mathcal{D}(-j)\Bigr|\;=\;\frac{{\epsilon}}{c}+\frac{{\epsilon}}{c}\;=\;\frac{2\,{\epsilon}}{c}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em" stretchy="true">|</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mi>c</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mi>c</mi></mfrac></mstyle></mrow><mo lspace="0.558em" rspace="0.558em">=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mi>c</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigl|\hat{\mathcal{D}}_{x}(+j)-\mathcal{D}(+j)\Bigr|+\Bigl|\hat{\mathcal{D}}_{x}(-j)-\mathcal{D}(-j)\Bigr|\;=\;\frac{{\epsilon}}{c}+\frac{{\epsilon}}{c}\;=\;\frac{2\,{\epsilon}}{c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I6.i2.p1" class="ltx_para">
<p id="A2.I6.i2.p1.1" class="ltx_p"><math id="A2.I6.i2.p1.m1" class="ltx_Math" alttext="x(+j)\geq x(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x(+j)\geq x(-j)</annotation></semantics></math> while <math id="A2.I6.i2.p1.m2" class="ltx_Math" alttext="\mathcal{D}(+j)&lt;\mathcal{D}(-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}(+j)&lt;\mathcal{D}(-j)</annotation></semantics></math>.
Similarly, we have</p>
<table id="A2.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\hat{\mathcal{D}}_{x}(+j)=\frac{1+{\epsilon}}{2c},\quad\hat{\mathcal{D}}_{x}(-j)=\frac{1-{\epsilon}}{2c},\quad\mathcal{D}(+j)=\frac{1-{\epsilon}}{2c},\quad\mathcal{D}(-j)=\frac{1+{\epsilon}}{2c}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>ϵ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\mathcal{D}}_{x}(+j)=\frac{1+{\epsilon}}{2c},\quad\hat{\mathcal{D}}_{x}(-j)=\frac{1-{\epsilon}}{2c},\quad\mathcal{D}(+j)=\frac{1-{\epsilon}}{2c},\quad\mathcal{D}(-j)=\frac{1+{\epsilon}}{2c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.I6.i2.p2" class="ltx_para">
<p id="A2.I6.i2.p2.1" class="ltx_p">Again, we have</p>
<table id="A2.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex63.m1" class="ltx_Math" alttext="\displaystyle\Bigl|\hat{\mathcal{D}}_{x}(+j)-\mathcal{D}(+j)\Bigr|+\Bigl|\hat{\mathcal{D}}_{x}(-j)-\mathcal{D}(-j)\Bigr|\;=\;\frac{{\epsilon}}{c}+\frac{{\epsilon}}{c}\;=\;\frac{2\,{\epsilon}}{c}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>+</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.280em" stretchy="true">|</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mi>c</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mi>c</mi></mfrac></mstyle></mrow><mo lspace="0.558em" rspace="0.558em">=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mi>c</mi></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Bigl|\hat{\mathcal{D}}_{x}(+j)-\mathcal{D}(+j)\Bigr|+\Bigl|\hat{\mathcal{D}}_{x}(-j)-\mathcal{D}(-j)\Bigr|\;=\;\frac{{\epsilon}}{c}+\frac{{\epsilon}}{c}\;=\;\frac{2\,{\epsilon}}{c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
<div id="A2.SS4.p13" class="ltx_para">
<p id="A2.SS4.p13.1" class="ltx_p"><span id="A2.SS4.p13.1.1" class="ltx_text">Thus, it follows that</span></p>
<table id="A2.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex64.m1" class="ltx_Math" alttext="\delta(\hat{\mathcal{D}}_{x},\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi>ϵ</mi><mi>c</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta(\hat{\mathcal{D}}_{x},\mathcal{D})=\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p13.2" class="ltx_p"><span id="A2.SS4.p13.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS4.p14" class="ltx_para">
<p id="A2.SS4.p14.1" class="ltx_p">From Lemma <a href="#A2.Thmlemma3" title="Lemma B.3. ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a> and Lemma <a href="#A2.Thmlemma4" title="Lemma B.4. ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>,</p>
<table id="A2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E15.m1" class="ltx_Math" alttext="U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})~=~\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})~=~\delta(\hat{\mathcal{D}}_{x},\mathcal{D})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mfrac><mi>ϵ</mi><mi>c</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>Disagree</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><mi>x</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U(\mathcal{D},\mathcal{D})-U(x,\mathcal{D})~=~\frac{{\epsilon}}{c}\cdot\mathrm{Disagree}(x,\mathcal{D})~=~\delta(\hat{\mathcal{D}}_{x},\mathcal{D}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p15" class="ltx_para">
<p id="A2.SS4.p15.1" class="ltx_p">Consider the regret of the online learning algorithm <math id="A2.SS4.p15.m1" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math> for the Bayesian Stackelberg game, where the algorithm outputs <math id="A2.SS4.p15.m2" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math> at round <math id="A2.SS4.p15.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. By Equation (<a href="#A2.E15" title="In B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) and Theorem <a href="#A2.Thmtheorem3" title="Theorem B.3 (e.g., [ , ]). ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>, the expected regret at round <math id="A2.SS4.p15.m4" class="ltx_Math" alttext="t\leq\mathcal{O}(\frac{2c}{{\epsilon}^{2}})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\leq\mathcal{O}(\frac{2c}{{\epsilon}^{2}})</annotation></semantics></math> is at least</p>
<table id="A2.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex65.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[U(\mathcal{D},\mathcal{D})-U(x^{t},\mathcal{D})]~=~\mathbb{E}[\delta(\hat{\mathcal{D}}_{x^{t}},\mathcal{D})]~\geq~\Omega({\epsilon})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>^</mo></mover><msup><mi>x</mi><mi>t</mi></msup></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">≥</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[U(\mathcal{D},\mathcal{D})-U(x^{t},\mathcal{D})]~=~\mathbb{E}[\delta(\hat{\mathcal{D}}_{x^{t}},\mathcal{D})]~\geq~\Omega({\epsilon}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p15.2" class="ltx_p">Thus, the expected regret over <math id="A2.SS4.p15.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> rounds is at least:</p>
<table id="A2.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex66.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\sum_{t=1}^{T}\mathbb{E}[U(\mathcal{D},\mathcal{D})-U(x^{t},\mathcal{D})]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\sum_{t=1}^{T}\mathbb{E}[U(\mathcal{D},\mathcal{D})-U(x^{t},\mathcal{D})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex66.m2" class="ltx_Math" alttext="\displaystyle~\geq~\min\Big\{T,\;\mathcal{O}\big(\frac{2c}{{\epsilon}^{2}}\big)\Big\}\cdot\Omega({\epsilon})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≥</mo><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>T</mi><mo rspace="0.447em">,</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">}</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\geq~\min\Big\{T,\;\mathcal{O}\big(\frac{2c}{{\epsilon}^{2}}\big)\Big\}\cdot\Omega({\epsilon})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex67.m1" class="ltx_Math" alttext="\displaystyle~\geq~\Omega(\sqrt{2cT})~=~\Omega(\sqrt{\min\{K,L\}T})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≥</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>K</mi><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\geq~\Omega(\sqrt{2cT})~=~\Omega(\sqrt{\min\{K,L\}T})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p15.3" class="ltx_p">where we choose <math id="A2.SS4.p15.m6" class="ltx_Math" alttext="{\epsilon}=\sqrt{\frac{2c}{T}}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mi>T</mi></mfrac></msqrt></mrow><annotation encoding="application/x-tex">{\epsilon}=\sqrt{\frac{2c}{T}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span><math id="A2.SS5.m1" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,nK\}T})</annotation></semantics></math> Lower Bound for the Multi-Follower Case: Proof of Theorem <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4.2 Lower Bound ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a></h3>

<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p">We now prove a lower bound of <math id="A2.SS5.p1.m1" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,nK\}T})</annotation></semantics></math> on the expected regret of any online learning algorithms for Bayesian Stackelberg games with multiple followers.
Without loss of generality, assume that <math id="A2.SS5.p1.m2" class="ltx_Math" alttext="nK" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">nK</annotation></semantics></math> is an even integer, and assume that the number of leader actions <math id="A2.SS5.p1.m3" class="ltx_Math" alttext="L\geq nK" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>≥</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">L\geq nK</annotation></semantics></math>.
We do a reduction from the single-follower problem to the multi-follower problem.</p>
</div>
<section id="A2.SS5.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Single-Follower Bayesian Stackelberg Game instance:</h4>

<div id="A2.SS5.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS5.SSS0.Px1.p1.1" class="ltx_p">Consider the single-follower Bayesian Stackelberg game instance defined in Appendix <a href="#A2.SS4" title="B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>, but instead of a single follower with <math id="A2.SS5.SSS0.Px1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> types, we change the instance so that the single follower has <math id="A2.SS5.SSS0.Px1.p1.m2" class="ltx_Math" alttext="nK" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">nK</annotation></semantics></math> types, indexed by <math id="A2.SS5.SSS0.Px1.p1.m3" class="ltx_math_unparsed" alttext="\Theta=\{(i,j):i\in[n],j\in[K]\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta=\{(i,j):i\in[n],j\in[K]\}</annotation></semantics></math>.
Suppose the single follower’s type distribution <math id="A2.SS5.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> belongs to the class <math id="A2.SS5.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> in Definition <a href="#A2.Thmdefinition4" title="Definition B.4 (Class of Distributions 𝒞). ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a> with support size <math id="A2.SS5.SSS0.Px1.p1.m6" class="ltx_Math" alttext="2c=nK" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">2c=nK</annotation></semantics></math> (instead of <math id="A2.SS5.SSS0.Px1.p1.m7" class="ltx_Math" alttext="2c=K" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>=</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">2c=K</annotation></semantics></math>). Note that for such a <math id="A2.SS5.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\mathcal{D}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}\in\mathcal{C}</annotation></semantics></math>,</p>
<table id="A2.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex68.m1" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{n}\sum_{j=1}^{K}\mathcal{D}(i,j)=1~~\text{ and }~~\forall i\in[n],~~\sum_{j=1}^{K}\mathcal{D}(i,j)=\frac{1}{n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo lspace="0.660em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0.827em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{n}\sum_{j=1}^{K}\mathcal{D}(i,j)=1~~\text{ and }~~\forall i\in[n],~~\sum_{j=1}^{K}\mathcal{D}(i,j)=\frac{1}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px1.p1.2" class="ltx_p">The follower’s utility function <math id="A2.SS5.SSS0.Px1.p1.m9" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is given by (<a href="#A2.E11" title="In 1st item ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), except that we now use <math id="A2.SS5.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\theta=(i,j)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta=(i,j)</annotation></semantics></math> to represent a type and <math id="A2.SS5.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\ell=(i,j)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell=(i,j)</annotation></semantics></math> to represent a leader’s action. The leader’s action set is <math id="A2.SS5.SSS0.Px1.p1.m12" class="ltx_Math" alttext="\mathcal{L}=\Theta" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\mathcal{L}=\Theta</annotation></semantics></math>, with utility function <math id="A2.SS5.SSS0.Px1.p1.m13" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> given by (<a href="#A2.E12" title="In 2nd item ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</p>
</div>
</section>
<section id="A2.SS5.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Multi-Follower Bayesian Stackelberg Game instance:</h4>

<div id="A2.SS5.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS5.SSS0.Px2.p1.1" class="ltx_p">We reduce the single-follower game to an <math id="A2.SS5.SSS0.Px2.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game defined below.
Consider a Bayesian Stackelberg game with <math id="A2.SS5.SSS0.Px2.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> followers each with <math id="A2.SS5.SSS0.Px2.p1.m3" class="ltx_Math" alttext="K+1" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K+1</annotation></semantics></math> types.
The type distribution and the followers and leader’s actions and utilities are defined below:
(To distinguish the notations from the single-follower game, we use tilde notations <math id="A2.SS5.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\tilde{\cdot}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>⋅</mo><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\cdot}</annotation></semantics></math>)</p>
<ul id="A2.I7" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<li id="A2.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i1.p1" class="ltx_para">
<p id="A2.I7.i1.p1.1" class="ltx_p"><span id="A2.I7.i1.p1.1.1" class="ltx_text ltx_font_bold">Type distribution</span>: The followers’ types are independently distributed according to distribution <math id="A2.I7.i1.p1.m1" class="ltx_Math" alttext="\tilde{\bm{\mathcal{D}}}=\prod_{i=1}^{n}\tilde{\mathcal{D}}_{i}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>~</mo></mover><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\bm{\mathcal{D}}}=\prod_{i=1}^{n}\tilde{\mathcal{D}}_{i}</annotation></semantics></math> where the probability that follower <math id="A2.I7.i1.p1.m2" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math> has type <math id="A2.I7.i1.p1.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is:</p>
<table id="A2.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex69.m1" class="ltx_Math" alttext="\tilde{\mathcal{D}}_{i}(j)=\begin{cases}1-\frac{1}{100n}&amp;\text{if }j=0,\\
\frac{1}{100}\mathcal{D}(i,j)&amp;\text{if }j=1,\ldots,K.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>100</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{D}}_{i}(j)=\begin{cases}1-\frac{1}{100n}&amp;\text{if }j=0,\\
\frac{1}{100}\mathcal{D}(i,j)&amp;\text{if }j=1,\ldots,K.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i2.p1" class="ltx_para">
<p id="A2.I7.i2.p1.1" class="ltx_p"><span id="A2.I7.i2.p1.1.1" class="ltx_text ltx_font_bold">Followers’ actions and utilities</span>: Each follower has 3 actions <math id="A2.I7.i2.p1.m1" class="ltx_Math" alttext="\tilde{\mathcal{A}}=\{\text{Good},\text{Bad},a_{0}\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>Good</mtext><mo>,</mo><mtext>Bad</mtext><mo>,</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{A}}=\{\text{Good},\text{Bad},a_{0}\}</annotation></semantics></math>.
The utility of a follower <math id="A2.I7.i2.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> with type <math id="A2.I7.i2.p1.m3" class="ltx_Math" alttext="j\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\neq 0</annotation></semantics></math> is equal to the utility of the single follower with type <math id="A2.I7.i2.p1.m4" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math>. Utilities for type <math id="A2.I7.i2.p1.m5" class="ltx_Math" alttext="j=0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j=0</annotation></semantics></math> and action <math id="A2.I7.i2.p1.m6" class="ltx_Math" alttext="a_{0}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>0</mn></msub><annotation encoding="application/x-tex">a_{0}</annotation></semantics></math> are specially defined:</p>
<table id="A2.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex70.m1" class="ltx_Math" alttext="\tilde{v}_{i}(\ell,a,\theta_{i}=j)=\begin{cases}v(\ell,a,(i,j))&amp;\text{ if }\theta_{i}\neq 0\text{ and }a\neq a_{0}\\
-1&amp;\text{ if }\theta_{i}\neq 0\text{ and }a=a_{0},\\
1&amp;\text{ if }\theta_{i}=0\text{ and }a=a_{0},\\
-1&amp;\text{ if }\theta_{i}=0\text{ and }a\neq a_{0}.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>a</mi><mo>,</mo><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>=</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>a</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>i</mi></msub></mrow><mo>≠</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>≠</mo><msub><mi>a</mi><mn>0</mn></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>i</mi></msub></mrow><mo>≠</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>=</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>=</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>≠</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\tilde{v}_{i}(\ell,a,\theta_{i}=j)=\begin{cases}v(\ell,a,(i,j))&amp;\text{ if }\theta_{i}\neq 0\text{ and }a\neq a_{0}\\
-1&amp;\text{ if }\theta_{i}\neq 0\text{ and }a=a_{0},\\
1&amp;\text{ if }\theta_{i}=0\text{ and }a=a_{0},\\
-1&amp;\text{ if }\theta_{i}=0\text{ and }a\neq a_{0}.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I7.i2.p1.2" class="ltx_p">Note that the best-response action of a follower with type <math id="A2.I7.i2.p1.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> is always <math id="A2.I7.i2.p1.m8" class="ltx_Math" alttext="a_{0}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>0</mn></msub><annotation encoding="application/x-tex">a_{0}</annotation></semantics></math>, regardless of the leader’s strategy.</p>
</div></li>
<li id="A2.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I7.i3.p1" class="ltx_para">
<p id="A2.I7.i3.p1.1" class="ltx_p"><span id="A2.I7.i3.p1.1.1" class="ltx_text ltx_font_bold">Leader’s actions and utilities:</span> The leader has the same action set as the single-follower game: <math id="A2.I7.i3.p1.m1" class="ltx_math_unparsed" alttext="\mathcal{L}=\Theta=\{(i,j):i\in[n],j\in[K]\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\Theta=\{(i,j):i\in[n],j\in[K]\}</annotation></semantics></math>. For any leader action <math id="A2.I7.i3.p1.m2" class="ltx_Math" alttext="\ell\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">\ell\in\mathcal{L}</annotation></semantics></math>,</p>
<table id="A2.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex71.m1" class="ltx_Math" alttext="\tilde{u}(\ell,\bm{a})=\begin{cases}1&amp;\text{if }n-1\text{ followers choose }a_{0}\text{ and one plays Good},\\
0&amp;\text{otherwise}.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mtext> followers choose </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and one plays Good</mtext></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>otherwise</mtext><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}(\ell,\bm{a})=\begin{cases}1&amp;\text{if }n-1\text{ followers choose }a_{0}\text{ and one plays Good},\\
0&amp;\text{otherwise}.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="A2.SS5.SSS0.Px2.p2" class="ltx_para"><span id="A2.SS5.SSS0.Px2.p2.1" class="ltx_inline-logical-block ltx_framed ltx_framed_rectangle">
<span id="A2.SS5.SSS0.Px2.p2.p1" class="ltx_para">
<span id="A2.SS5.SSS0.Px2.p2.p1.1" class="ltx_p">Given an online learning algorithm <math id="A2.SS5.SSS0.Px2.p2.p1.m1" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math> for the <math id="A2.SS5.SSS0.Px2.p2.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower problem, we construct an online learning algorithm for the single-follower problem as follows:</span>
</span>
<span id="A2.SS5.SSS0.Px2.p2.p2" class="ltx_para">
<span id="A2.SS5.SSS0.Px2.p2.p2.1" class="ltx_p">At each round <math id="A2.SS5.SSS0.Px2.p2.p2.m1" class="ltx_Math" alttext="t=1,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\ldots,T</annotation></semantics></math>:</span>
<span id="A2.I8" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<span id="A2.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I8.i1.p1" class="ltx_para">
<span id="A2.I8.i1.p1.1" class="ltx_p">Obtain a strategy <math id="A2.I8.i1.p1.m1" class="ltx_Math" alttext="x^{t}\in\Delta(\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>t</mi></msup><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{t}\in\Delta(\mathcal{L})</annotation></semantics></math> from algorithm <math id="A2.I8.i1.p1.m2" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math>. Output <math id="A2.I8.i1.p1.m3" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math>.</span>
</span></span>
<span id="A2.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I8.i2.p1" class="ltx_para">
<span id="A2.I8.i2.p1.1" class="ltx_p">Receive a sample of the single follower’s type <math id="A2.I8.i2.p1.m1" class="ltx_Math" alttext="\theta^{t}=(i^{t},j^{t})\sim\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>θ</mi><mi>t</mi></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mi>t</mi></msup><mo>,</mo><msup><mi>j</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">\theta^{t}=(i^{t},j^{t})\sim\mathcal{D}</annotation></semantics></math>.</span>
</span></span>
<span id="A2.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I8.i3.p1" class="ltx_para">
<span id="A2.I8.i3.p1.1" class="ltx_p">For every follower <math id="A2.I8.i3.p1.m1" class="ltx_Math" alttext="i\in[n]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]</annotation></semantics></math>, we construct their type <math id="A2.I8.i3.p1.m2" class="ltx_Math" alttext="\theta_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">\theta_{i}^{t}</annotation></semantics></math> in the following way: Independently flip a coin that lands on head with probability <math id="A2.I8.i3.p1.m3" class="ltx_Math" alttext="1-\frac{1}{100n}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{1}{100n}</annotation></semantics></math>. If it lands on head, set the follower type <math id="A2.I8.i3.p1.m4" class="ltx_Math" alttext="\theta_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">\theta_{i}^{t}</annotation></semantics></math> to <math id="A2.I8.i3.p1.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
If it lands on tail, we select the most recent sample of the form <math id="A2.I8.i3.p1.m6" class="ltx_Math" alttext="(i^{s}=i,j^{s})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msup><mi>i</mi><mi>s</mi></msup><mo>=</mo><mi>i</mi></mrow><mo>,</mo><msup><mi>j</mi><mi>s</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i^{s}=i,j^{s})</annotation></semantics></math> from the history <math id="A2.I8.i3.p1.m7" class="ltx_Math" alttext="\{(i^{s},j^{s})\}_{s=1}^{t}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mi>s</mi></msup><mo>,</mo><msup><mi>j</mi><mi>s</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><annotation encoding="application/x-tex">\{(i^{s},j^{s})\}_{s=1}^{t}</annotation></semantics></math>, and set the follower’s type <math id="A2.I8.i3.p1.m8" class="ltx_Math" alttext="\theta_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">\theta_{i}^{t}</annotation></semantics></math> to <math id="A2.I8.i3.p1.m9" class="ltx_Math" alttext="j^{s}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mi>s</mi></msup><annotation encoding="application/x-tex">j^{s}</annotation></semantics></math>.
Each sample can only be used once.
If there are insufficient samples, we halt the algorithm.</span>
</span></span>
<span id="A2.I8.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I8.i4.p1" class="ltx_para">
<span id="A2.I8.i4.p1.1" class="ltx_p">Provide the constructed types <math id="A2.I8.i4.p1.m1" class="ltx_Math" alttext="(\theta_{1}^{t},\ldots,\theta_{n}^{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mn>1</mn><mi>t</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>θ</mi><mi>n</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\theta_{1}^{t},\ldots,\theta_{n}^{t})</annotation></semantics></math> to algorithm <math id="A2.I8.i4.p1.m2" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math>.</span>
</span></span>
</span>
</span></span>
</div>
<div id="A2.SS5.SSS0.Px2.p3" class="ltx_para">
<p id="A2.SS5.SSS0.Px2.p3.1" class="ltx_p">In the above reduction process, if we always have sufficient samples in the third step at each round, then the distribution of samples <math id="A2.SS5.SSS0.Px2.p3.m1" class="ltx_Math" alttext="(\theta_{1}^{t},\ldots,\theta^{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mn>1</mn><mi>t</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>θ</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\theta_{1}^{t},\ldots,\theta^{t})</annotation></semantics></math> provided to algorithm <math id="A2.SS5.SSS0.Px2.p3.m2" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math> is equal to the type distribution <math id="A2.SS5.SSS0.Px2.p3.m3" class="ltx_Math" alttext="\tilde{\bm{\mathcal{D}}}=\prod_{i=1}^{n}\tilde{\mathcal{D}}_{i}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>~</mo></mover><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{\bm{\mathcal{D}}}=\prod_{i=1}^{n}\tilde{\mathcal{D}}_{i}</annotation></semantics></math> of the <math id="A2.SS5.SSS0.Px2.p3.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game. Thus, from algorithm <math id="A2.SS5.SSS0.Px2.p3.m5" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math>’s perspective, it is solving the <math id="A2.SS5.SSS0.Px2.p3.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game with unknown type distribution <math id="A2.SS5.SSS0.Px2.p3.m7" class="ltx_Math" alttext="\tilde{\bm{\mathcal{D}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{\mathcal{D}}}</annotation></semantics></math>.
We then argue that we have sufficient samples with high probability.
Let <math id="A2.SS5.SSS0.Px2.p3.m8" class="ltx_Math" alttext="H_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">H_{i}^{t}</annotation></semantics></math> be the number of available samples in the history that we can use to set follower <math id="A2.SS5.SSS0.Px2.p3.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>’s type at round <math id="A2.SS5.SSS0.Px2.p3.m10" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, and let <math id="A2.SS5.SSS0.Px2.p3.m11" class="ltx_Math" alttext="N_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">N_{i}^{t}</annotation></semantics></math> be the number of samples that we actually need.
Define</p>
<table id="A2.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex72.m1" class="ltx_math_unparsed" alttext="\displaystyle 1-\delta(t)=\Pr\big(\forall i\in[n],H_{i}^{t}\geq N_{i}^{t}\big)," display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>Pr</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo rspace="0.167em">∀</mo><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><msubsup><mi>H</mi><mi>i</mi><mi>t</mi></msubsup><mo>≥</mo><msubsup><mi>N</mi><mi>i</mi><mi>t</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1-\delta(t)=\Pr\big(\forall i\in[n],H_{i}^{t}\geq N_{i}^{t}\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p3.2" class="ltx_p">which is the probability that we have sufficient samples at round <math id="A2.SS5.SSS0.Px2.p3.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmclaim2" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmclaim2.2" class="ltx_text ltx_font_bold">Claim B.2</span></span><span id="A2.Thmclaim2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmclaim2.p1" class="ltx_para">
<p id="A2.Thmclaim2.p1.1" class="ltx_p"><math id="A2.Thmclaim2.p1.m1" class="ltx_Math" alttext="\delta(t)\leq 2n\exp\Bigl(-\frac{t^{2}\bigl(\tfrac{1}{100n}-\tfrac{1}{n}\bigr)^{2}}{2t}\Bigr)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mfrac><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><mstyle scriptlevel="-1"><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>−</mo><mstyle scriptlevel="-1"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta(t)\leq 2n\exp\Bigl(-\frac{t^{2}\bigl(\tfrac{1}{100n}-\tfrac{1}{n}\bigr)^{2}}{2t}\Bigr)</annotation></semantics></math><span id="A2.Thmclaim2.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div>
</div>
<div id="A2.SS5.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS5.SSS0.Px2.p4" class="ltx_para">
<p id="A2.SS5.SSS0.Px2.p4.1" class="ltx_p"><span id="A2.SS5.SSS0.Px2.p4.1.1" class="ltx_text">Note that <math id="A2.SS5.SSS0.Px2.p4.m1" class="ltx_Math" alttext="H_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">H_{i}^{t}</annotation></semantics></math> and <math id="A2.SS5.SSS0.Px2.p4.m2" class="ltx_Math" alttext="N_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>N</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">N_{i}^{t}</annotation></semantics></math> are Binomial random variables: <math id="A2.SS5.SSS0.Px2.p4.m3" class="ltx_Math" alttext="H_{i}^{t}\sim\mathrm{Bin}(t,\frac{1}{n})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mi>i</mi><mi>t</mi></msubsup><mo>∼</mo><mrow><mi>Bin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mfrac><mn>1</mn><mi>n</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{i}^{t}\sim\mathrm{Bin}(t,\frac{1}{n})</annotation></semantics></math>, <math id="A2.SS5.SSS0.Px2.p4.m4" class="ltx_Math" alttext="N_{i}^{t}\sim\mathrm{Bin}(t,\frac{1}{100n})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>N</mi><mi>i</mi><mi>t</mi></msubsup><mo>∼</mo><mrow><mi>Bin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{i}^{t}\sim\mathrm{Bin}(t,\frac{1}{100n})</annotation></semantics></math>. So, by union bound and Hoeffding’s inequality:</span></p>
<table id="A2.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_math_unparsed" alttext="\displaystyle\Pr\bigl(\exists i\in[n],\,H_{i}^{t}&lt;N_{i}^{t}\bigr)" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mo rspace="0.167em">∃</mo><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo rspace="0.337em">,</mo><msubsup><mi>H</mi><mi>i</mi><mi>t</mi></msubsup><mo>&lt;</mo><msubsup><mi>N</mi><mi>i</mi><mi>t</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\bigl(\exists i\in[n],\,H_{i}^{t}&lt;N_{i}^{t}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m2" class="ltx_Math" alttext="\displaystyle\leq n\Pr\bigl(H_{i}^{t}&lt;N_{i}^{t}\bigr)\leq 2n\exp\Bigl(-\frac{t^{2}\bigl(\tfrac{1}{100n}-\tfrac{1}{n}\bigr)^{2}}{2t}\Bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>H</mi><mi>i</mi><mi>t</mi></msubsup><mo>&lt;</mo><msubsup><mi>N</mi><mi>i</mi><mi>t</mi></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq n\Pr\bigl(H_{i}^{t}&lt;N_{i}^{t}\bigr)\leq 2n\exp\Bigl(-\frac{t^{2}\bigl(\tfrac{1}{100n}-\tfrac{1}{n}\bigr)^{2}}{2t}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p4.2" class="ltx_p"><span id="A2.SS5.SSS0.Px2.p4.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS5.SSS0.Px2.p5" class="ltx_para">
<p id="A2.SS5.SSS0.Px2.p5.1" class="ltx_p">Let <math id="A2.SS5.SSS0.Px2.p5.m1" class="ltx_Math" alttext="\tilde{U}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{U}(x)</annotation></semantics></math> be the leader’s expected utility in the <math id="A2.SS5.SSS0.Px2.p5.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game (on type distribution <math id="A2.SS5.SSS0.Px2.p5.m3" class="ltx_Math" alttext="\tilde{\bm{\mathcal{D}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\bm{\mathcal{D}}}</annotation></semantics></math>) and <math id="A2.SS5.SSS0.Px2.p5.m4" class="ltx_Math" alttext="U(x)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(x)</annotation></semantics></math> be the leader’s utility in the single-follower game (on type distribution <math id="A2.SS5.SSS0.Px2.p5.m5" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>).
We note that, given any strategy <math id="A2.SS5.SSS0.Px2.p5.m6" class="ltx_Math" alttext="x\in\Delta(\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in\Delta(\mathcal{L})</annotation></semantics></math> of the leader, the best-response action of follower <math id="A2.SS5.SSS0.Px2.p5.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> with type <math id="A2.SS5.SSS0.Px2.p5.m8" class="ltx_Math" alttext="\theta_{i}=j\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>=</mo><mi>j</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\theta_{i}=j\neq 0</annotation></semantics></math> (in the <math id="A2.SS5.SSS0.Px2.p5.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game) is equal to the best-response action of the single follower with type <math id="A2.SS5.SSS0.Px2.p5.m10" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math>, namely, <math id="A2.SS5.SSS0.Px2.p5.m11" class="ltx_Math" alttext="\mathrm{br}_{i}(j,x)=\mathrm{br}((i,j),x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>br</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>br</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{br}_{i}(j,x)=\mathrm{br}((i,j),x)</annotation></semantics></math>. Thus,</p>
<table id="A2.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex74.m1" class="ltx_Math" alttext="\displaystyle\tilde{U}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{U}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex74.m2" class="ltx_Math" alttext="\displaystyle~=~\Pr[\text{exactly one follower has a non-$0$ type}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>exactly one follower has a non-</mtext><mn>0</mn><mtext> type</mtext></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\Pr[\text{exactly one follower has a non-$0$ type}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex75.m1" class="ltx_Math" alttext="\displaystyle\qquad\cdot\mathbb{E}[\text{leader's utility}\mid\text{exactly one follower has a non-$0$ type}]~+~0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="2.222em" rspace="0.222em">⋅</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>leader’s utility</mtext><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mtext>exactly one follower has a non-</mtext><mn>0</mn><mtext> type</mtext></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.552em">+</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\cdot\mathbb{E}[\text{leader's utility}\mid\text{exactly one follower has a non-$0$ type}]~+~0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle~=~\Bigl(1-\frac{1}{100n}\Bigr)^{n-1}\sum_{i=1}^{n}\sum_{j=1}^{K}\frac{1}{100}\mathcal{D}(i,j)\,\mathds{1}\left[\mathrm{br}_{i}\bigl(j,x\bigr)=\text{Good}\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.608em">=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>100</mn></mfrac></mstyle><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><mrow><mo>[</mo><msub><mi>br</mi><mi>i</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>j</mi><mo>,</mo><mi>x</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><mtext>Good</mtext><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\Bigl(1-\frac{1}{100n}\Bigr)^{n-1}\sum_{i=1}^{n}\sum_{j=1}^{K}\frac{1}{100}\mathcal{D}(i,j)\,\mathds{1}\left[\mathrm{br}_{i}\bigl(j,x\bigr)=\text{Good}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_math_unparsed" alttext="\displaystyle~=~\Bigl(1-\frac{1}{100n}\Bigr)^{n-1}\sum_{i=1}^{n}\sum_{j=1}^{K}\frac{1}{100}\mathcal{D}(i,j)\,\mathds{1}\left[\mathrm{br}\bigl((i,j),x\bigr)=\text{Good}\right]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.608em">=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>100</mn></mfrac></mstyle><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><mrow><mo>[</mo><mi>br</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>x</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>=</mo><mtext>Good</mtext><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\Bigl(1-\frac{1}{100n}\Bigr)^{n-1}\sum_{i=1}^{n}\sum_{j=1}^{K}\frac{1}{100}\mathcal{D}(i,j)\,\mathds{1}\left[\mathrm{br}\bigl((i,j),x\bigr)=\text{Good}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle~=~\frac{1}{100}\Bigl(1-\frac{1}{100n}\Bigr)^{n-1}\,U(x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>100</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\frac{1}{100}\Bigl(1-\frac{1}{100n}\Bigr)^{n-1}\,U(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle~\approx~\frac{1}{100}e^{-\frac{1}{100}}\,U(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≈</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>100</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>100</mn></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\approx~\frac{1}{100}e^{-\frac{1}{100}}\,U(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p5.2" class="ltx_p">Define <math id="A2.SS5.SSS0.Px2.p5.m12" class="ltx_Math" alttext="C=\frac{1}{100}(1-\frac{1}{100n})^{n-1}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mn>100</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">C=\frac{1}{100}(1-\frac{1}{100n})^{n-1}</annotation></semantics></math>. Let <math id="A2.SS5.SSS0.Px2.p5.m13" class="ltx_Math" alttext="\tilde{r}(t)=\tilde{U}(x^{*})-\tilde{U}(x^{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{r}(t)=\tilde{U}(x^{*})-\tilde{U}(x^{t})</annotation></semantics></math> denote the per-round regret of the online learning algorithm <math id="A2.SS5.SSS0.Px2.p5.m14" class="ltx_Math" alttext="\mathrm{Alg}" display="inline" intent=":literal"><semantics><mi>Alg</mi><annotation encoding="application/x-tex">\mathrm{Alg}</annotation></semantics></math> for the <math id="A2.SS5.SSS0.Px2.p5.m15" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game.
Let <math id="A2.SS5.SSS0.Px2.p5.m16" class="ltx_Math" alttext="r(t)=U(x^{*})-U(x^{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r(t)=U(x^{*})-U(x^{t})</annotation></semantics></math> denote the per-round regret of the single-follower algorithm constructed by the above reduction.
Consider the expected total regret in the <math id="A2.SS5.SSS0.Px2.p5.m17" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-follower game:</p>
<table id="A2.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\tilde{\mathrm{Reg}}(T)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>Reg</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tilde{\mathrm{Reg}}(T)]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\mathbb{E}[\tilde{r}(t)]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\mathbb{E}[\tilde{r}(t)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle\geq\sum_{t=1}^{T}\Big((1-\delta(t))\cdot\mathbb{E}[\tilde{r}(t)]\;-\;\delta(t)\cdot 1\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.502em">−</mo><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mn>1</mn></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sum_{t=1}^{T}\Big((1-\delta(t))\cdot\mathbb{E}[\tilde{r}(t)]\;-\;\delta(t)\cdot 1\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\bigl(1-\delta(t)\bigr)\cdot C\cdot\mathbb{E}[r(t)]\;-\;\sum_{t=1}^{T}\delta(t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.502em">−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\bigl(1-\delta(t)\bigr)\cdot C\cdot\mathbb{E}[r(t)]\;-\;\sum_{t=1}^{T}\delta(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\displaystyle\geq C\cdot\sum_{t=1}^{T}\mathbb{E}[r(t)]\;-\;\sum_{t=1}^{T}\delta(t)\cdot C\cdot 1\;-\;\sum_{t=1}^{T}\delta(t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.502em">−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>1</mn></mrow></mrow><mo lspace="0.502em" rspace="0.502em">−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq C\cdot\sum_{t=1}^{T}\mathbb{E}[r(t)]\;-\;\sum_{t=1}^{T}\delta(t)\cdot C\cdot 1\;-\;\sum_{t=1}^{T}\delta(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex84.m1" class="ltx_Math" alttext="\displaystyle=C\cdot\mathbb{E}[\mathrm{Reg}(T)]\;-\;(C+1)\sum_{t=1}^{T}\delta(t)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.502em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=C\cdot\mathbb{E}[\mathrm{Reg}(T)]\;-\;(C+1)\sum_{t=1}^{T}\delta(t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS5.SSS0.Px2.p6" class="ltx_para">
<p id="A2.SS5.SSS0.Px2.p6.1" class="ltx_p">Now, we bound <math id="A2.SS5.SSS0.Px2.p6.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\delta(t)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\delta(t)</annotation></semantics></math>. Consider a threshold <math id="A2.SS5.SSS0.Px2.p6.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> such that for all <math id="A2.SS5.SSS0.Px2.p6.m3" class="ltx_Math" alttext="t\geq\tau" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">t\geq\tau</annotation></semantics></math>, we have <math id="A2.SS5.SSS0.Px2.p6.m4" class="ltx_Math" alttext="\delta(t)\leq\frac{1}{T^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\delta(t)\leq\frac{1}{T^{2}}</annotation></semantics></math>.
To find <math id="A2.SS5.SSS0.Px2.p6.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, we solve</p>
<table id="A2.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex85.m1" class="ltx_Math" alttext="2n\exp\Big(-\frac{(1/100n-1/n)^{2}}{2}\tau\Big)\leq\frac{1}{T^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>100</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2n\exp\Big(-\frac{(1/100n-1/n)^{2}}{2}\tau\Big)\leq\frac{1}{T^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p6.2" class="ltx_p">Rearranging, we choose <math id="A2.SS5.SSS0.Px2.p6.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> such that</p>
<table id="A2.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_Math" alttext="\displaystyle\tau\geq\frac{\ln(2nT^{2})}{C_{\tau}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>C</mi><mi>τ</mi></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\tau\geq\frac{\ln(2nT^{2})}{C_{\tau}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p6.3" class="ltx_p">where <math id="A2.SS5.SSS0.Px2.p6.m7" class="ltx_Math" alttext="C_{\tau}=(\frac{1}{100n}-\frac{1}{n})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>τ</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mrow><mn>100</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">C_{\tau}=(\frac{1}{100n}-\frac{1}{n})^{2}</annotation></semantics></math>.
If <math id="A2.SS5.SSS0.Px2.p6.m8" class="ltx_Math" alttext="t\leq\tau" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">t\leq\tau</annotation></semantics></math>, we bound <math id="A2.SS5.SSS0.Px2.p6.m9" class="ltx_Math" alttext="\delta(t)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta(t)\leq 1</annotation></semantics></math>. For <math id="A2.SS5.SSS0.Px2.p6.m10" class="ltx_Math" alttext="t&gt;\tau" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">t&gt;\tau</annotation></semantics></math>, we use the bound <math id="A2.SS5.SSS0.Px2.p6.m11" class="ltx_Math" alttext="\delta(t)\leq\frac{1}{T^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\delta(t)\leq\frac{1}{T^{2}}</annotation></semantics></math>.
Now, summing over all <math id="A2.SS5.SSS0.Px2.p6.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,</p>
<table id="A2.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\delta(t)~\leq~\tau+(T-\tau)\,\frac{1}{T^{2}}~=~\frac{\ln\bigl(2nT^{2}\bigr)}{C_{\tau}}~+~\frac{T-\tau}{T^{2}}~\leq~\mathcal{O}\Bigl(\frac{\ln T}{C_{\tau}}+\frac{1}{T}\Bigr)~=~\mathcal{O}(\log T)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mi>τ</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mstyle></mrow></mrow><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mn>2</mn></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msub><mi>C</mi><mi>τ</mi></msub></mfrac></mstyle><mo lspace="0.552em" rspace="0.552em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo>−</mo><mi>τ</mi></mrow><msup><mi>T</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><msub><mi>C</mi><mi>τ</mi></msub></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.330em">)</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\delta(t)~\leq~\tau+(T-\tau)\,\frac{1}{T^{2}}~=~\frac{\ln\bigl(2nT^{2}\bigr)}{C_{\tau}}~+~\frac{T-\tau}{T^{2}}~\leq~\mathcal{O}\Bigl(\frac{\ln T}{C_{\tau}}+\frac{1}{T}\Bigr)~=~\mathcal{O}(\log T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p6.4" class="ltx_p">Then,</p>
<table id="A2.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex88.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\tilde{\mathrm{Reg}}(T)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>Reg</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tilde{\mathrm{Reg}}(T)]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex88.m2" class="ltx_Math" alttext="\displaystyle~\geq~C\cdot\mathbb{E}[\mathrm{Reg}(T)]-\mathcal{O}(\log T)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≥</mo><mrow><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\geq~C\cdot\mathbb{E}[\mathrm{Reg}(T)]-\mathcal{O}(\log T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p6.5" class="ltx_p">The regret <math id="A2.SS5.SSS0.Px2.p6.m13" class="ltx_Math" alttext="\mathbb{E}[\mathrm{Reg}(T)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\mathrm{Reg}(T)]</annotation></semantics></math> for a single-follower game where the follower has <math id="A2.SS5.SSS0.Px2.p6.m14" class="ltx_Math" alttext="nK" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">nK</annotation></semantics></math> types and the leader has <math id="A2.SS5.SSS0.Px2.p6.m15" class="ltx_Math" alttext="L=nK" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">L=nK</annotation></semantics></math> actions is at least <math id="A2.SS5.SSS0.Px2.p6.m16" class="ltx_Math" alttext="\Omega(\sqrt{nKT})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{nKT})</annotation></semantics></math> by Theorem <a href="#A2.Thmtheorem2" title="Theorem B.2. ‣ B.4 Ω(√min{{𝐿,𝐾}⁢𝑇}) Lower Bound in the Single-Follower Case ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>.
Thus, we obtain</p>
<table id="A2.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\tilde{\mathrm{Reg}}(T)]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>Reg</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tilde{\mathrm{Reg}}(T)]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m2" class="ltx_Math" alttext="\displaystyle~\geq~C\cdot\Omega(\sqrt{nKT})-\mathcal{O}(\log T)~=~\Omega(\sqrt{nKT})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≥</mo><mrow><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle~\geq~C\cdot\Omega(\sqrt{nKT})-\mathcal{O}(\log T)~=~\Omega(\sqrt{nKT}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS0.Px2.p6.6" class="ltx_p">which is also <math id="A2.SS5.SSS0.Px2.p6.m17" class="ltx_Math" alttext="\Omega(\sqrt{\min\{L,nK\}T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>min</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>L</mi><mo>,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\min\{L,nK\}T})</annotation></semantics></math> because <math id="A2.SS5.SSS0.Px2.p6.m18" class="ltx_Math" alttext="L=nK" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">L=nK</annotation></semantics></math>.</p>
</div>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Appendix for Section <a href="#S5" title="5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span><math id="A3.SS1.m1" class="ltx_Math" alttext="\mathcal{O}(K^{n}\sqrt{T}\log T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(K^{n}\sqrt{T}\log T)</annotation></semantics></math>-Regret Algorithm and the Proof of Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1. ‣ Linear-bandit based approach with 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇) regret: ‣ 5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a></h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">We show that the online learning problem for a Bayesian Stackelberg game with action feedback can be solved with <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{O}(K^{n}\sqrt{T}\log T)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(K^{n}\sqrt{T}\log T)</annotation></semantics></math> regret, by using a technique developed by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>.</p>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite> showed that the online learning problem for a linear program with unknown objective parameter can be reduced to a linear bandit problem.
We first show that the Bayesian Stackelberg game (which is not a linear program as defined in Definition <a href="#S2.Thmdefinition2" title="Definition 2.2 (Leader’s Optimal Strategy). ‣ Multi-Follower Bayesian Stackelberg Game: ‣ 2 Model ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>) can be reformulated as a linear program. Then, we use <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>’s reduction to reduce the linear program formulation of online Bayesian Stackelberg game to a linear bandit problem. A difference between our work and <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite> is that, while they consider an adversarial online learning setting, we consider a stochastic online learning setting. Directly applying <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>’s result will lead to an <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="\widetilde{\mathcal{O}}(K^{\frac{3n}{2}}\sqrt{T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{O}}(K^{\frac{3n}{2}}\sqrt{T})</annotation></semantics></math> regret bound. Instead, we apply the OFUL algorithm for stochastic linear bandit <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib1" title="" class="ltx_ref">Abbasi-yadkori et al., 2011</a>]</cite> to obtain a better regret bound of <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\widetilde{\mathcal{O}}(K^{n}\sqrt{T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathcal{O}}(K^{n}\sqrt{T})</annotation></semantics></math>.</p>
</div>
<section id="A3.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Step 1: Reformulate Bayesian Stackelberg game as a linear program.</h4>

<div id="A3.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p1.1" class="ltx_p">First, we reformulate the Bayesian Stackelberg game optimization problem <math id="A3.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\max_{x\in\Delta(\mathcal{L})}U_{\bm{\mathcal{D}}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{x\in\Delta(\mathcal{L})}U_{\bm{\mathcal{D}}}(x)</annotation></semantics></math> (Definition <a href="#S2.Thmdefinition2" title="Definition 2.2 (Leader’s Optimal Strategy). ‣ Multi-Follower Bayesian Stackelberg Game: ‣ 2 Model ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>), which is a nonlinear program by definition, into a linear program.
Let variable <math id="A3.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> represent a joint distribution over best-response function <math id="A3.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="W\in\mathcal{A}^{nK}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W\in\mathcal{A}^{nK}</annotation></semantics></math> and the leader’s actions <math id="A3.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>. Specifically,</p>
<table id="A3.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex90.m1" class="ltx_Math" alttext="\displaystyle x=(x(W,\ell))_{W\in\mathcal{A}^{nK},\ell\in\mathcal{L}}\in\mathbb{R}^{A^{nK}\times L}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>W</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>A</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle x=(x(W,\ell))_{W\in\mathcal{A}^{nK},\ell\in\mathcal{L}}\in\mathbb{R}^{A^{nK}\times L},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex90.m2" class="ltx_Math" alttext="\displaystyle\text{where}\sum_{W\in\mathcal{A}^{nK},\ell\in L}x(W,\ell)=1,~\text{ and }~x(W,\ell)\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mtext>where</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>W</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow><mo>,</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi>L</mi></mrow></mrow></munder></mstyle><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="0.497em">,</mo><mrow><mrow><mtext> and </mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{where}\sum_{W\in\mathcal{A}^{nK},\ell\in L}x(W,\ell)=1,~\text{ and }~x(W,\ell)\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p1.2" class="ltx_p">Alternatively, <math id="A3.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> can be viewed as an <math id="A3.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="A^{nK}\times L" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">A^{nK}\times L</annotation></semantics></math>-dimensional matrix, where <math id="A3.SS1.SSS0.Px1.p1.m7" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> indexes the row and <math id="A3.SS1.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> indexes the columns.
We maximize the following objective (which is linear in <math id="A3.SS1.SSS0.Px1.p1.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>):</p>
<table id="A3.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E16.m1" class="ltx_Math" alttext="\displaystyle\max_{x}~U(x)=\sum_{W\in\mathcal{A}^{nK}}\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}\bm{\mathcal{D}}(\bm{\theta})x(W,\ell)u(\ell,W(\bm{\theta}))," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>max</mi><mi>x</mi></munder><mo lspace="0.497em">⁡</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mi>n</mi></msup></mrow></munder></mstyle><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>W</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\max_{x}~U(x)=\sum_{W\in\mathcal{A}^{nK}}\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}\bm{\mathcal{D}}(\bm{\theta})x(W,\ell)u(\ell,W(\bm{\theta})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p1.3" class="ltx_p">subject to the Incentive Compatibility (IC) constraint, meaning that the followers’ best-response actions are consistent with <math id="A3.SS1.SSS0.Px1.p1.m10" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>: <math id="A3.SS1.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\forall W\in\mathcal{A}^{nK},\forall i\in[n],\forall\theta_{i}\in\Theta,\forall a_{i}\in\mathcal{A}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>W</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>θ</mi><mi>i</mi></msub></mrow><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></mrow><annotation encoding="application/x-tex">\forall W\in\mathcal{A}^{nK},\forall i\in[n],\forall\theta_{i}\in\Theta,\forall a_{i}\in\mathcal{A}</annotation></semantics></math>,</p>
<table id="A3.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E17.m1" class="ltx_Math" alttext="\displaystyle\sum_{\ell\in\mathcal{L}}x(W,\ell)\Big(v_{i}(\ell,w_{i}(\theta_{i}),\theta_{i})-v_{i}(\ell,a_{i},\theta_{i})\Big)\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\ell\in\mathcal{L}}x(W,\ell)\Big(v_{i}(\ell,w_{i}(\theta_{i}),\theta_{i})-v_{i}(\ell,a_{i},\theta_{i})\Big)\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
<div id="A3.Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlemma1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmlemma1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlemma1.p1" class="ltx_para">
<p id="A3.Thmlemma1.p1.1" class="ltx_p"><span id="A3.Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">With known distribution <math id="A3.Thmlemma1.p1.m1" class="ltx_Math" alttext="\bm{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝓓</mi><annotation encoding="application/x-tex">\bm{\mathcal{D}}</annotation></semantics></math>, the Bayesian Stackelberg game can be solved by the linear program (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) in the following sense: there exists a solution <math id="A3.Thmlemma1.p1.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> to (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) with only one non-zero row <math id="A3.Thmlemma1.p1.m3" class="ltx_Math" alttext="x(W^{*},\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x(W^{*},\cdot)</annotation></semantics></math>, and this row <math id="A3.Thmlemma1.p1.m4" class="ltx_Math" alttext="x(W^{*},\cdot)\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">x(W^{*},\cdot)\in\mathbb{R}^{L}</annotation></semantics></math> is a solution to <math id="A3.Thmlemma1.p1.m5" class="ltx_Math" alttext="\max_{x\in\Delta(\mathcal{L})}U_{\bm{\mathcal{D}}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{x\in\Delta(\mathcal{L})}U_{\bm{\mathcal{D}}}(x)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.SSS0.Px1.p2" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p2.1" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p2.1.1" class="ltx_text">First, we prove that the linear program (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) contains an optimal solution with only one non-zero row.
Suppose an optimal solution <math id="A3.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> has two non-zero rows <math id="A3.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">W_{1}</annotation></semantics></math>, <math id="A3.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">W_{2}</annotation></semantics></math>:</span></p>
<table id="A3.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex91.m1" class="ltx_Math" alttext="\sum_{\ell\in L}x(W_{1},\ell)=p_{1}&gt;0,\quad\sum_{\ell\in L}x(W_{2},\ell)=p_{2}&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi>L</mi></mrow></munder><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msub><mi>p</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><mo rspace="1.000em">,</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi>L</mi></mrow></munder><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msub><mi>p</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{\ell\in L}x(W_{1},\ell)=p_{1}&gt;0,\quad\sum_{\ell\in L}x(W_{2},\ell)=p_{2}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p2.2" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p2.2.1" class="ltx_text">Consider the conditional expected utility of these two rows. Because, when conditioned on row <math id="A3.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the conditional probability of playing action <math id="A3.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is <math id="A3.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\frac{x(W,\ell)}{p_{1}}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi>p</mi><mn>1</mn></msub></mfrac><annotation encoding="application/x-tex">\frac{x(W,\ell)}{p_{1}}</annotation></semantics></math>, we have:</span></p>
<table id="A3.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex92.m1" class="ltx_Math" alttext="\displaystyle u_{1}=\frac{1}{p_{1}}\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}x(W_{1},\ell)\bm{\mathcal{D}}(\bm{\theta})u(\ell,W_{1}(\bm{\theta}))," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>p</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mi>n</mi></msup></mrow></munder></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle u_{1}=\frac{1}{p_{1}}\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}x(W_{1},\ell)\bm{\mathcal{D}}(\bm{\theta})u(\ell,W_{1}(\bm{\theta})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex93.m1" class="ltx_Math" alttext="\displaystyle u_{2}=\frac{1}{p_{2}}\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}x(W_{2},\ell)\bm{\mathcal{D}}(\bm{\theta})u(\ell,W_{1}(\bm{\theta}))." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>p</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mi>n</mi></msup></mrow></munder></mstyle><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle u_{2}=\frac{1}{p_{2}}\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}x(W_{2},\ell)\bm{\mathcal{D}}(\bm{\theta})u(\ell,W_{1}(\bm{\theta})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px1.p3" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p3.1" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p3.1.1" class="ltx_text">Without loss of generality, assume <math id="A3.SS1.SSS0.Px1.p3.m1" class="ltx_Math" alttext="u_{1}\geq u_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">u_{1}\geq u_{2}</annotation></semantics></math>. We construct a new solution <math id="A3.SS1.SSS0.Px1.p3.m2" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> by transferring probability mass from row <math id="A3.SS1.SSS0.Px1.p3.m3" class="ltx_Math" alttext="W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">W_{2}</annotation></semantics></math> to row <math id="A3.SS1.SSS0.Px1.p3.m4" class="ltx_Math" alttext="W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">W_{1}</annotation></semantics></math>. Specifically, <math id="A3.SS1.SSS0.Px1.p3.m5" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> is defined as follows:</span></p>
<table id="A3.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex94.m1" class="ltx_Math" alttext="\displaystyle x^{\prime}(W_{1},\ell)=\frac{p_{1}+p_{2}}{p_{1}}x(W_{1},\ell)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>+</mo><msub><mi>p</mi><mn>2</mn></msub></mrow><msub><mi>p</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle x^{\prime}(W_{1},\ell)=\frac{p_{1}+p_{2}}{p_{1}}x(W_{1},\ell),</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex94.m2" class="ltx_Math" alttext="\displaystyle\forall\ell\in\mathcal{L}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall\ell\in\mathcal{L}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex95.m1" class="ltx_Math" alttext="\displaystyle x^{\prime}(W_{2},\ell)=0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle x^{\prime}(W_{2},\ell)=0,</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex95.m2" class="ltx_Math" alttext="\displaystyle\forall\ell\in\mathcal{L}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall\ell\in\mathcal{L},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex96.m1" class="ltx_Math" alttext="\displaystyle x^{\prime}(W_{j},\ell)=x(W_{j},\ell)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>j</mi></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>j</mi></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle x^{\prime}(W_{j},\ell)=x(W_{j},\ell),</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex96.m2" class="ltx_Math" alttext="\displaystyle\forall\text{ other $W_{j}$},~\forall\ell\in\mathcal{L}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mrow><mtext> other </mtext><msub><mi>W</mi><mi>j</mi></msub></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mo rspace="0.167em">∀</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\forall\text{ other $W_{j}$},~\forall\ell\in\mathcal{L}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p3.2" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p3.2.1" class="ltx_text">It is straightforward to verify that <math id="A3.SS1.SSS0.Px1.p3.m6" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> satisfies the IC constraint.
Now, we show that the utility of <math id="A3.SS1.SSS0.Px1.p3.m7" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> is weakly greater than the utility of <math id="A3.SS1.SSS0.Px1.p3.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</span></p>
<table id="A3.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex97.m1" class="ltx_Math" alttext="\displaystyle U(x^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle U(x^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex97.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}\frac{p_{1}+p_{2}}{p_{1}}x(W_{1},\ell)\bm{\mathcal{D}}(\bm{\theta})u(\ell,W_{1}(\bm{\theta}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mi>n</mi></msup></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>+</mo><msub><mi>p</mi><mn>2</mn></msub></mrow><msub><mi>p</mi><mn>1</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\ell\in\mathcal{L}}\sum_{\bm{\theta}\in\Theta^{n}}\frac{p_{1}+p_{2}}{p_{1}}x(W_{1},\ell)\bm{\mathcal{D}}(\bm{\theta})u(\ell,W_{1}(\bm{\theta}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex98.m1" class="ltx_Math" alttext="\displaystyle\quad+\text{utility from rows other than }\{W_{1},W_{2}\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mtext>utility from rows other than </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\text{utility from rows other than }\{W_{1},W_{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex99.m1" class="ltx_Math" alttext="\displaystyle=(p_{1}+p_{2})u_{1}+\text{utility from rows other than }\{W_{1},W_{2}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>+</mo><msub><mi>p</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mtext>utility from rows other than </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(p_{1}+p_{2})u_{1}+\text{utility from rows other than }\{W_{1},W_{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex100.m1" class="ltx_Math" alttext="\displaystyle\geq p_{1}u_{1}+p_{2}u_{2}+\text{utility from rows other than }\{W_{1},W_{2}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>p</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mtext>utility from rows other than </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>W</mi><mn>1</mn></msub><mo>,</mo><msub><mi>W</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq p_{1}u_{1}+p_{2}u_{2}+\text{utility from rows other than }\{W_{1},W_{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex101.m1" class="ltx_Math" alttext="\displaystyle=U(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=U(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px1.p3.3" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p3.3.1" class="ltx_text">Note that the <math id="A3.SS1.SSS0.Px1.p3.m9" class="ltx_Math" alttext="W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">W_{2}</annotation></semantics></math> row of <math id="A3.SS1.SSS0.Px1.p3.m10" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> has become <math id="A3.SS1.SSS0.Px1.p3.m11" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. We can apply this construction iteratively until only one row remains non-zero, without decreasing utility, thus obtaining an optimal solution with only one non-zero row.</span></p>
</div>
<div id="A3.SS1.SSS0.Px1.p4" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p4.1" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p4.1.1" class="ltx_text">Let <math id="A3.SS1.SSS0.Px1.p4.m1" class="ltx_Math" alttext="x^{*}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">x^{*}</annotation></semantics></math> be an optimal solution to the linear program (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) with only one non-zero row <math id="A3.SS1.SSS0.Px1.p4.m2" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>. Let <math id="A3.SS1.SSS0.Px1.p4.m3" class="ltx_Math" alttext="x^{*}_{BS}=\max_{x\in\Delta(\mathcal{L})}U_{\bm{\mathcal{D}}}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo>=</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{*}_{BS}=\max_{x\in\Delta(\mathcal{L})}U_{\bm{\mathcal{D}}}(x)</annotation></semantics></math> be an optimal solution for the Bayesian Stackelberg game.
We prove that <math id="A3.SS1.SSS0.Px1.p4.m4" class="ltx_Math" alttext="U(x^{*})=U_{\bm{\mathcal{D}}}(x^{*}_{BS})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U(x^{*})=U_{\bm{\mathcal{D}}}(x^{*}_{BS})</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.SSS0.Px1.p5" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p5.1" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p5.1.1" class="ltx_text">First, we prove <math id="A3.SS1.SSS0.Px1.p5.m1" class="ltx_Math" alttext="U_{\bm{\mathcal{D}}}(x^{*}_{BS})\leq U(x^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{\bm{\mathcal{D}}}(x^{*}_{BS})\leq U(x^{*})</annotation></semantics></math>.
Let <math id="A3.SS1.SSS0.Px1.p5.m2" class="ltx_Math" alttext="W^{*}_{BS}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">W^{*}_{BS}</annotation></semantics></math> be the best-response function corresponding to <math id="A3.SS1.SSS0.Px1.p5.m3" class="ltx_Math" alttext="x^{*}_{BS}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">x^{*}_{BS}</annotation></semantics></math>, i.e., <math id="A3.SS1.SSS0.Px1.p5.m4" class="ltx_Math" alttext="x_{BS}^{*}\in R(W^{*}_{BS})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo>∈</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{BS}^{*}\in R(W^{*}_{BS})</annotation></semantics></math>. We construct a feasible solution <math id="A3.SS1.SSS0.Px1.p5.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> to the linear program (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) by setting the row indexed by <math id="A3.SS1.SSS0.Px1.p5.m6" class="ltx_Math" alttext="W^{*}_{BS}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">W^{*}_{BS}</annotation></semantics></math> to <math id="A3.SS1.SSS0.Px1.p5.m7" class="ltx_Math" alttext="x^{*}_{BS}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">x^{*}_{BS}</annotation></semantics></math> and assigning zero values to all other rows. By definition, <math id="A3.SS1.SSS0.Px1.p5.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> satisfies the IC constraint, so it is a feasible solution. Moreover, <math id="A3.SS1.SSS0.Px1.p5.m9" class="ltx_Math" alttext="x^{*}_{BS}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">x^{*}_{BS}</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px1.p5.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> achieve the same objective value <math id="A3.SS1.SSS0.Px1.p5.m11" class="ltx_Math" alttext="U_{\bm{\mathcal{D}}}(x^{*}_{BS})=U(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{\bm{\mathcal{D}}}(x^{*}_{BS})=U(x)</annotation></semantics></math>. By definition, <math id="A3.SS1.SSS0.Px1.p5.m12" class="ltx_Math" alttext="U(x)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(x)</annotation></semantics></math> is weakly less than the optimal objective value <math id="A3.SS1.SSS0.Px1.p5.m13" class="ltx_Math" alttext="U(x^{*})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(x^{*})</annotation></semantics></math> of the linear program, so <math id="A3.SS1.SSS0.Px1.p5.m14" class="ltx_Math" alttext="U_{\bm{\mathcal{D}}}(x^{*}_{BS})\leq U(x^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U_{\bm{\mathcal{D}}}(x^{*}_{BS})\leq U(x^{*})</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.SSS0.Px1.p6" class="ltx_para">
<p id="A3.SS1.SSS0.Px1.p6.1" class="ltx_p"><span id="A3.SS1.SSS0.Px1.p6.1.1" class="ltx_text">Then, we prove <math id="A3.SS1.SSS0.Px1.p6.m1" class="ltx_Math" alttext="U(x^{*})\leq U_{\bm{\mathcal{D}}}(x^{*}_{BS})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U(x^{*})\leq U_{\bm{\mathcal{D}}}(x^{*}_{BS})</annotation></semantics></math>.
Suppose the leader uses the strategy defined by the non-zero row of <math id="A3.SS1.SSS0.Px1.p6.m2" class="ltx_Math" alttext="x^{*}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">x^{*}</annotation></semantics></math>, which is <math id="A3.SS1.SSS0.Px1.p6.m3" class="ltx_Math" alttext="x^{*}(W^{*},\cdot)\in\Delta(\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>x</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{*}(W^{*},\cdot)\in\Delta(\mathcal{L})</annotation></semantics></math>. By the IC constraint of the linear program, the best-response function of the followers is equal to <math id="A3.SS1.SSS0.Px1.p6.m4" class="ltx_Math" alttext="W^{*}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">W^{*}</annotation></semantics></math>, so the expected utility of the leader is exactly equal to <math id="A3.SS1.SSS0.Px1.p6.m5" class="ltx_Math" alttext="U(x^{*})" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(x^{*})</annotation></semantics></math>, which is <math id="A3.SS1.SSS0.Px1.p6.m6" class="ltx_Math" alttext="\leq U_{\bm{\mathcal{D}}}(x^{*}_{BS})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>U</mi><mi class="ltx_font_mathcaligraphic">𝓓</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\leq U_{\bm{\mathcal{D}}}(x^{*}_{BS})</annotation></semantics></math> because <math id="A3.SS1.SSS0.Px1.p6.m7" class="ltx_Math" alttext="x^{*}_{BS}" display="inline" intent=":literal"><semantics><msubsup><mi>x</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">x^{*}_{BS}</annotation></semantics></math> is an optimal solution for the Bayesian Stackelberg game.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Step 2: Reduce online Bayesian Stackelberg game to a linear bandit problem.</h4>

<div id="A3.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p1.1" class="ltx_p">Based on the linear program formulation (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), we then reduce the online Bayesian Stackelberg game problem to a linear bandit problem, using the technique in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>.
Let <math id="A3.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\mathcal{X}\subseteq\Delta(\mathcal{A}^{nK}\times\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>⊆</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{X}\subseteq\Delta(\mathcal{A}^{nK}\times\mathcal{L})</annotation></semantics></math> be the set of feasible solutions to the linear program (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>).
We define the loss of a strategy <math id="A3.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math> when the follower types are <math id="A3.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\bm{\theta}\in[K]^{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\bm{\theta}\in[K]^{n}</annotation></semantics></math> as:</p>
<table id="A3.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex102.m1" class="ltx_math_unparsed" alttext="\displaystyle L_{\bm{\theta}}(x)=-\sum_{W\in\mathcal{A}^{nK}}\sum_{\ell\in\mathcal{L}}x(W,\ell)u(\ell,W(\bm{\theta}))." display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow></munder></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow><mi>u</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>W</mi><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle L_{\bm{\theta}}(x)=-\sum_{W\in\mathcal{A}^{nK}}\sum_{\ell\in\mathcal{L}}x(W,\ell)u(\ell,W(\bm{\theta})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS0.Px2.p2" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p2.1" class="ltx_p">We define a linear map <math id="A3.SS1.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\phi:\mathcal{X}\to\mathbb{R}^{K^{n}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\phi:\mathcal{X}\to\mathbb{R}^{K^{n}}</annotation></semantics></math> that maps a strategy <math id="A3.SS1.SSS0.Px2.p2.m2" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math> to a vector in <math id="A3.SS1.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\mathbb{R}^{K^{n}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup><annotation encoding="application/x-tex">\mathbb{R}^{K^{n}}</annotation></semantics></math>, representing the loss of the strategy for each type profile:</p>
<table id="A3.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex103.m1" class="ltx_Math" alttext="\displaystyle\phi(x)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\phi(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex103.m2" class="ltx_Math" alttext="\displaystyle=\begin{pmatrix}L_{\bm{\theta}_{1}}(x)\\
\vdots\\
L_{\bm{\theta}_{K^{n}}}(x)\end{pmatrix}\in\mathbb{R}^{K^{n}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>(</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi>L</mi><msub><mi>𝜽</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><msub><mi>L</mi><msub><mi>𝜽</mi><msup><mi>K</mi><mi>n</mi></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{pmatrix}L_{\bm{\theta}_{1}}(x)\\
\vdots\\
L_{\bm{\theta}_{K^{n}}}(x)\end{pmatrix}\in\mathbb{R}^{K^{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p2.2" class="ltx_p">Its inverse, <math id="A3.SS1.SSS0.Px2.p2.m4" class="ltx_Math" alttext="\phi^{\dagger}:\mathbb{R}^{K^{n}}\to\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mo>†</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></mrow><annotation encoding="application/x-tex">\phi^{\dagger}:\mathbb{R}^{K^{n}}\to\mathcal{X}</annotation></semantics></math> maps a loss vector back to a strategy. Let <math id="A3.SS1.SSS0.Px2.p2.m5" class="ltx_Math" alttext="\mathrm{co}\,\phi(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{co}\,\phi(\mathcal{X})</annotation></semantics></math> denote the convex hull of the image set of <math id="A3.SS1.SSS0.Px2.p2.m6" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.SSS0.Px2.p3" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p3.1" class="ltx_p">Let <math id="A3.SS1.SSS0.Px2.p3.m1" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> be a stochastic linear bandit algorithm with decision space <math id="A3.SS1.SSS0.Px2.p3.m2" class="ltx_Math" alttext="\mathrm{co}\,\phi(\mathcal{X})\subseteq\mathbb{R}^{K^{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup></mrow><annotation encoding="application/x-tex">\mathrm{co}\,\phi(\mathcal{X})\subseteq\mathbb{R}^{K^{n}}</annotation></semantics></math>.
In particular, we let <math id="A3.SS1.SSS0.Px2.p3.m3" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> be the OFUL algorithm <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib1" title="" class="ltx_ref">Abbasi-yadkori et al., 2011</a>]</cite>.
At each round, <math id="A3.SS1.SSS0.Px2.p3.m4" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> outputs a strategy <math id="A3.SS1.SSS0.Px2.p3.m5" class="ltx_Math" alttext="z^{t}\in\mathrm{co}\,\phi(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mi>t</mi></msup><mo>∈</mo><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z^{t}\in\mathrm{co}\,\phi(\mathcal{X})</annotation></semantics></math>, and we invoke a Carathédory oracle to decompose <math id="A3.SS1.SSS0.Px2.p3.m6" class="ltx_Math" alttext="z^{t}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mi>t</mi></msup><annotation encoding="application/x-tex">z^{t}</annotation></semantics></math> into <math id="A3.SS1.SSS0.Px2.p3.m7" class="ltx_Math" alttext="K^{n}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K^{n}+1</annotation></semantics></math> elements from <math id="A3.SS1.SSS0.Px2.p3.m8" class="ltx_Math" alttext="\phi(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\mathcal{X})</annotation></semantics></math>, forming a convex combination.<span id="footnote5" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">5</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">5</sup>
                <span class="ltx_tag ltx_tag_note">5</span>
                
                
                
              The Carathédory oracle is based on the well-known <span id="footnote5.2" class="ltx_text ltx_font_italic">Carathédory Theorem</span>.</span></span></span> We then sample one of the elements <math id="A3.SS1.SSS0.Px2.p3.m9" class="ltx_Math" alttext="z_{j}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>z</mi><mi>j</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">z_{j}^{t}</annotation></semantics></math>, and apply the inverse map <math id="A3.SS1.SSS0.Px2.p3.m10" class="ltx_Math" alttext="\phi^{\dagger}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mo>†</mo></msup><annotation encoding="application/x-tex">\phi^{\dagger}</annotation></semantics></math> to obtain a strategy <math id="A3.SS1.SSS0.Px2.p3.m11" class="ltx_Math" alttext="x^{t}\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>t</mi></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x^{t}\in\mathcal{X}</annotation></semantics></math> for the leader.
After playing strategy <math id="A3.SS1.SSS0.Px2.p3.m12" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math>, we observe the utility <math id="A3.SS1.SSS0.Px2.p3.m13" class="ltx_Math" alttext="u^{t}=u(\ell^{t},\bm{a}^{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mi>t</mi></msup><mo>=</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">ℓ</mi><mi>t</mi></msup><mo>,</mo><msup><mi>𝒂</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u^{t}=u(\ell^{t},\bm{a}^{t})</annotation></semantics></math> and feed the utility feedback to <math id="A3.SS1.SSS0.Px2.p3.m14" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math>.</p>
</div>
<figure id="algorithm5" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm5.3" class="ltx_text ltx_font_bold">ALGORITHM 5</span> </span>Linear Bandit Algorithm for Bayesian Stackelberg Games</figcaption>
<div id="algorithm5.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm5.4.1" class="ltx_listingline">
<span id="algorithm5.4.1.1" class="ltx_text ltx_font_bold">Input :</span> A linear bandit algorithm <math id="algorithm5.m1" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> over decision space <math id="algorithm5.m2" class="ltx_Math" alttext="\mathrm{co}\,\phi(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{co}\,\phi(\mathcal{X})</annotation></semantics></math>, where <math id="algorithm5.m3" class="ltx_Math" alttext="\mathfrak{R}.\text{RECOMMEND()}" display="inline" intent=":literal"><semantics><mrow><mi>ℜ</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext>RECOMMEND()</mtext></mrow><annotation encoding="application/x-tex">\mathfrak{R}.\text{RECOMMEND()}</annotation></semantics></math> returns an element in <math id="algorithm5.m4" class="ltx_Math" alttext="\mathrm{co}\,\phi(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{co}\,\phi(\mathcal{X})</annotation></semantics></math>, and <math id="algorithm5.m5" class="ltx_Math" alttext="\mathfrak{R}.\text{OBSERVELOSS}" display="inline" intent=":literal"><semantics><mrow><mi>ℜ</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext>OBSERVELOSS</mtext></mrow><annotation encoding="application/x-tex">\mathfrak{R}.\text{OBSERVELOSS}</annotation></semantics></math> takes the loss feedback. 
</div>
<div id="algorithm5.4.2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.2.1" class="ltx_text ltx_font_bold">1</span></span>
              <span id="algorithm5.4.2.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm5.4.2.3" class="ltx_emph ltx_font_italic">each round <math id="algorithm5.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math></em> <span id="algorithm5.4.2.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm5.4.3" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.3.1" class="ltx_text ltx_font_bold">2</span></span>
              Use <math id="algorithm5.m7" class="ltx_Math" alttext="\mathfrak{R}.\text{RECOMMEND()}" display="inline" intent=":literal"><semantics><mrow><mi>ℜ</mi><mo lspace="0em" rspace="0.167em">.</mo><mtext>RECOMMEND()</mtext></mrow><annotation encoding="application/x-tex">\mathfrak{R}.\text{RECOMMEND()}</annotation></semantics></math> to obtain <math id="algorithm5.m8" class="ltx_Math" alttext="z^{t}\in\mathrm{co}~\phi(\mathcal{X})\subseteq\mathbb{R}^{K^{n}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>z</mi><mi>t</mi></msup><mo>∈</mo><mrow><mi>co</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup></mrow><annotation encoding="application/x-tex">z^{t}\in\mathrm{co}~\phi(\mathcal{X})\subseteq\mathbb{R}^{K^{n}}</annotation></semantics></math>.
</div>
<div id="algorithm5.4.4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.4.1" class="ltx_text ltx_font_bold">3</span></span>
               <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.4.2" class="ltx_text ltx_font_bold">4</span></span>
              Call a Carathéodory oracle with input <math id="algorithm5.m9" class="ltx_Math" alttext="(z^{t},\phi(\mathcal{X}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>z</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(z^{t},\phi(\mathcal{X}))</annotation></semantics></math>, which returns <math id="algorithm5.m10" class="ltx_Math" alttext="K^{n}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">K^{n}+1</annotation></semantics></math> elements <math id="algorithm5.m11" class="ltx_Math" alttext="\{z^{t}_{i},\lambda^{t}_{i}\}_{i\in[K^{n}+1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>z</mi><mi>i</mi><mi>t</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{z^{t}_{i},\lambda^{t}_{i}\}_{i\in[K^{n}+1]}</annotation></semantics></math> such that:

<table id="A3.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex104.m1" class="ltx_Math" alttext="z^{t}=\sum_{i=1}^{K^{n}+1}\lambda^{t}_{i}z^{t}_{i},\quad\text{where }\sum_{i=1}^{K^{n}+1}\lambda^{t}_{i}=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>z</mi><mi>t</mi></msup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msup><mi>K</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow></munderover><mrow><msubsup><mi>λ</mi><mi>i</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>i</mi><mi>t</mi></msubsup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><msup><mi>K</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow></munderover><msubsup><mi>λ</mi><mi>i</mi><mi>t</mi></msubsup></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z^{t}=\sum_{i=1}^{K^{n}+1}\lambda^{t}_{i}z^{t}_{i},\quad\text{where }\sum_{i=1}^{K^{n}+1}\lambda^{t}_{i}=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="algorithm5.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.5.1" class="ltx_text ltx_font_bold">5</span></span>
              Draw an index <math id="algorithm5.m12" class="ltx_Math" alttext="j\in\{1,\ldots,K^{n}+1\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\ldots,K^{n}+1\}</annotation></semantics></math> with probabilities <math id="algorithm5.m13" class="ltx_Math" alttext="\lambda^{t}_{j}" display="inline" intent=":literal"><semantics><msubsup><mi>λ</mi><mi>j</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">\lambda^{t}_{j}</annotation></semantics></math>.
</div>
<div id="algorithm5.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.6.1" class="ltx_text ltx_font_bold">6</span></span>
              Compute <math id="algorithm5.m14" class="ltx_Math" alttext="x^{t}\leftarrow\phi^{\dagger}(z^{t}_{j})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi>ϕ</mi><mo>†</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>j</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{t}\leftarrow\phi^{\dagger}(z^{t}_{j})</annotation></semantics></math>. Note that <math id="algorithm5.m15" class="ltx_Math" alttext="x^{t}\in\mathcal{X}=\Delta(\mathcal{A}^{nK}\times\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>t</mi></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{t}\in\mathcal{X}=\Delta(\mathcal{A}^{nK}\times\mathcal{L})</annotation></semantics></math> is a matrix.
</div>
<div id="algorithm5.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.7.1" class="ltx_text ltx_font_bold">7</span></span>
              Play <math id="algorithm5.m16" class="ltx_Math" alttext="x^{t}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mi>t</mi></msup><annotation encoding="application/x-tex">x^{t}</annotation></semantics></math> in the following sense: sample a row <math id="algorithm5.m17" class="ltx_Math" alttext="W\in\mathcal{A}^{nK}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W\in\mathcal{A}^{nK}</annotation></semantics></math> with probability <math id="algorithm5.m18" class="ltx_Math" alttext="p(W)=\sum_{\ell\in\mathcal{L}}x^{t}(W,\ell)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p(W)=\sum_{\ell\in\mathcal{L}}x^{t}(W,\ell)</annotation></semantics></math>, then play the mixed strategy <math id="algorithm5.m19" class="ltx_Math" alttext="x^{t}(W,\cdot)/p(W)\in\Delta(\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{t}(W,\cdot)/p(W)\in\Delta(\mathcal{L})</annotation></semantics></math>.
</div>
<div id="algorithm5.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.8.1" class="ltx_text ltx_font_bold">8</span></span>
              Observe the realized utility <math id="algorithm5.m20" class="ltx_Math" alttext="u^{t}=u(\ell^{t},\bm{a}^{t})" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mi>t</mi></msup><mo>=</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">ℓ</mi><mi>t</mi></msup><mo>,</mo><msup><mi>𝒂</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u^{t}=u(\ell^{t},\bm{a}^{t})</annotation></semantics></math>.
</div>
<div id="algorithm5.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.9.1" class="ltx_text ltx_font_bold">9</span></span>
              Feed the loss to <math id="algorithm5.m21" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> by calling <math id="algorithm5.m22" class="ltx_Math" alttext="\mathfrak{R}.\text{OBSERVELOSS}(-u^{t})" display="inline" intent=":literal"><semantics><mrow><mi>ℜ</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>OBSERVELOSS</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msup><mi>u</mi><mi>t</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{R}.\text{OBSERVELOSS}(-u^{t})</annotation></semantics></math>.
</div>
<div id="algorithm5.4.10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm5.4.10.1" class="ltx_text ltx_font_bold">10</span></span>
              We let <math id="algorithm5.m23" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> be the OFUL algorithm <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib1" title="" class="ltx_ref">Abbasi-yadkori et al., 2011</a>]</cite>.

</div>
</div>
</figure>
<div id="A3.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem C.1</span></span><span id="A3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmtheorem1.p1" class="ltx_para">
<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The expected regret of Algorithm <a href="#algorithm5" title="In Step 2: Reduce online Bayesian Stackelberg game to a linear bandit problem. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> is <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="O(K^{n}\sqrt{T}\log T)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(K^{n}\sqrt{T}\log T)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.SSS0.Px2.p4" class="ltx_para">
<p id="A3.SS1.SSS0.Px2.p4.1" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.1.1" class="ltx_text">Because <math id="A3.SS1.SSS0.Px2.p4.m1" class="ltx_Math" alttext="x^{t}\in\mathcal{X}=\Delta(\mathcal{A}^{nK}\times\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mi>t</mi></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{t}\in\mathcal{X}=\Delta(\mathcal{A}^{nK}\times\mathcal{L})</annotation></semantics></math> is a feasible solutions to the linear program (<a href="#A3.E16" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)(<a href="#A3.E17" title="In Step 1: Reformulate Bayesian Stackelberg game as a linear program. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), it satisfies the IC constraint. So, when the leader plays <math id="A3.SS1.SSS0.Px2.p4.m2" class="ltx_Math" alttext="x^{t}(W,\cdot)/p(W)\in\Delta(\mathcal{L})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x^{t}(W,\cdot)/p(W)\in\Delta(\mathcal{L})</annotation></semantics></math>, the followers (with types <math id="A3.SS1.SSS0.Px2.p4.m3" class="ltx_Math" alttext="\bm{\theta}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">\bm{\theta}</annotation></semantics></math>) will best respond according to the function <math id="A3.SS1.SSS0.Px2.p4.m4" class="ltx_Math" alttext="W(\bm{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">W(\bm{\theta})</annotation></semantics></math>. Thus, the leader’s expected utility at round <math id="A3.SS1.SSS0.Px2.p4.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is</span></p>
<table id="A3.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex105.m1" class="ltx_Math" alttext="\displaystyle\sum_{W\in A^{nK}}p(W)\sum_{\ell\in\mathcal{L}}\frac{x^{t}(W,\ell)}{p(W)}\sum_{\bm{\theta}\in[K]^{n}}\bm{\mathcal{D}}(\bm{\theta})u(\ell,W(\bm{\theta}))=U(x^{t})=-\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}[L_{\bm{\theta}}(x^{t})]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><msup><mi>A</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msup></mrow></munder></mstyle><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>x</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝜽</mi><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow><mi>n</mi></msup></mrow></munder></mstyle><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>W</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝜽</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>L</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{W\in A^{nK}}p(W)\sum_{\ell\in\mathcal{L}}\frac{x^{t}(W,\ell)}{p(W)}\sum_{\bm{\theta}\in[K]^{n}}\bm{\mathcal{D}}(\bm{\theta})u(\ell,W(\bm{\theta}))=U(x^{t})=-\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}[L_{\bm{\theta}}(x^{t})].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.2" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.2.1" class="ltx_text">Then, the regret of Algorithm <a href="#algorithm5" title="In Step 2: Reduce online Bayesian Stackelberg game to a linear bandit problem. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> in <math id="A3.SS1.SSS0.Px2.p4.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> rounds can be expressed as</span></p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex106.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Reg}(T)~=~\sum_{t=1}^{T}\Big(\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}[L_{\bm{\theta}}(x^{t})]-\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}[L_{\bm{\theta}}(x^{*})]\Big)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>𝜽</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>L</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>𝜽</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>L</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Reg}(T)~=~\sum_{t=1}^{T}\Big(\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}[L_{\bm{\theta}}(x^{t})]-\mathbb{E}_{\bm{\theta}\sim\bm{\mathcal{D}}}[L_{\bm{\theta}}(x^{*})]\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.3" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.3.1" class="ltx_text">where <math id="A3.SS1.SSS0.Px2.p4.m7" class="ltx_Math" alttext="x^{*}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">x^{*}</annotation></semantics></math> is the optimal strategy in <math id="A3.SS1.SSS0.Px2.p4.m8" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math>, which minimizes the expected loss (maximizes expected utility).
Let <math id="A3.SS1.SSS0.Px2.p4.m9" class="ltx_Math" alttext="\mathrm{Reg}_{\mathfrak{R},\mathrm{co}\,\phi(\mathcal{X})}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Reg</mi><mrow><mi>ℜ</mi><mo>,</mo><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Reg}_{\mathfrak{R},\mathrm{co}\,\phi(\mathcal{X})}(T)</annotation></semantics></math> be the expected regret of the linear bandit algorithm <math id="A3.SS1.SSS0.Px2.p4.m10" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> on decision space <math id="A3.SS1.SSS0.Px2.p4.m11" class="ltx_Math" alttext="\mathrm{co}\,\phi(\mathcal{X})" display="inline" intent=":literal"><semantics><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{co}\,\phi(\mathcal{X})</annotation></semantics></math> in <math id="A3.SS1.SSS0.Px2.p4.m12" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> rounds.
According to the Theorem 3.1 of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>,</span></p>
<table id="A3.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex107.m1" class="ltx_Math" alttext="\mathrm{Reg}(T)\leq\mathrm{Reg}_{\mathfrak{R},\mathrm{co}\,\phi(\mathcal{X})}(T)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>Reg</mi><mrow><mi>ℜ</mi><mo>,</mo><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Reg}(T)\leq\mathrm{Reg}_{\mathfrak{R},\mathrm{co}\,\phi(\mathcal{X})}(T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.4" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.4.1" class="ltx_text">We let <math id="A3.SS1.SSS0.Px2.p4.m13" class="ltx_Math" alttext="\mathfrak{R}" display="inline" intent=":literal"><semantics><mi>ℜ</mi><annotation encoding="application/x-tex">\mathfrak{R}</annotation></semantics></math> be the OFUL algorithm <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib1" title="" class="ltx_ref">Abbasi-yadkori et al., 2011</a>]</cite>.
For any <math id="A3.SS1.SSS0.Px2.p4.m14" class="ltx_Math" alttext="z\in\mathrm{co}\,\phi(\mathcal{X})\subseteq\mathbb{R}^{K^{n}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><msup><mi>ℝ</mi><msup><mi>K</mi><mi>n</mi></msup></msup></mrow><annotation encoding="application/x-tex">z\in\mathrm{co}\,\phi(\mathcal{X})\subseteq\mathbb{R}^{K^{n}}</annotation></semantics></math>, the stochastic loss of <math id="A3.SS1.SSS0.Px2.p4.m15" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> can be expressed as <math id="A3.SS1.SSS0.Px2.p4.m16" class="ltx_Math" alttext="L^{t}=\langle z,\bm{\mathcal{D}}\rangle+\eta^{t}" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mi>t</mi></msup><mo>=</mo><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mi>z</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>+</mo><msup><mi>η</mi><mi>t</mi></msup></mrow></mrow><annotation encoding="application/x-tex">L^{t}=\langle z,\bm{\mathcal{D}}\rangle+\eta^{t}</annotation></semantics></math>, with <math id="A3.SS1.SSS0.Px2.p4.m17" class="ltx_Math" alttext="|L^{t}|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msup><mi>L</mi><mi>t</mi></msup><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|L^{t}|\leq 1</annotation></semantics></math>, <math id="A3.SS1.SSS0.Px2.p4.m18" class="ltx_Math" alttext="\|\bm{\mathcal{D}}\|_{2}\leq\|\bm{\mathcal{D}}\|_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mi class="ltx_font_mathcaligraphic">𝓓</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\bm{\mathcal{D}}\|_{2}\leq\|\bm{\mathcal{D}}\|_{1}=1</annotation></semantics></math>, and <math id="A3.SS1.SSS0.Px2.p4.m19" class="ltx_Math" alttext="\eta^{t}" display="inline" intent=":literal"><semantics><msup><mi>η</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\eta^{t}</annotation></semantics></math> being a bounded zero-mean noise.
Then, from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib1" title="" class="ltx_ref">Abbasi-yadkori et al. [2011]</a></cite>’s Theorem 3, we have with probability at least <math id="A3.SS1.SSS0.Px2.p4.m20" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex108.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Reg}_{\mathfrak{R},\mathrm{co}\,\phi(\mathcal{X})}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Reg</mi><mrow><mi>ℜ</mi><mo>,</mo><mrow><mi>co</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Reg}_{\mathfrak{R},\mathrm{co}\,\phi(\mathcal{X})}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex108.m2" class="ltx_Math" alttext="\displaystyle\leq 4\sqrt{TK^{n}\log\left(\lambda+\frac{TL}{K^{n}}\right)}\cdot\left(\lambda^{1/2}+\sqrt{2\log\left(\frac{1}{\delta}\right)+K^{n}\log\left(1+\frac{TL}{\lambda K^{n}}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>λ</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><msup><mi>K</mi><mi>n</mi></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></msqrt></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><msup><mi>λ</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>+</mo><msqrt><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>n</mi></msup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow></msqrt></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 4\sqrt{TK^{n}\log\left(\lambda+\frac{TL}{K^{n}}\right)}\cdot\left(\lambda^{1/2}+\sqrt{2\log\left(\frac{1}{\delta}\right)+K^{n}\log\left(1+\frac{TL}{\lambda K^{n}}\right)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.5" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.5.1" class="ltx_text">where <math id="A3.SS1.SSS0.Px2.p4.m21" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> is a tunable parameter in the OFUL algorithm. By setting <math id="A3.SS1.SSS0.Px2.p4.m22" class="ltx_Math" alttext="\lambda=1" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lambda=1</annotation></semantics></math> and <math id="A3.SS1.SSS0.Px2.p4.m23" class="ltx_Math" alttext="\delta=\frac{1}{T}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mfrac><mn>1</mn><mi>T</mi></mfrac></mrow><annotation encoding="application/x-tex">\delta=\frac{1}{T}</annotation></semantics></math>, we obtain</span></p>
<table id="A3.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex109.m1" class="ltx_Math" alttext="\mathbb{E}[\mathrm{Reg}(T)]~\leq~(1-\delta)\cdot O(K^{n}\sqrt{T}\log T)+\delta\cdot T~=~\mathcal{O}(K^{n}\sqrt{T}\log T)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow></mrow><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>K</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\mathrm{Reg}(T)]~\leq~(1-\delta)\cdot O(K^{n}\sqrt{T}\log T)+\delta\cdot T~=~\mathcal{O}(K^{n}\sqrt{T}\log T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS0.Px2.p4.6" class="ltx_p"><span id="A3.SS1.SSS0.Px2.p4.6.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Proof of Lemma  <a href="#S5.Thmlemma1" title="Lemma 5.1. ‣ Algorithm with 𝑂(√𝑛^𝐿⁢𝐾^𝐿⁢𝐴^{2⁢𝐿}⁢𝐿⁢𝑇⁢log𝑇) regret. ‣ 5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> </h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">We can express the leader’s utility function as</p>
<table id="A3.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex110.m1" class="ltx_Math" alttext="u(x,\bm{a})=\sum_{\ell\in\mathcal{L}}x(\ell)u(\ell,\bm{a})=\langle x,u_{\bm{a}}\rangle" display="block" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>x</mi><mo>,</mo><msub><mi>u</mi><mi>𝒂</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,\bm{a})=\sum_{\ell\in\mathcal{L}}x(\ell)u(\ell,\bm{a})=\langle x,u_{\bm{a}}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.2" class="ltx_p">where vector <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="u_{\bm{a}}=(u(\ell,\bm{a}))_{\ell\in\mathcal{L}}\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>𝒂</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">u_{\bm{a}}=(u(\ell,\bm{a}))_{\ell\in\mathcal{L}}\in\mathbb{R}^{L}</annotation></semantics></math>. Note that <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="u(x,\bm{a})" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>𝒂</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,\bm{a})</annotation></semantics></math> is a linear function of <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="u_{\bm{a}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>𝒂</mi></msub><annotation encoding="application/x-tex">u_{\bm{a}}</annotation></semantics></math>.
Consequently, the expected utility of a strategy <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="x\in R(W)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in R(W)</annotation></semantics></math> on the true distribution <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="\bm{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝓓</mi><annotation encoding="application/x-tex">\bm{\mathcal{D}}</annotation></semantics></math> is given by</p>
<table id="A3.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex111.m1" class="ltx_math_unparsed" alttext="U(x,R(W))=\mathbb{E}_{\bm{a}\sim\mathcal{P}(\cdot|R(W))}[\langle x,u_{\bm{a}}\rangle]." display="block" intent=":literal"><semantics><mrow><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>𝒂</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>R</mi><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">⟨</mo><mi>x</mi><mo>,</mo><msub><mi>u</mi><mi>𝒂</mi></msub><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U(x,R(W))=\mathbb{E}_{\bm{a}\sim\mathcal{P}(\cdot|R(W))}[\langle x,u_{\bm{a}}\rangle].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.3" class="ltx_p">Given samples <math id="A3.SS2.p1.m6" class="ltx_Math" alttext="\bm{a}^{1},...,\bm{a}^{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒂</mi><mn>1</mn></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝒂</mi><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">\bm{a}^{1},...,\bm{a}^{N}</annotation></semantics></math>, we can compute <math id="A3.SS2.p1.m7" class="ltx_Math" alttext="u_{\bm{a}^{1}},...,u_{\bm{a}^{N}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><msup><mi>𝒂</mi><mn>1</mn></msup></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>u</mi><msup><mi>𝒂</mi><mi>N</mi></msup></msub></mrow><annotation encoding="application/x-tex">u_{\bm{a}^{1}},...,u_{\bm{a}^{N}}</annotation></semantics></math> because we know the utility function. By Lemma <a href="#A2.Thmlemma1" title="Lemma B.1 (e.g., Theorem 10.4 in [ ] ). ‣ B.1 Proof of Lemma ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, the pseudo-dimension of the family of linear functions <math id="A3.SS2.p1.m8" class="ltx_Math" alttext="\{\langle x,\cdot\rangle~|~x\in R(W)\in\mathbb{R}^{L}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo></mrow><mo rspace="0.052em" stretchy="false">⟩</mo></mrow><mo rspace="0.330em">|</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\langle x,\cdot\rangle~|~x\in R(W)\in\mathbb{R}^{L}\}</annotation></semantics></math> is <math id="A3.SS2.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Applying Theorem <a href="#A2.Thmtheorem1" title="Theorem B.1 (e.g., Theorem 10.6 in [ ] ). ‣ B.1 Proof of Lemma ‣ Appendix B Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, with <math id="A3.SS2.p1.m10" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> samples, we have</p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex112.m1" class="ltx_math_unparsed" alttext="\displaystyle\Pr\left[\exists x\in R(W),~\big|U(x,R(W))-\hat{U}_{N}(x,R(W))\big|&gt;\sqrt{\frac{2L\log 3N}{N}}+\sqrt{\frac{\log\frac{1}{\delta}}{2N}}~\right]\leq\delta." display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo>[</mo><mo rspace="0.167em">∃</mo><mi>x</mi><mo>∈</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.497em">,</mo><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mo lspace="0.167em">&gt;</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><mi>N</mi></mfrac></mstyle></msqrt><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.330em">]</mo></mrow><mo>≤</mo><mi>δ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\left[\exists x\in R(W),~\big|U(x,R(W))-\hat{U}_{N}(x,R(W))\big|&gt;\sqrt{\frac{2L\log 3N}{N}}+\sqrt{\frac{\log\frac{1}{\delta}}{2N}}~\right]\leq\delta.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.4" class="ltx_p">Let <math id="A3.SS2.p1.m11" class="ltx_Math" alttext="\delta=\frac{1}{T^{4}}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mfrac><mn>1</mn><msup><mi>T</mi><mn>4</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">\delta=\frac{1}{T^{4}}</annotation></semantics></math>. Taking a union bound over all <math id="A3.SS2.p1.m12" class="ltx_Math" alttext="N\in\{1,...,T\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N\in\{1,...,T\}</annotation></semantics></math> and all <math id="A3.SS2.p1.m13" class="ltx_Math" alttext="W\in\mathcal{W}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">W\in\mathcal{W}</annotation></semantics></math>, we obtain</p>
<table id="A3.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle\Pr\bigg[\exists W\in\mathcal{W},\exists N\in[T],\exists x\in R(W),~\big|U(x,R(W))-\hat{U}_{N}(x,R(W))\big|&gt;\sqrt{\frac{2L\log(3N)}{N}}+\sqrt{\frac{\log T^{4}}{2N}}~\bigg]" display="inline" intent=":literal"><semantics><mrow><mi>Pr</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo rspace="0.167em">∃</mo><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>,</mo><mo rspace="0.167em">∃</mo><mi>N</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mo rspace="0.167em">∃</mo><mi>x</mi><mo>∈</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.497em">,</mo><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mo lspace="0.167em">&gt;</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>N</mi></mfrac></mstyle></msqrt><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>T</mi><mn>4</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0.330em" maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Pr\bigg[\exists W\in\mathcal{W},\exists N\in[T],\exists x\in R(W),~\big|U(x,R(W))-\hat{U}_{N}(x,R(W))\big|&gt;\sqrt{\frac{2L\log(3N)}{N}}+\sqrt{\frac{\log T^{4}}{2N}}~\bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex114.m1" class="ltx_Math" alttext="\displaystyle\quad\leq|\mathcal{W}|T\delta=\frac{|\mathcal{W}|T}{T^{4}}\leq\frac{1}{T^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msup><mi>T</mi><mn>4</mn></msup></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq|\mathcal{W}|T\delta=\frac{|\mathcal{W}|T}{T^{4}}\leq\frac{1}{T^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.5" class="ltx_p">(assuming <math id="A3.SS2.p1.m14" class="ltx_Math" alttext="T\geq|\mathcal{W}|" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">T\geq|\mathcal{W}|</annotation></semantics></math>).
Thus, with probability at least <math id="A3.SS2.p1.m15" class="ltx_Math" alttext="1-\frac{1}{T^{2}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{1}{T^{2}}</annotation></semantics></math>, for every <math id="A3.SS2.p1.m16" class="ltx_Math" alttext="W\in\mathcal{W}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow><annotation encoding="application/x-tex">W\in\mathcal{W}</annotation></semantics></math>, <math id="A3.SS2.p1.m17" class="ltx_Math" alttext="N\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">N\in[T]</annotation></semantics></math>, and <math id="A3.SS2.p1.m18" class="ltx_Math" alttext="x\in R(W)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in R(W)</annotation></semantics></math>, we have</p>
<table id="A3.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex115.m1" class="ltx_Math" alttext="\big|\,U(x,R(W))-\hat{U}_{N}(x,R(W))\,\big|~\leq~\sqrt{\frac{4(L+1)\log(3T)}{t}}" display="block" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em" stretchy="true">|</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.330em" stretchy="true">|</mo></mrow><mo rspace="0.608em">≤</mo><msqrt><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac></msqrt></mrow><annotation encoding="application/x-tex">\big|\,U(x,R(W))-\hat{U}_{N}(x,R(W))\,\big|~\leq~\sqrt{\frac{4(L+1)\log(3T)}{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.6" class="ltx_p">using the inequality <math id="A3.SS2.p1.m19" class="ltx_Math" alttext="\sqrt{a}+\sqrt{b}\leq\sqrt{2(a+b)}" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo>+</mo><msqrt><mi>b</mi></msqrt></mrow><mo>≤</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sqrt{a}+\sqrt{b}\leq\sqrt{2(a+b)}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Proof of Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2. ‣ Algorithm with 𝑂(√𝑛^𝐿⁢𝐾^𝐿⁢𝐴^{2⁢𝐿}⁢𝐿⁢𝑇⁢log𝑇) regret. ‣ 5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> </h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">By Lemma <a href="#S5.Thmlemma1" title="Lemma 5.1. ‣ Algorithm with 𝑂(√𝑛^𝐿⁢𝐾^𝐿⁢𝐴^{2⁢𝐿}⁢𝐿⁢𝑇⁢log𝑇) regret. ‣ 5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, the event</p>
<table id="A3.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex116.m1" class="ltx_math_unparsed" alttext="C=\left[\forall W\in\mathcal{W},\forall N\in[T],\forall x\in R(W),\ \left|U(x,R(W))-\hat{U}_{N}(x,R(W))\right|\leq\sqrt{\frac{4(L+1)\log(3T)}{N}}~\right]" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo>[</mo><mo rspace="0.167em">∀</mo><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>,</mo><mo rspace="0.167em">∀</mo><mi>N</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mo rspace="0.167em">∀</mo><mi>x</mi><mo>∈</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mo fence="false" rspace="0.167em">|</mo><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo fence="false">|</mo><mo lspace="0.167em">≤</mo><msqrt><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>N</mi></mfrac></msqrt><mo lspace="0.330em">]</mo></mrow></mrow><annotation encoding="application/x-tex">C=\left[\forall W\in\mathcal{W},\forall N\in[T],\forall x\in R(W),\ \left|U(x,R(W))-\hat{U}_{N}(x,R(W))\right|\leq\sqrt{\frac{4(L+1)\log(3T)}{N}}~\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.2" class="ltx_p">happens with probability at least <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="1-\frac{1}{T^{2}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mrow><annotation encoding="application/x-tex">1-\frac{1}{T^{2}}</annotation></semantics></math>.
Suppose <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> happens. The regret at round <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is given by</p>
<table id="A3.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex117.m1" class="ltx_Math" alttext="r(t)=U(x^{*},R(W^{*}))-U(x^{t},R(W^{t}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r(t)=U(x^{*},R(W^{*}))-U(x^{t},R(W^{t})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.3" class="ltx_p">For any strategy <math id="A3.SS3.p1.m4" class="ltx_Math" alttext="x\in R(W)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in R(W)</annotation></semantics></math>, we define the upper confidence bound of its utility as</p>
<table id="A3.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex118.m1" class="ltx_Math" alttext="\mathrm{UCB}^{t}(x)=\hat{U}_{N^{t}(W)}(x,R(W))+\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W)}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>UCB</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><msup><mi>N</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msqrt><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>N</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{UCB}^{t}(x)=\hat{U}_{N^{t}(W)}(x,R(W))+\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.4" class="ltx_p">Since <math id="A3.SS3.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> holds, it follows that</p>
<table id="A3.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex119.m1" class="ltx_Math" alttext="U(x^{*},R(W^{*}))\leq\mathrm{UCB}^{t}(x^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>UCB</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U(x^{*},R(W^{*}))\leq\mathrm{UCB}^{t}(x^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.5" class="ltx_p">Because the UCB algorithm chooses the strategy with the highest upper confidence bound at round <math id="A3.SS3.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, we have <math id="A3.SS3.p1.m7" class="ltx_Math" alttext="\mathrm{UCB}^{t}(x^{*})\leq\mathrm{UCB}^{t}(x^{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>UCB</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>UCB</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{UCB}^{t}(x^{*})\leq\mathrm{UCB}^{t}(x^{t})</annotation></semantics></math>.
Thus,</p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex120.m1" class="ltx_Math" alttext="\displaystyle r(t)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle r(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex120.m2" class="ltx_Math" alttext="\displaystyle\leq\mathrm{UCB}^{t}(x^{*})-U(x^{t},R(W^{t}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mi>UCB</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathrm{UCB}^{t}(x^{*})-U(x^{t},R(W^{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex121.m1" class="ltx_Math" alttext="\displaystyle\leq\mathrm{UCB}^{t}(x^{t})-U(x^{t},R(W^{t}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mi>UCB</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathrm{UCB}^{t}(x^{t})-U(x^{t},R(W^{t}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_Math" alttext="\displaystyle=\hat{U}_{N^{t}(W)}(x^{t},R(W^{t}))-U(x^{t},R(W^{t}))+\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W^{t})}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>U</mi><mo>^</mo></mover><mrow><msup><mi>N</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mi>t</mi></msup><mo>,</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>N</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{U}_{N^{t}(W)}(x^{t},R(W^{t}))-U(x^{t},R(W^{t}))+\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W^{t})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex123.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W^{t})}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>N</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W^{t})}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.6" class="ltx_p">The total regret is at most</p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex124.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Reg}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Reg}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex124.m2" class="ltx_Math" alttext="\displaystyle~=~\sum_{t=1}^{T}r(t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\sum_{t=1}^{T}r(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex125.m1" class="ltx_Math" alttext="\displaystyle~\leq~2\sum_{t=1}^{T}\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W^{t})}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msup><mi>N</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>W</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\leq~2\sum_{t=1}^{T}\sqrt{\frac{4(L+1)\log(3T)}{N^{t}(W^{t})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex126.m1" class="ltx_Math" alttext="\displaystyle~=~2\sum_{W\in\mathcal{W}}\sum_{m=1}^{N^{T}(W)}\sqrt{\frac{4(L+1)\log(3T)}{m}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><msup><mi>N</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></munderover></mstyle><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>m</mi></mfrac></mstyle></msqrt></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~2\sum_{W\in\mathcal{W}}\sum_{m=1}^{N^{T}(W)}\sqrt{\frac{4(L+1)\log(3T)}{m}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex127.m1" class="ltx_Math" alttext="\displaystyle~\leq~8\sum_{W\in\mathcal{W}}\sqrt{N^{T}(W)\cdot(L+1)\cdot\log(3T)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></munder></mstyle><msqrt><mrow><mrow><msup><mi>N</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\leq~8\sum_{W\in\mathcal{W}}\sqrt{N^{T}(W)\cdot(L+1)\cdot\log(3T)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.7" class="ltx_p">where we applied the inequality <math id="A3.SS3.p1.m8" class="ltx_Math" alttext="\sum_{m=1}^{N}\sqrt{\frac{1}{m}}\leq 2\sqrt{N}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><msqrt><mfrac><mn>1</mn><mi>m</mi></mfrac></msqrt></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>N</mi></msqrt></mrow></mrow><annotation encoding="application/x-tex">\sum_{m=1}^{N}\sqrt{\frac{1}{m}}\leq 2\sqrt{N}</annotation></semantics></math>.
By Jensen’s inequality,</p>
<table id="A3.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex128.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{|\mathcal{W}|}\sum_{W\in\mathcal{W}}\sqrt{N^{T}(W)}\;\leq\;\sqrt{\frac{1}{|\mathcal{W}|}\sum_{W\in\mathcal{W}}N^{T}(W)}\;=\;\sqrt{\frac{1}{|\mathcal{W}|}T}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></munder></mstyle><msqrt><mrow><msup><mi>N</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo lspace="0.558em" rspace="0.558em">≤</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></munder></mstyle><mrow><msup><mi>N</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msqrt><mo lspace="0.558em" rspace="0.558em">=</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{|\mathcal{W}|}\sum_{W\in\mathcal{W}}\sqrt{N^{T}(W)}\;\leq\;\sqrt{\frac{1}{|\mathcal{W}|}\sum_{W\in\mathcal{W}}N^{T}(W)}\;=\;\sqrt{\frac{1}{|\mathcal{W}|}T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.8" class="ltx_p">Thus,</p>
<table id="A3.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex129.m1" class="ltx_Math" alttext="\displaystyle\mathrm{Reg}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{Reg}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex129.m2" class="ltx_Math" alttext="\displaystyle~\leq~8\sum_{W\in\mathcal{W}}\sqrt{|\mathcal{W}|T}\cdot\sqrt{(L+1)\log(3T)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>W</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></mrow></munder></mstyle><msqrt><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~\leq~8\sum_{W\in\mathcal{W}}\sqrt{|\mathcal{W}|T}\cdot\sqrt{(L+1)\log(3T)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex130.m1" class="ltx_Math" alttext="\displaystyle~=~\mathcal{O}\Big(\sqrt{|\mathcal{W}|L\cdot T\log T}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msqrt><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\mathcal{O}\Big(\sqrt{|\mathcal{W}|L\cdot T\log T}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex131.m1" class="ltx_Math" alttext="\displaystyle~=~\mathcal{O}\Big(\sqrt{n^{L}K^{L}A^{2L}L\cdot T\log T}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.608em" rspace="0.608em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msqrt><mrow><mrow><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~=~\mathcal{O}\Big(\sqrt{n^{L}K^{L}A^{2L}L\cdot T\log T}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.9" class="ltx_p">where we used <math id="A3.SS3.p1.m9" class="ltx_Math" alttext="|\mathcal{W}|=O(n^{L}K^{L}A^{2L})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|\mathcal{W}|=O(n^{L}K^{L}A^{2L})</annotation></semantics></math> from Lemma <a href="#S3.Thmlemma2" title="Lemma 3.2. ‣ 3.3 Enumerating Best-Response Regions and Computing the Offline Optimal ‣ 3 Best Response Regions: A Geometric Perspective ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>.</p>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p">Finally, considering the case where <math id="A3.SS3.p2.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> does not happen (which has probability at most <math id="A3.SS3.p2.m2" class="ltx_Math" alttext="\frac{1}{T^{2}}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac><annotation encoding="application/x-tex">\frac{1}{T^{2}}</annotation></semantics></math>),</p>
<table id="A3.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex132.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\big(1-\frac{1}{T^{2}}\big)\mathcal{O}\Big(\sqrt{n^{L}K^{L}A^{2L}L\cdot T\log T}\Big)+\frac{1}{T^{2}}\cdot T~\leq~\mathcal{O}\Big(\sqrt{n^{L}K^{L}A^{2L}L\cdot T\log T}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Reg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.330em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.608em">=</mo><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msqrt><mrow><mrow><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow></mrow><mo lspace="0.608em" rspace="0.608em">≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msqrt><mrow><mrow><mrow><msup><mi>n</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>A</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>T</mi></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow></msqrt><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\mathrm{Reg}(T)]~=~\big(1-\frac{1}{T^{2}}\big)\mathcal{O}\Big(\sqrt{n^{L}K^{L}A^{2L}L\cdot T\log T}\Big)+\frac{1}{T^{2}}\cdot T~\leq~\mathcal{O}\Big(\sqrt{n^{L}K^{L}A^{2L}L\cdot T\log T}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Simulations</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">We empirically simulate and validate the results of the studied algorithms in both the type-feedback setting and action feedback setting. For the former, we consider the independent type setting to understand how much better, in practice, is Algorithm <a href="#algorithm2" title="In Independent Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (customized for independent types) as opposed to the general purpose Algorithm <a href="#algorithm1" title="In General Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> (works for general type distributions). We consider an <math id="A4.p1.m1" class="ltx_Math" alttext="(L=2,K=6,A=2,n=2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>K</mi><mo>=</mo><mn>6</mn></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L=2,K=6,A=2,n=2)</annotation></semantics></math> instance and simulate the results in Figure <a href="#A4.F3" title="Figure 3 ‣ Appendix D Simulations ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. As expected, the specialized algorithm does indeed outperform the general one.</p>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">For the action feedback case, we empirically compare our UCB-based Algorithm <a href="#algorithm3" title="In Algorithm with 𝑂(√𝑛^𝐿⁢𝐾^𝐿⁢𝐴^{2⁢𝐿}⁢𝐿⁢𝑇⁢log𝑇) regret. ‣ 5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> with the linear bandit approach inspired by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>, Algorithm <a href="#algorithm5" title="In Step 2: Reduce online Bayesian Stackelberg game to a linear bandit problem. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>. We especially consider the small <math id="A4.p2.m1" class="ltx_Math" alttext="n,L" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">n,L</annotation></semantics></math> regime where our theory does not provide any concrete guidance. Shown in Figure <a href="#A4.F3" title="Figure 3 ‣ Appendix D Simulations ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we consider an <math id="A4.p2.m2" class="ltx_Math" alttext="(L=2,K=6,A=2,n=2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>K</mi><mo>=</mo><mn>6</mn></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L=2,K=6,A=2,n=2)</annotation></semantics></math> instance and observe the advantage of the UCB-based algorithm over the linear bandit one.</p>
</div>
<figure id="A4.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F3.fig1" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:165.6pt;"><img src="2510.01387v1/figures/type_feedback_sims.png" id="A4.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/162;" width="229" height="162" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Cumulative regret from the type-feedback based Algorithms <a href="#algorithm1" title="In General Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#algorithm2" title="In Independent Type Distributions: ‣ 4.1 Learning Algorithms and Upper Bounds ‣ 4 Type Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> for an <math id="A4.F3.m2" class="ltx_Math" alttext="(L=2,K=6,A=2,n=2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>K</mi><mo>=</mo><mn>6</mn></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L=2,K=6,A=2,n=2)</annotation></semantics></math> instance with independent types. We plot the average over 2000 simulations with 90% confidence intervals.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F3.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:165.6pt;"><img src="2510.01387v1/figures/action_feedback_sims.png" id="A4.F3.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/162;" width="229" height="162" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Cumulative regret from Algorithm <a href="#algorithm5" title="In Step 2: Reduce online Bayesian Stackelberg game to a linear bandit problem. ‣ C.1 𝒪(𝐾^𝑛⁢√𝑇⁢log𝑇)-Regret Algorithm and the Proof of Theorem ‣ Appendix C Appendix for Section ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> (the Linear-Bandit approach inspired by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib7" title="" class="ltx_ref">Bernasconi et al. [2023]</a></cite>) and Algorithm <a href="#algorithm3" title="In Algorithm with 𝑂(√𝑛^𝐿⁢𝐾^𝐿⁢𝐴^{2⁢𝐿}⁢𝐿⁢𝑇⁢log𝑇) regret. ‣ 5 Action Feedback ‣ Learning to Play Multi-Follower Bayesian Stackelberg Games" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> for an <math id="A4.F3.m4" class="ltx_Math" alttext="(L=2,K=6,A=2,n=2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>K</mi><mo>=</mo><mn>6</mn></mrow><mo>,</mo><mrow><mi>A</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(L=2,K=6,A=2,n=2)</annotation></semantics></math> instance. We plot the average over 2000 simulations with 90% confidence intervals.</figcaption>
</figure></div></div>
</figure>
</section>
