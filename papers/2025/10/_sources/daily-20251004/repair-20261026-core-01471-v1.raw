</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
              Obtain <math id="alg1.l14.m1" class="ltx_Math" alttext="w_{t}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>t</mi><mi>j</mi></msubsup><annotation encoding="application/x-tex">w_{t}^{j}</annotation></semantics></math> using <math id="alg1.l14.m2" class="ltx_Math" alttext="\mathcal{L}_{t}^{\text{ELBO}}(\hat{\boldsymbol{\Theta}}_{j})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>t</mi><mtext>ELBO</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{t}^{\text{ELBO}}(\hat{\boldsymbol{\Theta}}_{j})</annotation></semantics></math> according to  (<a href="#S4.E13" title="In 4 Ensembling LoRA-VBLL with recursive updates ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) and (<a href="#S4.E14" title="In 4 Ensembling LoRA-VBLL with recursive updates ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>);

