           <span id="alg1.l21.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l21.4" class="ltx_text ltx_font_bold">for
<br class="ltx_break"></span>
</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
           <span id="alg1.l22.3" class="ltx_text ltx_font_bold">Output:</span> <math id="alg1.l22.m1" class="ltx_Math" alttext="{\bf x}^{*}={\bf x}_{\tau^{*}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐱</mi><mo>∗</mo></msup><mo>=</mo><msub><mi>𝐱</mi><msup><mi>τ</mi><mo>∗</mo></msup></msub></mrow><annotation encoding="application/x-tex">{\bf x}^{*}={\bf x}_{\tau^{*}}</annotation></semantics></math>, where <math id="alg1.l22.m2" class="ltx_Math" alttext="\tau^{*}=\underset{\tau\in\{1,\ldots,n_{0}+T\}}{\arg\max}\ \ y_{\tau}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><mo>∗</mo></msup><mo>=</mo><munder accentunder="true"><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>max</mi></mrow><mrow><mi mathsize="0.700em">τ</mi><mo mathsize="0.700em">∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo mathsize="0.700em">,</mo><mrow><msub><mi mathsize="0.700em">n</mi><mn mathsize="0.710em">0</mn></msub><mo mathsize="0.700em">+</mo><mi mathsize="0.700em">T</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></munder></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><msub><mi>y</mi><mi>τ</mi></msub></mrow><annotation encoding="application/x-tex">\tau^{*}=\underset{\tau\in\{1,\ldots,n_{0}+T\}}{\arg\max}\ \ y_{\tau}</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Training a single LoRA-VBLL via the ELBO objective</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           Data <math id="alg2.l0.m1" class="ltx_Math" alttext="\mathcal{D}_{t}:=\{({\bf x}_{\tau},y_{\tau})\}_{\tau=1}^{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub><mo>:=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>τ</mi></msub><mo>,</mo><msub><mi>y</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{D}_{t}:=\{({\bf x}_{\tau},y_{\tau})\}_{\tau=1}^{t}</annotation></semantics></math>, pre-trained LLM weights <math id="alg2.l0.m2" class="ltx_Math" alttext="{\bf W}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\bf W}_{0}</annotation></semantics></math>, rank <math id="alg2.l0.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, prior variance <math id="alg2.l0.m4" class="ltx_Math" alttext="\sigma_{\beta}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>β</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{\beta}^{2}</annotation></semantics></math>, initial value for <math id="alg2.l0.m5" class="ltx_Math" alttext="\sigma_{\epsilon}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>ϵ</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\sigma_{\epsilon}^{2}</annotation></semantics></math>, learning rate <math id="alg2.l0.m6" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, number of iterations <math id="alg2.l0.m7" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>

<br class="ltx_break">
</div>
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           Initialize LoRA parameters <math id="alg2.l1.m1" class="ltx_Math" alttext="{\bf A}\in\mathbb{R}^{r\times m}" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bf A}\in\mathbb{R}^{r\times m}</annotation></semantics></math>, <math id="alg2.l1.m2" class="ltx_Math" alttext="{\bf B}\in\mathbb{R}^{r\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝐁</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\bf B}\in\mathbb{R}^{r\times n}</annotation></semantics></math> randomly

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           Initialize posterior <math id="alg2.l2.m1" class="ltx_Math" alttext="q_{t}(\boldsymbol{\beta})=\mathcal{N}(\boldsymbol{\beta};\boldsymbol{\mu}_{t},\boldsymbol{\Sigma}_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜷</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝜷</mi><mo>,</mo><msub><mi>𝝁</mi><mi>t</mi></msub><mo>,</mo><msub><mi>𝚺</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{t}(\boldsymbol{\beta})=\mathcal{N}(\boldsymbol{\beta};\boldsymbol{\mu}_{t},\boldsymbol{\Sigma}_{t})</annotation></semantics></math> where <math id="alg2.l2.m2" class="ltx_Math" alttext="\boldsymbol{\mu}_{t}=\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><mi>t</mi></msub><mo>=</mo><mn>𝟎</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{\mu}_{t}=\mathbf{0}</annotation></semantics></math>, <math id="alg2.l2.m3" class="ltx_Math" alttext="\boldsymbol{\Sigma}_{t}=\sigma_{\beta}^{2}{\bf I}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚺</mi><mi>t</mi></msub><mo>=</mo><mrow><msubsup><mi>σ</mi><mi>β</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐈</mi></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\Sigma}_{t}=\sigma_{\beta}^{2}{\bf I}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           <span id="alg2.l3.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l3.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="alg2.l3.m2" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> <span id="alg2.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            Sample mini-batch <math id="alg2.l4.m1" class="ltx_Math" alttext="\mathcal{B}_{i}\subset\mathcal{D}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{B}_{i}\subset\mathcal{D}_{t}</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            Compute feature mapping <math id="alg2.l5.m1" class="ltx_Math" alttext="\boldsymbol{\phi}_{{\bf W}_{0}+{\bf A}^{\top}{\bf B}}({\bf x})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><msub><mi>𝐖</mi><mn>0</mn></msub><mo>+</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\phi}_{{\bf W}_{0}+{\bf A}^{\top}{\bf B}}({\bf x})</annotation></semantics></math> for all <math id="alg2.l5.m2" class="ltx_Math" alttext="{\bf x}\in\mathcal{B}_{j}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">{\bf x}\in\mathcal{B}_{j}</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
            Compute the gradient of the ELBO (<a href="#S3.E4" title="In 3.1 Fine-tuning LLMs via variational Bayes last layer ‣ 3 LLM-enhanced surrogate model for HDBO ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>)
<math id="alg2.l6.m1" class="ltx_Math" alttext="\nabla_{\boldsymbol{\Theta}}\mathcal{L}_{t}^{\text{ELBO}}(\boldsymbol{\Theta})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>𝚯</mi></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>t</mi><mtext>ELBO</mtext></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝚯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\boldsymbol{\Theta}}\mathcal{L}_{t}^{\text{ELBO}}(\boldsymbol{\Theta})</annotation></semantics></math>

</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            Update parameters:
<math id="alg2.l7.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\Theta}}\leftarrow\hat{\boldsymbol{\Theta}}+\eta\cdot\nabla_{\boldsymbol{\Theta}}\mathcal{L}_{t}^{\text{ELBO}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mo stretchy="false">←</mo><mrow><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mo>+</mo><mrow><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝚯</mi></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>t</mi><mtext>ELBO</mtext></msubsup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{\Theta}}\leftarrow\hat{\boldsymbol{\Theta}}+\eta\cdot\nabla_{\boldsymbol{\Theta}}\mathcal{L}_{t}^{\text{ELBO}}</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
           <span id="alg2.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l8.4" class="ltx_text ltx_font_bold">for
<br class="ltx_break"></span>
</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
           <span id="alg2.l9.3" class="ltx_text ltx_font_bold">Output:</span> <math id="alg2.l9.m1" class="ltx_Math" alttext="\hat{\boldsymbol{\Theta}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\boldsymbol{\Theta}}</annotation></semantics></math> and <math id="alg2.l9.m2" class="ltx_Math" alttext="\mathcal{L}_{t}^{\text{ELBO}}(\hat{\boldsymbol{\Theta}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>t</mi><mtext>ELBO</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝚯</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{t}^{\text{ELBO}}(\hat{\boldsymbol{\Theta}})</annotation></semantics></math>

</div>
</div>
</figure>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Additional experimental results</h2>

<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Benchmark HDBO Tasks</h3>

<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">In our experiments, we evaluate our proposed approaches on several benchmark high-dimensional Bayesian optimization (HDBO) tasks with different types of variables:</p>
</div>
<section id="A4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.1.1 </span>Categorical Variable Problems</h4>

<div id="A4.SS1.SSS1.p1" class="ltx_para">
<ul id="A4.I1" class="ltx_itemize">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p"><span id="A4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Branin32</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib55" title="" class="ltx_ref">55</a>]</cite>: A standard test function extended to 32 dimensions with categorical variables. Each dimension is discretized into categorical levels, creating a challenging discrete optimization problem with multiple local minima. The underlying continuous function structure is preserved through discretization:</p>
</div>
<div id="A4.I1.i1.p2" class="ltx_para">
<table id="A4.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E19.m1" class="ltx_Math" alttext="f(x_{1},x_{2})=(x_{2}-0.129x_{1}^{2}+1.6x_{1}-6)^{2}+10(1-0.125/\pi)\cos(x_{1})+10" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><mrow><mn>0.129</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mn>1.6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow><mo>−</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>0.125</mn><mo>/</mo><mi>π</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>10</mn></mrow></mrow><annotation encoding="application/x-tex">f(x_{1},x_{2})=(x_{2}-0.129x_{1}^{2}+1.6x_{1}-6)^{2}+10(1-0.125/\pi)\cos(x_{1})+10</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="A4.I1.i1.p3" class="ltx_para">
<p id="A4.I1.i1.p3.1" class="ltx_p">where the continuous variables are mapped to discrete categorical values across all 32 dimensions.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p"><span id="A4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Ackley60</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib56" title="" class="ltx_ref">56</a>]</cite>: A multimodal test function discretized into 60 categorical dimensions. The discrete version maintains the challenging landscape of numerous local minima while operating over categorical variables. The original continuous formulation:</p>
</div>
<div id="A4.I1.i2.p2" class="ltx_para">
<table id="A4.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E20.m1" class="ltx_Math" alttext="f(x)=-20\exp\left(-0.2\sqrt{\frac{1}{d}\sum_{i=1}^{d}x_{i}^{2}}\right)-\exp\left(\frac{1}{d}\sum_{i=1}^{d}\cos(2\pi x_{i})\right)+20+e" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><mn>20</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mn>0.2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mn>20</mn><mo>+</mo><mi>e</mi></mrow></mrow><annotation encoding="application/x-tex">f(x)=-20\exp\left(-0.2\sqrt{\frac{1}{d}\sum_{i=1}^{d}x_{i}^{2}}\right)-\exp\left(\frac{1}{d}\sum_{i=1}^{d}\cos(2\pi x_{i})\right)+20+e</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="A4.I1.i2.p3" class="ltx_para">
<p id="A4.I1.i2.p3.1" class="ltx_p">is evaluated over discretized categorical inputs, where each dimension takes values from a finite categorical set.</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p"><span id="A4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Pest Control</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">57</a>]</cite>: A real-world problem involving 25 categorical variables, each representing an intervention stage with five possible values. Each configuration in this problem defines a pest control strategy, and the objective is to minimize the cost associated with pest population dynamics. This benchmark represents a challenging categorical optimization task with real-world relevance in ecological management.</p>
</div></li>
<li id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i4.p1" class="ltx_para">
<p id="A4.I1.i4.p1.1" class="ltx_p"><span id="A4.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">MAXSAT60</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>]</cite>: A Boolean satisfiability problem with 60 binary variables. The objective is to find an assignment to these variables that maximizes the number of satisfied clauses in a given Boolean formula. MAXSAT60 represents a purely discrete optimization challenge that is NP-hard in nature, testing our method’s ability to navigate combinatorial search spaces <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite>.</p>
</div></li>
</ul>
</div>
</section>
<section id="A4.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">D.1.2 </span>Mixed and Continuous Variable Problems</h4>

<div id="A4.SS1.SSS2.p1" class="ltx_para">
<ul id="A4.I2" class="ltx_itemize">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p"><span id="A4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Ackley53</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib66" title="" class="ltx_ref">66</a>]</cite>: A modified version of the Ackley function that incorporates mixed variable types. This benchmark includes 53 dimensions with 3 continuous variables and 50 categorical variables. The categorical variables are one-hot encoded, resulting in a challenging mixed-variable optimization problem that tests our method’s ability to handle heterogeneous input spaces.</p>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p"><span id="A4.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Ackley30</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib66" title="" class="ltx_ref">66</a>]</cite>: A modified version of the Ackley function that incorporates continuous variable types. This benchmark includes 30 dimensions with both continuous variables. It is a challenging, continuous optimization problem.</p>
</div></li>
</ul>
</div>
<div id="A4.SS1.SSS2.p2" class="ltx_para">
<p id="A4.SS1.SSS2.p2.1" class="ltx_p">In practice, for computational efficiency under continuous variables, we pre-generate a discrete candidate set using Sobol sequences <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">67</a>, <a href="#bib.bib68" title="" class="ltx_ref">68</a>]</cite>, allowing AF optimization to proceed via simple enumeration rather than expensive gradient-based continuous optimization.</p>
</div>
</section>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Molecular Optimization Tasks</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p">We also evaluate our approach on molecular optimization tasks, which involve complex, high-dimensional search spaces with discrete structures:</p>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<ul id="A4.I3" class="ltx_itemize">
<li id="A4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i1.p1" class="ltx_para">
<p id="A4.I3.i1.p1.1" class="ltx_p"><span id="A4.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">Redoxmer</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib60" title="" class="ltx_ref">60</a>]</cite>: This task focuses on minimizing the redox potential of molecules for possible flow battery electrolytes. The search space consists of molecules represented in SMILES format, with the objective function computed using physics-inspired simulators.</p>
</div></li>
<li id="A4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i2.p1" class="ltx_para">
<p id="A4.I3.i2.p1.1" class="ltx_p"><span id="A4.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">Solvation</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib60" title="" class="ltx_ref">60</a>]</cite>: Similar to Redoxmer, this task aims to minimize the solvation energy of molecules. Solvation energy is a critical property for flow battery electrolytes and influences their stability and performance.</p>
</div></li>
<li id="A4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i3.p1" class="ltx_para">
<p id="A4.I3.i3.p1.1" class="ltx_p"><span id="A4.I3.i3.p1.1.1" class="ltx_text ltx_font_bold">Kinase</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">61</a>]</cite>: This task involves minimizing the docking score of kinase inhibitors for drug discovery applications. The objective function simulates the binding affinity of molecules to target kinase proteins.</p>
</div></li>
<li id="A4.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I3.i4.p1" class="ltx_para">
<p id="A4.I3.i4.p1.1" class="ltx_p"><span id="A4.I3.i4.p1.1.1" class="ltx_text ltx_font_bold">Laser</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite>: This task aims to maximize the fluorescence oscillator strength of molecules for laser applications. The search space consists of potential laser materials represented as molecular structures.</p>
</div></li>
</ul>
</div>
<div id="A4.SS2.p3" class="ltx_para">
<p id="A4.SS2.p3.1" class="ltx_p">Each molecular optimization task represents a real-world challenge where efficient exploration of the chemical space is crucial. These problems deal with high-dimensional, discrete search spaces with complex structural dependencies that standard optimization methods struggle to handle effectively.</p>
</div>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Experiment Setup</h3>

<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p">We compare the performance of the following surrogate models.</p>
</div>
<section id="A4.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">GP:</h5>

<div id="A4.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px1.p1.1" class="ltx_p">As the de-facto standard in BO, we use GPs with a Matérn <math id="A4.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="5/2" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">5/2</annotation></semantics></math> kernel (<math id="A4.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\nu=2.5" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>=</mo><mn>2.5</mn></mrow><annotation encoding="application/x-tex">\nu=2.5</annotation></semantics></math>) and individual lengthscales <math id="A4.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="l_{i}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mi>i</mi></msub><annotation encoding="application/x-tex">l_{i}</annotation></semantics></math> for all input dimensions. These lengthscales are optimized within box constraints <math id="A4.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="l_{i}\in[0.005,4]" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mi>i</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0.005</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">l_{i}\in[0.005,4]</annotation></semantics></math> following recommended best practices <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">67</a>, <a href="#bib.bib69" title="" class="ltx_ref">69</a>]</cite>. For single-objective problems, we use an adaptive scale with a lengthscale prior of <math id="A4.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\mathrm{Gamma}(3,6)" display="inline" intent=":literal"><semantics><mrow><mi>Gamma</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Gamma}(3,6)</annotation></semantics></math> and an output-scale prior of <math id="A4.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\mathrm{Gamma}(2.0,0.15)" display="inline" intent=":literal"><semantics><mrow><mi>Gamma</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2.0</mn><mo>,</mo><mn>0.15</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Gamma}(2.0,0.15)</annotation></semantics></math>, which combine with the marginal likelihood to form a posterior that we optimize for hyperparameter learning.</p>
</div>
</section>
<section id="A4.SS3.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Infinite-width (I-) BNN:</h5>

<div id="A4.SS3.SSS0.Px2.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px2.p1.1" class="ltx_p">Following the setting in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite>, we employ I-BNNs<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib32" title="" class="ltx_ref">32</a>]</cite> with <math id="A4.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> hidden layers and ReLU activation functions. We set the weight variance to <math id="A4.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="10.0" display="inline" intent=":literal"><semantics><mn>10.0</mn><annotation encoding="application/x-tex">10.0</annotation></semantics></math> and the bias variance to <math id="A4.SS3.SSS0.Px2.p1.m3" class="ltx_Math" alttext="1.6" display="inline" intent=":literal"><semantics><mn>1.6</mn><annotation encoding="application/x-tex">1.6</annotation></semantics></math>. Note that the I-BNN is expressed as a kernel; therefore, the model is still non-parametric and does not learn features.</p>
</div>
<div id="A4.SS3.SSS0.Px2.p2" class="ltx_para">
<p id="A4.SS3.SSS0.Px2.p2.1" class="ltx_p">For a fair comparison in our LLM-based Bayesian optimization framework, we have replaced all neural network components in the following methods with LLM<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib70" title="" class="ltx_ref">70</a>]</cite>+LoRA<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite> configurations, while maintaining GP and I-BNN implementations of these two non-parametric methods in their original versions.</p>
</div>
</section>
<section id="A4.SS3.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Deep Kernel Learning (DKL):</h5>

<div id="A4.SS3.SSS0.Px3.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px3.p1.1" class="ltx_p">DKL <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>]</cite> combines feature extraction with neural networks and GPs. In our implementation, we adapt this approach to utilize LLMs as feature extractors. Specifically, we fine-tune LlaMA3.1-8B<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib71" title="" class="ltx_ref">71</a>]</cite> using LoRA on the output layer and the queries and values of all attention layers. This LLM-based feature extractor <math id="A4.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="g_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">g_{\theta}</annotation></semantics></math> is then wrapped in a kernel as <math id="A4.SS3.SSS0.Px3.p1.m2" class="ltx_Math" alttext="k_{\text{DKL}}:=k(g_{\theta}(x),g_{\theta}(x^{\prime}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mtext>DKL</mtext></msub><mo>:=</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k_{\text{DKL}}:=k(g_{\theta}(x),g_{\theta}(x^{\prime}))</annotation></semantics></math>, allowing for non-stationary modeling and exact inference. We set up the base kernel using the same Matérn <math id="A4.SS3.SSS0.Px3.p1.m3" class="ltx_Math" alttext="5/2" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">5/2</annotation></semantics></math> kernel as in our GP implementation. For multi-objective problems, we independently model each objective.</p>
</div>
</section>
<section id="A4.SS3.SSS0.Px4" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Last Layer Laplace Approximation (LLLA):</h5>

<div id="A4.SS3.SSS0.Px4.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px4.p1.1" class="ltx_p">LLLA provides a computationally efficient way to obtain uncertainty estimates after training a neural network <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib49" title="" class="ltx_ref">49</a>, <a href="#bib.bib50" title="" class="ltx_ref">50</a>]</cite>. In our approach, we apply LLLA to fine-tuned LlaMA3.1-8B models with LoRA adaptations. Following Laplace-LoRA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>, <a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite>, we apply the Laplace approximation to the LoRA parameters in the output layer and attention layers to obtain a Gaussian posterior over these parameters.</p>
</div>
</section>
<section id="A4.SS3.SSS0.Px5" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Deep Ensembles (DE):</h5>

<div id="A4.SS3.SSS0.Px5.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px5.p1.1" class="ltx_p">Deep ensembles<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib37" title="" class="ltx_ref">37</a>]</cite> offer a computationally efficient approach to obtaining predictions with uncertainty. Instead of traditional neural networks, we implement an ensemble of <math id="A4.SS3.SSS0.Px5.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> LlaMA3.1-8B models, each fine-tuned with different LoRA parameters. Each model uses the same base LLM architecture but has independently trained LoRA parameters, effectively creating diversity in the ensemble while maintaining computational efficiency. Each model is trained on a random 80% of the function evaluations. We parameterize the predictive as a normal distribution with mean and variance derived from the ensemble.</p>
</div>
</section>
<section id="A4.SS3.SSS0.Px6" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bayesian Low-Rank Adaptation (BLoB):</h5>

<div id="A4.SS3.SSS0.Px6.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px6.p1.1" class="ltx_p">BLoB <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite> provides a principled Bayesian framework for LLM-based surrogate models. We implement BLoB using LlaMA3.1-8B with LoRA applied to both the output layer and the queries and values of all attention layers. Unlike post-training Bayesian methods, BLoB jointly adjusts both the mean and covariance of the LLM parameters throughout the fine-tuning process, leading to better calibrated uncertainty estimates. We maintain the default hyperparameter settings from the original implementation for reproducibility, including the LoRA rank and learning rate.</p>
</div>
</section>
<section id="A4.SS3.SSS0.Px7" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">MLP-VBLL:</h5>

<div id="A4.SS3.SSS0.Px7.p1" class="ltx_para">
<p id="A4.SS3.SSS0.Px7.p1.1" class="ltx_p">To illustrate the power of large models, we choose as baseline VBLL with an MLP with <math id="A4.SS3.SSS0.Px7.p1.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> hidden layers and ReLU activation functions following the original work that adapts VBLL for BO <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib72" title="" class="ltx_ref">72</a>]</cite>.</p>
</div>
</section>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4 </span>Results using different AFs</h3>

<figure id="A4.F6" class="ltx_figure"><img src="2510.01471v1/SFL_EXP_FIGS/Molecular_Exp_Results/Appendix/bayesian_optimization_comparison_20250523_011007.png" id="A4.F6.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:429/396;" width="429" height="396" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>Performance on Molecular Optimization taks using different AFs</figcaption>
</figure>
<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p">To assess the robustness of ENS-LoRA-VBLL across acquisition strategies, we evaluated Thompson Sampling (TS), Upper Confidence Bound (UCB), and LogEI on molecular optimization tasks. As shown in Figure <a href="#A4.F6" title="Figure 6 ‣ D.4 Results using different AFs ‣ Appendix D Additional experimental results ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, the choice of acquisition function significantly impacts baseline methods: LLLA and DE exhibit substantial performance variations across different AFs, with DE showing particularly high variance under UCB. In contrast, ENS-LoRA-VBLL maintains exceptional consistency and superior performance regardless of the acquisition strategy, demonstrating that our LLM-based surrogate model provides robust uncertainty estimates that work effectively across different exploration-exploitation trade-offs. This AF-agnostic robustness eliminates the need for careful acquisition function tuning and reinforces the practical applicability of our approach.</p>
</div>
</section>
<section id="A4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.5 </span>HDBO over continuous and mixed variables</h3>

<figure id="A4.F7" class="ltx_figure"><img src="2510.01471v1/SFL_EXP_FIGS/Molecular_Exp_Results/Appendix/ackley_comparison_20250523_011557.png" id="A4.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:429/195;" width="429" height="195" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7: </span>HDBO over Mixed and Continuous spaces</figcaption>
</figure>
<div id="A4.SS5.p1" class="ltx_para">
<p id="A4.SS5.p1.1" class="ltx_p">To evaluate our method’s versatility across different variable types, we conducted experiments on both mixed-variable and continuous optimization problems. According to the fig<a href="#A4.F7" title="Figure 7 ‣ D.5 HDBO over continuous and mixed variables ‣ Appendix D Additional experimental results ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, for the continuous Ackley30 benchmark, ENS-LoRA-VBLL shows competitive performance, closely matching BLoB while significantly outperforming LLLA and MLP-VBLL. The continuous space results reveal distinct convergence patterns: LLLA shows initial promise but plateaus early, while BLoB exhibits more consistent performance in continuous spaces compared to mixed-variable settings.</p>
</div>
<div id="A4.SS5.p2" class="ltx_para">
<p id="A4.SS5.p2.1" class="ltx_p">Our method maintains robust performance across both variable types, with particularly strong advantages in mixed-variable scenarios where the discrete-continuous interface poses additional modeling challenges. These results confirm ENS-LoRA-VBLL’s effectiveness in handling heterogeneous optimization spaces and demonstrate the practical value of LLM-based feature extraction for diverse optimization problems.</p>
</div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Implementation Details</h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">Our implementation is built using PyTorch<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
            <span class="ltx_tag ltx_tag_note">1</span>
            
            
            
          https://pytorch.org/</span></span></span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib73" title="" class="ltx_ref">73</a>]</cite> with the Transformers library<span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
            <span class="ltx_tag ltx_tag_note">2</span>
            
            
            
          https://huggingface.co/docs/transformers/en/index</span></span></span><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib74" title="" class="ltx_ref">74</a>]</cite> for LLM backbone integration. We utilize the PEFT library <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib44" title="" class="ltx_ref">44</a>]</cite> for parameter-efficient fine-tuning with LoRA configurations. The posterior <math id="A5.p1.m1" class="ltx_Math" alttext="q_{t}(\boldsymbol{\beta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜷</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{t}(\boldsymbol{\beta})</annotation></semantics></math> in VBLL is implemented with custom multivariate normal distributions supporting multiple parameterizations, including dense, diagonal, low-rank, and dense precision formulations.</p>
</div>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p">For efficient uncertainty quantification, we implement custom Cholesky update operations using rank-1 updates for recursive Bayesian inference. The dense precision parameterization utilizes specialized matrix operations including Cholesky decomposition, matrix inversion via <span id="A5.p2.1.1" class="ltx_text ltx_font_typewriter">torch.cholesky_solve</span>, and symmetric matrix operations. Our recursive update mechanism leverages batched tensor operations to maintain computational efficiency during the optimization loop.</p>
</div>
<div id="A5.p3" class="ltx_para">
<p id="A5.p3.1" class="ltx_p">The proposed ENS-LoRA-VBLL combines a fine-tuned LLM through LoRA with different ranks from <math id="A5.p3.m1" class="ltx_Math" alttext="\{8,16,32,64\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>8</mn><mo>,</mo><mn>16</mn><mo>,</mo><mn>32</mn><mo>,</mo><mn>64</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{8,16,32,64\}</annotation></semantics></math> through adaptive weighting based on marginal likelihood estimation. Feature caching is implemented for the molecular optimization tasks to avoid redundant forward passes through the LLM backbone between fine-tuning steps, significantly reducing computational overhead.</p>
</div>
<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Training Procedure</h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p">Our training procedure consists of two distinct phases designed to ensure stable convergence and optimal performance. In the first phase, we perform MSE-based initialization where only the mean parameters (<math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\mathbf{W}_{\text{mean}}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mtext>mean</mtext></msub><annotation encoding="application/x-tex">\mathbf{W}_{\text{mean}}</annotation></semantics></math>) and noise variance are optimized using standard mean squared error loss for 500 epochs. This provides a stable initialization point for the subsequent variational training phase.</p>
</div>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p">In the second phase, we conduct full ELBO-based training with all VBLL parameters using AdamW optimizer <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib75" title="" class="ltx_ref">75</a>]</cite> with learning rate <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="1\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-3}</annotation></semantics></math> and weight decay <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="1\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-4}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.1" class="ltx_p">For the extra VBLL hyperparameters used in the original codebase of VBLL<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
              <span class="ltx_tag ltx_tag_note">3</span>
              
              
              
            https://github.com/VectorInstitute/vbll/tree/main</span></span></span>. We use the default configuration. The prior scale is set to <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="10.0" display="inline" intent=":literal"><semantics><mn>10.0</mn><annotation encoding="application/x-tex">10.0</annotation></semantics></math> and the Wishart scale to <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="1\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-3}</annotation></semantics></math> with the degrees of freedom set to <math id="A5.SS1.p3.m3" class="ltx_Math" alttext="2.0" display="inline" intent=":literal"><semantics><mn>2.0</mn><annotation encoding="application/x-tex">2.0</annotation></semantics></math>.</p>
</div>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p">LoRA configurations use the <math id="A5.SS1.p4.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> parameter of 32 and a dropout rate of 0.1. The ensemble weights are determined using marginal likelihood estimation with a temperature scaling parameter of 1.0.</p>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Feature caching for efficient recursive updates.</h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p">The computational bottleneck in the recursive Bayesian update of Eq. (<a href="#S4.E18" title="In 4.1 Recursive update ‣ 4 Ensembling LoRA-VBLL with recursive updates ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) lies in the repeated forward passes through the LLM to compute the feature mapping <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="\boldsymbol{\phi}_{{\bf W}_{0}+{\bf A}^{\top}{\bf B}}({\bf x})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><msub><mi>𝐖</mi><mn>0</mn></msub><mo>+</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\phi}_{{\bf W}_{0}+{\bf A}^{\top}{\bf B}}({\bf x})</annotation></semantics></math>. Between two consecutive fine-tuning steps where the LoRA parameters <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="\{{\bf A},{\bf B}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>𝐀</mi><mo>,</mo><mi>𝐁</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{{\bf A},{\bf B}\}</annotation></semantics></math> remain fixed, we can eliminate this redundancy by caching these feature representations. Specifically, for a set of candidate inputs <math id="A5.SS2.p1.m3" class="ltx_Math" alttext="\{{\bf x}_{j}\}_{j=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>𝐱</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{{\bf x}_{j}\}_{j=1}^{N}</annotation></semantics></math>, we pre-compute and store the feature vectors:</p>
</div>
<div id="A5.SS2.p2" class="ltx_para">
<table id="A5.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E21.m1" class="ltx_Math" alttext="\boldsymbol{\Phi}_{\text{cached}}=\{\boldsymbol{\phi}_{{\bf W}_{0}+{\bf A}^{\top}{\bf B}}({\bf x}_{n})\}_{n=1}^{N}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝚽</mi><mtext>cached</mtext></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mrow><msub><mi>𝐖</mi><mn>0</mn></msub><mo>+</mo><mrow><msup><mi>𝐀</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\Phi}_{\text{cached}}=\{\boldsymbol{\phi}_{{\bf W}_{0}+{\bf A}^{\top}{\bf B}}({\bf x}_{n})\}_{n=1}^{N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p3" class="ltx_para">
<p id="A5.SS2.p3.1" class="ltx_p">When performing the recursive update in Eq. (<a href="#S3.E8" title="In 3.2 Recursive incremental update between fine-tuning ‣ 3 LLM-enhanced surrogate model for HDBO ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), we directly retrieve the corresponding cached feature vector without recomputing the expensive forward pass through the LLM. This yields a modified update procedure with identical mathematical properties but significantly reduced computational complexity. The posterior mean and covariance are updated as</p>
</div>
<div id="A5.SS2.p4" class="ltx_para">
<table id="A5.E22" class="ltx_equationgroup ltx_eqn_table">
<tbody><tr id="A5.EGx18" class="ltx_eqn_row"><td class="ltx_eqn_cell" colspan="5"></td></tr>
<tr id="A5.E22.1" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E22.1.m1" class="ltx_Math" alttext="\displaystyle\hat{\boldsymbol{\mu}}_{t+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝝁</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\hat{\boldsymbol{\mu}}_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E22.1.m2" class="ltx_Math" alttext="\displaystyle=\hat{\boldsymbol{\mu}}_{t}+\sigma_{t+1|t}^{-2}\hat{\boldsymbol{\Sigma}}_{t}\boldsymbol{\phi}_{\text{cached}}({\bf x}_{t+1})(y_{t+1}-\hat{y}_{t+1|t})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mover accent="true"><mi>𝝁</mi><mo>^</mo></mover><mi>t</mi></msub><mo>+</mo><mrow><msubsup><mi>σ</mi><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚺</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mtext>cached</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo fence="false">|</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{\boldsymbol{\mu}}_{t}+\sigma_{t+1|t}^{-2}\hat{\boldsymbol{\Sigma}}_{t}\boldsymbol{\phi}_{\text{cached}}({\bf x}_{t+1})(y_{t+1}-\hat{y}_{t+1|t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22a)</span></td></tr>
<tr id="A5.E22.2" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E22.2.m1" class="ltx_Math" alttext="\displaystyle\hat{\boldsymbol{\Sigma}}_{t+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝚺</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\hat{\boldsymbol{\Sigma}}_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E22.2.m2" class="ltx_Math" alttext="\displaystyle=\hat{\boldsymbol{\Sigma}}_{t}-\sigma_{t+1|t}^{-2}\hat{\boldsymbol{\Sigma}}_{t}\boldsymbol{\phi}_{\text{cached}}({\bf x}_{t+1})\boldsymbol{\phi}_{\text{cached}}^{\top}({\bf x}_{t+1})\hat{\boldsymbol{\Sigma}}_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mover accent="true"><mi>𝚺</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msubsup><mi>σ</mi><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo fence="false">|</mo><mi>t</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚺</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mtext>cached</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mtext>cached</mtext><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝚺</mi><mo>^</mo></mover><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\hat{\boldsymbol{\Sigma}}_{t}-\sigma_{t+1|t}^{-2}\hat{\boldsymbol{\Sigma}}_{t}\boldsymbol{\phi}_{\text{cached}}({\bf x}_{t+1})\boldsymbol{\phi}_{\text{cached}}^{\top}({\bf x}_{t+1})\hat{\boldsymbol{\Sigma}}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22b)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p5" class="ltx_para">
<p id="A5.SS2.p5.1" class="ltx_p">where <math id="A5.SS2.p5.m1" class="ltx_Math" alttext="\boldsymbol{\phi}_{\text{cached}}({\bf x}_{t+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mtext>cached</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\phi}_{\text{cached}}({\bf x}_{t+1})</annotation></semantics></math> denotes the cached feature vector for input <math id="A5.SS2.p5.m2" class="ltx_Math" alttext="{\bf x}_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\bf x}_{t+1}</annotation></semantics></math> and <math id="A5.SS2.p5.m3" class="ltx_Math" alttext="\hat{y}_{t+1|t}=\boldsymbol{\phi}_{\text{cached}}^{\top}({\bf x}_{t+1})\hat{\boldsymbol{\mu}}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo fence="false">|</mo><mi>t</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mtext>cached</mtext><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝝁</mi><mo>^</mo></mover><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{t+1|t}=\boldsymbol{\phi}_{\text{cached}}^{\top}({\bf x}_{t+1})\hat{\boldsymbol{\mu}}_{t}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS2.p6" class="ltx_para">
<p id="A5.SS2.p6.1" class="ltx_p">This caching mechanism is particularly effective in discrete optimization domains such as molecular optimization <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>, where the search space is finite and pre-defined. The memory requirements scale linearly with the number of candidate points, making this approach feasible even for moderately large candidate sets. Furthermore, the cached features can be reused across multiple Thompson sampling iterations (cf. Eq. (<a href="#S3.E6" title="In 3.1 Fine-tuning LLMs via variational Bayes last layer ‣ 3 LLM-enhanced surrogate model for HDBO ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)), amortizing the initial computation cost over the entire optimization procedure.</p>
</div>
<div id="A5.SS2.p7" class="ltx_para">
<p id="A5.SS2.p7.1" class="ltx_p">The caching strategy confers a significant computational advantage over other Bayesian fine-tuning approaches that require repeated forward passes, such as Laplace approximation <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib42" title="" class="ltx_ref">42</a>]</cite> and BLoB <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>, which do not admit such optimizations due to their non-parametric nature or joint parameter updates.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
