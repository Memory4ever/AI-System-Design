              Recursive updates of <math id="alg1.l18.m1" class="ltx_Math" alttext="\{w_{t}^{j},\hat{\boldsymbol{\mu}}_{t}^{j},\hat{\boldsymbol{\Sigma}}_{t}^{j},j\in\mathcal{J}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>w</mi><mi>t</mi><mi>j</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝝁</mi><mo>^</mo></mover><mi>t</mi><mi>j</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>𝚺</mi><mo>^</mo></mover><mi>t</mi><mi>j</mi></msubsup><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒥</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{w_{t}^{j},\hat{\boldsymbol{\mu}}_{t}^{j},\hat{\boldsymbol{\Sigma}}_{t}^{j},j\in\mathcal{J}\}</annotation></semantics></math> via  (<a href="#S4.E16" title="In 4.1 Recursive update ‣ 4 Ensembling LoRA-VBLL with recursive updates ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>)-(<a href="#S4.E18" title="In 4.1 Recursive update ‣ 4 Ensembling LoRA-VBLL with recursive updates ‣ Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimzation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>);

