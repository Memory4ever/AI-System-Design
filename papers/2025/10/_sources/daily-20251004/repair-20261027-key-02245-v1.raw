<td id="A6.T5.2.1.5.3" class="ltx_td ltx_align_center" style="padding:1pt 8.3pt;"><span id="A6.T5.2.1.5.3.1" class="ltx_text" style="--ltx-bg-color:#E7F5FB;">17.4</span></td>
