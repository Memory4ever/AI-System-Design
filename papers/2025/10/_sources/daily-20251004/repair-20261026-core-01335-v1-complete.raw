<td id="A4.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T3.2.1.2.1" class="ltx_text ltx_font_bold">Symbol</span></td>
<td id="A4.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T3.2.1.3.1" class="ltx_text ltx_font_bold">Quotient space</span></td>
<td id="A4.T3.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="A4.T3.m1" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math></td>
<td id="A4.T3.2.1.5" class="ltx_td ltx_align_center ltx_border_tt">
<table id="A4.T3.2.1.5.1" class="ltx_tabular ltx_align_middle">
<tr id="A4.T3.2.1.5.1.1" class="ltx_tr">
<td id="A4.T3.2.1.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A4.T3.2.1.5.1.1.1.1" class="ltx_text ltx_font_bold">QuIIEst</span></td></tr>
<tr id="A4.T3.2.1.5.1.2" class="ltx_tr">
<td id="A4.T3.2.1.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A4.T3.2.1.5.1.2.1.1" class="ltx_text ltx_font_bold">embedding</span></td></tr>
</table></td>
<td id="A4.T3.2.1.6" class="ltx_td ltx_align_center ltx_border_tt"><math id="A4.T3.m2" class="ltx_Math" alttext="d_{a}^{\textnormal{min}}" display="inline" intent=":literal"><semantics><msubsup><mi>d</mi><mi>a</mi><mtext>min</mtext></msubsup><annotation encoding="application/x-tex">d_{a}^{\textnormal{min}}</annotation></semantics></math></td></tr>
<tr id="A4.T3.2.2" class="ltx_tr">
<td id="A4.T3.2.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A4.T3.2.2.1.1" class="ltx_text">
<span id="A4.T3.2.2.1.1.1" class="ltx_tabular ltx_align_middle">
<span id="A4.T3.2.2.1.1.1.1" class="ltx_tr">
<span id="A4.T3.2.2.1.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Stiefel</span></span>
<span id="A4.T3.2.2.1.1.1.2" class="ltx_tr">
<span id="A4.T3.2.2.1.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">manifold</span></span>
</span></span></td>
<td id="A4.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A4.T3.2.2.2.1" class="ltx_text"><math id="A4.T3.m3" class="ltx_Math" alttext="\mathrm{St}(k,\mathbb{R}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>St</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{St}(k,\mathbb{R}^{n})</annotation></semantics></math></span></td>
<td id="A4.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A4.T3.2.2.3.1" class="ltx_text"><math id="A4.T3.m4" class="ltx_Math" alttext="\frac{\mathrm{O}(n)}{\mathrm{O}(n-k)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\mathrm{O}(n)}{\mathrm{O}(n-k)}</annotation></semantics></math></span></td>
<td id="A4.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="A4.T3.2.2.4.1" class="ltx_text"><math id="A4.T3.m5" class="ltx_Math" alttext="{\scriptstyle nk-\frac{1}{2}k(k+1)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.700em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">k</mi></mrow><mo mathsize="0.700em">−</mo><mrow><mstyle scriptlevel="+1"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">k</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">k</mi><mo mathsize="0.700em">+</mo><mn mathsize="0.700em">1</mn></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\scriptstyle nk-\frac{1}{2}k(k+1)}</annotation></semantics></math></span></td>
<td id="A4.T3.2.2.5" class="ltx_td ltx_align_center ltx_border_t">St (Matrix)</td>
<td id="A4.T3.2.2.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m6" class="ltx_Math" alttext="{\scriptstyle nk}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">k</mi></mrow><annotation encoding="application/x-tex">{\scriptstyle nk}</annotation></semantics></math></td></tr>
<tr id="A4.T3.2.3" class="ltx_tr">
<td id="A4.T3.2.3.1" class="ltx_td ltx_align_center ltx_border_t">St (Vec)</td>
<td id="A4.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m7" class="ltx_Math" alttext="{\scriptstyle\binom{n}{k}+k^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mstyle scriptlevel="+1"><mfrac linethickness="0pt"><mi>n</mi><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo mathsize="0.700em">+</mo><msup><mi mathsize="0.700em">k</mi><mn mathsize="0.710em">2</mn></msup></mrow><annotation encoding="application/x-tex">{\scriptstyle\binom{n}{k}+k^{2}}</annotation></semantics></math></td></tr>
