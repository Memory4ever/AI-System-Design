<td id="A4.T4.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.T4.m6" class="ltx_Math" alttext="\mathrm{O}(n)/\mathrm{O}(n-k)\times\mathrm{O}(k)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{O}(n)/\mathrm{O}(n-k)\times\mathrm{O}(k)</annotation></semantics></math></td>
<td id="A4.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T4.m7" class="ltx_Math" alttext="\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbb{Z}_{2}</annotation></semantics></math></td>
<td id="A4.T4.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T4.m8" class="ltx_Math" alttext="\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbb{Z}_{2}</annotation></semantics></math></td></tr>
