<td id="A7.T5.2.5.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t"><span id="A7.T5.2.5.2.1" class="ltx_text ltx_font_bold">0.2023</span></td>
<td id="A7.T5.2.5.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_t">0.5785</td>
<td id="A7.T5.2.5.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_t">0.5793</td>
