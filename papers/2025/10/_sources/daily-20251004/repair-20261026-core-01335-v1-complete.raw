<th id="A4.T4.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A4.T4.m4" class="ltx_Math" alttext="\pi_{2}(\mathcal{M})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{2}(\mathcal{M})</annotation></semantics></math></th></tr>
