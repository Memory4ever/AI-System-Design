<td id="A4.T3.2.5.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m15" class="ltx_Math" alttext="{\scriptstyle\binom{n}{k}}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mstyle scriptlevel="+1"><mfrac linethickness="0pt"><mi>n</mi><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><annotation encoding="application/x-tex">{\scriptstyle\binom{n}{k}}</annotation></semantics></math></td></tr>
