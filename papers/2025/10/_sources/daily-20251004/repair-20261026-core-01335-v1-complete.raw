<td id="A4.T3.2.4.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m8" class="ltx_Math" alttext="\mathrm{Gr}(k,\mathbb{R}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>Gr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Gr}(k,\mathbb{R}^{n})</annotation></semantics></math></td>
<td id="A4.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m9" class="ltx_Math" alttext="\frac{\mathrm{O}(n)}{\mathrm{O}(n-k)\mathrm{O}(k)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\mathrm{O}(n)}{\mathrm{O}(n-k)\mathrm{O}(k)}</annotation></semantics></math></td>
<td id="A4.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m10" class="ltx_Math" alttext="{\scriptstyle k(n-k)}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">k</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">n</mi><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">k</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\scriptstyle k(n-k)}</annotation></semantics></math></td>
<td id="A4.T3.2.4.5" class="ltx_td ltx_align_center ltx_border_t">Gr (Proj)</td>
<td id="A4.T3.2.4.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T3.m11" class="ltx_Math" alttext="{\scriptstyle n^{2}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em">n</mi><mn mathsize="0.710em">2</mn></msup><annotation encoding="application/x-tex">{\scriptstyle n^{2}}</annotation></semantics></math></td></tr>
<tr id="A4.T3.2.5" class="ltx_tr">
<td id="A4.T3.2.5.1" class="ltx_td ltx_align_center"><math id="A4.T3.m12" class="ltx_Math" alttext="\mathrm{Gr}^{\star}(k,\mathbb{R}^{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>Gr</mi><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Gr}^{\star}(k,\mathbb{R}^{n})</annotation></semantics></math></td>
<td id="A4.T3.2.5.2" class="ltx_td ltx_align_center"><math id="A4.T3.m13" class="ltx_Math" alttext="\frac{\mathrm{O}(n)}{\mathrm{O}(n-k)\mathrm{SO}(k)}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>SO</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\mathrm{O}(n)}{\mathrm{O}(n-k)\mathrm{SO}(k)}</annotation></semantics></math></td>
<td id="A4.T3.2.5.3" class="ltx_td ltx_align_center"><math id="A4.T3.m14" class="ltx_Math" alttext="{\scriptstyle k(n-k)}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">k</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">n</mi><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">k</mi></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\scriptstyle k(n-k)}</annotation></semantics></math></td>
