<th id="A4.T7.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="A4.T7.2.1.3.1" class="ltx_text ltx_font_bold">Best</span></th>
<th id="A4.T7.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="A4.T7.2.1.4.1" class="ltx_text ltx_font_bold">Average</span></th></tr>
