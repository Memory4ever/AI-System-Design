<section id="Ptx1" class="ltx_part">
<h2 class="ltx_title ltx_title_part">Appendices</h2>

<section id="A1" class="ltx_appendix">
<h3 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Experimental Details</h3>

<section id="A1.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Pseudocode for <span id="A1.SS1.2" class="ltx_text ltx_font_typewriter">RLAD</span></h4>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Joint RL Training of <math id="alg1.m3" class="ltx_Math" alttext="\pi^{\mathrm{abs}}_{\theta}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>θ</mi><mi>abs</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathrm{abs}}_{\theta}</annotation></semantics></math> and <math id="alg1.m4" class="ltx_Math" alttext="\pi^{\mathrm{sol}}_{\theta}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>θ</mi><mi>sol</mi></msubsup><annotation encoding="application/x-tex">\pi^{\mathrm{sol}}_{\theta}</annotation></semantics></math></figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
