<th id="A4.T7.2.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column"><span id="A4.T7.2.2.3.1" class="ltx_text ltx_font_bold">Abstraction</span></th>
<th id="A4.T7.2.2.4" class="ltx_td ltx_align_right ltx_th ltx_th_column"><span id="A4.T7.2.2.4.1" class="ltx_text ltx_font_bold">Abstraction</span></th></tr>
<tr id="A4.T7.2.3" class="ltx_tr">
<td id="A4.T7.2.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A4.T7.2.3.1.1" class="ltx_text" style="font-size:90%;">UCI Dry Bean</span></td>
<td id="A4.T7.2.3.2" class="ltx_td ltx_align_right ltx_border_t">0.00</td>
<td id="A4.T7.2.3.3" class="ltx_td ltx_align_right ltx_border_t">0.65</td>
<td id="A4.T7.2.3.4" class="ltx_td ltx_align_right ltx_border_t">0.51</td></tr>
<tr id="A4.T7.2.4" class="ltx_tr">
<td id="A4.T7.2.4.1" class="ltx_td ltx_align_left">Wikipedia Proteinogenic Acid</td>
<td id="A4.T7.2.4.2" class="ltx_td ltx_align_right">0.22</td>
<td id="A4.T7.2.4.3" class="ltx_td ltx_align_right">0.78</td>
<td id="A4.T7.2.4.4" class="ltx_td ltx_align_right">0.58</td></tr>
<tr id="A4.T7.2.5" class="ltx_tr">
<td id="A4.T7.2.5.1" class="ltx_td ltx_align_left">UCI Student Performance</td>
<td id="A4.T7.2.5.2" class="ltx_td ltx_align_right">0.25</td>
