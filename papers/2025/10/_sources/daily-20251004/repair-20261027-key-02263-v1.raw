<td id="A2.T5.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.2.2.1" class="ltx_text" style="font-size:80%;">48.54</span></td>
<td id="A2.T5.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.2.3.1" class="ltx_text" style="font-size:80%;">22.50</span></td></tr>
<tr id="A2.T5.2.3" class="ltx_tr">
<th id="A2.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.3.1.1" class="ltx_text" style="font-size:80%;">+ DaPO</span></th>
<td id="A2.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.3.2.1" class="ltx_text" style="font-size:80%;">44.17</span></td>
<td id="A2.T5.2.3.3" class="ltx_td ltx_align_center" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.3.3.1" class="ltx_text" style="font-size:80%;">23.13</span></td></tr>
<tr id="A2.T5.2.4" class="ltx_tr">
<th id="A2.T5.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.4.1.1" class="ltx_text" style="font-size:80%;">+ <span id="A2.T5.2.4.1.1.1" class="ltx_text ltx_font_typewriter">RLAD</span></span></th>
<td id="A2.T5.2.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.4.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">51.46</span></td>
<td id="A2.T5.2.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.05pt 3.6pt;"><span id="A2.T5.2.4.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">23.75</span></td></tr>
