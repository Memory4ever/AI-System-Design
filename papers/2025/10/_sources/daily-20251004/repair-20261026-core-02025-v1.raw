<td id="A1.SS3.tab1.1.32.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
<span id="A1.SS3.tab1.1.32.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A1.SS3.tab1.1.32.1.1.1" class="ltx_p">26</span>
</span></td>
<td id="A1.SS3.tab1.1.32.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding:-0.2pt 1.3pt;">
<span id="A1.SS3.tab1.1.32.2.1" class="ltx_inline-block ltx_align_top">
<span id="A1.SS3.tab1.1.32.2.1.1" class="ltx_p ltx_align_left">The protagonist competes, distancing themselves from others in pursuit of success but not recognition.</span>
</span></td>
<td id="A1.SS3.tab1.1.32.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
