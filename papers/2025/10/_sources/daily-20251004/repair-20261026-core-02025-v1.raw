<span id="A1.SS3.tab1.1.15.3.1.1" class="ltx_p ltx_align_right">H·I·S</span>
</span></td></tr>
<tr id="A1.SS3.tab1.1.16" class="ltx_tr">
<td id="A1.SS3.tab1.1.16.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
<span id="A1.SS3.tab1.1.16.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A1.SS3.tab1.1.16.1.1.1" class="ltx_p">12</span>
</span></td>
<td id="A1.SS3.tab1.1.16.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding:-0.2pt 1.3pt;">
<span id="A1.SS3.tab1.1.16.2.1" class="ltx_inline-block ltx_align_top">
<span id="A1.SS3.tab1.1.16.2.1.1" class="ltx_p ltx_align_left">The protagonist stands on self-built achievement of high status, yet external changes threaten their status.</span>
</span></td>
<td id="A1.SS3.tab1.1.16.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
