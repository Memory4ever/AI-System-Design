<span id="A1.SS3.tab1.1.16.3.1.1" class="ltx_p ltx_align_right">H·E·U</span>
</span></td></tr>
<tr id="A1.SS3.tab1.1.17" class="ltx_tr">
<td id="A1.SS3.tab1.1.17.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
<span id="A1.SS3.tab1.1.17.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A1.SS3.tab1.1.17.1.1.1" class="ltx_p">13</span>
</span></td>
<td id="A1.SS3.tab1.1.17.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding:-0.2pt 1.3pt;">
<span id="A1.SS3.tab1.1.17.2.1" class="ltx_inline-block ltx_align_top">
<span id="A1.SS3.tab1.1.17.2.1.1" class="ltx_p ltx_align_left">The protagonist secures middle-class status through effort and skill, maintaining a stable place in society.</span>
</span></td>
<td id="A1.SS3.tab1.1.17.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
