<tr id="A1.SS3.tab1.1.3" class="ltx_tr">
<td id="A1.SS3.tab1.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.2pt 1.3pt;">
