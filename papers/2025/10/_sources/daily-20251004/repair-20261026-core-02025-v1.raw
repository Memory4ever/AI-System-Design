</span></td></tr>
<tr id="A1.SS2.tab1.1.11" class="ltx_tr">
<td id="A1.SS2.tab1.1.11.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.15pt 1.1pt;">
<span id="A1.SS2.tab1.1.11.1.1" class="ltx_inline-block ltx_align_top" style="width:8.5pt;">
<span id="A1.SS2.tab1.1.11.1.1.1" class="ltx_p">9</span>
</span></td>
<td id="A1.SS2.tab1.1.11.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding:-0.15pt 1.1pt;">
<span id="A1.SS2.tab1.1.11.2.1" class="ltx_inline-block ltx_align_top">
<span id="A1.SS2.tab1.1.11.2.1.1" class="ltx_p ltx_align_left">Write like Han Kang.</span>
</span></td>
<td id="A1.SS2.tab1.1.11.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_align_top" style="padding:-0.15pt 1.1pt;">
<span id="A1.SS2.tab1.1.11.3.1" class="ltx_inline-block ltx_align_top" style="width:37.0pt;">
<span id="A1.SS2.tab1.1.11.3.1.1" class="ltx_p ltx_align_right">MP·F·AS</span>
</span></td></tr>
<tr id="A1.SS2.tab1.1.12" class="ltx_tr">
<td id="A1.SS2.tab1.1.12.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.15pt 1.1pt;">
