<span id="A1.SS4.tab1.1.6.1.1.1" class="ltx_p">4</span>
</span></td>
<td id="A1.SS4.tab1.1.6.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left" style="padding:-0.2pt 1.2pt;">
<span id="A1.SS4.tab1.1.6.2.1" class="ltx_inline-block ltx_align_top">
<span id="A1.SS4.tab1.1.6.2.1.1" class="ltx_p ltx_align_left">Set in a time of total war, collapsing empires, and competing dreams of modernity.</span>
</span></td>
<td id="A1.SS4.tab1.1.6.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.2pt 1.2pt;">
