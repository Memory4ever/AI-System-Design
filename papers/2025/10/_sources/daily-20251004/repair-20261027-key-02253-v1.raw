<td id="S4.T2.8.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m3" class="ltx_Math" alttext="\textbf{IF}_{s2s}\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_bold">IF</mtext><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\textbf{IF}_{s2s}\downarrow</annotation></semantics></math></td>
<td id="S4.T2.8.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m4" class="ltx_Math" alttext="\textbf{MD}_{1}\downarrow" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_bold">MD</mtext><mn>1</mn></msub><mo stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\textbf{MD}_{1}\downarrow</annotation></semantics></math></td>
