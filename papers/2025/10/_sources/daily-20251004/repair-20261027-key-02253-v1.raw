              <span id="lstnumberx39.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx39.3" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx39.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">editing_prompt</span><span id="lstnumberx39.5" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx39.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.7" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx39.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx39.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">top</span><span id="lstnumberx39.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx39.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">bottom</span><span id="lstnumberx39.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sections</span><span id="lstnumberx39.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx39.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx39.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">beach</span><span id="lstnumberx39.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx39.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">narrowed</span><span id="lstnumberx39.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx39.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx39.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">outside</span><span id="lstnumberx39.33" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx39.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx39.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx39.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">middle</span><span id="lstnumberx39.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">part</span><span id="lstnumberx39.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx39.44" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx39.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter">narrowed</span><span id="lstnumberx39.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span>