<td id="S4.T5.6.1.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" rowspan="2"><span id="S4.T5.6.1.1.2.1" class="ltx_text"><span id="S4.T5.6.1.1.2.1.1" class="ltx_text"></span><span id="S4.T5.6.1.1.2.1.2" class="ltx_text">
<span id="S4.T5.6.1.1.2.1.2.1" class="ltx_tabular ltx_align_middle">
