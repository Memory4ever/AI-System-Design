<td id="S4.T5.6.1.2.3" class="ltx_td ltx_align_center">Structure</td>
<td id="S4.T5.6.1.2.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T5.6.1.2.4.1" class="ltx_text ltx_font_bold">Avg.</span></td>
<td id="S4.T5.6.1.2.5" class="ltx_td ltx_align_center">Coverage</td>
<td id="S4.T5.6.1.2.6" class="ltx_td ltx_align_center">Depth</td>
