<td id="S4.T5.6.1.2.8" class="ltx_td ltx_align_center">Coherence</td>
<td id="S4.T5.6.1.2.9" class="ltx_td ltx_align_center">Fluency</td>
<td id="S4.T5.6.1.2.10" class="ltx_td ltx_align_center"><span id="S4.T5.6.1.2.10.1" class="ltx_text ltx_font_bold">Avg.</span></td></tr>
<tr id="S4.T5.6.1.3" class="ltx_tr">
<td id="S4.T5.6.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T5.6.1.3.1.1" class="ltx_text ltx_font_smallcaps">OpenAI-DR</span></td>
<td id="S4.T5.6.1.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">New</td>
<td id="S4.T5.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t">3.15</td>
<td id="S4.T5.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t">3.60</td>
<td id="S4.T5.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t">3.35</td>
<td id="S4.T5.6.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">3.37</td>
<td id="S4.T5.6.1.3.7" class="ltx_td ltx_align_center ltx_border_t">4.10</td>
<td id="S4.T5.6.1.3.8" class="ltx_td ltx_align_center ltx_border_t">4.20</td>
<td id="S4.T5.6.1.3.9" class="ltx_td ltx_align_center ltx_border_t">4.65</td>
<td id="S4.T5.6.1.3.10" class="ltx_td ltx_align_center ltx_border_t">4.10</td>
<td id="S4.T5.6.1.3.11" class="ltx_td ltx_align_center ltx_border_t">4.15</td>
<td id="S4.T5.6.1.3.12" class="ltx_td ltx_align_center ltx_border_t">4.24</td></tr>
<tr id="S4.T5.6.1.4" class="ltx_tr">
<td id="S4.T5.6.1.4.1" class="ltx_td ltx_align_left ltx_border_r">Old</td>
<td id="S4.T5.6.1.4.2" class="ltx_td ltx_align_center">3.63</td>
