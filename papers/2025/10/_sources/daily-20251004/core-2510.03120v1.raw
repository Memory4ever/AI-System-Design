<span id="S4.T5.6.1.1.2.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T5.6.1.1.2.1.2.1.2.1.1" class="ltx_text ltx_font_bold">Recency</span></span></span>
</span></span><span id="S4.T5.6.1.1.2.1.3" class="ltx_text"></span></span></td>
<td id="S4.T5.6.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="4"><span id="S4.T5.6.1.1.3.1" class="ltx_text ltx_font_bold">Outline Quality</span></td>
<td id="S4.T5.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="6"><span id="S4.T5.6.1.1.4.1" class="ltx_text ltx_font_bold">Content Quality</span></td></tr>
<tr id="S4.T5.6.1.2" class="ltx_tr">
<td id="S4.T5.6.1.2.1" class="ltx_td ltx_align_center">Coverage</td>
