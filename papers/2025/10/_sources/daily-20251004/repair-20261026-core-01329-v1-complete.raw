              <span id="alg2.l7.3" class="ltx_text" style="font-size:90%;">      determine whether to unmask </span><math id="alg2.l7.m1" class="ltx_Math" alttext="{\bm{x}}_{t-1}^{i}\sim\mathrm{Cat}(\rho_{t}^{\mathrm{flip}}f_{\theta}({\bm{x}}_{t}^{i},{\bm{z}}_{t}^{i})+\rho_{t}^{\mathrm{keep}}{\bm{m}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">𝒙</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">i</mi></msubsup><mo mathsize="0.900em">∼</mo><mrow><mi mathsize="0.900em">Cat</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><msubsup><mi mathsize="0.900em">ρ</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">flip</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝒙</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">𝒛</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msubsup><mi mathsize="0.900em">ρ</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">keep</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">𝒎</mi></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t-1}^{i}\sim\mathrm{Cat}(\rho_{t}^{\mathrm{flip}}f_{\theta}({\bm{x}}_{t}^{i},{\bm{z}}_{t}^{i})+\rho_{t}^{\mathrm{keep}}{\bm{m}})</annotation></semantics></math><span id="alg2.l7.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
              <span id="alg2.l8.3" class="ltx_text" style="font-size:90%;">      </span><span id="alg2.l8.4" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="alg2.l8.5" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l8.m1" class="ltx_Math" alttext="{\bm{x}}_{t-1}^{i}\leftarrow{\bm{m}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">𝒙</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">i</mi></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mi mathsize="0.900em">𝒎</mi></mrow><annotation encoding="application/x-tex">{\bm{x}}_{t-1}^{i}\leftarrow{\bm{m}}</annotation></semantics></math><span id="alg2.l8.6" class="ltx_text" style="font-size:90%;">  </span><span id="alg2.l8.7" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span><span id="alg2.l8.8" class="ltx_text" style="font-size:90%;">
draw </span><math id="alg2.l8.m2" class="ltx_Math" alttext="{\bm{z}}_{t-1}^{i}\sim\mathcal{N}\!\Big(\tilde{\bm{\mu}}_{t}\big(\hat{\bm{z}}_{0,\theta}^{i},\ {\bm{z}}_{t}^{i}\big),\ \tilde{\beta}_{t}{\bm{I}}_{d}\Big)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">𝒛</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">i</mi></msubsup><mo mathsize="0.900em">∼</mo><mrow><mpadded style="width:0.818em;" width="0.818em"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒩</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mover accent="true"><mi mathsize="0.900em">𝝁</mi><mo>~</mo></mover><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mover accent="true"><mi mathsize="0.900em">𝒛</mi><mo>^</mo></mover><mrow><mn mathsize="0.900em">0</mn><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">θ</mi></mrow><mi mathsize="0.900em">i</mi></msubsup><mo mathsize="0.900em">,</mo><msubsup><mi mathsize="0.900em">𝒛</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">i</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><msub><mover accent="true"><mi mathsize="0.900em">β</mi><mo>~</mo></mover><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">𝑰</mi><mi mathsize="0.900em">d</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{z}}_{t-1}^{i}\sim\mathcal{N}\!\Big(\tilde{\bm{\mu}}_{t}\big(\hat{\bm{z}}_{0,\theta}^{i},\ {\bm{z}}_{t}^{i}\big),\ \tilde{\beta}_{t}{\bm{I}}_{d}\Big)</annotation></semantics></math><span id="alg2.l8.9" class="ltx_text" style="font-size:90%;"> with equation </span><a href="#S4.E13" title="Equation 4.13 ‣ Proposition 2 (Factorization of the true posterior). ‣ 4.2 Reverse ‣ 4 Continuously Augmented Discrete Diffusion (CADD) ‣ Continuously Augmented Discrete Diffusion model for Categorical Generative Modeling" class="ltx_ref" style="font-size:90%;"><span class="ltx_text ltx_ref_tag">4.13</span></a><span id="alg2.l8.10" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
                
                
              <span id="alg2.l9.3" class="ltx_text" style="font-size:90%;">      </span><span id="alg2.l9.4" class="ltx_text ltx_font_bold" style="font-size:90%;">else</span><span id="alg2.l9.5" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l9.m1" class="ltx_Math" alttext="{\bm{z}}_{t-1}^{i}\leftarrow{\bm{w}}_{\theta}({\bm{x}}_{t-1}^{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">𝒛</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">i</mi></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">𝒘</mi><mi mathsize="0.900em">θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝒙</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">i</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{z}}_{t-1}^{i}\leftarrow{\bm{w}}_{\theta}({\bm{x}}_{t-1}^{i})</annotation></semantics></math><span id="alg2.l9.6" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
                
                
              <span id="alg2.l10.3" class="ltx_text" style="font-size:90%;">      </span><span id="alg2.l10.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l10.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l10.6" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
                
                
              <span id="alg2.l11.3" class="ltx_text" style="font-size:90%;">   </span><span id="alg2.l11.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l11.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l11.6" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
