<div id="A4.SS1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS1.p1.pic1" class="ltx_picture" height="238.57" overflow="visible" version="1.1" viewBox="0 0 653.15 238.57" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,238.57) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 232.67 C 0 235.93 2.64 238.57 5.91 238.57 L 647.24 238.57 C 650.51 238.57 653.15 235.93 653.15 232.67 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 232.67 C 1.97 234.84 3.73 236.6 5.91 236.6 L 647.24 236.6 C 649.42 236.6 651.18 234.84 651.18 232.67 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 215.45)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:14.58em;font-size:10pt;" height="211.02" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.SS1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
