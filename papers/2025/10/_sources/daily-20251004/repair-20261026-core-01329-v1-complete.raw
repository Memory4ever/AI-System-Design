</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A4.SS1.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS1.p3.pic1" class="ltx_picture" height="520.16" overflow="visible" version="1.1" viewBox="0 0 653.15 520.16" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,520.16) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 514.25 C 0 517.51 2.64 520.16 5.91 520.16 L 647.24 520.16 C 650.51 520.16 653.15 517.51 653.15 514.25 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 514.25 C 1.97 516.43 3.73 518.19 5.91 518.19 L 647.24 518.19 C 649.42 518.19 651.18 516.43 651.18 514.25 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 497.73)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:0.63em;--ltx-fo-depth:34.98em;font-size:10pt;" height="492.6" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
