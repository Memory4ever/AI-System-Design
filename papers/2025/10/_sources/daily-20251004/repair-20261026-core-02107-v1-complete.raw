</div>
<div id="lstnumberx33" class="ltx_listingline"><span id="lstnumberx33.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;">        </span><span id="lstnumberx33.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">loss</span><span id="lstnumberx33.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx33.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">=</span><span id="lstnumberx33.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx33.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">base</span><span id="lstnumberx33.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx33.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">+</span><span id="lstnumberx33.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx33.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">self</span><span id="lstnumberx33.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="lstnumberx33.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">rho</span><span id="lstnumberx33.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx33.14" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">*</span><span id="lstnumberx33.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx33.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">sumexp</span>
</div>
