<span id="A4.SS10.p2.1.1.1.1.1.1.5.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="A4.SS10.p2.m8" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math></span></span>
<span id="A4.SS10.p2.1.1.1.1.1.1.6" class="ltx_tr">
