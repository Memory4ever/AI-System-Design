font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="lstnumberx31.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">rho</span><span id="lstnumberx31.36" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx31.37" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">+</span><span id="lstnumberx31.38" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx31.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">self</span><span id="lstnumberx31.40" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="lstnumberx31.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">ema</span><span id="lstnumberx31.42" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx31.43" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">*</span><span id="lstnumberx31.44" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx31.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">est</span>
</div>
