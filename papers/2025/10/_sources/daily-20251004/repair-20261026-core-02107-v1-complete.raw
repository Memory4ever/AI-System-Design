<span id="A4.SS10.p2.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.SS10.p2.1.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Lower Bound</span></span>
<span id="A4.SS10.p2.1.1.1.1.1.1.1.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt"><span id="A4.SS10.p2.1.1.1.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Upper Bound</span></span></span>
