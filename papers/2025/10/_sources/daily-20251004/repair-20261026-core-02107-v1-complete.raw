<td id="A4.SS8.SSS0.Px1.p2.1.4.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m5" class="ltx_Math" alttext="32\times 32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">32\times 32\times 32</annotation></semantics></math></td></tr>
