<td id="A4.SS8.SSS0.Px1.p2.1.6.2" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m9" class="ltx_Math" alttext="64" display="inline" intent=":literal"><semantics><mn>64</mn><annotation encoding="application/x-tex">64</annotation></semantics></math> filters, <math id="A4.SS8.SSS0.Px1.m10" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math>, padding = <math id="A4.SS8.SSS0.Px1.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.6.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m12" class="ltx_Math" alttext="64\times 16\times 16" display="inline" intent=":literal"><semantics><mrow><mn>64</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">64\times 16\times 16</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.7" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.7.1" class="ltx_td ltx_align_left">ReLU</td>
<td id="A4.SS8.SSS0.Px1.p2.1.7.2" class="ltx_td ltx_align_left">-</td>
<td id="A4.SS8.SSS0.Px1.p2.1.7.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m13" class="ltx_Math" alttext="64\times 16\times 16" display="inline" intent=":literal"><semantics><mrow><mn>64</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">64\times 16\times 16</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.8" class="ltx_tr">
