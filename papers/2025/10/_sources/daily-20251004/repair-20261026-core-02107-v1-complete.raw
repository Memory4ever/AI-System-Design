<span id="A4.SS10.p2.1.1.1.1.1.1.8.2" class="ltx_td ltx_align_left ltx_border_t">Penalty Parameter <math id="A4.SS10.p2.m15" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></span>
