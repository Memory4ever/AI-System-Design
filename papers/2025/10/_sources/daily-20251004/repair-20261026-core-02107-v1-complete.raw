<span id="A4.SS3.p7.1.1.1.1.1.1.3.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">120</span></span>
<span id="A4.SS3.p7.1.1.1.1.1.1.4" class="ltx_tr">
<span id="A4.SS3.p7.1.1.1.1.1.1.4.1" class="ltx_td ltx_align_left ltx_border_t">PathMNIST Training</span>
