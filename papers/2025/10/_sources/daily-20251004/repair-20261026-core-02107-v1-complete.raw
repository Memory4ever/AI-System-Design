<span id="A4.SS3.p5.1.1.1.1.1.1.7.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_b ltx_border_t">150000</span></span>
</span></span></span>
</span></span></span></p>
</div>
          
</div>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A4.SS3.p6" class="ltx_para ltx_noindent">
<p id="A4.SS3.p6.1" class="ltx_p">We furthermore report the approximate runtime for a single run of an experiment (200 epochs):</p>
</div>
<figure id="A4.SS3.tab3" class="ltx_table">
<div id="A4.SS3.tab3.1" class="ltx_logical-block">
            
<div id="A4.SS3.p7" class="ltx_para ltx_noindent ltx_align_center">
<p id="A4.SS3.p7.1" class="ltx_p"><span id="A4.SS3.p7.1.1" class="ltx_text">
<span id="A4.SS3.p7.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:290.5pt;height:74.8pt;vertical-align:-34.9pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
<span id="A4.SS3.p7.1.1.1.1" class="ltx_p"><span id="A4.SS3.p7.1.1.1.1.1" class="ltx_text">
<span id="A4.SS3.p7.1.1.1.1.1.1" class="ltx_tabular ltx_align_middle">
<span id="A4.SS3.p7.1.1.1.1.1.1.1" class="ltx_tr">
<span id="A4.SS3.p7.1.1.1.1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A4.SS3.p7.1.1.1.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Dataset</span></span>
<span id="A4.SS3.p7.1.1.1.1.1.1.1.2" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt"><span id="A4.SS3.p7.1.1.1.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Approx. time per run (in minutes)</span></span></span>
<span id="A4.SS3.p7.1.1.1.1.1.1.2" class="ltx_tr">
