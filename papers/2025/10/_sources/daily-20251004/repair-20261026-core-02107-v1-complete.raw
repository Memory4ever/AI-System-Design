<td id="A4.SS8.SSS0.Px1.p2.1.10.2" class="ltx_td ltx_align_left">-</td>
<td id="A4.SS8.SSS0.Px1.p2.1.10.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m21" class="ltx_Math" alttext="128\times 8\times 8" display="inline" intent=":literal"><semantics><mrow><mn>128</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">128\times 8\times 8</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.11" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.11.1" class="ltx_td ltx_align_left">MaxPool2d</td>
<td id="A4.SS8.SSS0.Px1.p2.1.11.2" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m22" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math>, stride = <math id="A4.SS8.SSS0.Px1.m23" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.11.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m24" class="ltx_Math" alttext="128\times c\times c" display="inline" intent=":literal"><semantics><mrow><mn>128</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>c</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">128\times c\times c</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.12" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.12.1" class="ltx_td ltx_align_left">Flatten</td>
<td id="A4.SS8.SSS0.Px1.p2.1.12.2" class="ltx_td ltx_align_left">-</td>
<td id="A4.SS8.SSS0.Px1.p2.1.12.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m25" class="ltx_Math" alttext="2048" display="inline" intent=":literal"><semantics><mn>2048</mn><annotation encoding="application/x-tex">2048</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.13" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.13.1" class="ltx_td ltx_align_left">Dropout</td>
<td id="A4.SS8.SSS0.Px1.p2.1.13.2" class="ltx_td ltx_align_left">p = <math id="A4.SS8.SSS0.Px1.m26" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.13.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m27" class="ltx_Math" alttext="2048" display="inline" intent=":literal"><semantics><mn>2048</mn><annotation encoding="application/x-tex">2048</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.14" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.14.1" class="ltx_td ltx_align_left">Linear</td>
<td id="A4.SS8.SSS0.Px1.p2.1.14.2" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m28" class="ltx_Math" alttext="2048\rightarrow 256" display="inline" intent=":literal"><semantics><mrow><mn>2048</mn><mo stretchy="false">→</mo><mn>256</mn></mrow><annotation encoding="application/x-tex">2048\rightarrow 256</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.14.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m29" class="ltx_Math" alttext="256" display="inline" intent=":literal"><semantics><mn>256</mn><annotation encoding="application/x-tex">256</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.15" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.15.1" class="ltx_td ltx_align_left">ReLU</td>
<td id="A4.SS8.SSS0.Px1.p2.1.15.2" class="ltx_td ltx_align_left">-</td>
<td id="A4.SS8.SSS0.Px1.p2.1.15.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m30" class="ltx_Math" alttext="256" display="inline" intent=":literal"><semantics><mn>256</mn><annotation encoding="application/x-tex">256</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.16" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.16.1" class="ltx_td ltx_align_left ltx_border_bb">Linear</td>
<td id="A4.SS8.SSS0.Px1.p2.1.16.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="A4.SS8.SSS0.Px1.m31" class="ltx_Math" alttext="256\rightarrow\texttt{n\_out}" display="inline" intent=":literal"><semantics><mrow><mn>256</mn><mo stretchy="false">→</mo><mtext class="ltx_mathvariant_monospace">n_out</mtext></mrow><annotation encoding="application/x-tex">256\rightarrow\texttt{n\_out}</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.16.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.SS8.SSS0.Px1.p2.1.16.3.1" class="ltx_text ltx_font_typewriter">n_out</span></td></tr>
</table>
</div>
<div id="A4.SS8.SSS0.Px1.p3" class="ltx_para ltx_noindent">
<p id="A4.SS8.SSS0.Px1.p3.1" class="ltx_p">In the final layer, <math id="A4.SS8.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\texttt{n\_out}=10" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">n_out</mtext><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">\texttt{n\_out}=10</annotation></semantics></math>, <math id="A4.SS8.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\texttt{n\_out}=100" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">n_out</mtext><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">\texttt{n\_out}=100</annotation></semantics></math> or <math id="A4.SS8.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\texttt{n\_out}=9" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">n_out</mtext><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">\texttt{n\_out}=9</annotation></semantics></math>, respectively. We do so for all methods except for ablation 3) (see <a href="#S4.SS1" title="4.1 Setup ‣ 4 Experiments" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>), where <math id="A4.SS8.SSS0.Px1.p3.m4" class="ltx_Math" alttext="\texttt{n\_out}=9" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">n_out</mtext><mo>=</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">\texttt{n\_out}=9</annotation></semantics></math>, <math id="A4.SS8.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\texttt{n\_out}=99" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">n_out</mtext><mo>=</mo><mn>99</mn></mrow><annotation encoding="application/x-tex">\texttt{n\_out}=99</annotation></semantics></math> or <math id="A4.SS8.SSS0.Px1.p3.m6" class="ltx_Math" alttext="\texttt{n\_out}=8" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">n_out</mtext><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\texttt{n\_out}=8</annotation></semantics></math>, respectively. Furthermore, we note that <math id="A4.SS8.SSS0.Px1.p3.m7" class="ltx_Math" alttext="c=4" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">c=4</annotation></semantics></math> for CIFAR-10/100 (because the images have shape <math id="A4.SS8.SSS0.Px1.p3.m8" class="ltx_Math" alttext="3\times 32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">3\times 32\times 32</annotation></semantics></math>) and <math id="A4.SS8.SSS0.Px1.p3.m9" class="ltx_Math" alttext="c=8" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">c=8</annotation></semantics></math> for PathMNIST (images have shape <math id="A4.SS8.SSS0.Px1.p3.m10" class="ltx_Math" alttext="3\times 64\times 64" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>64</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>64</mn></mrow><annotation encoding="application/x-tex">3\times 64\times 64</annotation></semantics></math>).</p>
</div>
</section>
<section id="A4.SS8.SSS0.Px2" class="ltx_paragraph">
<h6 class="ltx_title ltx_title_paragraph">ImageNet.</h6>

<div id="A4.SS8.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A4.SS8.SSS0.Px2.p1.1" class="ltx_p">The architecture used corresponds to ViT-Base <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Dosovitskiy et al., 2021</a>)</cite> and is provided in the following table:</p>
</div>
<div id="A4.SS8.SSS0.Px2.p2" class="ltx_para">
<table id="A4.SS8.SSS0.Px2.p2.1" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A4.SS8.SSS0.Px2.p2.1.1" class="ltx_tr">
<td id="A4.SS8.SSS0.Px2.p2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A4.SS8.SSS0.Px2.p2.1.1.1.1" class="ltx_text ltx_font_bold">Layer Type</span></td>
<td id="A4.SS8.SSS0.Px2.p2.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A4.SS8.SSS0.Px2.p2.1.1.2.1" class="ltx_text ltx_font_bold">Parameters</span></td>
<td id="A4.SS8.SSS0.Px2.p2.1.1.3" class="ltx_td ltx_align_left ltx_border_tt"><span id="A4.SS8.SSS0.Px2.p2.1.1.3.1" class="ltx_text ltx_font_bold">Output Shape</span></td></tr>
<tr id="A4.SS8.SSS0.Px2.p2.1.2" class="ltx_tr">
<td id="A4.SS8.SSS0.Px2.p2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Input</td>
<td id="A4.SS8.SSS0.Px2.p2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">-</td>
<td id="A4.SS8.SSS0.Px2.p2.1.2.3" class="ltx_td ltx_align_left ltx_border_t"><math id="A4.SS8.SSS0.Px2.m1" class="ltx_Math" alttext="3\times 224\times 224" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>224</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>224</mn></mrow><annotation encoding="application/x-tex">3\times 224\times 224</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px2.p2.1.3" class="ltx_tr">
<td id="A4.SS8.SSS0.Px2.p2.1.3.1" class="ltx_td ltx_align_left">Patch Embedding</td>
<td id="A4.SS8.SSS0.Px2.p2.1.3.2" class="ltx_td ltx_align_left">Patch size <math id="A4.SS8.SSS0.Px2.m2" class="ltx_Math" alttext="16\times 16" display="inline" intent=":literal"><semantics><mrow><mn>16</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">16\times 16</annotation></semantics></math>, embedding dim <math id="A4.SS8.SSS0.Px2.m3" class="ltx_Math" alttext="768" display="inline" intent=":literal"><semantics><mn>768</mn><annotation encoding="application/x-tex">768</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px2.p2.1.3.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px2.m4" class="ltx_Math" alttext="196\times 768" display="inline" intent=":literal"><semantics><mrow><mn>196</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>768</mn></mrow><annotation encoding="application/x-tex">196\times 768</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px2.p2.1.4" class="ltx_tr">
<td id="A4.SS8.SSS0.Px2.p2.1.4.1" class="ltx_td ltx_align_left">Add CLS token</td>
<td id="A4.SS8.SSS0.Px2.p2.1.4.2" class="ltx_td ltx_align_left">-</td>
<td id="A4.SS8.SSS0.Px2.p2.1.4.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px2.m5" class="ltx_Math" alttext="197\times 768" display="inline" intent=":literal"><semantics><mrow><mn>197</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>768</mn></mrow><annotation encoding="application/x-tex">197\times 768</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px2.p2.1.5" class="ltx_tr">
<td id="A4.SS8.SSS0.Px2.p2.1.5.1" class="ltx_td ltx_align_left">Add Positional Encoding</td>
