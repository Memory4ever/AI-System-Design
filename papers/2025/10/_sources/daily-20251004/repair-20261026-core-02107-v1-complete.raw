<td id="A4.SS8.SSS0.Px1.p2.1.8.2" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m14" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math>, stride = <math id="A4.SS8.SSS0.Px1.m15" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.8.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m16" class="ltx_Math" alttext="64\times 8\times 8" display="inline" intent=":literal"><semantics><mrow><mn>64</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">64\times 8\times 8</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.9" class="ltx_tr">
<td id="A4.SS8.SSS0.Px1.p2.1.9.1" class="ltx_td ltx_align_left">Conv2d</td>
<td id="A4.SS8.SSS0.Px1.p2.1.9.2" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m17" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn>128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math> filters, <math id="A4.SS8.SSS0.Px1.m18" class="ltx_Math" alttext="3\times 3" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">3\times 3</annotation></semantics></math>, padding = <math id="A4.SS8.SSS0.Px1.m19" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td>
<td id="A4.SS8.SSS0.Px1.p2.1.9.3" class="ltx_td ltx_align_left"><math id="A4.SS8.SSS0.Px1.m20" class="ltx_Math" alttext="128\times 8\times 8" display="inline" intent=":literal"><semantics><mrow><mn>128</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">128\times 8\times 8</annotation></semantics></math></td></tr>
<tr id="A4.SS8.SSS0.Px1.p2.1.10" class="ltx_tr">
