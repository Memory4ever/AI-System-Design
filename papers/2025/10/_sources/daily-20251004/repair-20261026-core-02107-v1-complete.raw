<span id="A4.SS10.p2.1.1.1.1.1.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.SS10.p2.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span>
<span id="A4.SS10.p2.1.1.1.1.1.1.6.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><math id="A4.SS10.p2.m11" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math></span></span>
