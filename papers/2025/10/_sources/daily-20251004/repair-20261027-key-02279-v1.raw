<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\text{AUC}^{\text{MC}}\cdot(1-2p)+\frac{1}{M}\sum^{M}_{i}p^{2}\ +" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mtext>AUC</mtext><mtext>MC</mtext></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>i</mi><mi>M</mi></munderover></mstyle><msup><mi>p</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\text{AUC}^{\text{MC}}\cdot(1-2p)+\frac{1}{M}\sum^{M}_{i}p^{2}\ +</annotation></semantics></math></td>
