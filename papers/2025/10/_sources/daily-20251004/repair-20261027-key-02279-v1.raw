<tbody id="A4.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle+p\cdot(1-p)\frac{1}{M}\sum^{M}_{i}\begin{cases}\mathbbm{1}\left(s(x^{a}_{i})&gt;s(x^{b}_{i})\mid c(x^{a}_{i})=1,c(x^{b}_{i})=1\right)\ +\\
\mathbbm{1}\left(s(x^{a}_{i})&gt;s(x^{b}_{i})\mid c(x^{a}_{i})=0,c(x^{b}_{i})=0\right)\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>p</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mi>i</mi><mi>M</mi></munderover></mstyle><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>b</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>b</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo rspace="0.500em">)</mo></mrow></mrow><mo>+</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>b</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>a</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>i</mi><mi>b</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo>)</mo></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+p\cdot(1-p)\frac{1}{M}\sum^{M}_{i}\begin{cases}\mathbbm{1}\left(s(x^{a}_{i})&gt;s(x^{b}_{i})\mid c(x^{a}_{i})=1,c(x^{b}_{i})=1\right)\ +\\
\mathbbm{1}\left(s(x^{a}_{i})&gt;s(x^{b}_{i})\mid c(x^{a}_{i})=0,c(x^{b}_{i})=0\right)\end{cases}</annotation></semantics></math></td>
