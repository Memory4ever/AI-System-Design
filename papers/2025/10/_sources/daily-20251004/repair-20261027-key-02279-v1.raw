<tr id="p1.1.1" class="ltx_tr">
<td id="p1.1.1.1" class="ltx_td ltx_align_center"><span class="ltx_rule" style="width:0.0pt;height:24.0pt;--ltx-bg-color:black;display:inline-block;"></span></td></tr>
