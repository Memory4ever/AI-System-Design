<span id="S4.T2.tab1.1.1.1.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T2.tab1.1.1.1.5.2.1.1" class="ltx_tr">
<span id="S4.T2.tab1.1.1.1.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">P4: Lane borrowing through</span></span>
<span id="S4.T2.tab1.1.1.1.5.2.1.2" class="ltx_tr">
<span id="S4.T2.tab1.1.1.1.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">work zone</span></span>
</span></span><span id="S4.T2.tab1.1.1.1.5.3" class="ltx_text"></span></td></tr>
<tr id="S4.T2.tab1.1.1.2" class="ltx_tr">
<td id="S4.T2.tab1.1.1.2.1" class="ltx_td"></td>
<td id="S4.T2.tab1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">ADE</td>
<td id="S4.T2.tab1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">FDE</td>
<td id="S4.T2.tab1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t">CR</td>
<td id="S4.T2.tab1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t">ADE</td>
