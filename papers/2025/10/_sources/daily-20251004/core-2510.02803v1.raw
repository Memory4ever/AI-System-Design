<td id="S5.T5.5.1.5.4" class="ltx_td ltx_align_center">0.05</td></tr>
<tr id="S5.T5.5.1.6" class="ltx_tr">
<td id="S5.T5.5.1.6.1" class="ltx_td ltx_align_left ltx_border_bb"><math id="S5.T5.m4" class="ltx_Math" alttext="\mathsf{REACT\text{-}Drive}" display="inline" intent=":literal"><semantics><mrow><mi>𝖱𝖤𝖠𝖢𝖳</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝖣𝗋𝗂𝗏𝖾</mi></mrow><annotation encoding="application/x-tex">\mathsf{REACT\text{-}Drive}</annotation></semantics></math> (Ours)</td>
<td id="S5.T5.5.1.6.2" class="ltx_td ltx_align_center ltx_border_bb">64.28</td>
<td id="S5.T5.5.1.6.3" class="ltx_td ltx_align_center ltx_border_bb">106.47</td>
<td id="S5.T5.5.1.6.4" class="ltx_td ltx_align_center ltx_border_bb">0.00</td></tr>
