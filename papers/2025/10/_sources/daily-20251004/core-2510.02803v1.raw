<td id="S5.T5.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">127.68</td>
<td id="S5.T5.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">225.06</td>
<td id="S5.T5.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">0.03</td></tr>
<tr id="S5.T5.5.1.3" class="ltx_tr">
