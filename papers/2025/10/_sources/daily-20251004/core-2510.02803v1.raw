<td id="S5.T5.5.1.4.3" class="ltx_td ltx_align_center">271.56</td>
<td id="S5.T5.5.1.4.4" class="ltx_td ltx_align_center">0.03</td></tr>
<tr id="S5.T5.5.1.5" class="ltx_tr">
<td id="S5.T5.5.1.5.1" class="ltx_td ltx_align_left">RoboTron-Drive</td>
