<td id="S5.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S5.T3.2.1.2.1" class="ltx_text ltx_font_bold">iOS</span></td>
