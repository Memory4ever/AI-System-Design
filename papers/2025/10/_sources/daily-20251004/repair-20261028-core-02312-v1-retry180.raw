<span id="S4.T2.4.1.1.1.1.1.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.4.1.1.1.1.1.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">40.4</span></span>
<span id="S4.T2.4.1.1.1.1.1.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.1.1.1.1.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">59.6</span></span>
