<td id="S5.T5.8.3.11" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.11.1" class="ltx_verbatim ltx_font_typewriter">0</code></td>
<td id="S5.T5.8.3.12" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.12.1" class="ltx_verbatim ltx_font_typewriter">*</code></td>
<td id="S5.T5.8.3.13" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.13.1" class="ltx_verbatim ltx_font_typewriter">*</code></td>
