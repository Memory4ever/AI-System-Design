<td id="S5.T5.8.3.6" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.6.1" class="ltx_verbatim ltx_font_typewriter">130</code></td>
<td id="S5.T5.8.3.7" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.7.1" class="ltx_verbatim ltx_font_typewriter">0</code></td>
<td id="S5.T5.8.3.8" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.8.1" class="ltx_verbatim ltx_font_typewriter">&gt;&gt;</code></td>
