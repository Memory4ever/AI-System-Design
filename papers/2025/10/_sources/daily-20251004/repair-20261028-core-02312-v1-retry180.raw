<span id="S4.T2.4.1.1.1.1.1.1.18.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.4.1.1.1.1.1.1.18.5.1" class="ltx_text ltx_font_bold">6</span> <span id="S4.T2.4.1.1.1.1.1.1.18.5.2" class="ltx_text" style="--ltx-fg-color:#00E000;">(-92%)</span></span>
