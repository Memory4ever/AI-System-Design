<td id="S5.T5.8.4.9" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.9.1" class="ltx_verbatim ltx_font_typewriter">The</code></td>
<td id="S5.T5.8.4.10" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.10.1" class="ltx_verbatim ltx_font_typewriter">.</code></td>
<td id="S5.T5.8.4.11" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.11.1" class="ltx_verbatim ltx_font_typewriter">*</code></td>
<td id="S5.T5.8.4.12" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.12.1" class="ltx_verbatim ltx_font_typewriter">%</code></td>
<td id="S5.T5.8.4.13" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.13.1" class="ltx_verbatim ltx_font_typewriter">%</code></td>
<td id="S5.T5.8.4.14" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.14.1" class="ltx_verbatim ltx_font_typewriter">=</code></td>
<td id="S5.T5.8.4.15" class="ltx_td ltx_align_left"><code id="S5.T5.8.4.15.1" class="ltx_verbatim ltx_font_typewriter">*</code></td>
<td id="S5.T5.8.4.16" class="ltx_td ltx_align_left ltx_border_r"><code id="S5.T5.8.4.16.1" class="ltx_verbatim ltx_font_typewriter">325</code></td>
<td id="S5.T5.8.4.17" class="ltx_td ltx_align_right">975</td></tr>
<tr id="S5.T5.8.5" class="ltx_tr">
<td id="S5.T5.8.5.1" class="ltx_td ltx_align_left ltx_border_r">3</td>
<td id="S5.T5.8.5.2" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.2.1" class="ltx_verbatim ltx_font_typewriter">65</code></td>
<td id="S5.T5.8.5.3" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.3.1" class="ltx_verbatim ltx_font_typewriter">-</code></td>
<td id="S5.T5.8.5.4" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.4.1" class="ltx_verbatim ltx_font_typewriter">0</code></td>
<td id="S5.T5.8.5.5" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.5.1" class="ltx_verbatim ltx_font_typewriter">=$</code></td>
<td id="S5.T5.8.5.6" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.6.1" class="ltx_verbatim ltx_font_typewriter">125</code></td>
<td id="S5.T5.8.5.7" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.7.1" class="ltx_verbatim ltx_font_typewriter">00</code></td>
<td id="S5.T5.8.5.8" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.8.1" class="ltx_verbatim"></code>|</td>
<td id="S5.T5.8.5.9" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.9.1" class="ltx_verbatim ltx_font_typewriter">&lt;&lt;(</code></td>
<td id="S5.T5.8.5.10" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.10.1" class="ltx_verbatim ltx_font_typewriter">␣and</code></td>
<td id="S5.T5.8.5.11" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.11.1" class="ltx_verbatim ltx_font_typewriter">k</code></td>
<td id="S5.T5.8.5.12" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.12.1" class="ltx_verbatim ltx_font_typewriter">*.</code></td>
<td id="S5.T5.8.5.13" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.13.1" class="ltx_verbatim ltx_font_typewriter">=</code></td>
<td id="S5.T5.8.5.14" class="ltx_td ltx_align_left"><code id="S5.T5.8.5.14.1" class="ltx_verbatim ltx_font_typewriter">0</code></td>
