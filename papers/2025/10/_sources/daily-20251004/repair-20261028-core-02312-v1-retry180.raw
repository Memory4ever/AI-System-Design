<span id="S4.T2.4.1.1.1.1.1.1.18" class="ltx_tr">
<span id="S4.T2.4.1.1.1.1.1.1.18.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T2.4.1.1.1.1.1.1.18.1.1" class="ltx_text ltx_font_smallcaps">KaVa </span>(ours)</span>
<span id="S4.T2.4.1.1.1.1.1.1.18.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.4.1.1.1.1.1.1.18.2.1" class="ltx_text ltx_underline">6.4</span> <span id="S4.T2.4.1.1.1.1.1.1.18.2.2" class="ltx_text" style="--ltx-fg-color:#00E000;">(-80%)</span></span>
<span id="S4.T2.4.1.1.1.1.1.1.18.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.4.1.1.1.1.1.1.18.3.1" class="ltx_text ltx_underline">8.2</span> <span id="S4.T2.4.1.1.1.1.1.1.18.3.2" class="ltx_text" style="--ltx-fg-color:#00E000;">(-80%)</span></span>
