<div id="lstnumberx50" class="ltx_listingline"><span id="lstnumberx50.1" class="ltx_text ltx_lst_space ltx_font_typewriter">      </span><span id="lstnumberx50.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Optionally</span><span id="lstnumberx50.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">include</span><span id="lstnumberx50.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">params</span><span id="lstnumberx50.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">like</span><span id="lstnumberx50.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">custodians</span><span id="lstnumberx50.11" class="ltx_text ltx_font_typewriter">=10,</span><span id="lstnumberx50.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">complexity</span><span id="lstnumberx50.14" class="ltx_text ltx_font_typewriter">=0.7,</span><span id="lstnumberx50.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">aggr</span><span id="lstnumberx50.17" class="ltx_text ltx_font_typewriter">=0.4,</span><span id="lstnumberx50.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx50.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">amount</span><span id="lstnumberx50.20" class="ltx_text ltx_font_typewriter">=25.</span>
</div>
</div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 4: </span>Free-text LLM prompt</figcaption>
