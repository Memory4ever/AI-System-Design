mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}-\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Bigg]</annotation></semantics></math></td>
