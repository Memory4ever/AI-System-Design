<p id="A1.p15.3" class="ltx_p"><span id="A1.p15.3.1" class="ltx_text">Since <math id="A1.p15.m3" class="ltx_Math" alttext="p_{\theta}(Z_{s(i)}|Z_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(Z_{s(i)}|Z_{t(i)})</annotation></semantics></math> is represented by the network prediction <math id="A1.p15.m4" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}(Z_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}(Z_{t(i)})</annotation></semantics></math>, we can rewrite the first expectation as:</span></p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex60.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]=\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]=\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p15.4" class="ltx_p"><span id="A1.p15.4.1" class="ltx_text">Putting everything together, the expected log-likelihood ratio under <math id="A1.p15.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> becomes</span></p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E13.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{p_{\varphi}(Z_{s(i)}|Z_{t(i)},{\mathbf{y}})}\Bigg]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐲</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{p_{\varphi}(Z_{s(i)}|Z_{t(i)},{\mathbf{y}})}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
<tbody id="A1.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E14.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]-\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Bigg]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]-\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A1.p15.5" class="ltx_p"><span id="A1.p15.5.1" class="ltx_text">Similarly to the proof of <span id="A1.p15.5.1.1" class="ltx_text ltx_font_bold">Theorem <a href="#A1.Thmtheorem1" title="Theorem A.1 (Discrete Diffusion Posterior Sampling(DDPS)). ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a></span>, we consider two cases to compute the first expectation.
<span id="A1.p15.5.1.2" class="ltx_text ltx_font_bold">Case I: <math id="A1.p15.m6" class="ltx_Math" alttext="Z_{t(i)}={\mathbf{m}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">Z_{t(i)}={\mathbf{m}}</annotation></semantics></math>.</span>
Using the masked diffusion inference posterior derived from (<a href="#S3.E3" title="In 3.1 Preliminaries ‣ 3 Method ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), when <math id="A1.p15.m7" class="ltx_Math" alttext="Z_{t(i)}={\mathbf{m}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">Z_{t(i)}={\mathbf{m}}</annotation></semantics></math> we have</span></p>
<table id="A1.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex61.m1" class="ltx_Math" alttext="q(Z_{s(i)}={\mathbf{m}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}})=\frac{1-\alpha_{s(i)}}{1-\alpha_{t(i)}},\quad q(Z_{s(i)}={\mathbf{x}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}})=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo lspace="0.170em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐱</mi></mrow><mo lspace="0.170em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q(Z_{s(i)}={\mathbf{m}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}})=\frac{1-\alpha_{s(i)}}{1-\alpha_{t(i)}},\quad q(Z_{s(i)}={\mathbf{x}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}})=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p15.6" class="ltx_p"><span id="A1.p15.6.1" class="ltx_text">Under the pretrained model parameterization (<a href="#S3.E4" title="In 3.1 Preliminaries ‣ 3 Method ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), the corresponding terms are</span></p>
<table id="A1.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex62.m1" class="ltx_Math" alttext="\displaystyle q(Z_{s(i)}={\mathbf{m}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo lspace="0.170em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q(Z_{s(i)}={\mathbf{m}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex62.m2" class="ltx_Math" alttext="\displaystyle=\frac{1-\alpha_{s(i)}}{1-\alpha_{t(i)}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-\alpha_{s(i)}}{1-\alpha_{t(i)}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex63.m1" class="ltx_Math" alttext="\displaystyle q(Z_{s(i)}={\mathbf{x}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐱</mi></mrow><mo lspace="0.170em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q(Z_{s(i)}={\mathbf{x}}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex63.m2" class="ltx_Math" alttext="\displaystyle=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p15.7" class="ltx_p"><span id="A1.p15.7.1" class="ltx_text">and likewise with <math id="A1.p15.m8" class="ltx_Math" alttext="{\mathbf{x}}_{\varphi}(Z_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\varphi}(Z_{t(i)})</annotation></semantics></math> replacing <math id="A1.p15.m9" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}(Z_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}(Z_{t(i)})</annotation></semantics></math> for our parameterization. Hence,</span></p>
<table id="A1.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex64.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q(Z_{s(i)}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}})}\Bigg[\log\frac{q(Z_{s(i)}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi></mrow><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q(Z_{s(i)}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}})}\Bigg[\log\frac{q(Z_{s(i)}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}\,|\,Z_{t(i)}={\mathbf{m}},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
