<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)}))\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>CE</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)}))\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
