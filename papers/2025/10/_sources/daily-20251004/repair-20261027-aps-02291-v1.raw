<tbody id="A1.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex77.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac></mstyle><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E16.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Big]," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>log</mi><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A1.p17.4" class="ltx_p"><span id="A1.p17.4.1" class="ltx_text">where in the last step we use the fact that <math id="A1.p17.m1" class="ltx_Math" alttext="q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))</annotation></semantics></math> is independent of <math id="A1.p17.m2" class="ltx_Math" alttext="Z_{s(i)}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">Z_{s(i)}</annotation></semantics></math> given <math id="A1.p17.m3" class="ltx_Math" alttext="Z_{t(i)}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">Z_{t(i)}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.p18" class="ltx_para">
<p id="A1.p18.1" class="ltx_p"><span id="A1.p18.1.1" class="ltx_text ltx_font_bold">Treatment of boundary conditions.<span id="A1.p18.1.1.1" class="ltx_text ltx_font_medium">
In masked diffusion the terminal state <math id="A1.p18.m1" class="ltx_Math" alttext="Z_{1}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mn>1</mn></msub><annotation encoding="application/x-tex">Z_{1}</annotation></semantics></math> is absorbing (all-mask), hence
<math id="A1.p18.m2" class="ltx_Math" alttext="q(Z_{1}|{\mathbf{x}})=p_{\varphi}(Z_{1}|{\mathbf{y}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q(Z_{1}|{\mathbf{x}})=p_{\varphi}(Z_{1}|{\mathbf{y}})</annotation></semantics></math> and the boundary KL-divergence vanishes.
Thus (<a href="#A1.Ex72" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) becomes</span></span></p>
<table id="A1.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex78.m1" class="ltx_Math" alttext="\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>φ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex78.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}\!\big[-\log p_{\varphi}({\mathbf{x}}|Z_{0},{\mathbf{y}})\big]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mo lspace="0em">−</mo><mi>log</mi><msub><mi>p</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}\!\big[-\log p_{\varphi}({\mathbf{x}}|Z_{0},{\mathbf{y}})\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex79.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mpadded style="width:1.412em;" width="1.412em"><mi>CE</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex80.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac></mstyle><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E17.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big]." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>log</mi><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A1.p18.2" class="ltx_p"><span id="A1.p18.2.1" class="ltx_text">Since <math id="A1.p18.m3" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math> is a deterministic function of <math id="A1.p18.m4" class="ltx_Math" alttext="Z_{0}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mn>0</mn></msub><annotation encoding="application/x-tex">Z_{0}</annotation></semantics></math>, the reconstruction term in (<a href="#A1.Ex78" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) simplifies to:</span></p>
<table id="A1.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex81.m1" class="ltx_Math" alttext="\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>φ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex81.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}_{q(Z_{0}|{\mathbf{x}})}\!\big[-\log p_{\varphi}({\mathbf{x}}|Z_{0})\big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>φ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{q(Z_{0}|{\mathbf{x}})}\!\big[-\log p_{\varphi}({\mathbf{x}}|Z_{0})\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex82.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mpadded style="width:1.412em;" width="1.412em"><mi>CE</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac></mstyle><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E18.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big]." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>log</mi><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A1.p18.3" class="ltx_p"><span id="A1.p18.3.1" class="ltx_text">Finally, the decoder is same for unconditional generation and posterior sampling, i.e., <math id="A1.p18.m5" class="ltx_Math" alttext="p_{\varphi}({\mathbf{x}}|Z_{0})=p_{\theta}({\mathbf{x}}|Z_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{\varphi}({\mathbf{x}}|Z_{0})=p_{\theta}({\mathbf{x}}|Z_{0})</annotation></semantics></math>. Substituting this property in (<a href="#A1.Ex81" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) yields</span></p>
<table id="A1.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex84.m1" class="ltx_Math" alttext="\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>φ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex84.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}\!\big[-\log p_{\theta}({\mathbf{x}}|Z_{0})\big]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mo lspace="0em">−</mo><mi>log</mi><msub><mi>p</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}\!\big[-\log p_{\theta}({\mathbf{x}}|Z_{0})\big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mpadded style="width:1.412em;" width="1.412em"><mi>CE</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac></mstyle><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E19.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big]\coloneqq{\mathcal{L}}_{\mathrm{APS}}({\mathbf{x}},{\mathbf{y}};\varphi)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>log</mi><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>≔</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>APS</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo>;</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big]\coloneqq{\mathcal{L}}_{\mathrm{APS}}({\mathbf{x}},{\mathbf{y}};\varphi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A1.p18.4" class="ltx_p"><span id="A1.p18.4.1" class="ltx_text">Since <math id="A1.p18.m6" class="ltx_Math" alttext="\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)=-\log\langle\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mpadded style="width:1.412em;" width="1.412em"><mi>CE</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝐱</mi><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CE}\!\big({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)})\big)=-\log\langle\rangle</annotation></semantics></math>, the first two terms in (<a href="#A1.Ex84" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) equals to the standard NELBO (<a href="#S3.E5" title="In 3.1 Preliminaries ‣ 3 Method ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) used to train the masked diffusion model.
Therefore, we have</span></p>
<table id="A1.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex87.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{L}}_{\mathrm{APS}}({\mathbf{x}},{\mathbf{y}};\varphi)={\mathcal{L}}_{\mathrm{NELBO}}({\mathbf{x}};\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>APS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo>,</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>NELBO</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{L}}_{\mathrm{APS}}({\mathbf{x}},{\mathbf{y}};\varphi)={\mathcal{L}}_{\mathrm{NELBO}}({\mathbf{x}};\theta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex87.m2" class="ltx_math_unparsed" alttext="\displaystyle+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac></mstyle><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex88.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big]," display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>log</mi><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\big[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p18.5" class="ltx_p"><span id="A1.p18.5.1" class="ltx_text">completing the statement of the theorem.
∎</span></p>
</div>
</div>
<div id="A1.p19" class="ltx_para ltx_noindent">
<p id="A1.p19.1" class="ltx_p"><span id="A1.p19.1.1" class="ltx_text ltx_font_bold">Implications.</span>
<span id="A1.p19.1.2" class="ltx_text ltx_font_bold">Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 (Test-time Anchored Posterior Sampling). ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a></span> establishes a principled upper bound on the negative log-posterior likelihood when posterior sampling is performed without additional training.</p>
<ul id="A1.I2" class="ltx_itemize">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A1.I2.i1.p1.1" class="ltx_p"><em id="A1.I2.i1.p1.1.1" class="ltx_emph ltx_font_italic">Reuse of pretrained objective.</em> The bound <math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{L}}_{\mathrm{APS}}({\mathbf{x}},{\mathbf{y}};\varphi)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>APS</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo>,</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\mathrm{APS}}({\mathbf{x}},{\mathbf{y}};\varphi)</annotation></semantics></math> is expressed in terms of the standard masked diffusion <math id="A1.I2.i1.p1.m2" class="ltx_Math" alttext="{\mathcal{L}}_{\mathrm{NELBO}}({\mathbf{x}};\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>NELBO</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\mathrm{NELBO}}({\mathbf{x}};\theta)</annotation></semantics></math>, meaning that posterior sampling can be performed using pretrained masked diffusion models.</p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A1.I2.i2.p1.1" class="ltx_p"><em id="A1.I2.i2.p1.1.1" class="ltx_emph ltx_font_italic">Adaptation gap.</em> The log-ratio correction term quantifies the mismatch between the pretrained transitions <math id="A1.I2.i2.p1.m1" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}</annotation></semantics></math> and the proposed posterior transitions <math id="A1.I2.i2.p1.m2" class="ltx_Math" alttext="{\mathbf{x}}_{\varphi}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>φ</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{\varphi}</annotation></semantics></math>, effective only at masked positions. This isolates the additional cost of posterior sampling.</p>
</div></li>
<li id="A1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i3.p1" class="ltx_para ltx_noindent">
<p id="A1.I2.i3.p1.1" class="ltx_p"><em id="A1.I2.i3.p1.1.1" class="ltx_emph ltx_font_italic">Measurement consistency.</em> The final summation enforces alignment with the measurement likelihood <math id="A1.I2.i3.p1.m1" class="ltx_Math" alttext="q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))</annotation></semantics></math>, ensuring that the sampler accounts for observations at each diffusion step.</p>
</div></li>
<li id="A1.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i4.p1" class="ltx_para ltx_noindent">
<p id="A1.I2.i4.p1.1" class="ltx_p"><em id="A1.I2.i4.p1.1.1" class="ltx_emph ltx_font_italic">Boundary conditions.</em> As in the training bound, the absorbing mask state renders the boundary KL-divergence constant (often zero), so the effective objective simplifies to the pretrained NELBO plus adaptation and measurement terms.</p>
</div></li>
<li id="A1.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A1.I2.i5.p1" class="ltx_para">
<p id="A1.I2.i5.p1.1" class="ltx_p"><em id="A1.I2.i5.p1.1.1" class="ltx_emph ltx_font_italic">Test-time posterior sampling.</em> Together, the decomposition clarifies how posterior sampling can be performed without retraining: start from the pretrained NELBO and add corrections for model adaptation at masked positions while incorporating measurements via tilting.</p>
</div></li>
</ul>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Additional Experiments</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">This section provides supplementary details and evaluations of our APS method.
We first describe implementation details for both inverse problems and stylization (§<a href="#A2.SS1" title="B.1 Implementation Details ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>), followed by algorithmic analysis including pseudocode and hyperparameter studies (§<a href="#A2.SS2" title="B.2 Algorithm Details ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>).
We then examine the impact of design choices in our ablations (§<a href="#A2.SS3" title="B.3 Ablation Study ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>), evaluate using the same prior (§<a href="#A2.SS4" title="B.4 Evaluation Under Identical Discrete Diffusion Prior ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>), and discuss computational complexity (§<a href="#A2.SS5" title="B.5 Computational Complexity ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a>).
Next, we outline the compared baselines (§<a href="#A2.SS6" title="B.6 Compared Baselines ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>) and summarize benchmarks and metrics (§<a href="#A2.SS7" title="B.7 Benchmarks &amp; Metrics ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>).
Finally, we present additional results (§<a href="#A2.SS8" title="B.8 Additional Results ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.8</span></a>) and limitations (§<a href="#A2.SS9" title="B.9 Limitations ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.9</span></a>).</p>
</div>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Implementation Details</h3>

<section id="A2.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.1 </span>Inverse Problems</h4>

<div id="A2.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS1.p1.1" class="ltx_p">For inverse problems, we implement our test-time optimization using two main configurations corresponding to the APS (<math id="A2.SS1.SSS1.p1.m1" class="ltx_Math" alttext="512\times 512" display="inline" intent=":literal"><semantics><mrow><mn>512</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>512</mn></mrow><annotation encoding="application/x-tex">512\times 512</annotation></semantics></math>) and APS-L (<math id="A2.SS1.SSS1.p1.m2" class="ltx_Math" alttext="1024\times 1024" display="inline" intent=":literal"><semantics><mrow><mn>1024</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1024</mn></mrow><annotation encoding="application/x-tex">1024\times 1024</annotation></semantics></math>) results reported in §<a href="#S4" title="4 Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. The full reverse sampling process is discretized into <math id="A2.SS1.SSS1.p1.m3" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> time steps following a cosine mask schedule, using a classifier-free guidance scale of <math id="A2.SS1.SSS1.p1.m4" class="ltx_Math" alttext="3.5" display="inline" intent=":literal"><semantics><mn>3.5</mn><annotation encoding="application/x-tex">3.5</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS1.p2.1" class="ltx_p">At each of the <math id="A2.SS1.SSS1.p2.m1" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> reverse steps, we perform an inner optimization loop to ensure measurement consistency. This loop consists of <math id="A2.SS1.SSS1.p2.m2" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math> optimization steps using the Adam optimizer with a learning rate of <math id="A2.SS1.SSS1.p2.m3" class="ltx_Math" alttext="\eta=1.0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\eta=1.0</annotation></semantics></math>. The total loss function is a weighted sum of three components: (1) a reconstruction loss, which could be L1 or L2 norm; we choose L1 norm <math id="A2.SS1.SSS1.p2.m4" class="ltx_Math" alttext="\|{\mathbf{y}}-{\mathcal{A}}(\hat{{\mathbf{x}}})\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐲</mi><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\|{\mathbf{y}}-{\mathcal{A}}(\hat{{\mathbf{x}}})\|_{1}</annotation></semantics></math> because it is known to generate sharper quality <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib48" title="" class="ltx_ref">Van Den Oord et al., 2017</a>; <a href="#bib.bib55" title="" class="ltx_ref">Yu et al., 2024</a>)</cite>, (2) a VGG perceptual loss with a coefficient of <math id="A2.SS1.SSS1.p2.m5" class="ltx_Math" alttext="\lambda_{\mathrm{p}}=10^{-3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>p</mi></msub><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\lambda_{\mathrm{p}}=10^{-3}</annotation></semantics></math>, and (3) a prior preservation loss
<math id="A2.SS1.SSS1.p2.m6" class="ltx_math_unparsed" alttext="{\mathcal{L}}_{\mathrm{prior}}({\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)}),{\mathbf{x}}_{\theta}({\mathbf{z}}_{t(i)}))=-\frac{1}{L}\sum_{l=1}^{L}\log\langle{\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)}),{\mathbf{x}}_{\theta}({\mathbf{z}}_{t(i)})\rangle\bm{1}_{\{{\mathbf{z}}^{l}_{t(i)}={\mathbf{m}}\}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>prior</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mi>L</mi></mfrac><msubsup><mo>∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mi>log</mi><mrow><mo stretchy="false">⟨</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>𝐳</mi><msup><mrow></mrow><mi>l</mi></msup><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\mathrm{prior}}({\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)}),{\mathbf{x}}_{\theta}({\mathbf{z}}_{t(i)}))=-\frac{1}{L}\sum_{l=1}^{L}\log\langle{\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)}),{\mathbf{x}}_{\theta}({\mathbf{z}}_{t(i)})\rangle\bm{1}_{\{{\mathbf{z}}^{l}_{t(i)}={\mathbf{m}}\}}</annotation></semantics></math> with coefficient <math id="A2.SS1.SSS1.p2.m7" class="ltx_Math" alttext="\lambda_{\mathrm{pp}}=10^{-4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>pp</mi></msub><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\lambda_{\mathrm{pp}}=10^{-4}</annotation></semantics></math>.
To reduce the number of hyper-parameters introduced by our <span id="A2.SS1.SSS1.p2.1.1" class="ltx_text ltx_font_bold">Algorithm <a href="#alg1" title="In B.2 Algorithm Details ‣ Appendix B Additional Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></span> and ensure fast convergence, we make the following practical implementation choices:</p>
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I1.i1.p1.1" class="ltx_p">initialize <math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="{\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)})</annotation></semantics></math> with <math id="A2.I1.i1.p1.m2" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}({\mathbf{z}}_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}({\mathbf{z}}_{t(i)})</annotation></semantics></math>: Lines 6 and 9,</p>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I1.i2.p1.1" class="ltx_p">choose a small decaying learning rate <math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="\eta=1.0" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\eta=1.0</annotation></semantics></math> in Adam: Line 15,</p>
</div></li>
<li id="A2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i3.p1.1" class="ltx_p">optimize for a fewer iterations <math id="A2.I1.i3.p1.m1" class="ltx_Math" alttext="T=15" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">T=15</annotation></semantics></math> and <math id="A2.I1.i3.p1.m2" class="ltx_Math" alttext="M=100" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">M=100</annotation></semantics></math>: Lines 5 and 8.</p>
</div></li>
</ul>
<p id="A2.SS1.SSS1.p2.2" class="ltx_p">This has an equivalent effect of prior preservation.
We note that the optimization loop (Lines 8-16) computes gradients with respect to the logits <math id="A2.SS1.SSS1.p2.m8" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math>.
This is significantly cheaper than the expensive backpropagation steps through denoising network (here, 8B parameters for MMaDA) used in prior continuous diffusion approaches <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib35" title="" class="ltx_ref">Rout et al., 2023</a>; <a href="#bib.bib36" title="" class="ltx_ref">Rout et al., 2024</a>; <a href="#bib.bib9" title="" class="ltx_ref">Chung et al., 2024</a>)</cite>.
Thus, we set <math id="A2.SS1.SSS1.p2.m9" class="ltx_Math" alttext="\lambda_{\mathrm{pp}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>pp</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{\mathrm{pp}}=0</annotation></semantics></math> by default.
Alternatively, one could initialize <math id="A2.SS1.SSS1.p2.m10" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> with all zeros or randomly and set <math id="A2.SS1.SSS1.p2.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> very large until convergence while enforcing the prior preservation loss (<math id="A2.SS1.SSS1.p2.m12" class="ltx_Math" alttext="\lambda_{\mathrm{pp}}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>pp</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{\mathrm{pp}}\neq 0</annotation></semantics></math>) in Line 14.</p>
</div>
<div id="A2.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS1.p3.1" class="ltx_p">The specific parameters for each degradation operator <math id="A2.SS1.SSS1.p3.m1" class="ltx_Math" alttext="{\mathcal{A}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}(\cdot)</annotation></semantics></math> vary by task, with all measurements simulated by adding Gaussian noise of <math id="A2.SS1.SSS1.p3.m2" class="ltx_Math" alttext="\sigma=0.05" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\sigma=0.05</annotation></semantics></math>. For super resolution, we use a <math id="A2.SS1.SSS1.p3.m3" class="ltx_math_unparsed" alttext="4\times" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">4\times</annotation></semantics></math> downsampling factor. For Gaussian Deblurring, the operator is a Gaussian kernel of size <math id="A2.SS1.SSS1.p3.m4" class="ltx_Math" alttext="61\times 61" display="inline" intent=":literal"><semantics><mrow><mn>61</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>61</mn></mrow><annotation encoding="application/x-tex">61\times 61</annotation></semantics></math> with a standard deviation of <math id="A2.SS1.SSS1.p3.m5" class="ltx_Math" alttext="3.0" display="inline" intent=":literal"><semantics><mn>3.0</mn><annotation encoding="application/x-tex">3.0</annotation></semantics></math>. Motion Deblurring uses a kernel of the same size with an intensity parameter of <math id="A2.SS1.SSS1.p3.m6" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn>0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math> (on a scale of <math id="A2.SS1.SSS1.p3.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> for linear to <math id="A2.SS1.SSS1.p3.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> for highly nonlinear), corresponding to a moderately nonlinear motion path. For Inpainting, we randomly remove <math id="A2.SS1.SSS1.p3.m9" class="ltx_Math" alttext="70\%" display="inline" intent=":literal"><semantics><mrow><mn>70</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">70\%</annotation></semantics></math> of pixels. Nonlinear Deblurring kernels are generated using the <span id="A2.SS1.SSS1.p3.1.1" class="ltx_text ltx_font_typewriter">KernelWizard<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
                  <span class="ltx_tag ltx_tag_note"><span id="footnote1.1" class="ltx_text ltx_font_serif">1</span></span>
                  
                  
                  
                <a href="https://github.com/LeviBorodenko/motionblur" title="" class="ltx_ref ltx_url">https://github.com/LeviBorodenko/motionblur</a></span></span></span></span> model from the <span id="A2.SS1.SSS1.p3.1.2" class="ltx_text ltx_font_typewriter">bkse<span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
                  <span class="ltx_tag ltx_tag_note"><span id="footnote2.1" class="ltx_text ltx_font_serif">2</span></span>
                  
                  
                  
                <a href="https://github.com/VinAIResearch/blur-kernel-space-exploring" title="" class="ltx_ref ltx_url">https://github.com/VinAIResearch/blur-kernel-space-exploring</a></span></span></span></span> library. Finally, High Dynamic Range (HDR) reconstruction is modeled by scaling the image data and clipping the result, following the operation <math id="A2.SS1.SSS1.p3.m10" class="ltx_Math" alttext="\text{clip}(\text{data}\times 2,-1,1)" display="inline" intent=":literal"><semantics><mrow><mtext>clip</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>data</mtext><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{clip}(\text{data}\times 2,-1,1)</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.2 </span>Reference-based Stylization</h4>

<div id="A2.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS2.p1.1" class="ltx_p">Our approach to training-free, reference-based stylization leverages the core APS framework by framing the task as a <span id="A2.SS1.SSS2.p1.1.1" class="ltx_text ltx_font_italic">highly nonlinear</span> inverse problem. Let <math id="A2.SS1.SSS2.p1.m1" class="ltx_Math" alttext="\hat{{\mathbf{x}}}_{\text{ref}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mtext>ref</mtext></msub><annotation encoding="application/x-tex">\hat{{\mathbf{x}}}_{\text{ref}}</annotation></semantics></math> denote the conditional reference image providing the style. The target measurement, a style vector <math id="A2.SS1.SSS2.p1.m2" class="ltx_Math" alttext="{\mathbf{y}}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">{\mathbf{y}}</annotation></semantics></math>, is obtained by applying a pretrained Contrastive Style Descriptor (CSD) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib46" title="" class="ltx_ref">Somepalli et al., 2024</a>)</cite> model as our measurement operator <math id="A2.SS1.SSS2.p1.m3" class="ltx_Math" alttext="{\mathcal{A}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}(\cdot)</annotation></semantics></math> to this reference image, i.e., <math id="A2.SS1.SSS2.p1.m4" class="ltx_Math" alttext="{\mathbf{y}}={\mathcal{A}}(\hat{{\mathbf{x}}}_{\mathrm{ref}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mi>ref</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{y}}={\mathcal{A}}(\hat{{\mathbf{x}}}_{\mathrm{ref}})</annotation></semantics></math>. At each reverse diffusion step <math id="A2.SS1.SSS2.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, APS aims to generate a sample whose style matches this target.</p>
</div>
<div id="A2.SS1.SSS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS2.p2.1" class="ltx_p">As discussed in §<a href="#S3.SS2" title="3.2 Test-Time Anchored Posterior Sampling ‣ 3 Method ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, there are two main stages of APS.
In the first stage (§<a href="#S3.SS2.SSS1" title="3.2.1 Quantized Expectation ‣ 3.2 Test-Time Anchored Posterior Sampling ‣ 3 Method ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2.1</span></a>), we perform a differentiable forward pass by computing the expected codebook embedding <math id="A2.SS1.SSS2.p2.m1" class="ltx_Math" alttext="\bar{{\mathbf{x}}}^{l}=\sum_{k=1}^{K}{\mathbf{c}}_{k}{\mathbf{x}}^{l}_{\varphi}({\mathbf{z}}_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>l</mi></msup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><msub><mi>𝐜</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐱</mi><mi>φ</mi><mi>l</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{{\mathbf{x}}}^{l}=\sum_{k=1}^{K}{\mathbf{c}}_{k}{\mathbf{x}}^{l}_{\varphi}({\mathbf{z}}_{t(i)})</annotation></semantics></math> for <math id="A2.SS1.SSS2.p2.m2" class="ltx_Math" alttext="l=1,\dots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">l=1,\dots,L</annotation></semantics></math> using the model’s output probabilities <math id="A2.SS1.SSS2.p2.m3" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}({\mathbf{z}}_{t})^{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>l</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}({\mathbf{z}}_{t})^{l}</annotation></semantics></math> as initial condition for <math id="A2.SS1.SSS2.p2.m4" class="ltx_Math" alttext="\varphi_{t(i)}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi>φ</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi>l</mi></msubsup><annotation encoding="application/x-tex">\varphi_{t(i)}^{l}</annotation></semantics></math>. The straight-through estimator is then used to obtain a differentiable image representation <math id="A2.SS1.SSS2.p2.m5" class="ltx_Math" alttext="\hat{{\mathbf{x}}}={\mathcal{D}}(\tilde{{\mathbf{x}}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{{\mathbf{x}}}={\mathcal{D}}(\tilde{{\mathbf{x}}})</annotation></semantics></math>. To guide the optimization, the measurement consistency loss is calculated as the cosine distance between the style vector of the generated image and the target style vector <math id="A2.SS1.SSS2.p2.m6" class="ltx_Math" alttext="{\mathbf{y}}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">{\mathbf{y}}</annotation></semantics></math> as follows:</p>
<table id="A2.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\text{style}}(\varphi_{t(i)})=1-\frac{\langle{\mathcal{A}}(\hat{{\mathbf{x}}}),{\mathbf{y}})\rangle}{\|{\mathcal{A}}(\hat{{\mathbf{x}}})\|\|{\mathbf{y}}\|}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>style</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mo stretchy="false">)</mo><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo></mrow><mrow><mrow><mo stretchy="false">‖</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mi>𝐲</mi><mo stretchy="false">‖</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{style}}(\varphi_{t(i)})=1-\frac{\langle{\mathcal{A}}(\hat{{\mathbf{x}}}),{\mathbf{y}})\rangle}{\|{\mathcal{A}}(\hat{{\mathbf{x}}})\|\|{\mathbf{y}}\|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.SSS2.p2.2" class="ltx_p">For each reverse step, we perform <math id="A2.SS1.SSS2.p2.m7" class="ltx_Math" alttext="100" display="inline" intent=":literal"><semantics><mn>100</mn><annotation encoding="application/x-tex">100</annotation></semantics></math> optimization steps using an Adam optimizer with a learning rate of <math id="A2.SS1.SSS2.p2.m8" class="ltx_Math" alttext="0.1" display="inline" intent=":literal"><semantics><mn>0.1</mn><annotation encoding="application/x-tex">0.1</annotation></semantics></math>. Gradients from this style loss are backpropagated through the frozen VQ-VAE decoder <math id="A2.SS1.SSS2.p2.m9" class="ltx_Math" alttext="{\mathcal{D}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{D}}(\cdot)</annotation></semantics></math> and the straight-through estimator <math id="A2.SS1.SSS2.p2.m10" class="ltx_Math" alttext="\tilde{{\mathbf{x}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝐱</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{{\mathbf{x}}}</annotation></semantics></math> to update all the entries of the conditional probability table by directly updating the logits <math id="A2.SS1.SSS2.p2.m11" class="ltx_Math" alttext="\varphi_{t(i)}=\{\varphi_{t(i)}^{l}\}_{l=1}^{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>φ</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mi>l</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup></mrow><annotation encoding="application/x-tex">\varphi_{t(i)}=\{\varphi_{t(i)}^{l}\}_{l=1}^{L}</annotation></semantics></math>.</p>
</div>
<div id="A2.SS1.SSS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS2.p3.1" class="ltx_p">In the second stage (§<a href="#S3.SS2.SSS2" title="3.2.2 Anchored Remasking ‣ 3.2 Test-Time Anchored Posterior Sampling ‣ 3 Method ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2.2</span></a>), the posterior estimate <math id="A2.SS1.SSS2.p3.m1" class="ltx_Math" alttext="{\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\varphi}({\mathbf{z}}_{t(i)})</annotation></semantics></math> obtained from the first stage is used adaptively unmask anchor tokens in the sequence.
Both the processes continue over <math id="A2.SS1.SSS2.p3.m2" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> total steps following a cosine mask schedule.
The fully unmasked sequence satisfies the stylistic constraints without requiring any task-specific retraining of the foundation model.</p>
</div>
</section>
<section id="A2.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.1.3 </span>High-Resolution Inference</h4>

<div id="A2.SS1.SSS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.SSS3.p1.1" class="ltx_p">To demonstrate the scalability of our method, we experiment with a higher-resolution setting. For a fair comparison on our <math id="A2.SS1.SSS3.p1.m1" class="ltx_Math" alttext="256\times 256" display="inline" intent=":literal"><semantics><mrow><mn>256</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>256</mn></mrow><annotation encoding="application/x-tex">256\times 256</annotation></semantics></math> benchmark, we follow the upsampling protocol described in G2D2 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Murata et al., 2024</a>)</cite>. Specifically, for both our standard (<math id="A2.SS1.SSS3.p1.m2" class="ltx_Math" alttext="512\times 512" display="inline" intent=":literal"><semantics><mrow><mn>512</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>512</mn></mrow><annotation encoding="application/x-tex">512\times 512</annotation></semantics></math>) and large-scale (APS-L, <math id="A2.SS1.SSS3.p1.m3" class="ltx_Math" alttext="1024\times 1024" display="inline" intent=":literal"><semantics><mrow><mn>1024</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1024</mn></mrow><annotation encoding="application/x-tex">1024\times 1024</annotation></semantics></math>) models, we first upsample the benchmark images to the model’s native resolution before applying the forward operator. For the APS-L configuration, this increases the number of visual tokens by a factor of four (from <math id="A2.SS1.SSS3.p1.m4" class="ltx_Math" alttext="1024" display="inline" intent=":literal"><semantics><mn>1024</mn><annotation encoding="application/x-tex">1024</annotation></semantics></math> to <math id="A2.SS1.SSS3.p1.m5" class="ltx_Math" alttext="4096" display="inline" intent=":literal"><semantics><mn>4096</mn><annotation encoding="application/x-tex">4096</annotation></semantics></math>)<span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
                <span class="ltx_tag ltx_tag_note">3</span>
                
                
                
              The visual tokenizer <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib55" title="" class="ltx_ref">Yu et al., 2024</a>)</cite> used in MMaDA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib53" title="" class="ltx_ref">Yang et al., 2025</a>)</cite> uses 16<math id="footnote3.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> downscaling, generating <math id="footnote3.m2" class="ltx_Math" alttext="1024=32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>1024</mn><mo>=</mo><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow></mrow><annotation encoding="application/x-tex">1024=32\times 32</annotation></semantics></math> tokens for an image of size <math id="footnote3.m3" class="ltx_Math" alttext="512\times 512" display="inline" intent=":literal"><semantics><mrow><mn>512</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>512</mn></mrow><annotation encoding="application/x-tex">512\times 512</annotation></semantics></math>.</span></span></span>. The Transformer-based MMaDA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib53" title="" class="ltx_ref">Yang et al., 2025</a>)</cite> model accommodates this by processing a longer sequence without architectural changes. After the high-resolution reconstruction is complete, we downsample the output back to the benchmark’s native <math id="A2.SS1.SSS3.p1.m6" class="ltx_Math" alttext="256\times 256" display="inline" intent=":literal"><semantics><mrow><mn>256</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>256</mn></mrow><annotation encoding="application/x-tex">256\times 256</annotation></semantics></math> resolution for evaluation. As demonstrated in our experiments (§<a href="#S4.SS1" title="4.1 Results on Linear Inverse Problems ‣ 4 Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, §<a href="#S4.SS2" title="4.2 Results on General Inverse Problems ‣ 4 Experiments ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), this approach further improves performance, achieving substantial gains in both PSNR and LPIPS.</p>
</div>
</section>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Algorithm Details</h3>

<figure id="alg1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Test-Time Anchored Posterior Sampling (APS)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.4.1" class="ltx_listingline">





















































<div id="alg1.4.1.1" class="ltx_listing ltx_listing">
<div id="\algocf@printnl@i{{{3}}}alg1.l1" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">1:</span>
                  
                  
                 <span id="\algocf@printnl@i{{{3}}}alg1.l1.2" class="ltx_text ltx_font_bold">Input:</span> Diffusion steps <math id="\algocf@printnl@i{{{3}}}alg1.l1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, measurement <math id="\algocf@printnl@i{{{3}}}alg1.l1.m2" class="ltx_Math" alttext="{\mathbf{y}}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">{\mathbf{y}}</annotation></semantics></math>, denoiser <math id="\algocf@printnl@i{{{3}}}alg1.l1.m3" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}^{\mathrm{logits}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>θ</mi><mi>logits</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}^{\mathrm{logits}}(\cdot)</annotation></semantics></math>, operator <math id="\algocf@printnl@i{{{3}}}alg1.l1.m4" class="ltx_Math" alttext="{\mathcal{A}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}(\cdot)</annotation></semantics></math>, decoder <math id="\algocf@printnl@i{{{3}}}alg1.l1.m5" class="ltx_Math" alttext="{\mathcal{D}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{D}}(\cdot)</annotation></semantics></math>,
Codebook <math id="\algocf@printnl@i{{{3}}}alg1.l1.m6" class="ltx_Math" alttext="{\mathcal{C}}=\{{\mathbf{c}}_{k}\}_{k=1}^{K}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>𝐜</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}=\{{\mathbf{c}}_{k}\}_{k=1}^{K}</annotation></semantics></math>, Lookup-Free Quantizer <math id="\algocf@printnl@i{{{3}}}alg1.l1.m7" class="ltx_Math" alttext="{\mathcal{Q}}_{\mathrm{lfq}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>lfq</mi></msub><annotation encoding="application/x-tex">{\mathcal{Q}}_{\mathrm{lfq}}</annotation></semantics></math>.

</div>
<div id="alg1.l2" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">2:</span>
                  
                  
                 <span id="alg1.l2.2" class="ltx_text ltx_font_bold">Tunable parameters:</span> Optimization steps <math id="alg1.l2.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, learning rate <math id="alg1.l2.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, loss coefficients <math id="alg1.l2.m3" class="ltx_Math" alttext="\lambda_{\mathrm{p}},\lambda_{e}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>p</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>e</mi></msub></mrow><annotation encoding="application/x-tex">\lambda_{\mathrm{p}},\lambda_{e}</annotation></semantics></math>.

</div>
<div id="alg1.l3" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">3:</span>
                  
                  
                 <span id="alg1.l3.2" class="ltx_text ltx_font_bold">Output:</span> Reconstructed image <math id="alg1.l3.m1" class="ltx_Math" alttext="\hat{{\mathbf{x}}}_{\text{final}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mtext>final</mtext></msub><annotation encoding="application/x-tex">\hat{{\mathbf{x}}}_{\text{final}}</annotation></semantics></math>.

</div>
<div id="alg1.l4" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">4:</span>
                  
                  
                 Initialize latent state <math id="alg1.l4.m1" class="ltx_Math" alttext="{\mathbf{z}}_{1}\leftarrow\{{\mathbf{m}}\}^{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mn>1</mn></msub><mo stretchy="false">←</mo><msup><mrow><mo stretchy="false">{</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbf{z}}_{1}\leftarrow\{{\mathbf{m}}\}^{L}</annotation></semantics></math> (all masked)

</div>
<div id="alg1.l5" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline">5:</span>
                  
                  
                 <span id="alg1.l5.2" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text ltx_font_bold">to</span> <math id="alg1.l5.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">do</span>



</div>
