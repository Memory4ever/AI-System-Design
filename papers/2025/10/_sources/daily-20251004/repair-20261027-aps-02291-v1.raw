<tr id="S3.T1.6.1.2" class="ltx_tr">
<th id="S3.T1.6.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Type</th>
<th id="S3.T1.6.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">Method</th>
<td id="S3.T1.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t" colspan="2">SR (4<math id="S3.T1.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</td>
<td id="S3.T1.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t" colspan="2">Deblur</td>
<td id="S3.T1.6.1.2.5" class="ltx_td ltx_align_center ltx_border_t" colspan="2">SR (4<math id="S3.T1.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</td>
<td id="S3.T1.6.1.2.6" class="ltx_td ltx_align_center ltx_border_t" colspan="2">Deblur</td></tr>
<tr id="S3.T1.6.1.3" class="ltx_tr">
<th id="S3.T1.6.1.3.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="S3.T1.6.1.3.2" class="ltx_td ltx_th ltx_th_row"></th>
<td id="S3.T1.6.1.3.3" class="ltx_td ltx_align_center">LPIPS <math id="S3.T1.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
