<div id="A1.p16" class="ltx_para ltx_noindent">
<p id="A1.p16.1" class="ltx_p"><span id="A1.p16.1.1" class="ltx_text ltx_font_bold">Case II: <math id="A1.p16.m1" class="ltx_Math" alttext="Z_{t(i)}\neq{\mathbf{m}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≠</mo><mi>𝐦</mi></mrow><annotation encoding="application/x-tex">Z_{t(i)}\neq{\mathbf{m}}</annotation></semantics></math>.<span id="A1.p16.1.1.1" class="ltx_text ltx_font_medium">
When the token is already revealed, the posterior is deterministic:</span></span></p>
<table id="A1.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex67.m1" class="ltx_Math" alttext="q(Z_{s(i)}=Z_{t(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}})=1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q(Z_{s(i)}=Z_{t(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p16.2" class="ltx_p"><span id="A1.p16.2.1" class="ltx_text">and this form is identical for the <math id="A1.p16.m2" class="ltx_Math" alttext="{\mathbf{x}}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{\theta}</annotation></semantics></math>- and <math id="A1.p16.m3" class="ltx_Math" alttext="{\mathbf{x}}_{\varphi}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>φ</mi></msub><annotation encoding="application/x-tex">{\mathbf{x}}_{\varphi}</annotation></semantics></math>-parameterized posteriors as well:</span></p>
<table id="A1.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex68.m1" class="ltx_Math" alttext="q(Z_{s(i)}=Z_{t(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))=1,\quad q(Z_{s(i)}=Z_{t(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}}_{\varphi}(Z_{t(i)}))=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q(Z_{s(i)}=Z_{t(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}}_{\theta}(Z_{t(i)}))=1,\quad q(Z_{s(i)}=Z_{t(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}}_{\varphi}(Z_{t(i)}))=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p16.3" class="ltx_p"><span id="A1.p16.3.1" class="ltx_text">Therefore,</span></p>
<table id="A1.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex69.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q(Z_{s(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}})}\Bigg[\log\frac{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≠</mo><mi>𝐦</mi></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q(Z_{s(i)}\,|\,Z_{t(i)}\neq{\mathbf{m}},{\mathbf{x}})}\Bigg[\log\frac{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.p17" class="ltx_para ltx_noindent">
<p id="A1.p17.1" class="ltx_p"><span id="A1.p17.1.1" class="ltx_text">Combining both cases,</span></p>
<table id="A1.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex70.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}})}\Bigg[\log\frac{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\,," display="block" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>log</mi><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0.170em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo>=</mo><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac><mi>log</mi><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac><msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}})}\Bigg[\log\frac{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\theta}(Z_{t(i)}))}{q(Z_{s(i)}\,|\,Z_{t(i)},{\mathbf{x}}_{\varphi}(Z_{t(i)}))}\Bigg]=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p17.2" class="ltx_p"><span id="A1.p17.2.1" class="ltx_text">which simplifies (<a href="#A1.E13" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) as follows:</span></p>
<table id="A1.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex71.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{p_{\varphi}(Z_{s(i)}|Z_{t(i)},{\mathbf{y}})}\Bigg]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐲</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{p_{\varphi}(Z_{s(i)}|Z_{t(i)},{\mathbf{y}})}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E15.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\,-\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Bigg]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>𝐱</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">⟩</mo></mrow></mfrac></mstyle><msub><mn>𝟏</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo>−</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>log</mi><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐱</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\log\frac{\langle{\mathbf{x}}_{\theta}(Z_{t(i)}),{\mathbf{x}}\rangle}{\langle{\mathbf{x}}_{\varphi}(Z_{t(i)}),{\mathbf{x}}\rangle}\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\,-\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\!\Bigg[\log q({\mathbf{y}}|{\mathbf{x}}_{\varphi}(Z_{t(i)}))\Bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A1.p17.3" class="ltx_p"><span id="A1.p17.3.1" class="ltx_text">Substituting (<a href="#A1.Ex71" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) into (<a href="#A1.Ex53" title="In Proof. ‣ Appendix A Additional Theoretical Results ‣ Test-Time Anchoring for Discrete Diffusion Posterior Sampling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), the conditional likelihood can be bounded as</span></p>
<table id="A1.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex72.m1" class="ltx_Math" alttext="\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>φ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\log p_{\varphi}({\mathbf{x}}|{\mathbf{y}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex72.m2" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}[-\log p_{\varphi}({\mathbf{x}}|Z_{0},{\mathbf{y}})]+\mathbb{E}_{q(Z_{1}|{\mathbf{x}})}\!\Big[\log\frac{q(Z_{1}|{\mathbf{x}})}{p_{\varphi}(Z_{1}|{\mathbf{y}})}\Big]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>log</mi><msub><mi>p</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}[-\log p_{\varphi}({\mathbf{x}}|Z_{0},{\mathbf{y}})]+\mathbb{E}_{q(Z_{1}|{\mathbf{x}})}\!\Big[\log\frac{q(Z_{1}|{\mathbf{x}})}{p_{\varphi}(Z_{1}|{\mathbf{y}})}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex73.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)}))\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>α</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mfrac></mstyle><mi>CE</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><msub><mi>𝐱</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msub><mn class="ltx_mathvariant_bold" mathvariant="bold"> 1</mn><mrow><mo stretchy="false">{</mo><mi>Z</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mi>𝐦</mi><mo stretchy="false">}</mo></mrow></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\Bigg[\frac{\alpha_{s(i)}-\alpha_{t(i)}}{1-\alpha_{t(i)}}\,\mathrm{CE}({\mathbf{x}},{\mathbf{x}}_{\theta}(Z_{t(i)}))\,\bm{1}_{\{Z_{t(i)}={\mathbf{m}}\}}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex74.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{p_{\varphi}(Z_{s(i)}|Z_{t(i)},{\mathbf{y}})}\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>Z</mi><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐲</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\sum_{i=1}^{T}\mathbb{E}_{q(Z_{t(i)}|{\mathbf{x}})}\mathbb{E}_{q(Z_{s(i)}|Z_{t(i)},{\mathbf{x}})}\Bigg[\log\frac{p_{\theta}(Z_{s(i)}|Z_{t(i)})}{p_{\varphi}(Z_{s(i)}|Z_{t(i)},{\mathbf{y}})}\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex75.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}[-\log p_{\varphi}({\mathbf{x}}|Z_{0},{\mathbf{y}})]+\mathbb{E}_{q(Z_{1}|{\mathbf{x}})}\!\Big[\log\frac{q(Z_{1}|{\mathbf{x}})}{p_{\varphi}(Z_{1}|{\mathbf{y}})}\Big]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo stretchy="false">(</mo><mi>Z</mi><msub><mrow></mrow><mrow><mn>0</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>1</mn></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>log</mi><msub><mi>p</mi><mi>φ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>Z</mi><mn>0</mn></msub><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{q(Z_{0:1}|{\mathbf{x}})}[-\log p_{\varphi}({\mathbf{x}}|Z_{0},{\mathbf{y}})]+\mathbb{E}_{q(Z_{1}|{\mathbf{x}})}\!\Big[\log\frac{q(Z_{1}|{\mathbf{x}})}{p_{\varphi}(Z_{1}|{\mathbf{y}})}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
