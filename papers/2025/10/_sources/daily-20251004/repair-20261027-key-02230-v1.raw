<tbody class="ltx_tbody">
<tr id="S6.T1.4.1.3" class="ltx_tr">
<th id="S6.T1.4.1.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;" rowspan="3"><span id="S6.T1.4.1.3.1.1" class="ltx_text"> Qwen2.5-Math-1.5B</span></th>
<td id="S6.T1.4.1.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">Base model</td>
<td id="S6.T1.4.1.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">9.73</td>
<td id="S6.T1.4.1.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">75.86</td>
<td id="S6.T1.4.1.3.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">4.45</td>
<td id="S6.T1.4.1.3.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">67.80</td>
<td id="S6.T1.4.1.3.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">58.83</td>
<td id="S6.T1.4.1.3.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">95.58</td>
<td id="S6.T1.4.1.3.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.9pt;padding-right:0.9pt;">16.82</td>
