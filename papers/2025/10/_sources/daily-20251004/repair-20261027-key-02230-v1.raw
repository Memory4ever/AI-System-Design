<th id="S6.T1.4.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:0.9pt;padding-right:0.9pt;" rowspan="2"><span id="S6.T1.4.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="S6.T1.4.1.1.3" class="ltx_td ltx_nopad_l ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:0.9pt;padding-right:0.9pt;" colspan="2"><span id="S6.T1.4.1.1.3.1" class="ltx_text ltx_font_bold">AIME 2024</span></th>
