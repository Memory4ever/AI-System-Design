<tr id="S6.T1.4.1.2" class="ltx_tr">
<th id="S6.T1.4.1.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column" style="padding-left:0.9pt;padding-right:0.9pt;">Pass@1</th>
