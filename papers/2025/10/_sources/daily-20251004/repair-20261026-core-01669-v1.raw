<tr id="S4.T3.5.1.3" class="ltx_tr">
<td id="S4.T3.5.1.3.1" class="ltx_td ltx_align_left"><span id="S4.T3.5.1.3.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">(b) (w/ ThreadPose)</span></td>
<td id="S4.T3.5.1.3.2" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#00FF00;">✓</span></td>
<td id="S4.T3.5.1.3.3" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S4.T3.5.1.3.4" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.4.1" class="ltx_text" style="font-size:90%;">17.29</span></td>
<td id="S4.T3.5.1.3.5" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.3.5.1" class="ltx_text" style="font-size:90%;">0.5876</span></td></tr>
