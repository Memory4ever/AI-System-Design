<td id="S4.T3.5.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T3.5.1.4.5.1" class="ltx_text" style="font-size:90%;">0.6067</span></td></tr>
<tr id="S4.T3.5.1.5" class="ltx_tr">
