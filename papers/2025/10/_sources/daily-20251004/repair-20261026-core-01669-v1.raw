<td id="S4.T5.7.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T5.7.1.1.7.1" class="ltx_text" style="font-size:70%;">SSIM</span></td>
<td id="S4.T5.7.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T5.7.1.1.8.1" class="ltx_text" style="font-size:70%;">LPIPS</span></td></tr>
<tr id="S4.T5.7.1.2" class="ltx_tr">
<td id="S4.T5.7.1.2.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S4.T5.7.1.2.1.1" class="ltx_text" style="font-size:70%;">MSE</span></td>
<td id="S4.T5.7.1.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.7.1.2.2.1" class="ltx_text" style="font-size:70%;">16.19</span></td>
<td id="S4.T5.7.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T5.7.1.2.3.1" class="ltx_text" style="font-size:70%;">0.3788</span></td>
<td id="S4.T5.7.1.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S4.T5.7.1.2.4.1" class="ltx_text" style="font-size:70%;">0.5340</span></td>
<td id="S4.T5.7.1.2.5" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S4.T5.7.1.2.5.1" class="ltx_text" style="font-size:70%;">Consistent</span></td>
<td id="S4.T5.7.1.2.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="--ltx-bg-color:#FFB3B3;"><span id="S4.T5.7.1.2.6.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#FFB3B3;">17.42</span></td>
