<div id="alg1.l28" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l28.1" class="ltx_text" style="font-size:80%;">28:</span></span>
              
              
             <math id="alg1.l28.m1" class="ltx_math_unparsed" alttext="\{P^{\prime}_{i}\}_{i=1}^{K}\leftarrow Camera(I^{re}{{}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>P</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo stretchy="false">←</mo><mi>C</mi><mi>a</mi><mi>m</mi><mi>e</mi><mi>r</mi><mi>a</mi><mrow><mo stretchy="false">(</mo><msup><mi>I</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msup><mmultiscripts><mo stretchy="false">)</mo><mprescripts></mprescripts><mrow></mrow><mo>′</mo></mmultiscripts></mrow></mrow><annotation encoding="application/x-tex">\{P^{\prime}_{i}\}_{i=1}^{K}\leftarrow Camera(I^{re}{{}^{\prime}})</annotation></semantics></math> # estimate poses again using consistent images

</div>
<div id="alg1.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l29.1" class="ltx_text" style="font-size:80%;">29:</span></span>
              
              
             <span id="alg1.l29.3" class="ltx_text ltx_font_bold">Output: the reconstructed 3D scene <math id="alg1.l29.m1" class="ltx_math_unparsed" alttext="Recon(I^{re}{{}^{\prime}},\{P^{\prime}_{i}\}_{i=1}^{K})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mi>e</mi><mi>c</mi><mi>o</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><msup><mi>I</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msup><mmultiscripts><mo>,</mo><mprescripts></mprescripts><mrow></mrow><mo>′</mo></mmultiscripts><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>P</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Recon(I^{re}{{}^{\prime}},\{P^{\prime}_{i}\}_{i=1}^{K})</annotation></semantics></math> </span>

</div>
</div></div></div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">

<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> ThreadPose for Implicit Camera Trajectory</figcaption><div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="alg2.4" class="ltx_p ltx_figure_panel ltx_framed ltx_framed_topbottom"><span id="alg2.4.1" class="ltx_text ltx_font_bold">Input:</span> Poses <math id="alg2.m1" class="ltx_Math" alttext="\{P_{i}\}_{i=1}^{K}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><annotation encoding="application/x-tex">\{P_{i}\}_{i=1}^{K}</annotation></semantics></math>, <math id="alg2.m2" class="ltx_Math" alttext="add\_edge(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">add\_edge(\cdot)</annotation></semantics></math> func to add bidirectional edges, <math id="alg2.m3" class="ltx_Math" alttext="Traverse(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Traverse(\cdot)</annotation></semantics></math> func to traverse the list by edges</p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<div id="alg2.5" class="ltx_listing ltx_figure_panel ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
             Initialize a double linked list <math id="alg2.l1.m1" class="ltx_Math" alttext="\{P^{l}_{i}\}_{i=1}^{L}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>P</mi><mi>i</mi><mi>l</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><annotation encoding="application/x-tex">\{P^{l}_{i}\}_{i=1}^{L}</annotation></semantics></math> with a randomly chosen pose <math id="alg2.l1.m2" class="ltx_Math" alttext="P_{\text{init}}\in\{P_{i}\}_{i=1}^{K}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mtext>init</mtext></msub><mo>∈</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup></mrow><annotation encoding="application/x-tex">P_{\text{init}}\in\{P_{i}\}_{i=1}^{K}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             Set <math id="alg2.l2.m1" class="ltx_Math" alttext="L\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L\leftarrow 1</annotation></semantics></math>, <math id="alg2.l2.m2" class="ltx_Math" alttext="P^{l}_{1}\leftarrow P_{\text{init}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mn>1</mn><mi>l</mi></msubsup><mo stretchy="false">←</mo><msub><mi>P</mi><mtext>init</mtext></msub></mrow><annotation encoding="application/x-tex">P^{l}_{1}\leftarrow P_{\text{init}}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
             <span id="alg2.l3.3" class="ltx_text ltx_font_bold">while</span> <math id="alg2.l3.m1" class="ltx_Math" alttext="\{P_{i}\}_{i=1}^{K}\setminus\{P^{l}_{i}\}_{i=1}^{L}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo>∖</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>P</mi><mi>i</mi><mi>l</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup></mrow><annotation encoding="application/x-tex">\{P_{i}\}_{i=1}^{K}\setminus\{P^{l}_{i}\}_{i=1}^{L}</annotation></semantics></math> is <span id="alg2.l3.4" class="ltx_text ltx_font_bold">not empty</span> <span id="alg2.l3.5" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              Find the pose <math id="alg2.l4.m1" class="ltx_Math" alttext="P_{new}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><annotation encoding="application/x-tex">P_{new}</annotation></semantics></math> with the minimal distance:

<table id="S7.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex1.m1" class="ltx_Math" alttext="P_{new}=\mathop{\arg\min}_{P_{c}\in\{P_{i}\}_{i=1}^{K}\setminus\{P^{l}_{i}\}_{i=1}^{L}}D_{PL}(P_{new},\{P^{l}_{i}\}_{i=1}^{L})" display="block" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>=</mo><mrow><munder><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mi>min</mi></mrow><mrow><msub><mi>P</mi><mi>c</mi></msub><mo>∈</mo><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo>∖</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>P</mi><mi>i</mi><mi>l</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><msub><mi>D</mi><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>P</mi><mi>i</mi><mi>l</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>L</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{new}=\mathop{\arg\min}_{P_{c}\in\{P_{i}\}_{i=1}^{K}\setminus\{P^{l}_{i}\}_{i=1}^{L}}D_{PL}(P_{new},\{P^{l}_{i}\}_{i=1}^{L})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <span id="alg2.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l5.m1" class="ltx_Math" alttext="D_{P}(P_{new},P^{l}_{head})&lt;D_{P}(P_{new},P^{l}_{tail})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>,</mo><msubsup><mi>P</mi><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mi>l</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>D</mi><mi>P</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msub><mo>,</mo><msubsup><mi>P</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mi>l</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{P}(P_{new},P^{l}_{head})&lt;D_{P}(P_{new},P^{l}_{tail})</annotation></semantics></math> <span id="alg2.l5.4" class="ltx_text ltx_font_bold">then</span>



