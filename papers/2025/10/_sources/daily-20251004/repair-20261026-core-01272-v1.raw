              <span id="lstnumberx167.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx167.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">def</span><span id="lstnumberx167.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx167.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">transition</span><span id="lstnumberx167.6" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx167.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">self</span><span id="lstnumberx167.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx167.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx167.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state</span><span id="lstnumberx167.11" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx167.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx167.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">action</span><span id="lstnumberx167.14" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx167.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx167.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">info</span><span id="lstnumberx167.17" class="ltx_text ltx_font_typewriter">):</span>
</div>
<div id="lstnumberx168" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">8</span>
                
                
                
              <span id="lstnumberx168.2" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx168.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">if</span><span id="lstnumberx168.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx168.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state</span><span id="lstnumberx168.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx168.7" class="ltx_text ltx_font_typewriter">==</span><span id="lstnumberx168.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx168.9" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx168.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">explore</span><span id="lstnumberx168.11" class="ltx_text ltx_font_typewriter">’:</span>
</div>
