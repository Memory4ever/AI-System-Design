"ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">storing</span><span id="lstnumberx146.48" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx146.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx146.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter">moving</span><span id="lstnumberx146.53" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter">blocks</span><span id="lstnumberx146.55" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx146.57" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx146.59" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter">strategic</span><span id="lstnumberx146.61" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx146.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter">manner</span><span id="lstnumberx146.63" class="ltx_text ltx_font_typewriter">.</span>
