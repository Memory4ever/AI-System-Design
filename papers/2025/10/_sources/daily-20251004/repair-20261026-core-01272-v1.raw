<tr id="A1.SS10.SSS1.p2.1.10" class="ltx_tr">
<td id="A1.SS10.SSS1.p2.1.10.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t">Maximum number of tokens</td>
<td id="A1.SS10.SSS1.p2.1.10.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A1.SS10.SSS1.p2.1.10.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="A1.SS10.SSS1.p2.1.10.2.1.1" class="ltx_p">The maximum number of tokens the large language model can generate.</span>
</span></td>
<td id="A1.SS10.SSS1.p2.1.10.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">2000</td></tr>
