<td id="A1.SS9.p3.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A1.SS9.p3.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="A1.SS9.p3.1.2.2.1.1" class="ltx_p">The number of agent scripts to sample per epoch.</span>
</span></td>
<td id="A1.SS9.p3.1.2.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">1</td></tr>
<tr id="A1.SS9.p3.1.3" class="ltx_tr">
<td id="A1.SS9.p3.1.3.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t"># Datapoints per Agent</td>
