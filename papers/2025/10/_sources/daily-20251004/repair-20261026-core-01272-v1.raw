<span id="A1.T1.2.2.4.1.1" class="ltx_p">0.202 <math id="A1.T1.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.023</span>
</span></td></tr>
<tr id="A1.T1.2.3" class="ltx_tr">
<th id="A1.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:1pt 4.0pt;">NLLM</th>
<td id="A1.T1.2.3.2" class="ltx_td ltx_align_left" style="padding:1pt 4.0pt;">
<span id="A1.T1.2.3.2.1" class="ltx_inline-block ltx_align_top">
