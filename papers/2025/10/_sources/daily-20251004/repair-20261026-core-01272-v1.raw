              <span id="lstnumberx160.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx160.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">agent</span><span id="lstnumberx160.5" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx160.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx160.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">behavior</span><span id="lstnumberx160.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">pattern</span><span id="lstnumberx160.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">emerges</span><span id="lstnumberx160.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">from</span><span id="lstnumberx160.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx160.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sequence</span><span id="lstnumberx160.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx160.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">actions</span><span id="lstnumberx160.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx160.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">involve</span><span id="lstnumberx160.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">picking</span><span id="lstnumberx160.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">up</span><span id="lstnumberx160.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx160.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">moving</span><span id="lstnumberx160.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">objects</span><span id="lstnumberx160.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx160.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rearrange</span><span id="lstnumberx160.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">them</span><span id="lstnumberx160.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">according</span><span id="lstnumberx160.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx160.47" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter">its</span><span id="lstnumberx160.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx160.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">strategy</span><span id="lstnumberx160.51" class="ltx_text ltx_font_typewriter">.</span>
