<td id="A1.SS10.SSS1.p2.1.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A1.SS10.SSS1.p2.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="A1.SS10.SSS1.p2.1.1.2.1.1" class="ltx_p"><span id="A1.SS10.SSS1.p2.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Purpose</span></span>
</span></td>
<td id="A1.SS10.SSS1.p2.1.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t"><span id="A1.SS10.SSS1.p2.1.1.3.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
