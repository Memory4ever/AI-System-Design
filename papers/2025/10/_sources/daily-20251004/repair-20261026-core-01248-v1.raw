<span id="S5.T5.2.1.1.1.1.1.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S5.T5.m2" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></span>
