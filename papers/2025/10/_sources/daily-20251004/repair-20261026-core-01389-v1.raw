<li class="ltx_tocentry ltx_tocentry_section"><a href="#S8" title="In INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VIII </span><span class="ltx_text ltx_font_smallcaps">Discussion</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S9" title="In INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">IX </span><span class="ltx_text ltx_font_smallcaps">Conclusion</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A1" title="In INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">A </span>Additional Experimental Results</span></a>
<ol class="ltx_toclist ltx_toclist_appendix">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A1.SS1" title="In Appendix A Additional Experimental Results ‣ INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">A-A</span> </span><span class="ltx_text ltx_font_italic">In-Distribution Test Results</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A1.SS2" title="In Appendix A Additional Experimental Results ‣ INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">A-B</span> </span><span class="ltx_text ltx_font_italic">Distribution Shift Test Results</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A1.SS3" title="In Appendix A Additional Experimental Results ‣ INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">A-C</span> </span><span class="ltx_text ltx_font_italic">Large In-Distribution Test Results</span></span></a></li>
