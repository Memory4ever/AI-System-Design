<span id="S6.T2.2.1.1.1.1.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T2.2.1.1.1.1.1.2.6.1" class="ltx_text ltx_font_bold">Geo. adh. (%)<math id="S6.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span>
