<th id="S6.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S6.T3.m1" class="ltx_Math" alttext="\text{PoT}_{F_{1}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_bold">PoT</mtext><msub><mi>F</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\text{PoT}_{F_{1}}</annotation></semantics></math><span id="S6.T3.2.1.2.1" class="ltx_text ltx_font_bold"> <math id="S6.T3.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
