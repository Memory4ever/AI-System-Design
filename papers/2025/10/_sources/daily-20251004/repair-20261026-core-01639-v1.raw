</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 11.55 15.01)"><foreignObject style="--ltx-fo-width:38.08em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="526.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="Ax1.p1.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:38.08em;">
<span id="Ax1.p1.pic1.2.1" class="ltx_listing ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx91" class="ltx_listingline"><span id="lstnumberx91.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">---</span><span id="lstnumberx91.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx91.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">RAW</span><span id="lstnumberx91.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx91.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">ROAD</span><span id="lstnumberx91.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx91.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">NETWORK</span><span id="lstnumberx91.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx91.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">DATA</span><span id="lstnumberx91.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx91.11" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">---</span>
</span>
<span id="lstnumberx92" class="ltx_listingline"><span id="lstnumberx92.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Raw</span><span id="lstnumberx92.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx92.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Road</span><span id="lstnumberx92.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx92.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Network</span><span id="lstnumberx92.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx92.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Data</span><span id="lstnumberx92.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx92.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">(</span><span id="lstnumberx92.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">Full</span><span id="lstnumberx92.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx92.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">OSM</span><span id="lstnumberx92.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx92.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">JSON</span><span id="lstnumberx92.15" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">):</span>
</span>
<span id="lstnumberx93" class="ltx_listingline">
</span>
<span id="lstnumberx94" class="ltx_listingline"><span id="lstnumberx94.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">{</span>
</span>
