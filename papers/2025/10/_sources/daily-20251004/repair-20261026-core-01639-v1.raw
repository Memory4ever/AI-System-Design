<section id="Ax1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix">Raw road network</h2>

<div id="Ax1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="Ax1.p1.pic1" class="ltx_picture" height="54.99" overflow="visible" version="1.1" viewBox="0 0 550 54.99" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.99) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 54.99 L 550 54.99 L 550 0 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 0.69 L 0.69 36.24 L 549.31 36.24 L 549.31 0.69 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 11.55 40.87)"><foreignObject style="--ltx-fo-width:33.11em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="458.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
