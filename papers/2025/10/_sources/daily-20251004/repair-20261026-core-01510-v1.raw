68 -2.14 Z"></path></g></g><g style="--ltx-stroke-color:#50BE50;--ltx-fill-color:#50BE50;" fill="#50BE50" stroke="#50BE50"><path style="fill:none" d="M 116.08 0 L 208.86 0"></path><g style="--ltx-fg-color:#50BE50;" color="#50BE50" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 205.8 0)"><path d="M 7.44 0 L 1.68 2.14 L 3.32 0 L 1.68 -2.14 Z"></path></g></g><g style="--ltx-stroke-color:#50BE50;--ltx-fill-color:#50BE50;" fill="#50BE50" stroke="#50BE50"><path style="fill:none" d="M 226.32 0 L 319.1 0"></path><g style="--ltx-fg-color:#50BE50;" color="#50BE50" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 316.04 0)"><path d="M 7.44 0 L 1.68 2.14 L 3.32 0 L 1.68 -2.14 Z"></path></g></g><g style="--ltx-stroke-color:#50BE50;--ltx-fill-color:#50BE50;" fill="#50BE50" stroke="#50BE50"><g style="--ltx-fg-color:#50BE50;" color="#50BE50" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 0 5.85 C 0 25.2 -3.88 46.5 -16.65 51.15"></path></g><g style="--ltx-fg-color:#50BE50;" color="#50BE50" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.9397 0.34203 -0.34203 -0.9397 -13.78 50.1)"><path d="M 7.44 0 L 1.68 2.14 L 3.32 0 L 1.68 -2.14 Z"></path></g></g><g style="--ltx-stroke-color:#50BE50;--ltx-fill-color:#50BE50;" fill="#50BE50" stroke="#50BE50"><g style="--ltx-fg-color:#50BE50;" color="#50BE50" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -5.85 0 C -25.2 0 -46.5 3.88 -51.15 16.65"></path></g><g style="--ltx-fg-color:#50BE50;" color="#50BE50" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.34203 0.9397 -0.9397 -0.34203 -50.1 13.78)"><path d="M 7.44 0 L 1.68 2.14 L 3.32 0 L 1.68 -2.14 Z"></path></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>An example of a graph from <span id="A1.F5.7" class="ltx_text ltx_font_smallcaps">Petals</span> with <math id="A1.F5.m4" class="ltx_Math" alttext="c=4" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">c=4</annotation></semantics></math>, <math id="A1.F5.m5" class="ltx_Math" alttext="l=2" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">l=2</annotation></semantics></math> and <math id="A1.F5.m6" class="ltx_Math" alttext="t=3" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">t=3</annotation></semantics></math>, and the associated link prediction instances (dashed). The relation types ‘<span id="A1.F5.8" class="ltx_text" style="--ltx-fg-color:#BE5050;">red</span>’, ‘<span id="A1.F5.9" class="ltx_text" style="--ltx-fg-color:#5050BE;">blue</span>’, ‘<span id="A1.F5.10" class="ltx_text" style="--ltx-fg-color:#FF6EBE;">pink</span>’ and ‘<span id="A1.F5.11" class="ltx_text" style="--ltx-fg-color:#FFD705;">yellow</span>’ are structurally isomorphic, hence become equated in the eyes of the existing KGFMs. </figcaption>
</figure>
<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">State-of-the-art knowledge graph foundation models (KGFMs) typically impose relational invariance.
Formally, given two knowledge graphs <math id="A1.p1.m1" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> and <math id="A1.p1.m2" class="ltx_Math" alttext="H=(V^{\prime},E^{\prime},R^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H=(V^{\prime},E^{\prime},R^{\prime})</annotation></semantics></math>, if there exists an isomorphism <math id="A1.p1.m3" class="ltx_Math" alttext="(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\pi,\phi)</annotation></semantics></math> from <math id="A1.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> to <math id="A1.p1.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, then for any <math id="A1.p1.m6" class="ltx_Math" alttext="r\in R" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">r\in R</annotation></semantics></math>, the model enforces identical representations for <math id="A1.p1.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and its image <math id="A1.p1.m8" class="ltx_Math" alttext="\phi(r)\in R^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>R</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\phi(r)\in R^{\prime}</annotation></semantics></math>.
This design promotes generalization across different graphs, as it aligns analogous relations, but reduces expressivity within a single graph (<math id="A1.p1.m9" class="ltx_Math" alttext="G=H" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">G=H</annotation></semantics></math>), where relations related by automorphisms are forced to be indistinguishable.
Concretely, if an automorphism <math id="A1.p1.m10" class="ltx_Math" alttext="(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\pi,\phi)</annotation></semantics></math> of <math id="A1.p1.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> maps <math id="A1.p1.m12" class="ltx_Math" alttext="r_{1}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>1</mn></msub><annotation encoding="application/x-tex">r_{1}</annotation></semantics></math> to <math id="A1.p1.m13" class="ltx_Math" alttext="r_{2}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>2</mn></msub><annotation encoding="application/x-tex">r_{2}</annotation></semantics></math>, then the model must treat <math id="A1.p1.m14" class="ltx_Math" alttext="r_{1}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>1</mn></msub><annotation encoding="application/x-tex">r_{1}</annotation></semantics></math> and <math id="A1.p1.m15" class="ltx_Math" alttext="r_{2}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>2</mn></msub><annotation encoding="application/x-tex">r_{2}</annotation></semantics></math> as identical during inference.
While some approaches mitigate this limitation via the labeling trick, assigning distinct embeddings to query-specific nodes and relations, this only isolates the queried relation type and does not resolve the underlying issue in general.</p>
</div>
<div id="A1.p2" class="ltx_para ltx_noindent">
<p id="A1.p2.1" class="ltx_p">Motivated by this limitation, we introduce the <span id="A1.p2.1.1" class="ltx_text ltx_font_smallcaps">Petals</span> benchmark.
<span id="A1.p2.1.2" class="ltx_text ltx_font_smallcaps">Petals</span> comprises 220 graphs, each paired with a link prediction query <math id="A1.p2.m1" class="ltx_Math" alttext="(h,r,?)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(h,r,?)</annotation></semantics></math> and a target set <math id="A1.p2.m2" class="ltx_Math" alttext="\{t_{1},t_{2}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{t_{1},t_{2}\}</annotation></semantics></math>.
While <math id="A1.p2.m3" class="ltx_Math" alttext="t_{1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>1</mn></msub><annotation encoding="application/x-tex">t_{1}</annotation></semantics></math> and <math id="A1.p2.m4" class="ltx_Math" alttext="t_{2}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>2</mn></msub><annotation encoding="application/x-tex">t_{2}</annotation></semantics></math> are non-isomorphic, KGFMs enforcing relational invariance are unable to distinguish them, producing identical predictions.
We empirically validate this property by evaluating the classification accuracy of marking <math id="A1.p2.m5" class="ltx_Math" alttext="t_{1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>1</mn></msub><annotation encoding="application/x-tex">t_{1}</annotation></semantics></math> as <span id="A1.p2.1.3" class="ltx_text ltx_font_smallcaps">true</span> and <math id="A1.p2.m6" class="ltx_Math" alttext="t_{2}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>2</mn></msub><annotation encoding="application/x-tex">t_{2}</annotation></semantics></math> as <span id="A1.p2.1.4" class="ltx_text ltx_font_smallcaps">false</span>, reported in <a href="#S5.T1" title="In 5.1 Synthetic datasets experiments ‣ 5 Experiments ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Structure of the studied KGs</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">Knowledge graphs in <span id="A1.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">Petals</span> follow a flower-like structure, parametrized by the number <math id="A1.SS1.p1.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> of ‘petals’, their length <math id="A1.SS1.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> and the length <math id="A1.SS1.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> of the ‘stem’ (see <a href="#A1.F5" title="In Appendix A Details of the Petals benchmark ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">5</span></a> for visualization).</p>
</div>
<div id="A1.SS1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS1.p2.1" class="ltx_p"><span id="A1.SS1.p2.1.1" class="ltx_text ltx_font_bold">Vertices. </span>
Each ‘petal’ is a set <math id="A1.SS1.p2.m1" class="ltx_Math" alttext="A^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">A^{(i)}</annotation></semantics></math> of <math id="A1.SS1.p2.m2" class="ltx_Math" alttext="2l+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2l+1</annotation></semantics></math> vertices <math id="A1.SS1.p2.m3" class="ltx_Math" alttext="A^{(i)}=\left\{a_{1}^{(i)},a_{2}^{(i)},\dots,a_{2l+1}^{(i)}\right\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mo>{</mo><mrow><msubsup><mi>a</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">A^{(i)}=\left\{a_{1}^{(i)},a_{2}^{(i)},\dots,a_{2l+1}^{(i)}\right\}</annotation></semantics></math>, while the stem <math id="A1.SS1.p2.m4" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> consists of <math id="A1.SS1.p2.m5" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math> nodes <math id="A1.SS1.p2.m6" class="ltx_Math" alttext="B=\{b_{0},b_{1},\dots,b_{t}\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>b</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B=\{b_{0},b_{1},\dots,b_{t}\}</annotation></semantics></math>.
The full set of entities is then:</p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_math_unparsed" alttext="V=B\cup\bigcup_{i=1}^{c}A(i)=\{b_{0},b_{1},\dots,b_{t}\}\cup\left\{a_{j}^{(i)}\mid 1\leq i\leq c,1\leq j\leq 2l+1\right\}" display="block" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mi>B</mi><mo rspace="0.055em">∪</mo><munderover><mo movablelimits="false">⋃</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>b</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo>{</mo><msubsup><mi>a</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>c</mi><mo>,</mo><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>2</mn><mi>l</mi><mo>+</mo><mn>1</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">V=B\cup\bigcup_{i=1}^{c}A(i)=\{b_{0},b_{1},\dots,b_{t}\}\cup\left\{a_{j}^{(i)}\mid 1\leq i\leq c,1\leq j\leq 2l+1\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.2" class="ltx_p">We call <math id="A1.SS1.p2.m7" class="ltx_Math" alttext="b_{0}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mn>0</mn></msub><annotation encoding="application/x-tex">b_{0}</annotation></semantics></math> the ‘central’ node, as it is connected to every petal, as described below.</p>
</div>
<div id="A1.SS1.p3" class="ltx_para ltx_noindent">
<p id="A1.SS1.p3.1" class="ltx_p"><span id="A1.SS1.p3.1.1" class="ltx_text ltx_font_bold">Edges. </span>
The nodes of the stem are connected in a consecutive manner by the same relation type <math id="A1.SS1.p3.m1" class="ltx_Math" alttext="r_{0}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>0</mn></msub><annotation encoding="application/x-tex">r_{0}</annotation></semantics></math>.
Precisely, for each <math id="A1.SS1.p3.m2" class="ltx_Math" alttext="i\in{1,\cdots,t}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">i\in{1,\cdots,t}</annotation></semantics></math>, there exists an edge <math id="A1.SS1.p3.m3" class="ltx_Math" alttext="(b_{i-1},r_{0},b_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b_{i-1},r_{0},b_{i})</annotation></semantics></math>.
Each petal <math id="A1.SS1.p3.m4" class="ltx_Math" alttext="A^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">A^{(i)}</annotation></semantics></math> is associated with two edge types <math id="A1.SS1.p3.m5" class="ltx_Math" alttext="r^{(i)}_{1},r^{(i)}_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">r^{(i)}_{1},r^{(i)}_{2}</annotation></semantics></math>, and is connected to the central node <math id="A1.SS1.p3.m6" class="ltx_Math" alttext="b_{0}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mn>0</mn></msub><annotation encoding="application/x-tex">b_{0}</annotation></semantics></math> with links <math id="A1.SS1.p3.m7" class="ltx_Math" alttext="\!\left(b_{0},r^{(i)}_{1},a_{1}^{(i)}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><annotation encoding="application/x-tex">\!\left(b_{0},r^{(i)}_{1},a_{1}^{(i)}\right)</annotation></semantics></math> and <math id="A1.SS1.p3.m8" class="ltx_Math" alttext="\!\left(b_{0},r^{(i)}_{2},a_{2}^{(i)}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>r</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><annotation encoding="application/x-tex">\!\left(b_{0},r^{(i)}_{2},a_{2}^{(i)}\right)</annotation></semantics></math>. The rest of the petal is connected with edges of type <math id="A1.SS1.p3.m9" class="ltx_Math" alttext="r_{1}^{(i)}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">r_{1}^{(i)}</annotation></semantics></math> only, going from <math id="A1.SS1.p3.m10" class="ltx_Math" alttext="a^{(i)}_{2j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2j-1}</annotation></semantics></math> to <math id="A1.SS1.p3.m11" class="ltx_Math" alttext="a^{(i)}_{2j+1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2j+1}</annotation></semantics></math>, and from <math id="A1.SS1.p3.m12" class="ltx_Math" alttext="a^{(i)}_{2j}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2j}</annotation></semantics></math> to <math id="A1.SS1.p3.m13" class="ltx_Math" alttext="a^{(i)}_{2j+2}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2j+2}</annotation></semantics></math>. Finally, there are also edges linking <math id="A1.SS1.p3.m14" class="ltx_Math" alttext="a^{(i)}_{2l-1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2l-1}</annotation></semantics></math> and <math id="A1.SS1.p3.m15" class="ltx_Math" alttext="a^{(i)}_{2l}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2l}</annotation></semantics></math> to <math id="A1.SS1.p3.m16" class="ltx_Math" alttext="a^{(i)}_{2l+1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2l+1}</annotation></semantics></math>.
Therefore, the full set of edges can be characterized as:</p>
<table id="A1.Ex5" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A1.Ex5X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex5X.m2" class="ltx_Math" alttext="\displaystyle E=\left(\{(b_{i-1},r_{0},b_{i})\mid 1\leq i\leq t\}\right)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><mo>(</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle E=\left(\{(b_{i-1},r_{0},b_{i})\mid 1\leq i\leq t\}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5X.m3" class="ltx_Math" alttext="\displaystyle\cup\left(\bigcup_{i=1}^{c}\left\{(b_{0},r^{(i)}_{1},a^{(i)}_{1}),(b_{0},r^{(i)}_{2},a^{(i)}_{2})\right\}\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∪</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⋃</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>r</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cup\left(\bigcup_{i=1}^{c}\left\{(b_{0},r^{(i)}_{1},a^{(i)}_{1}),(b_{0},r^{(i)}_{2},a^{(i)}_{2})\right\}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex5Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5Xa.m2" class="ltx_Math" alttext="\displaystyle\cup\left(\bigcup_{i=1}^{c}\bigcup_{j=1}^{l-1}\left\{\!\left(a^{(i)}_{2j-1},r^{(i)}_{1},a^{(i)}_{2j+1}\right),\!\left(a^{(i)}_{2j},r^{(i)}_{1},a^{(i)}_{2j+2}\right)\right\}\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∪</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⋃</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⋃</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>{</mo><mrow><mo>(</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mpadded style="width:0.275em;" width="0.275em"><mo>,</mo></mpadded><mrow><mo>(</mo><msubsup><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>}</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cup\left(\bigcup_{i=1}^{c}\bigcup_{j=1}^{l-1}\left\{\!\left(a^{(i)}_{2j-1},r^{(i)}_{1},a^{(i)}_{2j+1}\right),\!\left(a^{(i)}_{2j},r^{(i)}_{1},a^{(i)}_{2j+2}\right)\right\}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex5Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5Xb.m2" class="ltx_Math" alttext="\displaystyle\cup\left(\bigcup_{i=1}^{c}\left\{\!\left(a^{(i)}_{2l-1},r^{(i)}_{1},a^{(i)}_{2l+1}\right),\!\left(a^{(i)}_{2l},r^{(i)}_{1},a^{(i)}_{2l+1}\right)\right\}\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∪</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⋃</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>c</mi></munderover></mstyle><mrow><mo>{</mo><mrow><mo>(</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mpadded style="width:0.275em;" width="0.275em"><mo>,</mo></mpadded><mrow><mo>(</mo><msubsup><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>}</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cup\left(\bigcup_{i=1}^{c}\left\{\!\left(a^{(i)}_{2l-1},r^{(i)}_{1},a^{(i)}_{2l+1}\right),\!\left(a^{(i)}_{2l},r^{(i)}_{1},a^{(i)}_{2l+1}\right)\right\}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS1.p4" class="ltx_para ltx_noindent">
<p id="A1.SS1.p4.1" class="ltx_p">We select each of the types <math id="A1.SS1.p4.m1" class="ltx_Math" alttext="r^{(i)}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">r^{(i)}_{1}</annotation></semantics></math> and <math id="A1.SS1.p4.m2" class="ltx_Math" alttext="r^{(i)}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">r^{(i)}_{2}</annotation></semantics></math> from the set of considered relations <math id="A1.SS1.p4.m3" class="ltx_Math" alttext="R=\{r_{1},\dots,r_{|R|}\}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mrow><mo stretchy="false">|</mo><mi>R</mi><mo stretchy="false">|</mo></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">R=\{r_{1},\dots,r_{|R|}\}</annotation></semantics></math> so that any relation-invariant model will equate all petals (i.e. so that for each pair of petals, there is an automorphism taking one to another).
For instance, <a href="#A1.F5" title="In Appendix A Details of the Petals benchmark ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">5</span></a> displays a cyclic pattern, in which <math id="A1.SS1.p4.m4" class="ltx_Math" alttext="r^{(i)}_{2}=r^{(i+1)}_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>r</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">r^{(i)}_{2}=r^{(i+1)}_{1}</annotation></semantics></math>.
Such symmetry causes all petals to be isomorphic, and leads to the inability of KGFMs to distinguish between the relations inside them.</p>
</div>
<div id="A1.SS1.p5" class="ltx_para ltx_noindent">
<p id="A1.SS1.p5.1" class="ltx_p"><span id="A1.SS1.p5.1.1" class="ltx_text ltx_font_bold">Link prediction instances. </span>
Although the petals are isomorphic to each other, given the asymmetry of edge types from <math id="A1.SS1.p5.m1" class="ltx_Math" alttext="b_{0}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mn>0</mn></msub><annotation encoding="application/x-tex">b_{0}</annotation></semantics></math> to <math id="A1.SS1.p5.m2" class="ltx_Math" alttext="a^{(i)}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{1}</annotation></semantics></math> and <math id="A1.SS1.p5.m3" class="ltx_Math" alttext="a^{(i)}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2}</annotation></semantics></math>, the nodes within a single petal generally can be distinguished.
Therefore, for each graph with the structure as described above, we randomly sample one of the stem nodes <math id="A1.SS1.p5.m4" class="ltx_Math" alttext="b_{s}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>s</mi></msub><annotation encoding="application/x-tex">b_{s}</annotation></semantics></math>, and ask the link prediction query <math id="A1.SS1.p5.m5" class="ltx_Math" alttext="(b_{s},r_{0},?)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mi>s</mi></msub><mo>,</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b_{s},r_{0},?)</annotation></semantics></math>.
For the target nodes, we randomly select petal index <math id="A1.SS1.p5.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and distance <math id="A1.SS1.p5.m7" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> from the central node <math id="A1.SS1.p5.m8" class="ltx_Math" alttext="b_{0}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mn>0</mn></msub><annotation encoding="application/x-tex">b_{0}</annotation></semantics></math>, and consider the predictions for <math id="A1.SS1.p5.m9" class="ltx_Math" alttext="a^{(i)}_{2j-1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2j-1}</annotation></semantics></math> and <math id="A1.SS1.p5.m10" class="ltx_Math" alttext="a^{(i)}_{2j}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(i)}_{2j}</annotation></semantics></math>.
For example, <a href="#A1.F5" title="In Appendix A Details of the Petals benchmark ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">5</span></a> shows the case when <math id="A1.SS1.p5.m11" class="ltx_Math" alttext="b_{s}=b_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>s</mi></msub><mo>=</mo><msub><mi>b</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">b_{s}=b_{0}</annotation></semantics></math>, <math id="A1.SS1.p5.m12" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> and <math id="A1.SS1.p5.m13" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math>, where the query is <math id="A1.SS1.p5.m14" class="ltx_Math" alttext="(b_{0},r_{0},?)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b_{0},r_{0},?)</annotation></semantics></math> and we are interested in the scores for <math id="A1.SS1.p5.m15" class="ltx_Math" alttext="a^{(1)}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(1)}_{1}</annotation></semantics></math> and <math id="A1.SS1.p5.m16" class="ltx_Math" alttext="a^{(1)}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>a</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">a^{(1)}_{2}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Parameters and generation</h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p">We construct <span id="A1.SS2.p1.1.1" class="ltx_text ltx_font_smallcaps">Petals</span> by manually designing 11 relation-assignment schemes that guarantee isomorphism across all petals.
For each such selection, which already determines the number <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> of petals, we generate 20 graphs corresponding to all combinations of <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="t\in\{1,2,3,4\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{1,2,3,4\}</annotation></semantics></math> and <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="l\in\{1,2,3,4,5\}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">l\in\{1,2,3,4,5\}</annotation></semantics></math>.
Each graph is paired with a link prediction query and two target nodes, sampled as described above.
This yields <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="11\cdot 20=220" display="inline" intent=":literal"><semantics><mrow><mrow><mn>11</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>20</mn></mrow><mo>=</mo><mn>220</mn></mrow><annotation encoding="application/x-tex">11\cdot 20=220</annotation></semantics></math> instances that constitute the <span id="A1.SS2.p1.1.2" class="ltx_text ltx_font_smallcaps">Petals</span> benchmark.</p>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Methodology - details</h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">In this section, we expand on the descriptions of individual components of <span id="A2.p1.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> summarized in <a href="#S4" title="4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a>: the random walk algorithm, the recording protocol, the sequence processor, and the consensus protocol.</p>
</div>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Uniform random walk</h3>

<div id="A2.SS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS1.p1.2" class="ltx_p">Let <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> be a knowledge graph, and let <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> be the length of random walks.
For each node <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, we will denote by <math id="A2.SS1.p1.m4" class="ltx_Math" alttext="\mathcal{N}(v)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(v)</annotation></semantics></math> the set of neighbors of <math id="A2.SS1.p1.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>:</p>
<table id="A2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex6.m1" class="ltx_math_unparsed" alttext="\mathcal{N}(v)=\{w\in V:\exists r\in R.(v,r,w)\in E\lor(w,r,v)\in E\}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo>∈</mo><mi>V</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mo rspace="0.167em">∃</mo><mi>r</mi><mo>∈</mo><mi>R</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi><mo>∨</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(v)=\{w\in V:\exists r\in R.(v,r,w)\in E\lor(w,r,v)\in E\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.3" class="ltx_p">and by <math id="A2.SS1.p1.m6" class="ltx_Math" alttext="E{(v,w)}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E{(v,w)}</annotation></semantics></math>, the set of relational edges from <math id="A2.SS1.p1.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> to <math id="A2.SS1.p1.m8" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> (allowing for the inverse direction):</p>
<table id="A2.Ex7" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex7X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex7X.m2" class="ltx_Math" alttext="\displaystyle E{(v,w)}=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle E{(v,w)}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex7X.m3" class="ltx_Math" alttext="\displaystyle\{(v,r,w)\in R\times\{v\}\times\{w\}:(v,r,w)\in E\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo rspace="0.278em" stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{(v,r,w)\in R\times\{v\}\times\{w\}:(v,r,w)\in E\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex7Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex7Xa.m2" class="ltx_Math" alttext="\displaystyle\cup\{(v,r^{-1},w)\in R^{-1}\times\{v\}\times\{w\}:(w,r,v)\in E\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∪</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><msup><mi>r</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo rspace="0.278em" stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cup\{(v,r^{-1},w)\in R^{-1}\times\{v\}\times\{w\}:(w,r,v)\in E\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.4" class="ltx_p">where <math id="A2.SS1.p1.m9" class="ltx_Math" alttext="R^{-1}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">R^{-1}</annotation></semantics></math> is the set symbolizing the inverses of relation types in <math id="A2.SS1.p1.m10" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>.
The uniform random walk with no backtracking <math id="A2.SS1.p1.m11" class="ltx_Math" alttext="\eta(G,l)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta(G,l)</annotation></semantics></math> of length <math id="A2.SS1.p1.m12" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> over <math id="A2.SS1.p1.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, represented as:</p>
<table id="A2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex8.m1" class="ltx_Math" alttext="V_{0}\xrightarrow{R_{1}}V_{1}\xrightarrow{R_{2}}\cdots\xrightarrow{R_{l}}V_{l}" display="block" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>V</mi><mn>1</mn></msub><mover accent="true"><mo rspace="0.1389em">→</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">2</mn></msub></mover><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mover accent="true"><mo lspace="0.1389em">→</mo><msub><mi mathsize="0.700em">R</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>V</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">V_{0}\xrightarrow{R_{1}}V_{1}\xrightarrow{R_{2}}\cdots\xrightarrow{R_{l}}V_{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p1.5" class="ltx_p">is a second-order Markov process that follows the rules:</p>
<table id="A2.E8" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E8X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E8X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(V_{i+2}=v\mid V_{i+1}=w,V_{i}=u)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mi>v</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>w</mi></mrow><mo>,</mo><mrow><msub><mi>V</mi><mi>i</mi></msub><mo>=</mo><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(V_{i+2}=v\mid V_{i+1}=w,V_{i}=u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E8X.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}0&amp;\text{if }v=u\text{ and }|\mathcal{N}_{w}|&gt;1\\
1&amp;\text{if }v=u\text{ and }\mathcal{N}_{w}=\{u\}\\
\frac{1}{|\mathcal{N}_{w}|-1}&amp;\text{if }v\neq u\text{ and }v\in\mathcal{N}_{w}\\
0&amp;\text{if }v\notin\mathcal{N}_{w}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>u</mi><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>≠</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}0&amp;\text{if }v=u\text{ and }|\mathcal{N}_{w}|&gt;1\\
1&amp;\text{if }v=u\text{ and }\mathcal{N}_{w}=\{u\}\\
\frac{1}{|\mathcal{N}_{w}|-1}&amp;\text{if }v\neq u\text{ and }v\in\mathcal{N}_{w}\\
0&amp;\text{if }v\notin\mathcal{N}_{w}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(8)</span></td></tr>
<tr id="A2.E8Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E8Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(R_{j+1}=r\mid V_{j+1}=w,V_{j}=u)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>r</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>V</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>w</mi></mrow><mo>,</mo><mrow><msub><mi>V</mi><mi>j</mi></msub><mo>=</mo><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(R_{j+1}=r\mid V_{j+1}=w,V_{j}=u)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E8Xa.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|E_{(w,u)}|}&amp;\text{if }r(w,u)\in E_{(w,u)}\\
0&amp;\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo mathsize="0.700em">,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|E_{(w,u)}|}&amp;\text{if }r(w,u)\in E_{(w,u)}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS1.p2.1" class="ltx_p">for all <math id="A2.SS1.p2.m1" class="ltx_Math" alttext="i\geq 0,j\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\geq 0,j\geq 1</annotation></semantics></math>. Intuitively, at each step of the walk, we first select a neighbor (except for the vertex chosen one step ago) of the current node uniformly at random (disregarding multi-edges and edge directions), and then sample an edge between these two nodes uniformly at random. If the current node has only one neighbor, we are forced to return to it.</p>
</div>
<div id="A2.SS1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS1.p3.1" class="ltx_p">The initial conditions depend on the selected scenario.
Given a query <math id="A2.SS1.p3.m1" class="ltx_Math" alttext="q=(h,r,?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h,r,?)</annotation></semantics></math> over <math id="A2.SS1.p3.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, we can describe the process of selecting the first step <math id="A2.SS1.p3.m3" class="ltx_Math" alttext="V_{0}\xrightarrow{R_{1}}V_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>V</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">V_{0}\xrightarrow{R_{1}}V_{1}</annotation></semantics></math> as setting either (each with probability <math id="A2.SS1.p3.m4" class="ltx_Math" alttext="\frac{1}{3}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{3}</annotation></semantics></math>):</p>
</div>
<div id="A2.SS1.p4" class="ltx_para ltx_noindent">
<ul id="A2.I1" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I1.i1.p1.1" class="ltx_p"><math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="V_{0}=h" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">V_{0}=h</annotation></semantics></math> and selecting the first step uniformly at random as described above, meaning:</p>
<table id="A2.Ex9" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex9X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex9X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(V_{1}=v\mid V_{0}=h)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mi>v</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(V_{1}=v\mid V_{0}=h)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex9X.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{h}|}&amp;\text{if }v\in\mathcal{N}_{h}\\
0&amp;\text{if }v\notin\mathcal{N}_{h}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>h</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>h</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>h</mi></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{h}|}&amp;\text{if }v\in\mathcal{N}_{h}\\
0&amp;\text{if }v\notin\mathcal{N}_{h}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex9Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex9Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(R_{1}=r\mid V_{1}=w)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mi>r</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(R_{1}=r\mid V_{1}=w)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex9Xa.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|E_{(w,h)}|}&amp;\text{if }r(w,h)\in E_{(w,h)}\\
0&amp;\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo mathsize="0.700em">,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|E_{(w,h)}|}&amp;\text{if }r(w,h)\in E_{(w,h)}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I1.i2.p1.1" class="ltx_p">setting <math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="R_{1}=r" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">R_{1}=r</annotation></semantics></math> and selecting <math id="A2.I1.i2.p1.m2" class="ltx_Math" alttext="V_{0}\xrightarrow{R_{1}}V_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>V</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">V_{0}\xrightarrow{R_{1}}V_{1}</annotation></semantics></math> uniformly at random from edges with type <math id="A2.I1.i2.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I1.i3.p1.1" class="ltx_p">choosing <math id="A2.I1.i3.p1.m1" class="ltx_Math" alttext="V_{0}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>0</mn></msub><annotation encoding="application/x-tex">V_{0}</annotation></semantics></math> uniformly at random, and then sampling the first step at random as well:</p>
<table id="A2.Ex10" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex10X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex10X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(V_{0}=w)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(V_{0}=w)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10X.m3" class="ltx_Math" alttext="\displaystyle=\frac{1}{|V|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{|V|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex10Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex10Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(V_{1}=w\mid V_{0}=v)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mi>w</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(V_{1}=w\mid V_{0}=v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10Xa.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{w}|}&amp;\text{if }v\in\mathcal{N}_{w}\\
0&amp;\text{if }v\notin\mathcal{N}_{w}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>w</mi></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{w}|}&amp;\text{if }v\in\mathcal{N}_{w}\\
0&amp;\text{if }v\notin\mathcal{N}_{w}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex10Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex10Xb.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(R_{1}=r\mid V_{1}=v,V_{0}=w)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mi>r</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mi>v</mi></mrow><mo>,</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>w</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(R_{1}=r\mid V_{1}=v,V_{0}=w)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex10Xb.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|E_{(w,v)}|}&amp;\text{if }r(w,v)\in E_{(w,v)}\\
0&amp;\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo mathsize="0.700em">,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|E_{(w,v)}|}&amp;\text{if }r(w,v)\in E_{(w,v)}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="A2.SS1.p5" class="ltx_para ltx_noindent">
<p id="A2.SS1.p5.1" class="ltx_p">For the relation prediction objective, we add one more scenario, similar to the first one described above, but substituting <math id="A2.SS1.p5.m1" class="ltx_Math" alttext="V_{0}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">V_{0}=t</annotation></semantics></math> instead.
For that problem, each scenario is chosen with probability <math id="A2.SS1.p5.m2" class="ltx_Math" alttext="\frac{1}{4}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>4</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{4}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Recording function</h3>

<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p">Given a KG <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math>, a query <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="q=(h_{q},r_{q},?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>q</mi></msub><mo>,</mo><msub><mi>r</mi><mi>q</mi></msub><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h_{q},r_{q},?)</annotation></semantics></math>, a walk <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="\bar{\eta}=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>v</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">\bar{\eta}=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}</annotation></semantics></math> of length <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> over <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, and a set of embeddings <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\mathbf{v}" display="inline" intent=":literal"><semantics><mi>𝐯</mi><annotation encoding="application/x-tex">\mathbf{v}</annotation></semantics></math> of nodes <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> and <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="\mathbf{r}" display="inline" intent=":literal"><semantics><mi>𝐫</mi><annotation encoding="application/x-tex">\mathbf{r}</annotation></semantics></math> of relations <math id="A2.SS2.p1.m9" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, our recording function <math id="A2.SS2.p1.m10" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> first splits the walk into a sequence of <math id="A2.SS2.p1.m11" class="ltx_Math" alttext="l+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l+1</annotation></semantics></math> steps:</p>
<table id="A2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex11.m1" class="ltx_Math" alttext="(r_{0},v_{0}),(r_{1},v_{1}),\dots(r_{l},v_{l})" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>l</mi></msub><mo>,</mo><msub><mi>v</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(r_{0},v_{0}),(r_{1},v_{1}),\dots(r_{l},v_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p">with <math id="A2.SS2.p1.m12" class="ltx_Math" alttext="r_{0}=r_{\varnothing}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>=</mo><msub><mi>r</mi><mi mathvariant="normal">∅</mi></msub></mrow><annotation encoding="application/x-tex">r_{0}=r_{\varnothing}</annotation></semantics></math> being a special marker for no relation. Each step <math id="A2.SS2.p1.m13" class="ltx_Math" alttext="(r_{i},v_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>,</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{i},v_{i})</annotation></semantics></math> is transformed into a 7-tuple:</p>
<table id="A2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex12.m1" class="ltx_Math" alttext="S_{i}=\left(\operatorname{id}_{V}(v_{i};\bar{\eta}),\operatorname{id}_{R}(r_{i};\bar{\eta}),\operatorname{dir}_{i},\delta_{v_{i}=h_{q}},\delta_{r_{i}=r_{q}},\mathbf{v}(v_{i}),\mathbf{r}(r_{i})\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>(</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>dir</mi><mi>i</mi></msub><mo>,</mo><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><mo>,</mo><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><mo>,</mo><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{i}=\left(\operatorname{id}_{V}(v_{i};\bar{\eta}),\operatorname{id}_{R}(r_{i};\bar{\eta}),\operatorname{dir}_{i},\delta_{v_{i}=h_{q}},\delta_{r_{i}=r_{q}},\mathbf{v}(v_{i}),\mathbf{r}(r_{i})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.3" class="ltx_p">where:</p>
<ul id="A2.I2" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i1.p1.1" class="ltx_p"><math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="\operatorname{id}_{V}(v_{i};\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{id}_{V}(v_{i};\bar{\eta})</annotation></semantics></math> and <math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="\operatorname{id}_{R}(r_{i};\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{id}_{R}(r_{i};\bar{\eta})</annotation></semantics></math> are the anonymized id’s of the node <math id="A2.I2.i1.p1.m3" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> and relation <math id="A2.I2.i1.p1.m4" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, evaluated as:</p>
<table id="A2.Ex13" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex13X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex13X.m2" class="ltx_Math" alttext="\displaystyle\operatorname{id}_{V}(v_{i};\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{id}_{V}(v_{i};\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13X.m3" class="ltx_Math" alttext="\displaystyle=\argmin_{t}[v_{t}=v_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">[</mo><mi>v</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mi>v</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\argmin_{t}[v_{t}=v_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex13Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex13Xa.m2" class="ltx_Math" alttext="\displaystyle\operatorname{id}_{R}(r_{i};\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{id}_{R}(r_{i};\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex13Xa.m3" class="ltx_Math" alttext="\displaystyle=\argmin_{t}\left[r_{t}=r_{i}\lor r_{t}=r_{i}^{-1}\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><msub><mrow></mrow><mi>t</mi></msub><mo>[</mo><mi>r</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∨</mo><mi>r</mi><msub><mrow></mrow><mi>t</mi></msub><mo>=</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\argmin_{t}\left[r_{t}=r_{i}\lor r_{t}=r_{i}^{-1}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i2.p1.1" class="ltx_p"><math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="\operatorname{dir}_{i}" display="inline" intent=":literal"><semantics><msub><mi>dir</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\operatorname{dir}_{i}</annotation></semantics></math> denotes the direction in which we follow the edge. We set <math id="A2.I2.i2.p1.m2" class="ltx_Math" alttext="\operatorname{dir}_{i}\!=\!0" display="inline" intent=":literal"><semantics><mrow><msub><mi>dir</mi><mi>i</mi></msub><mo lspace="0.108em">=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{dir}_{i}\!=\!0</annotation></semantics></math> if <math id="A2.I2.i2.p1.m3" class="ltx_Math" alttext="r_{i}\!\in\!R" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0.108em" rspace="0.108em">∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">r_{i}\!\in\!R</annotation></semantics></math> (the edge is traversed from head to tail) and <math id="A2.I2.i2.p1.m4" class="ltx_Math" alttext="\operatorname{dir}_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>dir</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\operatorname{dir}_{i}=1</annotation></semantics></math> if <math id="A2.I2.i2.p1.m5" class="ltx_Math" alttext="r_{i}\in R^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>∈</mo><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">r_{i}\in R^{-1}</annotation></semantics></math> (the edge is taken in the reverse direction).</p>
</div></li>
<li id="A2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i3.p1.1" class="ltx_p"><math id="A2.I2.i3.p1.m1" class="ltx_Math" alttext="\delta_{v_{i}=h_{q}}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><annotation encoding="application/x-tex">\delta_{v_{i}=h_{q}}</annotation></semantics></math> and <math id="A2.I2.i3.p1.m2" class="ltx_Math" alttext="\delta_{r_{i}\sim r_{q}}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><annotation encoding="application/x-tex">\delta_{r_{i}\sim r_{q}}</annotation></semantics></math> are binary flags representing whether the current node <math id="A2.I2.i3.p1.m3" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> is the query head <math id="A2.I2.i3.p1.m4" class="ltx_Math" alttext="v_{q}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>q</mi></msub><annotation encoding="application/x-tex">v_{q}</annotation></semantics></math> and if the relation <math id="A2.I2.i3.p1.m5" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> is either the queried relation <math id="A2.I2.i3.p1.m6" class="ltx_Math" alttext="r_{q}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>q</mi></msub><annotation encoding="application/x-tex">r_{q}</annotation></semantics></math> or its inverse <math id="A2.I2.i3.p1.m7" class="ltx_Math" alttext="r_{q}^{-1}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mi>q</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">r_{q}^{-1}</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i4.p1" class="ltx_para">
<p id="A2.I2.i4.p1.1" class="ltx_p"><math id="A2.I2.i4.p1.m1" class="ltx_Math" alttext="\mathbf{v}(v_{i}),\mathbf{r}(r_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}(v_{i}),\mathbf{r}(r_{i})</annotation></semantics></math> are the embeddings of <math id="A2.I2.i4.p1.m2" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> and <math id="A2.I2.i4.p1.m3" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math>, respectively.</p>
</div></li>
</ul>
<p id="A2.SS2.p1.4" class="ltx_p">The output of <math id="A2.SS2.p1.m14" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> for <math id="A2.SS2.p1.m15" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> given <math id="A2.SS2.p1.m16" class="ltx_Math" alttext="G,q,\mathbf{v},\mathbf{r}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>𝐯</mi><mo>,</mo><mi>𝐫</mi></mrow><annotation encoding="application/x-tex">G,q,\mathbf{v},\mathbf{r}</annotation></semantics></math> is then:</p>
<table id="A2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex14.m1" class="ltx_Math" alttext="w(\bar{\eta};G,q,\mathbf{v},\mathbf{r})=(S_{0},S_{1},\dots,S_{l})" display="block" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>,</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>𝐯</mi><mo>,</mo><mi>𝐫</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mn>0</mn></msub><mo>,</mo><msub><mi>S</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>S</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(\bar{\eta};G,q,\mathbf{v},\mathbf{r})=(S_{0},S_{1},\dots,S_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Sequence processor</h3>

<div id="A2.SS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.p1.1" class="ltx_p">Once the sampled walks are anonymized by the recording protocol <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, the output for each walk <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="\bar{\eta}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\bar{\eta}_{i}</annotation></semantics></math>:</p>
<table id="A2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex15.m1" class="ltx_Math" alttext="w(\bar{\eta};G,q,\mathbf{v},\mathbf{r})=(S_{0},S_{1},\dots,S_{l})" display="block" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>,</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>𝐯</mi><mo>,</mo><mi>𝐫</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mn>0</mn></msub><mo>,</mo><msub><mi>S</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>S</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(\bar{\eta};G,q,\mathbf{v},\mathbf{r})=(S_{0},S_{1},\dots,S_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p">is passed through the sequence processor <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math>, parametrized by the following modules:</p>
<ul id="A2.I3" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<li id="A2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i1.p1.1" class="ltx_p"><math id="A2.I3.i1.p1.m1" class="ltx_Math" alttext="\mathbf{A}_{v},\mathbf{A}_{r}\in\mathbb{R}^{(l+1)\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐀</mi><mi>v</mi></msub><mo>,</mo><mrow><msub><mi>𝐀</mi><mi>r</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}_{v},\mathbf{A}_{r}\in\mathbb{R}^{(l+1)\times d}</annotation></semantics></math>: embedding tables for anonymized vertices and relations, respectively,</p>
</div></li>
<li id="A2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i2.p1.1" class="ltx_p"><math id="A2.I3.i2.p1.m1" class="ltx_Math" alttext="\mathbf{D}\in\mathbb{R}^{2\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐃</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{D}\in\mathbb{R}^{2\times d}</annotation></semantics></math>: look-up table for the direction embedding,</p>
</div></li>
<li id="A2.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I3.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i3.p1.1" class="ltx_p"><math id="A2.I3.i3.p1.m1" class="ltx_Math" alttext="\mathbf{Q}_{h},\mathbf{Q}_{r}\in\mathbb{R}^{2\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐐</mi><mi>h</mi></msub><mo>,</mo><mrow><msub><mi>𝐐</mi><mi>r</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q}_{h},\mathbf{Q}_{r}\in\mathbb{R}^{2\times d}</annotation></semantics></math>: embedding tables for the binary query labels,</p>
</div></li>
<li id="A2.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I3.i4.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i4.p1.1" class="ltx_p"><math id="A2.I3.i4.p1.m1" class="ltx_Math" alttext="\mathbf{V},\mathbf{R}:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐕</mi><mo>,</mo><mrow><mi>𝐑</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>d</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{V},\mathbf{R}:\mathbb{R}^{d}\rightarrow\mathbb{R}^{d}</annotation></semantics></math>: linear maps applied to the passed embeddings of vertices and relations,</p>
</div></li>
<li id="A2.I3.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I3.i5.p1" class="ltx_para">
<p id="A2.I3.i5.p1.1" class="ltx_p"><math id="A2.I3.i5.p1.m1" class="ltx_Math" alttext="\mathbf{\Omega}" display="inline" intent=":literal"><semantics><mi>𝛀</mi><annotation encoding="application/x-tex">\mathbf{\Omega}</annotation></semantics></math>: a bi-directional GRU <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib11" title="" class="ltx_ref">Cho et al., 2014</a>)</cite> cell equipped with RMSNorm <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib49" title="" class="ltx_ref">Zhang &amp; Sennrich, 2019</a>)</cite> and SwiGLU <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib38" title="" class="ltx_ref">Shazeer, 2020</a>)</cite> activation function.</p>
</div></li>
</ul>
<p id="A2.SS3.p1.3" class="ltx_p">For each step, encoding <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> of the form:</p>
<table id="A2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex16.m1" class="ltx_Math" alttext="S_{i}=\left(\operatorname{id}_{V}(v_{i};\bar{\eta}_{i}),\operatorname{id}_{R}(r_{i};\bar{\eta}_{i}),\operatorname{dir}_{i},\delta_{v_{i}=h_{q}},\delta_{r_{i}=r_{q}},\mathbf{v}(v_{i}),\mathbf{r}(r_{i})\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>(</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>dir</mi><mi>i</mi></msub><mo>,</mo><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><mo>,</mo><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><mo>,</mo><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{i}=\left(\operatorname{id}_{V}(v_{i};\bar{\eta}_{i}),\operatorname{id}_{R}(r_{i};\bar{\eta}_{i}),\operatorname{dir}_{i},\delta_{v_{i}=h_{q}},\delta_{r_{i}=r_{q}},\mathbf{v}(v_{i}),\mathbf{r}(r_{i})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.4" class="ltx_p">we evaluate the processed embedding <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="\mathbf{c_{i}}" display="inline" intent=":literal"><semantics><msub><mi>𝐜</mi><mi>𝐢</mi></msub><annotation encoding="application/x-tex">\mathbf{c_{i}}</annotation></semantics></math> of <math id="A2.SS3.p1.m6" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> as a sum of the corresponding encoded components:</p>
<table id="A2.Ex17" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex17X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17X.m2" class="ltx_Math" alttext="\displaystyle\mathbf{c}_{i}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐜</mi><mi>i</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{c}_{i}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17X.m3" class="ltx_Math" alttext="\displaystyle\mathbf{A}_{v}(\operatorname{id}_{V}(v_{i};\bar{\eta}_{i}))+\mathbf{A}_{r}(\operatorname{id}_{R}(r_{i};\bar{\eta}_{i}))+\mathbf{D}(\operatorname{dir}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐀</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝐀</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐃</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>dir</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{A}_{v}(\operatorname{id}_{V}(v_{i};\bar{\eta}_{i}))+\mathbf{A}_{r}(\operatorname{id}_{R}(r_{i};\bar{\eta}_{i}))+\mathbf{D}(\operatorname{dir}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17Xa.m2" class="ltx_Math" alttext="\displaystyle+\mathbf{Q_{h}}(\delta_{v_{i}=h_{q}})+\mathbf{Q}_{r}(\delta_{r_{i}=r_{q}})+\mathbf{V}(\mathbf{v}(v_{i}))+\mathbf{R}(\mathbf{r}(r_{i}))" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>𝐐</mi><mi>𝐡</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>𝐐</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐕</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝐑</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbf{Q_{h}}(\delta_{v_{i}=h_{q}})+\mathbf{Q}_{r}(\delta_{r_{i}=r_{q}})+\mathbf{V}(\mathbf{v}(v_{i}))+\mathbf{R}(\mathbf{r}(r_{i}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.p2.1" class="ltx_p">These are then passed to the GRU cell <math id="A2.SS3.p2.m1" class="ltx_Math" alttext="\mathbf{\Omega}" display="inline" intent=":literal"><semantics><mi>𝛀</mi><annotation encoding="application/x-tex">\mathbf{\Omega}</annotation></semantics></math>, which fuses the features across the whole walk and produces multi-head embeddings of vertices and relations, as well as the associated weights:</p>
<table id="A2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\left(\mathbf{s}^{(V)}_{i},\mathbf{s}^{(R)}_{i},\mathbf{a}^{(V)}_{i},\mathbf{a}^{(R)}_{i}\right)=\mathbf{\Omega}([\mathbf{c}_{0},\mathbf{c}_{1},\dots,\mathbf{c}_{l}])" display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝐚</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>𝐚</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>=</mo><mrow><mi>𝛀</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐜</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝐜</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐜</mi><mi>l</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left(\mathbf{s}^{(V)}_{i},\mathbf{s}^{(R)}_{i},\mathbf{a}^{(V)}_{i},\mathbf{a}^{(R)}_{i}\right)=\mathbf{\Omega}([\mathbf{c}_{0},\mathbf{c}_{1},\dots,\mathbf{c}_{l}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p2.2" class="ltx_p">where <math id="A2.SS3.p2.m2" class="ltx_Math" alttext="\mathbf{s}^{(V)}_{i},\mathbf{s}^{(R)}_{i}\in\mathbb{R}^{(l+1)\times h\times d_{h}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>𝐬</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>h</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mi>h</mi></msub></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}^{(V)}_{i},\mathbf{s}^{(R)}_{i}\in\mathbb{R}^{(l+1)\times h\times d_{h}}</annotation></semantics></math> and <math id="A2.SS3.p2.m3" class="ltx_Math" alttext="\mathbf{a}^{(V)}_{i},\mathbf{a}^{(R)}_{i}\in\mathbb{R}^{(l+1)\times h}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐚</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><msubsup><mi>𝐚</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>h</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{a}^{(V)}_{i},\mathbf{a}^{(R)}_{i}\in\mathbb{R}^{(l+1)\times h}</annotation></semantics></math>.
Stacking all <math id="A2.SS3.p2.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> of them gives us the final output of the sequence processor.</p>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Consensus protocol</h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p">Given walks <math id="A2.SS4.p1.m1" class="ltx_math_unparsed" alttext="\bar{\eta}_{1:N}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bar{\eta}_{1:N}</annotation></semantics></math> over <math id="A2.SS4.p1.m2" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> and the outputs <math id="A2.SS4.p1.m3" class="ltx_Math" alttext="\mathbf{s}^{(V)},\mathbf{s}^{(R)},\mathbf{a}^{(V)},\mathbf{a}^{(R)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐬</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{s}^{(V)},\mathbf{s}^{(R)},\mathbf{a}^{(V)},\mathbf{a}^{(R)}</annotation></semantics></math> of the sequence processor, the consensus protocol <math id="A2.SS4.p1.m4" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> aggregates the signal for each node by evaluating a weighted sum over the appearances of this node across the walks. More precisely, for each node <math id="A2.SS4.p1.m5" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, we find all pairs of indices <math id="A2.SS4.p1.m6" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math>, such that the <math id="A2.SS4.p1.m7" class="ltx_Math" alttext="j^{\text{th}}" display="inline" intent=":literal"><semantics><msup><mi>j</mi><mtext>th</mtext></msup><annotation encoding="application/x-tex">j^{\text{th}}</annotation></semantics></math> node visited in <math id="A2.SS4.p1.m8" class="ltx_Math" alttext="\bar{\eta}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\bar{\eta}_{i}</annotation></semantics></math> was <math id="A2.SS4.p1.m9" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>, and concatenate the weighted sums of embeddings produced by each head, with weights exponentially proportional to the scores <math id="A2.SS4.p1.m10" class="ltx_Math" alttext="\mathbf{a}^{(V)}" display="inline" intent=":literal"><semantics><msup><mi>𝐚</mi><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathbf{a}^{(V)}</annotation></semantics></math>:</p>
<table id="A2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\Delta\mathbf{v}(v)=\bigoplus_{k=1}^{h}\frac{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(v_{j})=v\end{subarray}}\exp\left(\mathbf{a}^{(V)}_{i,j,k}\right)\cdot\mathbf{s}^{(V)}_{i,j,k}}{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(v_{j})=v\end{subarray}}\exp\left(\mathbf{a}^{(V)}_{i,j,k}\right)}" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover><mfrac><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>v</mi></mrow></mtd></mtr></mtable></munder><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝐚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐬</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>v</mi></mrow></mtd></mtr></mtable></munder><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝐚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{v}(v)=\bigoplus_{k=1}^{h}\frac{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(v_{j})=v\end{subarray}}\exp\left(\mathbf{a}^{(V)}_{i,j,k}\right)\cdot\mathbf{s}^{(V)}_{i,j,k}}{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(v_{j})=v\end{subarray}}\exp\left(\mathbf{a}^{(V)}_{i,j,k}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p1.2" class="ltx_p">Similarly, we aggregate the encodings for relations, considering their occurrences in both directions:</p>
<table id="A2.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\Delta\mathbf{r}(r)=\bigoplus_{k=1}^{h}\frac{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(r_{j})\in\{r,r^{-1}\}\end{subarray}}\exp\left(\mathbf{a}^{(R)}_{i,j,k}\right)\cdot\mathbf{s}^{(R)}_{i,j,k}}{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(r_{j})\in\{r,r^{-1}\}\end{subarray}}\exp\left(\mathbf{a}^{(R)}_{i,j,k}\right)}" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>h</mi></munderover><mfrac><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>r</mi><mo>,</mo><msup><mi>r</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr></mtable></munder><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝐚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>𝐬</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi>r</mi><mo>,</mo><msup><mi>r</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">}</mo></mrow></mrow></mtd></mtr></mtable></munder><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝐚</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{r}(r)=\bigoplus_{k=1}^{h}\frac{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(r_{j})\in\{r,r^{-1}\}\end{subarray}}\exp\left(\mathbf{a}^{(R)}_{i,j,k}\right)\cdot\mathbf{s}^{(R)}_{i,j,k}}{\sum\limits_{\begin{subarray}{c}i,j\\
\bar{\eta}_{i}(r_{j})\in\{r,r^{-1}\}\end{subarray}}\exp\left(\mathbf{a}^{(R)}_{i,j,k}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p1.3" class="ltx_p">In both formulas above, <math id="A2.SS4.p1.m11" class="ltx_Math" alttext="\bigoplus" display="inline" intent=":literal"><semantics><mo>⨁</mo><annotation encoding="application/x-tex">\bigoplus</annotation></semantics></math> denotes concatenation.</p>
</div>
<div id="A2.SS4.p2" class="ltx_para ltx_noindent">
<p id="A2.SS4.p2.1" class="ltx_p">Additionally, we say that a consensus protocol <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> is <em id="A2.SS4.p2.1.1" class="ltx_emph ltx_font_italic">invariant</em> if for any pair of isomorphic KGs <math id="A2.SS4.p2.m2" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> and <math id="A2.SS4.p2.m3" class="ltx_Math" alttext="H=(V^{\prime},E^{\prime},R^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H=(V^{\prime},E^{\prime},R^{\prime})</annotation></semantics></math>, any isomorphism <math id="A2.SS4.p2.m4" class="ltx_Math" alttext="\mu=(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu=(\pi,\phi)</annotation></semantics></math> from <math id="A2.SS4.p2.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> to <math id="A2.SS4.p2.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, any list of embeddings <math id="A2.SS4.p2.m7" class="ltx_math_unparsed" alttext="\mathbf{h}_{1:N}" display="inline" intent=":literal"><semantics><mrow><mi>𝐡</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{h}_{1:N}</annotation></semantics></math> with <math id="A2.SS4.p2.m8" class="ltx_Math" alttext="\mathbf{h}_{i}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mi>i</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{h}_{i}\in\mathbb{R}^{d}</annotation></semantics></math>, and any sequence of sampled walks <math id="A2.SS4.p2.m9" class="ltx_math_unparsed" alttext="\bar{\eta}_{1:N}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bar{\eta}_{1:N}</annotation></semantics></math> over <math id="A2.SS4.p2.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, the outputs</p>
<table id="A2.Ex21" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex21X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21X.m2" class="ltx_Math" alttext="\displaystyle(\Delta\mathbf{v},\Delta\mathbf{r})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐫</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\Delta\mathbf{v},\Delta\mathbf{r})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21X.m3" class="ltx_Math" alttext="\displaystyle=c(\mathbf{h}_{1:N},\bar{\eta}_{1:N})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>c</mi><mo stretchy="false">(</mo><mi>𝐡</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=c(\mathbf{h}_{1:N},\bar{\eta}_{1:N})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex21Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21Xa.m2" class="ltx_Math" alttext="\displaystyle(\Delta\mathbf{v}^{\prime},\Delta\mathbf{r}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐫</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\Delta\mathbf{v}^{\prime},\Delta\mathbf{r}^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21Xa.m3" class="ltx_Math" alttext="\displaystyle=c(\mathbf{h}_{1:N},\mu(\bar{\eta}_{1:N}))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>c</mi><mo stretchy="false">(</mo><mi>𝐡</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=c(\mathbf{h}_{1:N},\mu(\bar{\eta}_{1:N}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p2.2" class="ltx_p">satisfy:</p>
<table id="A2.Ex22" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex22X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22X.m2" class="ltx_Math" alttext="\displaystyle\Delta\mathbf{v}(v)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\mathbf{v}(v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22X.m3" class="ltx_Math" alttext="\displaystyle=\Delta\mathbf{v}^{\prime}(\pi(v))\quad" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle=\Delta\mathbf{v}^{\prime}(\pi(v))\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22X.m5" class="ltx_Math" alttext="\displaystyle\forall v\in V" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>v</mi></mrow><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\displaystyle\forall v\in V</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22Xa.m2" class="ltx_Math" alttext="\displaystyle\Delta\mathbf{r}(r)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\mathbf{r}(r)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22Xa.m3" class="ltx_Math" alttext="\displaystyle=\Delta\mathbf{r}^{\prime}(\phi(r))\quad" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐫</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace></mrow><annotation encoding="application/x-tex">\displaystyle=\Delta\mathbf{r}^{\prime}(\phi(r))\quad</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22Xa.m5" class="ltx_Math" alttext="\displaystyle\forall r\in R" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>r</mi></mrow><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\displaystyle\forall r\in R</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Proofs</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Expressivity</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">The main proposition of this section formalizes the fact that <span id="A3.SS1.p1.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> can approximate any link-invariant function over fixed-size knowledge graphs in probability.
Intuitively, when the length of the sampled walks <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> becomes higher, the probability of a single walk witnessing all the edges grows to 1.
Once a walk visits all the edges, a sufficiently powerful sequence processor can derive the whole graph structure from its anonymized representation, recreating the graph in its entirety, up to isomorphism.
Then, the processor can return the value of the approximated function for that graph.</p>
</div>
<div id="A3.SS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.p2.1" class="ltx_p">We start by showing that the edge cover time <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="C_{E}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{E}(\cdot)</annotation></semantics></math> of graphs in <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="K_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">K_{n,m}</annotation></semantics></math> is bounded:</p>
</div>
<div id="A3.Thmglobalcounter1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmglobalcounter1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter1.p1" class="ltx_para">
<p id="A3.Thmglobalcounter1.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmglobalcounter1.p1.m1" class="ltx_Math" alttext="G\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G\in\mathbb{K}_{n,m}</annotation></semantics></math> for some <math id="A3.Thmglobalcounter1.p1.m2" class="ltx_Math" alttext="n,m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">n,m</annotation></semantics></math>. The edge cover time <math id="A3.Thmglobalcounter1.p1.m3" class="ltx_Math" alttext="C_{E}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{E}(G)</annotation></semantics></math> of <math id="A3.Thmglobalcounter1.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, using the algorithm from <a href="#A2.SS1" title="B.1 Uniform random walk ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>, is finite.</span></p>
</div>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS1.p3.1" class="ltx_p"><span id="A3.SS1.p3.1.1" class="ltx_text">Let <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="G=(V,E,R)\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G=(V,E,R)\in\mathbb{K}_{n,m}</annotation></semantics></math> be a graph. For any edge <math id="A3.SS1.p3.m2" class="ltx_Math" alttext="e\in E" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">e\in E</annotation></semantics></math> and any vertex <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, let <math id="A3.SS1.p3.m4" class="ltx_Math" alttext="H_{v}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{v}(e)</annotation></semantics></math> denote the expected number of steps of the random walk algorithm <math id="A3.SS1.p3.m5" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> described in <a href="#A2.SS1" title="B.1 Uniform random walk ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>.
Then, the edge cover time <math id="A3.SS1.p3.m6" class="ltx_Math" alttext="C_{E}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{E}(G)</annotation></semantics></math> of <math id="A3.SS1.p3.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with <math id="A3.SS1.p3.m8" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, i.e. the expected number of steps that <math id="A3.SS1.p3.m9" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> needs to take before visiting every edge in <math id="A3.SS1.p3.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, is bounded above by:</span></p>
<table id="A3.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex23.m1" class="ltx_Math" alttext="C_{E}(G)\leq\sum\limits_{e\in E}\max_{v\in V}H_{v}(e)\leq m\cdot\max_{\begin{subarray}{c}e\in E\\
v\in V\end{subarray}}H_{v}(e)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow></munder><mrow><mrow><munder><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>H</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><munder><mi>max</mi><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></mtd></mtr></mtable></munder><mo lspace="0.167em">⁡</mo><msub><mi>H</mi><mi>v</mi></msub></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{E}(G)\leq\sum\limits_{e\in E}\max_{v\in V}H_{v}(e)\leq m\cdot\max_{\begin{subarray}{c}e\in E\\
v\in V\end{subarray}}H_{v}(e)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p3.2" class="ltx_p"><span id="A3.SS1.p3.2.1" class="ltx_text">Indeed, consider the event of visiting all these edges in order <math id="A3.SS1.p3.m11" class="ltx_Math" alttext="e_{1},\dots,e_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">e_{1},\dots,e_{m}</annotation></semantics></math>:</span></p>
<table id="A3.Ex24" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex24X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex24X.m2" class="ltx_Math" alttext="\displaystyle C_{E}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle C_{E}(G)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[\text{\#steps to visit all }e_{1},\dots,e_{m}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mtext>#steps to visit all </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\text{\#steps to visit all }e_{1},\dots,e_{m}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex24Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}[\text{\#steps to visit }e_{1},\text{ then }e_{2},\dots,\text{ then }e_{m}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mtext>#steps to visit </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mtext> then </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>2</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mtext> then </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>m</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}[\text{\#steps to visit }e_{1},\text{ then }e_{2},\dots,\text{ then }e_{m}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex24Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}[\text{\#steps to visit }e_{1}]+\sum_{i=1}^{m-1}\mathbb{E}[\text{\#steps to visit }e_{i+1}\text{ starting from }h_{i}\text{ or }t_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>#steps to visit </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>#steps to visit </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> starting from </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> or </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}[\text{\#steps to visit }e_{1}]+\sum_{i=1}^{m-1}\mathbb{E}[\text{\#steps to visit }e_{i+1}\text{ starting from }h_{i}\text{ or }t_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex24Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{v\in V}H_{v}(e_{1})+\sum_{i=1}^{m-1}\max(H_{h_{i}}(e_{i+1}),H_{t_{i}}(e_{i+1}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><munder><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>H</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><msub><mi>h</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>H</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{v\in V}H_{v}(e_{1})+\sum_{i=1}^{m-1}\max(H_{h_{i}}(e_{i+1}),H_{t_{i}}(e_{i+1}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex24Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24Xd.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{v\in V}H_{v}(e_{1})+\sum_{i=1}^{m-1}\max_{v\in V}H_{v}(e_{i+1})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><munder><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>H</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><munder><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>H</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{v\in V}H_{v}(e_{1})+\sum_{i=1}^{m-1}\max_{v\in V}H_{v}(e_{i+1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex24Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex24Xe.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{m}\max_{v\in V}H_{v}(e_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mrow><munder><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>H</mi><mi>v</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{m}\max_{v\in V}H_{v}(e_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p3.3" class="ltx_p"><span id="A3.SS1.p3.3.1" class="ltx_text">where <math id="A3.SS1.p3.m12" class="ltx_Math" alttext="h_{i}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>i</mi></msub><annotation encoding="application/x-tex">h_{i}</annotation></semantics></math> and <math id="A3.SS1.p3.m13" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> are the head and tail of the edge <math id="A3.SS1.p3.m14" class="ltx_Math" alttext="e_{i}" display="inline" intent=":literal"><semantics><msub><mi>e</mi><mi>i</mi></msub><annotation encoding="application/x-tex">e_{i}</annotation></semantics></math>, respectively.
Therefore, to show that <math id="A3.SS1.p3.m15" class="ltx_Math" alttext="C_{E}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{E}(G)</annotation></semantics></math> is finite, it suffices to prove that <math id="A3.SS1.p3.m16" class="ltx_Math" alttext="H_{v}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{v}(e)</annotation></semantics></math> is bounded for all <math id="A3.SS1.p3.m17" class="ltx_Math" alttext="v\in V,e\in E" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">v\in V,e\in E</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.p4" class="ltx_para ltx_noindent">
<p id="A3.SS1.p4.1" class="ltx_p"><span id="A3.SS1.p4.1.1" class="ltx_text">Fix <math id="A3.SS1.p4.m1" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> and <math id="A3.SS1.p4.m2" class="ltx_Math" alttext="e\in E" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">e\in E</annotation></semantics></math>. Consider an infinite random walk generated with <math id="A3.SS1.p4.m3" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> over <math id="A3.SS1.p4.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, starting at <math id="A3.SS1.p4.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>:</span></p>
<table id="A3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex25.m1" class="ltx_Math" alttext="v=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}v_{2}\xrightarrow{r_{3}}\dots" display="block" intent=":literal"><semantics><mrow><mi>v</mi><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub></mover><msub><mi>v</mi><mn>2</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">3</mn></msub></mover><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">v=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}v_{2}\xrightarrow{r_{3}}\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p4.2" class="ltx_p"><span id="A3.SS1.p4.2.1" class="ltx_text">We want to bound the expected first index <math id="A3.SS1.p4.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, such that <math id="A3.SS1.p4.m7" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> is the edge traversed in step <math id="A3.SS1.p4.m8" class="ltx_Math" alttext="v_{t-1}\xrightarrow{r_{t}}v_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">t</mi></msub></mover><msub><mi>v</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">v_{t-1}\xrightarrow{r_{t}}v_{t}</annotation></semantics></math>.
Denote by <math id="A3.SS1.p4.m9" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> a maximum degree of a vertex in <math id="A3.SS1.p4.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> (counted as the number of connected vertices <math id="A3.SS1.p4.m11" class="ltx_Math" alttext="\mathcal{N}(v)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(v)</annotation></semantics></math>), by <math id="A3.SS1.p4.m12" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> the maximum number of edges between any single pair of nodes and by <math id="A3.SS1.p4.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> – the diameter of the graph, i.e. the length of the longest shortest path between two vertices (in the undirected version of <math id="A3.SS1.p4.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>).
Consider the series of events <math id="A3.SS1.p4.m15" class="ltx_Math" alttext="A_{0},A_{1},\dots" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>,</mo><msub><mi>A</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">A_{0},A_{1},\dots</annotation></semantics></math> where <math id="A3.SS1.p4.m16" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> is characterized as:</span></p>
<table id="A3.Ex26" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex26X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex26X.m2" class="ltx_Math" alttext="\displaystyle A_{i}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle A_{i}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26X.m3" class="ltx_Math" alttext="\displaystyle\text{ the event that starting from }v_{i(d+2)}\text{ the walk will follow a shortest path}" display="inline" intent=":literal"><semantics><mrow><mtext>the event that starting from </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> the walk will follow a shortest path</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\text{ the event that starting from }v_{i(d+2)}\text{ the walk will follow a shortest path}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex26Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex26Xa.m2" class="ltx_Math" alttext="\displaystyle\text{ to one of the endpoints of }e\text{ and then go through }e" display="inline" intent=":literal"><semantics><mrow><mtext>to one of the endpoints of </mtext><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and then go through </mtext><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\displaystyle\text{ to one of the endpoints of }e\text{ and then go through }e</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p4.3" class="ltx_p"><span id="A3.SS1.p4.3.1" class="ltx_text">Let <math id="A3.SS1.p4.m17" class="ltx_Math" alttext="e=(h_{e},r_{e},t_{e})" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>e</mi></msub><mo>,</mo><msub><mi>r</mi><mi>e</mi></msub><mo>,</mo><msub><mi>t</mi><mi>e</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">e=(h_{e},r_{e},t_{e})</annotation></semantics></math>.
For all values of <math id="A3.SS1.p4.m18" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, by definition, the length of the shortest path from <math id="A3.SS1.p4.m19" class="ltx_Math" alttext="v_{i(d+2)}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">v_{i(d+2)}</annotation></semantics></math> to <math id="A3.SS1.p4.m20" class="ltx_Math" alttext="h_{e}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>e</mi></msub><annotation encoding="application/x-tex">h_{e}</annotation></semantics></math> or <math id="A3.SS1.p4.m21" class="ltx_Math" alttext="t_{e}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>e</mi></msub><annotation encoding="application/x-tex">t_{e}</annotation></semantics></math> is at most <math id="A3.SS1.p4.m22" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.
Therefore, the whole part of the walk described in <math id="A3.SS1.p4.m23" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> is at most <math id="A3.SS1.p4.m24" class="ltx_Math" alttext="d+1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d+1</annotation></semantics></math> steps long.
By the definition of the used random walk algorithm, which only looks at the previously taken edge, we can deduce that the events <math id="A3.SS1.p4.m25" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> are all mutually independent.</span></p>
</div>
<div id="A3.SS1.p5" class="ltx_para ltx_noindent">
<p id="A3.SS1.p5.1" class="ltx_p"><span id="A3.SS1.p5.1.1" class="ltx_text">Moreover, let <math id="A3.SS1.p5.m1" class="ltx_Math" alttext="v_{i(d+2)}=u_{0}\xrightarrow{s_{1}}u_{1}\xrightarrow{s_{2}}\dots\xrightarrow{s_{l}}u_{l}\in\{h_{e},t_{e}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><msub><mi>u</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">s</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>u</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">s</mi><mn mathsize="0.710em">2</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">s</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>u</mi><mi>l</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi>e</mi></msub><mo>,</mo><msub><mi>t</mi><mi>e</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">v_{i(d+2)}=u_{0}\xrightarrow{s_{1}}u_{1}\xrightarrow{s_{2}}\dots\xrightarrow{s_{l}}u_{l}\in\{h_{e},t_{e}\}</annotation></semantics></math> be a shortest path from <math id="A3.SS1.p5.m2" class="ltx_Math" alttext="v_{i(d+2)}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">v_{i(d+2)}</annotation></semantics></math> to one of <math id="A3.SS1.p5.m3" class="ltx_Math" alttext="h_{e},t_{e}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>e</mi></msub><mo>,</mo><msub><mi>t</mi><mi>e</mi></msub></mrow><annotation encoding="application/x-tex">h_{e},t_{e}</annotation></semantics></math>.
Note that by minimality, there cannot be any backtracking while following this path.
Therefore, the probability of the next visited node is dependent only on the value of the previous one, and we can bound the probability <math id="A3.SS1.p5.m4" class="ltx_Math" alttext="P(A_{i})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(A_{i})</annotation></semantics></math> of <math id="A3.SS1.p5.m5" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> from below by:</span></p>
<table id="A3.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex27.m1" class="ltx_Math" alttext="{\mathbb{P}}(A_{i})\geq{\mathbb{P}}(\text{pass through }e\text{ after reaching }h_{e}\text{ or }t_{e})\cdot\prod_{j=0}^{l-1}{\mathbb{P}}(v_{i(d+2)+j+1}=u_{j+1}\mid v_{i(d+2)+j}=u_{j})" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>pass through </mtext><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mtext> after reaching </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> or </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>e</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">⋅</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>u</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi></mrow></msub><mo>=</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(A_{i})\geq{\mathbb{P}}(\text{pass through }e\text{ after reaching }h_{e}\text{ or }t_{e})\cdot\prod_{j=0}^{l-1}{\mathbb{P}}(v_{i(d+2)+j+1}=u_{j+1}\mid v_{i(d+2)+j}=u_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p5.2" class="ltx_p"><span id="A3.SS1.p5.2.1" class="ltx_text">The first term on the right hand side is the probability of selecting <math id="A3.SS1.p5.m6" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> while being at <math id="A3.SS1.p5.m7" class="ltx_Math" alttext="h_{e}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>e</mi></msub><annotation encoding="application/x-tex">h_{e}</annotation></semantics></math> or <math id="A3.SS1.p5.m8" class="ltx_Math" alttext="t_{e}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>e</mi></msub><annotation encoding="application/x-tex">t_{e}</annotation></semantics></math>, which is the probability of first selecting the other endpoint (out of at most <math id="A3.SS1.p5.m9" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> neighbors) and then picking <math id="A3.SS1.p5.m10" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> over other edges between <math id="A3.SS1.p5.m11" class="ltx_Math" alttext="h_{e}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>e</mi></msub><annotation encoding="application/x-tex">h_{e}</annotation></semantics></math> and <math id="A3.SS1.p5.m12" class="ltx_Math" alttext="t_{e}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>e</mi></msub><annotation encoding="application/x-tex">t_{e}</annotation></semantics></math> (of which there is at most <math id="A3.SS1.p5.m13" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>). Hence:</span></p>
<table id="A3.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex28.m1" class="ltx_Math" alttext="{\mathbb{P}}(\text{pass through }e\text{ after reaching }h_{e}\text{ or }t_{e})\geq\frac{1}{\Delta}\cdot\frac{1}{\rho}=\frac{1}{\Delta\cdot\rho}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>pass through </mtext><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mtext> after reaching </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> or </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>e</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mi>ρ</mi></mfrac></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ρ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\text{pass through }e\text{ after reaching }h_{e}\text{ or }t_{e})\geq\frac{1}{\Delta}\cdot\frac{1}{\rho}=\frac{1}{\Delta\cdot\rho}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p5.3" class="ltx_p"><span id="A3.SS1.p5.3.1" class="ltx_text">As we never reach a backtracking situation by minimality of the shortest path, we can also write:</span></p>
<table id="A3.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex29.m1" class="ltx_Math" alttext="{\mathbb{P}}(v_{i(d+2)+j+1}=u_{j+1}\mid v_{i(d+2)+j}=u_{j})=\frac{1}{|\mathcal{N}(v_{i(d+2)+j})|}\geq\frac{1}{\Delta}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>u</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi></mrow></msub><mo>=</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo>≥</mo><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(v_{i(d+2)+j+1}=u_{j+1}\mid v_{i(d+2)+j}=u_{j})=\frac{1}{|\mathcal{N}(v_{i(d+2)+j})|}\geq\frac{1}{\Delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p5.4" class="ltx_p"><span id="A3.SS1.p5.4.1" class="ltx_text">Combining these observations, we can derive a bound for <math id="A3.SS1.p5.m14" class="ltx_Math" alttext="{\mathbb{P}}(A_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(A_{i})</annotation></semantics></math> in terms of <math id="A3.SS1.p5.m15" class="ltx_Math" alttext="\Delta,\rho" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>,</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">\Delta,\rho</annotation></semantics></math> and <math id="A3.SS1.p5.m16" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>:</span></p>
<table id="A3.Ex30" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex30X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex30X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(A_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(A_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30X.m3" class="ltx_Math" alttext="\displaystyle\geq{\mathbb{P}}(\text{pass through }e\text{ after reaching }h_{e}\text{ or }t_{e})\cdot\prod_{j=0}^{l-1}{\mathbb{P}}(v_{i(d+2)+j+1}=u_{j+1}\mid v_{i(d+2)+j}=u_{j})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>pass through </mtext><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mtext> after reaching </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext> or </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>e</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>u</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>v</mi><mrow><mrow><mi>i</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>j</mi></mrow></msub><mo>=</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq{\mathbb{P}}(\text{pass through }e\text{ after reaching }h_{e}\text{ or }t_{e})\cdot\prod_{j=0}^{l-1}{\mathbb{P}}(v_{i(d+2)+j+1}=u_{j+1}\mid v_{i(d+2)+j}=u_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex30Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex30Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{\Delta\cdot\rho}\cdot\prod_{j=0}^{l-1}\frac{1}{\Delta}\quad\geq\quad\frac{1}{\Delta\cdot\rho}\left(\frac{1}{\Delta}\right)^{l}\quad\geq\quad\frac{1}{\Delta\cdot\rho}\left(\frac{1}{\Delta}\right)^{d}\quad=\quad\frac{1}{\rho\Delta^{d+1}}" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac></mstyle><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac></mstyle><mo>)</mo><msup><mrow></mrow><mi>l</mi></msup><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi mathvariant="normal">Δ</mi></mfrac></mstyle><mo>)</mo><msup><mrow></mrow><mi>d</mi></msup><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{\Delta\cdot\rho}\cdot\prod_{j=0}^{l-1}\frac{1}{\Delta}\quad\geq\quad\frac{1}{\Delta\cdot\rho}\left(\frac{1}{\Delta}\right)^{l}\quad\geq\quad\frac{1}{\Delta\cdot\rho}\left(\frac{1}{\Delta}\right)^{d}\quad=\quad\frac{1}{\rho\Delta^{d+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p5.5" class="ltx_p"><span id="A3.SS1.p5.5.1" class="ltx_text">Finally, note that if <math id="A3.SS1.p5.m17" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> is true, then the first index <math id="A3.SS1.p5.m18" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> such that <math id="A3.SS1.p5.m19" class="ltx_Math" alttext="v_{t-1}\xrightarrow{r_{t}}v_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">t</mi></msub></mover><msub><mi>v</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">v_{t-1}\xrightarrow{r_{t}}v_{t}</annotation></semantics></math> traverses <math id="A3.SS1.p5.m20" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> is at most <math id="A3.SS1.p5.m21" class="ltx_Math" alttext="(i+1)(d+2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(i+1)(d+2)</annotation></semantics></math>.
We can therefore bound the expectation of such <math id="A3.SS1.p5.m22" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, being <math id="A3.SS1.p5.m23" class="ltx_Math" alttext="H_{v}(e)=H_{v_{0}}(e)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>H</mi><msub><mi>v</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{v}(e)=H_{v_{0}}(e)</annotation></semantics></math> by:</span></p>
<table id="A3.Ex31" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex31X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex31X.m2" class="ltx_Math" alttext="\displaystyle H_{v}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{v}(e)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31X.m3" class="ltx_Math" alttext="\displaystyle\leq(d+2)\cdot{\mathbb{P}}(A_{0})+2(d+2)\cdot{\mathbb{P}}(\neg A_{0}\land A_{1})+3(d+2)\cdot{\mathbb{P}}(\neg A_{0}\land\neg A_{1}\land A_{2})+\dots" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>0</mn></msub></mrow><mo>∧</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>0</mn></msub></mrow><mo>∧</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo>∧</mo><msub><mi>A</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(d+2)\cdot{\mathbb{P}}(A_{0})+2(d+2)\cdot{\mathbb{P}}(\neg A_{0}\land A_{1})+3(d+2)\cdot{\mathbb{P}}(\neg A_{0}\land\neg A_{1}\land A_{2})+\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31Xa.m2" class="ltx_Math" alttext="\displaystyle=(d+2)\cdot{\mathbb{P}}(A_{0})+2(d+2)\cdot{\mathbb{P}}(\neg A_{0})\cdot P(A_{1})+3(d+2)\cdot{\mathbb{P}}(\neg A_{0})\cdot{\mathbb{P}}(\neg A_{1})\cdot{\mathbb{P}}(\land A_{2})+\dots" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>0</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>0</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0em">∧</mo><msub><mi>A</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(d+2)\cdot{\mathbb{P}}(A_{0})+2(d+2)\cdot{\mathbb{P}}(\neg A_{0})\cdot P(A_{1})+3(d+2)\cdot{\mathbb{P}}(\neg A_{0})\cdot{\mathbb{P}}(\neg A_{1})\cdot{\mathbb{P}}(\land A_{2})+\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31Xb.m2" class="ltx_Math" alttext="\displaystyle=(d+2)+{\mathbb{P}}(\neg A_{0})\cdot(d+2+{\mathbb{P}}(\neg A_{1})\cdot(d+2+{\mathbb{P}}(\neg A_{2})\cdot(\dots)))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>0</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo rspace="0.167em">¬</mo><msub><mi>A</mi><mn>2</mn></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(d+2)+{\mathbb{P}}(\neg A_{0})\cdot(d+2+{\mathbb{P}}(\neg A_{1})\cdot(d+2+{\mathbb{P}}(\neg A_{2})\cdot(\dots)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31Xc.m2" class="ltx_Math" alttext="\displaystyle\leq(d+2)+\left(1-\frac{1}{\rho\Delta^{d+1}}\right)\cdot\left(d+2+\left(1-\frac{1}{\rho\Delta^{d+1}}\right)\cdot\left(d+2+\left(1-\frac{1}{\rho\Delta^{d+1}}\right)\cdot(\dots)\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mstyle></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(d+2)+\left(1-\frac{1}{\rho\Delta^{d+1}}\right)\cdot\left(d+2+\left(1-\frac{1}{\rho\Delta^{d+1}}\right)\cdot\left(d+2+\left(1-\frac{1}{\rho\Delta^{d+1}}\right)\cdot(\dots)\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex31Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31Xd.m2" class="ltx_Math" alttext="\displaystyle=\rho(d+2)\Delta^{d+1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\rho(d+2)\Delta^{d+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p5.6" class="ltx_p"><span id="A3.SS1.p5.6.1" class="ltx_text">Since <math id="A3.SS1.p5.m24" class="ltx_Math" alttext="\rho\leq m,d+2\leq n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>≤</mo><mi>m</mi></mrow><mo>,</mo><mrow><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo>≤</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\rho\leq m,d+2\leq n</annotation></semantics></math> and <math id="A3.SS1.p5.m25" class="ltx_Math" alttext="\Delta\leq n" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\Delta\leq n</annotation></semantics></math>, we have <math id="A3.SS1.p5.m26" class="ltx_Math" alttext="H_{v}(e)\leq m(n+2)n^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mi>n</mi></msup></mrow></mrow><annotation encoding="application/x-tex">H_{v}(e)\leq m(n+2)n^{n}</annotation></semantics></math>, which completes the proof.
∎</span></p>
</div>
</div>
<div id="A3.Thmglobalcounter2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter2.2" class="ltx_text ltx_font_bold">Remark C.2</span></span><span id="A3.Thmglobalcounter2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter2.p1" class="ltx_para">
<p id="A3.Thmglobalcounter2.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter2.p1.1.1" class="ltx_text ltx_font_italic">The bound obtained in the proof of Lemma <a href="#A3.Thmglobalcounter1" title="Lemma C.1. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> is very crude.
In fact, we could transform the given knowledge graph into a simple graph (undirected, with no multi-edges) by substituting each edge <math id="A3.Thmglobalcounter2.p1.m1" class="ltx_Math" alttext="u\xrightarrow{r}v" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑟</mo></mover><mi>v</mi></mrow><annotation encoding="application/x-tex">u\xrightarrow{r}v</annotation></semantics></math> with two undirected edges <math id="A3.Thmglobalcounter2.p1.m2" class="ltx_Math" alttext="u\leftrightarrow v_{(u,r,v)}\leftrightarrow v" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo stretchy="false">↔</mo><msub><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">↔</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">u\leftrightarrow v_{(u,r,v)}\leftrightarrow v</annotation></semantics></math>.
The augmented graph will then have <math id="A3.Thmglobalcounter2.p1.m3" class="ltx_Math" alttext="n+m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">n+m</annotation></semantics></math> vertices, and our random walk algorithm naturally translates to a weighted random walk on the transformed graph.
This hints at an assumption that in practice, the edge cover time of the used random walk algorithm is of the magnitude <math id="A3.Thmglobalcounter2.p1.m4" class="ltx_Math" alttext="O((n+m)^{3})=O(n^{3}+m^{3})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mn>3</mn></msup><mo>+</mo><msup><mi>m</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O((n+m)^{3})=O(n^{3}+m^{3})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.p6" class="ltx_para ltx_noindent">
<p id="A3.SS1.p6.1" class="ltx_p">Let us now prove a fact about the number of distinct, up to isomorphism, graphs in <math id="A3.SS1.p6.m1" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math>.</p>
</div>
<div id="A3.Thmglobalcounter3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter3.2" class="ltx_text ltx_font_bold">Lemma C.3</span></span><span id="A3.Thmglobalcounter3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter3.p1" class="ltx_para">
<p id="A3.Thmglobalcounter3.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter3.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="A3.Thmglobalcounter3.p1.m1" class="ltx_Math" alttext="n,m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">n,m</annotation></semantics></math>, the number of isomorphism classes in <math id="A3.Thmglobalcounter3.p1.m2" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> is finite.</span></p>
</div>
</div>
<div id="A3.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p7" class="ltx_para ltx_noindent">
<p id="A3.SS1.p7.1" class="ltx_p"><span id="A3.SS1.p7.1.1" class="ltx_text">Since the number of distinct relation types that a graph in <math id="A3.SS1.p7.m1" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> is at most <math id="A3.SS1.p7.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, it suffices to show that the number of isomorphism classes of graphs in <math id="A3.SS1.p7.m3" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> with exactly <math id="A3.SS1.p7.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> relation types is bounded, for all <math id="A3.SS1.p7.m5" class="ltx_Math" alttext="k\in\{1,2,\dots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,2,\dots,m\}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.p8" class="ltx_para ltx_noindent">
<p id="A3.SS1.p8.1" class="ltx_p"><span id="A3.SS1.p8.1.1" class="ltx_text">Fix the number <math id="A3.SS1.p8.m1" class="ltx_Math" alttext="k\in\{1,2,\dots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,2,\dots,m\}</annotation></semantics></math> and consider <math id="A3.SS1.p8.m2" class="ltx_Math" alttext="G=(V,E,R)\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G=(V,E,R)\in\mathbb{K}_{n,m}</annotation></semantics></math> with <math id="A3.SS1.p8.m3" class="ltx_Math" alttext="|R|=k" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>R</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">|R|=k</annotation></semantics></math>.
We will show that, up to isomorphism, there are finitely many such choices of <math id="A3.SS1.p8.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.
Firstly, as renaming does not change the graph structure, without loss of generality, we can assume that:</span></p>
<table id="A3.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex32.m1" class="ltx_Math" alttext="V=\{v_{1},v_{2},\dots,v_{n}\}\qquad\text{and}\qquad R=\{r_{1},r_{2},\dots,r_{k}\}" display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>and</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><mi>R</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>k</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V=\{v_{1},v_{2},\dots,v_{n}\}\qquad\text{and}\qquad R=\{r_{1},r_{2},\dots,r_{k}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p8.2" class="ltx_p"><span id="A3.SS1.p8.2.1" class="ltx_text">Then, there are exactly <math id="A3.SS1.p8.m5" class="ltx_Math" alttext="n^{2}k" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n^{2}k</annotation></semantics></math> possible relational edges <math id="A3.SS1.p8.m6" class="ltx_Math" alttext="e\in(V\times R\times V)" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">e\in(V\times R\times V)</annotation></semantics></math>, and <math id="A3.SS1.p8.m7" class="ltx_Math" alttext="E\subseteq V\times R\times V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⊆</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">E\subseteq V\times R\times V</annotation></semantics></math> is a set of <math id="A3.SS1.p8.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> elements.
Hence, there are <math id="A3.SS1.p8.m9" class="ltx_Math" alttext="n^{2}k\choose{m}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mi>m</mi></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">n^{2}k\choose{m}</annotation></semantics></math> possible choices of <math id="A3.SS1.p8.m10" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and hence, at most <math id="A3.SS1.p8.m11" class="ltx_Math" alttext="n^{2}k\choose{m}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mi>m</mi></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">n^{2}k\choose{m}</annotation></semantics></math> non-isomorphic choices of <math id="A3.SS1.p8.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Since <math id="A3.SS1.p8.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> was chosen arbitrarily, this completes the proof.
∎</span></p>
</div>
</div>
<div id="A3.Thmglobalcounter4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter4.2" class="ltx_text ltx_font_bold">Lemma C.4</span></span><span id="A3.Thmglobalcounter4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter4.p1" class="ltx_para">
<p id="A3.Thmglobalcounter4.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter4.p1.1.1" class="ltx_text ltx_font_italic">For each pair <math id="A3.Thmglobalcounter4.p1.m1" class="ltx_Math" alttext="(n,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,m)</annotation></semantics></math>, there exists a number <math id="A3.Thmglobalcounter4.p1.m2" class="ltx_Math" alttext="C_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">C_{n,m}</annotation></semantics></math> such that the edge cover time, using the algorithm from <a href="#A2.SS1" title="B.1 Uniform random walk ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>, of any knowledge graph in <math id="A3.Thmglobalcounter4.p1.m3" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> is at most <math id="A3.Thmglobalcounter4.p1.m4" class="ltx_Math" alttext="C_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">C_{n,m}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p9" class="ltx_para">
<p id="A3.SS1.p9.1" class="ltx_p"><span id="A3.SS1.p9.1.1" class="ltx_text">The result follows from Lemmas <a href="#A3.Thmglobalcounter1" title="Lemma C.1. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> and <a href="#A3.Thmglobalcounter3" title="Lemma C.3. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a>.
As two isomorphic graphs have identical cover time, we can set <math id="A3.SS1.p9.m1" class="ltx_Math" alttext="C_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">C_{n,m}</annotation></semantics></math> to be the maximum of cover times of representatives of all isomorphic classes, which, by finiteness of both, is well-defined.
∎</span></p>
</div>
</div>
<div id="A3.Thmglobalcounter5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter5.2" class="ltx_text ltx_font_bold">Lemma C.5</span></span><span id="A3.Thmglobalcounter5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter5.p1" class="ltx_para">
<p id="A3.Thmglobalcounter5.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmglobalcounter5.p1.m1" class="ltx_Math" alttext="G\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G\in\mathbb{K}_{n,m}</annotation></semantics></math> be a graph, <math id="A3.Thmglobalcounter5.p1.m2" class="ltx_Math" alttext="q=(h_{q},r_{q},?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>q</mi></msub><mo>,</mo><msub><mi>r</mi><mi>q</mi></msub><mo>,</mo><mi mathvariant="normal">?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h_{q},r_{q},?)</annotation></semantics></math> be a link query over <math id="A3.Thmglobalcounter5.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, and <math id="A3.Thmglobalcounter5.p1.m4" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> be a walk over <math id="A3.Thmglobalcounter5.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. If <math id="A3.Thmglobalcounter5.p1.m6" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> traverses all edges of <math id="A3.Thmglobalcounter5.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, then using only the output <math id="A3.Thmglobalcounter5.p1.m8" class="ltx_math_unparsed" alttext="w(\bar{\eta};G,q,\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>;</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(\bar{\eta};G,q,\cdot,\cdot)</annotation></semantics></math> of the recording function <math id="A3.Thmglobalcounter5.p1.m9" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> detailed in <a href="#A2.SS2" title="B.2 Recording function ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.2</span></a>, we can construct a graph-query pair <math id="A3.Thmglobalcounter5.p1.m10" class="ltx_Math" alttext="(H,q^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,q^{\prime})</annotation></semantics></math> isomorphic to <math id="A3.Thmglobalcounter5.p1.m11" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p10" class="ltx_para ltx_noindent">
<p id="A3.SS1.p10.1" class="ltx_p"><span id="A3.SS1.p10.1.1" class="ltx_text">Suppose that <math id="A3.SS1.p10.m1" class="ltx_Math" alttext="\bar{\eta}=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>v</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">\bar{\eta}=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}</annotation></semantics></math> visits all edges of <math id="A3.SS1.p10.m2" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> and let <math id="A3.SS1.p10.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> be its length.
Recall the anonymization functions <math id="A3.SS1.p10.m4" class="ltx_Math" alttext="\operatorname{id}_{V}(\cdot;\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{id}_{V}(\cdot;\bar{\eta})</annotation></semantics></math> and <math id="A3.SS1.p10.m5" class="ltx_Math" alttext="\operatorname{id}_{R}(\cdot;\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{id}_{R}(\cdot;\bar{\eta})</annotation></semantics></math> as defined in <a href="#A2.SS2" title="B.2 Recording function ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.2</span></a>.
The output <math id="A3.SS1.p10.m6" class="ltx_math_unparsed" alttext="w(\bar{\eta};G,q,\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>;</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(\bar{\eta};G,q,\cdot,\cdot)</annotation></semantics></math> (the embedding functions provided as the last two arguments are irrelevant) is a sequence of tuples <math id="A3.SS1.p10.m7" class="ltx_Math" alttext="S_{0},S_{1},\dots,S_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mn>0</mn></msub><mo>,</mo><msub><mi>S</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>S</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">S_{0},S_{1},\dots,S_{l}</annotation></semantics></math> with each <math id="A3.SS1.p10.m8" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> equal to:</span></p>
<table id="A3.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex33.m1" class="ltx_math_unparsed" alttext="S_{i}=\left(\operatorname{id}_{V}(v_{i};\bar{\eta}),\operatorname{id}_{R}(r_{i};\bar{\eta}),\operatorname{dir}_{i},\delta_{v_{i}=h_{q}},\delta_{r_{i}=r_{q}},\cdot,\cdot\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>(</mo><msub><mi>id</mi><mi>V</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>id</mi><mi>R</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>dir</mi><mi>i</mi></msub><mo>,</mo><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><mo>,</mo><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{i}=\left(\operatorname{id}_{V}(v_{i};\bar{\eta}),\operatorname{id}_{R}(r_{i};\bar{\eta}),\operatorname{dir}_{i},\delta_{v_{i}=h_{q}},\delta_{r_{i}=r_{q}},\cdot,\cdot\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p10.2" class="ltx_p"><span id="A3.SS1.p10.2.1" class="ltx_text">Consider a graph <math id="A3.SS1.p10.m9" class="ltx_Math" alttext="H=(V^{\prime},E^{\prime},R^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H=(V^{\prime},E^{\prime},R^{\prime})</annotation></semantics></math> constructed as follows:</span></p>
<ul id="A3.I1" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i1.p1.1" class="ltx_p">the vertices <math id="A3.I1.i1.p1.m1" class="ltx_Math" alttext="V^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>V</mi><mo>′</mo></msup><annotation encoding="application/x-tex">V^{\prime}</annotation></semantics></math> correspond to the anonymized node ids <math id="A3.I1.i1.p1.m2" class="ltx_Math" alttext="\operatorname{id}_{V}(v_{i};\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{id}_{V}(v_{i};\bar{\eta})</annotation></semantics></math>:</p>
<table id="A3.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex34.m1" class="ltx_Math" alttext="V^{\prime}=\{\operatorname{id}_{V}(v;\bar{\eta})\mid v\in V\}" display="block" intent=":literal"><semantics><mrow><msup><mi>V</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V^{\prime}=\{\operatorname{id}_{V}(v;\bar{\eta})\mid v\in V\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I1.i1.p1.2" class="ltx_p">Since each vertex must have been visited by <math id="A3.I1.i1.p1.m3" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math>, this is well-defined.</p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i2.p1.1" class="ltx_p">the relation types <math id="A3.I1.i2.p1.m1" class="ltx_Math" alttext="R^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mo>′</mo></msup><annotation encoding="application/x-tex">R^{\prime}</annotation></semantics></math> are the anonymized relation ids <math id="A3.I1.i2.p1.m2" class="ltx_Math" alttext="\operatorname{id}_{R}(r_{i};\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{id}_{R}(r_{i};\bar{\eta})</annotation></semantics></math>:</p>
<table id="A3.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex35.m1" class="ltx_Math" alttext="R^{\prime}=\{\operatorname{id}_{V}(r;\bar{\eta})\mid r\in R\}" display="block" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>r</mi><mo>∈</mo><mi>R</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">R^{\prime}=\{\operatorname{id}_{V}(r;\bar{\eta})\mid r\in R\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I1.i2.p1.2" class="ltx_p">Again, this is well-defined, as each relation must have been noticed by <math id="A3.I1.i2.p1.m3" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math>.</p>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="A3.I1.i3.p1.1" class="ltx_p">the edges <math id="A3.I1.i3.p1.m1" class="ltx_Math" alttext="E^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mo>′</mo></msup><annotation encoding="application/x-tex">E^{\prime}</annotation></semantics></math> are reconstructed from the consecutive step encodings using the anonymized vertex and relation indices and the direction <math id="A3.I1.i3.p1.m2" class="ltx_Math" alttext="\operatorname{dir}_{i}" display="inline" intent=":literal"><semantics><msub><mi>dir</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\operatorname{dir}_{i}</annotation></semantics></math>:</p>
<table id="A3.Ex36" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex36X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36X.m2" class="ltx_Math" alttext="\displaystyle E^{\prime}=" display="inline" intent=":literal"><semantics><mrow><msup><mi>E</mi><mo>′</mo></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle E^{\prime}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36X.m3" class="ltx_Math" alttext="\displaystyle\left\{(\operatorname{id}_{V}(v_{i-1}),\operatorname{id}_{R}(r_{i}),\operatorname{id}_{V}(v_{i}))\mid\operatorname{dir}_{i}=0,1\leq i\leq l\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mo stretchy="false">(</mo><mi>id</mi><msub><mrow></mrow><mi>V</mi></msub><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>,</mo><mi>id</mi><msub><mrow></mrow><mi>R</mi></msub><mo stretchy="false">(</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>id</mi><msub><mrow></mrow><mi>V</mi></msub><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>dir</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>l</mi><mo>}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\{(\operatorname{id}_{V}(v_{i-1}),\operatorname{id}_{R}(r_{i}),\operatorname{id}_{V}(v_{i}))\mid\operatorname{dir}_{i}=0,1\leq i\leq l\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex36Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36Xa.m2" class="ltx_Math" alttext="\displaystyle\cup\left\{(\operatorname{id}_{V}(v_{i}),\operatorname{id}_{R}(r_{i}),\operatorname{id}_{V}(v_{i-1}))\mid\operatorname{dir}_{i}=1,1\leq i\leq l\right\}" display="inline" intent=":literal"><semantics><mrow><mo>∪</mo><mo>{</mo><mo stretchy="false">(</mo><mi>id</mi><msub><mrow></mrow><mi>V</mi></msub><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>id</mi><msub><mrow></mrow><mi>R</mi></msub><mo stretchy="false">(</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>id</mi><msub><mrow></mrow><mi>V</mi></msub><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>dir</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>l</mi><mo>}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\cup\left\{(\operatorname{id}_{V}(v_{i}),\operatorname{id}_{R}(r_{i}),\operatorname{id}_{V}(v_{i-1}))\mid\operatorname{dir}_{i}=1,1\leq i\leq l\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="A3.SS1.p10.3" class="ltx_p"><span id="A3.SS1.p10.3.1" class="ltx_text">and a query <math id="A3.SS1.p10.m10" class="ltx_Math" alttext="q^{\prime}=(\operatorname{id}_{V}(v_{i};\bar{\eta}),\operatorname{id}_{R}(r_{j},\bar{\eta}),?)" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q^{\prime}=(\operatorname{id}_{V}(v_{i};\bar{\eta}),\operatorname{id}_{R}(r_{j},\bar{\eta}),?)</annotation></semantics></math> for <math id="A3.SS1.p10.m11" class="ltx_Math" alttext="i,j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,j</annotation></semantics></math> such that <math id="A3.SS1.p10.m12" class="ltx_Math" alttext="\delta_{v_{i}=h_{q}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta_{v_{i}=h_{q}}=1</annotation></semantics></math> and <math id="A3.SS1.p10.m13" class="ltx_Math" alttext="\delta_{r_{j}=r_{q}}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>j</mi></msub><mo>=</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta_{r_{j}=r_{q}}=1</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.p11" class="ltx_para">
<p id="A3.SS1.p11.1" class="ltx_p"><span id="A3.SS1.p11.1.1" class="ltx_text">Then by the definition of <math id="A3.SS1.p11.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> (<a href="#A2.SS2" title="B.2 Recording function ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.2</span></a>), it is straightforward to check that the pair <math id="A3.SS1.p11.m2" class="ltx_Math" alttext="(\operatorname{id}_{V}(\cdot;\bar{\eta}),\operatorname{id}_{R}(\cdot;\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\operatorname{id}_{V}(\cdot;\bar{\eta}),\operatorname{id}_{R}(\cdot;\bar{\eta}))</annotation></semantics></math> defines an isomorphism from <math id="A3.SS1.p11.m3" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math> to <math id="A3.SS1.p11.m4" class="ltx_Math" alttext="(H,q^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,q^{\prime})</annotation></semantics></math>.
Indeed, both these functions are injective by construction, and as <math id="A3.SS1.p11.m5" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> witnesses all nodes and relations, they are well-defined bijections.
For each unique edge traversed by <math id="A3.SS1.p11.m6" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math>, there exists a unique edge in <math id="A3.SS1.p11.m7" class="ltx_Math" alttext="E^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mo>′</mo></msup><annotation encoding="application/x-tex">E^{\prime}</annotation></semantics></math> translated to the anonymized space, which implies an isomorphism between <math id="A3.SS1.p11.m8" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="A3.SS1.p11.m9" class="ltx_Math" alttext="E^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>E</mi><mo>′</mo></msup><annotation encoding="application/x-tex">E^{\prime}</annotation></semantics></math>.
Finally, by utilizing the flags <math id="A3.SS1.p11.m10" class="ltx_Math" alttext="\delta_{v_{i}=h_{q}}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><msub><mi>h</mi><mi>q</mi></msub></mrow></msub><annotation encoding="application/x-tex">\delta_{v_{i}=h_{q}}</annotation></semantics></math> and <math id="A3.SS1.p11.m11" class="ltx_Math" alttext="\delta_{r_{j}=r_{q}}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><msub><mi>r</mi><mi>j</mi></msub><mo>=</mo><msub><mi>r</mi><mi>q</mi></msub></mrow></msub><annotation encoding="application/x-tex">\delta_{r_{j}=r_{q}}</annotation></semantics></math>, we can identify the query head node and relation in the new graph.
All things considered, we can reconstruct the pair <math id="A3.SS1.p11.m12" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math>, up to isomorphism, from the output of <math id="A3.SS1.p11.m13" class="ltx_math_unparsed" alttext="w(\bar{\eta};G,q,\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>;</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(\bar{\eta};G,q,\cdot,\cdot)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A3.SS1.p12" class="ltx_para ltx_noindent">
<p id="A3.SS1.p12.1" class="ltx_p">We are now ready to prove the main result regarding the universality of <span id="A3.SS1.p12.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> as an approximation of link invariant functions.
The outline of the proof is as follows:
1) Using the upper-bound on the edge cover time of graphs in <math id="A3.SS1.p12.m2" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> derived in Lemma <a href="#A3.Thmglobalcounter4" title="Lemma C.4. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.4</span></a>, we can bound the probability of sampling a walk that visits all edges,
2) Once such a walk is sampled, we can recover the graph and query, up to isomorphism, from its anonymized form (Lemma <a href="#A3.Thmglobalcounter5" title="Lemma C.5. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.5</span></a>),
3) Lastly, we can return the value of the approximated function for the derived isomorphic instance.
Since the approximated function is link invariant, if the reconstructed graph matches the original one, we return precisely the correct value.</p>
</div>
<div id="Thminnercustomprop1" class="ltx_theorem ltx_theorem_innercustomprop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thminnercustomprop1.2" class="ltx_text ltx_font_bold">Proposition </span><a href="#S4.Thmglobalcounter1" title="Proposition 4.1. ‣ 4.2 Theoretical properties of Flock ‣ 4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref ltx_font_bold"><span class="ltx_text ltx_ref_tag">4.1</span></a></span><span id="Thminnercustomprop1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thminnercustomprop1.p1" class="ltx_para">
<p id="Thminnercustomprop1.p1.1" class="ltx_p"><span id="Thminnercustomprop1.p1.1.1" class="ltx_text ltx_font_italic">With a powerful enough sequence processor <math id="Thminnercustomprop1.p1.m1" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math>, the <span id="Thminnercustomprop1.p1.1.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> framework described in <a href="#S4" title="4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a> is a universal approximator of link invariant functions over <math id="Thminnercustomprop1.p1.m3" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> for all pairs <math id="Thminnercustomprop1.p1.m4" class="ltx_Math" alttext="(n,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,m)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS1.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p13" class="ltx_para ltx_noindent">
<p id="A3.SS1.p13.1" class="ltx_p"><span id="A3.SS1.p13.1.1" class="ltx_text">Let <math id="A3.SS1.p13.m1" class="ltx_Math" alttext="\varphi:\mathbb{K}_{n,m}\rightarrow(V\times R\times V\rightarrow[0,1])" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>V</mi></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:\mathbb{K}_{n,m}\rightarrow(V\times R\times V\rightarrow[0,1])</annotation></semantics></math> be a link invariant function over <math id="A3.SS1.p13.m2" class="ltx_Math" alttext="\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\mathbb{K}_{n,m}</annotation></semantics></math> returning values from the interval <math id="A3.SS1.p13.m3" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>.
Let <math id="A3.SS1.p13.m4" class="ltx_Math" alttext="G=(V,E,R)\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G=(V,E,R)\in\mathbb{K}_{n,m}</annotation></semantics></math>, <math id="A3.SS1.p13.m5" class="ltx_Math" alttext="q=(h,r,?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h,r,?)</annotation></semantics></math> be a link prediction query over <math id="A3.SS1.p13.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="A3.SS1.p13.m7" class="ltx_Math" alttext="t\in V" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">t\in V</annotation></semantics></math> be a target node.
Pick some <math id="A3.SS1.p13.m8" class="ltx_Math" alttext="\epsilon,\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>,</mo><mi>δ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon,\delta&gt;0</annotation></semantics></math>. Our goal is to show that:</span></p>
<table id="A3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E9.m1" class="ltx_Math" alttext="{\mathbb{P}}(|\varphi(G)((h,r,t))-X_{\theta}(G,(h,r,?))(t)|&lt;\epsilon)&gt;1-\delta" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(|\varphi(G)((h,r,t))-X_{\theta}(G,(h,r,?))(t)|&lt;\epsilon)&gt;1-\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p14" class="ltx_para ltx_noindent">
<p id="A3.SS1.p14.1" class="ltx_p"><span id="A3.SS1.p14.1.1" class="ltx_text">For simplicity, let us consider a situation where only a single walk <math id="A3.SS1.p14.m1" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> of length <math id="A3.SS1.p14.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> is sampled by the model (otherwise, omit additional walks).
We will also restrict the argument to a single refinement case – the result can be extended to multiple refinement steps by returning <math id="A3.SS1.p14.m3" class="ltx_Math" alttext="\Delta\mathbf{v},\Delta\mathbf{r}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi></mrow><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐫</mi></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta\mathbf{v},\Delta\mathbf{r}=0</annotation></semantics></math> during all additional iterations.
Consider a sequence processor <math id="A3.SS1.p14.m4" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math> that given the output <math id="A3.SS1.p14.m5" class="ltx_math_unparsed" alttext="w(\bar{\eta};G,q,\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>;</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(\bar{\eta};G,q,\cdot,\cdot)</annotation></semantics></math> of the recording protocol, creates a graph-query pair <math id="A3.SS1.p14.m6" class="ltx_Math" alttext="(H,q^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,q^{\prime})</annotation></semantics></math> with <math id="A3.SS1.p14.m7" class="ltx_Math" alttext="q^{\prime}=(h_{q^{\prime}},r_{q^{\prime}},?)" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><msub><mi>r</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q^{\prime}=(h_{q^{\prime}},r_{q^{\prime}},?)</annotation></semantics></math> using the strategy described in the proof of Lemma <a href="#A3.Thmglobalcounter5" title="Lemma C.5. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.5</span></a>, and returns a vector
<math id="A3.SS1.p14.m8" class="ltx_Math" alttext="\mathbf{h}\in\mathbb{R}^{l+1}" display="inline" intent=":literal"><semantics><mrow><mi>𝐡</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{h}\in\mathbb{R}^{l+1}</annotation></semantics></math> whose <math id="A3.SS1.p14.m9" class="ltx_Math" alttext="i^{\text{th}}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mtext>th</mtext></msup><annotation encoding="application/x-tex">i^{\text{th}}</annotation></semantics></math> entry is equal <math id="A3.SS1.p14.m10" class="ltx_Math" alttext="\mathbf{h}_{i}=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(v_{i};\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mi>i</mi></msub><mo>=</mo><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><msub><mi>r</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{i}=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(v_{i};\bar{\eta}))</annotation></semantics></math> where <math id="A3.SS1.p14.m11" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> is the <math id="A3.SS1.p14.m12" class="ltx_Math" alttext="i^{\text{th}}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mtext>th</mtext></msup><annotation encoding="application/x-tex">i^{\text{th}}</annotation></semantics></math> node visited by <math id="A3.SS1.p14.m13" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math>.
The consensus protocol <math id="A3.SS1.p14.m14" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, provided <math id="A3.SS1.p14.m15" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> was visited by <math id="A3.SS1.p14.m16" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math>, can then identify <math id="A3.SS1.p14.m17" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> as one of the <math id="A3.SS1.p14.m18" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math> and pull the corresponding embedding
<math id="A3.SS1.p14.m19" class="ltx_Math" alttext="\mathbf{h}_{j}=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(t;\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mi>j</mi></msub><mo>=</mo><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><msub><mi>r</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{h}_{j}=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(t;\bar{\eta}))</annotation></semantics></math>, returning it as the output <math id="A3.SS1.p14.m20" class="ltx_Math" alttext="\mathbf{v}(t)=\mathbf{h}_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝐡</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{v}(t)=\mathbf{h}_{j}</annotation></semantics></math> (note that no matter which specific value of <math id="A3.SS1.p14.m21" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is chosen, this value will be the same).
Finally, the classification head can work as an identity operation, returning <math id="A3.SS1.p14.m22" class="ltx_Math" alttext="X_{\theta}(G,q)(t)=\mathbf{v}(t)=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(t;\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝐯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><msub><mi>r</mi><msup><mi>q</mi><mo>′</mo></msup></msub><mo>,</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>;</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{\theta}(G,q)(t)=\mathbf{v}(t)=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(t;\bar{\eta}))</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS1.p15" class="ltx_para ltx_noindent">
<p id="A3.SS1.p15.1" class="ltx_p"><span id="A3.SS1.p15.1.1" class="ltx_text">We claim that if the sampled walk <math id="A3.SS1.p15.m1" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> traverses all edges of <math id="A3.SS1.p15.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, then the output of the <span id="A3.SS1.p15.1.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> model described above satisfies:</span></p>
<table id="A3.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\varphi(G)((h,r,t))=X_{\theta}(G,(h,r,?))(t)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi(G)((h,r,t))=X_{\theta}(G,(h,r,?))(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p15.2" class="ltx_p"><span id="A3.SS1.p15.2.1" class="ltx_text">By Lemma <a href="#A3.Thmglobalcounter5" title="Lemma C.5. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.5</span></a>, in such case, the reconstructed pair <math id="A3.SS1.p15.m4" class="ltx_Math" alttext="(H,q^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,q^{\prime})</annotation></semantics></math> is isomorphic to <math id="A3.SS1.p15.m5" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math> by the isomorphism <math id="A3.SS1.p15.m6" class="ltx_Math" alttext="id=(\operatorname{id}_{V}(\cdot;\bar{\eta}),\operatorname{id}_{R}(\cdot;\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><mi>V</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>id</mi><mi>R</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">id=(\operatorname{id}_{V}(\cdot;\bar{\eta}),\operatorname{id}_{R}(\cdot;\bar{\eta}))</annotation></semantics></math>.
Since <math id="A3.SS1.p15.m7" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is link invariant, we can write:</span></p>
<table id="A3.Ex38" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex38X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex38X.m2" class="ltx_Math" alttext="\displaystyle\varphi(G)((h,r,t))" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\varphi(G)((h,r,t))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38X.m3" class="ltx_Math" alttext="\displaystyle=\varphi(\operatorname{id}(G))((\operatorname{id}_{V}(h;\bar{\eta}),\operatorname{id}_{R}(r;\bar{\eta}),\operatorname{id}_{V}(t;\bar{\eta})))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>id</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\varphi(\operatorname{id}(G))((\operatorname{id}_{V}(h;\bar{\eta}),\operatorname{id}_{R}(r;\bar{\eta}),\operatorname{id}_{V}(t;\bar{\eta})))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex38Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38Xa.m2" class="ltx_Math" alttext="\displaystyle=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(t;\bar{\eta})))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\varphi(H)((h_{q^{\prime}},r_{q^{\prime}},\operatorname{id}_{V}(t;\bar{\eta})))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex38Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38Xb.m2" class="ltx_Math" alttext="\displaystyle=X_{\theta}(G,(h,r,?))(t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=X_{\theta}(G,(h,r,?))(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p16" class="ltx_para ltx_noindent">
<p id="A3.SS1.p16.1" class="ltx_p"><span id="A3.SS1.p16.1.1" class="ltx_text">Therefore, whenever the walk <math id="A3.SS1.p16.m1" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> witnesses all edges of <math id="A3.SS1.p16.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, the output of the <span id="A3.SS1.p16.1.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> model satisfies:</span></p>
<table id="A3.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex39.m1" class="ltx_Math" alttext="\varphi(G)((h,r,t))=X_{\theta}(G,(h,r,?))(t)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi(G)((h,r,t))=X_{\theta}(G,(h,r,?))(t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p17" class="ltx_para ltx_noindent">
<p id="A3.SS1.p17.1" class="ltx_p"><span id="A3.SS1.p17.1.1" class="ltx_text">Hence, to show (<a href="#A3.E9" title="Equation 9 ‣ Proof. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), it suffices to prove that we can uniformly choose the length <math id="A3.SS1.p17.m1" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> of the random walk so that the probability of <math id="A3.SS1.p17.m2" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> covering all the edges is greater than <math id="A3.SS1.p17.m3" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>.
By Markov’s inequality:</span></p>
<table id="A3.Ex40" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex40X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex40X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(\bar{\eta}\text{ does not cover all edges})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext> does not cover all edges</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(\bar{\eta}\text{ does not cover all edges})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40X.m3" class="ltx_Math" alttext="\displaystyle={\mathbb{P}}(\text{it takes }&gt;l\text{ steps for }\eta\text{ to cover edges of }G)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>it takes </mtext><mo>&gt;</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mtext> steps for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mtext> to cover edges of </mtext><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbb{P}}(\text{it takes }&gt;l\text{ steps for }\eta\text{ to cover edges of }G)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex40Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{\mathbb{E}[\text{\#steps such that }\eta\text{ covers all edges of }G]}{l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>#steps such that </mtext><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mtext> covers all edges of </mtext><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mi>l</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\mathbb{E}[\text{\#steps such that }\eta\text{ covers all edges of }G]}{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex40Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{C_{E}(G)}{l}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mi>l</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{C_{E}(G)}{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p17.2" class="ltx_p"><span id="A3.SS1.p17.2.1" class="ltx_text">But by Lemma <a href="#A3.Thmglobalcounter4" title="Lemma C.4. ‣ C.1 Expressivity ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.4</span></a>, <math id="A3.SS1.p17.m4" class="ltx_Math" alttext="C_{E}(G)\leq C_{n,m}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">C_{E}(G)\leq C_{n,m}</annotation></semantics></math> for some constant <math id="A3.SS1.p17.m5" class="ltx_Math" alttext="C_{n,m}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">C_{n,m}</annotation></semantics></math>.
Hence, taking <math id="A3.SS1.p17.m6" class="ltx_Math" alttext="l&gt;\frac{C_{n,m}}{\delta}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>&gt;</mo><mfrac><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mi>δ</mi></mfrac></mrow><annotation encoding="application/x-tex">l&gt;\frac{C_{n,m}}{\delta}</annotation></semantics></math>, we get:</span></p>
<table id="A3.Ex41" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex41X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex41X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(\bar{\eta}\text{ does not cover all edges})\leq\frac{C_{E}(G)}{l}\leq\frac{C_{n,m}}{l}&lt;\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext> does not cover all edges</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>C</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mi>l</mi></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mi>l</mi></mfrac></mstyle><mo>&lt;</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(\bar{\eta}\text{ does not cover all edges})\leq\frac{C_{E}(G)}{l}\leq\frac{C_{n,m}}{l}&lt;\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p17.3" class="ltx_p"><span id="A3.SS1.p17.3.1" class="ltx_text">This means that for such a choice of <math id="A3.SS1.p17.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>:</span></p>
<table id="A3.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex42.m1" class="ltx_Math" alttext="{\mathbb{P}}(\bar{\eta}\text{ witnesses all edges of }G)&gt;1-\delta" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mtext> witnesses all edges of </mtext><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\bar{\eta}\text{ witnesses all edges of }G)&gt;1-\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p17.4" class="ltx_p"><span id="A3.SS1.p17.4.1" class="ltx_text">which leads to the conclusion that for <math id="A3.SS1.p17.m8" class="ltx_Math" alttext="l&gt;\frac{C_{n,m}}{\delta}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>&gt;</mo><mfrac><msub><mi>C</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub><mi>δ</mi></mfrac></mrow><annotation encoding="application/x-tex">l&gt;\frac{C_{n,m}}{\delta}</annotation></semantics></math>, the proposed <span id="A3.SS1.p17.4.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> framework satisfies:</span></p>
<table id="A3.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex43.m1" class="ltx_Math" alttext="{\mathbb{P}}(|\varphi(G)((h,r,t))-X_{\theta}(G,(h,r,?))(t)|&lt;\epsilon)&gt;1-\delta" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(|\varphi(G)((h,r,t))-X_{\theta}(G,(h,r,?))(t)|&lt;\epsilon)&gt;1-\delta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p17.5" class="ltx_p"><span id="A3.SS1.p17.5.1" class="ltx_text">for any choice of <math id="A3.SS1.p17.m10" class="ltx_Math" alttext="G=(V,E,R)\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G=(V,E,R)\in\mathbb{K}_{n,m}</annotation></semantics></math> and <math id="A3.SS1.p17.m11" class="ltx_Math" alttext="(h,r,t)\in V\times R\times V" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">(h,r,t)\in V\times R\times V</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Invariance</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">First, let us recall the definition of invariance for the context of knowledge graphs and the associated notion of invariance in probability.
We say that a function <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> taking KGs as input is invariant if for any pair of isomorphic KGs <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="G\simeq H" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>≃</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">G\simeq H</annotation></semantics></math> it produces the same input, i.e. <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="G\simeq H\implies\varphi(G)=\varphi(H)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>≃</mo><mi>H</mi><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\simeq H\implies\varphi(G)=\varphi(H)</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p">We extend the notion of invariance for further types of inputs, not limited to full knowledge graphs, particularly to random walks and link prediction queries.
Let <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="G=(V,E,R)\in\mathbb{K}_{n,m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝕂</mi><mrow><mi>n</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G=(V,E,R)\in\mathbb{K}_{n,m}</annotation></semantics></math> and let <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="H=(V^{\prime},E^{\prime},R^{\prime})\simeq G" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>≃</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">H=(V^{\prime},E^{\prime},R^{\prime})\simeq G</annotation></semantics></math> be a KG isomorphic to <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> via the isomorphism <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="\mu=(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu=(\pi,\phi)</annotation></semantics></math>. For any <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="h\in V" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">h\in V</annotation></semantics></math> and <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="r\in R" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">r\in R</annotation></semantics></math>, we identify the link prediction query <math id="A3.SS2.p2.m7" class="ltx_Math" alttext="q=(h,r,?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h,r,?)</annotation></semantics></math> in <math id="A3.SS2.p2.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> using the isomorphism <math id="A3.SS2.p2.m9" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> as:</p>
<table id="A3.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex44.m1" class="ltx_Math" alttext="\mu(q)=\mu((h,r,?))=(\pi(h),\phi(r),?)" display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">(</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo>,</mo><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(q)=\mu((h,r,?))=(\pi(h),\phi(r),?)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p">Similarly, let <math id="A3.SS2.p2.m10" class="ltx_Math" alttext="\eta=v_{0}\xrightarrow{r_{1}}\dots\xrightarrow{r_{l}}v_{l}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>v</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">\eta=v_{0}\xrightarrow{r_{1}}\dots\xrightarrow{r_{l}}v_{l}</annotation></semantics></math> be a walk of length <math id="A3.SS2.p2.m11" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> in <math id="A3.SS2.p2.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.
The view of <math id="A3.SS2.p2.m13" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> with <math id="A3.SS2.p2.m14" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> is defined as:</p>
<table id="A3.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\mu\left(v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}\right)=\pi(v_{0})\xrightarrow{\phi(r_{1})}\pi(v_{1})\xrightarrow{\phi(r_{2})}\dots\xrightarrow{\phi(r_{l})}\pi(v_{l})" display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>v</mi><mi>l</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">l</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu\left(v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}\right)=\pi(v_{0})\xrightarrow{\phi(r_{1})}\pi(v_{1})\xrightarrow{\phi(r_{2})}\dots\xrightarrow{\phi(r_{l})}\pi(v_{l})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.p3.1" class="ltx_p">Let <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> be a function taking inputs drawn from KGs. We call <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> invariant if for any pair of isomorphic graphs <math id="A3.SS2.p3.m3" class="ltx_Math" alttext="G\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$\mu$}}}}}}{{\simeq}}H" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mover><mo>≃</mo><mpadded style="width:0pt;" lspace="-2.4pt" width="0pt"><mi>μ</mi></mpadded></mover><mi>H</mi></mrow><annotation encoding="application/x-tex">G\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$\mu$}}}}}}{{\simeq}}H</annotation></semantics></math> and an associated isomorphism <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="\mu=(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu=(\pi,\phi)</annotation></semantics></math>, <math id="A3.SS2.p3.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> satisfies</p>
<table id="A3.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex46.m1" class="ltx_Math" alttext="f(x)=f(\mu(x))" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x)=f(\mu(x))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p3.2" class="ltx_p">where <math id="A3.SS2.p3.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> can be, e.g., a walk or link prediction query.
In words, invariance means that the function preserves output under the re-identifications of the input graph and the induced transformations of queries and walks.</p>
</div>
<div id="A3.SS2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.p4.1" class="ltx_p">This notion extends to functions with multiple inputs, where we enforce the transformation on each graph-related input.
For example, a function <math id="A3.SS2.p4.m1" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> taking a KG, query and a <math id="A3.SS2.p4.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>-dimensional vector is invariant if it satisfies:</p>
<table id="A3.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex47.m1" class="ltx_Math" alttext="\forall G\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$\mu$}}}}}}{{\simeq}}H,q,\mathbf{v}\in\mathbb{R}^{d}:\quad\varphi(G,q,\mathbf{v})=\varphi(\mu(G),\mu(q),\mathbf{v})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>G</mi></mrow><mover><mo>≃</mo><mpadded style="width:0pt;" lspace="-2.4pt" width="0pt"><mi>μ</mi></mpadded></mover><mi>H</mi></mrow><mo>,</mo><mi>q</mi><mo>,</mo><mrow><mi>𝐯</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\forall G\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$\mu$}}}}}}{{\simeq}}H,q,\mathbf{v}\in\mathbb{R}^{d}:\quad\varphi(G,q,\mathbf{v})=\varphi(\mu(G),\mu(q),\mathbf{v})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p5" class="ltx_para ltx_noindent">
<p id="A3.SS2.p5.1" class="ltx_p">Following the definition of <span id="A3.SS2.p5.1.1" class="ltx_text ltx_font_italic">invariance in probability</span>, provided in <a href="#S3" title="3 Preliminary ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3</span></a>, we extend all the definitions above to the stochastic case, replacing equality (<math id="A3.SS2.p5.m1" class="ltx_Math" alttext="=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">=</annotation></semantics></math>) with equality in distribution (<math id="A3.SS2.p5.m2" class="ltx_Math" alttext="\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}" display="inline" intent=":literal"><semantics><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><annotation encoding="application/x-tex">\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}</annotation></semantics></math>).</p>
</div>
<div id="A3.SS2.p6" class="ltx_para ltx_noindent">
<p id="A3.SS2.p6.1" class="ltx_p">We can now prove the main propositions stated in <a href="#S4.SS2" title="4.2 Theoretical properties of Flock ‣ 4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4.2</span></a>.
Let’s begin with the more general:</p>
</div>
<div id="Thminnercustomprop2" class="ltx_theorem ltx_theorem_innercustomprop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thminnercustomprop2.2" class="ltx_text ltx_font_bold">Proposition </span><a href="#S4.Thmglobalcounter2" title="Proposition 4.2. ‣ 4.2 Theoretical properties of Flock ‣ 4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref ltx_font_bold"><span class="ltx_text ltx_ref_tag">4.2</span></a></span><span id="Thminnercustomprop2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thminnercustomprop2.p1" class="ltx_para">
<p id="Thminnercustomprop2.p1.1" class="ltx_p"><span id="Thminnercustomprop2.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the walk sampling protocol <math id="Thminnercustomprop2.p1.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is invariant in probability and both the recording protocol <math id="Thminnercustomprop2.p1.m2" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and the consensus protocol <math id="Thminnercustomprop2.p1.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> are invariant.
Then, regardless of the choice of the deterministic sequence processor <math id="Thminnercustomprop2.p1.m4" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math>, the corresponding <span id="Thminnercustomprop2.p1.1.1.1" class="ltx_text ltx_font_smallcaps">Flock</span> model is invariant in probability.</span></p>
</div>
</div>
<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p7" class="ltx_para ltx_noindent">
<p id="A3.SS2.p7.1" class="ltx_p"><span id="A3.SS2.p7.1.1" class="ltx_text">Let <math id="A3.SS2.p7.m1" class="ltx_Math" alttext="(V,E,R)=G\simeq H=(V^{\prime},E^{\prime},R^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>G</mi><mo>≃</mo><mi>H</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>′</mo></msup><mo>,</mo><msup><mi>E</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(V,E,R)=G\simeq H=(V^{\prime},E^{\prime},R^{\prime})</annotation></semantics></math> be isomorphic knowledge graphs with isomorphism <math id="A3.SS2.p7.m2" class="ltx_Math" alttext="\mu=(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu=(\pi,\phi)</annotation></semantics></math> transforming <math id="A3.SS2.p7.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> into <math id="A3.SS2.p7.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.
Our goal is to show that when the statement conditions are met for a <span id="A3.SS2.p7.1.1.1" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> model <math id="A3.SS2.p7.m6" class="ltx_Math" alttext="X_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">X_{\theta}</annotation></semantics></math> with <math id="A3.SS2.p7.m7" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> refinement steps, then for any link prediction query <math id="A3.SS2.p7.m8" class="ltx_Math" alttext="q=(h,r,?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h,r,?)</annotation></semantics></math> and any target node <math id="A3.SS2.p7.m9" class="ltx_Math" alttext="t\in V" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">t\in V</annotation></semantics></math>, the prediction of <span id="A3.SS2.p7.1.1.2" class="ltx_text ltx_markedasmath ltx_font_smallcaps">Flock</span> for <math id="A3.SS2.p7.m11" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> over <math id="A3.SS2.p7.m12" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math> is an identical random variable to the prediction for <math id="A3.SS2.p7.m13" class="ltx_Math" alttext="\pi(t)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(t)</annotation></semantics></math> over <math id="A3.SS2.p7.m14" class="ltx_Math" alttext="(H,\mu(q))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,\mu(q))</annotation></semantics></math>, i.e.</span></p>
<table id="A3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex48.m1" class="ltx_Math" alttext="X_{\theta}(G,q)(t)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}X_{\theta}(H,\mu(q))(\pi(t))" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{\theta}(G,q)(t)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}X_{\theta}(H,\mu(q))(\pi(t))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p7.2" class="ltx_p"><span id="A3.SS2.p7.2.1" class="ltx_text">where <math id="A3.SS2.p7.m15" class="ltx_Math" alttext="\mu(q)=(\pi(h),\phi(r),?)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(q)=(\pi(h),\phi(r),?)</annotation></semantics></math>. Recall that these predictions are defined as:</span></p>
<table id="A3.Ex49" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex49X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex49X.m2" class="ltx_Math" alttext="\displaystyle X_{\theta}(G,q)(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X_{\theta}(G,q)(t)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex49X.m3" class="ltx_Math" alttext="\displaystyle\coloneqq{\rm head}({\bf v}^{(I)}(t)+{\bf r}^{(I)}(r))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≔</mo><mrow><mi>head</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>𝐫</mi><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\coloneqq{\rm head}({\bf v}^{(I)}(t)+{\bf r}^{(I)}(r))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex49Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex49Xa.m2" class="ltx_Math" alttext="\displaystyle X_{\theta}(H,\mu(q))(\pi(t))" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X_{\theta}(H,\mu(q))(\pi(t))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex49Xa.m3" class="ltx_Math" alttext="\displaystyle\coloneqq{\rm head}({\bf v^{\prime}}^{(I)}(\pi(t))+{\bf r^{\prime}}^{(I)}(\phi(r)))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≔</mo><mrow><mi>head</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mmultiscripts><mi>𝐯</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mmultiscripts><mi>𝐫</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\coloneqq{\rm head}({\bf v^{\prime}}^{(I)}(\pi(t))+{\bf r^{\prime}}^{(I)}(\phi(r)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p7.3" class="ltx_p"><span id="A3.SS2.p7.3.1" class="ltx_text">As <math id="A3.SS2.p7.m16" class="ltx_Math" alttext="{\rm head}" display="inline" intent=":literal"><semantics><mi>head</mi><annotation encoding="application/x-tex">{\rm head}</annotation></semantics></math> is a deterministic map, it suffices to show that the final embeddings <math id="A3.SS2.p7.m17" class="ltx_Math" alttext="\mathbf{v}^{(I)},\mathbf{r}^{(I)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝐫</mi><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{v}^{(I)},\mathbf{r}^{(I)}</annotation></semantics></math> for <math id="A3.SS2.p7.m18" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math> and <math id="A3.SS2.p7.m19" class="ltx_Math" alttext="\mathbf{v^{\prime}}^{(I)},\mathbf{r^{\prime}}^{(I)}" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝐯</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝐫</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathbf{v^{\prime}}^{(I)},\mathbf{r^{\prime}}^{(I)}</annotation></semantics></math> for <math id="A3.SS2.p7.m20" class="ltx_Math" alttext="(H,\mu(q))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,\mu(q))</annotation></semantics></math> satisfy:</span></p>
<table id="A3.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex50.m1" class="ltx_Math" alttext="\&gt;\mathbf{v}^{(I)}(v)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{v^{\prime}}^{(I)}(\pi(v))\quad\text{and}\quad\mathbf{r}^{(I)}(r)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{r^{\prime}}^{(I)}(\phi(r))\qquad\forall v\in V,r\in R" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mmultiscripts><mi>𝐯</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msup><mi>𝐫</mi><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mmultiscripts><mi>𝐫</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>v</mi></mrow><mo>∈</mo><mi>V</mi></mrow><mo>,</mo><mrow><mi>r</mi><mo>∈</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">\&gt;\mathbf{v}^{(I)}(v)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{v^{\prime}}^{(I)}(\pi(v))\quad\text{and}\quad\mathbf{r}^{(I)}(r)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{r^{\prime}}^{(I)}(\phi(r))\qquad\forall v\in V,r\in R</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p7.4" class="ltx_p"><span id="A3.SS2.p7.4.1" class="ltx_text">We will prove this result by induction on the number of layers <math id="A3.SS2.p7.m21" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. The base case <math id="A3.SS2.p7.m22" class="ltx_Math" alttext="i=0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i=0</annotation></semantics></math> is trivial, as we initialize the embeddings of all nodes with a pretrained vector <math id="A3.SS2.p7.m23" class="ltx_Math" alttext="\mathbf{v}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐯</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbf{v}_{0}</annotation></semantics></math>, and all relations with <math id="A3.SS2.p7.m24" class="ltx_Math" alttext="\mathbf{r}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝐫</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathbf{r}_{0}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS2.p8" class="ltx_para ltx_noindent">
<p id="A3.SS2.p8.1" class="ltx_p"><span id="A3.SS2.p8.1.1" class="ltx_text">For the induction step, suppose the claim holds for <math id="A3.SS2.p8.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.
We drop the superscript <math id="A3.SS2.p8.m2" class="ltx_Math" alttext="(i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i)</annotation></semantics></math> for readability.
The result for <math id="A3.SS2.p8.m3" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math> becomes apparent by unfolding the definitions of invariance of the considered components.
Since <math id="A3.SS2.p8.m4" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is invariant in probability, we have</span></p>
<table id="A3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E10.m1" class="ltx_Math" alttext="\mu(\eta(G))\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\eta(H)" display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu(\eta(G))\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\eta(H)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p8.2" class="ltx_p"><span id="A3.SS2.p8.2.1" class="ltx_text">Let <math id="A3.SS2.p8.m5" class="ltx_Math" alttext="\eta_{1},\dots,\eta_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\eta_{1},\dots,\eta_{n}</annotation></semantics></math> be the random walks over <math id="A3.SS2.p8.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> using <math id="A3.SS2.p8.m7" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> and <math id="A3.SS2.p8.m8" class="ltx_Math" alttext="\eta_{1}^{\prime},\dots,\eta_{n}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>η</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>η</mi><mi>n</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\eta_{1}^{\prime},\dots,\eta_{n}^{\prime}</annotation></semantics></math> be random walks over <math id="A3.SS2.p8.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.
Now, <math id="A3.SS2.p8.m10" class="ltx_Math" alttext="\eta_{1},\dots,\eta_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\eta_{1},\dots,\eta_{n}</annotation></semantics></math> are independent and identically distributed random variables, each following the distribution <math id="A3.SS2.p8.m11" class="ltx_Math" alttext="\eta_{j}\sim\eta(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{j}\sim\eta(G)</annotation></semantics></math>. Similarly, using (<a href="#A3.E10" title="Equation 10 ‣ Proof. ‣ C.2 Invariance ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>):</span></p>
<table id="A3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E11.m1" class="ltx_Math" alttext="\eta_{j}^{\prime}\sim\eta(H)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mu(\eta(G))\implies\eta_{j}^{\prime}\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mu(\eta_{j})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>η</mi><mi>j</mi><mo>′</mo></msubsup><mo>∼</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟹</mo><msubsup><mi>η</mi><mi>j</mi><mo>′</mo></msubsup><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{j}^{\prime}\sim\eta(H)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mu(\eta(G))\implies\eta_{j}^{\prime}\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mu(\eta_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p9" class="ltx_para ltx_noindent">
<p id="A3.SS2.p9.1" class="ltx_p"><span id="A3.SS2.p9.1.1" class="ltx_text">As the recording protocol <math id="A3.SS2.p9.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is invariant,
<math id="A3.SS2.p9.m2" class="ltx_Math" alttext="w(\eta_{j})\!\!=\!w(\mu(\eta_{j}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>j</mi></msub><mpadded style="width:0.327em;" width="0.327em"><mo stretchy="false">)</mo></mpadded></mrow></mrow><mo rspace="0.108em">=</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w(\eta_{j})\!\!=\!w(\mu(\eta_{j}))</annotation></semantics></math>
for all <math id="A3.SS2.p9.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>,
which with (<a href="#A3.E11" title="Equation 11 ‣ Proof. ‣ C.2 Invariance ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) yields:</span></p>
<table id="A3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E12.m1" class="ltx_Math" alttext="\mathbf{z}_{j}:=w(\eta_{j})=w(\mu(\eta_{j}))\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}w(\eta_{j}^{\prime}):=\mathbf{z^{\prime}_{j}}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐳</mi><mi>j</mi></msub><mo>:=</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>η</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msubsup><mi>𝐳</mi><mi>𝐣</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{z}_{j}:=w(\eta_{j})=w(\mu(\eta_{j}))\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}w(\eta_{j}^{\prime}):=\mathbf{z^{\prime}_{j}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p10" class="ltx_para ltx_noindent">
<p id="A3.SS2.p10.1" class="ltx_p"><span id="A3.SS2.p10.1.1" class="ltx_text">Then, <math id="A3.SS2.p10.m1" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math> is a deterministic map, so (<a href="#A3.E12" title="Equation 12 ‣ Proof. ‣ C.2 Invariance ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) implies:</span></p>
<table id="A3.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\mathbf{h}_{j}:=f_{\theta}(\mathbf{z}_{j})\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}f_{\theta}(\mathbf{z}^{\prime}_{j}):=\mathbf{h}_{j}^{\prime}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐡</mi><mi>j</mi></msub><mo>:=</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐳</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msubsup><mi>𝐡</mi><mi>j</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{h}_{j}:=f_{\theta}(\mathbf{z}_{j})\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}f_{\theta}(\mathbf{z}^{\prime}_{j}):=\mathbf{h}_{j}^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p11" class="ltx_para ltx_noindent">
<p id="A3.SS2.p11.1" class="ltx_p"><span id="A3.SS2.p11.1.1" class="ltx_text">Let <math id="A3.SS2.p11.m1" class="ltx_math_unparsed" alttext="(\Delta\mathbf{v},\Delta\mathbf{r})=c(\mathbf{h}_{1:N},\eta_{1:N})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>𝐯</mi><mo>,</mo><mi mathvariant="normal">Δ</mi><mi>𝐫</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐡</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><msub><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\Delta\mathbf{v},\Delta\mathbf{r})=c(\mathbf{h}_{1:N},\eta_{1:N})</annotation></semantics></math>, <math id="A3.SS2.p11.m2" class="ltx_math_unparsed" alttext="(\Delta\mathbf{v}^{\prime},\Delta\mathbf{r}^{\prime})=c(\mathbf{h}^{\prime}_{1:N},\eta^{\prime}_{1:N})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msup><mi>𝐯</mi><mo>′</mo></msup><mo>,</mo><mi mathvariant="normal">Δ</mi><msup><mi>𝐫</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐡</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\Delta\mathbf{v}^{\prime},\Delta\mathbf{r}^{\prime})=c(\mathbf{h}^{\prime}_{1:N},\eta^{\prime}_{1:N})</annotation></semantics></math> be the outputs of the consensus protocol.
We will denote by <math id="A3.SS2.p11.m3" class="ltx_Math" alttext="c_{\mathbf{v}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>𝐯</mi></msub><annotation encoding="application/x-tex">c_{\mathbf{v}}</annotation></semantics></math> and <math id="A3.SS2.p11.m4" class="ltx_Math" alttext="c_{\mathbf{r}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>𝐫</mi></msub><annotation encoding="application/x-tex">c_{\mathbf{r}}</annotation></semantics></math>, the restrictions to the first and second output, e.g. <math id="A3.SS2.p11.m5" class="ltx_math_unparsed" alttext="\Delta\mathbf{v}=c_{\mathbf{v}}(\mathbf{h}_{1:N},\eta_{1:N})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mi>𝐯</mi><mo>=</mo><msub><mi>c</mi><mi>𝐯</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝐡</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><msub><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{v}=c_{\mathbf{v}}(\mathbf{h}_{1:N},\eta_{1:N})</annotation></semantics></math>.
Let <math id="A3.SS2.p11.m6" class="ltx_Math" alttext="\mathbf{x}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{x}\in\mathbb{R}^{d}</annotation></semantics></math> be a vector, and denote by <math id="A3.SS2.p11.m7" class="ltx_Math" alttext="\mathcal{W}(G)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{W}(G)</annotation></semantics></math> the space of walks over <math id="A3.SS2.p11.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. For any vertex <math id="A3.SS2.p11.m9" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, the probability that <math id="A3.SS2.p11.m10" class="ltx_Math" alttext="\Delta\mathbf{v}(v)=\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow><annotation encoding="application/x-tex">\Delta\mathbf{v}(v)=\mathbf{x}</annotation></semantics></math> equals:</span></p>
</div>
<div id="A3.SS2.p12" class="ltx_para ltx_noindent">
<table id="A3.Ex52" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex52X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex52X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(\Delta\mathbf{v}(v)=\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(\Delta\mathbf{v}(v)=\mathbf{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52X.m3" class="ltx_Math" alttext="\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(\Delta\mathbf{v}(v)=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>𝐯</mi><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo>=</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(\Delta\mathbf{v}(v)=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(c_{\mathbf{v}}(\mathbf{h}_{1:N},\eta_{1:N})=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mi>𝐯</mi></msub><mo stretchy="false">(</mo><mi>𝐡</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>,</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(c_{\mathbf{v}}(\mathbf{h}_{1:N},\eta_{1:N})=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(c_{\mathbf{v}}(f_{\theta}(w(\eta_{1:N})),\eta_{1:N})=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mi>𝐯</mi></msub><mo stretchy="false">(</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>,</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(c_{\mathbf{v}}(f_{\theta}(w(\eta_{1:N})),\eta_{1:N})=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52Xc.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>c</mi><msub><mrow></mrow><mi>𝐯</mi></msub><mo stretchy="false">(</mo><mi>f</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo><mo>=</mo><mi>𝐱</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\bar{\eta}\in\mathcal{W}(G)^{n}}{\mathbb{P}}(c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})=\mathbf{x}|\eta_{1:N}=\bar{\eta})\cdot{\mathbb{P}}(\eta_{1:N}=\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52Xd.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}{\mathbb{P}}(\eta_{1:N}=\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}{\mathbb{P}}(\eta_{1:N}=\bar{\eta})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS2.p13" class="ltx_para ltx_noindent">
<p id="A3.SS2.p13.3" class="ltx_p"><span id="A3.SS2.p13.3.1" class="ltx_text">Similarly, we can derive:</span></p>
<table id="A3.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex53.m1" class="ltx_math_unparsed" alttext="{\mathbb{P}}(\Delta\mathbf{v}^{\prime}(\pi(v))=\mathbf{x})=\sum_{\begin{subarray}{c}\bar{\eta}^{\prime}\in\mathcal{W}(H)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta}^{\prime})),\bar{\eta}^{\prime})(\pi(v))=\mathbf{x}\end{subarray}}{\mathbb{P}}(\eta^{\prime}_{1:N}=\bar{\eta}^{\prime})" display="block" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><msup><mi>𝐯</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></munder><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow><mo>′</mo></msubsup><mo>=</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\Delta\mathbf{v}^{\prime}(\pi(v))=\mathbf{x})=\sum_{\begin{subarray}{c}\bar{\eta}^{\prime}\in\mathcal{W}(H)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta}^{\prime})),\bar{\eta}^{\prime})(\pi(v))=\mathbf{x}\end{subarray}}{\mathbb{P}}(\eta^{\prime}_{1:N}=\bar{\eta}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.4" class="ltx_p"><span id="A3.SS2.p13.4.1" class="ltx_text">Using the invariance of the consensus protocol and the invariance of <math id="A3.SS2.p13.m1" class="ltx_Math" alttext="f_{\theta}\circ w" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>w</mi></mrow><annotation encoding="application/x-tex">f_{\theta}\circ w</annotation></semantics></math>, we can write:</span></p>
<table id="A3.Ex54" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex54X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex54X.m2" class="ltx_Math" alttext="\displaystyle c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta}^{\prime})),\bar{\eta}^{\prime})(\pi(v))" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta}^{\prime})),\bar{\eta}^{\prime})(\pi(v))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54X.m3" class="ltx_Math" alttext="\displaystyle=c_{\mathbf{v}}(f_{\theta}(w(\mu(\bar{\eta}))),\mu(\bar{\eta}))(\pi(v))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=c_{\mathbf{v}}(f_{\theta}(w(\mu(\bar{\eta}))),\mu(\bar{\eta}))(\pi(v))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex54Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54Xa.m2" class="ltx_Math" alttext="\displaystyle=c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\mu(\bar{\eta}))(\pi(v))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\mu(\bar{\eta}))(\pi(v))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex54Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
