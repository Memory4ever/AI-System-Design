<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E15X.m3" class="ltx_Math" alttext="\displaystyle{\displaystyle\mathbb{P}}(V_{0}=v_{0})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\displaystyle\mathbb{P}}(V_{0}=v_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(15)</span></td></tr>
<tr id="A3.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E15Xa.m2" class="ltx_Math" alttext="\displaystyle\cdot{\mathbb{P}}(V_{1}=v_{1}\mid V_{0}=v_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><msub><mi>v</mi><mn>1</mn></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot{\mathbb{P}}(V_{1}=v_{1}\mid V_{0}=v_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E15Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
