<figure id="A6.T7.st2" class="ltx_table ltx_figure_panel ltx_align_center">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">(b) </span>Zero-shot performance for relation prediction.</figcaption>
<table id="A6.T7.st2.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A6.T7.st2.2.1" class="ltx_tr">
