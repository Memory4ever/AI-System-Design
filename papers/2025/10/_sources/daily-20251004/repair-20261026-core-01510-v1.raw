<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E15Xb.m2" class="ltx_Math" alttext="\displaystyle\cdot\prod^{l-2}_{i=0}{\mathbb{P}}(V_{i+2}=v_{i+2}\mid V_{i+1}=v_{i+1},V_{i}=v_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>l</mi><mo>−</mo><mn>2</mn></mrow></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>V</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><mrow><msub><mi>V</mi><mi>i</mi></msub><mo>=</mo><msub><mi>v</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\prod^{l-2}_{i=0}{\mathbb{P}}(V_{i+2}=v_{i+2}\mid V_{i+1}=v_{i+1},V_{i}=v_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
