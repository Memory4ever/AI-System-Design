<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p16.8" class="ltx_p"><span id="A3.SS2.p16.8.1" class="ltx_text">and <math id="A3.SS2.p16.m14" class="ltx_Math" alttext="P(\eta(H,l)=\mu(\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\eta(H,l)=\mu(\bar{\eta}))</annotation></semantics></math>:</span></p>
