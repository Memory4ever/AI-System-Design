</table>
<p id="A3.SS2.p16.7" class="ltx_p"><span id="A3.SS2.p16.7.1" class="ltx_text">To see this, let us expand the definitions of <math id="A3.SS2.p16.m13" class="ltx_Math" alttext="{\mathbb{P}}(\eta(G,l)=\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\eta(G,l)=\bar{\eta})</annotation></semantics></math>:</span></p>
<table id="A3.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
