<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54Xb.m2" class="ltx_Math" alttext="\displaystyle=c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.5" class="ltx_p"><span id="A3.SS2.p13.5.1" class="ltx_text">The graph isomorphism <math id="A3.SS2.p13.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> defines a bijection between walks <math id="A3.SS2.p13.m3" class="ltx_Math" alttext="\mathcal{W}(G)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{W}(G)</annotation></semantics></math> in <math id="A3.SS2.p13.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and walks <math id="A3.SS2.p13.m5" class="ltx_Math" alttext="\mathcal{W}(H)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{W}(H)</annotation></semantics></math> in <math id="A3.SS2.p13.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, so we can use this correspondence to deduce:</span></p>
<table id="A3.E13" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E13X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E13X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(\Delta\mathbf{v}^{\prime}(\pi(v))=\mathbf{x})\;\;\;=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow><mo rspace="0.840em" stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(\Delta\mathbf{v}^{\prime}(\pi(v))=\mathbf{x})\;\;\;=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E13X.m3" class="ltx_Math" alttext="\displaystyle\sum_{\begin{subarray}{c}\bar{\eta}^{\prime}\in\mathcal{W}(H)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta}^{\prime})),\bar{\eta}^{\prime})(\pi(v))=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\bar{\eta}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\begin{subarray}{c}\bar{\eta}^{\prime}\in\mathcal{W}(H)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta}^{\prime})),\bar{\eta}^{\prime})(\pi(v))=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\bar{\eta}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(13)</span></td></tr>
<tr id="A3.E13Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E13Xa.m2" class="ltx_Math" alttext="\displaystyle\;\;\;=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle\;\;\;=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E13Xa.m3" class="ltx_Math" alttext="\displaystyle\sum_{\begin{subarray}{c}\mu(\bar{\eta})\in\mathcal{W}(H)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\mu(\bar{\eta}))),\mu(\bar{\eta}))(\pi(v))=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\mu(\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mi>μ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\begin{subarray}{c}\mu(\bar{\eta})\in\mathcal{W}(H)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\mu(\bar{\eta}))),\mu(\bar{\eta}))(\pi(v))=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\mu(\bar{\eta}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E13Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E13Xb.m2" class="ltx_Math" alttext="\displaystyle\;\;\;=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle\;\;\;=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E13Xb.m3" class="ltx_Math" alttext="\displaystyle\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\mu(\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></msub><mi>ℙ</mi><mo stretchy="false">(</mo><mi>η</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mi>μ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\mu(\bar{\eta}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.6" class="ltx_p"><span id="A3.SS2.p13.6.1" class="ltx_text">Since <math id="A3.SS2.p13.m7" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is invariant in probability, <math id="A3.SS2.p13.m8" class="ltx_math_unparsed" alttext="{\mathbb{P}}(\eta_{1:N}\!=\!\bar{\eta})={\mathbb{P}}(\eta^{\prime}_{1:N}\!=\!\mu(\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo rspace="0.108em">=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow><mo>′</mo></msubsup><mo rspace="0.108em">=</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\eta_{1:N}\!=\!\bar{\eta})={\mathbb{P}}(\eta^{\prime}_{1:N}\!=\!\mu(\bar{\eta}))</annotation></semantics></math>. Applying this to (<a href="#A3.E13" title="Equation 13 ‣ Proof. ‣ C.2 Invariance ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) yields:</span></p>
<table id="A3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex55.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(\Delta\mathbf{v}^{\prime}(\pi(v))=\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(\Delta\mathbf{v}^{\prime}(\pi(v))=\mathbf{x})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex55.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\mu(\bar{\eta}))" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow><mo>′</mo></msubsup><mo>=</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}\!\!\!\!\!{\mathbb{P}}(\eta^{\prime}_{1:N}=\mu(\bar{\eta}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56.m1" class="ltx_math_unparsed" alttext="\displaystyle=\!\!\!\!\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}\!\!\!\!\!\!\!{\mathbb{P}}(\eta_{1:N}=\bar{\eta})={\mathbb{P}}(\Delta\mathbf{v}(v)=\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:0.376em;" width="0.376em"><mo>=</mo></mpadded><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>c</mi><mi>𝐯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐱</mi></mrow></mtd></mtr></mtable></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>N</mi></mrow></msub><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\!\!\!\!\sum_{\begin{subarray}{c}\bar{\eta}\in\mathcal{W}(G)^{n}\\
c_{\mathbf{v}}(f_{\theta}(w(\bar{\eta})),\bar{\eta})(v)=\mathbf{x}\end{subarray}}\!\!\!\!\!\!\!{\mathbb{P}}(\eta_{1:N}=\bar{\eta})={\mathbb{P}}(\Delta\mathbf{v}(v)=\mathbf{x})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.7" class="ltx_p"><span id="A3.SS2.p13.7.1" class="ltx_text">As <math id="A3.SS2.p13.m9" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> was chosen arbitrarily, we can conclude that <math id="A3.SS2.p13.m10" class="ltx_Math" alttext="\Delta\mathbf{v}(v)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\Delta\mathbf{v}^{\prime}(\pi(v))" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{v}(v)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\Delta\mathbf{v}^{\prime}(\pi(v))</annotation></semantics></math>.
The proof for relations follows analogously, considering <math id="A3.SS2.p13.m11" class="ltx_Math" alttext="c_{\mathbf{r}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>𝐫</mi></msub><annotation encoding="application/x-tex">c_{\mathbf{r}}</annotation></semantics></math> instead of <math id="A3.SS2.p13.m12" class="ltx_Math" alttext="c_{\mathbf{v}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>𝐯</mi></msub><annotation encoding="application/x-tex">c_{\mathbf{v}}</annotation></semantics></math>. This allows us to write:</span></p>
<table id="A3.E14" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E14X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E14X.m2" class="ltx_Math" alttext="\displaystyle\Delta\mathbf{v}(v)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\mathbf{v}(v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E14X.m3" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\Delta\mathbf{v}^{\prime}(\pi(v))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\Delta\mathbf{v}^{\prime}(\pi(v))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E14X.m5" class="ltx_Math" alttext="\displaystyle\quad\forall v\in V" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>v</mi></mrow><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\forall v\in V</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(14)</span></td></tr>
<tr id="A3.E14Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E14Xa.m2" class="ltx_Math" alttext="\displaystyle\Delta\mathbf{r}(r)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta\mathbf{r}(r)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E14Xa.m3" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\Delta\mathbf{r}^{\prime}(\phi(r))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐫</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\Delta\mathbf{r}^{\prime}(\phi(r))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E14Xa.m5" class="ltx_Math" alttext="\displaystyle\quad\forall r\in R" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>r</mi></mrow><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\forall r\in R</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.8" class="ltx_p"><span id="A3.SS2.p13.8.1" class="ltx_text">By the induction hypothesis, <math id="A3.SS2.p13.m13" class="ltx_Math" alttext="\mathbf{v}^{(i)}(v)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{v^{\prime}}^{(i)}(\pi(v))" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mmultiscripts><mi>𝐯</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}^{(i)}(v)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{v^{\prime}}^{(i)}(\pi(v))</annotation></semantics></math> for all <math id="A3.SS2.p13.m14" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> and <math id="A3.SS2.p13.m15" class="ltx_Math" alttext="\mathbf{r}^{(i)}(r)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{r^{\prime}}^{(i)}(r)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐫</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mmultiscripts><mi>𝐫</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{r}^{(i)}(r)\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{r^{\prime}}^{(i)}(r)</annotation></semantics></math> for all <math id="A3.SS2.p13.m16" class="ltx_Math" alttext="r\in R" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">r\in R</annotation></semantics></math>. Therefore, by (<a href="#A3.E14" title="Equation 14 ‣ Proof. ‣ C.2 Invariance ‣ Appendix C Proofs ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), combined with properties of sums of random variables:</span></p>
<table id="A3.Ex57" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex57X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex57X.m2" class="ltx_Math" alttext="\displaystyle\mathbf{v}^{(i+1)}(v):=\mathbf{v}^{(i)}(v)+\Delta\mathbf{v}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msup><mi>𝐯</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{v}^{(i+1)}(v):=\mathbf{v}^{(i)}(v)+\Delta\mathbf{v}(v)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57X.m3" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{v^{\prime}}^{(i)}(\pi(v))+\Delta\mathbf{v}^{\prime}(\pi(v)):=\mathbf{v^{\prime}}^{(i+1)}(\pi(v))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mrow><mmultiscripts><mi>𝐯</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐯</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>:=</mo><mrow><mmultiscripts><mi>𝐯</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{v^{\prime}}^{(i)}(\pi(v))+\Delta\mathbf{v}^{\prime}(\pi(v)):=\mathbf{v^{\prime}}^{(i+1)}(\pi(v))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex57X.m5" class="ltx_Math" alttext="\displaystyle\quad\forall v\in V" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>v</mi></mrow><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\forall v\in V</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex57Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex57Xa.m2" class="ltx_Math" alttext="\displaystyle\mathbf{r}^{(i+1)}(r):=\mathbf{r}^{(i)}(r)+\Delta\mathbf{r}(r)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐫</mi><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msup><mi>𝐫</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{r}^{(i+1)}(r):=\mathbf{r}^{(i)}(r)+\Delta\mathbf{r}(r)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57Xa.m3" class="ltx_Math" alttext="\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{r^{\prime}}^{(i)}(\phi(r))+\Delta\mathbf{r}^{\prime}(\phi(r)):=\mathbf{r^{\prime}}^{(i+1)}(\phi(r))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><mrow><mrow><mmultiscripts><mi>𝐫</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐫</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>:=</mo><mrow><mmultiscripts><mi>𝐫</mi><mrow></mrow><mo>′</mo><mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}\mathbf{r^{\prime}}^{(i)}(\phi(r))+\Delta\mathbf{r}^{\prime}(\phi(r)):=\mathbf{r^{\prime}}^{(i+1)}(\phi(r))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex57Xa.m5" class="ltx_Math" alttext="\displaystyle\quad\forall r\in R" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>r</mi></mrow><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\forall r\in R</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p13.9" class="ltx_p"><span id="A3.SS2.p13.9.1" class="ltx_text">which completes the induction step, and hence the proof.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p14" class="ltx_para ltx_noindent">
<p id="A3.SS2.p14.1" class="ltx_p">We can use the conclusion from Proposition <a href="#S4.Thmglobalcounter2" title="Proposition 4.2. ‣ 4.2 Theoretical properties of Flock ‣ 4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> to prove the probabilistic invariance of the architecture proposed in <a href="#S4" title="4 Methodology ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a>.
To be able to apply it, we first need to verify the invariance of all used components, which we formalize in the following lemmas.</p>
</div>
<div id="A3.Thmglobalcounter6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter6.2" class="ltx_text ltx_font_bold">Lemma C.6</span></span><span id="A3.Thmglobalcounter6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter6.p1" class="ltx_para">
<p id="A3.Thmglobalcounter6.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter6.p1.1.1" class="ltx_text ltx_font_italic">The choice of the first step <math id="A3.Thmglobalcounter6.p1.m1" class="ltx_Math" alttext="v_{0}\xrightarrow{r_{1}}v_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">v_{0}\xrightarrow{r_{1}}v_{1}</annotation></semantics></math> of the uniform random walk algorithm described in <a href="#A2.SS1" title="B.1 Uniform random walk ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> is invariant.</span></p>
</div>
</div>
<div id="A3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p15" class="ltx_para ltx_noindent">
<p id="A3.SS2.p15.1" class="ltx_p"><span id="A3.SS2.p15.1.1" class="ltx_text">Let <math id="A3.SS2.p15.m1" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> be a graph and let <math id="A3.SS2.p15.m2" class="ltx_Math" alttext="H\simeq G" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>≃</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">H\simeq G</annotation></semantics></math> be an isomorphic graph, with the isomorphism <math id="A3.SS2.p15.m3" class="ltx_Math" alttext="\mu=(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu=(\pi,\phi)</annotation></semantics></math> taking <math id="A3.SS2.p15.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> to <math id="A3.SS2.p15.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.
Consider a link prediction query <math id="A3.SS2.p15.m6" class="ltx_Math" alttext="q=(h,r,?)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q=(h,r,?)</annotation></semantics></math> over <math id="A3.SS2.p15.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, and its identification <math id="A3.SS2.p15.m8" class="ltx_Math" alttext="q^{\prime}=\mu(q)=(\pi(h),\phi(r),?)" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q^{\prime}=\mu(q)=(\pi(h),\phi(r),?)</annotation></semantics></math>.
The goal is to show that when using <math id="A3.SS2.p15.m9" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> described in <a href="#A2.SS1" title="B.1 Uniform random walk ‣ Appendix B Methodology - details ‣ Flock: A Knowledge Graph Foundation Model via Learning on Random Walks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> for <math id="A3.SS2.p15.m10" class="ltx_Math" alttext="(G,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,q)</annotation></semantics></math> and <math id="A3.SS2.p15.m11" class="ltx_Math" alttext="(H,q^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,q^{\prime})</annotation></semantics></math>, the first steps:</span></p>
<table id="A3.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex58.m1" class="ltx_Math" alttext="V_{0}\xrightarrow{R_{1}}V_{1}\qquad\text{and}\qquad U_{0}\xrightarrow{S_{1}}U_{1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>V</mi><mn>1</mn></msub></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>and</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><msub><mi>U</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">S</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>U</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">V_{0}\xrightarrow{R_{1}}V_{1}\qquad\text{and}\qquad U_{0}\xrightarrow{S_{1}}U_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p15.2" class="ltx_p"><span id="A3.SS2.p15.2.1" class="ltx_text">of the execution of <math id="A3.SS2.p15.m12" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> over <math id="A3.SS2.p15.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="A3.SS2.p15.m14" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, respectively, satisfy the following property:</span></p>
<table id="A3.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex59.m1" class="ltx_Math" alttext="\pi(V_{0})\xrightarrow{\phi(R_{1})}\pi(V_{1})\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}U_{0}\xrightarrow{S_{1}}U_{1}" display="block" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">1</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><msub><mi>U</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">S</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>U</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\pi(V_{0})\xrightarrow{\phi(R_{1})}\pi(V_{1})\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}U_{0}\xrightarrow{S_{1}}U_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p15.3" class="ltx_p"><span id="A3.SS2.p15.3.1" class="ltx_text">By definition of <math id="A3.SS2.p15.m15" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>, there are three scenarios of choosing the first step, each with probability <math id="A3.SS2.p15.m16" class="ltx_Math" alttext="\frac{1}{3}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>3</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{3}</annotation></semantics></math>.
Hence, it suffices to show that within each scenario, the selection process is invariant in probability:</span></p>
<ul id="A3.I2" class="ltx_itemize" style="--ltx-enum-leftmargin:2em;">
<li id="A3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A3.I2.i1.p1.1" class="ltx_p"><span id="A3.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Scenario 1:</span> selecting the query head as the first node, then proceeding by random. First, <math id="A3.I2.i1.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> takes the head node of <math id="A3.I2.i1.p1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> to the head node of <math id="A3.I2.i1.p1.m3" class="ltx_Math" alttext="q^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mo>′</mo></msup><annotation encoding="application/x-tex">q^{\prime}</annotation></semantics></math>.
Secondly, as isomorphisms preserve the number of neighboring nodes and number of edges between a pair of nodes, we have:</p>
<table id="A3.Ex60" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex60X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex60X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(V_{1}=v\mid V_{0}=h)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mi>v</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>=</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(V_{1}=v\mid V_{0}=h)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex60X.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{h}|}&amp;\text{\!\!if }v\in\mathcal{N}_{h}\\
0&amp;\text{\!\!if }v\notin\mathcal{N}_{h}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>h</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>​​if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>h</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>​​if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>h</mi></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{h}|}&amp;\text{\!\!if }v\in\mathcal{N}_{h}\\
0&amp;\text{\!\!if }v\notin\mathcal{N}_{h}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="2"></td></tr></tbody>
<tbody id="A3.Ex60Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex60Xa.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{\pi(h)}|}&amp;\text{\!\!if }\pi(v)\in\mathcal{N}_{\pi(h)}\\
0&amp;\text{\!\!if }\pi(v)\notin\mathcal{N}_{\pi(h)}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>​​if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>​​if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|\mathcal{N}_{\pi(h)}|}&amp;\text{\!\!if }\pi(v)\in\mathcal{N}_{\pi(h)}\\
0&amp;\text{\!\!if }\pi(v)\notin\mathcal{N}_{\pi(h)}\end{cases}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex60Xa.m4" class="ltx_Math" alttext="\displaystyle={\mathbb{P}}(U_{1}=\pi(v)\mid U_{0}=\pi(h))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>U</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbb{P}}(U_{1}=\pi(v)\mid U_{0}=\pi(h))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I2.i1.p1.2" class="ltx_p">and</p>
<table id="A3.Ex61" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex61X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61X.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{P}}(R_{1}=r\mid V_{1}=w)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mi>r</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>=</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{P}}(R_{1}=r\mid V_{1}=w)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61X.m3" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|E_{(w,h)}|}&amp;\text{if }r(w,h)\in E_{(w,h)}\\
0&amp;\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo mathsize="0.700em">,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|E_{(w,h)}|}&amp;\text{if }r(w,h)\in E_{(w,h)}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61Xa.m2" class="ltx_Math" alttext="\displaystyle=\begin{cases}\frac{1}{|E_{(\pi(w),\pi(h))}|}&amp;\text{if }\phi(r)(\pi(w),\pi(h))\in E_{(\pi(w),\pi(h))}\\
0&amp;\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">|</mo></mrow></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="0.700em">,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\frac{1}{|E_{(\pi(w),\pi(h))}|}&amp;\text{if }\phi(r)(\pi(w),\pi(h))\in E_{(\pi(w),\pi(h))}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex61Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61Xb.m2" class="ltx_Math" alttext="\displaystyle={\mathbb{P}}(S_{1}=\phi(r)\mid U_{1}=\pi(w))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle={\mathbb{P}}(S_{1}=\phi(r)\mid U_{1}=\pi(w))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A3.I2.i2.p1.1" class="ltx_p"><span id="A3.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Scenario 2:</span> selecting an edge with query relation type at random.
Here, we use the fact that isomorphisms preserve the number of edges of a given type.
Hence, <math id="A3.I2.i2.p1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> defines a bijection between the sets of edges with type <math id="A3.I2.i2.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> in <math id="A3.I2.i2.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and type <math id="A3.I2.i2.p1.m4" class="ltx_Math" alttext="\phi(r)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(r)</annotation></semantics></math> in <math id="A3.I2.i2.p1.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>,
which allows us to conclude that this scenario is also invariant in probability.</p>
</div></li>
<li id="A3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I2.i3.p1" class="ltx_para">
<p id="A3.I2.i3.p1.1" class="ltx_p"><span id="A3.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Scenario 3:</span> selecting the first step completely at random. This case is similar to Scenario 1 – using the invariance of the number of neighboring nodes under isomorphism, we can repeat similar calculations in a straightforward manner to show probabilistic invariance.</p>
</div></li>
</ul>
<p id="A3.SS2.p15.4" class="ltx_p"><span id="A3.SS2.p15.4.1" class="ltx_text">Either way, we find that the selection process of the first step of <math id="A3.SS2.p15.m17" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> over <math id="A3.SS2.p15.m18" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> translates naturally via <math id="A3.SS2.p15.m19" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> to the choice of the first step over <math id="A3.SS2.p15.m20" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, proving the desired statement.
∎</span></p>
</div>
</div>
<div id="A3.Thmglobalcounter7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmglobalcounter7.2" class="ltx_text ltx_font_bold">Lemma C.7</span></span><span id="A3.Thmglobalcounter7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmglobalcounter7.p1" class="ltx_para">
<p id="A3.Thmglobalcounter7.p1.1" class="ltx_p"><span id="A3.Thmglobalcounter7.p1.1.1" class="ltx_text ltx_font_italic">Suppose that the first step <math id="A3.Thmglobalcounter7.p1.m1" class="ltx_Math" alttext="v_{0}\xrightarrow{r_{1}}v_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">v_{0}\xrightarrow{r_{1}}v_{1}</annotation></semantics></math> is chosen in an invariant manner.
Then, the uniform random walk with no backtracking algorithm <math id="A3.Thmglobalcounter7.p1.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is invariant in probability.</span></p>
</div>
</div>
<div id="A3.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p16" class="ltx_para ltx_noindent">
<p id="A3.SS2.p16.5" class="ltx_p"><span id="A3.SS2.p16.5.1" class="ltx_text">Let <math id="A3.SS2.p16.m1" class="ltx_Math" alttext="G=(V,E,R)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E,R)</annotation></semantics></math> be a knowledge graph, and let <math id="A3.SS2.p16.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> be the length of random walks.
Let <math id="A3.SS2.p16.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be a KG isomorphic to <math id="A3.SS2.p16.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> via the isomorphism <math id="A3.SS2.p16.m5" class="ltx_Math" alttext="\mu=(\pi,\phi)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu=(\pi,\phi)</annotation></semantics></math>. We aim to show that:</span></p>
<table id="A3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\mu(\eta(G,l))=\pi(V_{0})\xrightarrow{\phi(R_{1})}\pi(V_{1})\xrightarrow{\phi(R_{2})}\dots\xrightarrow{\phi(R_{l})}\pi(V_{l})\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}U_{0}\xrightarrow{S_{1}}U_{1}\xrightarrow{S_{2}}\dots\xrightarrow{S_{l}}U_{l}=\eta(H,l)" display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">1</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">R</mi><mn mathsize="0.710em">2</mn></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><mrow><mi mathsize="0.700em">ϕ</mi><mo>⁡</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">R</mi><mi mathsize="0.710em">l</mi></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow></mover><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mpadded style="width:0pt;" lspace="-2.1pt" width="0pt"><mi>d</mi></mpadded></mover><msub><mi>U</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">S</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>U</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">S</mi><mn mathsize="0.710em">2</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">S</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>U</mi><mi>l</mi></msub><mo>=</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu(\eta(G,l))=\pi(V_{0})\xrightarrow{\phi(R_{1})}\pi(V_{1})\xrightarrow{\phi(R_{2})}\dots\xrightarrow{\phi(R_{l})}\pi(V_{l})\stackrel{{\scriptstyle\mathclap{\text{{\mbox{$d$}}}}}}{{=}}U_{0}\xrightarrow{S_{1}}U_{1}\xrightarrow{S_{2}}\dots\xrightarrow{S_{l}}U_{l}=\eta(H,l)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p16.6" class="ltx_p"><span id="A3.SS2.p16.6.1" class="ltx_text">Let
<math id="A3.SS2.p16.m6" class="ltx_Math" alttext="\bar{\eta}=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}\in\mathcal{W}(G)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo>=</mo><msub><mi>v</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>v</mi><mn>1</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub></mover><mi mathvariant="normal">…</mi><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">l</mi></msub></mover><msub><mi>v</mi><mi>l</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\eta}=v_{0}\xrightarrow{r_{1}}v_{1}\xrightarrow{r_{2}}\dots\xrightarrow{r_{l}}v_{l}\in\mathcal{W}(G)</annotation></semantics></math>
be a walk of length <math id="A3.SS2.p16.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> over <math id="A3.SS2.p16.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. It suffices to show that the probability of sampling <math id="A3.SS2.p16.m9" class="ltx_Math" alttext="\bar{\eta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>η</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\eta}</annotation></semantics></math> from <math id="A3.SS2.p16.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is identical to the probability of sampling <math id="A3.SS2.p16.m11" class="ltx_Math" alttext="\mu(\bar{\eta})" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(\bar{\eta})</annotation></semantics></math> from <math id="A3.SS2.p16.m12" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>:</span></p>
<table id="A3.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex63.m1" class="ltx_Math" alttext="{\mathbb{P}}(\eta(G,l)=\bar{\eta})={\mathbb{P}}(\eta(H,l)=\mu(\bar{\eta}))" display="block" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>η</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\eta(G,l)=\bar{\eta})={\mathbb{P}}(\eta(H,l)=\mu(\bar{\eta}))</annotation></semantics></math></td>
