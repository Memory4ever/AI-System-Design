<th id="A6.T7.st2.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A6.T7.st2.2.1.2.1" class="ltx_text ltx_font_bold">MRR</span></th>
<th id="A6.T7.st2.2.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A6.T7.st2.2.1.3.1" class="ltx_text ltx_font_bold">Hits@1</span></th></tr>
</thead>
<tbody class="ltx_tbody">
