<span id="A1.T10.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:313.0pt;">
<span id="A1.Ex3" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex3.m1" class="ltx_Math" alttext="\frac{\sigma(\texttt{x})=\texttt{v}}{\langle\texttt{x},\sigma,\chi\rangle\to\texttt{v}}" display="block" intent=":literal"><semantics><mfrac><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_monospace">x</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mtext class="ltx_mathvariant_monospace">v</mtext></mrow><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">x</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">→</mo><mtext class="ltx_mathvariant_monospace">v</mtext></mrow></mfrac><annotation encoding="application/x-tex">\frac{\sigma(\texttt{x})=\texttt{v}}{\langle\texttt{x},\sigma,\chi\rangle\to\texttt{v}}</annotation></semantics></math></span>
