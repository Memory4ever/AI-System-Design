<td id="A5.T15.2.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T15.2.2.7.1" class="ltx_text ltx_font_bold">(<math id="A5.T15.m12" class="ltx_Math" alttext="{s^{\prime}_{ko}}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msubsup><annotation encoding="application/x-tex">{s^{\prime}_{ko}}</annotation></semantics></math>, <math id="A5.T15.m13" class="ltx_Math" alttext="p^{\prime}_{ko}" display="inline" intent=":literal"><semantics><msubsup><mi>p</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">′</mo></msubsup><annotation encoding="application/x-tex">p^{\prime}_{ko}</annotation></semantics></math>)</span></td></tr>
<tr id="A5.T15.2.3" class="ltx_tr">
<th id="A5.T15.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="9"><span id="A5.T15.2.3.1.1" class="ltx_text ltx_font_bold">Human-Written</span></th></tr>
<tr id="A5.T15.2.4" class="ltx_tr">
<th id="A5.T15.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="8"><span id="A5.T15.2.4.1.1" class="ltx_text">
<span id="A5.T15.2.4.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:8.8pt;height:62.6pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:62.6pt;transform:translate(-26.9pt,-26.9pt) rotate(-90deg) ;">
<span id="A5.T15.2.4.1.1.1.1" class="ltx_p">Non-reasoning</span>
</span></span></span></th>
<th id="A5.T15.2.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A5.T15.2.4.2.1" class="ltx_text ltx_font_smallcaps">Qwen2.5-Instruct 14B</span></th>
<td id="A5.T15.2.4.3" class="ltx_td ltx_align_center ltx_border_t">70</td>
<td id="A5.T15.2.4.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#FFE6E6;"><span id="A5.T15.2.4.4.1" class="ltx_text" style="--ltx-bg-color:#FFE6E6;">67</span></td>
