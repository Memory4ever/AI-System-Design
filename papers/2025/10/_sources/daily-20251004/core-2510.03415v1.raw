<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>IMP Formalization</h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">Here we describe the syntax and semantics of IMP used in all our
experiments.</p>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>IMP Syntax Description</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">The IMP syntax used in all our experiments is given in EBNF in
Figure <a href="#A1.F3" title="Figure 3 ‣ A.1 IMP Syntax Description ‣ Appendix A IMP Formalization ‣ PLSemanticsBench: Large Language Models as Programming Language Interpreters" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. The terminals are shown in
red while the non-terminals are shown in blue.</p>
</div>
<figure id="A1.F3" class="ltx_figure ltx_lstlisting">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Complete syntax of IMP used in our experiments in EBNF.</figcaption>
<div id="A1.F3.2" class="ltx_listing ltx_lst_language_bnf-grammar ltx_lst_numbers_left ltx_lstlisting ltx_listing" style="--ltx-bg-color:#FFFFFF;--ltx-border-color:#000000;"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="code/appendix/imp_syntax.ebnf">⬇</a></div>
<div id="lstnumberx22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1</span>
              
              
              
            <span id="lstnumberx22.2" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx22.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">program</span><span id="lstnumberx22.4" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx22.5" class="ltx_text ltx_lst_space ltx_font_typewriter">   </span><span id="lstnumberx22.6" class="ltx_text ltx_font_typewriter">::=</span><span id="lstnumberx22.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.8" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx22.9" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt_list</span><span id="lstnumberx22.10" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
<div id="lstnumberx23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2</span>
              
              
              
            <span id="lstnumberx23.2" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx23.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt_list</span><span id="lstnumberx23.4" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx23.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx23.6" class="ltx_text ltx_font_typewriter">::=</span><span id="lstnumberx23.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx23.8" class="ltx_text ltx_font_typewriter">(&lt;</span><span id="lstnumberx23.9" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt</span><span id="lstnumberx23.10" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx23.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx23.12" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">';'</span><span id="lstnumberx23.13" class="ltx_text ltx_font_typewriter">)*</span>
</div>
<div id="lstnumberx24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3</span>
              
              
              
            <span id="lstnumberx24.2" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx24.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt</span><span id="lstnumberx24.4" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx24.5" class="ltx_text ltx_lst_space ltx_font_typewriter">      </span><span id="lstnumberx24.6" class="ltx_text ltx_font_typewriter">::=</span><span id="lstnumberx24.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.8" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'int'</span><span id="lstnumberx24.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.10" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx24.11" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">id</span><span id="lstnumberx24.12" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
<div id="lstnumberx25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4</span>
              
              
              
            <span id="lstnumberx25.2" class="ltx_text ltx_lst_space ltx_font_typewriter">            </span><span id="lstnumberx25.3" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx25.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.5" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx25.6" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">id</span><span id="lstnumberx25.7" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx25.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.9" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'='</span><span id="lstnumberx25.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx25.11" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx25.12" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">aexp</span><span id="lstnumberx25.13" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
<div id="lstnumberx26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5</span>
              
              
              
            <span id="lstnumberx26.2" class="ltx_text ltx_lst_space ltx_font_typewriter">            </span><span id="lstnumberx26.3" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx26.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.5" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'if'</span><span id="lstnumberx26.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.7" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'('</span><span id="lstnumberx26.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.9" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx26.10" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">bexp</span><span id="lstnumberx26.11" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx26.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.13" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">')'</span><span id="lstnumberx26.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.15" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'{'</span><span id="lstnumberx26.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.17" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx26.18" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt_list</span><span id="lstnumberx26.19" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx26.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.21" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'}'</span><span id="lstnumberx26.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.23" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'else'</span><span id="lstnumberx26.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.25" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'{'</span><span id="lstnumberx26.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.27" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx26.28" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt_list</span><span id="lstnumberx26.29" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx26.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx26.31" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'}'</span>
</div>
<div id="lstnumberx27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6</span>
              
              
              
            <span id="lstnumberx27.2" class="ltx_text ltx_lst_space ltx_font_typewriter">            </span><span id="lstnumberx27.3" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.5" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'while'</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.7" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'('</span><span id="lstnumberx27.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.9" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx27.10" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">bexp</span><span id="lstnumberx27.11" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx27.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.13" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">')'</span><span id="lstnumberx27.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.15" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'{'</span><span id="lstnumberx27.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.17" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx27.18" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">stmt_list</span><span id="lstnumberx27.19" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx27.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.21" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'}'</span>
</div>
