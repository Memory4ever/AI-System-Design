<td id="A1.T8.2.7.1" class="ltx_td ltx_align_left"><span id="A1.T8.2.7.1.1" class="ltx_text ltx_font_typewriter">s</span></td>
<td id="A1.T8.2.7.2" class="ltx_td ltx_align_left"><span id="A1.T8.2.7.2.1" class="ltx_text ltx_font_typewriter">stmt</span></td>
<td id="A1.T8.2.7.3" class="ltx_td ltx_align_left">Statements of the language</td></tr>
