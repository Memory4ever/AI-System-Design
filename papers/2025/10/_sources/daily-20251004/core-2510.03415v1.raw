<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\frac{\langle\texttt{a},\sigma,\chi\rangle\to\langle\texttt{a'},\sigma,\chi\rangle}{\langle\texttt{x := a :: SL},\sigma,\chi\rangle\to\langle\texttt{x := a' :: SL},\sigma,\chi\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">a</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">a’</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">x := a :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">x := a’ :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\langle\texttt{a},\sigma,\chi\rangle\to\langle\texttt{a'},\sigma,\chi\rangle}{\langle\texttt{x := a :: SL},\sigma,\chi\rangle\to\langle\texttt{x := a' :: SL},\sigma,\chi\rangle}</annotation></semantics></math></span>
