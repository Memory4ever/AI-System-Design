<td id="A1.T10.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r ltx_border_t">
<span id="A1.T10.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:22.8pt;">
