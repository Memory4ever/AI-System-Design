<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex75.m1" class="ltx_Math" alttext="\frac{\chi=\epsilon}{\langle\texttt{break :: SL},\sigma,\chi\rangle\to\langle\texttt{ERROR},\sigma,\chi\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mi>χ</mi><mo>=</mo><mi>ϵ</mi></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">break :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">ERROR</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\chi=\epsilon}{\langle\texttt{break :: SL},\sigma,\chi\rangle\to\langle\texttt{ERROR},\sigma,\chi\rangle}</annotation></semantics></math></span>
