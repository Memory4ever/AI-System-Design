<td id="A1.T9.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="A1.T9.m1" class="ltx_Math" alttext="\mathrm{stmt}\times\mathrm{Stack}\to\mathrm{Stack}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>stmt</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Stack</mi></mrow><mo stretchy="false">→</mo><mi>Stack</mi></mrow><annotation encoding="application/x-tex">\mathrm{stmt}\times\mathrm{Stack}\to\mathrm{Stack}</annotation></semantics></math></td>
<td id="A1.T9.2.2.3" class="ltx_td ltx_align_left ltx_border_t"><math id="A1.T9.m2" class="ltx_Math" alttext="\mathrm{push}(s,\chi)\triangleq s::\chi" display="inline" intent=":literal"><semantics><mrow><mrow><mi>push</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mi>χ</mi></mrow><annotation encoding="application/x-tex">\mathrm{push}(s,\chi)\triangleq s::\chi</annotation></semantics></math></td></tr>
<tr id="A1.T9.2.3" class="ltx_tr">
<th id="A1.T9.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T9.2.3.1.1" class="ltx_text ltx_font_typewriter">pop</span></th>
<td id="A1.T9.2.3.2" class="ltx_td ltx_align_left"><math id="A1.T9.m3" class="ltx_Math" alttext="\mathrm{Stack}_{\neq\epsilon}\to\mathrm{Stack}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stack</mi><mrow><mphantom></mphantom><mo>≠</mo><mi>ϵ</mi></mrow></msub><mo stretchy="false">→</mo><mi>Stack</mi></mrow><annotation encoding="application/x-tex">\mathrm{Stack}_{\neq\epsilon}\to\mathrm{Stack}</annotation></semantics></math></td>
<td id="A1.T9.2.3.3" class="ltx_td ltx_align_left"><math id="A1.T9.m4" class="ltx_math_unparsed" alttext="\mathrm{pop}(s::\chi)\triangleq\chi" display="inline" intent=":literal"><semantics><mrow><mi>pop</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo lspace="0.278em" rspace="0em">:</mo><mo rspace="0.278em">:</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo>≜</mo><mi>χ</mi></mrow><annotation encoding="application/x-tex">\mathrm{pop}(s::\chi)\triangleq\chi</annotation></semantics></math></td></tr>
<tr id="A1.T9.2.4" class="ltx_tr">
<th id="A1.T9.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A1.T9.2.4.1.1" class="ltx_text ltx_font_typewriter">top</span></th>
<td id="A1.T9.2.4.2" class="ltx_td ltx_align_left"><math id="A1.T9.m5" class="ltx_Math" alttext="\mathrm{Stack}\to\mathrm{stmt}\cup\{\epsilon\}" display="inline" intent=":literal"><semantics><mrow><mi>Stack</mi><mo stretchy="false">→</mo><mrow><mi>stmt</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stack}\to\mathrm{stmt}\cup\{\epsilon\}</annotation></semantics></math></td>
<td id="A1.T9.2.4.3" class="ltx_td ltx_align_left"><math id="A1.T9.m6" class="ltx_math_unparsed" alttext="\mathrm{top}(\chi)\triangleq\begin{cases}\epsilon&amp;\text{if }\chi=\epsilon,\\
s&amp;\text{if }\chi=s::\chi^{\prime}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mi>top</mi><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow><mo>≜</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi>ϵ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi></mrow><mo>=</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>s</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>χ</mi></mrow><mo>=</mo><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>χ</mi><mo>′</mo></msup></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\mathrm{top}(\chi)\triangleq\begin{cases}\epsilon&amp;\text{if }\chi=\epsilon,\\
s&amp;\text{if }\chi=s::\chi^{\prime}\end{cases}</annotation></semantics></math></td></tr>
<tr id="A1.T9.2.5" class="ltx_tr">
<th id="A1.T9.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A1.T9.m7" class="ltx_Math" alttext="\mathbin{++}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>+</mo></mrow><annotation encoding="application/x-tex">\mathbin{++}</annotation></semantics></math></th>
<td id="A1.T9.2.5.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="A1.T9.m8" class="ltx_Math" alttext="\mathrm{stmt\_list}\times\mathrm{stmt\_list}\to\mathrm{stmt\_list}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>stmt</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>list</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>stmt</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>list</mi></mrow><mo stretchy="false">→</mo><mrow><mi>stmt</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>list</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{stmt\_list}\times\mathrm{stmt\_list}\to\mathrm{stmt\_list}</annotation></semantics></math></td>
<td id="A1.T9.2.5.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="A1.T9.m9" class="ltx_math_unparsed" alttext="SL1\mathbin{++}SL2\triangleq\begin{cases}SL2&amp;\text{if }SL1=\epsilon,\\
s::(SL1^{\prime}\mathbin{++}SL2)&amp;\text{if }SL1=s::SL1^{\prime}.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mi>L</mi><mn>1</mn><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>+</mo></mrow><mi>S</mi><mi>L</mi><mn>2</mn><mo>≜</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>=</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>1</mn><mo>′</mo></msup></mrow><mrow><mo>+</mo><mo lspace="0em">⁣</mo><mo>+</mo></mrow><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>=</mo><mi>s</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>1</mn><mo>′</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">SL1\mathbin{++}SL2\triangleq\begin{cases}SL2&amp;\text{if }SL1=\epsilon,\\
s::(SL1^{\prime}\mathbin{++}SL2)&amp;\text{if }SL1=s::SL1^{\prime}.\end{cases}</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
<div id="A1.SS2.p3" class="ltx_para ltx_noindent">
<p id="A1.SS2.p3.1" class="ltx_p">Program execution proceeds by repeatedly applying the transition relation
<math id="A1.SS2.p3.m1" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> to configurations, starting from
<math id="A1.SS2.p3.m2" class="ltx_Math" alttext="\langle\texttt{SL},\sigma,\chi\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\texttt{SL},\sigma,\chi\rangle</annotation></semantics></math>, where <span id="A1.SS2.p3.1.1" class="ltx_text ltx_font_typewriter">SL</span> is the program’s
statement list, until a terminal configuration is reached. We treat
<math id="A1.SS2.p3.m3" class="ltx_Math" alttext="\langle\epsilon,\sigma,\chi\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mi>ϵ</mi><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\epsilon,\sigma,\chi\rangle</annotation></semantics></math>,
<math id="A1.SS2.p3.m4" class="ltx_Math" alttext="\langle\texttt{halt},\sigma,\chi\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">halt</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\texttt{halt},\sigma,\chi\rangle</annotation></semantics></math>, and
<math id="A1.SS2.p3.m5" class="ltx_Math" alttext="\langle\texttt{ERROR},\sigma,\chi\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">ERROR</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\texttt{ERROR},\sigma,\chi\rangle</annotation></semantics></math>
as terminal configurations.</p>
</div>
<div id="A1.SS2.p4" class="ltx_para">
<p id="A1.SS2.p4.1" class="ltx_p">The complete set of small-step SOS rules defining the semantics of IMP  appears in Table <a href="#A1.T10" title="Table 10 ‣ A.2 Small-step Operational Semantics (SOS) Rules for IMP ‣ Appendix A IMP Formalization ‣ PLSemanticsBench: Large Language Models as Programming Language Interpreters" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>.</p>
</div>
