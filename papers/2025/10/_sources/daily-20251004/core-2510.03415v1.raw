<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_Math" alttext="\frac{}{\langle\texttt{int x :: SL},\sigma,\chi\rangle\to\langle\texttt{SL},\sigma[\texttt{x}\mapsto 0],\chi\rangle}" display="block" intent=":literal"><semantics><mfrac><mphantom></mphantom><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">int x :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">SL</mtext><mo>,</mo><mi>σ</mi><mo stretchy="false">[</mo><mtext class="ltx_mathvariant_monospace">x</mtext><mo stretchy="false">↦</mo><mn>0</mn><mo stretchy="false">]</mo><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{}{\langle\texttt{int x :: SL},\sigma,\chi\rangle\to\langle\texttt{SL},\sigma[\texttt{x}\mapsto 0],\chi\rangle}</annotation></semantics></math></span>
