<th id="S3.T2.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m27" class="ltx_Math" alttext="\bm{\hat{\Omega}_{\textbf{\text{Loop}}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_bold">Loop</mtext></msub><annotation encoding="application/x-tex">\bm{\hat{\Omega}_{\textbf{\text{Loop}}}}</annotation></semantics></math></th>
<th id="S3.T2.2.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m28" class="ltx_Math" alttext="\bm{\Omega_{\textbf{\text{DD}}}}" display="inline" intent=":literal"><semantics><msub><mi>𝛀</mi><mtext class="ltx_mathvariant_bold">DD</mtext></msub><annotation encoding="application/x-tex">\bm{\Omega_{\textbf{\text{DD}}}}</annotation></semantics></math></th>
<th id="S3.T2.2.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m29" class="ltx_Math" alttext="\bm{\hat{\Omega}_{\textbf{\text{Assign}}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_bold">Assign</mtext></msub><annotation encoding="application/x-tex">\bm{\hat{\Omega}_{\textbf{\text{Assign}}}}</annotation></semantics></math></th>
<th id="S3.T2.2.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m30" class="ltx_Math" alttext="\bm{\Omega_{\textbf{\text{Loc}}}}" display="inline" intent=":literal"><semantics><msub><mi>𝛀</mi><mtext class="ltx_mathvariant_bold">Loc</mtext></msub><annotation encoding="application/x-tex">\bm{\Omega_{\textbf{\text{Loc}}}}</annotation></semantics></math></th>
<th id="S3.T2.2.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m31" class="ltx_Math" alttext="\bm{\Omega_{\textbf{\text{Vol}}}}" display="inline" intent=":literal"><semantics><msub><mi>𝛀</mi><mtext class="ltx_mathvariant_bold">Vol</mtext></msub><annotation encoding="application/x-tex">\bm{\Omega_{\textbf{\text{Vol}}}}</annotation></semantics></math></th>
<th id="S3.T2.2.2.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m32" class="ltx_Math" alttext="\bm{\Omega_{\textbf{\text{Voc}}}}" display="inline" intent=":literal"><semantics><msub><mi>𝛀</mi><mtext class="ltx_mathvariant_bold">Voc</mtext></msub><annotation encoding="application/x-tex">\bm{\Omega_{\textbf{\text{Voc}}}}</annotation></semantics></math></th>
<th id="S3.T2.2.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S3.T2.m33" class="ltx_Math" alttext="\bm{\hat{\Omega}_{\textbf{\text{Trace}}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝛀</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_bold">Trace</mtext></msub><annotation encoding="application/x-tex">\bm{\hat{\Omega}_{\textbf{\text{Trace}}}}</annotation></semantics></math></th></tr>
</thead>
