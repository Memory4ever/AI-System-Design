<td id="A5.T15.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A5.T15.2.1.3.1" class="ltx_text"><math id="A5.T15.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>𝒑</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></span></td>
<td id="A5.T15.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="A5.T15.2.1.4.1" class="ltx_text ltx_font_bold">K-semantics</span></td>
<td id="A5.T15.2.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="A5.T15.2.1.5.1" class="ltx_text ltx_font_bold">SOS</span></td></tr>
<tr id="A5.T15.2.2" class="ltx_tr">
<th id="A5.T15.2.2.1" class="ltx_td ltx_th ltx_th_row"></th>
<td id="A5.T15.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T15.2.2.2.1" class="ltx_text ltx_font_bold">(<math id="A5.T15.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>,<math id="A5.T15.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>)</span></td>
