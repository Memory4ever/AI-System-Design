<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex77.m1" class="ltx_Math" alttext="\frac{\chi\neq\epsilon\;\wedge\;\texttt{s}=\texttt{LE}\quad\texttt{s1}=\mathrm{top}(\chi)}{\langle\texttt{continue :: s :: SL},\sigma,\chi\rangle\to\langle\texttt{s1 :: SL},\sigma,\mathrm{pop}(\chi)\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mrow><mi>χ</mi><mo>≠</mo><mrow><mi>ϵ</mi><mo lspace="0.502em" rspace="0.502em">∧</mo><mtext class="ltx_mathvariant_monospace">s</mtext></mrow><mo>=</mo><mtext class="ltx_mathvariant_monospace">LE</mtext></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext class="ltx_mathvariant_monospace">s1</mtext><mo>=</mo><mrow><mi>top</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">continue :: s :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">s1 :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>pop</mi><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\chi\neq\epsilon\;\wedge\;\texttt{s}=\texttt{LE}\quad\texttt{s1}=\mathrm{top}(\chi)}{\langle\texttt{continue :: s :: SL},\sigma,\chi\rangle\to\langle\texttt{s1 :: SL},\sigma,\mathrm{pop}(\chi)\rangle}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></td>
