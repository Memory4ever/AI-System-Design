<span id="A1.T10.2.76.1.1.1" class="ltx_p">Rule 75</span>
</span></td>
<td id="A1.T10.2.76.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="A1.T10.2.76.2.1" class="ltx_inline-block ltx_align_top" style="width:313.0pt;">
<span id="A1.Ex77" class="ltx_equation ltx_eqn_table">

