            <span id="lstnumberx53.2" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx53.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#0000FF;">digit</span><span id="lstnumberx53.4" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx53.5" class="ltx_text ltx_lst_space ltx_font_typewriter">     </span><span id="lstnumberx53.6" class="ltx_text ltx_font_typewriter">::=</span><span id="lstnumberx53.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.8" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'0'</span><span id="lstnumberx53.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.10" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.12" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'1'</span><span id="lstnumberx53.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.14" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.16" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'2'</span><span id="lstnumberx53.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.18" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.20" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'3'</span><span id="lstnumberx53.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.22" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.24" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'4'</span><span id="lstnumberx53.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.26" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.28" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'5'</span><span id="lstnumberx53.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.30" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.32" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'6'</span><span id="lstnumberx53.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.34" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.36" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'7'</span><span id="lstnumberx53.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.38" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.40" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'8'</span><span id="lstnumberx53.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.42" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx53.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx53.44" class="ltx_text ltx_lst_string ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">'9'</span>
</div>
</div>
</figure>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Small-step Operational Semantics (SOS) Rules for IMP</h3>

<figure id="A1.T8" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 8: </span>Metavariables used in the SOS formalization of IMP.</figcaption>
<table id="A1.T8.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A1.T8.2.1" class="ltx_tr">
<th id="A1.T8.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T8.2.1.1.1" class="ltx_text ltx_font_bold">Meta-var</span></th>
<th id="A1.T8.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T8.2.1.2.1" class="ltx_text ltx_font_bold">Sort</span></th>
<th id="A1.T8.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T8.2.1.3.1" class="ltx_text ltx_font_bold">Ranges over / Domain</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T8.2.2" class="ltx_tr">
<td id="A1.T8.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.T8.2.2.1.1" class="ltx_text ltx_font_typewriter">x</span></td>
<td id="A1.T8.2.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.T8.2.2.2.1" class="ltx_text ltx_font_typewriter">id</span></td>
<td id="A1.T8.2.2.3" class="ltx_td ltx_align_left ltx_border_t">Identifiers (program variable names)</td></tr>
<tr id="A1.T8.2.3" class="ltx_tr">
<td id="A1.T8.2.3.1" class="ltx_td ltx_align_left"><span id="A1.T8.2.3.1.1" class="ltx_text ltx_font_typewriter">v</span></td>
<td id="A1.T8.2.3.2" class="ltx_td ltx_align_left"><span id="A1.T8.2.3.2.1" class="ltx_text ltx_font_typewriter">literal</span></td>
<td id="A1.T8.2.3.3" class="ltx_td ltx_align_left">Integer literals</td></tr>
<tr id="A1.T8.2.4" class="ltx_tr">
<td id="A1.T8.2.4.1" class="ltx_td ltx_align_left"><span id="A1.T8.2.4.1.1" class="ltx_text ltx_font_typewriter">q</span></td>
<td id="A1.T8.2.4.2" class="ltx_td ltx_align_left"><span id="A1.T8.2.4.2.1" class="ltx_text ltx_font_typewriter">bool</span></td>
<td id="A1.T8.2.4.3" class="ltx_td ltx_align_left">Boolean literals</td></tr>
<tr id="A1.T8.2.5" class="ltx_tr">
<td id="A1.T8.2.5.1" class="ltx_td ltx_align_left"><span id="A1.T8.2.5.1.1" class="ltx_text ltx_font_typewriter">a</span></td>
<td id="A1.T8.2.5.2" class="ltx_td ltx_align_left"><span id="A1.T8.2.5.2.1" class="ltx_text ltx_font_typewriter">aexp</span></td>
<td id="A1.T8.2.5.3" class="ltx_td ltx_align_left">Integer expressions</td></tr>
<tr id="A1.T8.2.6" class="ltx_tr">
<td id="A1.T8.2.6.1" class="ltx_td ltx_align_left"><span id="A1.T8.2.6.1.1" class="ltx_text ltx_font_typewriter">b</span></td>
<td id="A1.T8.2.6.2" class="ltx_td ltx_align_left"><span id="A1.T8.2.6.2.1" class="ltx_text ltx_font_typewriter">bexp</span></td>
<td id="A1.T8.2.6.3" class="ltx_td ltx_align_left">Boolean expressions</td></tr>
