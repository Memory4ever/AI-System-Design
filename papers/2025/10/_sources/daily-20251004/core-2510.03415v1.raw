            <span id="lstnumberx19.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx19.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">rule</span><span id="lstnumberx19.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.5" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx19.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">k</span><span id="lstnumberx19.7" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx19.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx19.10" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx19.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Id</span><span id="lstnumberx19.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.13" class="ltx_text ltx_font_typewriter">=&gt;</span><span id="lstnumberx19.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I</span><span id="lstnumberx19.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.17" class="ltx_text ltx_font_typewriter">...&lt;/</span><span id="lstnumberx19.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">k</span><span id="lstnumberx19.19" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx19.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.21" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx19.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state</span><span id="lstnumberx19.23" class="ltx_text ltx_font_typewriter">&gt;...</span><span id="lstnumberx19.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx19.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.27" class="ltx_text ltx_font_typewriter">|-&gt;</span><span id="lstnumberx19.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I</span><span id="lstnumberx19.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.31" class="ltx_text ltx_font_typewriter">...&lt;/</span><span id="lstnumberx19.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state</span><span id="lstnumberx19.33" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
<div id="lstnumberx20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8</span>
              
              
              
            <span id="lstnumberx20.2" class="ltx_text ltx_lst_space ltx_font_typewriter">  </span><span id="lstnumberx20.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold">rule</span><span id="lstnumberx20.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I1</span><span id="lstnumberx20.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.7" class="ltx_text ltx_font_typewriter">+</span><span id="lstnumberx20.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I2</span><span id="lstnumberx20.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.11" class="ltx_text ltx_font_typewriter">=&gt;</span><span id="lstnumberx20.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I1</span><span id="lstnumberx20.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.15" class="ltx_text ltx_font_typewriter">+</span><span id="lstnumberx20.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Int</span><span id="lstnumberx20.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">I2</span><span id="lstnumberx20.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.20" class="ltx_text"></span>
</div>
