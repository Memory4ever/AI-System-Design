ext ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.26" class="ltx_text ltx_font_typewriter">&lt;/</span><span id="lstnumberx17.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">k</span><span id="lstnumberx17.28" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx17.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.30" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx17.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state</span><span id="lstnumberx17.32" class="ltx_text ltx_font_typewriter">&gt;</span><span id="lstnumberx17.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Rho</span><span id="lstnumberx17.35" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx17.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Map</span><span id="lstnumberx17.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.38" class="ltx_text ltx_font_typewriter">(.</span><span id="lstnumberx17.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Map</span><span id="lstnumberx17.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.41" class="ltx_text ltx_font_typewriter">=&gt;</span><span id="lstnumberx17.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter">X</span><span id="lstnumberx17.44" class="ltx_text ltx_font_typewriter">|-&gt;0)</span><span id="lstnumberx17.45" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.46" class="ltx_text ltx_font_typewriter">&lt;/</span><span id="lstnumberx17.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">state</span><span id="lstnumberx17.48" class="ltx_text ltx_font_typewriter">&gt;</span>
</div>
