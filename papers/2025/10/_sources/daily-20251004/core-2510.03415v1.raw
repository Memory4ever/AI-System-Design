<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex76.m1" class="ltx_Math" alttext="\frac{\chi\neq\epsilon\;\wedge\;\texttt{s}\neq\texttt{LE}}{\langle\texttt{continue :: s :: SL},\sigma,\chi\rangle\to\langle\texttt{continue :: SL},\sigma,\chi\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mi>χ</mi><mo>≠</mo><mrow><mi>ϵ</mi><mo lspace="0.502em" rspace="0.502em">∧</mo><mtext class="ltx_mathvariant_monospace">s</mtext></mrow><mo>≠</mo><mtext class="ltx_mathvariant_monospace">LE</mtext></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">continue :: s :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">continue :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\chi\neq\epsilon\;\wedge\;\texttt{s}\neq\texttt{LE}}{\langle\texttt{continue :: s :: SL},\sigma,\chi\rangle\to\langle\texttt{continue :: SL},\sigma,\chi\rangle}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
