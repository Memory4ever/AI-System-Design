<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex70.m1" class="ltx_Math" alttext="\frac{\langle\texttt{b},\sigma,\chi\rangle\to\langle\texttt{b'},\sigma,\chi\rangle}{\langle\texttt{loop(b) \lx@text@lbrace SL\lx@text@rbrace :: SL1},\sigma,\chi\rangle\to\langle\texttt{loop(b') \lx@text@lbrace SL\lx@text@rbrace :: SL1},\sigma,\chi\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">b</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">⟨</mo><mrow><mtext class="ltx_mathvariant_monospace">b’</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">loop(b) {SL} :: SL1</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">loop(b’) {SL} :: SL1</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\langle\texttt{b},\sigma,\chi\rangle\to\langle\texttt{b'},\sigma,\chi\rangle}{\langle\texttt{loop(b) \lx@text@lbrace SL\lx@text@rbrace :: SL1},\sigma,\chi\rangle\to\langle\texttt{loop(b') \lx@text@lbrace SL\lx@text@rbrace :: SL1},\sigma,\chi\rangle}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></td>
