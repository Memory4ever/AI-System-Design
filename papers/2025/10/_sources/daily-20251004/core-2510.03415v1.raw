<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex71.m1" class="ltx_Math" alttext="\frac{\texttt{q}=\texttt{false}}{\langle\texttt{loop(q) \lx@text@lbrace SL\lx@text@rbrace :: SL1},\sigma,\chi\rangle\to\langle\texttt{SL1},\sigma,\mathrm{pop}(\chi)\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mtext class="ltx_mathvariant_monospace">q</mtext><mo>=</mo><mtext class="ltx_mathvariant_monospace">false</mtext></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">loop(q) {SL} :: SL1</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">SL1</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>pop</mi><mo stretchy="false">(</mo><mi>χ</mi><mo stretchy="false">)</mo><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\texttt{q}=\texttt{false}}{\langle\texttt{loop(q) \lx@text@lbrace SL\lx@text@rbrace :: SL1},\sigma,\chi\rangle\to\langle\texttt{SL1},\sigma,\mathrm{pop}(\chi)\rangle}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></td>
