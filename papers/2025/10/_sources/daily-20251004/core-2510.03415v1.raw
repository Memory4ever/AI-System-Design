<span class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\frac{\sigma(\texttt{x})\neq\bot}{\langle\texttt{x := v :: SL},\sigma,\chi\rangle\to\langle\texttt{SL},\sigma[\texttt{x}\mapsto\texttt{v}],\chi\rangle}" display="block" intent=":literal"><semantics><mfrac><mrow><mi>σ</mi><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_monospace">x</mtext><mo stretchy="false">)</mo><mo rspace="0em">≠</mo><mo lspace="0em">⊥</mo></mrow><mrow><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">x := v :: SL</mtext><mo>,</mo><mi>σ</mi><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo><mo stretchy="false">→</mo><mo stretchy="false">⟨</mo><mtext class="ltx_mathvariant_monospace">SL</mtext><mo>,</mo><mi>σ</mi><mo stretchy="false">[</mo><mtext class="ltx_mathvariant_monospace">x</mtext><mo stretchy="false">↦</mo><mtext class="ltx_mathvariant_monospace">v</mtext><mo stretchy="false">]</mo><mo>,</mo><mi>χ</mi><mo stretchy="false">⟩</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{\sigma(\texttt{x})\neq\bot}{\langle\texttt{x := v :: SL},\sigma,\chi\rangle\to\langle\texttt{SL},\sigma[\texttt{x}\mapsto\texttt{v}],\chi\rangle}</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></td>
