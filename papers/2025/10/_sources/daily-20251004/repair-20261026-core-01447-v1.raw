<td id="A2.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T2.2.1.3.1" class="ltx_text ltx_font_bold">Reduction vs. Adaptive (%)</span></td></tr>
<tr id="A2.T2.2.2" class="ltx_tr">
<td id="A2.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t">eICU (<math id="A2.T2.m1" class="ltx_Math" alttext="C=0.1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">C=0.1</annotation></semantics></math>)</td>
<td id="A2.T2.2.2.2" class="ltx_td ltx_align_center ltx_border_t">52.7</td>
<td id="A2.T2.2.2.3" class="ltx_td ltx_align_center ltx_border_t">47.9</td></tr>
<tr id="A2.T2.2.3" class="ltx_tr">
<td id="A2.T2.2.3.1" class="ltx_td ltx_align_left">Income Simple (<math id="A2.T2.m2" class="ltx_Math" alttext="C=0.01" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">C=0.01</annotation></semantics></math>)</td>
