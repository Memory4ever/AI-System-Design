<tr id="A2.T2.2.4" class="ltx_tr">
<td id="A2.T2.2.4.1" class="ltx_td ltx_align_left">Income Simple (<math id="A2.T2.m3" class="ltx_Math" alttext="C=0.05" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">C=0.05</annotation></semantics></math>)</td>
<td id="A2.T2.2.4.2" class="ltx_td ltx_align_center">78.5</td>
<td id="A2.T2.2.4.3" class="ltx_td ltx_align_center">8.4</td></tr>
<tr id="A2.T2.2.5" class="ltx_tr">
<td id="A2.T2.2.5.1" class="ltx_td ltx_align_left">Income Simple (<math id="A2.T2.m4" class="ltx_Math" alttext="C=0.1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">C=0.1</annotation></semantics></math>)</td>
<td id="A2.T2.2.5.2" class="ltx_td ltx_align_center">-11.7</td>
<td id="A2.T2.2.5.3" class="ltx_td ltx_align_center">-9.5</td></tr>
<tr id="A2.T2.2.6" class="ltx_tr">
<td id="A2.T2.2.6.1" class="ltx_td ltx_align_left">Income Complex (<math id="A2.T2.m5" class="ltx_Math" alttext="C=0.1" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">C=0.1</annotation></semantics></math>)</td>
