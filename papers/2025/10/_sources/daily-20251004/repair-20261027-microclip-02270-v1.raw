<tr id="S4.T1.3.3" class="ltx_tr">
<td id="S4.T1.3.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 3.0pt;"><span id="S4.T1.3.3.1.1" class="ltx_text" style="font-size:70%;">CLIP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite></span></td>
