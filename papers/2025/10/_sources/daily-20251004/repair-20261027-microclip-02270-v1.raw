<span id="S4.T1.3.3.2.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="S4.T1.3.3.2.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.3.3.2.1.1.1" class="ltx_text" style="font-size:70%;">ICML’21</span></span>
</span></td>
<td id="S4.T1.3.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 3.0pt;">
<span id="S4.T1.3.3.3.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.3.3.3.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.3.3.3.1.1.1" class="ltx_text" style="font-size:70%;">37.45</span></span>
</span></td>
<td id="S4.T1.3.3.4" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 3.0pt;">
<span id="S4.T1.3.3.4.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.3.3.4.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.3.3.4.1.1.1" class="ltx_text" style="font-size:70%;">90.69</span></span>
</span></td>
<td id="S4.T1.3.3.5" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.4pt 3.0pt;">
<span id="S4.T1.3.3.5.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.3.3.5.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.3.3.5.1.1.1" class="ltx_text" style="font-size:70%;">58.70</span></span>
</span></td>
