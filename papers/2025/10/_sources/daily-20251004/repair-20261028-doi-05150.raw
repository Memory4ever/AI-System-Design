{"data":{"id":"10.48550/arxiv.2510.05150","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.05150","prefix":"10.48550","suffix":"arxiv.2510.05150","identifiers":[{"identifier":"2510.05150","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.05150"}],"creators":[{"name":"Wu, Donghang","nameType":"Personal","givenName":"Donghang","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Haoyang","nameType":"Personal","givenName":"Haoyang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Chen","nameType":"Personal","givenName":"Chen","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Tianyu","nameType":"Personal","givenName":"Tianyu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Tian, Fei","nameType":"Personal","givenName":"Fei","familyName":"Tian","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Xuerui","nameType":"Personal","givenName":"Xuerui","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Gang","nameType":"Personal","givenName":"Gang","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Hexin","nameType":"Personal","givenName":"Hexin","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Nana","nameType":"Personal","givenName":"Nana","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Yuchen","nameType":"Personal","givenName":"Yuchen","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Chng, Eng Siong","nameType":"Personal","givenName":"Eng Siong","familyName":"Chng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Chronological Thinking in Full-Duplex Spoken Dialogue Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T10:28:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-08T00:01:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T21:35:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:11:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-12T14:26:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-15T00:51:44Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent advances in spoken dialogue language models (SDLMs) reflect growing interest in shifting from turn-based to full-duplex systems, where the models continuously perceive user speech streams while generating responses. This simultaneous listening and speaking design enables real-time interaction and the agent can handle dynamic conversational behaviors like user barge-in. However, during the listening phase, existing systems keep the agent idle by repeatedly predicting the silence token, which departs from human behavior: we usually engage in lightweight thinking during conversation rather than remaining absent-minded. Inspired by this, we propose Chronological Thinking, an on-the-fly conversational thinking mechanism that aims to improve response quality in full-duplex SDLMs. Specifically, chronological thinking presents a paradigm shift from conventional LLM thinking approaches, such as Chain-of-Thought, purpose-built for streaming acoustic input. (1) Strictly causal: the agent reasons incrementally while listening, updating internal hypotheses only from past audio with no lookahead. (2) No additional latency: reasoning is amortized during the listening window; once the user stops speaking, the agent halts thinking and begins speaking without further delay. Experiments demonstrate the effectiveness of chronological thinking through both objective metrics and human evaluations show consistent improvements in response quality. Furthermore, chronological thinking robustly handles conversational dynamics and attains competitive performance on full-duplex interaction metrics.","descriptionType":"Abstract"},{"description":"Accepted by SIGDIAL 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.05150","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-08T01:42:14.000Z","registered":"2025-10-08T01:42:14.000Z","published":"2025","updated":"2026-06-15T02:03:55.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.05150","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}