{"data":[{"id":"10.48550/arxiv.2510.01719","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01719","identifiers":[{"identifier":"2510.01719","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiwan","familyName":"Chung","name":"Chung, Jiwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Neel","familyName":"Joshi","name":"Joshi, Neel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pratyusha","familyName":"Sharma","name":"Sharma, Pratyusha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youngjae","familyName":"Yu","name":"Yu, Youngjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vibhav","familyName":"Vineet","name":"Vineet, Vibhav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What MLLMs Learn about When they Learn about Multimodal Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T06:58:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:29:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T15:17:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:54:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T08:57:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:44:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-07T09:13:59Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-08T00:42:20Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-10-23T02:22:08Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-10-26T00:24:33Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Evaluation of multimodal reasoning models is typically reduced to a single accuracy score, implicitly treating reasoning as a unitary capability. We introduce MathLens, a benchmark of textbook-style geometry problems that exposes this assumption by operationally decomposing performance into perception, reasoning, and multimodal-specific components. Each problem is derived from a symbolic specification and accompanied by visual diagrams, text-only variants, multimodal questions, and targeted perceptual probes, enabling controlled measurement of each component. Using this decomposition, we show that common training strategies are associated with systematically different capability profiles that are invisible under aggregate accuracy. Across the models we study, reinforcement learning primarily improves perceptual grounding and robustness to diagram variation, while our analysis suggests that textual SFT yields gains through reflective reasoning. In contrast, as perception and reasoning improve, a growing fraction of remaining errors fall outside these components and are categorized as multimodal-specific. These results suggest that apparent progress in multimodal reasoning reflects shifting balances among subskills rather than uniform advancement, motivating evaluation beyond scalar accuracy."},{"descriptionType":"Other","description":"NeurIPS 2026. Project page: https://jiwanchung.github.io/mathlens/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01719","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:56:14Z","registered":"2025-10-03T01:56:14Z","published":null,"updated":"2026-10-26T02:32:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02272","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02272","identifiers":[{"identifier":"2510.02272","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wen","familyName":"Yang","name":"Yang, Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhong","familyName":"Wu","name":"Wu, Junhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chong","familyName":"Li","name":"Li, Chong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengqing","familyName":"Zong","name":"Zong, Chengqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Zhang","name":"Zhang, Jiajun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Well Does Mathematical Reasoning Transfer Across Languages in English-Centric LLMs?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:49:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:02:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-22T16:06:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-23T01:16:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Reinforcement Post-Training (RPT) have substantially improved the mathematical reasoning capabilities of large language models (LLMs), but it remains unclear how well such gains transfer across languages. In this work, we study cross-lingual mathematical reasoning transfer in English-centric LLMs under controlled multilingual evaluation. We first evaluate a range of English-centric reasoning models on multilingual mathematical reasoning benchmarks and find that transfer is highly variable across initial model choice, target language, and training paradigm. Through controlled comparative experiments, we further find that stronger English-centric initialization does not necessarily lead to stronger relative transfer efficiency, even when it yields higher multilingual reasoning accuracy. Finally, we show that the largest improvement comes from moving beyond English-only supervision: adding a single parallel language yields a substantial gain, while further gains from additional languages are smaller but consistent. Overall, our results highlight the need to evaluate multilingual mathematical reasoning directly, using both absolute performance and relative transfer-efficiency metrics."},{"descriptionType":"Other","description":"Camera ready version for EMNLP 2026 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02272","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:58Z","registered":"2025-10-03T02:09:59Z","published":null,"updated":"2026-10-23T02:50:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02125","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02125","identifiers":[{"identifier":"2510.02125","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Claas","familyName":"Beger","name":"Beger, Claas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Yi","name":"Yi, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhao","familyName":"Fu","name":"Fu, Shuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaleda","familyName":"Denton","name":"Denton, Kaleda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arseny","familyName":"Moskvichev","name":"Moskvichev, Arseny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah W.","familyName":"Tsai","name":"Tsai, Sarah W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sivasankaran","familyName":"Rajamanickam","name":"Rajamanickam, Sivasankaran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Melanie","familyName":"Mitchell","name":"Mitchell, Melanie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Distinguishing Performance From Competence in Evaluations of Humanlike Abstract Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T15:35:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:54:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T03:03:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:18:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-06T21:24:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-08T00:11:15Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-02T20:36:47Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-04T01:10:06Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-10-16T21:55:47Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-10-20T00:17:50Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI reasoning models have exceeded human performance on the ARC-AGI-1 benchmark, but does that mean state-of-the-art models have the underlying competence (humanlike abstract reasoning) that the benchmark was designed to test? Here we investigate the abstraction abilities of AI models using the closely related but simpler ConceptARC benchmark. Our evaluations vary input modality (textual vs. visual), use of external Python tools, and reasoning effort. Beyond output accuracy, we evaluate the natural-language rules that models generate to explain their solutions, enabling us to assess whether models recognize the abstractions that ConceptARC was designed to elicit. We show that the best models' rules are frequently based on less abstract, more domain-specific concepts, capturing intended abstractions considerably less often than humans. In the visual modality, AI models' output accuracy drops sharply; however, our rule-level analysis reveals that a substantial share of their rules capture intended abstractions, even as the models struggle to apply these concepts to generate correct solutions. In short, we show that using performance (accuracy) alone can substantially overestimate AI competence in textual modalities while underestimating it in visual modalities, an illustration of the risk of mistaking performance for competence."},{"descriptionType":"Other","description":"NeurIPS 2026 Track on Evaluations and Datasets"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02125","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:06:19Z","registered":"2025-10-03T02:06:20Z","published":null,"updated":"2026-10-20T05:15:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02224","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02224","identifiers":[{"identifier":"2510.02224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ethan","familyName":"Baron","name":"Baron, Ethan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boris","familyName":"Oreshkin","name":"Oreshkin, Boris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruijun","familyName":"Ma","name":"Ma, Ruijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanyu","familyName":"Zhang","name":"Zhang, Hanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kari","familyName":"Torkkola","name":"Torkkola, Kari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael W.","familyName":"Mahoney","name":"Mahoney, Michael W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew Gordon","familyName":"Wilson","name":"Wilson, Andrew Gordon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tatiana","familyName":"Konstantinova","name":"Konstantinova, Tatiana","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficiently Generating Correlated Sample Paths from Multi-step Time Series Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:08:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-14T00:22:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Many time series applications require access to multi-step forecast trajectories in the form of sample paths. Recently, time series foundation models have leveraged multi-step lookahead predictions to improve the quality and efficiency of multi-step forecasts. However, these models only predict independent marginal distributions for each time step, rather than a full joint predictive distribution. To generate forecast sample paths with realistic correlation structures, one typically resorts to autoregressive sampling, which can be extremely expensive. In this paper, we present a copula-based approach to efficiently generate accurate, correlated sample paths from existing multi-step time series foundation models in one forward pass. Our copula-based approach generates correlated sample paths orders of magnitude faster than autoregressive sampling, and it yields improved sample path quality by mitigating the snowballing error phenomenon."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02224","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:47Z","registered":"2025-10-03T02:08:47Z","published":null,"updated":"2026-10-14T08:20:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01389","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01389","identifiers":[{"identifier":"2510.01389","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ulas Berk","familyName":"Karli","name":"Karli, Ulas Berk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Shangguan","name":"Shangguan, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tesca","familyName":"FItzgerald","name":"FItzgerald, Tesca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"INSIGHT: INference-time Sequence Introspection for Generating Help Triggers in Vision-Language-Action Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T19:22:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:07:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-24T16:18:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-05T00:08:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icra57385.2026.11697385","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent Vision-Language-Action (VLA) models show strong generalization capabilities, yet they lack introspective mechanisms for anticipating failures and requesting help from a human supervisor. We present \\textbf{INSIGHT}, a learning framework for leveraging token-level uncertainty signals to predict when a VLA should request help. Using $π_0$-FAST as the underlying model, we extract per-token \\emph{entropy}, \\emph{log-probability}, and Dirichlet-based estimates of \\emph{aleatoric and epistemic uncertainty}, and train compact transformer classifiers to map these sequences to help triggers. We explore supervision regimes for strong or weak supervision, and extensively compare them across in-distribution and out-of-distribution tasks. Our results show a trade-off: strong labels enable models to capture fine-grained uncertainty dynamics for reliable help detection, while weak labels, though noisier, still support competitive introspection when training and evaluation are aligned, offering a scalable path when dense annotation is impractical. Crucially, we find that modeling the temporal evolution of token-level uncertainty signals with transformers provides far greater predictive power than static sequence-level scores. This study provides the first systematic evaluation of uncertainty-based introspection in VLAs, opening future avenues for active learning and for real-time error mitigation through selective human intervention."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01389","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:47:54Z","registered":"2025-10-03T01:47:55Z","published":null,"updated":"2026-10-05T02:43:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02259","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02259","identifiers":[{"identifier":"2510.02259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tobias","familyName":"Kreiman","name":"Kreiman, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Bai","name":"Bai, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fadi","familyName":"Atieh","name":"Atieh, Fadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elizabeth","familyName":"Weaver","name":"Weaver, Elizabeth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Qu","name":"Qu, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditi S.","familyName":"Krishnapriyan","name":"Krishnapriyan, Aditi S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformers Discover Molecular Structure Without Graph Priors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Chemical Physics (physics.chem-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:42:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:02:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-17T20:27:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-21T00:09:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-24T18:51:52Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-28T00:04:59Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Computational simulations play a central role in scientific discovery, and machine learning (ML) has emerged as a promising alternative to traditional physics-based modeling. However, scientific modeling requires physically meaningful predictions, raising a fundamental question for data-driven methods: to what extent can physical inductive biases-that is, prior assumptions about the structure of the physical world-emerge by learning from data alone? In this work, we study atomistic modeling, a representative field in the computational sciences where ML architectures have historically embedded strong physical inductive biases-such as geometric locality and graph structure. We develop a systematic understanding of how physical patterns can alternatively be discovered directly from data by training a model without domain-specific priors, including any manually defined atomistic pairwise interactions. We find that the model autonomously recovers key physical structure, such as learned interatomic interaction strengths that mirror classical electrostatics and interaction cutoffs consistent with traditional physical models. We further demonstrate predictable neural scaling law behavior with increased data and compute, and find accuracy on certain metrics competitive with physics-informed architectures. Our results clarify the boundary between engineered inductive biases and learnable physical structure, suggesting that general-purpose architectures can serve as principled baselines for scientific modeling by learning fundamental physical structure directly from data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02259","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:38Z","registered":"2025-10-03T02:09:39Z","published":null,"updated":"2026-09-28T02:32:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01365","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01365","identifiers":[{"identifier":"2510.01365","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maedeh","familyName":"Saberi","name":"Saberi, Maedeh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir Barati","familyName":"Farimani","name":"Farimani, Amir Barati","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Safa","familyName":"Jamali","name":"Jamali, Safa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RheOFormer: A generative transformer model for simulation of complex fluids and flows"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Fluid Dynamics (physics.flu-dyn)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T18:49:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:05:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-21T15:00:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-22T02:08:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The ability to model mechanics of soft materials under flowing conditions is key in designing and engineering processes and materials with targeted properties. This generally requires solution of internal stress tensor, related to the deformation tensor through nonlinear and history-dependent constitutive models. Traditional numerical methods for non-Newtonian fluid dynamics often suffer from prohibitive computational demands and poor scalability to new problem instances. Developments in data-driven methods have mitigated some limitations but still require retraining across varied physical conditions. In this work, we introduce Rheological Operator Transformer (RheOFormer), a generative operator learning method leveraging self-attention to efficiently learn different spatial interactions and features of complex fluid flows. We benchmark RheOFormer across a range of different viscometric and non-viscometric flows with different types of viscoelastic and elastoviscoplastic mechanics in complex domains against ground truth solutions. Our results demonstrate that RheOFormer can accurately learn both scalar and tensorial nonlinear mechanics of different complex fluids and predict the spatio-temporal evolution of their flows, even when trained on limited datasets. Its strong generalization capabilities and computational efficiency establish RheOFormer as a robust neural surrogate for accelerating predictive complex fluid simulations, advancing data-driven experimentation, and enabling real-time process optimization across a wide range of applications."},{"descriptionType":"Other","description":"8 pages, 5 figures. Submitted to PNAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01365","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:19Z","registered":"2025-10-03T01:47:20Z","published":null,"updated":"2026-09-22T04:43:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01527","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01527","identifiers":[{"identifier":"2510.01527","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lecheng","familyName":"Kong","name":"Kong, Lecheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyuan","familyName":"Wang","name":"Wang, Xiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixin","familyName":"Chen","name":"Chen, Yixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhan","familyName":"Zhang","name":"Zhang, Muhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Round-trip Reinforcement Learning: Self-Consistent Training for Better Chemical LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T23:58:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-24T20:15:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-26T00:08:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are emerging as versatile foundation models for computational chemistry, handling bidirectional tasks like reaction prediction and retrosynthesis. However, these models often lack round-trip consistency. For instance, a state-of-the-art chemical LLM may successfully caption a molecule, yet be unable to accurately reconstruct the original structure from its own generated text. This inconsistency suggests that models are learning unidirectional memorization rather than flexible mastery. Indeed, recent work has demonstrated a strong correlation between a model's round-trip consistency and its performance on the primary tasks. This strong correlation reframes consistency into a direct target for model improvement. We therefore introduce Round-Trip Reinforcement Learning (RTRL), a novel framework that trains a model to improve its consistency by using the success of a round-trip transformation as a reward signal. We further propose an iterative variant where forward and reverse mappings alternately train each other in a self-improvement loop, a process that is highly data-efficient and notably effective with the massive amount of unlabelled data common in chemistry. Experiments demonstrate that RTRL significantly \\textbf{boosts performance and consistency} over strong baselines across supervised, self-supervised, and synthetic data regimes. This work shows that round-trip consistency is not just a desirable property but a trainable objective, offering a new path toward more robust and reliable foundation models."},{"descriptionType":"Other","description":"27 pages; Accepted by COLM 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01527","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:22Z","registered":"2025-10-03T01:51:23Z","published":null,"updated":"2026-08-26T02:36:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01832","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01832","identifiers":[{"identifier":"2510.01832","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shicheng","familyName":"Liu","name":"Liu, Shicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Sun","name":"Sun, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lisheng","familyName":"Fu","name":"Fu, Lisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xilun","familyName":"Chen","name":"Chen, Xilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Zhang","name":"Zhang, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaojiang","familyName":"Lin","name":"Lin, Zhaojiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rulin","familyName":"Shao","name":"Shao, Rulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Liu","name":"Liu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anuj","familyName":"Kumar","name":"Kumar, Anuj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wen-tau","familyName":"Yih","name":"Yih, Wen-tau","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin Luna","familyName":"Dong","name":"Dong, Xin Luna","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SCRIBES: Web-Scale Script-Based Semi-Structured Data Extraction with Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:27:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:35:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-17T22:54:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-19T00:15:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Semi-structured content in HTML tables, lists, and infoboxes accounts for a substantial share of factual data on the web, yet the formatting complicates usage, and reliably extracting structured information from them remains challenging. Existing methods either lack generalization or are resource-intensive due to per-page LLM inference. In this paper, we introduce SCRIBES (SCRIpt-Based Semi-Structured Content Extraction at Web-Scale), a novel reinforcement learning framework that leverages layout similarity across webpages within the same site as a reward signal. Instead of processing each page individually, SCRIBES generates reusable extraction scripts that can be applied to groups of structurally similar webpages. Our approach further improves by iteratively training on synthetic annotations from in-the-wild CommonCrawl data. Experiments show that our approach outperforms strong baselines by over 13% in script quality and boosts downstream question answering accuracy by more than 4% for GPT-4o, enabling scalable and resource-efficient web information extraction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01832","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:01Z","registered":"2025-10-03T01:59:02Z","published":null,"updated":"2026-08-19T02:23:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01925","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01925","identifiers":[{"identifier":"2510.01925","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiyuan","familyName":"Liu","name":"Liu, Qiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Xu","name":"Xu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhong","familyName":"Chen","name":"Chen, Xuhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Chen","name":"Chen, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yee Whye","familyName":"Teh","name":"Teh, Yee Whye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Miao","name":"Miao, Ning","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Large Language Model Reasoning with Reward Models: An Analytical Survey"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T11:42:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:41:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T10:55:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:33:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-03T11:37:46Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-04T01:51:14Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reward models (RMs) play a critical role in enhancing the reasoning performance of LLMs. For example, they can provide training signals to finetune LLMs during reinforcement learning (RL) and help select the best answer from multiple candidates during inference. In this paper, we provide a systematic introduction to RMs, along with a comprehensive survey of their applications in LLM reasoning. We first review fundamental concepts of RMs, including their architectures, training methodologies, and evaluation techniques. Then, we explore their key applications: (1) guiding generation and selecting optimal outputs during LLM inference, (2) facilitating data synthesis and iterative self-improvement for LLMs, and (3) providing training signals in RL-based finetuning. Finally, we discuss critical open questions regarding the selection, generalization, evaluation, and enhancement of RMs, based on existing research and our own empirical findings. Our analysis aims to provide actionable insights for the effective deployment and advancement of RMs for LLM reasoning."},{"descriptionType":"Other","description":"Accepted for publication in Artificial Intelligence Review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01925","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:01:22Z","registered":"2025-10-03T02:01:22Z","published":null,"updated":"2026-08-04T04:36:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01764","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01764","identifiers":[{"identifier":"2510.01764","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Waris","familyName":"Radji","name":"Radji, Waris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Michel","name":"Michel, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hector","familyName":"Piteau","name":"Piteau, Hector","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Octax: Accelerated CHIP-8 Arcade Environments for Reinforcement Learning in JAX"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T07:56:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:31:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T06:51:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:24:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-06T14:44:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T02:23:58Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) research requires diverse, challenging environments that are both tractable and scalable. While modern video games may offer rich dynamics, they are computationally expensive and poorly suited for large-scale experimentation due to their CPU-bound execution. We introduce Octax, a high-performance suite of classic arcade game environments implemented in JAX, based on CHIP-8 emulation, a predecessor to Atari, which is widely adopted as a benchmark in RL research. Octax provides the JAX community with a long-awaited end-to-end GPU alternative to Atari games, offering image-based environments, spanning puzzle, action, and strategy genres, all executable at massive scale on modern GPUs. Our JAX-based implementation achieves orders-of-magnitude speedups over traditional CPU emulators. We demonstrate Octax's capabilities by training RL agents across multiple games, showing significant improvements in training speed and scalability compared to existing solutions. The environment's modular design enables researchers to easily extend the suite with new games or generate novel environments using large language models, making it an ideal platform for large-scale RL experimentation. Our open-source framework is available at https://github.com/riiswa/octax/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01764","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:57:21Z","registered":"2025-10-03T01:57:22Z","published":null,"updated":"2026-07-07T04:58:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01878","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01878","identifiers":[{"identifier":"2510.01878","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sahar","familyName":"Rajabi","name":"Rajabi, Sahar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nayeema","familyName":"Nonta","name":"Nonta, Nayeema","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sirisha","familyName":"Rambhatla","name":"Rambhatla, Sirisha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometrically Principled Randomized Optimization for Efficient LLM Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T10:35:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:38:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-26T18:31:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T00:06:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-rank gradient optimization for large language models is currently divided into two categories: structured methods that rigorously identify subspaces, and randomized approaches employed primarily for computational efficiency. In this work, we question the intuition behind why random projections are effective. We trace this phenomenon to the geometry of the gradient subspaces, which exhibits subspace optimization landscape has a nearly flat curvature, while a significant portion of gradient information lies outside the core subspace. Leveraging these insights, and drawing on randomized linear algebra, we theoretically establish that random low-rank projections preserve the geometry, and we introduce GrassWalk and GrassJump, algorithms that navigate the Grassmannian manifold via random walks and jumps. By coupling this randomized exploration with subspace-aware optimizer and recovering the lost gradient signals, we achieve state-of-the-art results on LLaMA-1B, LLaMA-7B, and Qwen-1.5B pretraining. Our findings reframe randomization not merely as a computational shortcut, but as a geometrically principled approach to high-dimensional optimizations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01878","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:00:10Z","registered":"2025-10-03T02:00:11Z","published":null,"updated":"2026-06-30T04:07:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01718","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01718","identifiers":[{"identifier":"2510.01718","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jialin","familyName":"Zhao","name":"Zhao, Jialin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accelerating Attention with Basis Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T06:58:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:29:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-26T05:02:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-29T00:22:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Attention is a core operation in large language models (LLMs). We present BD Attention (BDA), a lossless algorithmic reformulation of attention. BDA is enabled by a simple matrix identity from Basis Decomposition (BD), which restructures multi-head projections into a compact form while preserving exact outputs. Unlike I/O-aware system optimizations such as FlashAttention, BDA provides a mathematically guaranteed acceleration that is architecture-agnostic. On DeepSeek-V2-Lite (16B, FP16), BDA requires only 4s of offline preparation with no retraining required and, on modern GPUs, achieves 34% faster key/value projections and 25% smaller weights, while increasing perplexity (PPL) by just 0.02% (FP16) or 0.0004% (FP32), a negligible effect on model performance. These results position BDA as a theoretically exact method for lossless attention acceleration that is complementary to existing engineering-level optimizations. Our code is available at https://github.com/abcbdf/basis-decomposition-official."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01718","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:56:12Z","registered":"2025-10-03T01:56:13Z","published":null,"updated":"2026-06-29T01:59:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01565","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01565","identifiers":[{"identifier":"2510.01565","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runyu","familyName":"Lu","name":"Lu, Runyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqi","familyName":"He","name":"He, Shiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Tan","name":"Tan, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenggui","familyName":"Li","name":"Li, Shenggui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruofan","familyName":"Wu","name":"Wu, Ruofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff J.","familyName":"Ma","name":"Ma, Jeff J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ang","familyName":"Chen","name":"Chen, Ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mosharaf","familyName":"Chowdhury","name":"Chowdhury, Mosharaf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TetriServe: Efficiently Serving Mixed DiT Workloads"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:23:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T00:16:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:19:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-15T20:28:33Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-19T01:04:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-18T01:08:24Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-19T00:16:06Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Transformer (DiT) models excel at generating high-quality images through iterative denoising steps, but serving them under strict Service Level Objectives (SLOs) is challenging due to their high computational cost, particularly at larger resolutions. Existing serving systems use fixed-degree sequence parallelism, which is inefficient for heterogeneous workloads with mixed resolutions and deadlines, leading to poor GPU utilization and low SLO attainment.\n In this paper, we propose step-level sequence parallelism to dynamically adjust the degree of parallelism of individual requests according to their deadlines. We present TetriServe, a DiT serving system that implements this strategy for highly efficient image generation. Specifically, TetriServe introduces a novel round-based scheduling mechanism that improves SLO attainment by (1) discretizing time into fixed rounds to make deadline-aware scheduling tractable, (2) adapting parallelism at the step level and minimizing GPU hour consumption, and (3) jointly packing requests to minimize late completions. Extensive evaluation on state-of-the-art DiT models shows that TetriServe achieves up to 32% higher SLO attainment compared to existing solutions without degrading image quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01565","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:19Z","registered":"2025-10-03T01:52:20Z","published":null,"updated":"2026-06-19T02:17:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01444","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01444","identifiers":[{"identifier":"2510.01444","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dian","familyName":"Yu","name":"Yu, Dian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Zheng","name":"Zheng, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runpeng","familyName":"Dai","name":"Dai, Runpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongxia","familyName":"Li","name":"Li, Zongxia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Yu","name":"Yu, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenwen","familyName":"Liang","name":"Liang, Zhenwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfeng","familyName":"Song","name":"Song, Linfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitao","familyName":"Mi","name":"Mi, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pratap","familyName":"Tokekar","name":"Tokekar, Pratap","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yu","name":"Yu, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dual-Uncertainty Guided Policy Learning for Multimodal Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:32:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:09:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-15T17:51:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-16T01:57:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-12T19:14:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T00:07:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning with verifiable rewards (RLVR) has advanced reasoning capabilities in multimodal large language models. However, existing methods typically treat visual inputs as deterministic, overlooking the perceptual ambiguity inherent to the visual modality. Consequently, they fail to distinguish whether a model's uncertainty stems from complex reasoning or ambiguous perception, preventing the targeted allocation of exploration or learning signals. To address this gap, we introduce \\textbf{DUPL}, a dual-uncertainty guided policy learning approach for multimodal RLVR that quantifies and leverages both perceptual uncertainty (via symmetric KL divergence) and output uncertainty (via policy entropy) to guide policy updates. By establishing an uncertainty-driven feedback loop and employing a dynamic branch prioritization mechanism, DUPL recalibrates the policy advantage to focus learning on states with high perceptual or decisional ambiguity, enabling effective targeted exploration beyond passive data augmentation. Evaluated on diverse multimodal reasoning benchmarks spanning mathematical and general domains, DUPL achieves solid gains. It improves Qwen2.5-VL accuracy by up to $\\textbf{12.3%}$ (3B) and $\\textbf{7.9%}$ (7B), and Qwen3-VL-Instruct by up to $\\textbf{10.7%}$ (4B) and $\\textbf{12.4%}$ (8B), consistently outperforming GRPO, while seamlessly generalizing to alternative algorithms (DAPO, $\\textbf{+6.5%}$ avg) and architectures (LLaVA-OneVision-1.5, $\\textbf{+4.7%}$ avg). These results demonstrate that DUPL is an effective and generalizable approach for multimodal RLVR."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01444","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:15Z","registered":"2025-10-03T01:49:16Z","published":null,"updated":"2026-06-16T04:06:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01529","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01529","identifiers":[{"identifier":"2510.01529","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jaiden","familyName":"Fairoze","name":"Fairoze, Jaiden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjam","familyName":"Garg","name":"Garg, Sanjam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keewoo","familyName":"Lee","name":"Lee, Keewoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyuan","familyName":"Wang","name":"Wang, Mingyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bypassing Prompt Guards in Production with Controlled-Release Prompting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T00:04:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T06:05:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:26:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-02T23:19:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-04T00:15:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-06-10T11:37:59Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-11T00:49:28Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Ball et al. recently established that prompt filtering for AI alignment faces a fundamental barrier: under standard cryptographic assumptions, no filter running significantly faster than the protected model can universally distinguish adversarial prompts from benign ones. We investigate whether this impossibility result translates to real-world vulnerabilities in deployed large language model (LLM) systems. We answer affirmatively by introducing controlled-release prompting, a practical instantiation of the theoretical framework that exploits the resource asymmetry between lightweight input filters and the main models they protect. Unlike the theoretical construction, our attack does not require model modification: it generates malicious prompts that are indecipherable by any bounded filter yet remain tractable to the target LLM. We find our attack to be successful on four major chat platforms (Google Gemini, DeepSeek Chat, xAI Grok, and Mistral Le Chat) where baseline methods fail. Additionally, we apply our attack to extract copyrighted data from Gemini. Finally, we provide a systematic evaluation of 14 open-weight prompt guard models, revealing that even reasoning-capable filters cannot reliably detect our attack without incurring prohibitive resource overhead."},{"descriptionType":"Other","description":"Accepted to USENIX Security 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01529","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:25Z","registered":"2025-10-03T01:51:26Z","published":null,"updated":"2026-06-11T02:25:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01902","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01902","identifiers":[{"identifier":"2510.01902","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paweł","familyName":"Parys","name":"Parys, Paweł","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sairam","familyName":"Vaidya","name":"Vaidya, Sairam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taylor","familyName":"Berg-Kirkpatrick","name":"Berg-Kirkpatrick, Taylor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Loris","familyName":"D'Antoni","name":"D'Antoni, Loris","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constrained Adaptive Rejection Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T11:17:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:40:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-02T22:25:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-04T00:13:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language Models (LMs) are increasingly used in applications where generated outputs must satisfy strict semantic or syntactic constraints. Existing approaches to constrained generation fall along a spectrum: greedy constrained decoding methods enforce validity during decoding but distort the LM's distribution, while rejection sampling (RS) preserves fidelity but wastes computation by discarding invalid outputs. Both extremes are problematic in domains such as program fuzzing, where both validity and diversity of samples are essential. We present Constrained Adaptive Rejection Sampling (CARS), an approach that strictly improves the sample-efficiency of RS without distributional distortion. CARS begins with unconstrained LM sampling and adaptively rules out constraint-violating continuations by recording them in a trie and subtracting their probability mass from future draws. This adaptive pruning ensures that prefixes proven invalid are never revisited, acceptance rates improve monotonically, and the resulting samples exactly follow the constrained distribution. In experiments on a variety of domains -- e.g., program fuzzing and molecular generation -- CARS consistently achieves higher efficiency -- measured in the number of LM forward passes per valid sample -- while also producing stronger sample diversity than both GCD and methods that approximate the LM's distribution."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01902","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:00:47Z","registered":"2025-10-03T02:00:48Z","published":null,"updated":"2026-06-04T03:28:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01377","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01377","identifiers":[{"identifier":"2510.01377","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chuan","familyName":"He","name":"He, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyi","familyName":"Ren","name":"Ren, Shuyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingwei","familyName":"Mao","name":"Mao, Jingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erik G.","familyName":"Larsson","name":"Larsson, Erik G.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DeMuon: A Decentralized Muon for Matrix Optimization over Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T19:06:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:06:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-02T08:11:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-03T00:40:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we propose DeMuon, a method for decentralized matrix optimization over a given communication topology. DeMuon incorporates matrix orthogonalization via Newton-Schulz iterations-a technique inherited from its centralized predecessor, Muon-and employs gradient tracking to mitigate heterogeneity among local functions. Under heavy-tailed noise conditions and additional mild assumptions, we establish the iteration complexity of DeMuon for reaching an approximate stochastic stationary point. This complexity result matches the best-known complexity bounds of centralized algorithms in terms of dependence on the target tolerance. To the best of our knowledge, DeMuon is the first direct extension of Muon to decentralized optimization over graphs with provable complexity guarantees. We conduct preliminary numerical experiments on decentralized transformer pretraining over graphs with varying degrees of connectivity. Our numerical results demonstrate a clear margin of improvement of DeMuon over other popular decentralized algorithms across different network topologies."},{"descriptionType":"Other","description":"Add an accelerated variant of the proposed method. New proofs of proposed methods"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01377","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:37Z","registered":"2025-10-03T01:47:37Z","published":null,"updated":"2026-06-03T03:10:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01711","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01711","identifiers":[{"identifier":"2510.01711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taeyoung","familyName":"Kim","name":"Kim, Taeyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jimin","familyName":"Lee","name":"Lee, Jimin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Myungkyu","familyName":"Koo","name":"Koo, Myungkyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyoung","familyName":"Kim","name":"Kim, Dongyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyungmin","familyName":"Lee","name":"Lee, Kyungmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changyeon","familyName":"Kim","name":"Kim, Changyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Younggyo","familyName":"Seo","name":"Seo, Younggyo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwoo","familyName":"Shin","name":"Shin, Jinwoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Contrastive Representation Regularization for Vision-Language-Action Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T06:41:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:28:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T07:50:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:38:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-28T04:47:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-29T00:30:55Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05-31T14:16:48Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-06-02T01:13:33Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have shown strong capabilities in robot manipulation by leveraging rich representations from pre-trained Vision-Language Models (VLMs). However, their representations arguably remain suboptimal, lacking sensitivity to robotic signals such as control actions and proprioceptive information. To address the issue, we introduce Robot State-aware Contrastive Loss (RS-CL), a simple and effective representation regularization for VLA models, designed to bridge the gap between VLM representations and robotic signals. In particular, RS-CL aligns the representations more closely with the robot's proprioceptive states by using relative distances between the states as soft supervision. Complementing the original action prediction objective, RS-CL enhances control-relevant representation learning, while being lightweight and fully compatible with standard VLA training pipelines. Our empirical results demonstrate that RS-CL substantially improves the performance of state-of-the-art VLA models; it pushes the prior art to 69.7% achieving the state-of-the-art performance on the RoboCasa-Kitchen benchmark, and boosts success rates from 45.0% to 58.3% on challenging real-robot manipulation tasks."},{"descriptionType":"Other","description":"ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01711","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:56:02Z","registered":"2025-10-03T01:56:03Z","published":null,"updated":"2026-06-02T04:53:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02060","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02060","identifiers":[{"identifier":"2510.02060","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sanghyu","familyName":"Yoon","name":"Yoon, Sanghyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongmin","familyName":"Kim","name":"Kim, Dongmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suhee","familyName":"Yoon","name":"Yoon, Suhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye Seul","familyName":"Sim","name":"Sim, Ye Seul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungdong","familyName":"Yoa","name":"Yoa, Seungdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hye-Seung","familyName":"Cho","name":"Cho, Hye-Seung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soonyoung","familyName":"Lee","name":"Lee, Soonyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hankook","familyName":"Lee","name":"Lee, Hankook","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Woohyung","familyName":"Lim","name":"Lim, Woohyung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReTabAD: A Benchmark for Restoring Semantic Context in Tabular Anomaly Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T14:28:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:50:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-28T23:39:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-01T00:16:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In tabular anomaly detection (AD), textual semantics often carry critical signals, as the definition of an anomaly is closely tied to domain-specific context. However, existing benchmarks provide only raw data points without semantic context, overlooking rich textual metadata such as feature descriptions and domain knowledge that experts rely on in practice. This limitation restricts research flexibility and prevents models from fully leveraging domain knowledge for detection. ReTabAD addresses this gap by restoring textual semantics to enable context-aware tabular AD research. We provide (1) 20 carefully curated tabular datasets enriched with structured textual metadata, together with implementations of state-of-the-art AD algorithms including classical, deep learning, and LLM-based approaches, and (2) a zero-shot LLM framework that leverages semantic context without task-specific training, establishing a strong baseline for future research. Furthermore, this work provides insights into the role and utility of textual metadata in AD through experiments and analysis. Results show that semantic context improves detection performance and enhances interpretability by supporting domain-aware reasoning. These findings establish ReTabAD as a benchmark for systematic exploration of context-aware AD."},{"descriptionType":"Other","description":"Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02060","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:04:42Z","registered":"2025-10-03T02:04:43Z","published":null,"updated":"2026-06-01T02:33:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01833","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01833","identifiers":[{"identifier":"2510.01833","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhihao","familyName":"Dou","name":"Dou, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinjian","familyName":"Zhao","name":"Zhao, Qinjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongwei","familyName":"Wan","name":"Wan, Zhongwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dinggen","familyName":"Zhang","name":"Zhang, Dinggen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weida","familyName":"Wang","name":"Wang, Weida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Towsif","familyName":"Raiyan","name":"Raiyan, Towsif","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benteng","familyName":"Chen","name":"Chen, Benteng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingtao","familyName":"Pan","name":"Pan, Qingtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Ouyang","name":"Ouyang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoda","familyName":"Song","name":"Song, Chaoda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Gao","name":"Gao, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shufei","familyName":"Zhang","name":"Zhang, Shufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sumon","familyName":"Biswas","name":"Biswas, Sumon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Plan Then Action:High-Level Planning Guidance Reinforcement Learning for LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:28:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:35:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-25T18:23:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-27T00:05:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) demonstrate strong reasoning abilities via Chain-of-Thought (CoT), but their token-level generation encourages local decisions and lacks global planning, often leading to redundant or inaccurate reasoning. Existing methods, such as tree-based search and reinforcement learning (RL), attempt to address this issue but incur high computational costs and still struggle to produce reliable reasoning trajectories. To address these challenges, we propose Plan-Then-Action Enhanced Reasoning with Group Relative Policy Optimization (PTA-GRPO), a two-stage framework designed to jointly improve high-level planning and fine-grained CoT reasoning. Specifically, in the first stage, a given LLM is responsible for summarizing CoT reasoning into compact high-level guidance, which is then leveraged for supervised fine-tuning. Then, we introduce a guidance-aware reinforcement learning method that jointly optimizes the final output and the quality of guidance, enhancing reasoning effectiveness. We evaluate PTA-GRPO on ten reasoning benchmarks across mathematics and natural sciences, using five diverse base models spanning multiple data modalities. The results show that PTA-GRPO consistently delivers significant improvements across models and tasks, demonstrating strong effectiveness and generalization."},{"descriptionType":"Other","description":"19 pages and 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01833","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:03Z","registered":"2025-10-03T01:59:03Z","published":null,"updated":"2026-05-27T02:36:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01336","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01336","identifiers":[{"identifier":"2510.01336","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Avinash","familyName":"Kumar","name":"Kumar, Avinash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sujay","familyName":"Sanghavi","name":"Sanghavi, Sujay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Poulami","familyName":"Das","name":"Das, Poulami","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HiSpec: Hierarchical Speculative Decoding for LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T18:04:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:03:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-26T05:53:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-27T00:33:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Speculative decoding accelerates LLM inference by using a smaller draft model to speculate tokens that a larger target model verifies. Verification is often the bottleneck (e.g. verification is $4\\times$ slower than token generation when a 3B model speculates for a 70B target model), but most prior works focus only on accelerating drafting. $\\textit{``Intermediate\"}$ verification reduces verification time by discarding inaccurate draft tokens early, but existing methods incur substantial training overheads in incorporating the intermediate verifier, increase the memory footprint to orchestrate the intermediate verification step, and compromise accuracy by relying on approximate heuristics.\n We propose $\\underline{\\textit{Hi}}\\textit{erarchical }\\underline{\\textit{Spec}}\\textit{ulative Decoding (HiSpec)}$, a framework for high-throughput speculative decoding that exploits $\\textit{early-exit (EE) models}$ for low-overhead intermediate verification. EE models allow tokens to exit early by skipping layer traversal and are explicitly trained so that hidden states at selected layers can be interpreted, making them uniquely suited for intermediate verification without drastically increasing compute and memory overheads. To improve resource-efficiency even further, we design a methodology that enables HiSpec to re-use key-value caches and hidden states between the draft, intermediate verifier, and target models. To maintain accuracy, HiSpec periodically validates the draft tokens accepted by the intermediate verifier against the target model. Our evaluations using various representative benchmarks and models show that HiSpec improves throughput by 1.28$\\times$ on average and by up to 2.01$\\times$ compared to the baseline single-layer speculation without compromising accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01336","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:46:36Z","registered":"2025-10-03T01:46:37Z","published":null,"updated":"2026-05-27T02:36:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01499","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01499","identifiers":[{"identifier":"2510.01499","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Ai","name":"Ai, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Pan","name":"Pan, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Simchi-Levi","name":"Simchi-Levi, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milind","familyName":"Tambe","name":"Tambe, Milind","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haifeng","familyName":"Xu","name":"Xu, Haifeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Majority Voting: LLM Aggregation by Leveraging Higher-Order Information"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T22:21:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:12:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-19T03:44:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-20T00:30:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid progress of multi-agent large language model (LLM) reasoning, how to effectively aggregate answers from multiple LLMs has emerged as a fundamental challenge. Standard majority voting treats all answers equally, failing to consider latent heterogeneity and correlation across models. In this work, we design two new aggregation algorithms called Optimal Weight (OW) and Inverse Surprising Popularity (ISP), leveraging both first-order and second-order information. Our theoretical analysis shows these methods provably mitigate inherent limitations of majority voting under mild assumptions, leading to more reliable collective decisions. We empirically validate our algorithms on synthetic datasets, popular LLM fine-tuning benchmarks such as UltraFeedback and MMLU, and a real-world healthcare setting ARMMAN. Our algorithms consistently outperform standard baselines, establishing a robust, training-free framework for effective multi-agent LLM aggregation."},{"descriptionType":"Other","description":"Accepted into ICML 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01499","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:50:36Z","registered":"2025-10-03T01:50:37Z","published":null,"updated":"2026-05-20T02:45:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01782","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01782","identifiers":[{"identifier":"2510.01782","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenbo","familyName":"Pan","name":"Pan, Wenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Xu","name":"Xu, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiguang","familyName":"Chen","name":"Chen, Qiguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Dong","name":"Dong, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Libo","familyName":"Qin","name":"Qin, Libo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinfeng","familyName":"Li","name":"Li, Xinfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haining","familyName":"Yu","name":"Yu, Haining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohua","familyName":"Jia","name":"Jia, Xiaohua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can LLMs Refuse Questions They Do Not Know? Measuring Knowledge-Aware Refusal in Factual Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T08:20:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:32:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-16T06:34:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-19T00:32:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) should refuse to answer questions beyond their knowledge. This capability, which we term knowledge-aware refusal, is crucial for factual reliability, while existing metrics fail to capture this ability. In this work, we propose the Refusal Index (RI), a novel and principled metric that measures how accurately LLMs refuse questions they do not know. We define RI as Spearman's rank correlation between refusal probability and error probability. RI is practically measurable with a lightweight two-pass evaluation method which only require observed refusal rates across two standard evaluation runs. Extensive experiments across 16 models and 5 datasets demonstrate that RI accurately quantifies a model's knowledge-aware refusal capability. Notably, RI remains stable across different refusal rates and provides consistent model rankings independent of a model's overall accuracy and refusal rates. These properties suggest RI captures a stable, intrinsic aspect of model knowledge calibration. More importantly, RI provides insight into an important but previously overlooked aspect of LLM factuality: while LLMs achieve high accuracy on factual tasks, their refusal behavior can be unreliable and fragile."},{"descriptionType":"Other","description":"Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01782","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:57:47Z","registered":"2025-10-03T01:57:48Z","published":null,"updated":"2026-05-19T04:48:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01502","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01502","identifiers":[{"identifier":"2510.01502","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kathy","familyName":"Garcia","name":"Garcia, Kathy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leyla","familyName":"Isik","name":"Isik, Leyla","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Behavioral Geometric Supervision Aligns Video Foundation Models with Human Social Perception"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T22:29:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:13:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-12T18:52:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T00:06:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current video foundation models, including the strongest self-supervised models such as V-JEPA2, fail to capture how humans organize social information in dynamic scenes. For example, across a range of diverse vision models tested, none were able to predict human similarity judgments to social video clips as well as a sentence embedding model of the caption text (MPNet). We show this gap in vision model performance can be closed by a compact behavioral supervisory signal. We introduce behavioral geometric supervision (BGS): a hybrid objective that constrains local and global pairwise embedding geometry to match the relational similarity structure across videos. We apply this method using a new human similarity dataset, containing 49,484 odd-one-out judgments from 250 naturalistic social video clips, and low-rank adaptation across four ViT backbones (V-JEPA 2/2.1, TimeSformer, VideoMAE, and CLIP). We find that one of the best fine-tuned models, V-JEPA 2.1, nearly triples in performance compared to the pre-trained baseline and reaches close to the noise ceiling, exceeding the strongest sentence-embedding baseline. In addition, finetuned models (i) capture unique variance in human judgments that caption-based language embeddings do not, (ii) develop interpretable social-affective attributes (valence, arousal, and dominance) despite never being trained on any of these attributes, (iii) zero-shot transfer to a separate dataset of out-of-distribution abstract social interactions, and (iv) shift spatial attention from scene context to socially informative regions (faces, gaze, and interacting bodies). A matched language-distillation control fails to reproduce these gains, ruling out caption transfer as the mechanism. Our results show how a modest amount of human behavioral data can steer video models toward human-like social visual understanding."},{"descriptionType":"Other","description":"v2: Major revision. Retitled; expanded from TimeSformer alone to four backbones (V-JEPA 2/2.1, TimeSformer, VideoMAE, CLIP), with V-JEPA 2.1 nearly tripling pretrained performance. Adds zero-shot PHASE transfer, attention-rollout analysis, and a language-distillation control. Data (OOO sim. judgments) \u0026amp; core hybrid triplet+RSA LoRA method unchanged from v1. Prepared for NeurIPS 2026 submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01502","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:50:40Z","registered":"2025-10-03T01:50:41Z","published":null,"updated":"2026-05-14T02:50:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01685","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01685","identifiers":[{"identifier":"2510.01685","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Apoorv","familyName":"Khandelwal","name":"Khandelwal, Apoorv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ellie","familyName":"Pavlick","name":"Pavlick, Ellie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Do Language Models Compose Functions?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T05:21:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:26:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-08T16:56:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-11T01:14:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While large language models (LLMs) appear to be increasingly capable of solving compositional tasks, it is an open question whether they do so using compositional mechanisms. In this work, we investigate how feedforward LLMs solve two-hop factual recall tasks, which can be expressed compositionally as $g(f(x))$. We first confirm that modern LLMs continue to suffer from the \"compositionality gap\", i.e. their ability to compute both $z = f(x)$ and $y = g(z)$ does not entail their ability to compute the composition $y = g(f(x))$. We then decode residual stream representations and identify two processing mechanisms: one which solves tasks $\\textit{compositionally}$, computing $f(x)$ along the way to $g(f(x))$, and one which solves them $\\textit{directly}$, without any detectable signature of the intermediate variable $f(x)$. Finally, we find that embedding space geometry is strongly related to which mechanism is employed, where the idiomatic mechanism is dominant when tasks are represented by translations from $x$ to $g(f(x))$ in the embedding spaces. We fully release our data and code at: https://github.com/apoorvkh/composing-functions."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01685","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:55:20Z","registered":"2025-10-03T01:55:21Z","published":null,"updated":"2026-05-11T02:42:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01569","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01569","identifiers":[{"identifier":"2510.01569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yubin","familyName":"Kim","name":"Kim, Yubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taehan","familyName":"Kim","name":"Kim, Taehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eugene","familyName":"Park","name":"Park, Eugene","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunjong","familyName":"Park","name":"Park, Chunjong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cynthia","familyName":"Breazeal","name":"Breazeal, Cynthia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"McDuff","name":"McDuff, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hae Won","familyName":"Park","name":"Park, Hae Won","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InvThink: Premortem Reasoning for Safer Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:26:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T21:56:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:08:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-08T00:53:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-11T00:24:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present InvThink, a training and prompting framework that requires the model to enumerate, analyze, and constrain potential failures before generating its final response. Unlike existing safety alignment methods that optimize only for safe final responses, InvThink structures generation into three steps: (1) enumerate potential harms, (2) analyze their consequences, (3) generate the response under explicit mitigation constraints. We observe three findings: (i) InvThink shows higher safety scores at larger model sizes, compared to existing safety prompting and alignment baselines. (ii) InvThink mitigates the safety tax. Models trained with INVTHINK preserve their reasoning capability on standard benchmarks. (iii) beyond general safety tasks, InvThink also reduces harmful behavior in professional ethics domains (medicine, finance, law) and in agentic misalignment scenarios, achieving up to 32% reduction in harmfulness over zero-shot baselines and 16% over SafetyPrompt. We extend InvThink with supervised fine-tuning, and GRPO-based reinforcement learning across three LLM families."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01569","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:25Z","registered":"2025-10-03T01:52:25Z","published":null,"updated":"2026-05-11T02:42:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01510","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01510","identifiers":[{"identifier":"2510.01510","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinwoo","familyName":"Kim","name":"Kim, Jinwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyue","familyName":"Huang","name":"Huang, Xingyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krzysztof","familyName":"Olejniczak","name":"Olejniczak, Krzysztof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyungbin","familyName":"Min","name":"Min, Kyungbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Bronstein","name":"Bronstein, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seunghoon","familyName":"Hong","name":"Hong, Seunghoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"İsmail İlkan","familyName":"Ceylan","name":"Ceylan, İsmail İlkan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Flock: A Knowledge Graph Foundation Model via Learning on Random Walks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T23:09:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:14:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-17T05:56:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-18T01:21:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-08T15:15:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-11T01:07:35Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the problem of zero-shot link prediction on knowledge graphs (KGs), which requires models to generalize to novel entities and novel relations. Knowledge graph foundation models (KGFMs) address this task by enforcing equivariance over both nodes and relations, which enables them to learn structural properties of nodes and relations that transfer to novel KGs with similar structure. However, the conventional notion of deterministic equivariance inherently limits the expressive power of KGFMs, as it prevents them from distinguishing relations that are structurally similar but semantically distinct. To overcome this limitation, we propose to leverage probabilistic node-relation equivariance, which preserves equivariance in distribution while using structured randomness to break symmetries at inference time. Building on this principle, we present Flock, a KGFM that iteratively samples random walks, encodes them into sequences, embeds them with a sequence model, and aggregates node and relation representations through learned pooling. Flock respects probabilistic node-relation equivariance and, crucially, is a universal approximator for isomorphism-invariant link-level functions over KGs. Empirically, Flock perfectly solves our new diagnostic dataset Petals on which current KGFMs fail, and achieves state-of-the-art performance on entity and relation prediction tasks across 54 KGs from diverse domains. Code is available at https://github.com/jw9730/flock."},{"descriptionType":"Other","description":"42 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01510","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:50:52Z","registered":"2025-10-03T01:50:53Z","published":null,"updated":"2026-05-11T02:42:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01290","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01290","identifiers":[{"identifier":"2510.01290","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akshat","familyName":"Ramachandran","name":"Ramachandran, Akshat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marina","familyName":"Neseem","name":"Neseem, Marina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charbel","familyName":"Sakr","name":"Sakr, Charbel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rangharajan","familyName":"Venkatesan","name":"Venkatesan, Rangharajan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brucek","familyName":"Khailany","name":"Khailany, Brucek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tushar","familyName":"Krishna","name":"Krishna, Tushar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ThinKV: Thought-Adaptive KV Cache Compression for Efficient Reasoning Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T04:09:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-07T18:13:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-11T00:04:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The long-output context generation of large reasoning models enables extended chain of thought (CoT) but also drives rapid growth of the key-value (KV) cache, quickly overwhelming GPU memory. To address this challenge, we propose ThinKV, a thought-adaptive KV cache compression framework. ThinKV is based on the observation that attention sparsity reveals distinct thought types with varying importance within the CoT. It applies a hybrid quantization-eviction strategy, assigning token precision by thought importance and progressively evicting tokens from less critical thoughts as reasoning trajectories evolve. Furthermore, to implement ThinKV, we design a kernel that extends PagedAttention to enable efficient reuse of evicted tokens' memory slots, eliminating compaction overheads. Extensive experiments on DeepSeek-R1-Distill, GPT-OSS, and NVIDIA AceReason across mathematics and coding benchmarks show that ThinKV achieves near-lossless accuracy with less than 5% of the original KV cache, while improving performance with up to 5.8x higher inference throughput over state-of-the-art baselines."},{"descriptionType":"Other","description":"ICLR 2026 (Oral)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01290","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:27Z","registered":"2025-10-03T01:45:28Z","published":null,"updated":"2026-05-11T02:42:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02312","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02312","identifiers":[{"identifier":"2510.02312","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Kuzina","name":"Kuzina, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maciej","familyName":"Pioro","name":"Pioro, Maciej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul N.","familyName":"Whatmough","name":"Whatmough, Paul N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Babak Ehteshami","familyName":"Bejnordi","name":"Bejnordi, Babak Ehteshami","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KaVa: Latent Reasoning via Compressed KV-Cache Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:59:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:04:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-07T14:29:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-08T01:05:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) excel at multi-step reasoning problems with explicit chain-of-thought (CoT), but verbose traces incur significant computational costs and memory overhead, and often carry redundant, stylistic artifacts. Latent reasoning has emerged as an efficient alternative that internalizes the thought process, but it suffers from a critical lack of supervision, limiting its effectiveness on complex, natural-language reasoning traces. In this work we propose KaVa, the first framework that bridges this gap by distilling knowledge directly from a compressed KV-cache of the teacher into a latent-reasoning student via self-distillation, leveraging the representational flexibility of continuous latent tokens to align stepwise KV trajectories. We show that the abstract, unstructured knowledge within compressed KV-cache, which lacks direct token correspondence, can serve as a rich supervisory signal for a latent reasoning student. Empirically, the approach consistently outperforms strong latent baselines, exhibits markedly smaller degradation from equation-only to natural-language traces, and scales to larger backbones while preserving efficiency. These results establish compressed KV-cache distillation as a scalable supervision signal for latent reasoning, combining the accuracy of CoT-trained teachers with the efficiency and deployability of latent inference."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02312","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:56Z","registered":"2025-10-03T02:10:57Z","published":null,"updated":"2026-05-08T12:51:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01706","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01706","identifiers":[{"identifier":"2510.01706","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shaan","familyName":"Shah","name":"Shah, Shaan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meenakshi","familyName":"Khosla","name":"Khosla, Meenakshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Representational Alignment Across Model Layers and Brain Regions with Multi-Level Optimal Transport"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T06:25:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:27:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-22T02:32:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-23T00:22:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard representational similarity methods align each layer of a network to its best match in another independently, producing asymmetric results, lacking a global alignment score, and struggling with networks of different depths. These limitations arise from ignoring global activation structure and restricting mappings to rigid one-to-one layer correspondences. We propose Multi-Level Optimal Transport (MOT), a unified framework that jointly infers soft, globally consistent layer-to-layer couplings and neuron-level transport plans. MOT allows source neurons to distribute mass across multiple target layers while minimizing total transport cost under marginal constraints. This yields both a single alignment score for the entire network comparison and a soft transport plan that naturally handles depth mismatches through mass distribution. We evaluate MOT on vision models, large language models, and human visual cortex recordings. Across all domains, MOT matches or surpasses standard pairwise matching in alignment quality. Moreover, it reveals smooth, fine-grained hierarchical correspondences: early layers map to early layers, deeper layers maintain relative positions, and depth mismatches are resolved by distributing representations across multiple layers. These structured patterns emerge naturally from global optimization without being imposed, yet are absent in greedy layer-wise methods. MOT thus enables richer, more interpretable comparisons between representations, particularly when networks differ in architecture or depth. We further extend our method to a three-level MOT framework, providing a proof-of-concept alignment of two networks across their training trajectories and demonstrating that MOT uncovers checkpoint-wise correspondences missed by greedy layer-wise matching."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01706","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:55:54Z","registered":"2025-10-03T01:55:55Z","published":null,"updated":"2026-04-23T02:22:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02025","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02025","identifiers":[{"identifier":"2510.02025","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Donghoon","familyName":"Jung","name":"Jung, Donghoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiwoo","familyName":"Choi","name":"Choi, Jiwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songeun","familyName":"Chae","name":"Chae, Songeun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seohyon","familyName":"Jung","name":"Jung, Seohyon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Style over Story: Measuring LLM Narrative Preferences via Structured Selection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T13:57:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:48:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-22T12:27:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-23T02:20:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-06T09:06:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-07T01:31:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-20T10:33:38Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-21T01:59:41Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a constraint-selection-based experiment design for measuring narrative preferences of Large Language Models (LLMs). This design offers an interpretable lens on LLMs' narrative selection behavior. We developed a library of 200 narratology-grounded constraints and prompted selections from six LLMs under three different instruction types: basic, quality-focused, and creativity-focused. Findings demonstrate that models consistently prioritize Style over narrative content elements like Event, Character, and Setting. Style preferences remain stable across models and instruction types, whereas content elements show cross-model divergence and instructional sensitivity. These results suggest that LLMs have latent narrative preferences, which should inform how the NLP community evaluates and deploys models in creative domains."},{"descriptionType":"Other","description":"Accepted to ACL 2026 (Findings), camera-ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02025","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:03:51Z","registered":"2025-10-03T02:03:51Z","published":null,"updated":"2026-04-21T04:49:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01801","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01801","identifiers":[{"identifier":"2510.01801","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongwu","familyName":"Xu","name":"Xu, Rongwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Jia","name":"Jia, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Liao","name":"Liao, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiao","familyName":"Sun","name":"Sun, Jiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Huang","name":"Huang, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Xu","name":"Xu, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting LLM-Generated Spam Reviews by Integrating Language Model Embeddings and Graph Neural Network"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T08:42:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:33:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-18T08:02:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T00:35:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rise of large language models (LLMs) has enabled the generation of highly persuasive spam reviews that closely mimic human writing. These reviews pose significant challenges for existing detection systems and threaten the credibility of online platforms. In this work, we first create three realistic LLM-generated spam review datasets using three distinct LLMs, each guided by product metadata and genuine reference reviews. Evaluations by GPT-4.1 confirm the high persuasion and deceptive potential of these reviews. To address this threat, we propose FraudSquad, a hybrid detection model that integrates text embeddings from a pre-trained language model with a gated graph transformer for spam node classification. FraudSquad captures both semantic and behavioral signals without relying on manual feature engineering or massive training resources. Experiments show that FraudSquad outperforms state-of-the-art baselines by up to 44.22% in precision and 43.01% in recall on three LLM-generated datasets, while also achieving promising results on two human-written spam datasets. Furthermore, FraudSquad maintains a modest model size and requires minimal labeled training data, making it a practical solution for real-world applications. Our contributions include new synthetic datasets, a practical detection framework, and empirical evidence highlighting the urgency of adapting spam detection to the LLM era. Our code and datasets are available at: https://anonymous.4open.science/r/FraudSquad-5389/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01801","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:58:15Z","registered":"2025-10-03T01:58:16Z","published":null,"updated":"2026-04-21T04:49:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02311","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02311","identifiers":[{"identifier":"2510.02311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guanqi","familyName":"Zhan","name":"Zhan, Guanqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianzheng","familyName":"Ma","name":"Ma, Xianzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weidi","familyName":"Xie","name":"Xie, Weidi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Zisserman","name":"Zisserman, Andrew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Inferring Dynamic Physical Properties from Video Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:59:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:04:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-13T04:19:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-14T01:24:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the task of predicting dynamic physical properties from videos. More specifically, we consider physical properties that require temporal information to be inferred: elasticity of a bouncing object, viscosity of a flowing liquid, and dynamic friction of an object sliding on a surface. To this end, we make the following contributions: (i) We collect a new video dataset for each physical property, consisting of synthetic training and testing splits, as well as a real split for real world evaluation. (ii) We explore three ways to infer the physical property from videos: (a) an oracle method where we supply the visual cues that intrinsically reflect the property using classical computer vision techniques; (b) a simple read out mechanism using a visual prompt and trainable prompt vector for cross-attention on pre-trained video generative and self-supervised models; and (c) prompt strategies for Multi-modal Large Language Models (MLLMs). (iii) We show that a video foundation model trained in a generative (DynamiCrafter) or trained in a self-supervised manner (V-JEPA-2) achieve a generally similar performance, though behind that of the oracle, and that MLLMs are currently inferior to the other models, though their performance can be improved through suitable prompting. The dataset, model, and code are available at https://www.robots.ox.ac.uk/~vgg/research/idpp/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02311","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:55Z","registered":"2025-10-03T02:10:55Z","published":null,"updated":"2026-04-14T04:18:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02249","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02249","identifiers":[{"identifier":"2510.02249","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi","familyName":"Bin","name":"Bin, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Jiang","name":"Jiang, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujuan","familyName":"Ding","name":"Ding, Yujuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kainian","familyName":"Zhu","name":"Zhu, Kainian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Ma","name":"Ma, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingkuan","familyName":"Song","name":"Song, Jingkuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng Tao","familyName":"Shen","name":"Shen, Heng Tao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Explore Briefly, Then Decide: Mitigating LLM Overthinking via Cumulative Entropy Regulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:36:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-21T12:52:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-24T00:40:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have demonstrated remarkable reasoning abilities on complex problems using long Chain-of-Thought (CoT) reasoning. However, they often suffer from overthinking, meaning generating unnecessarily lengthy reasoning steps for simpler problems. This issue may degrade the efficiency of the models and make them difficult to adapt the reasoning depth to the complexity of problems. To address this, we introduce a novel metric Token Entropy Cumulative Average (TECA), which measures the extent of exploration throughout the reasoning process. We further propose a novel reasoning paradigm named \"Explore Briefly, Then Decide\", with an associated Cumulative Entropy Regulation (CER) mechanism. This paradigm leverages TECA to help the model dynamically determine the optimal point to conclude its thought process and provide a final answer, thus achieving efficient reasoning. Experimental results across diverse mathematical benchmarks show that our approach substantially mitigates overthinking without sacrificing problem solving ability. With our thinking paradigm, the average response length decreases by up to 71% on simpler datasets, demonstrating the effectiveness of our method in creating a more efficient and adaptive reasoning process."},{"descriptionType":"Other","description":"Code: https://github.com/AusertDream/CumulativeEntropyRegulation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02249","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:23Z","registered":"2025-10-03T02:09:24Z","published":null,"updated":"2026-03-24T04:16:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01643","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01643","identifiers":[{"identifier":"2510.01643","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maryam","familyName":"Aliakbarpour","name":"Aliakbarpour, Maryam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Braverman","name":"Braverman, Vladimir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junze","familyName":"Yin","name":"Yin, Junze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haochen","familyName":"Zhang","name":"Zhang, Haochen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Support Basis: Fast Attention Beyond Bounded Entries"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T03:51:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:23:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-19T02:39:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-20T00:30:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated remarkable performance across a wide range of tasks. However, the quadratic complexity of softmax attention remains a central bottleneck that limits their scalability. Alman and Song (NeurIPS 2023a; NeurIPS 2024a) proposed sub-quadratic time algorithms for attention inference and training, respectively, but they rely on the restrictive bounded-entry assumption. We show that this assumption rarely holds in practice, which significantly limits their applicability to modern LLMs.\n In this paper, we introduce support-basis decomposition, a new technique for accurate and efficient attention inference and training without the bounded-entry assumption. We empirically show that the entries of the query and key matrices exhibit sub-Gaussian behavior. Leveraging this widely observed property, we perform exact computation on sparse components and polynomial approximation on dense components. Without relying on restrictive assumptions, we theoretically show that our algorithm achieves sub-quadratic runtime while matching the approximation error of prior work, and we empirically validate its computational efficiency and downstream task performance. We further generalize our method to a multi-threshold setting that eliminates all distributional assumptions, providing the first theoretical justification for the empirical success of polynomial attention. Moreover, we show that softmax attention can be closely approximated by multiple polynomial attentions with significantly smaller $\\ell_p$ error."},{"descriptionType":"Other","description":"AISTATS 2026 (Spotlight). Our code can be found at: https://github.com/yinj66/support_basis"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01643","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:13Z","registered":"2025-10-03T01:54:14Z","published":null,"updated":"2026-03-20T02:38:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01242","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01242","identifiers":[{"identifier":"2510.01242","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seyma Yaman","familyName":"Kayadibi","name":"Kayadibi, Seyma Yaman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Redundancy-as-Masking: Formalizing the Artificial Age Score (AAS) to Model Memory Aging in Generative AI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.0; H.1.2; H.1.1; H.1.0; F.4.0","lang":"en","subjectScheme":"ACM"},{"subject":"68T05, 03C95, 94A17, 68Q85","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-24T02:18:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-19T00:53:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-20T00:26:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.3389/frai.2026.1732691","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence is observed to age not through chronological time but through structural asymmetries in memory performance. In large language models, semantic cues such as the name of the day often remain stable across sessions, while episodic details like the sequential progression of experiment numbers tend to collapse when conversational context is reset. To capture this phenomenon, the Artificial Age Score (AAS) is introduced as a log-scaled, entropy-informed metric of memory aging derived from observable recall behavior. The score is formally proven to be well-defined, bounded, and monotonic under mild and model-agnostic assumptions, making it applicable across various tasks and domains. In its Redundancy-as-Masking formulation, the score interprets redundancy as overlapping information that reduces the penalized mass. However, in the present study, redundancy is not explicitly estimated; all reported values assume a redundancy-neutral setting (R = 0), yielding conservative upper bounds. The AAS framework was tested over a 25-day bilingual study involving ChatGPT-5, structured into stateless and persistent interaction phases. During persistent sessions, the model consistently recalled both semantic and episodic details, driving the AAS toward its theoretical minimum, indicative of structural youth. In contrast, when sessions were reset, the model preserved semantic consistency but failed to maintain episodic continuity, causing a sharp increase in the AAS and signaling structural memory aging. These findings support the utility of AAS as a theoretically grounded, task-independent diagnostic tool for evaluating memory degradation in artificial systems. The study builds on foundational concepts from von Neumann's work on automata, Shannon's theories of information and redundancy, and Turing's behavioral approach to intelligence."},{"descriptionType":"Other","description":"37 pages, 17 figures. Includes theoretical development and mathematical proofs of the Artificial Age Score (AAS), with empirical illustrations via ChatGPT-based memory recall experiments"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01242","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:44:17Z","registered":"2025-10-03T01:44:18Z","published":null,"updated":"2026-03-20T02:37:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02286","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02286","identifiers":[{"identifier":"2510.02286","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruohao","familyName":"Guo","name":"Guo, Ruohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Afshin","familyName":"Oroojlooy","name":"Oroojlooy, Afshin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roshan","familyName":"Sridhar","name":"Sridhar, Roshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miguel","familyName":"Ballesteros","name":"Ballesteros, Miguel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan","familyName":"Ritter","name":"Ritter, Alan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Roth","name":"Roth, Dan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tree-based Dialogue Reinforced Policy Optimization for Red-Teaming Attacks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:57:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:03:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-09T17:54:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T02:30:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite recent rapid progress in AI safety, current large language models remain vulnerable to adversarial attacks in multi-turn interaction settings, where attackers strategically adapt their prompts across conversation turns and pose a more critical yet realistic challenge. Existing approaches that discover safety vulnerabilities either rely on manual red-teaming with human experts or employ automated methods using pre-defined templates and human-curated attack data, with most focusing on single-turn attacks. However, these methods did not explore the vast space of possible multi-turn attacks, failing to consider novel attack trajectories that emerge from complex dialogue dynamics and strategic conversation planning. This gap is particularly critical given recent findings that LLMs exhibit significantly higher vulnerability to multi-turn attacks compared to single-turn attacks. We propose DialTree, an on-policy reinforcement learning framework integrated with tree search that autonomously discovers diverse multi-turn attack strategies by treating the dialogue as a sequential decision-making problem, enabling systematic exploration without manually curated data. Through extensive experiments, our approach not only achieves more than 44.2% higher ASR across 12 target models compared to previous state-of-the-art approaches, but also effectively uncovers new attack strategies by learning optimal dialogue policies that maximize attack success across multiple turns."},{"descriptionType":"Other","description":"Accepted at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02286","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:19Z","registered":"2025-10-03T02:10:19Z","published":null,"updated":"2026-03-10T04:50:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01674","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01674","identifiers":[{"identifier":"2510.01674","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"He","familyName":"Zhang","name":"Zhang, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anzhou","familyName":"Zhang","name":"Zhang, Anzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Dai","name":"Dai, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FOR-Prompting: From Objection to Revision via an Asymmetric Prompting Protocol"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:57:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:25:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T23:39:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T00:18:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning protocols such as Chain of Thought (CoT) and Tree of Thought (ToT) organize internal deliberation but lack an explicit mechanism for external questioning that elicits self-revision. We present FOR-Prompting (From Objection to Revision Prompting), an asymmetric protocol where a Defender proposes an answer, an Debater (Questioner) raises question-style objections with no direct fixes, and a Host optionally synthesizes the final output. Across GSM8K, FOR-Prompting matches the accuracy of CoT and consistently improves over single-prompting when evaluated under identical model backbones. On small-scale open-source models (e.g., LLaMA-3.2-1B), FOR-Prompting yields substantial gains over direct prompting and performs comparably to lightweight reasoning baselines, highlighting its promise for low-resource and on-device settings. Cross-model role-swapping further shows that performance is primarily determined by the Defender, enabling small models to act effectively as Questioners. Beyond structured math tasks, FOR-Prompting supports refinement in open-ended and multi-stage tasks: qualitative analysis shows improved exploration, coverage, and specificity, and a blind study of human preferences found that participants preferred FOR-Prompting outputs over strong LLM baselines in an itinerary-planning scenario. The protocol is model-agnostic and operates purely through role-structured prompting, requiring no training, access to model internals, or symmetrically strong agents. FOR-Prompting therefore enables scalable study of objection-driven reasoning and offers a practical mechanism for automated iterative refinement across both hosted and local LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01674","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:55:03Z","registered":"2025-10-03T01:55:04Z","published":null,"updated":"2026-03-10T04:50:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01235","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01235","identifiers":[{"identifier":"2510.01235","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Subham","familyName":"Ghosh","name":"Ghosh, Subham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Tewari","name":"Tewari, Abhishek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Extraction of Material Properties using LLM-based AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T18:27:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-10T00:42:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1016/j.commatsci.2026.114521","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid discovery of materials is constrained by the lack of large, machine-readable datasets that couple performance metrics with structural context. Existing databases are either small, manually curated, or biased toward first principles results, leaving experimental literature underexploited. We present an agentic, large language model (LLM)-driven workflow that autonomously extracts thermoelectric and structural-properties from about 10,000 full-text scientific articles. The pipeline integrates dynamic token allocation, zeroshot multi-agent extraction, and conditional table parsing to balance accuracy against computational cost. Benchmarking on 50 curated papers shows that GPT-4.1 achieves the highest accuracy (F1 = 0.91 for thermoelectric properties and 0.82 for structural fields), while GPT-4.1 Mini delivers nearly comparable performance (F1 = 0.89 and 0.81) at a fraction of the cost, enabling practical large scale deployment. Applying this workflow, we curated 27,822 temperature resolved property records with normalized units, spanning figure of merit (ZT), Seebeck coefficient, conductivity, resistivity, power factor, and thermal conductivity, together with structural attributes such as crystal class, space group, and doping strategy. Dataset analysis reproduces known thermoelectric trends, such as the superior performance of alloys over oxides and the advantage of p-type doping, while also surfacing broader structure-property correlations. To facilitate community access, we release an interactive web explorer with semantic filters, numeric queries, and CSV export. This study delivers the largest LLM-curated thermoelectric dataset to date, provides a reproducible and cost-profiled extraction pipeline, and establishes a foundation for scalable, data-driven materials discovery beyond thermoelectrics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01235","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:44:07Z","registered":"2025-10-03T01:44:08Z","published":null,"updated":"2026-03-10T04:50:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02243","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02243","identifiers":[{"identifier":"2510.02243","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Linh The","familyName":"Nguyen","name":"Nguyen, Linh The","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Tran","name":"Tran, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dung Ngoc","familyName":"Nguyen","name":"Nguyen, Dung Ngoc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Van-Cuong","familyName":"Pham","name":"Pham, Van-Cuong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hoang","familyName":"Ngo","name":"Ngo, Hoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dat Quoc","familyName":"Nguyen","name":"Nguyen, Dat Quoc","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AccurateRAG: A Framework for Building Accurate Retrieval-Augmented Question-Answering Applications"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:30:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:01:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-03T15:31:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-04T01:58:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce AccurateRAG -- a novel framework for constructing high-performance question-answering applications based on retrieval-augmented generation (RAG). Our framework offers a pipeline for development efficiency with tools for raw dataset processing, fine-tuning data generation, text embedding \u0026amp; LLM fine-tuning, output evaluation, and building RAG systems locally. Experimental results show that our framework outperforms previous strong baselines and obtains new state-of-the-art question-answering performance on benchmark datasets."},{"descriptionType":"Other","description":"Accepted to LREC 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02243","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:14Z","registered":"2025-10-03T02:09:15Z","published":null,"updated":"2026-03-04T03:18:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02253","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02253","identifiers":[{"identifier":"2510.02253","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihan","familyName":"Zhou","name":"Zhou, Zihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shilin","familyName":"Lu","name":"Lu, Shilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuli","familyName":"Leng","name":"Leng, Shuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaocong","familyName":"Zhang","name":"Zhang, Shaocong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuming","familyName":"Lian","name":"Lian, Zhuming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinlei","familyName":"Yu","name":"Yu, Xinlei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adams Wai-Kin","familyName":"Kong","name":"Kong, Adams Wai-Kin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DragFlow: Unleashing DiT Priors with Region Based Supervision for Drag Editing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:39:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:01:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-23T17:58:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-24T01:04:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-01T15:34:31Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-03T02:16:57Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Drag-based image editing has long suffered from distortions in the target region, largely because the priors of earlier base models, Stable Diffusion, are insufficient to project optimized latents back onto the natural image manifold. With the shift from UNet-based DDPMs to more scalable DiT with flow matching (e.g., SD3.5, FLUX), generative priors have become significantly stronger, enabling advances across diverse editing tasks. However, drag-based editing has yet to benefit from these stronger priors. This work proposes the first framework to effectively harness FLUX's rich prior for drag-based editing, dubbed DragFlow, achieving substantial gains over baselines. We first show that directly applying point-based drag editing to DiTs performs poorly: unlike the highly compressed features of UNets, DiT features are insufficiently structured to provide reliable guidance for point-wise motion supervision. To overcome this limitation, DragFlow introduces a region-based editing paradigm, where affine transformations enable richer and more consistent feature supervision. Additionally, we integrate pretrained open-domain personalization adapters (e.g., IP-Adapter) to enhance subject consistency, while preserving background fidelity through gradient mask-based hard constraints. Multimodal large language models (MLLMs) are further employed to resolve task ambiguities. For evaluation, we curate a novel Region-based Dragging benchmark (ReD Bench) featuring region-level dragging instructions. Extensive experiments on DragBench-DR and ReD Bench show that DragFlow surpasses both point-based and region-based baselines, setting a new state-of-the-art in drag-based image editing. Code and dataset are available at https://github.com/Edennnnnnnnnn/DragFlow."},{"descriptionType":"Other","description":"Accepted by ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02253","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:30Z","registered":"2025-10-03T02:09:31Z","published":null,"updated":"2026-03-03T05:44:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02245","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02245","identifiers":[{"identifier":"2510.02245","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runzhe","familyName":"Zhan","name":"Zhan, Runzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yafu","familyName":"Li","name":"Li, Yafu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Wang","name":"Wang, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoye","familyName":"Qu","name":"Qu, Xiaoye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongrui","familyName":"Liu","name":"Liu, Dongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Shao","name":"Shao, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Derek F.","familyName":"Wong","name":"Wong, Derek F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Cheng","name":"Cheng, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ExGRPO: Learning to Reason from Experience"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:31:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:01:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T13:00:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:40:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning from verifiable rewards (RLVR) is an emerging paradigm for improving the reasoning ability of large language models. However, standard on-policy training discards rollout experiences after a single update, leading to computational inefficiency and instability. While prior work on RL has highlighted the benefits of reusing past experience, the role of experience characteristics in shaping learning dynamics of large reasoning models remains underexplored. In this paper, we are the first to investigate what makes a reasoning experience valuable and identify rollout correctness and entropy as effective indicators of experience value. Based on these insights, we propose ExGRPO (Experiential Group Relative Policy Optimization), a framework that organizes and prioritizes valuable experiences, and employs a mixed-policy objective to balance exploration with experience exploitation. Experiments on five backbone models (1.5B-8B parameters) show that ExGRPO consistently improves reasoning performance on mathematical/general benchmarks, with an average gain of +3.5/7.6 points over on-policy RLVR. Moreover, ExGRPO stabilizes training on both stronger and weaker models where on-policy methods fail. These results highlight principled experience management as a key ingredient for efficient and scalable RLVR."},{"descriptionType":"Other","description":"ICLR 2026 Camera Ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02245","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:17Z","registered":"2025-10-03T02:09:18Z","published":null,"updated":"2026-03-03T05:44:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02209","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02209","identifiers":[{"identifier":"2510.02209","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanxu","familyName":"Chen","name":"Chen, Yanxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijun","familyName":"Yao","name":"Yao, Zijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yantao","familyName":"Liu","name":"Liu, Yantao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amy","familyName":"Xin","name":"Xin, Amy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Ye","name":"Ye, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianing","familyName":"Yu","name":"Yu, Jianing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Hou","name":"Hou, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juanzi","familyName":"Li","name":"Li, Juanzi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StockBench: Can LLM Agents Trade Stocks Profitably In Real-world Markets?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:54:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:59:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T14:50:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:13:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) demonstrate strong potential as autonomous agents, with promising capabilities in reasoning, tool use, and sequential decision-making. While prior benchmarks have evaluated LLM agents in various domains, the financial domain remains underexplored, despite its significant economic value and complex reasoning requirements. Most existing financial benchmarks focus on static question-answering, failing to capture the dynamics of real-market trading. To address this gap, we introduce STOCKBENCH, a contamination-free benchmark designed to evaluate LLM agents in realistic, multi-month stock trading environments. Agents receive daily market signals -- including prices, fundamentals, and news -- and make sequential buy, sell, or hold decisions. Performance is measured using financial metrics such as cumulative return, maximum drawdown, and the Sortino ratio, capturing both profitability and risk management. We evaluate a wide range of state-of-the-art proprietary and open-source LLMs. Surprisingly, most models struggle to outperform the simple buy-and-hold baseline, while some models demonstrate the potential to achieve higher returns and stronger risk management. These findings highlight both the challenges and opportunities of LLM-based trading agents, showing that strong performance on static financial question-answering do not necessarily translate into effective trading behavior. We release STOCKBENCH as an open-source benchmark to enable future research on LLM-driven financial agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02209","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:24Z","registered":"2025-10-03T02:08:25Z","published":null,"updated":"2026-03-03T05:44:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01367","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01367","identifiers":[{"identifier":"2510.01367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinpeng","familyName":"Wang","name":"Wang, Xinpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nitish","familyName":"Joshi","name":"Joshi, Nitish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Barbara","familyName":"Plank","name":"Plank, Barbara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rico","familyName":"Angell","name":"Angell, Rico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"He","name":"He, He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is It Thinking or Cheating? Detecting Implicit Reward Hacking by Measuring Reasoning Effort"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T18:49:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:05:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T07:33:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:27:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-07T17:08:11Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-08T01:00:08Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-02T16:43:38Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-03T03:21:52Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reward hacking, where a reasoning model exploits loopholes in a reward function to achieve high rewards without solving the intended task, poses a significant threat. This behavior may be explicit, i.e. verbalized in the model's chain-of-thought (CoT), or implicit, where the CoT appears benign thus bypasses CoT monitors. To detect implicit reward hacking, we propose TRACE (Truncated Reasoning AUC Evaluation). Our key observation is that hacking occurs when exploiting the loophole is easier than solving the actual task. This means that the model is using less 'effort' than required to achieve high reward. TRACE quantifies effort by measuring how early a model's reasoning becomes sufficient to obtain the reward. We progressively truncate a model's CoT at various lengths, force the model to answer, and estimate the expected reward at each cutoff. A hacking model, which takes a shortcut, will achieve a high expected reward with only a small fraction of its CoT, yielding a large area under the accuracy-vs-length curve. TRACE achieves over 65% gains over our strongest 72B CoT monitor in math reasoning, and over 30% gains over a 32B monitor in coding. We further show that TRACE can discover unknown loopholes during training. Overall, TRACE offers a scalable unsupervised approach for oversight where current monitoring methods prove ineffective."},{"descriptionType":"Other","description":"ICLR 2026 Oral Presentation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01367","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:22Z","registered":"2025-10-03T01:47:23Z","published":null,"updated":"2026-03-03T05:44:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01265","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01265","identifiers":[{"identifier":"2510.01265","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ali","familyName":"Hatamizadeh","name":"Hatamizadeh, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syeda Nahida","familyName":"Akter","name":"Akter, Syeda Nahida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrimai","familyName":"Prabhumoye","name":"Prabhumoye, Shrimai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Kautz","name":"Kautz, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mostofa","familyName":"Patwary","name":"Patwary, Mostofa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Shoeybi","name":"Shoeybi, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan","familyName":"Catanzaro","name":"Catanzaro, Bryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yejin","familyName":"Choi","name":"Choi, Yejin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLP: Reinforcement as a Pretraining Objective"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T17:53:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T21:03:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:24:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The dominant paradigm for training large reasoning models starts with pre-training using next-token prediction loss on vast amounts of data. Reinforcement learning, while powerful in scaling reasoning, is introduced only as the very last phase of post-training, preceded by supervised fine-tuning. While dominant, is this an optimal way of training? In this paper, we present RLP, an information-driven reinforcement pretraining objective, that brings the core spirit of reinforcement learning -- exploration -- to the last phase of pretraining. The key idea is to treat chain-of-thought as an exploratory action, with rewards computed based on the information gain it provides for predicting future tokens. This training objective essentially encourages the model to think for itself before predicting what comes next, thus teaching an independent thinking behavior earlier in the pretraining. More concretely, the reward signal measures the increase in log-likelihood of the next token when conditioning on both context and a sampled reasoning chain, compared to conditioning on context alone. This approach yields a verifier-free dense reward signal, allowing for efficient training for the full document stream during pretraining. Specifically, RLP reframes reinforcement learning for reasoning as a pretraining objective on ordinary text, bridging the gap between next-token prediction and the emergence of useful chain-of-thought reasoning. Pretraining with RLP on Qwen3-1.7B-Base lifts the overall average across an eight-benchmark math-and-science suite by 19%. With identical post-training, the gains compound, with the largest improvements on reasoning-heavy tasks such as AIME25 and MMLU-Pro. Applying RLP to the Nemotron-Nano-12B-v2 increases the overall average from 42.81% to 61.32% and raises the average on scientific reasoning by 23%, demonstrating scalability across architectures and model sizes."},{"descriptionType":"Other","description":"ICLR 2026 camera ready"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01265","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:51Z","registered":"2025-10-03T01:44:52Z","published":null,"updated":"2026-03-03T05:44:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01650","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01650","identifiers":[{"identifier":"2510.01650","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kwanhee","familyName":"Lee","name":"Lee, Kwanhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeondo","familyName":"Jang","name":"Jang, Hyeondo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyeop","familyName":"Lee","name":"Lee, Dongyeop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Alistarh","name":"Alistarh, Dan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Namhoon","familyName":"Lee","name":"Lee, Namhoon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Unseen Frontier: Pushing the Limits of LLM Sparsity with Surrogate-Free ADMM"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:10:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:24:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-23T08:37:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-24T02:15:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural network pruning is a promising technique to mitigate the excessive computational and memory requirements of large language models (LLMs). Despite its promise, however, progress in this area has diminished, as conventional methods are seemingly unable to surpass moderate sparsity levels (50-60%) without severely degrading model accuracy. This work breaks through the current impasse, presenting a principled and effective method called $\\texttt{Elsa}$, which achieves extreme sparsity levels of up to 90% while retaining high model fidelity. This is done by identifying several limitations in current practice, all of which can be traced back to their reliance on a surrogate objective formulation. $\\texttt{Elsa}$ tackles this issue directly and effectively via standard and well-established constrained optimization techniques based on ADMM. Our extensive experiments across a wide range of models and scales show that $\\texttt{Elsa}$ achieves substantial improvements over existing methods; e.g., it achieves 7.8$\\times$ less perplexity than the best existing method on LLaMA-2-7B at 90% sparsity. Moreover, we show that $\\texttt{Elsa}$ remains stable even at extreme sparsity (e.g., 95\\%), yielding up to $\\times$3.98 inference speedup and $\\times$7.80 memory compression over its dense counterpart. We also present $\\texttt{Elsa}_{-L}$, a quantized variant that scales to extremely large models (27B), and establish its theoretical convergence guarantees.These results highlight meaningful progress in advancing the frontier of LLM sparsity, while promising that significant opportunities for further advancement may remain in directions that have so far attracted limited exploration."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01650","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:23Z","registered":"2025-10-03T01:54:24Z","published":null,"updated":"2026-02-24T04:00:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02228","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02228","identifiers":[{"identifier":"2510.02228","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maximilian","familyName":"Beck","name":"Beck, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kajetan","familyName":"Schweighofer","name":"Schweighofer, Kajetan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Böck","name":"Böck, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Lehner","name":"Lehner, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sepp","familyName":"Hochreiter","name":"Hochreiter, Sepp","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"xLSTM Scaling Laws: Competitive Performance with Linear Time-Complexity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:14:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:00:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-20T18:12:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-23T01:46:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Scaling laws play a central role in the success of Large Language Models (LLMs), enabling the prediction of model performance relative to compute budgets prior to training. While Transformers have been the dominant architecture, recent alternatives such as xLSTM offer linear complexity with respect to context length while remaining competitive in the billion-parameter regime. We conduct a comparative investigation on the scaling behavior of Transformers and xLSTM along the following lines, providing insights to guide future model design and deployment. First, we study the scaling behavior for xLSTM in compute-optimal and over-training regimes using both IsoFLOP and parametric fit approaches on a wide range of model sizes (80M-7B) and number of training tokens (2B-2T). Second, we examine the dependence of optimal model sizes on context length, a pivotal aspect that was largely ignored in previous work. Finally, we analyze inference-time scaling characteristics. Our findings reveal that in typical LLM training and inference scenarios, xLSTM scales favorably compared to Transformers. Notably, xLSTM models consistently Pareto-dominate Transformer models, delivering lower cross-entropy loss for the same compute budget."},{"descriptionType":"Other","description":"Accepted at ICLR 2026. Code and data available at https://github.com/NX-AI/xlstm_scaling_laws"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02228","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:52Z","registered":"2025-10-03T02:08:53Z","published":null,"updated":"2026-02-23T02:45:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02186","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02186","identifiers":[{"identifier":"2510.02186","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weijia","familyName":"Dou","name":"Dou, Weijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Zhang","name":"Zhang, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Bin","name":"Bin, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Liu","name":"Liu, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Peng","name":"Peng, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoqing","familyName":"Wang","name":"Wang, Guoqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng Tao","familyName":"Shen","name":"Shen, Heng Tao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GeoPurify: A Data-Efficient Geometric Distillation Framework for Open-Vocabulary 3D Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:37:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:58:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-11T15:41:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-12T01:56:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent attempts to transfer features from 2D Vision-Language Models (VLMs) to 3D semantic segmentation expose a persistent trade-off. Directly projecting 2D features into 3D yields noisy and fragmented predictions, whereas enforcing geometric coherence necessitates costly training pipelines and large-scale annotated 3D data. We argue that this limitation stems from the dominant segmentation-and-matching paradigm, which fails to reconcile 2D semantics with 3D geometric structure. The geometric cues are not eliminated during the 2D-to-3D transfer but remain latent within the noisy and view-aggregated features. To exploit this property, we propose GeoPurify that applies a small Student Affinity Network to purify 2D VLM-generated 3D point features using geometric priors distilled from a 3D self-supervised teacher model. During inference, we devise a Geometry-Guided Pooling module to further denoise the point cloud and ensure the semantic and structural consistency. Benefiting from latent geometric information and the learned affinity network, GeoPurify effectively mitigates the trade-off and achieves superior data efficiency. Extensive experiments on major 3D benchmarks demonstrate that GeoPurify achieves or surpasses state-of-the-art performance while utilizing only about 1.5% of the training data."},{"descriptionType":"Other","description":"Accepted at ICLR 2026. Code available at: https://github.com/tj12323/GeoPurify"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02186","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:07:50Z","registered":"2025-10-03T02:07:51Z","published":null,"updated":"2026-02-12T03:21:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01304","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01304","identifiers":[{"identifier":"2510.01304","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Zeng","name":"Zeng, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Huang","name":"Huang, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiting","familyName":"Huang","name":"Huang, Shiting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xikun","familyName":"Bao","name":"Bao, Xikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukun","familyName":"Qi","name":"Qi, Yukun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Zhao","name":"Zhao, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiuchen","familyName":"Wang","name":"Wang, Qiuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Chen","name":"Chen, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zehui","familyName":"Chen","name":"Chen, Zehui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaian","familyName":"Chen","name":"Chen, Huaian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanli","familyName":"Ouyang","name":"Ouyang, Wanli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Zhao","name":"Zhao, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic Jigsaw Interaction Learning for Enhancing Visual Perception and Reasoning in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T17:58:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-10T15:16:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-11T01:59:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-11T16:48:31Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-12T02:00:32Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although current large Vision-Language Models (VLMs) have advanced in multimodal understanding and reasoning, their fundamental perceptual and reasoning abilities remain limited. Specifically, even on simple jigsaw tasks, existing VLMs perform near randomly, revealing deficiencies in core perception and reasoning capabilities. While high-quality vision-language data can enhance these capabilities, its scarcity and limited scalability impose significant constraints. To address this, we propose AGILE, an Agentic jiGsaw Interaction Learning for Enhancing visual perception and reasoning in VLMs. AGILE formulates jigsaw solving as an interactive process, enabling the model to progressively engage with the environment. At each step, the model generates executable code to perform an action based on the current state, while the environment provides fine-grained visual feedback to guide task completion. Through this iterative cycle of observation and interaction, the model incrementally improves its perceptual and reasoning capabilities via exploration and feedback. Experimental results show that AGILE not only substantially boosts performance on jigsaw tasks of varying complexity (e.g., increasing accuracy from 9.5% to 82.8% under the 2 $\\times$ 2 setting) but also demonstrates strong generalization across 9 general vision tasks, achieving an average improvement of 3.1%. These results indicate notable enhancements in both perceptual and reasoning abilities. This work opens a new avenue for advancing reasoning and generalization in multimodal models and provides an efficient, scalable solution to the scarcity of multimodal reinforcement learning data. The code and datasets is available at https://github.com/yuzeng0-0/AGILE ."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01304","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:47Z","registered":"2025-10-03T01:45:48Z","published":null,"updated":"2026-02-12T03:20:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01879","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01879","identifiers":[{"identifier":"2510.01879","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yisu","familyName":"Wang","name":"Wang, Yisu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Wang","name":"Wang, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyuan","familyName":"Song","name":"Song, Haoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjie","familyName":"Huang","name":"Huang, Wenjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaozheng","familyName":"Wang","name":"Wang, Chaozheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Xie","name":"Xie, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuming","familyName":"Ran","name":"Ran, Xuming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"REPAIR: Robust Editing via Progressive Adaptive Intervention and Reintegration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T10:35:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:38:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-10T05:25:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-11T01:27:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Post-training for large language models (LLMs) is constrained by the high cost of acquiring new knowledge or correcting errors and by the unintended side effects that frequently arise from retraining. To address these issues, we introduce REPAIR (Robust Editing via Progressive Adaptive Intervention and Reintegration), a lifelong editing framework designed to support precise and low-cost model updates while preserving non-target knowledge. REPAIR mitigates the instability and conflicts of large-scale sequential edits through a closed-loop feedback mechanism coupled with dynamic memory management. Furthermore, by incorporating frequent knowledge fusion and enforcing strong locality guards, REPAIR effectively addresses the shortcomings of traditional distribution-agnostic approaches that often overlook unintended ripple effects. Our experiments demonstrate that REPAIR boosts editing accuracy by 10%-30% across multiple model families and significantly reduces knowledge forgetting. This work introduces a robust framework for developing reliable, scalable, and continually evolving LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01879","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:00:11Z","registered":"2025-10-03T02:00:12Z","published":null,"updated":"2026-02-11T03:28:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01220","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01220","identifiers":[{"identifier":"2510.01220","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bonaventure F. P.","familyName":"Dossou","name":"Dossou, Bonaventure F. P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henri","familyName":"Aïdasso","name":"Aïdasso, Henri","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Open-Ended Discovery for Low-Resource NLP"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T01:19:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-08T23:01:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T02:20:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.uncertainlp-main.24","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Natural Language Processing (NLP) for low-resource languages remains fundamentally constrained by the lack of textual corpora, standardized orthographies, and scalable annotation pipelines. While recent advances in large language models have improved cross-lingual transfer, they remain inaccessible to underrepresented communities due to their reliance on massive, pre-collected data and centralized infrastructure. In this position paper, we argue for a paradigm shift toward open-ended, interactive language discovery, where AI systems learn new languages dynamically through dialogue rather than static datasets. We contend that the future of language technology, particularly for low-resource and under-documented languages, must move beyond static data collection pipelines toward interactive, uncertainty-driven discovery, where learning emerges dynamically from human-machine collaboration instead of being limited to pre-existing datasets. We propose a framework grounded in joint human-machine uncertainty, combining epistemic uncertainty from the model with hesitation cues and confidence signals from human speakers to guide interaction, query selection, and memory retention. This paper is a call to action: we advocate a rethinking of how AI engages with human knowledge in under-documented languages, moving from extractive data collection toward participatory, co-adaptive learning processes that respect and empower communities while discovering and preserving the world's linguistic diversity. This vision aligns with principles of human-centered AI, emphasizing interactive, cooperative model building between AI systems and speakers."},{"descriptionType":"Other","description":"Proceedings of the 2nd Workshop on Uncertainty-Aware NLP (UncertaiNLP) at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01220","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:43:45Z","registered":"2025-10-03T01:43:46Z","published":null,"updated":"2026-02-10T05:21:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01285","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01285","identifiers":[{"identifier":"2510.01285","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alireza","familyName":"Salemi","name":"Salemi, Alireza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihir","familyName":"Parmar","name":"Parmar, Mihir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Palash","familyName":"Goyal","name":"Goyal, Palash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwen","familyName":"Song","name":"Song, Yiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsung","familyName":"Yoon","name":"Yoon, Jinsung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamed","familyName":"Zamani","name":"Zamani, Hamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomas","familyName":"Pfister","name":"Pfister, Tomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamid","familyName":"Palangi","name":"Palangi, Hamid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Based Multi-Agent Blackboard System for Information Discovery in Data Science"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T22:34:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-31T23:30:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:55:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Advances in large language models (LLMs) have created new opportunities in data science, but their deployment is often limited by the challenge of finding relevant data in large data lakes. Existing methods struggle with this: both single- and multi-agent systems are quickly overwhelmed by large, heterogeneous files, and master-slave multi-agent systems rely on a rigid central controller that requires precise knowledge of each sub-agent's capabilities, which is not possible in large-scale settings where the main agent lacks full observability over sub-agents' knowledge and competencies. We propose a novel multi-agent paradigm inspired by the blackboard architecture for traditional AI models. In our framework, a central agent posts requests to a shared blackboard, and autonomous subordinate agents - either responsible for a partition of the data lake or retrieval from the web - volunteer to respond based on their capabilities. This design improves scalability and flexibility by removing the need for a central coordinator to know each agent's expertise or internal knowledge. We evaluate the approach on three benchmarks that require data discovery: KramaBench and modified versions of DSBench and DA-Code. Results show that the blackboard architecture substantially outperforms strong baselines, achieving 13%-57% relative improvements in end-to-end success and up to a 9% relative gain in data discovery F1 over the best baseline."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01285","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:20Z","registered":"2025-10-03T01:45:20Z","published":null,"updated":"2026-02-03T05:40:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01268","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01268","identifiers":[{"identifier":"2510.01268","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongyi","familyName":"Zhou","name":"Zhou, Hongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Zhu","name":"Zhu, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pingfan","familyName":"Su","name":"Su, Pingfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Ye","name":"Ye, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Yang","name":"Yang, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shakeel A O B","familyName":"Gavioli-Akilagun","name":"Gavioli-Akilagun, Shakeel A O B","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengchun","familyName":"Shi","name":"Shi, Chengchun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AdaDetectGPT: Adaptive Detection of LLM-Generated Text with Statistical Guarantees"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T10:04:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-24T13:46:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T00:51:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-27T15:06:24Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-29T00:01:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-07T15:28:12Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-09T01:55:26Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02-01T16:50:37Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-02-03T02:17:16Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We study the problem of determining whether a piece of text has been authored by a human or by a large language model (LLM). Existing state of the art logits-based detectors make use of statistics derived from the log-probability of the observed text evaluated using the distribution function of a given source LLM. However, relying solely on log probabilities can be sub-optimal. In response, we introduce AdaDetectGPT -- a novel classifier that adaptively learns a witness function from training data to enhance the performance of logits-based detectors. We provide statistical guarantees on its true positive rate, false positive rate, true negative rate and false negative rate. Extensive numerical studies show AdaDetectGPT nearly uniformly improves the state-of-the-art method in various combination of datasets and LLMs, and the improvement can reach up to 37\\%. A python implementation of our method is available at https://github.com/Mamba413/AdaDetectGPT."},{"descriptionType":"Other","description":"Accepted by NeurIPS2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01268","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:55Z","registered":"2025-10-03T01:44:56Z","published":null,"updated":"2026-02-03T05:40:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01254","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01254","identifiers":[{"identifier":"2510.01254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shree Harsha Bokkahalli","familyName":"Satish","name":"Satish, Shree Harsha Bokkahalli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gustav Eje","familyName":"Henter","name":"Henter, Gustav Eje","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Éva","familyName":"Székely","name":"Székely, Éva","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Bias Benchmarks Generalise? Evidence from Voice-based Evaluation of Gender Bias in SpeechLLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T16:16:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-01T16:36:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T02:16:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent work in benchmarking bias and fairness in speech large language models (SpeechLLMs) has relied heavily on multiple-choice question answering (MCQA) formats. The model is tasked to choose between stereotypical, anti-stereotypical, or neutral/irrelevant answers given an input speech prompt and an optional text prompt. Such MCQA benchmarks implicitly assume that model performance is consistent across other MCQA tasks, voices, and other task formats such as more realistic, long-form evaluations. In this paper, we probe that assumption. We fine-tune three SpeechLLMs using LoRA adapters to induce specific MCQA behaviours: preference for stereotypical, anti-stereotypical, or neutral/uncertain answers. We then evaluate whether these behaviours generalise to another, distinct MCQA benchmark, and more critically to long-form, creative generation tasks. Our results show that performance on MCQA bias benchmarks fails to reliably predict performances across other MCQA benchmarks, and more importantly across long-form tasks. We conclude that current MCQA bias benchmarks show limited evidence of cross-task generalisation in the speech domain, and also propose an evaluation suite for measuring behaviour transferability in future models and benchmarks."},{"descriptionType":"Other","description":"5 pages, 2 Figures, Accepted to IEEE ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01254","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:34Z","registered":"2025-10-03T01:44:35Z","published":null,"updated":"2026-02-03T05:40:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01250","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01250","identifiers":[{"identifier":"2510.01250","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Trung Duc Anh","familyName":"Dang","name":"Dang, Trung Duc Anh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ferdinando Pio","familyName":"D'Elia","name":"D'Elia, Ferdinando Pio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GemDetox at TextDetox CLEF 2025: Enhancing a Massively Multilingual Model for Text Detoxification on Low-resource Languages"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T10:06:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-03T01:21:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As social-media platforms emerge and evolve faster than the regulations meant to oversee them, automated detoxification might serve as a timely tool for moderators to enforce safe discourse at scale. We here describe our submission to the PAN 2025 Multilingual Text Detoxification Challenge, which rewrites toxic single-sentence inputs into neutral paraphrases across 15 typologically diverse languages. Building on a 12B-parameter Gemma-3 multilingual transformer, we apply parameter-efficient LoRA SFT fine-tuning and prompting techniques like few-shot and Chain-of-Thought. Our multilingual training corpus combines 3,600 human-authored parallel pairs, 21,600 machine-translated synthetic pairs, and model-generated pairs filtered by Jaccard thresholds. At inference, inputs are enriched with three LaBSE-retrieved neighbors and explicit toxic-span annotations. Evaluated via Style Transfer Accuracy, LaBSE-based semantic preservation, and xCOMET fluency, our system ranks first on high-resource and low-resource languages. Ablations show +0.081 joint score increase from few-shot examples and +0.088 from basic CoT prompting. ANOVA analysis identifies language resource status as the strongest predictor of performance ($η^2$ = 0.667, p \u0026lt; 0.01)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01250","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:29Z","registered":"2025-10-03T01:44:29Z","published":null,"updated":"2026-02-03T05:40:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02295","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02295","identifiers":[{"identifier":"2510.02295","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Enxin","familyName":"Song","name":"Song, Enxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Chai","name":"Chai, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shusheng","familyName":"Yang","name":"Yang, Shusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan","familyName":"Armand","name":"Armand, Ethan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Shan","name":"Shan, Xiaojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Xu","name":"Xu, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwen","familyName":"Xie","name":"Xie, Jianwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuowen","familyName":"Tu","name":"Tu, Zhuowen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VideoNSA: Native Sparse Attention Scales Video Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:58:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:03:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-30T06:16:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:30:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Video understanding in multimodal language models remains limited by context length: models often miss key transition frames and struggle to maintain coherence across long time scales. To address this, we adapt Native Sparse Attention (NSA) to video-language models. Our method, VideoNSA, adapts Qwen2.5-VL through end-to-end training on a 216K video instruction dataset. We employ a hardware-aware hybrid approach to attention, preserving dense attention for text, while employing NSA for video. Compared to token-compression and training-free sparse baselines, VideoNSA achieves improved performance on long-video understanding, temporal reasoning, and spatial benchmarks. Further ablation analysis reveals four key findings: (1) reliable scaling to 128K tokens; (2) an optimal global-local attention allocation at a fixed budget; (3) task-dependent branch usage patterns; and (4) the learnable combined sparse attention help induce dynamic attention sinks. Project Page: https://enxinsong.com/VideoNSA-web/, Code: https://github.com/Espere-1119-Song/VideoNSA"},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02295","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:31Z","registered":"2025-10-03T02:10:32Z","published":null,"updated":"2026-02-02T03:25:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02291","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02291","identifiers":[{"identifier":"2510.02291","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Litu","familyName":"Rout","name":"Rout, Litu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Lugmayr","name":"Lugmayr, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasamin","familyName":"Jafarian","name":"Jafarian, Yasamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Srivatsan","familyName":"Varadharajan","name":"Varadharajan, Srivatsan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Constantine","familyName":"Caramanis","name":"Caramanis, Constantine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanjay","familyName":"Shakkottai","name":"Shakkottai, Sanjay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ira","familyName":"Kemelmacher-Shlizerman","name":"Kemelmacher-Shlizerman, Ira","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Anchoring for Discrete Diffusion Posterior Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:58:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:03:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-30T03:35:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-02T01:22:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While continuous diffusion models have achieved remarkable success, discrete diffusion offers a unified framework for jointly modeling text and images. Beyond unification, discrete diffusion provides faster inference, finer control, and principled training-free guidance, making it well-suited for posterior sampling. Existing approaches to posterior sampling using discrete diffusion face severe challenges: derivative-free guidance yields sparse signals, continuous relaxations limit applicability, and split Gibbs samplers suffer from the curse of dimensionality. To overcome these limitations, we introduce Anchored Posterior Sampling (APS), built on two key innovations: quantized expectation for gradient-like guidance in discrete embedding space, and anchored remasking for adaptive decoding. APS achieves state-of-the-art performance among discrete diffusion samplers on both linear and nonlinear inverse problems across the standard image benchmarks. We demonstrate the generality of APS through training-free stylization and text-guided editing. We further apply APS to a large-scale diffusion language model, showing consistent improvement in question answering."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02291","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:26Z","registered":"2025-10-03T02:10:27Z","published":null,"updated":"2026-02-02T03:25:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01458","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01458","identifiers":[{"identifier":"2510.01458","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shawn","familyName":"Im","name":"Im, Shawn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sharon","familyName":"Li","name":"Li, Sharon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Well Can Preference Optimization Generalize Under Noisy Feedback?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:56:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:10:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T21:58:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T00:11:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-30T17:15:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-02T02:05:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) advance their capabilities, aligning these models with human preferences has become crucial. Preference optimization, which trains models to distinguish between preferred and non-preferred responses based on human feedback, has become a crucial component for aligning LLMs. However, most existing works assume noise-free feedback, which is unrealistic due to the inherent errors and inconsistencies in human judgments. This paper addresses the impact of noisy feedback on preference optimization, providing generalization guarantees under these conditions. In particular, we consider noise models that correspond to common real-world sources of noise, such as mislabeling and uncertainty. Unlike traditional analyses that assume convergence, our work focuses on finite-step preference optimization, offering new insights that are more aligned with practical LLM training. We describe how generalization decays with different types of noise across levels of noise rates based on the preference data distribution and number of samples. Our analysis for noisy preference learning applies to a broad family of preference optimization losses such as DPO, IPO, SLiC, etc. Empirical validation on contemporary LLMs confirms the practical relevance of our findings, offering valuable insights for developing AI systems that align with human preferences."},{"descriptionType":"Other","description":"TMLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01458","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:35Z","registered":"2025-10-03T01:49:36Z","published":null,"updated":"2026-02-02T03:25:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02190","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02190","identifiers":[{"identifier":"2510.02190","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Yao","name":"Yao, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixu","familyName":"Wang","name":"Wang, Yixu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Zhang","name":"Zhang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Lu","name":"Lu, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianle","familyName":"Gu","name":"Gu, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingyu","familyName":"Li","name":"Li, Lingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingyi","familyName":"Zhao","name":"Zhao, Dingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keming","familyName":"Wu","name":"Wu, Keming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhe","familyName":"Wang","name":"Wang, Haozhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Nie","name":"Nie, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Teng","name":"Teng, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingchun","familyName":"Wang","name":"Wang, Yingchun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dr. Bench: A Multidimensional Evaluation for Deep Research Agents, from Answers to Reports"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:40:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:58:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T14:47:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T02:02:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As an embodiment of intelligence evolution toward interconnected architectures, Deep Research Agents (DRAs) systematically exhibit the capabilities in task decomposition, cross-source retrieval, multi-stage reasoning, information integration, and structured output, which markedly enhance performance on complex and open-ended tasks. However, existing benchmarks remain deficient in evaluation dimensions, response format, and scoring mechanisms, limiting their effectiveness in assessing such agents. This paper introduces Dr. Bench, a multidimensional evaluation framework tailored to DRAs and long-form report-style responses. The benchmark comprises 214 expert-curated challenging tasks across 10 broad domains, each accompanied by manually constructed reference bundles to support composite evaluation. This framework incorporates metrics for semantic quality, topical focus, and retrieval trustworthiness, enabling a comprehensive evaluation of long reports generated by DRAs. Extensive experimentation confirms the superior performance of mainstream DRAs over web-search-tool-augmented reasoning models, yet reveals considerable scope for further improvement. This study provides a robust foundation for capability assessment, architectural refinement, and paradigm advancement of DRAs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02190","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:07:56Z","registered":"2025-10-03T02:07:57Z","published":null,"updated":"2026-01-30T03:42:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02180","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02180","identifiers":[{"identifier":"2510.02180","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Silvia","familyName":"Sapora","name":"Sapora, Silvia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Devon","familyName":"Hjelm","name":"Hjelm, Devon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Toshev","name":"Toshev, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omar","familyName":"Attia","name":"Attia, Omar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bogdan","familyName":"Mazoure","name":"Mazoure, Bogdan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GRACE: A Language Model Framework for Explainable Inverse Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:31:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:58:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-28T16:17:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-29T01:56:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Inverse Reinforcement Learning aims to recover reward models from expert demonstrations, but traditional methods yield black-box models that are difficult to interpret and debug. In this work, we introduce GRACE (Generating Rewards As CodE), a method for using Large Language Models within an evolutionary search to reverse-engineer an interpretable, code-based reward function directly from expert trajectories. The resulting reward function is executable code that can be inspected and verified. We empirically validate GRACE on the MuJoCo, BabyAI and AndroidWorld benchmarks, where it efficiently learns highly accurate rewards, even in complex, multi-task settings. Further, we demonstrate that the resulting reward leads to strong policies, compared to both competitive Imitation Learning and online RL approaches with ground-truth rewards. Finally, we show that GRACE is able to build complex reward APIs in multi-task setups."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02180","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:07:41Z","registered":"2025-10-03T02:07:41Z","published":null,"updated":"2026-01-29T03:13:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01733","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01733","identifiers":[{"identifier":"2510.01733","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix J.","familyName":"Yu","name":"Yu, Felix J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Kamp","name":"Kamp, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlos A.","familyName":"Argüelles","name":"Argüelles, Carlos A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reducing Simulation Dependence in Neutrino Telescopes with Masked Point Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T07:18:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:29:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-25T04:09:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T01:43:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning techniques in neutrino physics have traditionally relied on simulated data, which provides access to ground-truth labels. However, the accuracy of these simulations and the discrepancies between simulated and real data remain significant concerns, particularly for large-scale neutrino telescopes that operate in complex natural media. In recent years, self-supervised learning has emerged as a powerful paradigm for reducing dependence on labeled datasets. Here, we present the first self-supervised training pipeline for neutrino telescopes, leveraging point cloud transformers and masked autoencoders. By shifting the majority of training to real data, this approach minimizes reliance on simulations, thereby mitigating associated systematic uncertainties. This represents a fundamental departure from previous machine learning applications in neutrino telescopes, paving the way for substantial improvements in event reconstruction and classification."},{"descriptionType":"Other","description":"8 pages, 3 figures, presented at the 39th International Cosmic Ray Conference (ICRC2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01733","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:56:35Z","registered":"2025-10-03T01:56:35Z","published":null,"updated":"2026-01-27T04:35:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02212","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02212","identifiers":[{"identifier":"2510.02212","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanyang","familyName":"Zhao","name":"Zhao, Hanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawen","familyName":"Liang","name":"Liang, Dawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenpin","familyName":"Tang","name":"Tang, Wenpin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Yao","name":"Yao, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Kallus","name":"Kallus, Nathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiFFPO: Training Diffusion LLMs to Reason Fast and Furious via Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:57:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:59:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-10T10:25:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T01:23:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose DiFFPO, Diffusion Fast and Furious Policy Optimization, a unified framework for training masked diffusion large language models (dLLMs) to reason not only better (furious), but also faster via reinforcement learning (RL). We first unify the existing baseline approach such as d1 by proposing to train surrogate policies via off-policy RL, whose likelihood is much more tractable as an approximation to the true dLLM policy. This naturally motivates a more accurate and informative two-stage likelihood approximation combined with importance sampling correction, which leads to generalized RL algorithms with better sample efficiency and superior task performance. Second, we propose a new direction of joint training efficient samplers/controllers of dLLMs policy. Via RL, we incentivize dLLMs' natural multi-token prediction capabilities by letting the model learn to adaptively allocate an inference threshold for each prompt. By jointly training the sampler, we yield better accuracies with lower number of function evaluations (NFEs) compared to training the model only, obtaining the best performance in improving the Pareto frontier of the inference-time compute of dLLMs. We showcase the effectiveness of our pipeline by training open source large diffusion language models over benchmark math and planning tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02212","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:29Z","registered":"2025-10-03T02:08:29Z","published":null,"updated":"2026-01-13T04:26:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01228","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01228","identifiers":[{"identifier":"2510.01228","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siqi","familyName":"Zeng","name":"Zeng, Siqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Who is In Charge? Dissecting Role Conflicts in Instruction Following"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T03:24:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-17T23:27:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-19T01:14:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models should follow hierarchical instructions where system prompts override user inputs, yet recent work shows they often ignore this rule while strongly obeying social cues such as authority or consensus. We extend these behavioral findings with mechanistic interpretations on a large-scale dataset. Linear probing shows conflict-decision signals are encoded early, with system-user and social conflicts forming distinct subspaces. Direct Logit Attribution reveals stronger internal conflict detection in system-user cases but consistent resolution only for social cues. Steering experiments show that, despite using social cues, the vectors surprisingly amplify instruction following in a role-agnostic way. Together, these results explain fragile system obedience and underscore the need for lightweight hierarchy-sensitive alignment methods."},{"descriptionType":"Other","description":"12 pages, 5 figures, Mech Interp Workshop (NeurIPS 2025) Poster"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01228","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:57Z","registered":"2025-10-03T01:43:57Z","published":null,"updated":"2025-12-19T03:17:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01899","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01899","identifiers":[{"identifier":"2510.01899","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Talha","familyName":"Mohsin","name":"Mohsin, Md Talha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ismail","familyName":"Abdulrashid","name":"Abdulrashid, Ismail","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal Foundation Models for Early Disease Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T11:12:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:39:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-16T20:46:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-18T01:07:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Healthcare data now span EHRs, medical imaging, genomics, and wearable sensors, but most diagnostic models still process these modalities in isolation. This limits their ability to capture early, cross-modal disease signatures. This paper introduces a multimodal foundation model built on a transformer architecture that integrates heterogeneous clinical data through modality-specific encoders and cross-modal attention. Each modality is mapped into a shared latent space and fused using multi-head attention with residual normalization. We implement the framework using a multimodal dataset that simulates early-stage disease patterns across EHR sequences, imaging patches, genomic profiles, and wearable signals, including missing-modality scenarios and label noise. The model is trained using supervised classification together with self-supervised reconstruction and contrastive alignment to improve robustness. Experimental evaluation demonstrates strong performance in early-detection settings, with stable classification metrics, reliable uncertainty estimates, and interpretable attention patterns. The approach moves toward a flexible, pretrain-and-fine-tune foundation model that supports precision diagnostics, handles incomplete inputs, and improves early disease detection across oncology, cardiology, and neurology applications."},{"descriptionType":"Other","description":"6 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01899","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:00:42Z","registered":"2025-10-03T02:00:43Z","published":null,"updated":"2025-12-18T03:06:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01472","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01472","identifiers":[{"identifier":"2510.01472","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hengyi","familyName":"Zhu","name":"Zhu, Hengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grace Li","familyName":"Zhang","name":"Zhang, Grace Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyi","familyName":"Huang","name":"Huang, Shaoyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-NAS: LLM-driven Hardware-Aware Neural Architecture Search"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T21:29:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:11:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T17:40:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:39:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-02T18:21:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-03T02:00:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-04T20:26:48Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-08T01:05:07Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Hardware-Aware Neural Architecture Search (HW-NAS) requires joint optimization of accuracy and latency under device constraints. Traditional supernet-based methods require multiple GPU days per dataset. Large Language Model (LLM)-driven approaches avoid training a large supernet and can provide quick feedback, but we observe an exploration bias: the LLM repeatedly proposes neural network designs within limited search space and fails to discover architectures across different latency ranges in the entire search space. To address this issue, we propose LLM-NAS: an LLM-driven Neural Architecture Search that can generate neural networks with high accuracy and low latency with reduced search cost. Our proposed LLM-NAS has three key components: 1) a complexity-driven partitioning engine that divides the search space by complexity to enforce diversity and mitigate exploration bias; 2) an LLM-powered architecture prompt co-evolution operator, in which the LLM first updates a knowledge base of design heuristics based on results from the previous round, then performs a guided evolution algorithm on architectures with prompts that incorporate this knowledge base. Prompts and designs improve together across rounds which avoids random guesswork and improve efficiency; 3) a zero-cost predictor to avoid training a large number of candidates from scratch. Experimental results show that on HW-NAS-Bench, LLM-NAS can achieve overall higher HV, lower IGD, and up to 54% lower latency than baselines at similar accuracy. Meanwhile, the search cost drops from days to minutes compared with traditional supernet baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01472","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:56Z","registered":"2025-10-03T01:49:57Z","published":null,"updated":"2025-12-08T02:47:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01219","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01219","identifiers":[{"identifier":"2510.01219","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leroy Z.","familyName":"Wang","name":"Wang, Leroy Z.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Uncovering Implicit Bias in Large Language Models with Concept Learning Dataset"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T09:04:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-26T06:42:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-27T01:28:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a dataset of concept learning tasks that helps uncover implicit biases in large language models. Using in-context concept learning experiments, we found that language models may have a bias toward upward monotonicity in quantifiers; such bias is less apparent when the model is tested by direct prompting without concept learning components. This demonstrates that in-context concept learning can be an effective way to discover hidden biases in language models."},{"descriptionType":"Other","description":"Presented at EurIPS 2025 Workshop - Unifying Perspectives on Learning Biases (UPLB) https://sites.google.com/view/towards-a-unified-view"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01219","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:44Z","registered":"2025-10-03T01:43:44Z","published":null,"updated":"2025-11-27T03:16:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01223","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01223","identifiers":[{"identifier":"2510.01223","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ning","familyName":"Xu","name":"Xu, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Gao","name":"Gao, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Dou","name":"Dou, Hui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Jailbreaking LLMs via Semantically Relevant Nested Scenarios with Targeted Toxic Knowledge"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:37:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-17T11:40:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T02:43:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have demonstrated remarkable capabilities in various tasks. However, they remain exposed to jailbreak attacks, eliciting harmful responses. The nested scenario strategy has been increasingly adopted across various methods, demonstrating immense potential. Nevertheless, these methods are easily detectable due to their prominent malicious intentions. In this work, we are the first to find and systematically verify that LLMs' alignment defenses are not sensitive to nested scenarios, where these scenarios are highly semantically relevant to the queries and incorporate targeted toxic knowledge. This is a crucial yet insufficiently explored direction. Based on this, we propose RTS-Attack (Semantically Relevant Nested Scenarios with Targeted Toxic Knowledge), an adaptive and automated framework to examine LLMs' alignment. By building scenarios highly relevant to the queries and integrating targeted toxic knowledge, RTS-Attack bypasses the alignment defenses of LLMs. Moreover, the jailbreak prompts generated by RTS-Attack are free from harmful queries, leading to outstanding concealment. Extensive experiments demonstrate that RTS-Attack exhibits superior performance in both efficiency and universality compared to the baselines across diverse advanced LLMs, including GPT-4o, Llama3-70b, and Gemini-pro. Our complete code is available at https://github.com/nercode/Work. WARNING: THIS PAPER CONTAINS POTENTIALLY HARMFUL CONTENT."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01223","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:49Z","registered":"2025-10-03T01:43:50Z","published":null,"updated":"2025-11-18T05:15:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01611","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01611","identifiers":[{"identifier":"2510.01611","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Min","familyName":"Zeng","name":"Zeng, Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PsychCounsel-Bench: Evaluating the Psychology Intelligence of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:49:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T19:24:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-09T00:05:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-20T14:59:12Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-21T01:34:16Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11-12T22:18:01Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-11-14T01:09:19Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have demonstrated remarkable success across a wide range of industries, primarily due to their impressive generative abilities. Yet, their potential in applications requiring cognitive abilities, such as psychological counseling, remains largely untapped. This paper investigates the key question: \\textit{Can LLMs be effectively applied to psychological counseling?} To determine whether an LLM can effectively take on the role of a psychological counselor, the first step is to assess whether it meets the qualifications required for such a role, namely the ability to pass the U.S. National Counselor Certification Exam (NCE). This is because, just as a human counselor must pass a certification exam to practice, an LLM must demonstrate sufficient psychological knowledge to meet the standards required for such a role. To address this, we introduce PsychCounsel-Bench, a benchmark grounded in U.S.national counselor examinations, a licensure test for professional counselors that requires about 70\\% accuracy to pass. PsychCounsel-Bench comprises approximately 2,252 carefully curated single-choice questions, crafted to require deep understanding and broad enough to cover various sub-disciplines of psychology. This benchmark provides a comprehensive assessment of an LLM's ability to function as a counselor. Our evaluation shows that advanced models such as GPT-4o, Llama3.3-70B, and Gemma3-27B achieve well above the passing threshold, while smaller open-source models (e.g., Qwen2.5-7B, Mistral-7B) remain far below it. These results suggest that only frontier LLMs are currently capable of meeting counseling exam standards, highlighting both the promise and the challenges of developing psychology-oriented LLMs. We release the proposed dataset for public use: https://github.com/cloversjtu/PsychCounsel-Bench"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01611","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:27Z","registered":"2025-10-03T01:53:27Z","published":null,"updated":"2025-11-14T03:10:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01252","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01252","identifiers":[{"identifier":"2510.01252","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mariam","familyName":"Mahran","name":"Mahran, Mariam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katharina","familyName":"Simbeck","name":"Simbeck, Katharina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GPT and Prejudice: A Sparse Approach to Understanding Learned Representations in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T11:10:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T12:24:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:37:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-13T10:09:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-14T01:35:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are trained on massive, unstructured corpora, making it unclear which social patterns and biases they absorb and later reproduce. Existing evaluations typically examine outputs or activations, but rarely connect them back to the pre-training data. We introduce a pipeline that couples LLMs with sparse autoencoders (SAEs) to trace how different themes are encoded during training. As a controlled case study, we trained a GPT-style model on 37 nineteenth-century novels by ten female authors, a corpus centered on themes such as gender, marriage, class, and morality. By applying SAEs across layers and probing with eleven social and moral categories, we mapped sparse features to human-interpretable concepts. The analysis revealed stable thematic backbones (most prominently around gender and kinship) and showed how associations expand and entangle with depth. More broadly, we argue that the LLM+SAEs pipeline offers a scalable framework for auditing how cultural assumptions from the data are embedded in model representations."},{"descriptionType":"Other","description":"Preprint. Draft version, subject to revision"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01252","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:31Z","registered":"2025-10-03T01:44:32Z","published":null,"updated":"2025-11-14T03:10:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01258","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01258","identifiers":[{"identifier":"2510.01258","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nathan Junzi","familyName":"Chen","name":"Chen, Nathan Junzi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measuring Algorithmic Partisanship via Zero-Shot Classification and Its Implications on Political Discourse"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T05:26:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-02T07:54:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T01:51:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Amidst the rapid normalization of generative artificial intelligence (GAI), intelligent systems have come to dominate political discourse across information media. However, internalized political biases stemming from training data skews, human prejudice, and algorithmic flaws continue to plague this novel technology. This study employs a zero-shot classification approach to evaluate algorithmic political partisanship through a methodical combination of ideological alignment, topicality, response sentiment, and objectivity. A total of 1800 model responses across six mainstream large language models (LLMs) were individually input into four distinct fine-tuned classification algorithms, each responsible for computing one of the aforementioned metrics. The results show an amplified liberal-authoritarian alignment across the six LLMs evaluated, with notable instances of reasoning supersessions and canned refusals. The study subsequently highlights the psychological influences underpinning human-computer interactions and how intrinsic biases can permeate public discourse. The resulting distortion of the political landscape can ultimately manifest as conformity or polarization, depending on the region's pre-existing socio-political structures."},{"descriptionType":"Other","description":"19 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01258","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:41Z","registered":"2025-10-03T01:44:41Z","published":null,"updated":"2025-11-04T04:57:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01617","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01617","identifiers":[{"identifier":"2510.01617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hui Yi","familyName":"Leong","name":"Leong, Hui Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuheng","familyName":"Li","name":"Li, Yuheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Wu","name":"Wu, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenwen","familyName":"Ouyang","name":"Ouyang, Wenwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhu","name":"Zhu, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiechao","familyName":"Gao","name":"Gao, Jiechao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Han","name":"Han, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AMAS: Adaptively Determining Communication Topology for LLM-based Multi-Agent System"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:50:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T09:33:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:22:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-29T03:16:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-30T00:23:21Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although large language models (LLMs) have revolutionized natural language processing capabilities, their practical implementation as autonomous multi-agent systems (MAS) for industrial problem-solving encounters persistent barriers. Conventional MAS architectures are fundamentally restricted by inflexible, hand-crafted graph topologies that lack contextual responsiveness, resulting in diminished efficacy across varied academic and commercial workloads. To surmount these constraints, we introduce AMAS, a paradigm-shifting framework that redefines LLM-based MAS through a novel dynamic graph designer. This component autonomously identifies task-specific optimal graph configurations via lightweight LLM adaptation, eliminating the reliance on monolithic, universally applied structural templates. Instead, AMAS exploits the intrinsic properties of individual inputs to intelligently direct query trajectories through task-optimized agent pathways. Rigorous validation across question answering, mathematical deduction, and code generation benchmarks confirms that AMAS systematically exceeds state-of-the-art single-agent and multi-agent approaches across diverse LLM architectures. Our investigation establishes that context-sensitive structural adaptability constitutes a foundational requirement for high-performance LLM MAS deployments."},{"descriptionType":"Other","description":"Accepted by EMNLP-2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01617","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:35Z","registered":"2025-10-03T01:53:36Z","published":null,"updated":"2025-10-30T02:18:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01225","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01225","identifiers":[{"identifier":"2510.01225","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andrei","familyName":"Lazarev","name":"Lazarev, Andrei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dmitrii","familyName":"Sedov","name":"Sedov, Dmitrii","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Utilizing Modern Large Language Models (LLM) for Financial Trend Analysis and Digest Creation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T21:04:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-30T00:01:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/summa64428.2024.10803746","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The exponential growth of information presents a significant challenge for researchers and professionals seeking to remain at the forefront of their fields and this paper introduces an innovative framework for automatically generating insightful financial digests using the power of Large Language Models (LLMs), specifically Google's Gemini Pro. By leveraging a combination of data extraction from OpenAlex, strategic prompt engineering, and LLM-driven analysis, we demonstrate the automated example of creating a comprehensive digests that generalize key findings, identify emerging trends. This approach addresses the limitations of traditional analysis methods, enabling the efficient processing of vast amounts of unstructured data and the delivery of actionable insights in an easily digestible format. This paper describes how LLMs work in simple words and how we can use their power to help researchers and scholars save their time and stay informed about current trends. Our study includes step-by-step process, from data acquisition and JSON construction to interaction with Gemini and the automated generation of PDF reports, including a link to the project's GitHub repository for broader accessibility and further development."},{"descriptionType":"Other","description":"This is the version of the article accepted for publication in SUMMA 2024 after peer review. The final, published version is available at IEEE Xplore: 10.1109/SUMMA64428.2024.10803746"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01225","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:43:52Z","registered":"2025-10-03T01:43:53Z","published":null,"updated":"2025-10-30T02:18:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02279","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02279","identifiers":[{"identifier":"2510.02279","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mykyta","familyName":"Ielanskyi","name":"Ielanskyi, Mykyta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kajetan","familyName":"Schweighofer","name":"Schweighofer, Kajetan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas","familyName":"Aichberger","name":"Aichberger, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sepp","familyName":"Hochreiter","name":"Hochreiter, Sepp","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Addressing Pitfalls in the Evaluation of Uncertainty Estimation Methods for Natural Language Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:54:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:03:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-23T08:55:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-24T00:38:06Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Hallucinations are a common issue that undermine the reliability of large language models (LLMs). Recent studies have identified a specific subset of hallucinations, known as confabulations, which arise due to predictive uncertainty of LLMs. To detect confabulations, various methods for estimating predictive uncertainty in natural language generation (NLG) have been developed. These methods are typically evaluated by correlating uncertainty estimates with the correctness of generated text, with question-answering (QA) datasets serving as the standard benchmark. However, commonly used approximate correctness functions have substantial disagreement between each other and, consequently, in the ranking of the uncertainty estimation methods. This allows one to inflate the apparent performance of uncertainty estimation methods. We propose using several alternative risk indicators for risk correlation experiments that improve robustness of empirical assessment of UE algorithms for NLG. For QA tasks, we show that marginalizing over multiple LLM-as-a-judge variants leads to reducing the evaluation biases. Furthermore, we explore structured tasks as well as out of distribution and perturbation detection tasks which provide robust and controllable risk indicators. Finally, we propose to use an Elo rating of uncertainty estimation methods to give an objective summarization over extensive evaluation settings."},{"descriptionType":"Other","description":"Preprint, under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02279","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:09Z","registered":"2025-10-03T02:10:09Z","published":null,"updated":"2025-10-24T02:15:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01600","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01600","identifiers":[{"identifier":"2510.01600","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Neal Gregory","familyName":"Lawton","name":"Lawton, Neal Gregory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alfy","familyName":"Samuel","name":"Samuel, Alfy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anoop","familyName":"Kumar","name":"Kumar, Anoop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daben","familyName":"Liu","name":"Liu, Daben","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Comparison of Independent and Joint Fine-tuning Strategies for Retrieval-Augmented Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:30:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:20:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-17T20:14:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-21T00:09:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A Comparison of Independent and Joint Fine-tuning Strategies for Retrieval-Augmented Generation Download PDF Neal Gregory Lawton, Alfy Samuel, Anoop Kumar, Daben Liu Published: 20 Aug 2025, Retrieval augmented generation (RAG) is a popular framework for question answering that is powered by two large language models (LLMs): an embedding model that retrieves context documents from a database that are relevant to a given question, and a generator model that uses the retrieved context to generate an answer to the question. Both the embedding and generator models can be fine-tuned to increase performance of a RAG pipeline on a new task, but multiple fine-tuning strategies exist with different costs and benefits. In this paper, we evaluate and compare several RAG fine-tuning strategies, including independent, joint, and two-phase fine-tuning. In our experiments, we observe that all of these strategies achieve about equal improvement in EM and F1 generation quality metrics, although they have significantly different computational costs. We conclude the optimal fine-tuning strategy to use depends on whether the training dataset includes context labels and whether a grid search over the learning rates for the embedding and generator models is required."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01600","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:10Z","registered":"2025-10-03T01:53:11Z","published":null,"updated":"2025-10-21T03:42:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01656","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01656","identifiers":[{"identifier":"2510.01656","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiashun","familyName":"Liu","name":"Liu, Jiashun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johan","familyName":"Obando-Ceron","name":"Obando-Ceron, Johan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Lu","name":"Lu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yancheng","familyName":"He","name":"He, Yancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixun","familyName":"Wang","name":"Wang, Weixun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbo","familyName":"Su","name":"Su, Wenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zheng","name":"Zheng, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pablo Samuel","familyName":"Castro","name":"Castro, Pablo Samuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron","familyName":"Courville","name":"Courville, Aaron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Pan","name":"Pan, Ling","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asymmetric Proximal Policy Optimization: mini-critics boost LLM reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:24:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:24:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T03:46:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:21:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-15T08:36:52Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-16T00:35:50Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Most recent RL for LLMs (RL4LLM) methods avoid explicit critics, replacing them with average advantage baselines. This shift is largely pragmatic: conventional value functions are computationally expensive to train at LLM scale and often fail under sparse rewards and long reasoning horizons. We revisit this bottleneck from an architectural perspective and introduce Asymmetric Proximal Policy Optimization (AsyPPO), a simple and scalable framework that restores the critics role while remaining efficient in large-model settings. AsyPPO employs a set of lightweight mini-critics, each trained on disjoint prompt shards. This design encourages diversity while preserving calibration, reducing value-estimation bias. Beyond robust estimation, AsyPPO leverages inter-critic uncertainty to refine the policy update: (i) masking advantages in states where critics agree and gradients add little learning signal, and (ii) filtering high-divergence states from entropy regularization, suppressing spurious exploration. After training on open-source data with only 5,000 samples, AsyPPO consistently improves learning stability and performance across multiple benchmarks over strong baselines, such as GRPO, achieving performance gains of more than six percent on Qwen3-4b-Base and about three percent on Qwen3-8b-Base and Qwen3-14b-Base over classic PPO, without additional tricks. These results highlight the importance of architectural innovations for scalable, efficient algorithms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01656","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:32Z","registered":"2025-10-03T01:54:33Z","published":null,"updated":"2025-10-16T02:26:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01644","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01644","identifiers":[{"identifier":"2510.01644","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"John","familyName":"Hawkins","name":"Hawkins, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Pramar","name":"Pramar, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodney","familyName":"Beard","name":"Beard, Rodney","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rohitash","familyName":"Chandra","name":"Chandra, Rohitash","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Machine Learning for Detection and Analysis of Novel LLM Jailbreaks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T03:55:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:23:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T05:08:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:23:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) suffer from a range of vulnerabilities that allow malicious users to solicit undesirable responses through manipulation of the input text. These so-called jailbreak prompts are designed to trick the LLM into circumventing the safety guardrails put in place to keep responses acceptable to the developer's policies. In this study, we analyse the ability of different machine learning models to distinguish jailbreak prompts from genuine uses, including looking at our ability to identify jailbreaks that use previously unseen strategies. Our results indicate that using current datasets the best performance is achieved by fine tuning a Bidirectional Encoder Representations from Transformers (BERT) model end-to-end for identifying jailbreaks. We visualise the keywords that distinguish jailbreak from genuine prompts and conclude that explicit reflexivity in prompt structure could be a signal of jailbreak intention."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01644","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:15Z","registered":"2025-10-03T01:54:15Z","published":null,"updated":"2025-10-13T02:16:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01521","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01521","identifiers":[{"identifier":"2510.01521","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Diptyaroop","familyName":"Maji","name":"Maji, Diptyaroop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Yang","name":"Yang, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prashant","familyName":"Shenoy","name":"Shenoy, Prashant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramesh K","familyName":"Sitaraman","name":"Sitaraman, Ramesh K","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mani","familyName":"Srivastava","name":"Srivastava, Mani","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CarbonX: An Open-Source Tool for Computational Decarbonization Using Time Series Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T23:36:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:14:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T17:49:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T01:04:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Computational decarbonization aims to reduce carbon emissions in computing and societal systems such as data centers, transportation, and built environments. This requires accurate, fine-grained carbon intensity forecasts, yet existing tools have several key limitations: (i) they require grid-specific electricity mix data, restricting use where such information is unavailable; (ii) they depend on separate grid-specific models that make it challenging to provide global coverage; and (iii) they provide forecasts without uncertainty estimates, limiting reliability for downstream carbon-aware applications.\n In this paper, we present CarbonX, an open-source tool that leverages Time Series Foundation Models (TSFMs) for a range of decarbonization tasks. CarbonX utilizes the versatility of TSFMs to provide strong performance across multiple tasks, such as carbon intensity forecasting and imputation, and across diverse grids. Using only historical carbon intensity data and a single general model, our tool achieves a zero-shot forecasting Mean Absolute Percentage Error (MAPE) of 15.82% across 214 grids worldwide. Across 13 benchmark grids, CarbonX performance is comparable with the current state-of-the-art, with an average MAPE of 9.59% and tail forecasting MAPE of 16.54%, while also providing prediction intervals with 95% coverage. CarbonX can provide forecasts for up to 21 days with minimal accuracy degradation. Further, when fully fine-tuned, CarbonX outperforms the statistical baselines by 1.2--3.9X on the imputation task. Overall, these results demonstrate that CarbonX can be used easily on any grid with limited data and still deliver strong performance, making it a practical tool for global-scale decarbonization."},{"descriptionType":"Other","description":"Update: Corrected PDF rendering error on page 10 (caption of Figure 5 was previously overlapping with paper text)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01521","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:14Z","registered":"2025-10-03T01:51:14Z","published":null,"updated":"2025-10-13T02:16:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01298","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01298","identifiers":[{"identifier":"2510.01298","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Berker","familyName":"Demirel","name":"Demirel, Berker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Fumero","name":"Fumero, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Theofanis","familyName":"Karaletsos","name":"Karaletsos, Theofanis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Locatello","name":"Locatello, Francesco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MorphGen: Controllable and Morphologically Plausible Generative Cell-Imaging"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T13:34:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T13:11:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-13T00:48:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Simulating in silico cellular responses to interventions is a promising direction to accelerate high-content image-based assays, critical for advancing drug discovery and gene editing. To support this, we introduce MorphGen, a state-of-the-art diffusion-based generative model for fluorescent microscopy that enables controllable generation across multiple cell types and perturbations. To capture biologically meaningful patterns consistent with known cellular morphologies, MorphGen is trained with an alignment loss to match its representations to the phenotypic embeddings of OpenPhenom, a state-of-the-art biological foundation model. Unlike prior approaches that compress multichannel stains into RGB images -- thus sacrificing organelle-specific detail -- MorphGen generates the complete set of fluorescent channels jointly, preserving per-organelle structures and enabling a fine-grained morphological analysis that is essential for biological interpretation. We demonstrate biological consistency with real images via CellProfiler features, and MorphGen attains an FID score over 35% lower than the prior state-of-the-art MorphoDiff, which only generates RGB images for a single cell type. Code is available at https://github.com/czi-ai/MorphGen."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01298","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:38Z","registered":"2025-10-03T01:45:39Z","published":null,"updated":"2025-10-13T02:16:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02227","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02227","identifiers":[{"identifier":"2510.02227","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Yuan","name":"Yuan, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujuan","familyName":"Ding","name":"Ding, Yujuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Bin","name":"Bin, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqi","familyName":"Shao","name":"Shao, Wenqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyu","familyName":"Cai","name":"Cai, Jinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingkuan","familyName":"Song","name":"Song, Jingkuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng Tao","familyName":"Shen","name":"Shen, Heng Tao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"More Than One Teacher: Adaptive Multi-Guidance Policy Optimization for Diverse Exploration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:14:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:00:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T17:18:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T01:10:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning with Verifiable Rewards (RLVR) is a promising paradigm for enhancing the reasoning ability in Large Language Models (LLMs). However, prevailing methods primarily rely on self-exploration or a single off-policy teacher to elicit long chain-of-thought (LongCoT) reasoning, which may introduce intrinsic model biases and restrict exploration, ultimately limiting reasoning diversity and performance. Drawing inspiration from multi-teacher strategies in knowledge distillation, we introduce Adaptive Multi-Guidance Policy Optimization (AMPO), a novel framework that adaptively leverages guidance from multiple proficient teacher models, but only when the on-policy model fails to generate correct solutions. This \"guidance-on-demand\" approach expands exploration while preserving the value of self-discovery. Moreover, AMPO incorporates a comprehension-based selection mechanism, prompting the student to learn from the reasoning paths that it is most likely to comprehend, thus balancing broad exploration with effective exploitation. Extensive experiments show AMPO substantially outperforms a strong baseline (GRPO), with a 4.3% improvement on mathematical reasoning tasks and 12.2% on out-of-distribution tasks, while significantly boosting Pass@k performance and enabling more diverse exploration. Notably, using four peer-sized teachers, our method achieves comparable results to approaches that leverage a single, more powerful teacher (e.g., DeepSeek-R1) with more data. These results demonstrate a more efficient and scalable path to superior reasoning and generalizability. Our code is available at https://github.com/SII-Enigma/AMPO."},{"descriptionType":"Other","description":"20 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02227","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:51Z","registered":"2025-10-03T02:08:52Z","published":null,"updated":"2025-10-10T02:39:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02173","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02173","identifiers":[{"identifier":"2510.02173","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hsuan","familyName":"Su","name":"Su, Hsuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting-Yao","familyName":"Hu","name":"Hu, Ting-Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hema Swetha","familyName":"Koppula","name":"Koppula, Hema Swetha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kundan","familyName":"Krishna","name":"Krishna, Kundan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hadi","familyName":"Pouransari","name":"Pouransari, Hadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-Yu","familyName":"Hsieh","name":"Hsieh, Cheng-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cem","familyName":"Koc","name":"Koc, Cem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph Yitan","familyName":"Cheng","name":"Cheng, Joseph Yitan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oncel","familyName":"Tuzel","name":"Tuzel, Oncel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raviteja","familyName":"Vemulapalli","name":"Vemulapalli, Raviteja","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning to Reason for Hallucination Span Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:24:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:57:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T19:06:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:04:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) often generate hallucinations -- unsupported content that undermines reliability. While most prior works frame hallucination detection as a binary task, many real-world applications require identifying hallucinated spans, which is a multi-step decision making process. This naturally raises the question of whether explicit reasoning can help the complex task of detecting hallucination spans. To answer this question, we first evaluate pretrained models with and without Chain-of-Thought (CoT) reasoning, and show that CoT reasoning has the potential to generate at least one correct answer when sampled multiple times. Motivated by this, we propose RL4HS, a reinforcement learning framework that incentivizes reasoning with a span-level reward function. RL4HS builds on Group Relative Policy Optimization and introduces Class-Aware Policy Optimization to mitigate reward imbalance issue. Experiments on the RAGTruth benchmark (summarization, question answering, data-to-text) show that RL4HS surpasses pretrained reasoning models and supervised fine-tuning, demonstrating the necessity of reinforcement learning with span-level rewards for detecting hallucination spans."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02173","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:07:30Z","registered":"2025-10-03T02:07:31Z","published":null,"updated":"2025-10-10T02:39:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01538","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01538","identifiers":[{"identifier":"2510.01538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haokun","familyName":"Zhao","name":"Zhao, Haokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Zhang","name":"Zhang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wei","name":"Wei, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Xu","name":"Xu, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"He","name":"He, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Sun","name":"Sun, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyu","familyName":"You","name":"You, Chenyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TimeSeriesScientist: A General-Purpose AI Agent for Time Series Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T00:18:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T19:00:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:06:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series forecasting is central to decision-making in domains as diverse as energy, finance, climate, and public health. In practice, forecasters face thousands of short, noisy series that vary in frequency, quality, and horizon, where the dominant cost lies not in model fitting, but in the labor-intensive preprocessing, validation, and ensembling required to obtain reliable predictions. Prevailing statistical and deep learning models are tailored to specific datasets or domains and generalize poorly. A general, domain-agnostic framework that minimizes human intervention is urgently in demand. In this paper, we introduce TimeSeriesScientist (TSci), the first LLM-driven agentic framework for general time series forecasting. The framework comprises four specialized agents: Curator performs LLM-guided diagnostics augmented by external tools that reason over data statistics to choose targeted preprocessing; Planner narrows the hypothesis space of model choice by leveraging multi-modal diagnostics and self-planning over the input; Forecaster performs model fitting and validation and, based on the results, adaptively selects the best model configuration as well as ensemble strategy to make final predictions; and Reporter synthesizes the whole process into a comprehensive, transparent report. With transparent natural-language rationales and comprehensive reports, TSci transforms the forecasting workflow into a white-box system that is both interpretable and extensible across tasks. Empirical results on eight established benchmarks demonstrate that TSci consistently outperforms both statistical and LLM-based baselines, reducing forecast error by an average of 10.4% and 38.2%, respectively. Moreover, TSci produces a clear and rigorous report that makes the forecasting workflow more transparent and interpretable."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01538","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:38Z","registered":"2025-10-03T01:51:39Z","published":null,"updated":"2025-10-08T02:21:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01238","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01238","identifiers":[{"identifier":"2510.01238","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rom","familyName":"Himelstein","name":"Himelstein, Rom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"LeVi","name":"LeVi, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonatan","familyName":"Belinkov","name":"Belinkov, Yonatan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avi","familyName":"Mendelson","name":"Mendelson, Avi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Silent Tokens, Loud Effects: Padding in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T22:57:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T12:48:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:31:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Padding tokens are widely used in large language models (LLMs) to equalize sequence lengths during batched inference. While they should be fully masked, implementation errors can cause them to influence computation, and the extent of this influence is not well understood. We systematically study this effect across three open-source model families (Llama, Gemma, Qwen), inserting controlled amounts of padding and evaluating outcomes along four axes: activations, generation quality, bias, and safety. Even small amounts of padding shift hidden representations, degrade quality in smaller models, alter bias in unpredictable ways, and weaken safety guardrails. These findings demonstrate that padding is not a harmless detail but a robustness risk that must be carefully handled in deployment."},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025 Workshop on Evaluating the Evolving LLM Lifecycle: Benchmarks, Emergent Abilities, and Scaling"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01238","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:11Z","registered":"2025-10-03T01:44:12Z","published":null,"updated":"2025-10-07T03:56:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01688","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01688","identifiers":[{"identifier":"2510.01688","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seungseop","familyName":"Lim","name":"Lim, Seungseop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gibaeg","familyName":"Kim","name":"Kim, Gibaeg","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wooseok","familyName":"Han","name":"Han, Wooseok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean","familyName":"Seo","name":"Seo, Jean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunkyung","familyName":"Lee","name":"Lee, Hyunkyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaehyo","familyName":"Yoo","name":"Yoo, Jaehyo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunho","familyName":"Yang","name":"Yang, Eunho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Format Inertia: A Failure Mechanism of LLMs in Medical Pre-Consultation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T05:29:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:26:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T10:16:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:31:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Language Models (LLMs) have brought significant improvements to various service domains, including chatbots and medical pre-consultation applications. In the healthcare domain, the most common approach for adapting LLMs to multi-turn dialogue generation is Supervised Fine-Tuning (SFT). However, datasets for SFT in tasks like medical pre-consultation typically exhibit a skewed turn-count distribution. Training on such data induces a novel failure mechanism we term Format Inertia, where models tend to generate repetitive, format-correct, but diagnostically uninformative questions in long medical dialogues. To mitigate this observed failure mechanism, we adopt a simple, data-centric method that rebalances the turn-count distribution of the training dataset. Experimental results show that our approach substantially alleviates Format Inertia in medical pre-consultation."},{"descriptionType":"Other","description":"EMNLP 2025 Industry Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01688","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:55:24Z","registered":"2025-10-03T01:55:25Z","published":null,"updated":"2025-10-07T03:55:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02271","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02271","identifiers":[{"identifier":"2510.02271","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yaxin","familyName":"Du","name":"Du, Yaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanshuo","familyName":"Zhang","name":"Zhang, Yuanshuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyuan","familyName":"Yang","name":"Yang, Xiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhou","name":"Zhou, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Wang","name":"Wang, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongyi","familyName":"Zou","name":"Zou, Gongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianghe","familyName":"Pang","name":"Pang, Xianghe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Wang","name":"Wang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Menglan","familyName":"Chen","name":"Chen, Menglan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Tang","name":"Tang, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyu","familyName":"Li","name":"Li, Zhiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feiyu","familyName":"Xiong","name":"Xiong, Feiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siheng","familyName":"Chen","name":"Chen, Siheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InfoMosaic-Bench: Evaluating Multi-Source Information Seeking in Tool-Augmented Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:48:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:02:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T09:18:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:29:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Information seeking is a fundamental requirement for humans. However, existing LLM agents rely heavily on open-web search, which exposes two fundamental weaknesses: online content is noisy and unreliable, and many real-world tasks require precise, domain-specific knowledge unavailable from the web. The emergence of the Model Context Protocol (MCP) now allows agents to interface with thousands of specialized tools, seemingly resolving this limitation. Yet it remains unclear whether agents can effectively leverage such tools -- and more importantly, whether they can integrate them with general-purpose search to solve complex tasks. Therefore, we introduce InfoMosaic-Bench, the first benchmark dedicated to multi-source information seeking in tool-augmented agents. Covering six representative domains (medicine, finance, maps, video, web, and multi-domain integration), InfoMosaic-Bench requires agents to combine general-purpose search with domain-specific tools. Tasks are synthesized with InfoMosaic-Flow, a scalable pipeline that grounds task conditions in verified tool outputs, enforces cross-source dependencies, and filters out shortcut cases solvable by trivial lookup. This design guarantees both reliability and non-triviality. Experiments with 14 state-of-the-art LLM agents reveal three findings: (i) web information alone is insufficient, with GPT-5 achieving only 38.2% accuracy and 67.5% pass rate; (ii) domain tools provide selective but inconsistent benefits, improving some domains while degrading others; and (iii) 22.4% of failures arise from incorrect tool usage or selection, highlighting that current LLMs still struggle with even basic tool handling."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02271","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:56Z","registered":"2025-10-03T02:09:57Z","published":null,"updated":"2025-10-07T03:55:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01932","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01932","identifiers":[{"identifier":"2510.01932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qi","familyName":"He","name":"He, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Qian","name":"Qian, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiusi","familyName":"Chen","name":"Chen, Xiusi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingxiang","familyName":"He","name":"He, Bingxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi R.","familyName":"Fung","name":"Fung, Yi R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng","familyName":"Ji","name":"Ji, Heng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Veri-R1: Toward Precise and Faithful Claim Verification via Online Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T11:49:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:41:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T07:24:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:26:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Claim verification with large language models (LLMs) has recently attracted growing attention, due to their strong reasoning capabilities and transparent verification processes compared to traditional answer-only judgments. However, existing approaches to online claim verification, which requires iterative evidence retrieval and reasoning, still mainly rely on prompt engineering or pre-designed reasoning workflows, without unified training to improve necessary skills. Therefore, we introduce Veri-R1, an online reinforcement learning (RL) framework that enables an LLM to interact with a search engine and to receive reward signals that explicitly shape its planning, retrieval, and reasoning behaviors. This dynamic interaction of LLM with retrieval systems more accurately reflects real-world verification scenarios and fosters comprehensive verification skills. Empirical results show that Veri-R1 improves joint accuracy by up to 30% and doubles the evidence score, often surpassing its larger-scale model counterparts. Ablation studies further reveal the impact of reward components, and the link between output logits and label accuracy. Our results highlight the effectiveness of online RL for precise and faithful claim verification, providing an important foundation for future research. We release our code to support community progress in LLM empowered claim verification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01932","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:01:33Z","registered":"2025-10-03T02:01:33Z","published":null,"updated":"2025-10-07T03:55:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02120","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02120","identifiers":[{"identifier":"2510.02120","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Charalampos","familyName":"Lamprou","name":"Lamprou, Charalampos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aamna","familyName":"Alshehhi","name":"Alshehhi, Aamna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leontios J.","familyName":"Hadjileontiadis","name":"Hadjileontiadis, Leontios J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed L.","familyName":"Seghier","name":"Seghier, Mohamed L.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VarCoNet: A variability-aware self-supervised framework for functional connectome extraction from resting-state fMRI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T15:29:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:54:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T06:57:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:24:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accounting for inter-individual variability in brain function is key to precision medicine. Here, by considering functional inter-individual variability as meaningful data rather than noise, we introduce VarCoNet, an enhanced self-supervised framework for robust functional connectome (FC) extraction from resting-state fMRI (rs-fMRI) data. VarCoNet employs self-supervised contrastive learning to exploit inherent functional inter-individual variability, serving as a brain function encoder that generates FC embeddings readily applicable to downstream tasks even in the absence of labeled data. Contrastive learning is facilitated by a novel augmentation strategy based on segmenting rs-fMRI signals. At its core, VarCoNet integrates a 1D-CNN-Transformer encoder for advanced time-series processing, enhanced with a robust Bayesian hyperparameter optimization. Our VarCoNet framework is evaluated on two downstream tasks: (i) subject fingerprinting, using rs-fMRI data from the Human Connectome Project, and (ii) autism spectrum disorder (ASD) classification, using rs-fMRI data from the ABIDE I and ABIDE II datasets. Using different brain parcellations, our extensive testing against state-of-the-art methods, including 13 deep learning methods, demonstrates VarCoNet's superiority, robustness, interpretability, and generalizability. Overall, VarCoNet provides a versatile and robust framework for FC analysis in rs-fMRI."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02120","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:06:12Z","registered":"2025-10-03T02:06:13Z","published":null,"updated":"2025-10-06T02:05:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01494","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01494","identifiers":[{"identifier":"2510.01494","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Isha","familyName":"Gupta","name":"Gupta, Isha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rylan","familyName":"Schaeffer","name":"Schaeffer, Rylan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joshua","familyName":"Kazdan","name":"Kazdan, Joshua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ken Ziyu","familyName":"Liu","name":"Liu, Ken Ziyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanmi","familyName":"Koyejo","name":"Koyejo, Sanmi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Adversarial Transfer: Why Representation-Space Attacks Fail Where Data-Space Attacks Succeed"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T22:10:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:12:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T11:35:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:35:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The field of adversarial robustness has long established that adversarial examples can successfully transfer between image classifiers and that text jailbreaks can successfully transfer between language models (LMs). However, a pair of recent studies reported being unable to successfully transfer image jailbreaks between vision-language models (VLMs). To explain this striking difference, we propose a fundamental distinction regarding the transferability of attacks against machine learning models: attacks in the input data-space can transfer, whereas attacks in model representation space do not, at least not without geometric alignment of representations. We then provide theoretical and empirical evidence of this hypothesis in four different settings. First, we mathematically prove this distinction in a simple setting where two networks compute the same input-output map but via different representations. Second, we construct representation-space attacks against image classifiers that are as successful as well-known data-space attacks, but fail to transfer. Third, we construct representation-space attacks against LMs that successfully jailbreak the attacked models but again fail to transfer. Fourth, we construct data-space attacks against VLMs that successfully transfer to new VLMs, and we show that representation space attacks can transfer when VLMs' latent geometries are sufficiently aligned in post-projector space. Our work reveals that adversarial transfer is not an inherent property of all attacks but contingent on their operational domain - the shared data-space versus models' unique representation spaces - a critical insight for building more robust models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01494","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:50:29Z","registered":"2025-10-03T01:50:29Z","published":null,"updated":"2025-10-06T02:03:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02084","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02084","identifiers":[{"identifier":"2510.02084","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kuiye","familyName":"Ding","name":"Ding, Kuiye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fanda","familyName":"Fan","name":"Fan, Fanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheya","familyName":"Wang","name":"Wang, Zheya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongxiao","familyName":"Li","name":"Li, Hongxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wang","name":"Wang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Wang","name":"Wang, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunjie","familyName":"Luo","name":"Luo, Chunjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianfeng","familyName":"Zhan","name":"Zhan, Jianfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KAIROS: Unified Training for Universal Non-Autoregressive Time Series Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T14:50:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:51:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T05:10:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:21:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In the World Wide Web, reliable time series forecasts provide the forward-looking signals that drive resource planning, cache placement, and anomaly response, enabling platforms to operate efficiently as user behavior and content distributions evolve. Compared with other domains, time series forecasting for Web applications requires much faster responsiveness to support real-time decision making. We present KAIROS, a non-autoregressive time series forecasting framework that directly models segment-level multi-peak distributions. Unlike autoregressive approaches, KAIROS avoids error accumulation and achieves just-in-time inference, while improving over existing non-autoregressive models that collapse to over-smoothed predictions. Trained on the large-scale corpus, KAIROS demonstrates strong zero-shot generalization on six widely used benchmarks, delivering forecasting performance comparable to state-of-the-art foundation models with similar scale, at a fraction of their inference cost. Beyond empirical results, KAIROS highlights the importance of non-autoregressive design as a scalable paradigm for foundation models in time series."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02084","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:05:19Z","registered":"2025-10-03T02:05:19Z","published":null,"updated":"2025-10-06T02:01:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01471","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01471","identifiers":[{"identifier":"2510.01471","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haotian","familyName":"Xiang","name":"Xiang, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwen","familyName":"Xu","name":"Xu, Jinwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qin","familyName":"Lu","name":"Lu, Qin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fine-tuning LLMs with variational Bayesian last layer for high-dimensional Bayesian optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T21:28:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:11:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T00:33:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:14:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A plethora of applications entail solving black-box optimization problems with high evaluation costs, including drug discovery, material design, as well as hyperparameter tuning. Toward finding the global optimum of such black-box optimization problems with sample efficiency, Bayesian optimization (BO) is a theoretically elegant framework that relies on a probabilistic surrogate model so as to iteratively select the query point with well-balanced exploration-exploitation tradeoffs. The Gaussian process (GP), as the de-facto choice for surrogate modeling, has achieved compelling performances for vanilla BO with low-dimensional continuous variables. However, GPs fall short in coping with high-dimensional counterparts with {\\it irregular} variables (e.g., categorical, ordinal, etc.). To alleviate this, neural network-based surrogates have been explored. Inspired by the powerful capabilities of LLMs, we adopt the LLM as the surrogate to model the mapping from the high-dimensional input variables to the objective function. To adapt to the current problem, we leverage the low-rank adaptation (LoRA) to fine-tune the LLM parameters together with the posterior of a linear regression head via the variational Bayesian last layer (VBLL) framework. The resulting LoRA-VBLL is not only computationally light compared to existing alternatives, but also admits recursive updates. To automate the critical selection of the LoRA rank as well as other hyperparameters, a weighted ensemble (ENS) of LoRA-VBLL surrogates has been devised, which further accommodates continual update of the per-model weight and individual LoRA-VBLL parameters via recursive Bayes. Extensive experimental results demonstrate the compelling performance of the proposed (ENS-)LoRA-VBLL approaches on various high-dimensional benchmarks and the real-world molecular optimization tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01471","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:55Z","registered":"2025-10-03T01:49:56Z","published":null,"updated":"2025-10-06T02:00:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01227","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01227","identifiers":[{"identifier":"2510.01227","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicole N","familyName":"Khatibi","name":"Khatibi, Nicole N","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniil A.","familyName":"Radamovich","name":"Radamovich, Daniil A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael P.","familyName":"Brenner","name":"Brenner, Michael P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EEFSUVA: A New Mathematical Olympiad Benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"History and Overview (math.HO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T01:57:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-06T00:49:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent breakthroughs have spurred claims that large language models (LLMs) match gold medal Olympiad to graduate level proficiency on mathematics benchmarks. In this work, we examine these claims in detail and assess the extent to which current benchmarks capture genuine LLM mathematical reasoning. The composition of these benchmarks, primarily drawing from the International Mathematics Olympiad (IMO) and related competitions, may overstate models reasoning ability due to potential data contamination and a narrow focus on familiar problem types. To enable a more holistic assessment of mathematical understanding, we introduce EEFSUVA, a novel benchmark curated from under circulated regional and national Olympiads of Eastern Europe and the countries from the former Soviet Union. These contests feature problems of comparable difficulty to the IMO and are renowned for demanding nonstandard problem-solving techniques, yet their problems are far less prevalent in online corpora. Preliminary results suggest that even state-of-the-art LLMs exhibit a notable performance decline on EEFSUVA relative to other Olympiad-style benchmarks. These findings also suggest the potential importance of broader evaluation datasets for a fuller assessment of mathematical reasoning and for guiding future model development."},{"descriptionType":"Other","description":"16 Pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01227","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:55Z","registered":"2025-10-03T01:43:56Z","published":null,"updated":"2025-10-06T01:59:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02306","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02306","identifiers":[{"identifier":"2510.02306","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Raphael","familyName":"Tang","name":"Tang, Raphael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Crystina","familyName":"Zhang","name":"Zhang, Crystina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenyan","familyName":"Li","name":"Li, Wenyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carmen","familyName":"Lai","name":"Lai, Carmen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pontus","familyName":"Stenetorp","name":"Stenetorp, Pontus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Lu","name":"Lu, Yao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Drawing Conclusions from Draws: Rethinking Preference Semantics in Arena-Style LLM Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:59:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:04:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In arena-style evaluation of large language models (LLMs), two LLMs respond to a user query, and the user chooses the winning response or deems the \"battle\" a draw, resulting in an adjustment to the ratings of both models. The prevailing approach for modeling these rating dynamics is to view battles as two-player game matches, as in chess, and apply the Elo rating system and its derivatives. In this paper, we critically examine this paradigm. Specifically, we question whether a draw genuinely means that the two models are equal and hence whether their ratings should be equalized. Instead, we conjecture that draws are more indicative of query difficulty: if the query is too easy, then both models are more likely to succeed equally. On three real-world arena datasets, we show that ignoring rating updates for draws yields a 1-3% relative increase in battle outcome prediction accuracy (which includes draws) for all four rating systems studied. Further analyses suggest that draws occur more for queries rated as very easy and those as highly objective, with risk ratios of 1.37 and 1.35, respectively. We recommend future rating systems to reconsider existing draw semantics and to account for query properties in rating updates."},{"descriptionType":"Other","description":"6 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02306","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:47Z","registered":"2025-10-03T02:10:48Z","published":null,"updated":"2025-10-03T02:10:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02294","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02294","identifiers":[{"identifier":"2510.02294","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyin","familyName":"Zhang","name":"Zhang, Ziyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihan","familyName":"Liao","name":"Liao, Zihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Yu","name":"Yu, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Di","name":"Di, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Wang","name":"Wang, Rui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"F2LLM Technical Report: Matching SOTA Embedding Performance with 6 Million Open-Source Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:58:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:03:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce F2LLM - Foundation to Feature Large Language Models, a suite of state-of-the-art embedding models in three sizes: 0.6B, 1.7B, and 4B. Unlike previous top-ranking embedding models that require massive contrastive pretraining, sophisticated training pipelines, and costly synthetic training data, F2LLM is directly finetuned from foundation models on 6 million query-document-negative tuples curated from open-source, non-synthetic datasets, striking a strong balance between training cost, model size, and embedding performance. On the MTEB English leaderboard, F2LLM-4B ranks 2nd among models with approximately 4B parameters and 7th overall, while F2LLM-1.7B ranks 1st among models in the 1B-2B size range. To facilitate future research in the field, we release the models, training dataset, and code, positioning F2LLM as a strong, reproducible, and budget-friendly baseline for future works."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02294","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:30Z","registered":"2025-10-03T02:10:31Z","published":null,"updated":"2025-10-03T02:10:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02292","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02292","identifiers":[{"identifier":"2510.02292","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hala","familyName":"Sheta","name":"Sheta, Hala","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Huang","name":"Huang, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyu","familyName":"Wu","name":"Wu, Shuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ilia","familyName":"Alenabi","name":"Alenabi, Ilia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Hong","name":"Hong, Jiajun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryker","familyName":"Lin","name":"Lin, Ryker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoxi","familyName":"Ning","name":"Ning, Ruoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Wei","name":"Wei, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Yang","name":"Yang, Jialin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Zhou","name":"Zhou, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqiao","familyName":"Ma","name":"Ma, Ziqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Freda","familyName":"Shi","name":"Shi, Freda","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Behavioral Performance to Internal Competence: Interpreting Vision-Language Models with VLM-Lens"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:58:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:03:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce VLM-Lens, a toolkit designed to enable systematic benchmarking, analysis, and interpretation of vision-language models (VLMs) by supporting the extraction of intermediate outputs from any layer during the forward pass of open-source VLMs. VLM-Lens provides a unified, YAML-configurable interface that abstracts away model-specific complexities and supports user-friendly operation across diverse VLMs. It currently supports 16 state-of-the-art base VLMs and their over 30 variants, and is extensible to accommodate new models without changing the core logic.\n The toolkit integrates easily with various interpretability and analysis methods. We demonstrate its usage with two simple analytical experiments, revealing systematic differences in the hidden representations of VLMs across layers and target concepts. VLM-Lens is released as an open-sourced project to accelerate community efforts in understanding and improving VLMs."},{"descriptionType":"Other","description":"EMNLP 2025 System Demonstration | Code: https://github.com/compling-wat/vlm-lens"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02292","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:10:27Z","registered":"2025-10-03T02:10:28Z","published":null,"updated":"2025-10-03T02:10:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02263","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02263","identifiers":[{"identifier":"2510.02263","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxiao","familyName":"Qu","name":"Qu, Yuxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anikait","familyName":"Singh","name":"Singh, Anikait","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoonho","familyName":"Lee","name":"Lee, Yoonho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amrith","familyName":"Setlur","name":"Setlur, Amrith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruslan","familyName":"Salakhutdinov","name":"Salakhutdinov, Ruslan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chelsea","familyName":"Finn","name":"Finn, Chelsea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aviral","familyName":"Kumar","name":"Kumar, Aviral","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLAD: Training LLMs to Discover Abstractions for Solving Reasoning Problems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:44:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:02:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reasoning requires going beyond pattern matching or memorization of solutions to identify and implement \"algorithmic procedures\" that can be used to deduce answers to hard problems. Doing so requires realizing the most relevant primitives, intermediate results, or shared procedures, and building upon them. While RL post-training on long chains of thought ultimately aims to uncover this kind of algorithmic behavior, most reasoning traces learned by large models fail to consistently capture or reuse procedures, instead drifting into verbose and degenerate exploration. To address more effective reasoning, we introduce reasoning abstractions: concise natural language descriptions of procedural and factual knowledge that guide the model toward learning successful reasoning. We train models to be capable of proposing multiple abstractions given a problem, followed by RL that incentivizes building a solution while using the information provided by these abstractions. This results in a two-player RL training paradigm, abbreviated as RLAD, that jointly trains an abstraction generator and a solution generator. This setup effectively enables structured exploration, decouples learning signals of abstraction proposal and solution generation, and improves generalization to harder problems. We also show that allocating more test-time compute to generating abstractions is more beneficial for performance than generating more solutions at large test budgets, illustrating the role of abstractions in guiding meaningful exploration."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02263","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:44Z","registered":"2025-10-03T02:09:45Z","published":null,"updated":"2025-10-03T02:09:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02241","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02241","identifiers":[{"identifier":"2510.02241","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Gwon","name":"Gwon, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nour","familyName":"Jedidi","name":"Jedidi, Nour","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jimmy","familyName":"Lin","name":"Lin, Jimmy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Study on LLMs for Promptagator-Style Dense Retriever Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:29:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Promptagator demonstrated that Large Language Models (LLMs) with few-shot prompts can be used as task-specific query generators for fine-tuning domain-specialized dense retrieval models. However, the original Promptagator approach relied on proprietary and large-scale LLMs which users may not have access to or may be prohibited from using with sensitive data. In this work, we study the impact of open-source LLMs at accessible scales ($\\leq$14B parameters) as an alternative. Our results demonstrate that open-source LLMs as small as 3B parameters can serve as effective Promptagator-style query generators. We hope our work will inform practitioners with reliable alternatives for synthetic data generation and give insights to maximize fine-tuning results for domain-specific applications."},{"descriptionType":"Other","description":"CIKM 2025 short research paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02241","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:12Z","registered":"2025-10-03T02:09:12Z","published":null,"updated":"2025-10-03T02:09:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02232","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02232","identifiers":[{"identifier":"2510.02232","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ebtesam Jaber","familyName":"Aljohani","name":"Aljohani, Ebtesam Jaber","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wael M. S.","familyName":"Yafoo","name":"Yafoo, Wael M. S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhanced Arabic-language cyberbullying detection: deep embedding and transformer (BERT) approaches"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:20:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.11591/ijai.v14.i3.pp2258-2269","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent technological advances in smartphones and communications, including the growth of such online platforms as massive social media networks such as X (formerly known as Twitter) endangers young people and their emotional well-being by exposing them to cyberbullying, taunting, and bullying content. Most proposed approaches for automatically detecting cyberbullying have been developed around the English language, and methods for detecting Arabic-language cyberbullying are scarce. Methods for detecting Arabic-language cyberbullying are especially scarce. This paper aims to enhance the effectiveness of methods for detecting cyberbullying in Arabic-language content. We assembled a dataset of 10,662 X posts, pre-processed the data, and used the kappa tool to verify and enhance the quality of our annotations. We conducted four experiments to test numerous deep learning models for automatically detecting Arabic-language cyberbullying. We first tested a long short-term memory (LSTM) model and a bidirectional long short-term memory (Bi-LSTM) model with several experimental word embeddings. We also tested the LSTM and Bi-LSTM models with a novel pre-trained bidirectional encoder from representations (BERT) and then tested them on a different experimental models BERT again. LSTM-BERT and Bi-LSTM-BERT demonstrated a 97% accuracy. Bi-LSTM with FastText embedding word performed even better, achieving 98% accuracy. As a result, the outcomes are generalize"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02232","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T02:08:58Z","registered":"2025-10-03T02:08:59Z","published":null,"updated":"2025-10-03T02:08:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02230","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02230","identifiers":[{"identifier":"2510.02230","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Phuc Minh","familyName":"Nguyen","name":"Nguyen, Phuc Minh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chinh D.","familyName":"La","name":"La, Chinh D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duy M. H.","familyName":"Nguyen","name":"Nguyen, Duy M. H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nitesh V.","familyName":"Chawla","name":"Chawla, Nitesh V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binh T.","familyName":"Nguyen","name":"Nguyen, Binh T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khoa D.","familyName":"Doan","name":"Doan, Khoa D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Reasoning Boundary Paradox: How Reinforcement Learning Constrains Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:17:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:00:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement Learning with Verifiable Rewards (RLVR) has emerged as a key method for improving Large Language Models' reasoning capabilities, yet recent evidence suggests it may paradoxically shrink the reasoning boundary rather than expand it. This paper investigates the shrinkage issue of RLVR by analyzing its learning dynamics and reveals two critical phenomena that explain this failure. First, we expose negative interference in RLVR, where learning to solve certain training problems actively reduces the likelihood of correct solutions for others, leading to the decline of Pass@$k$ performance, or the probability of generating a correct solution within $k$ attempts. Second, we uncover the winner-take-all phenomenon: RLVR disproportionately reinforces problems with high likelihood, correct solutions, under the base model, while suppressing other initially low-likelihood ones. Through extensive theoretical and empirical analysis on multiple mathematical reasoning benchmarks, we show that this effect arises from the inherent on-policy sampling in standard RL objectives, causing the model to converge toward narrow solution strategies. Based on these insights, we propose a simple yet effective data curation algorithm that focuses RLVR learning on low-likelihood problems, achieving notable improvement in Pass@$k$ performance. Our code is available at https://github.com/mail-research/SELF-llm-interference."},{"descriptionType":"Other","description":"23 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02230","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:55Z","registered":"2025-10-03T02:08:56Z","published":null,"updated":"2025-10-03T02:08:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02216","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02216","identifiers":[{"identifier":"2510.02216","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeqi","familyName":"Ye","name":"Ye, Zeqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minshuo","familyName":"Chen","name":"Chen, Minshuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diffusion Transformers for Imputation: Statistical Efficiency and Uncertainty Quantification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:00:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:59:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Imputation methods play a critical role in enhancing the quality of practical time-series data, which often suffer from pervasive missing values. Recently, diffusion-based generative imputation methods have demonstrated remarkable success compared to autoregressive and conventional statistical approaches. Despite their empirical success, the theoretical understanding of how well diffusion-based models capture complex spatial and temporal dependencies between the missing values and observed ones remains limited. Our work addresses this gap by investigating the statistical efficiency of conditional diffusion transformers for imputation and quantifying the uncertainty in missing values. Specifically, we derive statistical sample complexity bounds based on a novel approximation theory for conditional score functions using transformers, and, through this, construct tight confidence regions for missing values. Our findings also reveal that the efficiency and accuracy of imputation are significantly influenced by the missing patterns. Furthermore, we validate these theoretical insights through simulation and propose a mixed-masking training strategy to enhance the imputation performance."},{"descriptionType":"Other","description":"49 pages, 4 figures. Accepted as a poster at NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02216","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:34Z","registered":"2025-10-03T02:08:35Z","published":null,"updated":"2025-10-03T02:08:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02206","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02206","identifiers":[{"identifier":"2510.02206","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel Gallo","familyName":"Fernández","name":"Fernández, Daniel Gallo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Poolformer: Recurrent Networks with Pooling for Long-Sequence Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:52:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:59:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sequence-to-sequence models have become central in Artificial Intelligence, particularly following the introduction of the transformer architecture. While initially developed for Natural Language Processing, these models have demonstrated utility across domains, including Computer Vision. Such models require mechanisms to exchange information along the time dimension, typically using recurrent or self-attention layers. However, self-attention scales quadratically with sequence length, limiting its practicality for very long sequences.\n We introduce Poolformer, a sequence-to-sequence model that replaces self-attention with recurrent layers and incorporates pooling operations to reduce sequence length. Poolformer is defined recursively using SkipBlocks, which contain residual blocks, a down-pooling layer, a nested SkipBlock, an up-pooling layer, and additional residual blocks. We conduct extensive experiments to support our architectural choices.\n Our results show that pooling greatly accelerates training, improves perceptual metrics (FID and IS), and prevents overfitting. Our experiments also suggest that long-range dependencies are handled by deep layers, while shallow layers take care of short-term features.\n Evaluated on raw audio, which naturally features long sequence lengths, Poolformer outperforms state-of-the-art models such as SaShiMi and Mamba. Future directions include applications to text and vision, as well as multi-modal scenarios, where a Poolformer-based LLM could effectively process dense representations of images and videos."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02206","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:20Z","registered":"2025-10-03T02:08:20Z","published":null,"updated":"2025-10-03T02:08:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02204","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02204","identifiers":[{"identifier":"2510.02204","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lingzhong","familyName":"Dong","name":"Dong, Lingzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Zhou","name":"Zhou, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuaibo","familyName":"Yang","name":"Yang, Shuaibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyue","familyName":"Sheng","name":"Sheng, Haiyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengzhou","familyName":"Cheng","name":"Cheng, Pengzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongru","familyName":"Wu","name":"Wu, Zongru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Wu","name":"Wu, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongshen","familyName":"Liu","name":"Liu, Gongshen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuosheng","familyName":"Zhang","name":"Zhang, Zhuosheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Say One Thing, Do Another? Diagnosing Reasoning-Execution Gaps in VLM-Powered Mobile-Use Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:51:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:59:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mobile-use agents powered by vision-language models (VLMs) have shown great potential in interpreting natural language instructions and generating corresponding actions based on mobile graphical user interface. Recent studies suggest that incorporating chain-of-thought (CoT) reasoning tends to improve the execution accuracy. However, existing evaluations emphasize execution accuracy while neglecting whether CoT reasoning aligns with ground-truth actions. This oversight fails to assess potential reasoning-execution gaps, which in turn foster over-trust: users relying on seemingly plausible CoTs may unknowingly authorize harmful actions, potentially resulting in financial loss or trust crisis. In this work, we introduce a new evaluation framework to diagnose reasoning-execution gaps. At its core lies Ground-Truth Alignment (GTA), which measures whether the action implied by a CoT matches the ground-truth action. By combining GTA with the standard Exact Match (EM) metric, we jointly assess both the reasoning accuracy and execution accuracy. This joint perspective reveals two types of reasoning-execution gaps: (i) Execution Gap (EG), where the reasoning correctly identifies the correct action but execution fails, and (ii) Reasoning Gap (RG), where execution succeeds but reasoning process conflicts with the actual execution. Experimental results across a wide range of mobile interaction tasks reveal that reasoning-execution gaps are prevalent, with execution gaps occurring more frequently than reasoning gaps. Moreover, while scaling up model size reduces the overall gap, sizable execution gaps persist even in the largest models. Further analysis shows that our framework reliably reflects systematic EG/RG patterns in state-of-the-art models. These findings offer concrete diagnostics and support the development of more trustworthy mobile-use agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02204","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:17Z","registered":"2025-10-03T02:08:18Z","published":null,"updated":"2025-10-03T02:08:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02200","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02200","identifiers":[{"identifier":"2510.02200","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felix","familyName":"Brei","name":"Brei, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenz","familyName":"Bühmann","name":"Bühmann, Lorenz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Frey","name":"Frey, Johannes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Gerber","name":"Gerber, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lars-Peter","familyName":"Meyer","name":"Meyer, Lars-Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claus","familyName":"Stadler","name":"Stadler, Claus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kirill","familyName":"Bulert","name":"Bulert, Kirill","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ARUQULA -- An LLM based Text2SPARQL Approach using ReAct and Knowledge Graph Exploration Utilities"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:49:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:59:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Interacting with knowledge graphs can be a daunting task for people without a background in computer science since the query language that is used (SPARQL) has a high barrier of entry. Large language models (LLMs) can lower that barrier by providing support in the form of Text2SPARQL translation. In this paper we introduce a generalized method based on SPINACH, an LLM backed agent that translates natural language questions to SPARQL queries not in a single shot, but as an iterative process of exploration and execution. We describe the overall architecture and reasoning behind our design decisions, and also conduct a thorough analysis of the agent behavior to gain insights into future areas for targeted improvements. This work was motivated by the Text2SPARQL challenge, a challenge that was held to facilitate improvements in the Text2SPARQL domain."},{"descriptionType":"Other","description":"peer reviewed publication at Text2SPARQL Workshop @ ESWC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02200","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:11Z","registered":"2025-10-03T02:08:12Z","published":null,"updated":"2025-10-03T02:08:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02194","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02194","identifiers":[{"identifier":"2510.02194","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhao","familyName":"Sun","name":"Sun, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoer","familyName":"Xu","name":"Xu, Zhuoer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiwen","familyName":"Cui","name":"Cui, Shiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yang","name":"Yang, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingyun","familyName":"Yu","name":"Yu, Lingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongdong","familyName":"Zhang","name":"Zhang, Yongdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongtao","familyName":"Xie","name":"Xie, Hongtao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UpSafe$^\\circ$C: Upcycling for Controllable Safety in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:43:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:58:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have achieved remarkable progress across a wide range of tasks, but remain vulnerable to safety risks such as harmful content generation and jailbreak attacks. Existing safety techniques -- including external guardrails, inference-time guidance, and post-training alignment -- each face limitations in balancing safety, utility, and controllability. In this work, we propose UpSafe$^\\circ$C, a unified framework for enhancing LLM safety through safety-aware upcycling. Our approach first identifies safety-critical layers and upcycles them into a sparse Mixture-of-Experts (MoE) structure, where the router acts as a soft guardrail that selectively activates original MLPs and added safety experts. We further introduce a two-stage SFT strategy to strengthen safety discrimination while preserving general capabilities. To enable flexible control at inference time, we introduce a safety temperature mechanism, allowing dynamic adjustment of the trade-off between safety and utility. Experiments across multiple benchmarks, base model, and model scales demonstrate that UpSafe$^\\circ$C achieves robust safety improvements against harmful and jailbreak inputs, while maintaining competitive performance on general tasks. Moreover, analysis shows that safety temperature provides fine-grained inference-time control that achieves the Pareto-optimal frontier between utility and safety. Our results highlight a new direction for LLM safety: moving from static alignment toward dynamic, modular, and inference-aware control."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02194","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:08:02Z","registered":"2025-10-03T02:08:03Z","published":null,"updated":"2025-10-03T02:08:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02187","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02187","identifiers":[{"identifier":"2510.02187","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luca A.","familyName":"Lanzendörfer","name":"Lanzendörfer, Luca A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Frédéric","familyName":"Berdoz","name":"Berdoz, Frédéric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonis","familyName":"Asonitis","name":"Asonitis, Antonis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roger","familyName":"Wattenhofer","name":"Wattenhofer, Roger","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"High-Fidelity Speech Enhancement via Discrete Audio Tokens"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:38:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:58:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent autoregressive transformer-based speech enhancement (SE) methods have shown promising results by leveraging advanced semantic understanding and contextual modeling of speech. However, these approaches often rely on complex multi-stage pipelines and low sampling rate codecs, limiting them to narrow and task-specific speech enhancement. In this work, we introduce DAC-SE1, a simplified language model-based SE framework leveraging discrete high-resolution audio representations; DAC-SE1 preserves fine-grained acoustic details while maintaining semantic coherence. Our experiments show that DAC-SE1 surpasses state-of-the-art autoregressive SE methods on both objective perceptual metrics and in a MUSHRA human evaluation. We release our codebase and model checkpoints to support further research in scalable, unified, and high-quality speech enhancement."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02187","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:07:52Z","registered":"2025-10-03T02:07:52Z","published":null,"updated":"2025-10-03T02:07:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02172","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02172","identifiers":[{"identifier":"2510.02172","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoning","familyName":"Yu","name":"Yu, Zhaoning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Will","familyName":"Su","name":"Su, Will","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leitian","familyName":"Tao","name":"Tao, Leitian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haozhu","familyName":"Wang","name":"Wang, Haozhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aashu","familyName":"Singh","name":"Singh, Aashu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanchao","familyName":"Yu","name":"Yu, Hanchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianyu","familyName":"Wang","name":"Wang, Jianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyang","familyName":"Gao","name":"Gao, Hongyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhe","familyName":"Yuan","name":"Yuan, Weizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Weston","name":"Weston, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Yu","name":"Yu, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Xu","name":"Xu, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RESTRAIN: From Spurious Votes to Signals -- Self-Driven RL with Self-Penalization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T16:24:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:57:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning with human-annotated data has boosted chain-of-thought reasoning in large reasoning models, but these gains come at high costs in labeled data while faltering on harder tasks. A natural next step is experience-driven learning, where models improve without curated labels by adapting to unlabeled data. We introduce RESTRAIN (REinforcement learning with Self-restraint), a self-penalizing RL framework that converts the absence of gold labels into a useful learning signal. Instead of overcommitting to spurious majority votes, RESTRAIN exploits signals from the model's entire answer distribution: penalizing overconfident rollouts and low-consistency examples while preserving promising reasoning chains. The self-penalization mechanism integrates seamlessly into policy optimization methods such as GRPO, enabling continual self-improvement without supervision. On challenging reasoning benchmarks, RESTRAIN delivers large gains using only unlabeled data. With Qwen3-4B-Base and OctoThinker Hybrid-8B-Base, it improves Pass@1 by up to +140.7 percent on AIME25, +36.2 percent on MMLU_STEM, and +19.6 percent on GPQA-Diamond, nearly matching gold-label training while using no gold labels. These results demonstrate that RESTRAIN establishes a scalable path toward stronger reasoning without gold labels."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02172","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:07:29Z","registered":"2025-10-03T02:07:29Z","published":null,"updated":"2025-10-03T02:07:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02139","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02139","identifiers":[{"identifier":"2510.02139","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Florensia","familyName":"Widjaja","name":"Widjaja, Florensia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhangtianyi","familyName":"Chen","name":"Chen, Zhangtianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juexiao","familyName":"Zhou","name":"Zhou, Juexiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BioinfoMCP: A Unified Platform Enabling MCP Interfaces in Agentic Bioinformatics"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T15:47:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:55:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Bioinformatics tools are essential for complex computational biology tasks, yet their integration with emerging AI-agent frameworks is hindered by incompatible interfaces, heterogeneous input-output formats, and inconsistent parameter conventions. The Model Context Protocol (MCP) provides a standardized framework for tool-AI communication, but manually converting hundreds of existing and rapidly growing specialized bioinformatics tools into MCP-compliant servers is labor-intensive and unsustainable. Here, we present BioinfoMCP, a unified platform comprising two components: BioinfoMCP Converter, which automatically generates robust MCP servers from tool documentation using large language models, and BioinfoMCP Benchmark, which systematically validates the reliability and versatility of converted tools across diverse computational tasks. We present a platform of 38 MCP-converted bioinformatics tools, extensively validated to show that 94.7% successfully executed complex workflows across three widely used AI-agent platforms. By removing technical barriers to AI automation, BioinfoMCP enables natural-language interaction with sophisticated bioinformatics analyses without requiring extensive programming expertise, offering a scalable path to intelligent, interoperable computational biology."},{"descriptionType":"Other","description":"20 pages, 8 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02139","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:06:40Z","registered":"2025-10-03T02:06:41Z","published":null,"updated":"2025-10-03T02:06:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02128","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02128","identifiers":[{"identifier":"2510.02128","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jameson","familyName":"Sandler","name":"Sandler, Jameson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmet","familyName":"Üstün","name":"Üstün, Ahmet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Romanelli","name":"Romanelli, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Hooker","name":"Hooker, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ferdinando","familyName":"Fioretto","name":"Fioretto, Ferdinando","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Disparate Impacts of Speculative Decoding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T15:38:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:54:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The practice of speculative decoding, whereby inference is probabilistically supported by a smaller, cheaper, ``drafter'' model, has become a standard technique for systematically reducing the decoding time of large language models. This paper conducts an analysis of speculative decoding through the lens of its potential disparate speed-up rates across tasks. Crucially, the paper shows that speed-up gained from speculative decoding is not uniformly distributed across tasks, consistently diminishing for under-fit, and often underrepresented tasks. To better understand this phenomenon, we derive an analysis to quantify this observed ``unfairness'' and draw attention to the factors that motivate such disparate speed-ups to emerge. Further, guided by these insights, the paper proposes a mitigation strategy designed to reduce speed-up disparities and validates the approach across several model pairs, revealing on average a 12% improvement in our fairness metric."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02128","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:06:24Z","registered":"2025-10-03T02:06:25Z","published":null,"updated":"2025-10-03T02:06:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02110","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02110","identifiers":[{"identifier":"2510.02110","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Koichi","familyName":"Saito","name":"Saito, Koichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"Tanke","name":"Tanke, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Simon","name":"Simon, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Masato","familyName":"Ishii","name":"Ishii, Masato","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kazuki","familyName":"Shimada","name":"Shimada, Kazuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zachary","familyName":"Novack","name":"Novack, Zachary","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi","familyName":"Zhong","name":"Zhong, Zhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akio","familyName":"Hayakawa","name":"Hayakawa, Akio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takashi","familyName":"Shibuya","name":"Shibuya, Takashi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuki","familyName":"Mitsufuji","name":"Mitsufuji, Yuki","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SoundReactor: Frame-level Online Video-to-Audio Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T15:18:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:53:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Prevailing Video-to-Audio (V2A) generation models operate offline, assuming an entire video sequence or chunks of frames are available beforehand. This critically limits their use in interactive applications such as live content creation and emerging generative world models. To address this gap, we introduce the novel task of frame-level online V2A generation, where a model autoregressively generates audio from video without access to future video frames. Furthermore, we propose SoundReactor, which, to the best of our knowledge, is the first simple yet effective framework explicitly tailored for this task. Our design enforces end-to-end causality and targets low per-frame latency with audio-visual synchronization. Our model's backbone is a decoder-only causal transformer over continuous audio latents. For vision conditioning, it leverages grid (patch) features extracted from the smallest variant of the DINOv2 vision encoder, which are aggregated into a single token per frame to maintain end-to-end causality and efficiency. The model is trained through a diffusion pre-training followed by consistency fine-tuning to accelerate the diffusion head decoding. On a benchmark of diverse gameplay videos from AAA titles, our model successfully generates semantically and temporally aligned, high-quality full-band stereo audio, validated by both objective and human evaluations. Furthermore, our model achieves low per-frame waveform-level latency (26.3ms with the head NFE=1, 31.5ms with NFE=4) on 30FPS, 480p videos using a single H100. Demo samples are available at https://koichi-saito-sony.github.io/soundreactor/."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02110","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:05:58Z","registered":"2025-10-03T02:05:58Z","published":null,"updated":"2025-10-03T02:05:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.02044","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02044","identifiers":[{"identifier":"2510.02044","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siddhant","familyName":"Arora","name":"Arora, Siddhant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haidar","familyName":"Khan","name":"Khan, Haidar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Sun","name":"Sun, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin Luna","familyName":"Dong","name":"Dong, Xin Luna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sajal","familyName":"Choudhary","name":"Choudhary, Sajal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungwhan","familyName":"Moon","name":"Moon, Seungwhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Zhang","name":"Zhang, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adithya","familyName":"Sagar","name":"Sagar, Adithya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Surya Teja","familyName":"Appini","name":"Appini, Surya Teja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaushik","familyName":"Patnaik","name":"Patnaik, Kaushik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanat","familyName":"Sharma","name":"Sharma, Sanat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shinji","familyName":"Watanabe","name":"Watanabe, Shinji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anuj","familyName":"Kumar","name":"Kumar, Anuj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Aly","name":"Aly, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Liu","name":"Liu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"Metze","name":"Metze, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaojiang","familyName":"Lin","name":"Lin, Zhaojiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stream RAG: Instant and Accurate Spoken Dialogue Systems with Streaming Tool Usage"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T14:18:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:49:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"End-to-end speech-in speech-out dialogue systems are emerging as a powerful alternative to traditional ASR-LLM-TTS pipelines, generating more natural, expressive responses with significantly lower latency. However, these systems remain prone to hallucinations due to limited factual grounding. While text-based dialogue systems address this challenge by integrating tools such as web search and knowledge graph APIs, we introduce the first approach to extend tool use directly into speech-in speech-out systems. A key challenge is that tool integration substantially increases response latency, disrupting conversational flow. To mitigate this, we propose Streaming Retrieval-Augmented Generation (Streaming RAG), a novel framework that reduces user-perceived latency by predicting tool queries in parallel with user speech, even before the user finishes speaking. Specifically, we develop a post-training pipeline that teaches the model when to issue tool calls during ongoing speech and how to generate spoken summaries that fuse audio queries with retrieved text results, thereby improving both accuracy and responsiveness. To evaluate our approach, we construct AudioCRAG, a benchmark created by converting queries from the publicly available CRAG dataset into speech form. Experimental results demonstrate that our streaming RAG approach increases QA accuracy by up to 200% relative (from 11.1% to 34.2% absolute) and further enhances user experience by reducing tool use latency by 20%. Importantly, our streaming RAG approach is modality-agnostic and can be applied equally to typed input, paving the way for more agentic, real-time AI assistants."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.02044","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:04:19Z","registered":"2025-10-03T02:04:19Z","published":null,"updated":"2025-10-03T02:04:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01995","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01995","identifiers":[{"identifier":"2510.01995","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Arid","familyName":"Hasan","name":"Hasan, Md Arid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Firoj","familyName":"Alam","name":"Alam, Firoj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Fahad","familyName":"Hossain","name":"Hossain, Md Fahad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Usman","familyName":"Naseem","name":"Naseem, Usman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syed Ishtiaque","familyName":"Ahmed","name":"Ahmed, Syed Ishtiaque","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Based Multi-Task Bangla Hate Speech Detection: Type, Severity, and Target"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.2.2; I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-10-02T13:17:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:45:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Online social media platforms are central to everyday communication and information seeking. While these platforms serve positive purposes, they also provide fertile ground for the spread of hate speech, offensive language, and bullying content targeting individuals, organizations, and communities. Such content undermines safety, participation, and equity online. Reliable detection systems are therefore needed, especially for low-resource languages where moderation tools are limited. In Bangla, prior work has contributed resources and models, but most are single-task (e.g., binary hate/offense) with limited coverage of multi-facet signals (type, severity, target). We address these gaps by introducing the first multi-task Bangla hate-speech dataset, BanglaMultiHate, one of the largest manually annotated corpus to date. Building on this resource, we conduct a comprehensive, controlled comparison spanning classical baselines, monolingual pretrained models, and LLMs under zero-shot prompting and LoRA fine-tuning. Our experiments assess LLM adaptability in a low-resource setting and reveal a consistent trend: although LoRA-tuned LLMs are competitive with BanglaBERT, culturally and linguistically grounded pretraining remains critical for robust performance. Together, our dataset and findings establish a stronger benchmark for developing culturally aligned moderation tools in low-resource contexts. For reproducibility, we will release the dataset and all related scripts."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01995","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:03:05Z","registered":"2025-10-03T02:03:05Z","published":null,"updated":"2025-10-03T02:03:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01989","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01989","identifiers":[{"identifier":"2510.01989","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryosuke","familyName":"Kohita","name":"Kohita, Ryosuke","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Database Normalization Effects on SQL Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T13:11:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:45:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Schema design, particularly normalization, is a critical yet often overlooked factor in natural language to SQL (NL2SQL) systems. Most prior research evaluates models on fixed schemas, overlooking the influence of design on performance. We present the first systematic study of schema normalization's impact, evaluating eight leading large language models on synthetic and real-world datasets with varied normalization levels. We construct controlled synthetic datasets with formal normalization (1NF-3NF) and real academic paper datasets with practical schemes. Our results show that denormalized schemas offer high accuracy on simple retrieval queries, even with cost-effective models in zero-shot settings. In contrast, normalized schemas (2NF/3NF) introduce challenges such as errors in base table selection and join type prediction; however, these issues are substantially mitigated by providing few-shot examples. For aggregation queries, normalized schemas yielded better performance, mainly due to their robustness against the data duplication and NULL value issues that cause errors in denormalized schemas. These findings suggest that the optimal schema design for NL2SQL applications depends on the types of queries to be supported. Our study demonstrates the importance of considering schema design when developing NL2SQL interfaces and integrating adaptive schema selection for real-world scenarios."},{"descriptionType":"Other","description":"Accepted to CIKM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01989","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:02:56Z","registered":"2025-10-03T02:02:57Z","published":null,"updated":"2025-10-03T02:02:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01976","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01976","identifiers":[{"identifier":"2510.01976","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adina Nicola","familyName":"Dobrinoiu","name":"Dobrinoiu, Adina Nicola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana Cristiana","familyName":"Marcu","name":"Marcu, Ana Cristiana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Homayounirad","name":"Homayounirad, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luciano Cavalcante","familyName":"Siebert","name":"Siebert, Luciano Cavalcante","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enrico","familyName":"Liscio","name":"Liscio, Enrico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Taking a SEAT: Predicting Value Interpretations from Sentiment, Emotion, Argument, and Topic Annotations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T12:51:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:44:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Our interpretation of value concepts is shaped by our sociocultural background and lived experiences, and is thus subjective. Recognizing individual value interpretations is important for developing AI systems that can align with diverse human perspectives and avoid bias toward majority viewpoints. To this end, we investigate whether a language model can predict individual value interpretations by leveraging multi-dimensional subjective annotations as a proxy for their interpretive lens. That is, we evaluate whether providing examples of how an individual annotates Sentiment, Emotion, Argument, and Topics (SEAT dimensions) helps a language model in predicting their value interpretations. Our experiment across different zero- and few-shot settings demonstrates that providing all SEAT dimensions simultaneously yields superior performance compared to individual dimensions and a baseline where no information about the individual is provided. Furthermore, individual variations across annotators highlight the importance of accounting for the incorporation of individual subjective annotators. To the best of our knowledge, this controlled setting, although small in size, is the first attempt to go beyond demographics and investigate the impact of annotation behavior on value prediction, providing a solid foundation for future large-scale validation."},{"descriptionType":"Other","description":"Accepted at VALE workshop (ECAI 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01976","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:02:36Z","registered":"2025-10-03T02:02:37Z","published":null,"updated":"2025-10-03T02:02:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01929","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01929","identifiers":[{"identifier":"2510.01929","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Davide","familyName":"Gabrielli","name":"Gabrielli, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Sestito","name":"Sestito, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iacopo","familyName":"Masi","name":"Masi, Iacopo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Inverse Language Modeling towards Robust and Grounded LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T11:47:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:41:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The current landscape of defensive mechanisms for LLMs is fragmented and underdeveloped, unlike prior work on classifiers. To further promote adversarial robustness in LLMs, we propose Inverse Language Modeling (ILM), a unified framework that simultaneously 1) improves the robustness of LLMs to input perturbations, and, at the same time, 2) enables native grounding by inverting model outputs to identify potentially toxic or unsafe input triggers. ILM transforms LLMs from static generators into analyzable and robust systems, potentially helping RED teaming. ILM can lay the foundation for next-generation LLMs that are not only robust and grounded but also fundamentally more controllable and trustworthy. The code is publicly available at github.com/davegabe/pag-llm."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01929","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:01:28Z","registered":"2025-10-03T02:01:29Z","published":null,"updated":"2025-10-03T02:01:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01910","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01910","identifiers":[{"identifier":"2510.01910","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoyan","familyName":"Wang","name":"Wang, Zhaoyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Gao","name":"Gao, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arogya","familyName":"Kharel","name":"Kharel, Arogya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"In-Young","familyName":"Ko","name":"Ko, In-Young","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Are LLMs Better GNN Helpers? Rethinking Robust Graph Learning under Deficiencies with Iterative Refinement"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T11:30:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:40:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graph Neural Networks (GNNs) are widely adopted in Web-related applications, serving as a core technique for learning from graph-structured data, such as text-attributed graphs. Yet in real-world scenarios, such graphs exhibit deficiencies that substantially undermine GNN performance. While prior GNN-based augmentation studies have explored robustness against individual imperfections, a systematic understanding of how graph-native and Large Language Models (LLMs) enhanced methods behave under compound deficiencies is still missing. Specifically, there has been no comprehensive investigation comparing conventional approaches and recent LLM-on-graph frameworks, leaving their merits unclear. To fill this gap, we conduct the first empirical study that benchmarks these two lines of methods across diverse graph deficiencies, revealing overlooked vulnerabilities and challenging the assumption that LLM augmentation is consistently superior. Building on empirical findings, we propose Robust Graph Learning via Retrieval-Augmented Contrastive Refinement (RoGRAD) framework. Unlike prior one-shot LLM-as-Enhancer designs, RoGRAD is the first iterative paradigm that leverages Retrieval-Augmented Generation (RAG) to inject retrieval-grounded augmentations by supplying class-consistent, diverse augmentations and enforcing discriminative representations through iterative graph contrastive learning. It transforms LLM augmentation for graphs from static signal injection into dynamic refinement. Extensive experiments demonstrate RoGRAD's superiority over both conventional GNN- and LLM-enhanced baselines, achieving up to 82.43% average improvement."},{"descriptionType":"Other","description":"14 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01910","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:00:59Z","registered":"2025-10-03T02:01:00Z","published":null,"updated":"2025-10-03T02:01:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01863","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01863","identifiers":[{"identifier":"2510.01863","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marco","familyName":"Cococcioni","name":"Cococcioni, Marco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dario","familyName":"Pagani","name":"Pagani, Dario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Rossi","name":"Rossi, Federico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microscaling Floating Point Formats for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T10:08:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:37:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing computational and memory demands of large language models (LLMs) necessitate innovative approaches to optimize resource usage without compromising performance. This paper leverages microscaling floating-point formats, a novel technique designed to address these challenges by reducing the storage and computational overhead associated with numerical representations in LLMs. Unlike traditional floating-point representations that allocate a dedicated scale for each value, microscaling employs a shared scale across a block of values, enabling compact one-byte floating-point representations while maintaining an extended dynamic range. We explore the application of microscaling in the context of 8-bit floating-point formats to significantly reduce memory footprint and computational costs. We tested several configurations of microscaling floats within the GPT-2 LLM architecture, demonstrating that microscaling data formats can achieve competitive accuracy during training and inference, proving its efficacy as a resource-efficient alternative for deploying LLMs at scale. The source code is publicly available at: https://github.com/unipi-dii-compressedarith/llm.c-sve"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01863","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:47Z","registered":"2025-10-03T01:59:48Z","published":null,"updated":"2025-10-03T01:59:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01845","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01845","identifiers":[{"identifier":"2510.01845","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ece","familyName":"Takmaz","name":"Takmaz, Ece","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lisa","familyName":"Bylinina","name":"Bylinina, Lisa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakub","familyName":"Dotlacil","name":"Dotlacil, Jakub","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Model Merging to Maintain Language-Only Performance in Developmentally Plausible Multimodal Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:38:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:36:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"State-of-the-art vision-and-language models consist of many parameters and learn from enormous datasets, surpassing the amounts of linguistic data that children are exposed to as they acquire a language. This paper presents our approach to the multimodal track of the BabyLM challenge addressing this discrepancy. We develop language-only and multimodal models in low-resource settings using developmentally plausible datasets, with our multimodal models outperforming previous BabyLM baselines. One finding in the multimodal language model literature is that these models tend to underperform in \\textit{language-only} tasks. Therefore, we focus on maintaining language-only abilities in multimodal models. To this end, we experiment with \\textit{model merging}, where we fuse the parameters of multimodal models with those of language-only models using weighted linear interpolation. Our results corroborate the findings that multimodal models underperform in language-only benchmarks that focus on grammar, and model merging with text-only models can help alleviate this problem to some extent, while maintaining multimodal performance."},{"descriptionType":"Other","description":"Accepted to the EMNLP 2025 workshop BabyLM: Accelerating language modeling research with cognitively plausible datasets"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01845","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:21Z","registered":"2025-10-03T01:59:21Z","published":null,"updated":"2025-10-03T01:59:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01842","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01842","identifiers":[{"identifier":"2510.01842","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yannis","familyName":"Belkhiter","name":"Belkhiter, Yannis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seshu","familyName":"Tirupathi","name":"Tirupathi, Seshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulio","familyName":"Zizzo","name":"Zizzo, Giulio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sachin","familyName":"Sharma","name":"Sharma, Sachin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John D.","familyName":"Kelleher","name":"Kelleher, John D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pre-Hoc Predictions in AutoML: Leveraging LLMs to Enhance Model Selection and Benchmarking for Tabular datasets"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:37:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:36:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The field of AutoML has made remarkable progress in post-hoc model selection, with libraries capable of automatically identifying the most performing models for a given dataset. Nevertheless, these methods often rely on exhaustive hyperparameter searches, where methods automatically train and test different types of models on the target dataset. Contrastingly, pre-hoc prediction emerges as a promising alternative, capable of bypassing exhaustive search through intelligent pre-selection of models. Despite its potential, pre-hoc prediction remains under-explored in the literature. This paper explores the intersection of AutoML and pre-hoc model selection by leveraging traditional models and Large Language Model (LLM) agents to reduce the search space of AutoML libraries. By relying on dataset descriptions and statistical information, we reduce the AutoML search space. Our methodology is applied to the AWS AutoGluon portfolio dataset, a state-of-the-art AutoML benchmark containing 175 tabular classification datasets available on OpenML. The proposed approach offers a shift in AutoML workflows, significantly reducing computational overhead, while still selecting the best model for the given dataset."},{"descriptionType":"Other","description":"Oral Presentations ADAPT Annual Scientific Conference 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01842","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:17Z","registered":"2025-10-03T01:59:17Z","published":null,"updated":"2025-10-03T01:59:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01831","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01831","identifiers":[{"identifier":"2510.01831","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dane","familyName":"Williamson","name":"Williamson, Dane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangfeng","familyName":"Ji","name":"Ji, Yangfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Dwyer","name":"Dwyer, Matthew","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Syntactic Blind Spots: How Misalignment Leads to LLMs Mathematical Errors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; I.2.0","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-02T09:26:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:35:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) demonstrate strong mathematical problem-solving abilities but frequently fail on problems that deviate syntactically from their training distribution. We identify a systematic failure mode, syntactic blind spots, in which models misapply familiar reasoning strategies to problems that are semantically straightforward but phrased in unfamiliar ways. These errors are not due to gaps in mathematical competence, but rather reflect a brittle coupling between surface form and internal representation. To test this, we rephrase incorrectly answered questions using syntactic templates drawn from correct examples. These rephrasings, which preserve semantics while reducing structural complexity, often lead to correct answers. We quantify syntactic complexity using a metric based on Dependency Locality Theory (DLT), and show that higher DLT scores are associated with increased failure rates across multiple datasets. Our findings suggest that many reasoning errors stem from structural misalignment rather than conceptual difficulty, and that syntax-aware interventions can reveal and mitigate these inductive failures."},{"descriptionType":"Other","description":"14 pages, 5 Tables, 9 Figures; Accepted to MathNLP 2025: The 3rd Workshop on Mathematical Natural Language Processing (co-located with EMNLP 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01831","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:59:00Z","registered":"2025-10-03T01:59:00Z","published":null,"updated":"2025-10-03T01:59:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01817","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01817","identifiers":[{"identifier":"2510.01817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adam","familyName":"Filipek","name":"Filipek, Adam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sparse Query Attention (SQA): A Computationally Efficient Attention Mechanism with Query Heads Reduction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T09:01:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:34:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Transformer architecture, underpinned by the Multi-Head Attention (MHA) mechanism, has become the de facto standard for state-of-the-art models in artificial intelligence. However, the quadratic computational complexity of MHA with respect to sequence length presents a significant barrier to scaling, particularly for applications involving long contexts. Prevailing solutions, such as Multi-Query Attention (MQA) and Grouped-Query Attention (GQA), have effectively addressed the memory bandwidth bottleneck that dominates autoregressive inference latency by sharing Key and Value projections. While highly successful, these methods do not reduce the fundamental number of floating-point operations (FLOPs) required for the attention score computation, which remains a critical bottleneck for training and full-sequence processing. This paper introduces Sparse Query Attention (SQA), a novel attention architecture that pursues an alternative and complementary optimization path. Instead of reducing Key/Value heads, SQA reduces the number of Query heads. This architectural modification directly decreases the computational complexity of the attention mechanism by a factor proportional to the reduction in query heads, thereby lowering the overall FLOPs. This work presents the theoretical foundation of SQA, its mathematical formulation, and a family of architectural variants. Empirical benchmarks on long sequences (32k-200k tokens) demonstrate that SQA can achieve significant throughput improvements of up to 3x in computation-bound scenarios such as model pre-training, fine-tuning, and encoder-based tasks, with only a minimal impact on model quality in preliminary smallscale experiments. SQA was discovered serendipitously during the development of the upcoming Reactive Transformer architecture, suggesting its potential as a powerful tool for building more efficient and scalable models"},{"descriptionType":"Other","description":"18 pages, 6 figures, small-scale experiments"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:58:39Z","registered":"2025-10-03T01:58:40Z","published":null,"updated":"2025-10-03T01:58:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01796","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01796","identifiers":[{"identifier":"2510.01796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Meng-Hsi","familyName":"Chen","name":"Chen, Meng-Hsi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Ang","familyName":"Lee","name":"Lee, Yu-Ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng-Ting","familyName":"Liao","name":"Liao, Feng-Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Da-shan","familyName":"Shiu","name":"Shiu, Da-shan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking the shape convention of an MLP"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T08:38:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:33:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-layer perceptrons (MLPs) conventionally follow a narrow-wide-narrow design where skip connections operate at the input/output dimensions while processing occurs in expanded hidden spaces. We challenge this convention by proposing wide-narrow-wide (Hourglass) MLP blocks where skip connections operate at expanded dimensions while residual computation flows through narrow bottlenecks. This inversion leverages higher-dimensional spaces for incremental refinement while maintaining computational efficiency through parameter-matched designs. Implementing Hourglass MLPs requires an initial projection to lift input signals to expanded dimensions. We propose that this projection can remain fixed at random initialization throughout training, enabling efficient training and inference implementations. We evaluate both architectures on generative tasks over popular image datasets, characterizing performance-parameter Pareto frontiers through systematic architectural search. Results show that Hourglass architectures consistently achieve superior Pareto frontiers compared to conventional designs. As parameter budgets increase, optimal Hourglass configurations favor deeper networks with wider skip connections and narrower bottlenecks-a scaling pattern distinct from conventional MLPs. Our findings suggest reconsidering skip connection placement in modern architectures, with potential applications extending to Transformers and other residual networks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:58:08Z","registered":"2025-10-03T01:58:09Z","published":null,"updated":"2025-10-03T01:58:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01792","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01792","identifiers":[{"identifier":"2510.01792","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ivan Leonidovich","familyName":"Litvak","name":"Litvak, Ivan Leonidovich","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anton","familyName":"Kostin","name":"Kostin, Anton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fedor","familyName":"Lashkin","name":"Lashkin, Fedor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tatiana","familyName":"Maksiyan","name":"Maksiyan, Tatiana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Lagutin","name":"Lagutin, Sergey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Comparison of Unsupervised Metrics for Evaluating Judicial Decision Extraction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.3.3; I.2.8; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-10-02T08:32:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:33:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of artificial intelligence in legal natural language processing demands scalable methods for evaluating text extraction from judicial decisions. This study evaluates 16 unsupervised metrics, including novel formulations, to assess the quality of extracting seven semantic blocks from 1,000 anonymized Russian judicial decisions, validated against 7,168 expert reviews on a 1--5 Likert scale. These metrics, spanning document-based, semantic, structural, pseudo-ground truth, and legal-specific categories, operate without pre-annotated ground truth. Bootstrapped correlations, Lin's concordance correlation coefficient (CCC), and mean absolute error (MAE) reveal that Term Frequency Coherence (Pearson $r = 0.540$, Lin CCC = 0.512, MAE = 0.127) and Coverage Ratio/Block Completeness (Pearson $r = 0.513$, Lin CCC = 0.443, MAE = 0.139) best align with expert ratings, while Legal Term Density (Pearson $r = -0.479$, Lin CCC = -0.079, MAE = 0.394) show strong negative correlations. The LLM Evaluation Score (mean = 0.849, Pearson $r = 0.382$, Lin CCC = 0.325, MAE = 0.197) showed moderate alignment, but its performance, using gpt-4.1-mini via g4f, suggests limited specialization for legal textse. These findings highlight that unsupervised metrics, including LLM-based approaches, enable scalable screening but, with moderate correlations and low CCC values, cannot fully replace human judgment in high-stakes legal contexts. This work advances legal NLP by providing annotation-free evaluation tools, with implications for judicial analytics and ethical AI deployment."},{"descriptionType":"Other","description":"28 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01792","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:58:02Z","registered":"2025-10-03T01:58:03Z","published":null,"updated":"2025-10-03T01:58:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01700","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01700","identifiers":[{"identifier":"2510.01700","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rohan","familyName":"Wadhawan","name":"Wadhawan, Rohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrice Y","familyName":"Harel-Canada","name":"Harel-Canada, Fabrice Y","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zi-Yi","familyName":"Dou","name":"Dou, Zi-Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suhaila","familyName":"Shakiah","name":"Shakiah, Suhaila","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robinson","familyName":"Piramuthu","name":"Piramuthu, Robinson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nanyun","familyName":"Peng","name":"Peng, Nanyun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VaPR -- Vision-language Preference alignment for Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T06:10:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:27:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Preference finetuning methods like Direct Preference Optimization (DPO) with AI-generated feedback have shown promise in aligning Large Vision-Language Models (LVLMs) with human preferences. However, existing techniques overlook the prevalence of noise in synthetic preference annotations in the form of stylistic and length biases. To this end, we introduce a hard-negative response generation framework based on LLM-guided response editing, that produces rejected responses with targeted errors, maintaining stylistic and length similarity to the accepted ones. Using this framework, we develop the VaPR dataset, comprising 30K high-quality samples, to finetune three LVLM families: LLaVA-V1.5, Qwen2VL \u0026amp; Qwen2.5VL (2B-13B sizes). Our VaPR models deliver significant performance improvements across ten benchmarks, achieving average gains of 6.5% (LLaVA), 4.0% (Qwen2VL), and 1.5% (Qwen2.5VL), with notable improvements on reasoning tasks. A scaling analysis shows that performance consistently improves with data size, with LLaVA models benefiting even at smaller scales. Moreover, VaPR reduces the tendency to answer \"Yes\" in binary questions - addressing a common failure mode in LVLMs like LLaVA. Lastly, we show that the framework generalizes to open-source LLMs as editors, with models trained on VaPR-OS achieving ~99% of the performance of models trained on \\name, which is synthesized using GPT-4o. Our data, models, and code can be found on the project page https://vap-r.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01700","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:55:42Z","registered":"2025-10-03T01:55:46Z","published":null,"updated":"2025-10-03T01:55:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01670","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01670","identifiers":[{"identifier":"2510.01670","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erfan","familyName":"Shayegani","name":"Shayegani, Erfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keegan","familyName":"Hines","name":"Hines, Keegan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Dong","name":"Dong, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nael","familyName":"Abu-Ghazaleh","name":"Abu-Ghazaleh, Nael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roman","familyName":"Lutz","name":"Lutz, Roman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Spencer","familyName":"Whitehead","name":"Whitehead, Spencer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vidhisha","familyName":"Balachandran","name":"Balachandran, Vidhisha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Besmira","familyName":"Nushi","name":"Nushi, Besmira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vibhav","familyName":"Vineet","name":"Vineet, Vibhav","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Just Do It!? Computer-Use Agents Exhibit Blind Goal-Directedness"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:52:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:25:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Computer-Use Agents (CUAs) are an increasingly deployed class of agents that take actions on GUIs to accomplish user goals. In this paper, we show that CUAs consistently exhibit Blind Goal-Directedness (BGD): a bias to pursue goals regardless of feasibility, safety, reliability, or context. We characterize three prevalent patterns of BGD: (i) lack of contextual reasoning, (ii) assumptions and decisions under ambiguity, and (iii) contradictory or infeasible goals. We develop BLIND-ACT, a benchmark of 90 tasks capturing these three patterns. Built on OSWorld, BLIND-ACT provides realistic environments and employs LLM-based judges to evaluate agent behavior, achieving 93.75% agreement with human annotations. We use BLIND-ACT to evaluate nine frontier models, including Claude Sonnet and Opus 4, Computer-Use-Preview, and GPT-5, observing high average BGD rates (80.8%) across them. We show that BGD exposes subtle risks that arise even when inputs are not directly harmful. While prompting-based interventions lower BGD levels, substantial risk persists, highlighting the need for stronger training- or inference-time interventions. Qualitative analysis reveals observed failure modes: execution-first bias (focusing on how to act over whether to act), thought-action disconnect (execution diverging from reasoning), and request-primacy (justifying actions due to user request). Identifying BGD and introducing BLIND-ACT establishes a foundation for future research on studying and mitigating this fundamental risk and ensuring safe CUA deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01670","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:58Z","registered":"2025-10-03T01:54:58Z","published":null,"updated":"2025-10-03T01:54:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01652","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01652","identifiers":[{"identifier":"2510.01652","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoxin","familyName":"Feng","name":"Feng, Zhaoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianfei","familyName":"Ma","name":"Ma, Jianfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emmanuele","familyName":"Chersoni","name":"Chersoni, Emmanuele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojing","familyName":"Zhao","name":"Zhao, Xiaojing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyi","familyName":"Bao","name":"Bao, Xiaoyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning to Look at the Other Side: A Semantic Probing Study of Word Embeddings in LLMs with Enabled Bidirectional Attention"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:18:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:24:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Autoregressive Large Language Models (LLMs) demonstrate exceptional performance in language understanding and generation. However, their application in text embedding tasks has been relatively slow, along with the analysis of their semantic representation in probing tasks, due to the constraints of the unidirectional attention mechanism.\n This paper aims to explore whether such constraints can be overcome by enabling bidirectional attention in LLMs. We tested different variants of the Llama architecture through additional training steps, progressively enabling bidirectional attention and unsupervised/supervised contrastive learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01652","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:26Z","registered":"2025-10-03T01:54:27Z","published":null,"updated":"2025-10-03T01:54:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01649","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01649","identifiers":[{"identifier":"2510.01649","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Muhammad Tanzil","familyName":"Furqon","name":"Furqon, Muhammad Tanzil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahardhika","familyName":"Pratama","name":"Pratama, Mahardhika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor","familyName":"Škrjanc","name":"Škrjanc, Igor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Liu","name":"Liu, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Habibullah","familyName":"Habibullah","name":"Habibullah, Habibullah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kutluyil","familyName":"Dogancay","name":"Dogancay, Kutluyil","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Source-Free Cross-Domain Continual Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:09:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:24:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Although existing cross-domain continual learning approaches successfully address many streaming tasks having domain shifts, they call for a fully labeled source domain hindering their feasibility in the privacy constrained environments. This paper goes one step ahead with the problem of source-free cross-domain continual learning where the use of source-domain samples are completely prohibited. We propose the idea of rehearsal-free frequency-aware dynamic prompt collaborations (REFEREE) to cope with the absence of labeled source-domain samples in realm of cross-domain continual learning. REFEREE is built upon a synergy between a source-pre-trained model and a large-scale vision-language model, thus overcoming the problem of sub-optimal generalizations when relying only on a source pre-trained model. The domain shift problem between the source domain and the target domain is handled by a frequency-aware prompting technique encouraging low-frequency components while suppressing high-frequency components. This strategy generates frequency-aware augmented samples, robust against noisy pseudo labels. The noisy pseudo-label problem is further addressed with the uncertainty-aware weighting strategy where the mean and covariance matrix are weighted by prediction uncertainties, thus mitigating the adverse effects of the noisy pseudo label. Besides, the issue of catastrophic forgetting (CF) is overcome by kernel linear discriminant analysis (KLDA) where the backbone network is frozen while the classification is performed using the linear discriminant analysis approach guided by the random kernel method. Our rigorous numerical studies confirm the advantage of our approach where it beats prior arts having access to source domain samples with significant margins."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01649","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:22Z","registered":"2025-10-03T01:54:22Z","published":null,"updated":"2025-10-03T01:54:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01645","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01645","identifiers":[{"identifier":"2510.01645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Niloofar","familyName":"Mireshghallah","name":"Mireshghallah, Niloofar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianshi","familyName":"Li","name":"Li, Tianshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Position: Privacy Is Not Just Memorization!"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T04:02:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:23:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The discourse on privacy risks in Large Language Models (LLMs) has disproportionately focused on verbatim memorization of training data, while a constellation of more immediate and scalable privacy threats remain underexplored. This position paper argues that the privacy landscape of LLM systems extends far beyond training data extraction, encompassing risks from data collection practices, inference-time context leakage, autonomous agent capabilities, and the democratization of surveillance through deep inference attacks. We present a comprehensive taxonomy of privacy risks across the LLM lifecycle -- from data collection through deployment -- and demonstrate through case studies how current privacy frameworks fail to address these multifaceted threats. Through a longitudinal analysis of 1,322 AI/ML privacy papers published at leading conferences over the past decade (2016--2025), we reveal that while memorization receives outsized attention in technical research, the most pressing privacy harms lie elsewhere, where current technical approaches offer little traction and viable paths forward remain unclear. We call for a fundamental shift in how the research community approaches LLM privacy, moving beyond the narrow focus of current technical solutions and embracing interdisciplinary approaches that address the sociotechnical nature of these emerging threats."},{"descriptionType":"Other","description":"27 pages, 6 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01645","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:16Z","registered":"2025-10-03T01:54:17Z","published":null,"updated":"2025-10-03T01:54:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01637","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01637","identifiers":[{"identifier":"2510.01637","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liyan","familyName":"Xie","name":"Xie, Liyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad","familyName":"Siddeek","name":"Siddeek, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamed","familyName":"Seif","name":"Seif, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea J.","familyName":"Goldsmith","name":"Goldsmith, Andrea J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengdi","familyName":"Wang","name":"Wang, Mengdi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting Post-generation Edits to Watermarked LLM Outputs via Combinatorial Watermarking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T03:33:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:23:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Watermarking has become a key technique for proprietary language models, enabling the distinction between AI-generated and human-written text. However, in many real-world scenarios, LLM-generated content may undergo post-generation edits, such as human revisions or even spoofing attacks, making it critical to detect and localize such modifications. In this work, we introduce a new task: detecting post-generation edits locally made to watermarked LLM outputs. To this end, we propose a combinatorial pattern-based watermarking framework, which partitions the vocabulary into disjoint subsets and embeds the watermark by enforcing a deterministic combinatorial pattern over these subsets during generation. We accompany the combinatorial watermark with a global statistic that can be used to detect the watermark. Furthermore, we design lightweight local statistics to flag and localize potential edits. We introduce two task-specific evaluation metrics, Type-I error rate and detection accuracy, and evaluate our method on open-source LLMs across a variety of editing scenarios, demonstrating strong empirical performance in edit localization."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01637","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:04Z","registered":"2025-10-03T01:54:05Z","published":null,"updated":"2025-10-03T01:54:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01634","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01634","identifiers":[{"identifier":"2510.01634","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan Y.","familyName":"Lin","name":"Lin, Ryan Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddhartha","familyName":"Ojha","name":"Ojha, Siddhartha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Bai","name":"Bai, Nicholas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CAT: Curvature-Adaptive Transformers for Geometry-Aware Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T03:26:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:22:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformers achieve strong performance across diverse domains but implicitly assume Euclidean geometry in their attention mechanisms, limiting their effectiveness on data with non-Euclidean structure. While recent extensions to hyperbolic and spherical spaces show promise for hierarchical and cyclical patterns, respectively, they require committing to a single geometry a priori, reducing flexibility when data exhibits mixed geometric properties. We introduce the Curvature-Adaptive Transformer (CAT), a novel architecture that dynamically learns per-token routing across three geometric attention branches through a lightweight, differentiable gating mechanism. Unlike fixed-geometry approaches, CAT enables adaptive geometric specialization, routing tokens to the appropriate curvature based on their local relational structure. The routing network provides interpretable curvature preferences while each branch employs geometry-specific operations optimized for its respective manifold. On knowledge graph completion benchmarks (FB15k-237, WN18RR), CAT achieves approximately 10% improvements in MRR and Hits@10 over fixed-geometry baselines with minimal overhead (5% parameter increase, comparable inference time). These results demonstrate that learned geometric adaptation outperforms any single fixed geometry for complex relational reasoning, establishing CAT as a scalable and interpretable foundation for mixture-of-geometry architectures across language, vision, and multimodal domains."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01634","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:54:00Z","registered":"2025-10-03T01:54:01Z","published":null,"updated":"2025-10-03T01:54:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01631","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01631","identifiers":[{"identifier":"2510.01631","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Feiyang","familyName":"Kang","name":"Kang, Feiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Newsha","familyName":"Ardalani","name":"Ardalani, Newsha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Kuchnik","name":"Kuchnik, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youssef","familyName":"Emad","name":"Emad, Youssef","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mostafa","familyName":"Elhoushi","name":"Elhoushi, Mostafa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubhabrata","familyName":"Sengupta","name":"Sengupta, Shubhabrata","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shang-Wen","familyName":"Li","name":"Li, Shang-Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramya","familyName":"Raghavendra","name":"Raghavendra, Ramya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoxi","familyName":"Jia","name":"Jia, Ruoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carole-Jean","familyName":"Wu","name":"Wu, Carole-Jean","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Demystifying Synthetic Data in LLM Pre-training: A Systematic Study of Scaling Laws, Benefits, and Pitfalls"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T03:24:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:22:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training data plays a crucial role in Large Language Models (LLM) scaling, yet high quality data is of limited supply. Synthetic data techniques offer a potential path toward sidestepping these limitations. We conduct a large-scale empirical investigation (\u0026gt;1000 LLMs with \u0026gt;100k GPU hours) using a unified protocol and scaling laws, comparing natural web data, diverse synthetic types (rephrased text, generated textbooks), and mixtures of natural and synthetic data. Specifically, we found pre-training on rephrased synthetic data \\textit{alone} is not faster than pre-training on natural web texts; while pre-training on 1/3 rephrased synthetic data mixed with 2/3 natural web texts can speed up 5-10x (to reach the same validation loss) at larger data budgets. Pre-training on textbook-style synthetic data \\textit{alone} results in notably higher loss on many downstream domains especially at small data budgets. \"Good\" ratios of synthetic data in training data mixtures depend on the model size and data budget, empirically converging to ~30% for rephrased synthetic data. Larger generator models do not necessarily yield better pre-training data than ~8B-param models. These results contribute mixed evidence on \"model collapse\" during large-scale single-round (n=1) model training on synthetic data--training on rephrased synthetic data shows no degradation in performance in foreseeable scales whereas training on mixtures of textbook-style pure-generated synthetic data shows patterns predicted by \"model collapse\". Our work demystifies synthetic data in pre-training, validates its conditional benefits, and offers practical guidance."},{"descriptionType":"Other","description":"Published as a Main Conference paper at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01631","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:56Z","registered":"2025-10-03T01:53:56Z","published":null,"updated":"2025-10-03T01:53:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01624","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01624","identifiers":[{"identifier":"2510.01624","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Feiyang","familyName":"Kang","name":"Kang, Feiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Kuchnik","name":"Kuchnik, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karthik","familyName":"Padthe","name":"Padthe, Karthik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marin","familyName":"Vlastelica","name":"Vlastelica, Marin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoxi","familyName":"Jia","name":"Jia, Ruoxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carole-Jean","familyName":"Wu","name":"Wu, Carole-Jean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Newsha","familyName":"Ardalani","name":"Ardalani, Newsha","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quagmires in SFT-RL Post-Training: When High SFT Scores Mislead and What to Use Instead"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:57:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In post-training for reasoning Large Language Models (LLMs), the current state of practice trains LLMs in two independent stages: Supervised Fine-Tuning (SFT) and Reinforcement Learning with Verifiable Rewards (RLVR, shortened as ``RL'' below). In this work, we challenge whether high SFT scores translate to improved performance after RL. We provide extensive counter-examples where this is not true. We find high SFT scores can be biased toward simpler or more homogeneous data and are not reliably predictive of subsequent RL gains or scaled-up post-training effectiveness. In some cases, RL training on models with improved SFT performance could lead to substantially worse outcome compared to RL on the base model without SFT. We study alternative metrics and identify generalization loss on held-out reasoning examples and Pass@large k performance to provide strong proxies for the RL outcome. We trained hundreds of models up to 12B-parameter with SFT and RLVR via GRPO and ran extensive evaluations on 7 math benchmarks with up to 256 repetitions, spending $\u0026gt;$1M GPU hours. Experiments include models from Llama3, Mistral-Nemo, Qwen3 and multiple state-of-the-art SFT/RL datasets. Compared to directly predicting from pre-RL performance, prediction based on generalization loss and Pass@large k achieves substantial higher precision, improving $R^2$ coefficient and Spearman's rank correlation coefficient by up to 0.5 (2x). This provides strong utility for broad use cases. For example, in most experiments, we find SFT training on unique examples for a one epoch underperforms training on half examples for two epochs, either after SFT or SFT-then-RL; With the same SFT budget, training only on short examples may lead to better SFT performance, though, it often leads to worse outcome after RL compared to training on examples with varying lengths. Evaluation tool will be open-sourced."},{"descriptionType":"Other","description":"Preprint. Under Review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01624","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:46Z","registered":"2025-10-03T01:53:46Z","published":null,"updated":"2025-10-03T01:53:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01622","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01622","identifiers":[{"identifier":"2510.01622","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Ma","name":"Ma, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Li","name":"Li, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"ZeHua","familyName":"Hu","name":"Hu, ZeHua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"XiaoFan","familyName":"Gui","name":"Gui, XiaoFan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"LuYao","familyName":"Liu","name":"Liu, LuYao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Lau","name":"Lau, Simon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM4Rec: Large Language Models for Multimodal Generative Recommendation with Causal Debiasing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:53:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Contemporary generative recommendation systems face significant challenges in handling multimodal data, eliminating algorithmic biases, and providing transparent decision-making processes. This paper introduces an enhanced generative recommendation framework that addresses these limitations through five key innovations: multimodal fusion architecture, retrieval-augmented generation mechanisms, causal inference-based debiasing, explainable recommendation generation, and real-time adaptive learning capabilities. Our framework leverages advanced large language models as the backbone while incorporating specialized modules for cross-modal understanding, contextual knowledge integration, bias mitigation, explanation synthesis, and continuous model adaptation. Extensive experiments on three benchmark datasets (MovieLens-25M, Amazon-Electronics, Yelp-2023) demonstrate consistent improvements in recommendation accuracy, fairness, and diversity compared to existing approaches. The proposed framework achieves up to 2.3% improvement in NDCG@10 and 1.4% enhancement in diversity metrics while maintaining computational efficiency through optimized inference strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01622","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:43Z","registered":"2025-10-03T01:53:43Z","published":null,"updated":"2025-10-03T01:53:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01616","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01616","identifiers":[{"identifier":"2510.01616","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu-Cheng","familyName":"Chih","name":"Chih, Yu-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Tao","familyName":"Duan","name":"Duan, Ming-Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Hao","familyName":"Hou","name":"Hou, Yong-Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Training of Robust Traditional Chinese LLaMA-1B on a Single Consumer GPU: Continual Pre-training, SFT, and DPO"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:50:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.17240351","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Small Language Models (SLMs) enable cost-effective, on-device and latency-sensitive AI applications, yet their deployment in Traditional Chinese (TC) remains hindered by token-level instability - models unpredictably emit non-TC characters or code-switch into other languages. We address this practical reliability gap by creating PureTC-1B, a three-stage stabilization pipeline for Llama-3.2-1B-Instruct (an open-weight, instruction-tuned model released by Meta) using parameter-efficient LoRA adapters. Our method combines Continual Pre-Training (CPT) on TC-centric corpora, Supervised Fine-Tuning (SFT) with instruction data, and Direct Preference Optimization (DPO) using TC-adherence preferences to improve monolingual robustness without full-model retraining. On a benchmark designed to simulate real-world usage, PureTC-1B achieves a 51.3% relative reduction (micro-average) in non-TC output tokens versus the base model. On a Named Entity Translation (NET) task, PureTC-1B further reduces incorrect-language tokens by 77.2% relative to Llama-3B and 57.2% relative to Qwen-1.5B, indicating that robust TC adherence is attainable even at the 1B scale. The pipeline is reproducible, adapter-only, and hardware-friendly, offering practitioners a practical recipe to enhance language stability for TC and potentially other non-English languages."},{"descriptionType":"Other","description":"17 pages, 1 figures, 2 tables. Technical report. Introduces PureTC-1B, an adapter-based pipeline for stabilizing Small Language Models in Traditional Chinese using CPT, SFT, and DPO"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01616","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:53:34Z","registered":"2025-10-03T01:53:34Z","published":null,"updated":"2025-10-03T01:53:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01606","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01606","identifiers":[{"identifier":"2510.01606","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bo","familyName":"Ma","name":"Ma, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"LuYao","familyName":"Liu","name":"Liu, LuYao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Lau","name":"Lau, Simon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandler","familyName":"Yuan","name":"Yuan, Chandler","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"and XueY","familyName":"Cui","name":"Cui, and XueY","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosie","familyName":"Zhang","name":"Zhang, Rosie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bridging Collaborative Filtering and Large Language Models with Dynamic Alignment, Multimodal Fusion and Evidence-grounded Explanations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:43:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:21:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent research has explored using Large Language Models for recommendation tasks by transforming user interaction histories and item metadata into text prompts, then having the LLM produce rankings or recommendations. A promising approach involves connecting collaborative filtering knowledge to LLM representations through compact adapter networks, which avoids expensive fine-tuning while preserving the strengths of both components. Yet several challenges persist in practice: collaborative filtering models often use static snapshots that miss rapidly changing user preferences; many real-world items contain rich visual and audio content beyond textual descriptions; and current systems struggle to provide trustworthy explanations backed by concrete evidence. Our work introduces \\model{}, a framework that tackles these limitations through three key innovations. We develop an online adaptation mechanism that continuously incorporates new user interactions through lightweight modules, avoiding the need to retrain large models. We create a unified representation that seamlessly combines collaborative signals with visual and audio features, handling cases where some modalities may be unavailable. Finally, we design an explanation system that grounds recommendations in specific collaborative patterns and item attributes, producing natural language rationales users can verify. Our approach maintains the efficiency of frozen base models while adding minimal computational overhead, making it practical for real-world deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01606","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:19Z","registered":"2025-10-03T01:53:20Z","published":null,"updated":"2025-10-03T01:53:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01598","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01598","identifiers":[{"identifier":"2510.01598","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Youwei","familyName":"Bao","name":"Bao, Youwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhan","familyName":"Yang","name":"Yang, Shuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunsoo","familyName":"Yang","name":"Yang, Hyunsoo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Securing generative artificial intelligence with parallel magnetic tunnel junction true randomness"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Analysis, Statistics and Probability (physics.data-an)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:26:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:20:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deterministic pseudo random number generators (PRNGs) used in generative artificial intelligence (GAI) models produce predictable patterns vulnerable to exploitation by attackers. Conventional defences against the vulnerabilities often come with significant energy and latency overhead. Here, we embed hardware-generated true random bits from spin-transfer torque magnetic tunnel junctions (STT-MTJs) to address the challenges. A highly parallel, FPGA-assisted prototype computing system delivers megabit-per-second true random numbers, passing NIST randomness tests after in-situ operations with minimal overhead. Integrating the hardware random bits into a generative adversarial network (GAN) trained on CIFAR-10 reduces insecure outputs by up to 18.6 times compared to the low-quality random number generators (RNG) baseline. With nanosecond switching speed, high energy efficiency, and established scalability, our STT-MTJ-based system holds the potential to scale beyond 106 parallel cells, achieving gigabit-per-second throughput suitable for large language model sampling. This advancement highlights spintronic RNGs as practical security components for next-generation GAI systems."},{"descriptionType":"Other","description":"4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01598","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:53:08Z","registered":"2025-10-03T01:53:08Z","published":null,"updated":"2025-10-03T01:53:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01591","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01591","identifiers":[{"identifier":"2510.01591","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhenwen","familyName":"Liang","name":"Liang, Zhenwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruosen","familyName":"Li","name":"Li, Ruosen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujun","familyName":"Zhou","name":"Zhou, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linfeng","familyName":"Song","name":"Song, Linfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dian","familyName":"Yu","name":"Yu, Dian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinya","familyName":"Du","name":"Du, Xinya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitao","familyName":"Mi","name":"Mi, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yu","name":"Yu, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CLUE: Non-parametric Verification from Experience via Hidden-State Clustering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:14:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:19:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Assessing the quality of Large Language Model (LLM) outputs presents a critical challenge. Previous methods either rely on text-level information (e.g., reward models, majority voting), which can overfit to superficial cues, or on calibrated confidence from token probabilities, which would fail on less-calibrated models. Yet both of these signals are, in fact, partial projections of a richer source of information: the model's internal hidden states. Early layers, closer to token embeddings, preserve semantic and lexical features that underpin text-based judgments, while later layers increasingly align with output logits, embedding confidence-related information. This paper explores hidden states directly as a unified foundation for verification. We show that the correctness of a solution is encoded as a geometrically separable signature within the trajectory of hidden activations. To validate this, we present Clue (Clustering and Experience-based Verification), a deliberately minimalist, non-parametric verifier. With no trainable parameters, CLUE only summarizes each reasoning trace by an hidden state delta and classifies correctness via nearest-centroid distance to ``success'' and ``failure'' clusters formed from past experience. The simplicity of this method highlights the strength of the underlying signal. Empirically, CLUE consistently outperforms LLM-as-a-judge baselines and matches or exceeds modern confidence-based methods in reranking candidates, improving both top-1 and majority-vote accuracy across AIME 24/25 and GPQA. As a highlight, on AIME 24 with a 1.5B model, CLUE boosts accuracy from 56.7% (majority@64) to 70.0% (top-maj@16)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01591","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:56Z","registered":"2025-10-03T01:52:57Z","published":null,"updated":"2025-10-03T01:52:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01585","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01585","identifiers":[{"identifier":"2510.01585","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haochen","familyName":"You","name":"You, Haochen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baojing","familyName":"Liu","name":"Liu, Baojing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReSSFormer: A Recursive Sparse Structured Transformer for Scalable and Long-Context Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:05:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:19:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While Transformer architectures have demonstrated impressive scalability across domains, they continue to face challenges in long-context reasoning, computational efficiency, and structural generalization - largely due to rigid layer stacking, dense attention, and reliance on positional encodings. We present ReSSFormer, a Recursive Sparse Structured Transformer that integrates three complementary innovations: Recurrent Reasoning \u0026amp; Memory Unit (R2MU) for iterative reasoning with bounded depth, Adaptive Sparse Attention Module (ASAM) for efficient and focused context selection, and Self-Organizing Encoder Structure (SOES) for position-free structure induction. ReSSFormer replaces conventional depth stacking with recurrent inference, substitutes full attention with token- and expert-level sparsity, and models latent token topology directly from content. Across language modeling, multi-hop QA, and structure-sensitive tasks, ReSSFormer consistently outperforms strong baselines under comparable FLOPs and parameter budgets, highlighting its scalability, efficiency, and structural flexibility."},{"descriptionType":"Other","description":"Accepted as a short paper at ACM Multimedia Asia 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01585","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:48Z","registered":"2025-10-03T01:52:48Z","published":null,"updated":"2025-10-03T01:52:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01582","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01582","identifiers":[{"identifier":"2510.01582","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Krishna Teja","familyName":"Chitty-Venkata","name":"Chitty-Venkata, Krishna Teja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Murali","familyName":"Emani","name":"Emani, Murali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ImageNet-Think-250K: A Large-Scale Synthetic Dataset for Multimodal Reasoning for Vision Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T02:02:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:18:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We develop ImageNet-Think, a multimodal reasoning dataset designed to aid the development of Vision Language Models (VLMs) with explicit reasoning capabilities. Our dataset is built on 250,000 images from ImageNet21k dataset, providing structured thinking tokens and corresponding answers. Our synthetic dataset is generated by two state-of-the-art VLMs: GLM-4.1V-9B-Thinking and Kimi-VL-A3B-Thinking-2506. Each image is accompanied by two pairs of thinking-answer sequences, creating a resource for training and evaluating multimodal reasoning models. We capture the step-by-step reasoning process of VLMs and the final descriptive answers. Our goal with this dataset is to enable the development of more robust VLMs while contributing to the broader understanding of multimodal reasoning mechanisms. The dataset and evaluation benchmarks will be publicly available to aid research in reasoning/thinking multimodal VLMs."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01582","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:43Z","registered":"2025-10-03T01:52:44Z","published":null,"updated":"2025-10-03T01:52:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01571","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01571","identifiers":[{"identifier":"2510.01571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanqun","familyName":"Cao","name":"Cao, Hanqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongrui","familyName":"Zhang","name":"Zhang, Hongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junde","familyName":"Xu","name":"Xu, Junde","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhou","familyName":"Zhang","name":"Zhang, Zhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingdong","familyName":"Shen","name":"Shen, Lingdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Sun","name":"Sun, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Liu","name":"Liu, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinbo","familyName":"Xu","name":"Xu, Jinbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wu-Jun","familyName":"Li","name":"Li, Wu-Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinren","familyName":"Ni","name":"Ni, Jinren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cesar","familyName":"de la Fuente-Nunez","name":"de la Fuente-Nunez, Cesar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianfan","familyName":"Fu","name":"Fu, Tianfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yejin","familyName":"Choi","name":"Choi, Yejin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pheng-Ann","familyName":"Heng","name":"Heng, Pheng-Ann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Wu","name":"Wu, Fang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Supervision to Exploration: What Does Protein Language Model Learn During Reinforcement Learning?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:31:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Protein language models (PLMs) have advanced computational protein science through large-scale pretraining and scalable architectures. In parallel, reinforcement learning (RL) has broadened exploration and enabled precise multi-objective optimization in protein design. Yet whether RL can push PLMs beyond their pretraining priors to uncover latent sequence-structure-function rules remains unclear. We address this by pairing RL with PLMs across four domains: antimicrobial peptide design, kinase variant optimization, antibody engineering, and inverse folding. Using diverse RL algorithms and model classes, we ask if RL improves sampling efficiency and, more importantly, if it reveals capabilities not captured by supervised learning. Across benchmarks, RL consistently boosts success rates and sample efficiency. Performance follows a three-factor interaction: task headroom, reward fidelity, and policy capacity jointly determine gains. When rewards are accurate and informative, policies have sufficient capacity, and tasks leave room beyond supervised baselines, improvements scale; when rewards are noisy or capacity is constrained, gains saturate despite exploration. This view yields practical guidance for RL in protein design: prioritize reward modeling and calibration before scaling policy size, match algorithm and regularization strength to task difficulty, and allocate capacity where marginal gains are largest. Implementation is available at https://github.com/chq1155/RL-PLM."},{"descriptionType":"Other","description":"24 pages, 7 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01571","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:27Z","registered":"2025-10-03T01:52:28Z","published":null,"updated":"2025-10-03T01:52:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01560","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01560","identifiers":[{"identifier":"2510.01560","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lang","familyName":"Tong","name":"Tong, Lang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Wang","name":"Wang, Xinyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI Foundation Model for Time Series with Innovations Representation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:14:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces an Artificial Intelligence (AI) foundation model for time series in engineering applications, where causal operations are required for real-time monitoring and control. Since engineering time series are governed by physical, rather than linguistic, laws, large-language-model-based AI foundation models may be ineffective or inefficient. Building on the classical innovations representation theory of Wiener, Kallianpur, and Rosenblatt, we propose Time Series GPT (TS-GPT) -- an innovations-representation-based Generative Pre-trained Transformer for engineering monitoring and control. As an example of foundation model adaptation, we consider Probabilistic Generative Forecasting, which produces future time series samples from conditional probability distributions given past realizations. We demonstrate the effectiveness of TS-GPT in forecasting real-time locational marginal prices using historical data from U.S. independent system operators."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01560","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:11Z","registered":"2025-10-03T01:52:12Z","published":null,"updated":"2025-10-03T01:52:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01558","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01558","identifiers":[{"identifier":"2510.01558","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengyang","familyName":"Shen","name":"Shen, Zhengyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuehao","familyName":"Zhai","name":"Zhai, Xuehao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Tu","name":"Tu, Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mayue","familyName":"Shi","name":"Shi, Mayue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CardioRAG: A Retrieval-Augmented Generation Framework for Multimodal Chagas Disease Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T01:02:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:17:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Chagas disease affects nearly 6 million people worldwide, with Chagas cardiomyopathy representing its most severe complication. In regions where serological testing capacity is limited, AI-enhanced electrocardiogram (ECG) screening provides a critical diagnostic alternative. However, existing machine learning approaches face challenges such as limited accuracy, reliance on large labeled datasets, and more importantly, weak integration with evidence-based clinical diagnostic indicators. We propose a retrieval-augmented generation framework, CardioRAG, integrating large language models with interpretable ECG-based clinical features, including right bundle branch block, left anterior fascicular block, and heart rate variability metrics. The framework uses variational autoencoder-learned representations for semantic case retrieval, providing contextual cases to guide clinical reasoning. Evaluation demonstrated high recall performance of 89.80%, with a maximum F1 score of 0.68 for effective identification of positive cases requiring prioritized serological testing. CardioRAG provides an interpretable, clinical evidence-based approach particularly valuable for resource-limited settings, demonstrating a pathway for embedding clinical indicators into trustworthy medical AI systems."},{"descriptionType":"Other","description":"4 pages, 2 figures. Accepted for oral presentation at the 52nd international Computing in Cardiology Conference (CinC2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01558","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:52:08Z","registered":"2025-10-03T01:52:08Z","published":null,"updated":"2025-10-03T01:52:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01546","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01546","identifiers":[{"identifier":"2510.01546","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanyu","familyName":"Wang","name":"Wang, Hanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaming","familyName":"Han","name":"Han, Jiaming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyan","familyName":"Yang","name":"Yang, Ziyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhao","name":"Zhao, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanchuan","familyName":"Lin","name":"Lin, Shanchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Yue","name":"Yue, Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhinav","familyName":"Shrivastava","name":"Shrivastava, Abhinav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenheng","familyName":"Yang","name":"Yang, Zhenheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Growing Visual Generative Capacity for Pre-Trained MLLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T00:40:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:16:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal large language models (MLLMs) extend the success of language models to visual understanding, and recent efforts have sought to build unified MLLMs that support both understanding and generation. However, constructing such models remains challenging: hybrid approaches combine continuous embeddings with diffusion or flow-based objectives, producing high-quality images but breaking the autoregressive paradigm, while pure autoregressive approaches unify text and image prediction over discrete visual tokens but often face trade-offs between semantic alignment and pixel-level fidelity. In this work, we present Bridge, a pure autoregressive unified MLLM that augments pre-trained visual understanding models with generative ability through a Mixture-of-Transformers architecture, enabling both image understanding and generation within a single next-token prediction framework. To further improve visual generation fidelity, we propose a semantic-to-pixel discrete representation that integrates compact semantic tokens with fine-grained pixel tokens, achieving strong language alignment and precise description of visual details with only a 7.9% increase in sequence length. Extensive experiments across diverse multimodal benchmarks demonstrate that Bridge achieves competitive or superior results in both understanding and generation benchmarks, while requiring less training data and reduced training time compared to prior unified MLLMs."},{"descriptionType":"Other","description":"Project page: https://hywang66.github.io/bridge/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01546","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:50Z","registered":"2025-10-03T01:51:51Z","published":null,"updated":"2025-10-03T01:51:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01539","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01539","identifiers":[{"identifier":"2510.01539","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aniket","familyName":"Vashishtha","name":"Vashishtha, Aniket","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qirun","familyName":"Dai","name":"Dai, Qirun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyuan","familyName":"Mei","name":"Mei, Hongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"Sharma","name":"Sharma, Amit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenhao","familyName":"Tan","name":"Tan, Chenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Peng","name":"Peng, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Executable Counterfactuals: Improving LLMs' Causal Reasoning Through Code"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T00:26:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Counterfactual reasoning, a hallmark of intelligence, consists of three steps: inferring latent variables from observations (abduction), constructing alternatives (interventions), and predicting their outcomes (prediction). This skill is essential for advancing LLMs' causal understanding and expanding their applications in high-stakes domains such as scientific research. However, existing efforts in assessing LLM's counterfactual reasoning capabilities tend to skip the abduction step, effectively reducing to interventional reasoning and leading to overestimation of LLM performance. To address this, we introduce executable counterfactuals, a novel framework that operationalizes causal reasoning through code and math problems. Our framework explicitly requires all three steps of counterfactual reasoning and enables scalable synthetic data creation with varying difficulty, creating a frontier for evaluating and improving LLM's reasoning. Our results reveal substantial drop in accuracy (25-40%) from interventional to counterfactual reasoning for SOTA models like o4-mini and Claude-4-Sonnet. To address this gap, we construct a training set comprising counterfactual code problems having if-else condition and test on out-of-domain code structures (e.g. having while-loop); we also test whether a model trained on code would generalize to counterfactual math word problems. While supervised finetuning on stronger models' reasoning traces improves in-domain performance of Qwen models, it leads to a decrease in accuracy on OOD tasks such as counterfactual math problems. In contrast, reinforcement learning induces the core cognitive behaviors and generalizes to new domains, yielding gains over the base model on both code (improvement of 1.5x-2x) and math problems. Analysis of the reasoning traces reinforces these findings and highlights the promise of RL for improving LLMs' counterfactual reasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01539","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:40Z","registered":"2025-10-03T01:51:40Z","published":null,"updated":"2025-10-03T01:51:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01531","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01531","identifiers":[{"identifier":"2510.01531","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Djengo Cyun-Jyun","familyName":"Fang","name":"Fang, Djengo Cyun-Jyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsung-Wei","familyName":"Ke","name":"Ke, Tsung-Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Information Seeking for Robust Decision Making under Partial Observability"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T00:06:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Explicit information seeking is essential to human problem-solving in practical environments characterized by incomplete information and noisy dynamics. When the true environmental state is not directly observable, humans seek information to update their internal dynamics and inform future decision-making. Although existing Large Language Model (LLM) planning agents have addressed observational uncertainty, they often overlook discrepancies between their internal dynamics and the actual environment. We introduce Information Seeking Decision Planner (InfoSeeker), an LLM decision-making framework that integrates task-oriented planning with information seeking to align internal dynamics and make optimal decisions under uncertainty in both agent observations and environmental dynamics. InfoSeeker prompts an LLM to actively gather information by planning actions to validate its understanding, detect environmental changes, or test hypotheses before generating or revising task-oriented plans. To evaluate InfoSeeker, we introduce a novel benchmark suite featuring partially observable environments with incomplete observations and uncertain dynamics. Experiments demonstrate that InfoSeeker achieves a 74% absolute performance gain over prior methods without sacrificing sample efficiency. Moreover, InfoSeeker generalizes across LLMs and outperforms baselines on established benchmarks such as robotic manipulation and web navigation. These findings underscore the importance of tightly integrating planning and information seeking for robust behavior in partially observable environments. The project page is available at https://infoseekerllm.github.io"},{"descriptionType":"Other","description":"The project page is available at https://infoseekerllm.github.io"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01531","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:28Z","registered":"2025-10-03T01:51:29Z","published":null,"updated":"2025-10-03T01:51:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01528","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01528","identifiers":[{"identifier":"2510.01528","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Zhao","name":"Zhao, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhilash","familyName":"Shankarampeta","name":"Shankarampeta, Abhilash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanxiang","familyName":"Hu","name":"Hu, Lanxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tajana","familyName":"Rosing","name":"Rosing, Tajana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhang","name":"Zhang, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Interpretable and Inference-Optimal COT Reasoning with Sparse Autoencoder-Guided Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T00:01:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a novel method that leverages sparse autoencoders (SAEs) and clustering techniques to analyze the internal token representations of large language models (LLMs) and guide generations in mathematical reasoning tasks. Our approach first trains an SAE to generate sparse vector representations for training tokens, then applies k-means clustering to construct a graph where vertices represent token clusters and weighted edges capture sequential token transitions. Using this graph, we define an edge-weight based reward function to quantify adherence to established reasoning traces, thereby identifying exploitative reasoning trajectories. Additionally, we measure generation diversity from clustering to assess the extent of exploration. Our findings indicate that balancing both exploitation and exploration is crucial for achieving high accuracy in mathematical reasoning tasks. During generation, the SAE can serve as a scalable reward model to guide generations, ensuring a balanced trade-off between exploitation and exploration. This prevents extreme behaviors in either direction, ultimately fostering a higher-quality reasoning process in LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01528","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:24Z","registered":"2025-10-03T01:51:25Z","published":null,"updated":"2025-10-03T01:51:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01526","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01526","identifiers":[{"identifier":"2510.01526","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mengyu","familyName":"Wang","name":"Wang, Mengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sotirios","familyName":"Sabanis","name":"Sabanis, Sotirios","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miguel","familyName":"de Carvalho","name":"de Carvalho, Miguel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shay B.","familyName":"Cohen","name":"Cohen, Shay B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiejun","familyName":"Ma","name":"Ma, Tiejun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"One More Question is Enough, Expert Question Decomposition (EQD) Model for Domain Quantitative Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Finance (q-fin.CP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T23:45:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:15:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Domain-specific quantitative reasoning remains a major challenge for large language models (LLMs), especially in fields requiring expert knowledge and complex question answering (QA). In this work, we propose Expert Question Decomposition (EQD), an approach designed to balance the use of domain knowledge with computational efficiency. EQD is built on a two-step fine-tuning framework and guided by a reward function that measures the effectiveness of generated sub-questions in improving QA outcomes. It requires only a few thousand training examples and a single A100 GPU for fine-tuning, with inference time comparable to zero-shot prompting. Beyond its efficiency, EQD outperforms state-of-the-art domain-tuned models and advanced prompting strategies. We evaluate EQD in the financial domain, characterized by specialized knowledge and complex quantitative reasoning, across four benchmark datasets. Our method consistently improves QA performance by 0.6% to 10.5% across different LLMs. Our analysis reveals an important insight: in domain-specific QA, a single supporting question often provides greater benefit than detailed guidance steps."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01526","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:21Z","registered":"2025-10-03T01:51:22Z","published":null,"updated":"2025-10-03T01:51:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01524","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01524","identifiers":[{"identifier":"2510.01524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Viraj","familyName":"Prabhu","name":"Prabhu, Viraj","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Dai","name":"Dai, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Fernandez","name":"Fernandez, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Gu","name":"Gu, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krithika","familyName":"Ramakrishnan","name":"Ramakrishnan, Krithika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanqi","familyName":"Luo","name":"Luo, Yanqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Silvio","familyName":"Savarese","name":"Savarese, Silvio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caiming","familyName":"Xiong","name":"Xiong, Caiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junnan","familyName":"Li","name":"Li, Junnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyuan","familyName":"Chen","name":"Chen, Zeyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"Xu","name":"Xu, Ran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WALT: Web Agents that Learn Tools"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T23:41:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:14:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Web agents promise to automate complex browser tasks, but current methods remain brittle -- relying on step-by-step UI interactions and heavy LLM reasoning that break under dynamic layouts and long horizons. Humans, by contrast, exploit website-provided functionality through high-level operations like search, filter, and sort. We introduce WALT (Web Agents that Learn Tools), a framework that reverse-engineers latent website functionality into reusable invocable tools. Rather than hypothesizing ad-hoc skills, WALT exposes robust implementations of automations already designed into websites -- spanning discovery (search, filter, sort), communication (post, comment, upvote), and content management (create, edit, delete). Tools abstract away low-level execution: instead of reasoning about how to click and type, agents simply call search(query) or create(listing). This shifts the computational burden from fragile step-by-step reasoning to reliable tool invocation. On VisualWebArena and WebArena, WALT achieves higher success with fewer steps and less LLM-dependent reasoning, establishing a robust and generalizable paradigm for browser automation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:18Z","registered":"2025-10-03T01:51:19Z","published":null,"updated":"2025-10-03T01:51:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01520","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01520","identifiers":[{"identifier":"2510.01520","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hossein","familyName":"Sholehrasa","name":"Sholehrasa, Hossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuan","familyName":"Xu","name":"Xu, Xuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Doina","familyName":"Caragea","name":"Caragea, Doina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jim E.","familyName":"Riviere","name":"Riviere, Jim E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Majid","familyName":"Jaberi-Douraki","name":"Jaberi-Douraki, Majid","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predictive Modeling and Explainable AI for Veterinary Safety Profiles, Residue Assessment, and Health Outcomes Using Real-World Data and Physicochemical Properties"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T23:34:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:14:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The safe use of pharmaceuticals in food-producing animals is vital to protect animal welfare and human food safety. Adverse events (AEs) may signal unexpected pharmacokinetic or toxicokinetic effects, increasing the risk of violative residues in the food chain. This study introduces a predictive framework for classifying outcomes (Death vs. Recovery) using ~1.28 million reports (1987-2025 Q1) from the U.S. FDA's OpenFDA Center for Veterinary Medicine. A preprocessing pipeline merged relational tables and standardized AEs through VeDDRA ontologies. Data were normalized, missing values imputed, and high-cardinality features reduced; physicochemical drug properties were integrated to capture chemical-residue links. We evaluated supervised models, including Random Forest, CatBoost, XGBoost, ExcelFormer, and large language models (Gemma 3-27B, Phi 3-12B). Class imbalance was addressed, such as undersampling and oversampling, with a focus on prioritizing recall for fatal outcomes. Ensemble methods(Voting, Stacking) and CatBoost performed best, achieving precision, recall, and F1-scores of 0.95. Incorporating Average Uncertainty Margin (AUM)-based pseudo-labeling of uncertain cases improved minority-class detection, particularly in ExcelFormer and XGBoost. Interpretability via SHAP identified biologically plausible predictors, including lung, heart, and bronchial disorders, animal demographics, and drug physicochemical properties. These features were strongly linked to fatal outcomes. Overall, the framework shows that combining rigorous data engineering, advanced machine learning, and explainable AI enables accurate, interpretable predictions of veterinary safety outcomes. The approach supports FARAD's mission by enabling early detection of high-risk drug-event profiles, strengthening residue risk assessment, and informing regulatory and clinical decision-making."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01520","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:51:07Z","registered":"2025-10-03T01:51:13Z","published":null,"updated":"2025-10-03T01:51:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01470","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01470","identifiers":[{"identifier":"2510.01470","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stephen","familyName":"Meisenbacher","name":"Meisenbacher, Stephen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Svetlozar","familyName":"Nestorov","name":"Nestorov, Svetlozar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Norlander","name":"Norlander, Peter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Extracting O*NET Features from the NLx Corpus to Build Public Use Aggregate Labor Market Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T21:27:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:11:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data from online job postings are difficult to access and are not built in a standard or transparent manner. Data included in the standard taxonomy and occupational information database (O*NET) are updated infrequently and based on small survey samples. We adopt O*NET as a framework for building natural language processing tools that extract structured information from job postings. We publish the Job Ad Analysis Toolkit (JAAT), a collection of open-source tools built for this purpose, and demonstrate its reliability and accuracy in out-of-sample and LLM-as-a-Judge testing. We extract more than 10 billion data points from more than 155 million online job ads provided by the National Labor Exchange (NLx) Research Hub, including O*NET tasks, occupation codes, tools, and technologies, as well as wages, skills, industry, and more features. We describe the construction of a dataset of occupation, state, and industry level features aggregated by monthly active jobs from 2015 - 2025. We illustrate the potential for research and future uses in education and workforce development."},{"descriptionType":"Other","description":"85 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01470","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:54Z","registered":"2025-10-03T01:49:54Z","published":null,"updated":"2025-10-03T01:49:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01469","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01469","identifiers":[{"identifier":"2510.01469","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicolás","familyName":"Aguirre","name":"Aguirre, Nicolás","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramiro","familyName":"Caso","name":"Caso, Ramiro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramiro Rodríguez","familyName":"Colmeiro","name":"Colmeiro, Ramiro Rodríguez","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mauro","familyName":"Santelli","name":"Santelli, Mauro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joaquín Toranzo","familyName":"Calderón","name":"Calderón, Joaquín Toranzo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A-VERT: Agnostic Verification with Embedding Ranking Targets"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-10-01T21:26:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:11:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The automatic evaluation of Language Model (LM) responses is a critical piece in the development of benchmarks and metrics, both for model training and quality assessment of production model endpoints. The current approaches to response classification relies on methods that are too expensive (i.e. LLM-as-a-Judge) or that are far from real-world conditions (string-matching, logprob). In this paper, a structure-free evaluation method is presented. The method makes use of semantic embedding distances to match target candidates with arbitrary LM-generated text, resulting in a robust classification of the response at a relatively low compute cost (embedding models of less than $10B$ parameters). The results show a regression score of ~0.97 and an accuracy of ~96% against human annotators, tested over 3 data sets and 3 different LM architectures."},{"descriptionType":"Other","description":"19 pages, 7 figures, code available at https://github.com/pnyxai/a-vert, authors in alphabetical order"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01469","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:52Z","registered":"2025-10-03T01:49:53Z","published":null,"updated":"2025-10-03T01:49:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01459","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01459","identifiers":[{"identifier":"2510.01459","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weizhe","familyName":"Chen","name":"Chen, Weizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sven","familyName":"Koenig","name":"Koenig, Sven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bistra","familyName":"Dilkina","name":"Dilkina, Bistra","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LSPO: Length-aware Dynamic Sampling for Policy Optimization in LLM Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:57:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:10:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Since the release of Deepseek-R1, reinforcement learning with verifiable rewards (RLVR) has become a central approach for training large language models (LLMs) on reasoning tasks. Recent work has largely focused on modifying loss functions to make RLVR more efficient and effective. In this paper, motivated by studies of overthinking in LLMs, we propose Length-aware Sampling for Policy Optimization (LSPO), a novel meta-RLVR algorithm that dynamically selects training data at each step based on the average response length. We evaluate LSPO across multiple base models and datasets, demonstrating that it consistently improves learning effectiveness. In addition, we conduct a detailed ablation study to examine alternative ways of incorporating length signals into dynamic sampling, offering further insights and highlighting promising directions for future research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01459","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:37Z","registered":"2025-10-03T01:49:38Z","published":null,"updated":"2025-10-03T01:49:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01454","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01454","identifiers":[{"identifier":"2510.01454","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nilay","familyName":"Naharas","name":"Naharas, Nilay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dang","familyName":"Nguyen","name":"Nguyen, Dang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nesihan","familyName":"Bulut","name":"Bulut, Nesihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammadhossein","familyName":"Bateni","name":"Bateni, Mohammadhossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vahab","familyName":"Mirrokni","name":"Mirrokni, Vahab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baharan","familyName":"Mirzasoleiman","name":"Mirzasoleiman, Baharan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Data Selection for Fine-tuning Vision Language Models via Cross Modal Alignment Trajectories"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:47:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:10:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data-efficient learning aims to eliminate redundancy in large training datasets by training models on smaller subsets of the most informative examples. While data selection has been extensively explored for vision models and large language models (LLMs), it remains underexplored for Large Vision-Language Models (LVLMs). Notably, none of existing methods can outperform random selection at different subset sizes. In this work, we propose the first principled method for data-efficient instruction tuning of LVLMs. We prove that examples with similar cross-modal attention matrices during instruction tuning have similar gradients. Thus, they influence model parameters in a similar manner and convey the same information to the model during training. Building on this insight, we propose XMAS, which clusters examples based on the trajectories of the top singular values of their attention matrices obtained from fine-tuning a small proxy LVLM. By sampling a balanced subset from these clusters, XMAS effectively removes redundancy in large-scale LVLM training data. Extensive experiments show that XMAS can discard 50% of the LLaVA-665k dataset and 85% of the Vision-Flan dataset while fully preserving performance of LLaVA-1.5-7B on 10 downstream benchmarks and speeding up its training by 1.2x. This is 30% more data reduction compared to the best baseline for LLaVA-665k. The project's website can be found at https://bigml-cs-ucla.github.io/XMAS-project-page/."},{"descriptionType":"Other","description":"30 pages, 10 figures, 5 tables, link: https://bigml-cs-ucla.github.io/XMAS-project-page/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01454","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:30Z","registered":"2025-10-03T01:49:30Z","published":null,"updated":"2025-10-03T01:49:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01451","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01451","identifiers":[{"identifier":"2510.01451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anne Lundgaard","familyName":"Hansen","name":"Hansen, Anne Lundgaard","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seung Jung","familyName":"Lee","name":"Lee, Seung Jung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Financial Stability Implications of Generative AI: Taming the Animal Spirits"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"General Finance (q-fin.GN)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:46:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:10:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.17016/feds.2025.090","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the impact of the adoption of generative AI on financial stability. We conduct laboratory-style experiments using large language models to replicate classic studies on herd behavior in trading decisions. Our results show that AI agents make more rational decisions than humans, relying predominantly on private information over market trends. Increased reliance on AI-powered trading advice could therefore potentially lead to fewer asset price bubbles arising from animal spirits that trade by following the herd. However, exploring variations in the experimental settings reveals that AI agents can be induced to herd optimally when explicitly guided to make profit-maximizing decisions. While optimal herding improves market discipline, this behavior still carries potential implications for financial stability. In other experimental variations, we show that AI agents are not purely algorithmic, but have inherited some elements of human conditioning and bias."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01451","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-10-03T01:49:25Z","registered":"2025-10-03T01:49:26Z","published":null,"updated":"2025-10-03T01:49:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01450","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01450","identifiers":[{"identifier":"2510.01450","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifei","familyName":"Zuo","name":"Zuo, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Yin","name":"Yin, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhichen","familyName":"Zeng","name":"Zeng, Zhichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ang","familyName":"Li","name":"Li, Ang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Banghua","familyName":"Zhu","name":"Zhu, Banghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoran","familyName":"Wang","name":"Wang, Zhaoran","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T20:42:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:10:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer architectures have achieved remarkable success in various domains. While efficient alternatives to Softmax Attention have been widely studied, the search for more expressive mechanisms grounded in theoretical insight-even at greater computational cost-has been relatively underexplored. In this work, we bridge this gap by proposing Local Linear Attention (LLA), a novel attention mechanism derived from nonparametric statistics through the lens of test-time regression. First, we show that LLA offers theoretical advantages over Linear and Softmax Attention for associative memory via a bias-variance trade-off analysis. Next, we address its computational challenges and propose two memory-efficient primitives to tackle the $Θ(n^2 d)$ and $Θ(n d^2)$ complexity. We then introduce FlashLLA, a hardware-efficient, blockwise algorithm that enables scalable and parallel computation on modern accelerators. In addition, we implement and profile a customized inference kernel that significantly reduces memory overheads. Finally, we empirically validate the advantages and limitations of LLA on test-time regression, in-context regression, associative recall and state tracking tasks. Experiment results demonstrate that LLA effectively adapts to non-stationarity, outperforming strong baselines in test-time training and in-context learning, and exhibiting promising evidence for its scalability and applicability in large-scale models. Code is available at https://github.com/Yifei-Zuo/Flash-LLA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01450","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:49:24Z","registered":"2025-10-03T01:49:25Z","published":null,"updated":"2025-10-03T01:49:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01394","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01394","identifiers":[{"identifier":"2510.01394","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yusuf","familyName":"Kalayci","name":"Kalayci, Yusuf","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vinod","familyName":"Raman","name":"Raman, Vinod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaddin","familyName":"Dughmi","name":"Dughmi, Shaddin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal Stopping vs Best-of-$N$ for Inference Time Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T19:25:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:07:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) generation often requires balancing output quality against inference cost, especially when using multiple generations. We introduce a new framework for inference-time optimization based on the classical Pandora's Box problem. Viewing each generation as opening a costly \"box\" with random reward, we develop algorithms that decide when to stop generating without knowing the underlying reward distribution. Our first contribution is a UCB-style Pandora's Box algorithm, which achieves performance that is provably close to Weitzman's algorithm, the optimal strategy when the distribution is known. We further adapt this method to practical LLM settings by addressing reward scaling across prompts via a Bradley-Terry inspired transformation. This leads to an adaptive inference-time optimization method that normalizes rewards and learns stopping thresholds on the fly. Experiments on the AlpacaFarm and HH-RLHF datasets, using multiple LLM-reward model pairs, show that our adaptive strategy can obtain the same performance as non-adaptive Best-of-N sampling while requiring 15-35 percent fewer generations on average. Our results establish a principled bridge between optimal stopping theory and inference-time scaling, providing both theoretical performance bounds and practical efficiency gains for LLM deployment."},{"descriptionType":"Other","description":"24 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01394","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:48:01Z","registered":"2025-10-03T01:48:02Z","published":null,"updated":"2025-10-03T01:48:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01391","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01391","identifiers":[{"identifier":"2510.01391","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maithili","familyName":"Kadam","name":"Kadam, Maithili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francis","familyName":"Ferraro","name":"Ferraro, Francis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TAG-EQA: Text-And-Graph for Event Question Answering via Structured Prompting Strategies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T19:23:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:07:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) excel at general language tasks but often struggle with event-based questions-especially those requiring causal or temporal reasoning. We introduce TAG-EQA (Text-And-Graph for Event Question Answering), a prompting framework that injects causal event graphs into LLM inputs by converting structured relations into natural-language statements. TAG-EQA spans nine prompting configurations, combining three strategies (zero-shot, few-shot, chain-of-thought) with three input modalities (text-only, graph-only, text+graph), enabling a systematic analysis of when and how structured knowledge aids inference. On the TORQUESTRA benchmark, TAG-EQA improves accuracy by 5% on average over text-only baselines, with gains up to 12% in zero-shot settings and 18% when graph-augmented CoT prompting is effective. While performance varies by model and configuration, our findings show that causal graphs can enhance event reasoning in LLMs without fine-tuning, offering a flexible way to encode structure in prompt-based QA."},{"descriptionType":"Other","description":"Accepted in *sem 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01391","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:57Z","registered":"2025-10-03T01:47:57Z","published":null,"updated":"2025-10-03T01:47:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01375","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01375","identifiers":[{"identifier":"2510.01375","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Humaid","familyName":"Ibrahim","name":"Ibrahim, Humaid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikolai","familyName":"Rozanov","name":"Rozanov, Nikolai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marek","familyName":"Rei","name":"Rei, Marek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fine-tuning with RAG for Improving LLM Learning of New Skills"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T19:03:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:06:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) agents deployed for multi-step tasks frequently fail in predictable ways: attempting actions with unmet preconditions, issuing redundant commands, or mishandling environment constraints. While retrieval-augmented generation (RAG) can improve performance by providing runtime guidance, it requires maintaining external knowledge databases and adds computational overhead at every deployment. We propose a simple pipeline that converts inference-time retrieval into learned competence through distillation. Our approach: (1) extracts compact, reusable hints from agent failures, (2) uses these hints to generate improved teacher trajectories via one-shot retrieval at episode start, and (3) trains student models on these trajectories with hint strings removed, forcing internalization rather than memorization. Across two interactive benchmarks, ALFWorld (household tasks) and WebShop (online shopping), distilled students consistently outperform baseline agents, achieving up to 91% success on ALFWorld (vs. 79% for baselines) and improving WebShop scores to 72 (vs. 61 for baselines), while using 10-60% fewer tokens than retrieval-augmented teachers depending on the environment. The approach generalizes across model scales (7B/14B parameters) and agent architectures (ReAct/StateAct), demonstrating that retrieval benefits can be effectively internalized through targeted fine-tuning without permanent runtime dependencies."},{"descriptionType":"Other","description":"Under review at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01375","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:34Z","registered":"2025-10-03T01:47:35Z","published":null,"updated":"2025-10-03T01:47:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01370","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01370","identifiers":[{"identifier":"2510.01370","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abu Bucker","familyName":"Siddik","name":"Siddik, Abu Bucker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diane","familyName":"Oyen","name":"Oyen, Diane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Most","name":"Most, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michal","familyName":"Kucer","name":"Kucer, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayan","familyName":"Biswas","name":"Biswas, Ayan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SPUS: A Lightweight and Parameter-Efficient Foundation Model for PDEs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T18:54:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:05:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Small PDE U-Net Solver (SPUS), a compact and efficient foundation model (FM) designed as a unified neural operator for solving a wide range of partial differential equations (PDEs). Unlike existing state-of-the-art PDE FMs-primarily based on large complex transformer architectures with high computational and parameter overhead-SPUS leverages a lightweight residual U-Net-based architecture that has been largely underexplored as a foundation model architecture in this domain. To enable effective learning in this minimalist framework, we utilize a simple yet powerful auto-regressive pretraining strategy which closely replicates the behavior of numerical solvers to learn the underlying physics. SPUS is pretrained on a diverse set of fluid dynamics PDEs and evaluated across 6 challenging unseen downstream PDEs spanning various physical systems. Experimental results demonstrate that SPUS using residual U-Net based architecture achieves state-of-the-art generalization on these downstream tasks while requiring significantly fewer parameters and minimal fine-tuning data, highlighting its potential as a highly parameter-efficient FM for solving diverse PDE systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01370","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:27Z","registered":"2025-10-03T01:47:27Z","published":null,"updated":"2025-10-03T01:47:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01353","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01353","identifiers":[{"identifier":"2510.01353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Darshan","familyName":"Deshpande","name":"Deshpande, Darshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun","familyName":"Gangal","name":"Gangal, Varun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hersh","familyName":"Mehta","name":"Mehta, Hersh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anand","familyName":"Kannappan","name":"Kannappan, Anand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca","familyName":"Qian","name":"Qian, Rebecca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MEMTRACK: Evaluating Long-Term Memory and State Tracking in Multi-Platform Dynamic Agent Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T18:34:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:05:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent works on context and memory benchmarking have primarily focused on conversational instances but the need for evaluating memory in dynamic enterprise environments is crucial for its effective application. We introduce MEMTRACK, a benchmark designed to evaluate long-term memory and state tracking in multi-platform agent environments. MEMTRACK models realistic organizational workflows by integrating asynchronous events across multiple communication and productivity platforms such as Slack, Linear and Git. Each benchmark instance provides a chronologically platform-interleaved timeline, with noisy, conflicting, cross-referring information as well as potential codebase/file-system comprehension and exploration. Consequently, our benchmark tests memory capabilities such as acquistion, selection and conflict resolution. We curate the MEMTRACK dataset through both manual expert driven design and scalable agent based synthesis, generating ecologically valid scenarios grounded in real world software development processes. We introduce pertinent metrics for Correctness, Efficiency, and Redundancy that capture the effectiveness of memory mechanisms beyond simple QA performance. Experiments across SoTA LLMs and memory backends reveal challenges in utilizing memory across long horizons, handling cross-platform dependencies, and resolving contradictions. Notably, the best performing GPT-5 model only achieves a 60\\% Correctness score on MEMTRACK. This work provides an extensible framework for advancing evaluation research for memory-augmented agents, beyond existing focus on conversational setups, and sets the stage for multi-agent, multi-platform memory benchmarking in complex organizational settings"},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025 SEA Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01353","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:47:01Z","registered":"2025-10-03T01:47:02Z","published":null,"updated":"2025-10-03T01:47:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01288","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01288","identifiers":[{"identifier":"2510.01288","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rui","familyName":"Melo","name":"Melo, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Abreu","name":"Abreu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Corina S.","familyName":"Pasareanu","name":"Pasareanu, Corina S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Microsaccade-Inspired Probing: Positional Encoding Perturbations Reveal LLM Misbehaviours"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T01:24:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We draw inspiration from microsaccades, tiny involuntary eye movements that reveal hidden dynamics of human perception, to propose an analogous probing method for large language models (LLMs). Just as microsaccades expose subtle but informative shifts in vision, we show that lightweight position encoding perturbations elicit latent signals that indicate model misbehaviour. Our method requires no fine-tuning or task-specific supervision, yet detects failures across diverse settings including factuality, safety, toxicity, and backdoor attacks. Experiments on multiple state-of-the-art LLMs demonstrate that these perturbation-based probes surface misbehaviours while remaining computationally efficient. These findings suggest that pretrained LLMs already encode the internal evidence needed to flag their own failures, and that microsaccade-inspired interventions provide a pathway for detecting and mitigating undesirable behaviours."},{"descriptionType":"Other","description":"9 main pages, 13 appendix pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01288","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:24Z","registered":"2025-10-03T01:45:25Z","published":null,"updated":"2025-10-03T01:45:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01283","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01283","identifiers":[{"identifier":"2510.01283","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Israel Abebe","familyName":"Azime","name":"Azime, Israel Abebe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tadesse Destaw","familyName":"Belay","name":"Belay, Tadesse Destaw","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atnafu Lambebo","familyName":"Tonja","name":"Tonja, Atnafu Lambebo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluation Sheet for Deep Research: A Use Case for Academic Survey Writing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T21:00:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) powered with argentic capabilities are able to do knowledge-intensive tasks without human involvement. A prime example of this tool is Deep research with the capability to browse the web, extract information and generate multi-page reports. In this work, we introduce an evaluation sheet that can be used for assessing the capability of Deep Research tools. In addition, we selected academic survey writing as a use case task and evaluated output reports based on the evaluation sheet we introduced. Our findings show the need to have carefully crafted evaluation standards. The evaluation done on OpenAI`s Deep Search and Google's Deep Search in generating an academic survey showed the huge gap between search engines and standalone Deep Research tools, the shortcoming in representing the targeted area."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01283","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:17Z","registered":"2025-10-03T01:45:18Z","published":null,"updated":"2025-10-03T01:45:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01279","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01279","identifiers":[{"identifier":"2510.01279","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongchao","familyName":"Chen","name":"Chen, Yongchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiefeng","familyName":"Chen","name":"Chen, Jiefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Meng","name":"Meng, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ji","familyName":"Yin","name":"Yin, Ji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Na","familyName":"Li","name":"Li, Na","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuchu","familyName":"Fan","name":"Fan, Chuchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Wang","name":"Wang, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomas","familyName":"Pfister","name":"Pfister, Tomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsung","familyName":"Yoon","name":"Yoon, Jinsung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TUMIX: Multi-Agent Test-Time Scaling with Tool-Use Mixture"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T19:19:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While integrating tools like Code Interpreter and Search has significantly enhanced Large Language Model (LLM) reasoning in models like ChatGPT Agent and Gemini-Pro, practical guidance on optimal tool use is lacking. The core challenge is effectively combining textual reasoning, coding, and search for diverse questions. In this paper, we propose Tool-Use Mixture (TUMIX), an ensemble framework that runs multiple agents in parallel, each employing distinct tool-use strategies and answer paths. Agents in TUMIX iteratively share and refine responses based on the question and previous answers. In experiments, TUMIX achieves significant gains over state-of-the-art tool-augmented and test-time scaling methods, delivering an average accuracy improvement of up to 3.55% over the best baseline on Gemini-2.5-Pro and Gemini-2.5-Flash across key reasoning benchmarks, with near-equal inference costs. We find that agent diversity and quality are crucial and can be enhanced by using LLMs to auto-optimize agent designs. Furthermore, TUMIX can halt refinement upon reaching sufficient confidence, preserving performance at only 49% of the inference cost. Further scaling can achieve higher performance, albeit at a greater cost."},{"descriptionType":"Other","description":"27 pages, 13 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01279","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:11Z","registered":"2025-10-03T01:45:12Z","published":null,"updated":"2025-10-03T01:45:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01276","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01276","identifiers":[{"identifier":"2510.01276","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sumaiya","familyName":"Tabassum","name":"Tabassum, Sumaiya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM Based Sentiment Classification From Bangladesh E-Commerce Reviews"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T16:46:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sentiment analysis is an essential part of text analysis, which is a larger field that includes determining and evaluating the author's emotional state. This method is essential since it makes it easier to comprehend consumers' feelings, viewpoints, and preferences holistically. The introduction of large language models (LLMs), such as Llama, has greatly increased the availability of cutting-edge model applications, such as sentiment analysis. However, accurate sentiment analysis is hampered by the intricacy of written language and the diversity of languages used in evaluations. The viability of using transformer-based BERT models and other LLMs for sentiment analysis from Bangladesh e commerce reviews is investigated in this paper. A subset of 4000 samples from the original dataset of Bangla and English customer reviews was utilized to fine-tune the model. The fine tuned Llama-3.1-8B model outperformed other fine-tuned models, including Phi-3.5-mini-instruct, Mistral-7B-v0.1, DistilBERT-multilingual, mBERT, and XLM-R-base, with an overall accuracy, precision, recall, and F1 score of 95.5%, 93%, 88%, 90%. The study emphasizes how parameter efficient fine-tuning methods (LoRA and PEFT) can lower computational overhead and make it appropriate for contexts with limited resources. The results show how LLMs can"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01276","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:07Z","registered":"2025-10-03T01:45:08Z","published":null,"updated":"2025-10-03T01:45:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01274","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01274","identifiers":[{"identifier":"2510.01274","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shenxu","familyName":"Chang","name":"Chang, Shenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junchi","familyName":"Yu","name":"Yu, Junchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weixing","familyName":"Wang","name":"Wang, Weixing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqiang","familyName":"Chen","name":"Chen, Yongqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Yu","name":"Yu, Jialin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Torr","name":"Torr, Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jindong","familyName":"Gu","name":"Gu, Jindong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TraceDet: Hallucination Detection from the Decoding Trace of Diffusion Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-30T02:01:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:02:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion large language models (D-LLMs) have recently emerged as a promising alternative to auto-regressive LLMs (AR-LLMs). However, the hallucination problem in D-LLMs remains underexplored, limiting their reliability in real-world applications. Existing hallucination detection methods are designed for AR-LLMs and rely on signals from single-step generation, making them ill-suited for D-LLMs where hallucination signals often emerge throughout the multi-step denoising process. To bridge this gap, we propose TraceDet, a novel framework that explicitly leverages the intermediate denoising steps of D-LLMs for hallucination detection. TraceDet models the denoising process as an action trace, with each action defined as the model's prediction over the cleaned response, conditioned on the previous intermediate output. By identifying the sub-trace that is maximally informative to the hallucinated responses, TraceDet leverages the key hallucination signals in the multi-step denoising process of D-LLMs for hallucination detection. Extensive experiments on various open source D-LLMs demonstrate that TraceDet consistently improves hallucination detection, achieving an average gain in AUROC of 15.2% compared to baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01274","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:04Z","registered":"2025-10-03T01:45:05Z","published":null,"updated":"2025-10-03T01:45:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01272","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01272","identifiers":[{"identifier":"2510.01272","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kunal","familyName":"Jha","name":"Jha, Kunal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aydan Yuenan","familyName":"Huang","name":"Huang, Aydan Yuenan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Ye","name":"Ye, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Natasha","familyName":"Jaques","name":"Jaques, Natasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Kleiman-Weiner","name":"Kleiman-Weiner, Max","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling Others' Minds as Code"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T22:56:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate prediction of human behavior is essential for robust and safe human-AI collaboration. However, existing approaches for modeling people are often data-hungry and brittle because they either make unrealistic assumptions about rationality or are too computationally demanding to adapt rapidly. Our key insight is that many everyday social interactions may follow predictable patterns; efficient \"scripts\" that minimize cognitive load for actors and observers, e.g., \"wait for the green light, then go.\" We propose modeling these routines as behavioral programs instantiated in computer code rather than policies conditioned on beliefs and desires. We introduce ROTE, a novel algorithm that leverages both large language models (LLMs) for synthesizing a hypothesis space of behavioral programs, and probabilistic inference for reasoning about uncertainty over that space. We test ROTE in a suite of gridworld tasks and a large-scale embodied household simulator. ROTE predicts human and AI behaviors from sparse observations, outperforming competitive baselines -- including behavior cloning and LLM-based methods -- by as much as 50% in terms of in-sample accuracy and out-of-sample generalization. By treating action understanding as a program synthesis problem, ROTE opens a path for AI systems to efficiently and effectively predict human behavior in the real-world."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01272","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:45:01Z","registered":"2025-10-03T01:45:02Z","published":null,"updated":"2025-10-03T01:45:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01270","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01270","identifiers":[{"identifier":"2510.01270","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hoang","familyName":"Phan","name":"Phan, Hoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Li","name":"Li, Victor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Lei","name":"Lei, Qi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Think Twice, Generate Once: Safeguarding by Progressive Self-Reflection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-29T12:54:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have revolutionized natural language processing with their ability to generate coherent and contextually relevant text. However, their deployment raises significant concerns about the potential for generating harmful or inappropriate content. In this paper, we introduce Progressive Self-Reflection (PSR), a novel inference-time technique that empowers LLMs to self-monitor and correct their outputs dynamically. Experimental results demonstrate that applying our proposed method to Llama-3.1-8B-Instruct reduces the attack success rate from 77.5\\% to 5.9\\%, to Llama-3.1-8B base from 89.7\\% to 5.6\\%, and to Qwen2.5-7B-Instruct from 44.4\\% to 3.8\\%, without additional training, while maintaining their original performance on benign tasks. Our approach acts as a test-time scaling method, where additional self-reflection rounds enhance safety at the cost of inference overhead. To balance safety with computational efficiency, we introduce a lightweight self-reflection predictor that estimates the optimal number of reflection rounds based on input complexity. This adaptive mechanism prevents unnecessary self-assessment on benign inputs while ensuring thorough evaluation when encountering potentially harmful content. Our findings suggest that Progressive Self-Reflection serves as a scalable test-time approach, enhancing LLM safety by dynamically allocating computational resources in proportion to the input's risk profile."},{"descriptionType":"Other","description":"Accepted to EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01270","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:58Z","registered":"2025-10-03T01:44:59Z","published":null,"updated":"2025-10-03T01:44:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01263","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01263","identifiers":[{"identifier":"2510.01263","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yaron","familyName":"Meirovitch","name":"Meirovitch, Yaron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuming","familyName":"Yang","name":"Yang, Fuming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff","familyName":"Lichtman","name":"Lichtman, Jeff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nir","familyName":"Shavit","name":"Shavit, Nir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Budgeted Broadcast: An Activity-Dependent Pruning Rule for Neural Network Efficiency"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-26T02:28:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Most pruning methods remove parameters ranked by impact on loss (e.g., magnitude or gradient). We propose Budgeted Broadcast (BB), which gives each unit a local traffic budget (the product of its long-term on-rate $a_i$ and fan-out $k_i$). A constrained-entropy analysis shows that maximizing coding entropy under a global traffic budget yields a selectivity-audience balance, $\\log\\frac{1-a_i}{a_i}=βk_i$. BB enforces this balance with simple local actuators that prune either fan-in (to lower activity) or fan-out (to reduce broadcast). In practice, BB increases coding entropy and decorrelation and improves accuracy at matched sparsity across Transformers for ASR, ResNets for face identification, and 3D U-Nets for synapse prediction, sometimes exceeding dense baselines. On electron microscopy images, it attains state-of-the-art F1 and PR-AUC under our evaluation protocol. BB is easy to integrate and suggests a path toward learning more diverse and efficient representations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01263","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:48Z","registered":"2025-10-03T01:44:48Z","published":null,"updated":"2025-10-03T01:44:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01257","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01257","identifiers":[{"identifier":"2510.01257","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Can","familyName":"Lin","name":"Lin, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengwang","familyName":"Jiang","name":"Jiang, Zhengwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Zheng","name":"Zheng, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhao","name":"Zhao, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Zhang","name":"Zhang, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Song","name":"Song, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wangqiu","familyName":"Zhou","name":"Zhou, Wangqiu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RJE: A Retrieval-Judgment-Exploration Framework for Efficient Knowledge Graph Question Answering with LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-25T03:56:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Knowledge graph question answering (KGQA) aims to answer natural language questions using knowledge graphs. Recent research leverages large language models (LLMs) to enhance KGQA reasoning, but faces limitations: retrieval-based methods are constrained by the quality of retrieved information, while agent-based methods rely heavily on proprietary LLMs. To address these limitations, we propose Retrieval-Judgment-Exploration (RJE), a framework that retrieves refined reasoning paths, evaluates their sufficiency, and conditionally explores additional evidence. Moreover, RJE introduces specialized auxiliary modules enabling small-sized LLMs to perform effectively: Reasoning Path Ranking, Question Decomposition, and Retriever-assisted Exploration. Experiments show that our approach with proprietary LLMs (such as GPT-4o-mini) outperforms existing baselines while enabling small open-source LLMs (such as 3B and 8B parameters) to achieve competitive results without fine-tuning LLMs. Additionally, RJE substantially reduces the number of LLM calls and token usage compared to agent-based methods, yielding significant efficiency improvements."},{"descriptionType":"Other","description":"18 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01257","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:39Z","registered":"2025-10-03T01:44:40Z","published":null,"updated":"2025-10-03T01:44:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01256","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01256","identifiers":[{"identifier":"2510.01256","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lingling","familyName":"Zeng","name":"Zeng, Lingling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gen","familyName":"Zhang","name":"Zhang, Gen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Peng","name":"Peng, Jialin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Xu","name":"Xu, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Xu","name":"Xu, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijun","familyName":"Ma","name":"Ma, Lijun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kant: An Efficient Unified Scheduling System for Large-Scale AI Clusters"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.7; C.2.4; C.1.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-25T02:25:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As AI cluster sizes continue to expand and the demand for large-language-model (LLM) training and inference workloads grows rapidly, traditional scheduling systems face significant challenges in balancing resource utilization, scheduling efficiency, and service quality. This paper presents and evaluates Kant: an efficient unified scheduling platform designed for large-scale AI container clusters, supporting the co-scheduling of both training and inference jobs. Based on the practical implementation of the Kant system, we systematically define a set of key evaluation metrics for AI clusters, including GPU Allocation Ratio (GAR), Scheduling Occupancy Rate (SOR), GPU Node Fragmentation Ratio (GFR), Job Waiting Time Distribution (JWTD), and Job Training Time Estimation Distribution (JTTED), providing a foundation for quantitative performance analysis. Experimental results demonstrate that Kant achieves exceptional performance in clusters ranging from hundreds to tens of thousands of GPUs. By leveraging scheduling strategies such as Backfill and Enhanced Binpack (E-Binpack), the system significantly improves resource utilization and scheduling efficiency, while effectively reducing resource fragmentation and communication overhead in distributed training. The system has been deployed in multiple AI data center clusters, where it stably supports large-scale intelligent computing workloads. This work provides a practical engineering approach for building high-performance, highly available, AI-native scheduling infrastructure."},{"descriptionType":"Other","description":"25 pages,15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01256","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:38Z","registered":"2025-10-03T01:44:38Z","published":null,"updated":"2025-10-03T01:44:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01255","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01255","identifiers":[{"identifier":"2510.01255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunlang","familyName":"Dai","name":"Dai, Yunlang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emma","familyName":"Lurie","name":"Lurie, Emma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danaé","familyName":"Metaxa","name":"Metaxa, Danaé","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sorelle A.","familyName":"Friedler","name":"Friedler, Sorelle A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Longitudinal Monitoring of LLM Content Moderation of Social Issues"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T21:06:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models' (LLMs') outputs are shaped by opaque and frequently-changing company content moderation policies and practices. LLM moderation often takes the form of refusal; models' refusal to produce text about certain topics both reflects company policy and subtly shapes public discourse. We introduce AI Watchman, a longitudinal auditing system to publicly measure and track LLM refusals over time, to provide transparency into an important and black-box aspect of LLMs. Using a dataset of over 400 social issues, we audit Open AI's moderation endpoint, GPT-4.1, and GPT-5, and DeepSeek (both in English and Chinese). We find evidence that changes in company policies, even those not publicly announced, can be detected by AI Watchman, and identify company- and model-specific differences in content moderation. We also qualitatively analyze and categorize different forms of refusal. This work contributes evidence for the value of longitudinal auditing of LLMs, and AI Watchman, one system for doing so."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01255","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:36Z","registered":"2025-10-03T01:44:37Z","published":null,"updated":"2025-10-03T01:44:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01253","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01253","identifiers":[{"identifier":"2510.01253","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianzhang","familyName":"Zhang","name":"Zhang, Jianzhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Zhou","name":"Zhou, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuang","familyName":"Liu","name":"Liu, Chuang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OR-Toolformer: Modeling and Solving Operations Research Problems with Tool Augmented Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T14:42:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) demonstrate strong mathematical reasoning, but reliance on closed-source APIs for OR tasks raises privacy concerns, and training open-source models from scratch incurs high compute costs. We introduce OR-Toolformer, which fine-tunes Llama-3.1-8B-Instruct with a semi-automatic data synthesis pipeline that generates diverse OR problem-answer pairs and augments the model with external solvers to produce API calls. On three of four standard benchmarks, OR-Toolformer achieves up to 80.1% execution accuracy, exceeding size-matched baselines by over 4.3%. In zero-shot evaluation on two unseen OR problem types, it attains 54% average accuracy, a 21 percentage-point improvement over the strongest baseline. These findings validate the efficacy of tool-augmented fine-tuning LLMs for accurate and generalizable OR problem modeling and solving."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01253","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:33Z","registered":"2025-10-03T01:44:33Z","published":null,"updated":"2025-10-03T01:44:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01251","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01251","identifiers":[{"identifier":"2510.01251","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Carlo","familyName":"Bono","name":"Bono, Carlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Belotti","name":"Belotti, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Palmonari","name":"Palmonari, Matteo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Uncertainty Estimation for LLM-based Entity Linking in Tabular Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T10:44:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Linking textual values in tabular data to their corresponding entities in a Knowledge Base is a core task across a variety of data integration and enrichment applications. Although Large Language Models (LLMs) have shown State-of-The-Art performance in Entity Linking (EL) tasks, their deployment in real-world scenarios requires not only accurate predictions but also reliable uncertainty estimates, which require resource-demanding multi-shot inference, posing serious limits to their actual applicability. As a more efficient alternative, we investigate a self-supervised approach for estimating uncertainty from single-shot LLM outputs using token-level features, reducing the need for multiple generations. Evaluation is performed on an EL task on tabular data across multiple LLMs, showing that the resulting uncertainty estimates are highly effective in detecting low-accuracy outputs. This is achieved at a fraction of the computational cost, ultimately supporting a cost-effective integration of uncertainty measures into LLM-based EL workflows. The method offers a practical way to incorporate uncertainty estimation into EL workflows with limited computational overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01251","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:30Z","registered":"2025-10-03T01:44:31Z","published":null,"updated":"2025-10-03T01:44:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01249","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01249","identifiers":[{"identifier":"2510.01249","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"You-Le","familyName":"Fang","name":"Fang, You-Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong-Shan","familyName":"Jian","name":"Jian, Dong-Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ce","familyName":"Meng","name":"Meng, Ce","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling-Shi","familyName":"Meng","name":"Meng, Ling-Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen-Xu","familyName":"Yan","name":"Yan, Chen-Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi-Zhang","familyName":"Bian","name":"Bian, Zhi-Zhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan-Qing","familyName":"Ma","name":"Ma, Yan-Qing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LOCA: Logical Chain Augmentation for Scientific Corpus Cleaning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T10:04:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While Large Language Models (LLMs) excel in general domains, their reliability often falls short in scientific problem-solving. The advancement of scientific AI depends on large-scale, high-quality corpora. However, existing scientific question-answering (QA) datasets suffer from high error rates, frequently resulting from logical leaps and implicit reasoning within the answers. To address this issue, we introduce LOCA (Logical Chain Augmentation), a novel framework for automatically cleaning scientific corpora, implemented through an augment-and-review loop. At its core, LOCA enhances raw answers by completing missing logical steps and explicitly separating the underlying scientific principle from its subsequent derivation. By applying LOCA to challenging scientific corpora, we demonstrate that it can automatically filter noisy datasets, typically reducing the error rate from as high as 20\\% to below 2\\%. LOCA provides a scalable and effective methodology for creating high-quality scientific corpora, paving the way for more reliable training and evaluation of scientific AI."},{"descriptionType":"Other","description":"29 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01249","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:27Z","registered":"2025-10-03T01:44:28Z","published":null,"updated":"2025-10-03T01:44:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01248","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01248","identifiers":[{"identifier":"2510.01248","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruyue","familyName":"Liu","name":"Liu, Ruyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Yin","name":"Yin, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangzhen","familyName":"Bo","name":"Bo, Xiangzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoshuai","familyName":"Hao","name":"Hao, Xiaoshuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Liu","name":"Liu, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinwen","familyName":"Zhong","name":"Zhong, Jinwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Can","familyName":"Ma","name":"Ma, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiping","familyName":"Wang","name":"Wang, Weiping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SSTAG: Structure-Aware Self-Supervised Learning Method for Text-Attributed Graphs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T09:10:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large scale pretrained models have revolutionized Natural Language Processing (NLP) and Computer Vision (CV), showcasing remarkable cross domain generalization abilities. However, in graph learning, models are typically trained on individual graph datasets, limiting their capacity to transfer knowledge across different graphs and tasks. This approach also heavily relies on large volumes of annotated data, which presents a significant challenge in resource-constrained settings. Unlike NLP and CV, graph structured data presents unique challenges due to its inherent heterogeneity, including domain specific feature spaces and structural diversity across various applications. To address these challenges, we propose a novel structure aware self supervised learning method for Text Attributed Graphs (SSTAG). By leveraging text as a unified representation medium for graph learning, SSTAG bridges the gap between the semantic reasoning of Large Language Models (LLMs) and the structural modeling capabilities of Graph Neural Networks (GNNs). Our approach introduces a dual knowledge distillation framework that co-distills both LLMs and GNNs into structure-aware multilayer perceptrons (MLPs), enhancing the scalability of large-scale TAGs. Additionally, we introduce an in-memory mechanism that stores typical graph representations, aligning them with memory anchors in an in-memory repository to integrate invariant knowledge, thereby improving the model's generalization ability. Extensive experiments demonstrate that SSTAG outperforms state-of-the-art models on cross-domain transfer learning tasks, achieves exceptional scalability, and reduces inference costs while maintaining competitive performance."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01248","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:26Z","registered":"2025-10-03T01:44:26Z","published":null,"updated":"2025-10-03T01:44:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01247","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01247","identifiers":[{"identifier":"2510.01247","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Punit Kumar","familyName":"Singh","name":"Singh, Punit Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nishant","familyName":"Kumar","name":"Kumar, Nishant","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akash","familyName":"Ghosh","name":"Ghosh, Akash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kunal","familyName":"Pasad","name":"Pasad, Kunal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khushi","familyName":"Soni","name":"Soni, Khushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manisha","familyName":"Jaishwal","name":"Jaishwal, Manisha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sriparna","familyName":"Saha","name":"Saha, Sriparna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syukron Abu Ishaq","familyName":"Alfarozi","name":"Alfarozi, Syukron Abu Ishaq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asres Temam","familyName":"Abagissa","name":"Abagissa, Asres Temam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kitsuchart","familyName":"Pasupa","name":"Pasupa, Kitsuchart","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiqin","familyName":"Yang","name":"Yang, Haiqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose G","familyName":"Moreno","name":"Moreno, Jose G","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Let's Play Across Cultures: A Large Multilingual, Multicultural Benchmark for Assessing Language Models' Understanding of Sports"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T09:06:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language Models (LMs) are primarily evaluated on globally popular sports, often overlooking regional and indigenous sporting traditions. To address this gap, we introduce \\textbf{\\textit{CultSportQA}}, a benchmark designed to assess LMs' understanding of traditional sports across 60 countries and 6 continents, encompassing four distinct cultural categories. The dataset features 33,000 multiple-choice questions (MCQs) across text and image modalities, each of which is categorized into three key types: history-based, rule-based, and scenario-based. To evaluate model performance, we employ zero-shot, few-shot, and chain-of-thought (CoT) prompting across a diverse set of Large Language Models (LLMs), Small Language Models (SLMs), and Multimodal Large Language Models (MLMs). By providing a comprehensive multilingual and multicultural sports benchmark, \\textbf{\\textit{CultSportQA}} establishes a new standard for assessing AI's ability to understand and reason about traditional sports."},{"descriptionType":"Other","description":"52 pages, 56 figures; appearing at EMNLP'25"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01247","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:24Z","registered":"2025-10-03T01:44:25Z","published":null,"updated":"2025-10-03T01:44:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01246","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01246","identifiers":[{"identifier":"2510.01246","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqing","familyName":"Xie","name":"Xie, Jiaqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Comparative Analysis of Sparse Autoencoder and Activation Difference in Language Model Steering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T08:31:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sparse autoencoders (SAEs) have recently emerged as a powerful tool for language model steering. Prior work has explored top-k SAE latents for steering, but we observe that many dimensions among the top-k latents capture non-semantic features such as punctuation rather than semantic attributes like instructions. To address this, we propose focusing on a single, most relevant SAE latent (top-1), eliminating redundant features. We further identify a limitation in constant SAE steering, which often produces degenerate outputs such as repetitive single words. To mitigate this, we introduce a token-wise decaying steering strategy, enabling more faithful comparisons with mean activation difference baselines. Empirically, we show that steering an SAE latent associated with reasoning reliably elicits step-by-step mathematical reasoning and enhances inference quality, functionally resembling the effect of appending a guiding token. Our results demonstrate that SAEs outperform mean activation difference methods on mathematical reasoning benchmarks and match their performance on IF-Eval."},{"descriptionType":"Other","description":"25 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01246","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:23Z","registered":"2025-10-03T01:44:24Z","published":null,"updated":"2025-10-03T01:44:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01245","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01245","identifiers":[{"identifier":"2510.01245","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runfei","familyName":"Chen","name":"Chen, Runfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuyang","familyName":"Jiang","name":"Jiang, Shuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Huang","name":"Huang, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SeMob: Semantic Synthesis for Dynamic Urban Mobility Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T05:33:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Human mobility prediction is vital for urban services, but often fails to account for abrupt changes from external events. Existing spatiotemporal models struggle to leverage textual descriptions detailing these events. We propose SeMob, an LLM-powered semantic synthesis pipeline for dynamic mobility prediction. Specifically, SeMob employs a multi-agent framework where LLM-based agents automatically extract and reason about spatiotemporally related text from complex online texts. Fine-grained relevant contexts are then incorporated with spatiotemporal data through our proposed innovative progressive fusion architecture. The rich pre-trained event prior contributes enriched insights about event-driven prediction, and hence results in a more aligned forecasting model. Evaluated on a dataset constructed through our pipeline, SeMob achieves maximal reductions of 13.92% in MAE and 11.12% in RMSE compared to the spatiotemporal model. Notably, the framework exhibits pronounced superiority especially within spatiotemporal regions close to an event's location and time of occurrence."},{"descriptionType":"Other","description":"EMNLP2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01245","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:21Z","registered":"2025-10-03T01:44:22Z","published":null,"updated":"2025-10-03T01:44:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01244","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01244","identifiers":[{"identifier":"2510.01244","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeoneui","familyName":"Kim","name":"Kim, Hyeoneui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeongha","familyName":"Kim","name":"Kim, Jeongha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huijing","familyName":"Xu","name":"Xu, Huijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsun","familyName":"Jung","name":"Jung, Jinsun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunghoon","familyName":"Kang","name":"Kang, Sunghoon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sun Joo","familyName":"Jang","name":"Jang, Sun Joo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Feasibility of Structuring Stress Documentation Using an Ontology-Guided Large Language Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T04:10:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Stress, arising from the dynamic interaction between external stressors, individual appraisals, and physiological or psychological responses, significantly impacts health yet is often underreported and inconsistently documented, typically captured as unstructured free-text in electronic health records. Ambient AI technologies offer promise in reducing documentation burden, but predominantly generate unstructured narratives, limiting downstream clinical utility.\n This study aimed to develop an ontology for mental stress and evaluate the feasibility of using a Large Language Model (LLM) to extract ontology-guided stress-related information from narrative text. The Mental Stress Ontology (MeSO) was developed by integrating theoretical models like the Transactional Model of Stress with concepts from 11 validated stress assessment tools. MeSO's structure and content were refined using Ontology Pitfall Scanner! and expert validation.\n Using MeSO, six categories of stress-related information--stressor, stress response, coping strategy, duration, onset, and temporal profile--were extracted from 35 Reddit posts using Claude Sonnet 4. Human reviewers evaluated accuracy and ontology coverage. The final ontology included 181 concepts across eight top-level classes. Of 220 extractable stress-related items, the LLM correctly identified 172 (78.2%), misclassified 27 (12.3%), and missed 21 (9.5%). All correctly extracted items were accurately mapped to MeSO, although 24 relevant concepts were not yet represented in the ontology.\n This study demonstrates the feasibility of using an ontology-guided LLM for structured extraction of stress-related information, offering potential to enhance the consistency and utility of stress documentation in ambient AI systems. Future work should involve clinical dialogue data and comparison across LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01244","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:20Z","registered":"2025-10-03T01:44:21Z","published":null,"updated":"2025-10-03T01:44:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01243","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01243","identifiers":[{"identifier":"2510.01243","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yisong","familyName":"Xiao","name":"Xiao, Yisong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aishan","familyName":"Liu","name":"Liu, Aishan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Liang","name":"Liang, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zonghao","familyName":"Ying","name":"Ying, Zonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianglong","familyName":"Liu","name":"Liu, Xianglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dacheng","familyName":"Tao","name":"Tao, Dacheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detoxifying Large Language Models via Autoregressive Reward Guided Representation Editing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T03:40:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have demonstrated impressive performance across various tasks, yet they remain vulnerable to generating toxic content, necessitating detoxification strategies to ensure safe and responsible deployment. Test-time detoxification methods, which typically introduce static or dynamic interventions into LLM representations, offer a promising solution due to their flexibility and minimal invasiveness. However, current approaches often suffer from imprecise interventions, primarily due to their insufficient exploration of the transition space between toxic and non-toxic outputs. To address this challenge, we propose \\textsc{A}utoregressive \\textsc{R}eward \\textsc{G}uided \\textsc{R}epresentation \\textsc{E}diting (ARGRE), a novel test-time detoxification framework that explicitly models toxicity transitions within the latent representation space, enabling stable and precise reward-guided editing. ARGRE identifies non-toxic semantic directions and interpolates between toxic and non-toxic representations to reveal fine-grained transition trajectories. These trajectories transform sparse toxicity annotations into dense training signals, enabling the construction of an autoregressive reward model that delivers stable and precise editing guidance. At inference, the reward model guides an adaptive two-step editing process to obtain detoxified representations: it first performs directional steering based on expected reward gaps to shift representations toward non-toxic regions, followed by lightweight gradient-based refinements. Extensive experiments across 8 widely used LLMs show that ARGRE significantly outperforms leading baselines in effectiveness (-62.21% toxicity) and efficiency (-47.58% inference time), while preserving the core capabilities of the original model with minimal degradation. Our code is available at the website."},{"descriptionType":"Other","description":"Accepted to NeurIPS 25"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01243","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:18Z","registered":"2025-10-03T01:44:19Z","published":null,"updated":"2025-10-03T01:44:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01241","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01241","identifiers":[{"identifier":"2510.01241","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hu","familyName":"Wei","name":"Wei, Hu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ze","familyName":"Xu","name":"Xu, Ze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyu","familyName":"Yang","name":"Yang, Boyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linlin","familyName":"Miao","name":"Miao, Linlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiqi","familyName":"Zhai","name":"Zhai, Weiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihan","familyName":"Li","name":"Li, Yihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Li","name":"Li, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijun","familyName":"Wang","name":"Wang, Zhijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boya","familyName":"Wang","name":"Wang, Boya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Yu","name":"Yu, Jianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialing","familyName":"Yuan","name":"Yuan, Jialing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyue","familyName":"Zhang","name":"Zhang, Xiaoyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"He","name":"He, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minglei","familyName":"Chen","name":"Chen, Minglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zifan","familyName":"Zhang","name":"Zhang, Zifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianhui","familyName":"Li","name":"Li, Qianhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Xu","name":"Xu, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SKYLENAGE Technical Report: Mathematical Reasoning and Contest-Innovation Benchmarks for Multi-Level Math Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T02:09:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) now perform strongly on many public math suites, yet frontier separation within mathematics increasingly suffers from ceiling effects. We present two complementary benchmarks: SKYLENAGE-ReasoningMATH, a 100-item, structure-aware diagnostic set with per-item metadata on length, numeric density, and symbolic complexity; and SKYLENAGE-MATH, a 150-item contest-style suite spanning four stages from high school to doctoral under a seven-subject taxonomy. We evaluate fifteen contemporary LLM variants under a single setup and analyze subject x model and grade x model performance. On the contest suite, the strongest model reaches 44% while the runner-up reaches 37%; accuracy declines from high school to doctoral, and top systems exhibit a doctoral-to-high-school retention near 79%. On the reasoning set, the best model attains 81% overall, and hardest-slice results reveal clear robustness gaps between leaders and the mid-tier. In summary, we release SKYLENAGE-ReasoningMATH and report aggregate results for SKYLENAGE-MATH; together, SKYLENAGE provides a hard, reasoning-centered and broadly covering math benchmark with calibrated difficulty and rich metadata, serving as a reference benchmark for future evaluations of mathematical reasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01241","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:15Z","registered":"2025-10-03T01:44:16Z","published":null,"updated":"2025-10-03T01:44:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01240","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01240","identifiers":[{"identifier":"2510.01240","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zukang","familyName":"Xu","name":"Xu, Zukang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Hu","name":"Hu, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Wu","name":"Wu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Yang","name":"Yang, Dawei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RSAVQ: Riemannian Sensitivity-Aware Vector Quantization for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T01:40:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated remarkable performance across a wide range of natural language processing tasks. However, their exponentially increasing parameters pose significant challenges for deployment on resource-constrained devices. Vector Quantization (VQ) shows great promise for low-bit quantization (e.g., 2 to 4 bits), but existing work faces two key challenges: unconstrained direction error and suboptimal bit allocation. In this paper, we propose RSAVQ, a novel VQ framework to enhance extremely low-bit quantization for LLMs. RSAVQ introduces two geometry-driven innovations that effectively mitigate above limitations: (1) Error Direction Sensitivity Guidance (EDSG), which leverages the Fisher Information Matrix (FIM)-induced Riemannian metric to project quantization errors onto low-sensitivity directions in the parameter space. Specifically, this projection is performed along the negative natural gradient direction, which effectively suppresses error expansion. (2) Weight Channel Sensitivity Guidance (WCSG) , which constructs a channel-wise sensitivity metric via FIM curvature analysis to dynamically guide bit resource allocation. The approach facilitates a globally optimal quantization solution within prescribed bit constraints. Experiments demonstrate that RSAVQ outperforms existing methods for LLMs. For example, in 2-bit quantization of LLaMA-3 8B, RSAVQ leads baselines like VPTQ and QuIP# by 0.4 in perplexity (PPL) and 1.5 in zero-shot accuracy. This work offers a practical solution for constrained environments and a theoretical bridge between information geometry and the quantization of neural networks, advancing efficient deep learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01240","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:14Z","registered":"2025-10-03T01:44:15Z","published":null,"updated":"2025-10-03T01:44:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01239","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01239","identifiers":[{"identifier":"2510.01239","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juntae","familyName":"Lee","name":"Lee, Juntae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihwan","familyName":"Bang","name":"Bang, Jihwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seunghan","familyName":"Yang","name":"Yang, Seunghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simyung","familyName":"Chang","name":"Chang, Simyung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CIFLEX: Contextual Instruction Flow for Sub-task Execution in Multi-Turn Interactions with a Single On-Device LLM"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-24T01:20:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present CIFLEX (Contextual Instruction Flow for Sub-task Execution), which is a novel execution system for efficient sub-task handling in multi-turn interactions with a single on-device large language model (LLM). As LLMs become increasingly capable, a single model is expected to handle diverse sub-tasks that more effectively and comprehensively support answering user requests. Naive approach reprocesses the entire conversation context when switching between main and sub-tasks (e.g., query rewriting, summarization), incurring significant computational overhead. CIFLEX mitigates this overhead by reusing the key-value (KV) cache from the main task and injecting only task-specific instructions into isolated side paths. After sub-task execution, the model rolls back to the main path via cached context, thereby avoiding redundant prefill computation. To support sub-task selection, we also develop a hierarchical classification strategy tailored for small-scale models, decomposing multi-choice decisions into binary ones. Experiments show that CIFLEX significantly reduces computational costs without degrading task performance, enabling scalable and efficient multi-task dialogue on-device."},{"descriptionType":"Other","description":"accepted at EMNLP 2025 (main)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01239","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:13Z","registered":"2025-10-03T01:44:13Z","published":null,"updated":"2025-10-03T01:44:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01237","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01237","identifiers":[{"identifier":"2510.01237","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nandakishor","familyName":"M","name":"M, Nandakishor","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Confidence-Aware Routing for Large Language Model Reliability Enhancement: A Multi-Signal Approach to Pre-Generation Hallucination Mitigation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T18:34:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models suffer from hallucination, generating plausible yet factually incorrect content. Current mitigation strategies focus on post-generation correction, which is computationally expensive and fails to prevent unreliable content generation. We propose a confidence-aware routing system that proactively assesses model uncertainty before generation and redirects queries based on estimated reliability. Our approach combines three complementary signals: semantic alignment between internal representations and reference embeddings, internal convergence analysis across model layers, and learned confidence estimation. The unified confidence score determines routing to four pathways: local generation for high confidence, retrieval-augmented generation for medium confidence, larger models for low confidence, and human review for very low confidence. Evaluation on knowledge-intensive QA benchmarks demonstrates significant improvements in hallucination detection (0.74 vs. 0.42 baseline) while reducing computational costs by 40% compared to post-hoc methods. The F1 score improves from 0.61 to 0.82 with low false positive rates (0.09). This paradigm shift from reactive correction to proactive assessment offers a computationally efficient approach to LLM reliability enhancement."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01237","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:10Z","registered":"2025-10-03T01:44:10Z","published":null,"updated":"2025-10-03T01:44:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01236","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01236","identifiers":[{"identifier":"2510.01236","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ismam Nur","familyName":"Swapnil","name":"Swapnil, Ismam Nur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aranya","familyName":"Saha","name":"Saha, Aranya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tanvir Ahmed","familyName":"Khan","name":"Khan, Tanvir Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Ariful","familyName":"Haque","name":"Haque, Mohammad Ariful","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GRPO++: Enhancing Dermatological Reasoning under Low Resource Settings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T18:32:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) show promise in medical image analysis, yet their capacity for structured reasoning in complex domains like dermatology is often limited by data scarcity and the high computational cost of advanced training techniques. To address these challenges, we introduce DermIQ-VLM, a VLM developed through a multi-stage, resource-efficient methodology designed to emulate a dermatologist's diagnostic process. Our primary contribution is a modified version of Grouped Relative Policy Optimization (GRPO), called GRPO++, which stabilizes the powerful but data-intensive GRPO framework. Our proposed training pipeline first employs GRPO++ for reasoning-oriented disease recognition, followed by supervised fine-tuning for conversational ability. To mitigate factual errors introduced during this step, we then align the model using Direct Preference Optimization (DPO), leveraging a Knowledge Graph-based system as a scalable proxy for expert preference. A preliminary evaluation on a curated dermatological dataset demonstrates that our proposed methodology yields notable performance gains over standard fine-tuning approaches. These findings validate the potential of our pipeline as a feasible pathway for developing specialized, reliable VLMs in resource-constrained environments."},{"descriptionType":"Other","description":"Will be submitted at IEEE JBHI"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01236","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:08Z","registered":"2025-10-03T01:44:09Z","published":null,"updated":"2025-10-03T01:44:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01234","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01234","identifiers":[{"identifier":"2510.01234","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shubham","familyName":"Agrawal","name":"Agrawal, Shubham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prasang","familyName":"Gupta","name":"Gupta, Prasang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMRank: Understanding LLM Strengths for Model Routing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T18:11:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid growth of large language models (LLMs) with diverse capabilities, latency and computational costs presents a critical deployment challenge: selecting the most suitable model for each prompt to optimize the trade-off between performance and efficiency. We introduce LLMRank, a prompt-aware routing framework that leverages rich, human-readable features extracted from prompts, including task type, reasoning patterns, complexity indicators, syntactic cues, and signals from a lightweight proxy solver. Unlike prior one-shot routers that rely solely on latent embeddings, LLMRank predicts per-model utility using a neural ranking model trained on RouterBench, comprising 36,497 prompts spanning 11 benchmarks and 11 state-of-the-art LLMs, from small efficient models to large frontier systems. Our approach achieves up to 89.2% of oracle utility, while providing interpretable feature attributions that explain routing decisions. Extensive studies demonstrate the importance of multifaceted feature extraction and the hybrid ranking objective, highlighting the potential of feature-driven routing for efficient and transparent LLM deployment."},{"descriptionType":"Other","description":"13 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01234","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:06Z","registered":"2025-10-03T01:44:06Z","published":null,"updated":"2025-10-03T01:44:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01232","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01232","identifiers":[{"identifier":"2510.01232","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongjun","familyName":"Kim","name":"Kim, Dongjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gyuho","familyName":"Shim","name":"Shim, Gyuho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongchan","familyName":"Chun","name":"Chun, Yongchan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minhyuk","familyName":"Kim","name":"Kim, Minhyuk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanjun","familyName":"Park","name":"Park, Chanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heuiseok","familyName":"Lim","name":"Lim, Heuiseok","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Benchmark Profiling: Mechanistic Diagnosis of LLM Benchmarks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T15:32:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models are commonly judged by their scores on standard benchmarks, yet such scores often overstate real capability since they mask the mix of skills a task actually demands. For example, ARC is assumed to test reasoning, while HellaSwag is designed to evaluate commonsense. However, we lack a systematic way to verify if these benchmarks actually measure these labels. We introduce Benchmark Profiling, a diagnostic framework that decomposes benchmark performance into ten cognitively grounded abilities. The method combines gradient-based importance scoring with targeted parameter ablation to compute an Ability Impact Score (AIS) that quantifies how much each ability contributes to a model's success on a given benchmark. Profiling three instruction-tuned models across ten widely used benchmarks yields four key findings: (i) most benchmarks draw on several abilities rather than one, (ii) datasets with similar labels rely on distinct ability mixtures, (iii) code-generation benchmarks reward broad, multi-skill improvement and thus show only modest gains from narrow domain-specific fine-tuning, and (iv) abilities irrelevant to the task could negatively affect performance. Benchmark Profiling therefore explains why performance gains do not always translate into user-perceived competence and offers a transparent tool for benchmark audit and model interpretability."},{"descriptionType":"Other","description":"16 pages, 5 figures. Accepted to EMNLP 2025 main conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01232","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:03Z","registered":"2025-10-03T01:44:03Z","published":null,"updated":"2025-10-03T01:44:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01231","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01231","identifiers":[{"identifier":"2510.01231","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuaidong","familyName":"Pan","name":"Pan, Shuaidong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Trustworthy Summarization via Uncertainty Quantification and Risk Awareness in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T15:09:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study addresses the reliability of automatic summarization in high-risk scenarios and proposes a large language model framework that integrates uncertainty quantification and risk-aware mechanisms. Starting from the demands of information overload and high-risk decision-making, a conditional generation-based summarization model is constructed, and Bayesian inference is introduced during generation to model uncertainty in the parameter space, which helps avoid overconfident predictions. The uncertainty level of the generated content is measured using predictive distribution entropy, and a joint optimization of entropy regularization and risk-aware loss is applied to ensure that key information is preserved and risk attributes are explicitly expressed during information compression. On this basis, the model incorporates risk scoring and regulation modules, allowing summaries to cover the core content accurately while enhancing trustworthiness through explicit risk-level prompts. Comparative experiments and sensitivity analyses verify that the proposed method significantly improves the robustness and reliability of summarization in high-risk applications while maintaining fluency and semantic integrity. This research provides a systematic solution for trustworthy summarization and demonstrates both scalability and practical value at the methodological level."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01231","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:44:01Z","registered":"2025-10-03T01:44:02Z","published":null,"updated":"2025-10-03T01:44:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01229","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01229","identifiers":[{"identifier":"2510.01229","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dimitar","familyName":"Peshevski","name":"Peshevski, Dimitar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kiril","familyName":"Blazhevski","name":"Blazhevski, Kiril","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Popovski","name":"Popovski, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gjorgji","familyName":"Madjarov","name":"Madjarov, Gjorgji","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Transformer-Based Rerankers with Synthetic Data and LLM-Based Supervision"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T09:47:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective document reranking is essential for improving search relevance across diverse applications. While Large Language Models (LLMs) excel at reranking due to their deep semantic understanding and reasoning, their high computational cost makes them impractical for many real-world deployments. Fine-tuning smaller, task-specific models is a more efficient alternative but typically depends on scarce, manually labeled data. To overcome this, we propose a novel pipeline that eliminates the need for human-labeled query-document pairs. Our method uses LLMs to generate synthetic queries from domain-specific corpora and employs an LLM-based classifier to label positive and hard-negative pairs. This synthetic dataset is then used to fine-tune a smaller transformer model with contrastive learning using Localized Contrastive Estimation (LCE) loss. Experiments on the MedQuAD dataset show that our approach significantly boosts in-domain performance and generalizes well to out-of-domain tasks. By using LLMs for data generation and supervision rather than inference, we reduce computational costs while maintaining strong reranking capabilities."},{"descriptionType":"Other","description":"Accepted by RANLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01229","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:58Z","registered":"2025-10-03T01:43:59Z","published":null,"updated":"2025-10-03T01:43:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01226","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01226","identifiers":[{"identifier":"2510.01226","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akshith Reddy","familyName":"Putta","name":"Putta, Akshith Reddy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Devasier","name":"Devasier, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengkai","familyName":"Li","name":"Li, Chengkai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ClaimCheck: Real-Time Fact-Checking with Small Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T21:18:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:01:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce ClaimCheck, an LLM-guided automatic fact-checking system designed to verify real-world claims using live Web evidence and small language models. Unlike prior systems that rely on large, closed-source models and static knowledge stores, ClaimCheck employs a transparent, stepwise verification pipeline that mirrors human fact-checking workflows consisting of Web search query planning, Web-based evidence retrieval and summarization, evidence synthesis and re-retrieval, and claim verdict evaluation. Each module is optimized for small LLMs, allowing the system to deliver accurate and interpretable fact-checking with significantly lower computational requirements. Despite using a much smaller Qwen3-4B model, ClaimCheck achieves state-of-the-art accuracy of 76.4% on the AVeriTeC dataset, outperforming previous approaches using LLaMA3.1 70B and GPT-4o. Extensive ablations demonstrate that careful modular design and prompting strategies can overcome the limitations of smaller LLMs. To promote accessibility and transparency, we provide a public demo at https://idir.uta.edu/claimcheck."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01226","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:54Z","registered":"2025-10-03T01:43:54Z","published":null,"updated":"2025-10-03T01:43:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01224","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01224","identifiers":[{"identifier":"2510.01224","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tyler J","familyName":"Poore","name":"Poore, Tyler J","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher J","familyName":"Pinard","name":"Pinard, Christopher J","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aleena","familyName":"Shabbir","name":"Shabbir, Aleena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Lagree","name":"Lagree, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andre","familyName":"Telfer","name":"Telfer, Andre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan-Chuen","familyName":"Wu","name":"Wu, Kuan-Chuen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Context Matters: Comparison of commercial large language tools in veterinary medicine"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T18:52:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly used in clinical settings, yet their performance in veterinary medicine remains underexplored. We evaluated three commercially available veterinary-focused LLM summarization tools (Product 1 [Hachiko] and Products 2 and 3) on a standardized dataset of veterinary oncology records. Using a rubric-guided LLM-as-a-judge framework, summaries were scored across five domains: Factual Accuracy, Completeness, Chronological Order, Clinical Relevance, and Organization. Product 1 achieved the highest overall performance, with a median average score of 4.61 (IQR: 0.73), compared to 2.55 (IQR: 0.78) for Product 2 and 2.45 (IQR: 0.92) for Product 3. It also received perfect median scores in Factual Accuracy and Chronological Order. To assess the internal consistency of the grading framework itself, we repeated the evaluation across three independent runs. The LLM grader demonstrated high reproducibility, with Average Score standard deviations of 0.015 (Product 1), 0.088 (Product 2), and 0.034 (Product 3). These findings highlight the importance of veterinary-specific commercial LLM tools and demonstrate that LLM-as-a-judge evaluation is a scalable and reproducible method for assessing clinical NLP summarization in veterinary medicine."},{"descriptionType":"Other","description":"4 Figures, 10 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01224","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:51Z","registered":"2025-10-03T01:43:51Z","published":null,"updated":"2025-10-03T01:43:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01222","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01222","identifiers":[{"identifier":"2510.01222","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bertrand Kian","familyName":"Hassani","name":"Hassani, Bertrand Kian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yacoub","familyName":"Bahini","name":"Bahini, Yacoub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rizwan","familyName":"Mushtaq","name":"Mushtaq, Rizwan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discourse vs emissions: Analysis of corporate narratives, symbolic practices, and mimicry through LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:26:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Climate change has increased demands for transparent and comparable corporate climate disclosures, yet imitation and symbolic reporting often undermine their value. This paper develops a multidimensional framework to assess disclosure maturity among 828 U.S.listed firms using large language models (LLMs) fine-tuned for climate communication. Four classifiers-sentiment, commitment, specificity, and target ambition-extract narrative indicators from sustainability and annual reports, which are linked to firm attributes such as emissions, market capitalization, and sector. Analyses reveal three insights: (1) risk-focused narratives often align with explicit commitments, but quantitative targets (e.g., net-zero pledges) remain decoupled from tone; (2) larger and higher-emitting firms disclose more commitments and actions than peers, though inconsistently with quantitative targets; and (3) widespread similarity in disclosure styles suggests mimetic behavior, reducing differentiation and decision usefulness. These results highlight the value of LLMs for ESG narrative analysis and the need for stronger regulation to connect commitments with verifiable transition strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01222","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:48Z","registered":"2025-10-03T01:43:48Z","published":null,"updated":"2025-10-03T01:43:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01218","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01218","identifiers":[{"identifier":"2510.01218","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergey","familyName":"Troshin","name":"Troshin, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wafaa","familyName":"Mohammed","name":"Mohammed, Wafaa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Meng","name":"Meng, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christof","familyName":"Monz","name":"Monz, Christof","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antske","familyName":"Fokkens","name":"Fokkens, Antske","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vlad","familyName":"Niculae","name":"Niculae, Vlad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Control the Temperature: Selective Sampling for Diverse and High-Quality LLM Outputs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T15:16:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diversity is an essential metric for evaluating the creativity of outputs generated by language models. Temperature-based sampling is a common strategy to increase diversity. However, for tasks that require high precision, e.g., mathematical reasoning, uncontrolled high temperature sampling, e.g., min-$p$ or top-$p$, degrades reasoning quality. We demonstrate that the loss of accuracy is caused by sampling incorrect continuations in sensitive decoding positions. To address this, in this paper, we propose \\textbf{selective sampling}, a method that dynamically switches between greedy and high-temperature sampling based on a sampling risk metric. This risk metric estimates the likelihood of output errors when applying high-temperature sampling on the current token position. To predict sampling risk, we train a lightweight classifier on a small subset of verifiable problems. The trained classifier can be integrated with the base language model with minimal latency overhead. Experiments on mathematical reasoning tasks demonstrate that selective sampling enhances the quality-diversity trade-off, even in high-temperature settings."},{"descriptionType":"Other","description":"Second Conference on Language Modeling, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01218","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:42Z","registered":"2025-10-03T01:43:43Z","published":null,"updated":"2025-10-03T01:43:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.01203","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.01203","identifiers":[{"identifier":"2510.01203","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lokesh Antony","familyName":"Kadiyala","name":"Kadiyala, Lokesh Antony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Mirzaeinia","name":"Mirzaeinia, Amir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mamba Outpaces Reformer in Stock Prediction with Sentiments from Top Ten LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Statistical Finance (q-fin.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:36:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T00:00:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The stock market is extremely difficult to predict in the short term due to high market volatility, changes caused by news, and the non-linear nature of the financial time series. This research proposes a novel framework for improving minute-level prediction accuracy using semantic sentiment scores from top ten different large language models (LLMs) combined with minute interval intraday stock price data. We systematically constructed a time-aligned dataset of AAPL news articles and 1-minute Apple Inc. (AAPL) stock prices for the dates of April 4 to May 2, 2025. The sentiment analysis was achieved using the DeepSeek-V3, GPT variants, LLaMA, Claude, Gemini, Qwen, and Mistral models through their APIs. Each article obtained sentiment scores from all ten LLMs, which were scaled to a [0, 1] range and combined with prices and technical indicators like RSI, ROC, and Bollinger Band Width. Two state-of-the-art such as Reformer and Mamba were trained separately on the dataset using the sentiment scores produced by each LLM as input. Hyper parameters were optimized by means of Optuna and were evaluated through a 3-day evaluation period. Reformer had mean squared error (MSE) or the evaluation metrics, and it should be noted that Mamba performed not only faster but also better than Reformer for every LLM across the 10 LLMs tested. Mamba performed best with LLaMA 3.3--70B, with the lowest error of 0.137. While Reformer could capture broader trends within the data, the model appeared to over smooth sudden changes by the LLMs. This study highlights the potential of integrating LLM-based semantic analysis paired with efficient temporal modeling to enhance real-time financial forecasting."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.01203","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T01:43:21Z","registered":"2025-10-03T01:43:21Z","published":null,"updated":"2025-10-03T01:43:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":192,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=registered%3A%5B2025-10-02T16%3A00%3A00Z+TO+2025-10-03T15%3A59%3A59Z%5D+AND+%28subjects.subject%3A%22cs.CL%22+OR+subjects.subject%3A%22cs.LG%22%29+AND+%28titles.title%3A%22language+model%22+OR+titles.title%3A%22language+models%22+OR+titles.title%3A%22LLM%22+OR+titles.title%3A%22LLMs%22+OR+titles.title%3A%22transformer%22+OR+titles.title%3A%22transformers%22+OR+titles.title%3A%22foundation+model%22+OR+titles.title%3A%22foundation+models%22+OR+titles.title%3A%22mixture+of+experts%22+OR+titles.title%3A%22MoE%22+OR+titles.title%3A%22linear+attention%22+OR+titles.title%3A%22diffusion+language%22+OR+titles.title%3A%22reasoning+model%22+OR+titles.title%3A%22reasoning+models%22+OR+descriptions.description%3A%22language+model%22+OR+descriptions.description%3A%22language+models%22+OR+descriptions.description%3A%22LLM%22+OR+descriptions.description%3A%22LLMs%22+OR+descriptions.description%3A%22transformer%22+OR+descriptions.description%3A%22transformers%22+OR+descriptions.description%3A%22foundation+model%22+OR+descriptions.description%3A%22foundation+models%22+OR+descriptions.description%3A%22mixture+of+experts%22+OR+descriptions.description%3A%22MoE%22+OR+descriptions.description%3A%22linear+attention%22+OR+descriptions.description%3A%22diffusion+language%22+OR+descriptions.description%3A%22reasoning+model%22+OR+descriptions.description%3A%22reasoning+models%22%29\u0026page%5Bsize%5D=1000\u0026page%5Bnumber%5D=1"}}