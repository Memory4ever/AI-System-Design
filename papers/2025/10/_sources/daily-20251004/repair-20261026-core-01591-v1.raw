<td id="S4.T1.4.1.5.4" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">59.7</td>
<td id="S4.T1.4.1.5.5" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">80.1</td>
<td id="S4.T1.4.1.5.6" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">84.3</td>
<td id="S4.T1.4.1.5.7" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">63.1</td></tr>
<tr id="S4.T1.4.1.6" class="ltx_tr">
<td id="S4.T1.4.1.6.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">   GPT-4o (Full Trace)</td>
<td id="S4.T1.4.1.6.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">47.5</td>
