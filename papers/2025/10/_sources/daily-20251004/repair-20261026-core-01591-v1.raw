<td id="S4.T1.4.1.4.5" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.4.5.1" class="ltx_text ltx_font_bold">81.1</span></td>
<td id="S4.T1.4.1.4.6" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">89.5</td>
