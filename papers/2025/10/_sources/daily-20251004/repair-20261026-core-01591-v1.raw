<td id="S4.T1.4.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.2.2.1" class="ltx_text ltx_font_bold">Accuracy (%)</span></td>
<td id="S4.T1.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.2.3.1" class="ltx_text ltx_font_bold">TPR (%)</span></td>
<td id="S4.T1.4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.2.4.1" class="ltx_text ltx_font_bold">TNR (%)</span></td>
