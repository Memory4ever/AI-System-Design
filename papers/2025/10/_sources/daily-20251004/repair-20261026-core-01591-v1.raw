<td id="S4.T1.4.1.8.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.8.2.1" class="ltx_text ltx_font_bold">85.2</span></td>
