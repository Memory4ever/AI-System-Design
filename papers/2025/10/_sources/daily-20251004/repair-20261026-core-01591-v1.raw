<td id="S4.T1.4.1.6.4" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">48.2</td>
<td id="S4.T1.4.1.6.5" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;">64.3</td>
