<td id="S4.T1.4.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1.25pt;padding-bottom:1.25pt;" colspan="3"><span id="S4.T1.4.1.1.3.1" class="ltx_text ltx_font_bold">Polaris-4B Solutions</span></td></tr>
<tr id="S4.T1.4.1.2" class="ltx_tr">
