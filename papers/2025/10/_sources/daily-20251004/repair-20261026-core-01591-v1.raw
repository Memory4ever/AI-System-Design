<td id="S4.T1.4.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.2.6.1" class="ltx_text ltx_font_bold">TPR (%)</span></td>
<td id="S4.T1.4.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.2.7.1" class="ltx_text ltx_font_bold">TNR (%)</span></td></tr>
<tr id="S4.T1.4.1.3" class="ltx_tr">
<td id="S4.T1.4.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;" colspan="7"><span id="S4.T1.4.1.3.1.1" class="ltx_text ltx_font_italic">Test Set: AIME 2024</span></td></tr>
<tr id="S4.T1.4.1.4" class="ltx_tr">
<td id="S4.T1.4.1.4.1" class="ltx_td ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;">   <span id="S4.T1.4.1.4.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">Clue<span id="S4.T1.4.1.4.1.1.1" class="ltx_text ltx_font_upright"> (Ours)</span></span></td>
<td id="S4.T1.4.1.4.2" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T1.4.1.4.2.1" class="ltx_text ltx_font_bold">80.9</span></td>
