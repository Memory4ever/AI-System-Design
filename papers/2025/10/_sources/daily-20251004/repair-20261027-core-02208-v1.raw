<th id="S3.T1.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:2.3pt 4.0pt;" rowspan="2"><span id="S3.T1.1.6.1.1" class="ltx_text">Inpainting</span></th>
<td id="S3.T1.1.6.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;">Baseline</td>
<td id="S3.T1.1.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;"><span id="S3.T1.1.6.3.1" class="ltx_text ltx_font_bold">22.51</span></td>
<td id="S3.T1.1.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;"><span id="S3.T1.1.6.4.1" class="ltx_text ltx_font_bold">0.830</span></td>
<td id="S3.T1.1.6.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;">4.69</td>
<td id="S3.T1.1.6.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;">39.82</td></tr>
<tr id="S3.T1.1.7" class="ltx_tr">
<td id="S3.T1.1.7.1" class="ltx_td ltx_align_center" style="padding:2.3pt 4.0pt;">Inverse-aDDIM</td>
