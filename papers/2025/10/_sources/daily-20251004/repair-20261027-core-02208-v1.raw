<th id="S3.T1.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:2.3pt 4.0pt;" rowspan="2"><span id="S3.T1.1.2.1.1" class="ltx_text">4<math id="S3.T1.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> Super-resolution</span></th>
<td id="S3.T1.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;">Baseline</td>
<td id="S3.T1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;"><span id="S3.T1.1.2.3.1" class="ltx_text ltx_font_bold">26.03</span></td>
<td id="S3.T1.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;"><span id="S3.T1.1.2.4.1" class="ltx_text ltx_font_bold">0.771</span></td>
<td id="S3.T1.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;">5.67</td>
<td id="S3.T1.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:2.3pt 4.0pt;">40.90</td></tr>
