<td id="S3.T3.2.9.6" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T3.m24" class="ltx_Math" alttext="0.596" display="inline" intent=":literal"><semantics><mn>0.596</mn><annotation encoding="application/x-tex">0.596</annotation></semantics></math></td></tr>
