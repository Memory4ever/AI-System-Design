<td id="S3.T1.2.6.5" class="ltx_td ltx_align_left"><math id="S3.T1.m14" class="ltx_Math" alttext="0.345" display="inline" intent=":literal"><semantics><mn>0.345</mn><annotation encoding="application/x-tex">0.345</annotation></semantics></math></td>
