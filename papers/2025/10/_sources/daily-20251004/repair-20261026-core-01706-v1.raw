<td id="S3.T3.2.8.6" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T3.m21" class="ltx_Math" alttext="0.293" display="inline" intent=":literal"><semantics><mn>0.293</mn><annotation encoding="application/x-tex">0.293</annotation></semantics></math></td></tr>
