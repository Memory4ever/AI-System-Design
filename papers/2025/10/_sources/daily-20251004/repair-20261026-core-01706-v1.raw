<td id="S3.T3.2.4.6" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T3.m9" class="ltx_Math" alttext="0.418" display="inline" intent=":literal"><semantics><mn>0.418</mn><annotation encoding="application/x-tex">0.418</annotation></semantics></math></td></tr>
