<td id="S3.T3.2.10.6" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S3.T3.m27" class="ltx_Math" alttext="0.571" display="inline" intent=":literal"><semantics><mn>0.571</mn><annotation encoding="application/x-tex">0.571</annotation></semantics></math></td></tr>
