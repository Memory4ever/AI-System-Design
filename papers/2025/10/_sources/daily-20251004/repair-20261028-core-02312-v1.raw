<span id="S4.T2.4.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.1.1.1.1.1.2.2.1" class="ltx_text ltx_font_bold">GSM8k-Hard</span></span>
<span id="S4.T2.4.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_rr ltx_border_t"><span id="S4.T2.4.1.1.1.1.1.1.2.3.1" class="ltx_text ltx_font_bold">SVAMP</span></span>
