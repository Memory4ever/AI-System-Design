<span id="S4.T2.4.1.1.1.1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt ltx_rowspan ltx_rowspan_2" style="padding-bottom: 4.30554pt;"><span id="S4.T2.4.1.1.1.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Method</span></span>
<span id="S4.T2.4.1.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_rr ltx_border_tt ltx_colspan ltx_colspan_3" style="padding-bottom: 4.30554pt;">GSM8k-AUG</span>
<span id="S4.T2.4.1.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_3" style="padding-bottom: 4.30554pt;">GSM8k-AUG-NL</span></span>
