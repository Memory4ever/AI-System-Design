<span id="S4.T2.4.1.1.1.1.1.1.4.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.1.1.1.1.1.4.6.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">105.2</span></span>
