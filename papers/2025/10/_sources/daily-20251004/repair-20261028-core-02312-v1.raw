<td id="S5.T5.8.3.5" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.5.1" class="ltx_verbatim ltx_font_typewriter">=</code></td>
<td id="S5.T5.8.3.6" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.6.1" class="ltx_verbatim ltx_font_typewriter">130</code></td>
<td id="S5.T5.8.3.7" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.7.1" class="ltx_verbatim ltx_font_typewriter">0</code></td>
<td id="S5.T5.8.3.8" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.8.1" class="ltx_verbatim ltx_font_typewriter">&gt;&gt;</code></td>
<td id="S5.T5.8.3.9" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.9.1" class="ltx_verbatim ltx_font_typewriter">&lt;&lt;</code></td>
<td id="S5.T5.8.3.10" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.10.1" class="ltx_verbatim ltx_font_typewriter">␣of</code></td>
<td id="S5.T5.8.3.11" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.11.1" class="ltx_verbatim ltx_font_typewriter">0</code></td>
<td id="S5.T5.8.3.12" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.12.1" class="ltx_verbatim ltx_font_typewriter">*</code></td>
<td id="S5.T5.8.3.13" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.13.1" class="ltx_verbatim ltx_font_typewriter">*</code></td>
<td id="S5.T5.8.3.14" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.14.1" class="ltx_verbatim ltx_font_typewriter">&gt;&gt;</code></td>
<td id="S5.T5.8.3.15" class="ltx_td ltx_align_left ltx_border_t"><code id="S5.T5.8.3.15.1" class="ltx_ver