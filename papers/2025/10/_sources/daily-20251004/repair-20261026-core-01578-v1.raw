<th id="S4.T3.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.1.1" class="ltx_text" style="font-size:90%;">ZClip</span></th>
<td id="S4.T3.3.6.2" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.2.1" class="ltx_text" style="font-size:90%;">0.199</span></td>
<td id="S4.T3.3.6.3" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.3.1" class="ltx_text" style="font-size:90%;">0.183</span></td>
<td id="S4.T3.3.6.4" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.4.1" class="ltx_text" style="font-size:90%;">0.168</span></td>
<td id="S4.T3.3.6.5" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.5.1" class="ltx_text" style="font-size:90%;">2.11</span></td>
<td id="S4.T3.3.6.6" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.6.1" class="ltx_text" style="font-size:90%;">1.93</span></td>
<td id="S4.T3.3.6.7" class="ltx_td ltx_align_center" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.6.7.1" class="ltx_text" style="font-size:90%;">1.60</span></td></tr>
<tr id="S4.T3.3.7" class="ltx_tr">
<th id="S4.T3.3.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.7.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Ours</span></th>
<td id="S4.T3.3.7.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.1pt 4.0pt;"><span id="S4.T3.3.7.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.131</span></td>
