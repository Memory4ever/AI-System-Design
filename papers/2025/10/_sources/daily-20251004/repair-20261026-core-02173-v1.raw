<span id="S5.T1.7.1.1.1.23.3" class="ltx_td ltx_align_center">64.4</span>
<span id="S5.T1.7.1.1.1.23.4" class="ltx_td ltx_align_center ltx_border_r">42.3</span>
<span id="S5.T1.7.1.1.1.23.5" class="ltx_td ltx_align_center"><span id="S5.T1.7.1.1.1.23.5.1" class="ltx_text ltx_font_bold">56.4</span></span>
<span id="S5.T1.7.1.1.1.23.6" class="ltx_td ltx_align_center">57.1</span>
