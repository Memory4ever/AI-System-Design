<span id="S5.T1.7.1.1.1.24.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.7.1.1.1.24.2.1" class="ltx_text ltx_font_bold">57.6</span></span>
<span id="S5.T1.7.1.1.1.24.3" class="ltx_td ltx_align_center ltx_border_bb">64.2</span>
