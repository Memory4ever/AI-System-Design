{"data":{"id":"10.48550/arxiv.2510.02272","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.02272","prefix":"10.48550","suffix":"arxiv.2510.02272","identifiers":[{"identifier":"2510.02272","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.02272"}],"creators":[{"name":"Yang, Wen","nameType":"Personal","givenName":"Wen","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Junhong","nameType":"Personal","givenName":"Junhong","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Chong","nameType":"Personal","givenName":"Chong","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zong, Chengqing","nameType":"Personal","givenName":"Chengqing","familyName":"Zong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jiajun","nameType":"Personal","givenName":"Jiajun","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Well Does Mathematical Reasoning Transfer Across Languages in English-Centric LLMs?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-02T17:49:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-03T01:02:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-22T16:06:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-23T01:16:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Recent advances in Reinforcement Post-Training (RPT) have substantially improved the mathematical reasoning capabilities of large language models (LLMs), but it remains unclear how well such gains transfer across languages. In this work, we study cross-lingual mathematical reasoning transfer in English-centric LLMs under controlled multilingual evaluation. We first evaluate a range of English-centric reasoning models on multilingual mathematical reasoning benchmarks and find that transfer is highly variable across initial model choice, target language, and training paradigm. Through controlled comparative experiments, we further find that stronger English-centric initialization does not necessarily lead to stronger relative transfer efficiency, even when it yields higher multilingual reasoning accuracy. Finally, we show that the largest improvement comes from moving beyond English-only supervision: adding a single parallel language yields a substantial gain, while further gains from additional languages are smaller but consistent. Overall, our results highlight the need to evaluate multilingual mathematical reasoning directly, using both absolute performance and relative transfer-efficiency metrics.","descriptionType":"Abstract"},{"description":"Camera ready version for EMNLP 2026 Main","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.02272","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-03T02:09:58.000Z","registered":"2025-10-03T02:09:59.000Z","published":"2025","updated":"2026-10-23T02:50:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.02272","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}