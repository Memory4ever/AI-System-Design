</span>
<span id="lstnumberx116" class="ltx_listingline"><span id="lstnumberx116.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">        </span><span id="lstnumberx116.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">html_type</span><span id="lstnumberx116.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx116.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">"pruned_html"</span><span id="lstnumberx116.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span>
