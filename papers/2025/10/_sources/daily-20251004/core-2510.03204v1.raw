"ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx28.33" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">(123,</span><span id="lstnumberx28.34" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx28.35" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">456)]</span>
</span>
<span id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">&lt;/answer&gt;</span>
</span>
