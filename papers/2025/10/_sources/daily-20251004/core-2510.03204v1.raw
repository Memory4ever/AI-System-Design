<span id="A5.F14.pic1.1.1" class="ltx_p"><span id="A5.F14.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">EmbeddingAgent Partial Observation on WokrArena L1</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.79 15.07)"><foreignObject style="--ltx-fo-width:31.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.16em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="435.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A5.F14.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.5em;">
<span id="A5.F14.pic1.2.1" class="ltx_listing ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx40" class="ltx_listingline"><span id="lstnumberx40.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">Chunk</span><span id="lstnumberx40.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx40.3" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">3:</span>
</span>
<span id="lstnumberx41" class="ltx_listingline"><span id="lstnumberx41.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">                                </span><span id="lstnumberx41.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">StaticText</span><span id="lstnumberx41.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx41.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">’</span><span id="lstnumberx41.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">Back</span><span id="lstnumberx41.6" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">’</span>
</span>
