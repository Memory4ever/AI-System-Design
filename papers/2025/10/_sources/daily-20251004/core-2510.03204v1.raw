</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.79 16.03)"><foreignObject style="--ltx-fo-width:31.5em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.23em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="435.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.F12.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.5em;">
<span id="A4.F12.pic1.2.1" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx8" class="ltx_listingline"><span id="lstnumberx8.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">SYSTEM</span><span id="lstnumberx8.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span>
</span>
