</span>
<span id="lstnumberx32" class="ltx_listingline"><span id="lstnumberx32.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">{goal}</span>
</span>
<span id="lstnumberx33" class="ltx_listingline">
</span>
<span id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">#</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx34.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">History</span><span id="lstnumberx34.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx34.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">of</span><span id="lstnumberx34.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx34.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">interaction</span><span id="lstnumberx34.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx34.9" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">with</span><span id="lstnumberx34.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx34.11" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">the</span><span id="lstnumberx34.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;"> </span><span id="lstnumberx34.13" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">task:</span>
</span>
<span id="lstnumberx35" class="ltx_listingline"><span id="lstnumberx35.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">{history}</span>
</span>
