<span id="A7.F17.pic1.2.1" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx126" class="ltx_listingline"><span id="lstnumberx126.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">SYSTEM</span><span id="lstnumberx126.2" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span>
</span>
<span id="lstnumberx127" class="ltx_listingline"><span id="lstnumberx127.1" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">""</span><span id="lstnumberx127.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#FF8000;">"</span>
</span>
