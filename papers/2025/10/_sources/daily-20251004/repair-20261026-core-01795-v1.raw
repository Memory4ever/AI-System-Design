<td id="S4.T2.1.1.15.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T2.1.1.15.2.1" class="ltx_text ltx_font_bold">0.216</span> <span id="S4.T2.1.1.15.2.2" class="ltx_text" style="font-size:50%;--ltx-fg-color:#009600;">(<math id="S4.T2.m15" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#009600;" mathcolor="#009600" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>13.9%)</span></td>
