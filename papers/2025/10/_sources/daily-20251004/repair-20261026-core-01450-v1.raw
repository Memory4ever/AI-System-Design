<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49Xb.m2" class="ltx_Math" alttext="\displaystyle n^{-1}\sum_{i=1}^{n}K_{H}(X_{i}-x_{0})(f(X_{i})-f(x_{0})-\nabla f(x_{0})^{\top}(X_{i}-x_{0}))=p(x_{0})\mu_{2}(K)\text{tr}\left(H\mathcal{H}_{f}(x_{0})\right)+o_{p}(\text{tr}(H))" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>K</mi><msub><mrow></mrow><mi>H</mi></msub><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo>−</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>−</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo>−</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>=</mo><mi>p</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mi>μ</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo><mtext>tr</mtext><mo>(</mo><mi>H</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mrow></mrow><mi>f</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>+</mo><mi>o</mi><msub><mrow></mrow><mi>p</mi></msub><mo stretchy="false">(</mo><mtext>tr</mtext><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle n^{-1}\sum_{i=1}^{n}K_{H}(X_{i}-x_{0})(f(X_{i})-f(x_{0})-\nabla f(x_{0})^{\top}(X_{i}-x_{0}))=p(x_{0})\mu_{2}(K)\text{tr}\left(H\mathcal{H}_{f}(x_{0})\right)+o_{p}(\text{tr}(H))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49Xc.m2" class="ltx_Math" alttext="\displaystyle n^{-1}\sum_{i=1}^{n}K_{H}(X_{i}-x_{0})(f(X_{i})-f(x_{0})-\nabla f(x_{0})^{\top}(X_{i}-x_{0}))(X_{i}-x_{0})=O_{p}(H^{3/2}\bm{1})," display="inline" intent=":literal"><semantics><mrow><mi>n</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>K</mi><msub><mrow></mrow><mi>H</mi></msub><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo>−</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>−</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo>−</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><mi>i</mi></msub><mo>−</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>=</mo><mi>O</mi><msub><mrow></mrow><mi>p</mi></msub><mo stretchy="false">(</mo><mi>H</mi><msup><mrow></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mn>𝟏</mn><mo stretchy="false">)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle n^{-1}\sum_{i=1}^{n}K_{H}(X_{i}-x_{0})(f(X_{i})-f(x_{0})-\nabla f(x_{0})^{\top}(X_{i}-x_{0}))(X_{i}-x_{0})=O_{p}(H^{3/2}\bm{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p7.1" class="ltx_p"><span id="A2.SS1.p7.1.1" class="ltx_text">where</span></p>
<table id="A2.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex50.m1" class="ltx_Math" alttext="R_{0}(x_{0},H)=\int_{D_{x_{0},H}}K^{2}(u)du,\quad R_{1}(x_{0},H)=\int_{D_{x_{0},H}}K^{2}(u)udu,\quad R_{2}(x_{0},H)=\int_{D_{x_{0},H}}K^{2}(u)uu^{\top}du." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>R</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∫</mo><msub><mi>D</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>H</mi></mrow></msub></msub><mrow><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>R</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∫</mo><msub><mi>D</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>H</mi></mrow></msub></msub><mrow><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>R</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∫</mo><msub><mi>D</mi><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi>H</mi></mrow></msub></msub><mrow><msup><mi>K</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{0}(x_{0},H)=\int_{D_{x_{0},H}}K^{2}(u)du,\quad R_{1}(x_{0},H)=\int_{D_{x_{0},H}}K^{2}(u)udu,\quad R_{2}(x_{0},H)=\int_{D_{x_{0},H}}K^{2}(u)uu^{\top}du.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS1.p8" class="ltx_para ltx_noindent">
<p id="A2.SS1.p8.1" class="ltx_p"><span id="A2.SS1.p8.1.1" class="ltx_text">Then we have the expression of every element in all matrices. A standard blockwise inversion therefore yields</span></p>
<table id="A2.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex51.m1" class="ltx_Math" alttext="\mathrm{Bias}_{\mathrm{LL}}(x)=O_{p}(\|H\|),\quad\mathrm{Var}_{\mathrm{LL}}(x)=O_{p}(\frac{1}{n|H|^{1/2}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Bias</mi><mi>LL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>Var</mi><mi>LL</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>H</mi><mo stretchy="false">|</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Bias}_{\mathrm{LL}}(x)=O_{p}(\|H\|),\quad\mathrm{Var}_{\mathrm{LL}}(x)=O_{p}(\frac{1}{n|H|^{1/2}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p8.2" class="ltx_p"><span id="A2.SS1.p8.2.1" class="ltx_text">uniformly over <math id="A2.SS1.p8.m1" class="ltx_Math" alttext="H\in\mathcal{H}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">H\in\mathcal{H}_{n}</annotation></semantics></math>, proving the claim.</span></p>
</div>
<div id="A2.SS1.p9" class="ltx_para">
<p id="A2.SS1.p9.1" class="ltx_p"><span id="A2.SS1.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Integral Error Estimation</h3>

<div id="A2.SS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.p1.1" class="ltx_p">From Lemma <a href="#A1.Thmlemma2" title="Lemma A.2. ‣ A.2 Point-wise Error Estimation of Local Constant Regression ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> we have that for any <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="x\in D" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">x\in D</annotation></semantics></math>, the pointwise bias of local constant estimator is</p>
<table id="A2.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex52.m1" class="ltx_math_unparsed" alttext="\mathrm{Bias}_{\mathrm{NW}}(x)=\nabla f(x)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)\;+\;O_{p}(\|H\|)." display="block" intent=":literal"><semantics><mrow><msub><mi>Bias</mi><mi>NW</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.502em">+</mo><msub><mi>O</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>H</mi><mo lspace="0em" rspace="0.167em">∥</mo><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Bias}_{\mathrm{NW}}(x)=\nabla f(x)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)\;+\;O_{p}(\|H\|).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p1.2" class="ltx_p">By symmetry of the kernel <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, the first moment satisfies <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="\bar{\mu}_{1}^{\star}(x,H)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\mu}_{1}^{\star}(x,H)=0</annotation></semantics></math> if and only if <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="x\notin\mathcal{B}(H)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\notin\mathcal{B}(H)</annotation></semantics></math>. We will show that if <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> has a sufficiently large normal gradient on a measurable subset of <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\partial D" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">\partial D</annotation></semantics></math>, then <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="\int_{\mathcal{B}(H)}\mathrm{Bias}^{2}_{\mathrm{NW}}(x)dx" display="inline" intent=":literal"><semantics><mrow><msub><mo>∫</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mrow><msubsup><mi>Bias</mi><mi>NW</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\int_{\mathcal{B}(H)}\mathrm{Bias}^{2}_{\mathrm{NW}}(x)dx</annotation></semantics></math> will have a dominant order <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="\Theta(\|H^{3/2}\|)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">‖</mo><msup><mi>H</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">‖</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(\|H^{3/2}\|)</annotation></semantics></math>.</p>
</div>
<div id="A2.SS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.p2.1" class="ltx_p">We begin by lower-bounding <math id="A2.SS2.p2.m1" class="ltx_math_unparsed" alttext="|\nabla f(x)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)|" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\nabla f(x)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)|</annotation></semantics></math>, to do which we first lower-bound <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{*}(y-te(y),H)" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{*}(y-te(y),H)</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma2.2" class="ltx_text ltx_font_bold">Lemma B.2</span></span><span id="A2.Thmlemma2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma2.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmlemma2.p1.1" class="ltx_p"><span id="A2.Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#A1.Thmassumption1" title="Assumption A.1. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, <a href="#A1.Thmassumption3" title="Assumption A.3. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, there exists <math id="A2.Thmlemma2.p1.m1" class="ltx_Math" alttext="\alpha\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1)</annotation></semantics></math>, <math id="A2.Thmlemma2.p1.m2" class="ltx_Math" alttext="c_{*}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mo>∗</mo></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{*}&gt;0</annotation></semantics></math> and <math id="A2.Thmlemma2.p1.m3" class="ltx_Math" alttext="C_{*}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{*}&gt;0</annotation></semantics></math> such that for all sufficiently small <math id="A2.Thmlemma2.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and all <math id="A2.Thmlemma2.p1.m5" class="ltx_Math" alttext="y\in\partial D" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">y\in\partial D</annotation></semantics></math>, all <math id="A2.Thmlemma2.p1.m6" class="ltx_Math" alttext="t\in[0,\alpha h_{n}(y)]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,\alpha h_{n}(y)]</annotation></semantics></math>,</span></p>
<table id="A2.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex53.m1" class="ltx_Math" alttext="|e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{*}(y-te(y),H)|\geq c_{*}h_{n}(y)\qquad||\bar{\mu}_{1}^{*}(y-te(y),H)||\leq C_{*}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mrow><msub><mi>c</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><msub><mi>C</mi><mo>∗</mo></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{*}(y-te(y),H)|\geq c_{*}h_{n}(y)\qquad||\bar{\mu}_{1}^{*}(y-te(y),H)||\leq C_{*}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">Recall <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="D_{x,H}=\{u\in\mathbb{B}^{d}:\ x+H^{1/2}u\in D\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>x</mi><mo>,</mo><mi>H</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>u</mi><mo>∈</mo><msup><mi>𝔹</mi><mi>d</mi></msup></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><mrow><mi>x</mi><mo>+</mo><mrow><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><mo>∈</mo><mi>D</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D_{x,H}=\{u\in\mathbb{B}^{d}:\ x+H^{1/2}u\in D\}</annotation></semantics></math>. For <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="x=y-te(y)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x=y-te(y)</annotation></semantics></math> with <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="y\in\partial D" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">y\in\partial D</annotation></semantics></math>, choose an orthogonal <math id="A2.SS2.p3.m4" class="ltx_Math" alttext="Q(y)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(y)</annotation></semantics></math> such that
<math id="A2.SS2.p3.m5" class="ltx_Math" alttext="Q(y)H^{1/2}e(y)=h_{n}(y)\,e_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>e</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Q(y)H^{1/2}e(y)=h_{n}(y)\,e_{d}</annotation></semantics></math>. Define the rotated domain</span></p>
<table id="A2.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\widetilde{D}_{y,t,H}:=\{\,v\in\mathbb{B}^{d}:\ y-te(y)+H^{1/2}Q(y)v\in D\,\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub><mo>:=</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><mrow><mi>v</mi><mo>∈</mo><msup><mi>𝔹</mi><mi>d</mi></msup></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><mrow><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>∈</mo><mi>D</mi></mrow><mo lspace="0.170em" stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{D}_{y,t,H}:=\{\,v\in\mathbb{B}^{d}:\ y-te(y)+H^{1/2}Q(y)v\in D\,\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">Define the corresponding moments on <math id="A2.SS2.p3.m6" class="ltx_Math" alttext="\widetilde{D}_{y,t,H}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{D}_{y,t,H}</annotation></semantics></math>:</span></p>
<table id="A2.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex55.m1" class="ltx_Math" alttext="\mu_{0,v}^{\star}(y,t,H):=\int_{\widetilde{D}_{y,t,H}}K(u)\,du,\quad\mu_{1,v}^{\star}(y,t,H):=\int_{\widetilde{D}_{y,t,H}}u\,K(u)\,du,\quad\bar{\mu}_{1,v}^{\star}(y,t,H):=\frac{\mu_{1,v}^{\star}(y,t,H)}{\mu_{0,v}^{\star}(y,t,H)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>μ</mi><mrow><mn>0</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><msub><mo>∫</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub></msub><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><msub><mo>∫</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub></msub><mrow><mi>u</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>u</mi></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mfrac><mrow><msubsup><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>μ</mi><mrow><mn>0</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mu_{0,v}^{\star}(y,t,H):=\int_{\widetilde{D}_{y,t,H}}K(u)\,du,\quad\mu_{1,v}^{\star}(y,t,H):=\int_{\widetilde{D}_{y,t,H}}u\,K(u)\,du,\quad\bar{\mu}_{1,v}^{\star}(y,t,H):=\frac{\mu_{1,v}^{\star}(y,t,H)}{\mu_{0,v}^{\star}(y,t,H)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p"><span id="A2.SS2.p3.3.1" class="ltx_text">Then</span></p>
<table id="A2.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\mu_{0,v}^{\star}(y,t,H)=\mu_{0}^{\star}(x,H),\quad Q(y)\,\mu_{1,v}^{\star}(y,t,H)=\mu_{1}^{\star}(x,H),\quad Q(y)\,\bar{\mu}_{1,v}^{\star}(y,t,H)=\bar{\mu}_{1}^{\star}(x,H)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>μ</mi><mrow><mn>0</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>μ</mi><mn>0</mn><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>μ</mi><mn>1</mn><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mu_{0,v}^{\star}(y,t,H)=\mu_{0}^{\star}(x,H),\quad Q(y)\,\mu_{1,v}^{\star}(y,t,H)=\mu_{1}^{\star}(x,H),\quad Q(y)\,\bar{\mu}_{1,v}^{\star}(y,t,H)=\bar{\mu}_{1}^{\star}(x,H),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.4" class="ltx_p"><span id="A2.SS2.p3.4.1" class="ltx_text">and hence</span></p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)=h_{n}(y)\,e_{d}^{\top}\bar{\mu}_{1,v}^{\star}(y,t,H)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>e</mi><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)=h_{n}(y)\,e_{d}^{\top}\bar{\mu}_{1,v}^{\star}(y,t,H).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS2.p4.1" class="ltx_p"><span id="A2.SS2.p4.1.1" class="ltx_text">By the standard signed-distance expansion with shape operator <math id="A2.SS2.p4.m1" class="ltx_Math" alttext="S_{y}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>y</mi></msub><annotation encoding="application/x-tex">S_{y}</annotation></semantics></math> (Assumption <a href="#A1.Thmassumption1" title="Assumption A.1. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>), for <math id="A2.SS2.p4.m2" class="ltx_Math" alttext="v\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">v\in\mathbb{R}^{d}</annotation></semantics></math>,</span></p>
<table id="A2.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex57.m1" class="ltx_Math" alttext="\phi\bigl(y-te(y)+H^{1/2}Q(y)v\bigr)=-t+h_{n}(y)\,v_{d}-\tfrac{1}{2}z_{T}^{\top}S_{y}z_{T}+O(\|H\|^{3/2})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mo>−</mo><mi>t</mi></mrow><mo>+</mo><mrow><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>v</mi><mi>d</mi></msub></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>T</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mi>T</mi></msub></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\phi\bigl(y-te(y)+H^{1/2}Q(y)v\bigr)=-t+h_{n}(y)\,v_{d}-\tfrac{1}{2}z_{T}^{\top}S_{y}z_{T}+O(\|H\|^{3/2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p4.2" class="ltx_p"><span id="A2.SS2.p4.2.1" class="ltx_text">where <math id="A2.SS2.p4.m3" class="ltx_Math" alttext="z_{T}:=(I-e(y)e(y)^{\top})H^{1/2}Q(y)v" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>T</mi></msub><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>−</mo><mrow><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">z_{T}:=(I-e(y)e(y)^{\top})H^{1/2}Q(y)v</annotation></semantics></math> and <math id="A2.SS2.p4.m4" class="ltx_Math" alttext="\|S_{y}\|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">‖</mo><msub><mi>S</mi><mi>y</mi></msub><mo stretchy="false">‖</mo></mrow><annotation encoding="application/x-tex">\|S_{y}\|</annotation></semantics></math> is uniformly bounded. Therefore</span></p>
<table id="A2.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex58.m1" class="ltx_Math" alttext="y-te(y)+H^{1/2}Q(y)v\in D\ \iff\ v_{d}&lt;\frac{t}{h_{n}(y)}+O(\|H\|^{1/2})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>∈</mo><mi>D</mi><mo lspace="0.778em" rspace="0.778em" stretchy="false">⇔</mo><mrow><msub><mi>v</mi><mi>d</mi></msub><mo>&lt;</mo><mrow><mfrac><mi>t</mi><mrow><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y-te(y)+H^{1/2}Q(y)v\in D\ \iff\ v_{d}&lt;\frac{t}{h_{n}(y)}+O(\|H\|^{1/2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p4.3" class="ltx_p"><span id="A2.SS2.p4.3.1" class="ltx_text">so</span></p>
<table id="A2.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\widetilde{D}_{y,t,H}=\Bigl\{\,v\in\mathbb{B}^{d}:\ v_{d}&lt;\frac{t}{h_{n}(y)}+O(\|H\|^{1/2})\,\Bigr\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub><mo>=</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><mrow><mi>v</mi><mo>∈</mo><msup><mi>𝔹</mi><mi>d</mi></msup></mrow><mo lspace="0.278em" rspace="0.778em">:</mo><mrow><msub><mi>v</mi><mi>d</mi></msub><mo>&lt;</mo><mrow><mfrac><mi>t</mi><mrow><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{D}_{y,t,H}=\Bigl\{\,v\in\mathbb{B}^{d}:\ v_{d}&lt;\frac{t}{h_{n}(y)}+O(\|H\|^{1/2})\,\Bigr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p5" class="ltx_para ltx_noindent">
<p id="A2.SS2.p5.1" class="ltx_p"><span id="A2.SS2.p5.1.1" class="ltx_text">Consequently,</span></p>
<table id="A2.Ex60" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex60X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex60X.m2" class="ltx_Math" alttext="\displaystyle\mu_{0,v}^{\star}(y,t,H)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>μ</mi><mrow><mn>0</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu_{0,v}^{\star}(y,t,H)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60X.m3" class="ltx_Math" alttext="\displaystyle=\int_{\widetilde{D}_{y,t,H}}K(v)\,dv" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub></msub></mstyle><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>v</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\widetilde{D}_{y,t,H}}K(v)\,dv</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex60Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{\mathbb{R}^{d-1}}\!\!dv_{1:d-1}\int_{-\sqrt{1-\sum_{i=1}^{d-1}v_{i}^{2}}}^{t/h_{n}(y)}K(v_{1:d-1},v_{d})\,dv_{d}\;+\;O(\|H\|^{1/2})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mi>d</mi><mi>v</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><msubsup><mi>v</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mrow></msub><msup><mrow></mrow><mrow><mrow><mi>t</mi><mo>/</mo><msub><mi>h</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mi>K</mi><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mo rspace="0.170em" stretchy="false">)</mo><mi>d</mi><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mo rspace="0.502em">+</mo><mi>O</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>H</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathbb{R}^{d-1}}\!\!dv_{1:d-1}\int_{-\sqrt{1-\sum_{i=1}^{d-1}v_{i}^{2}}}^{t/h_{n}(y)}K(v_{1:d-1},v_{d})\,dv_{d}\;+\;O(\|H\|^{1/2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex60Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex60Xb.m2" class="ltx_Math" alttext="\displaystyle\geq\int_{\mathbb{R}^{d-1}}\!\!dv_{1:d-1}\int_{-\sqrt{1-\sum_{i=1}^{d-1}v_{i}^{2}}}^{0}K(v_{1:d-1},v_{d})\,dv_{d}\;+\;O(\|H\|^{1/2})." display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mi>d</mi><mi>v</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><msubsup><mi>v</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mrow></msub><msup><mrow></mrow><mn>0</mn></msup><mi>K</mi><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mo rspace="0.170em" stretchy="false">)</mo><mi>d</mi><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mo rspace="0.502em">+</mo><mi>O</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>H</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\int_{\mathbb{R}^{d-1}}\!\!dv_{1:d-1}\int_{-\sqrt{1-\sum_{i=1}^{d-1}v_{i}^{2}}}^{0}K(v_{1:d-1},v_{d})\,dv_{d}\;+\;O(\|H\|^{1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.2" class="ltx_p"><span id="A2.SS2.p5.2.1" class="ltx_text">Using positivity and boundedness of <math id="A2.SS2.p5.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> on <math id="A2.SS2.p5.m2" class="ltx_Math" alttext="\mathbb{B}^{d}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mi>d</mi></msup><annotation encoding="application/x-tex">\mathbb{B}^{d}</annotation></semantics></math>, there exist <math id="A2.SS2.p5.m3" class="ltx_Math" alttext="0&lt;C&lt;D&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>C</mi><mo>&lt;</mo><mi>D</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">0&lt;C&lt;D&lt;\infty</annotation></semantics></math> such that</span></p>
<table id="A2.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E22.m1" class="ltx_Math" alttext="C&lt;\mu_{0,v}^{\star}(y,t,H)&lt;D." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>&lt;</mo><mrow><msubsup><mi>μ</mi><mrow><mn>0</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>D</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C&lt;\mu_{0,v}^{\star}(y,t,H)&lt;D.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p5.3" class="ltx_p"><span id="A2.SS2.p5.3.1" class="ltx_text">Similarly,</span></p>
<table id="A2.Ex61" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex61X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex61X.m2" class="ltx_Math" alttext="\displaystyle e_{d}^{\top}\mu_{1,v}^{\star}(y,t,H)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>e</mi><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle e_{d}^{\top}\mu_{1,v}^{\star}(y,t,H)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61X.m3" class="ltx_Math" alttext="\displaystyle=\int_{\widetilde{D}_{y,t,H}}v_{d}K(v)\,dv" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi></mrow></msub></msub></mstyle><mrow><msub><mi>v</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>v</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\widetilde{D}_{y,t,H}}v_{d}K(v)\,dv</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex61Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{\mathbb{R}^{d-1}}\!\!dv_{1:d-1}\int_{-\sqrt{1-\sum_{i=1}^{d-1}v_{i}^{2}}}^{t/h_{n}(y)}v_{d}\,K(v_{1:d-1},v_{d})\,dv_{d}\;+\;O(\|H\|^{1/2})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup></msub><mi>d</mi><mi>v</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>−</mo><msqrt><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><msubsup><mi>v</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></msqrt></mrow></msub><msup><mrow></mrow><mrow><mrow><mi>t</mi><mo>/</mo><msub><mi>h</mi><mi>n</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mi>K</mi><mo stretchy="false">(</mo><mi>v</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mo rspace="0.170em" stretchy="false">)</mo><mi>d</mi><mi>v</mi><msub><mrow></mrow><mi>d</mi></msub><mo rspace="0.502em">+</mo><mi>O</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>H</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathbb{R}^{d-1}}\!\!dv_{1:d-1}\int_{-\sqrt{1-\sum_{i=1}^{d-1}v_{i}^{2}}}^{t/h_{n}(y)}v_{d}\,K(v_{1:d-1},v_{d})\,dv_{d}\;+\;O(\|H\|^{1/2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex61Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex61Xb.m2" class="ltx_Math" alttext="\displaystyle=:g\!\left(\tfrac{t}{h_{n}(y)}\right)+O(\|H\|^{1/2})." display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">=</mo><mo rspace="0.278em">:</mo><mrow><mrow><mpadded style="width:0.343em;" width="0.343em"><mi>g</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mfrac><mi>t</mi><mrow><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=:g\!\left(\tfrac{t}{h_{n}(y)}\right)+O(\|H\|^{1/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.4" class="ltx_p"><span id="A2.SS2.p5.4.1" class="ltx_text">Note <math id="A2.SS2.p5.m4" class="ltx_Math" alttext="g(0)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g(0)&lt;0</annotation></semantics></math> and <math id="A2.SS2.p5.m5" class="ltx_Math" alttext="g(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\tau)</annotation></semantics></math> decreases as <math id="A2.SS2.p5.m6" class="ltx_Math" alttext="\tau\downarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau\downarrow 0</annotation></semantics></math>. Choose <math id="A2.SS2.p5.m7" class="ltx_Math" alttext="\alpha=\alpha_{1}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><msub><mi>α</mi><mn>1</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha=\alpha_{1}\in(0,1)</annotation></semantics></math> with <math id="A2.SS2.p5.m8" class="ltx_Math" alttext="g(\alpha_{1})&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g(\alpha_{1})&lt;0</annotation></semantics></math>. Then for all <math id="A2.SS2.p5.m9" class="ltx_Math" alttext="t\in[0,\alpha_{1}h_{n}(y)]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,\alpha_{1}h_{n}(y)]</annotation></semantics></math>,</span></p>
<table id="A2.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E23.m1" class="ltx_Math" alttext="e_{d}^{\top}\mu_{1,v}^{\star}(y,t,H)\leq g(\alpha_{1})+O(\|H\|^{1/2})&lt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>e</mi><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">‖</mo><mi>H</mi><mo stretchy="false">‖</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e_{d}^{\top}\mu_{1,v}^{\star}(y,t,H)\leq g(\alpha_{1})+O(\|H\|^{1/2})&lt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A2.SS2.p5.5" class="ltx_p"><span id="A2.SS2.p5.5.1" class="ltx_text">Combining equation <a href="#A2.E22" title="In Proof. ‣ B.2 Integral Error Estimation ‣ Appendix B Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>–equation <a href="#A2.E23" title="In Proof. ‣ B.2 Integral Error Estimation ‣ Appendix B Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>, for small <math id="A2.SS2.p5.m10" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>,</span></p>
<table id="A2.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex62.m1" class="ltx_Math" alttext="\bigl|e_{d}^{\top}\bar{\mu}_{1,v}^{\star}(y,t,H)\bigr|=\frac{|e_{d}^{\top}\mu_{1,v}^{\star}(y,t,H)|}{\mu_{0,v}^{\star}(y,t,H)}\;\geq\;\frac{|g(\alpha_{1})|}{2D}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><msubsup><mi>e</mi><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>=</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>e</mi><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mrow><mn>1</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><msubsup><mi>μ</mi><mrow><mn>0</mn><mo>,</mo><mi>v</mi></mrow><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.558em" rspace="0.558em">≥</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigl|e_{d}^{\top}\bar{\mu}_{1,v}^{\star}(y,t,H)\bigr|=\frac{|e_{d}^{\top}\mu_{1,v}^{\star}(y,t,H)|}{\mu_{0,v}^{\star}(y,t,H)}\;\geq\;\frac{|g(\alpha_{1})|}{2D}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p5.6" class="ltx_p"><span id="A2.SS2.p5.6.1" class="ltx_text">Using equation <a href="#A2.E21" title="In Proof. ‣ B.2 Integral Error Estimation ‣ Appendix B Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a> yields the first bound with <math id="A2.SS2.p5.m11" class="ltx_Math" alttext="c_{*}:=|g(\alpha_{1})|/(2D)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mo>∗</mo></msub><mo>:=</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{*}:=|g(\alpha_{1})|/(2D)</annotation></semantics></math>. The second bound follows from boundedness of <math id="A2.SS2.p5.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and <math id="A2.SS2.p5.m13" class="ltx_Math" alttext="\mathrm{supp}(K)\subset\mathbb{B}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msup><mi>𝔹</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathrm{supp}(K)\subset\mathbb{B}^{d}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.SS2.p6" class="ltx_para ltx_noindent">
<p id="A2.SS2.p6.1" class="ltx_p">Since the leading term of <math id="A2.SS2.p6.m1" class="ltx_Math" alttext="\mathrm{Bias}_{\mathrm{NW}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Bias</mi><mi>NW</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Bias}_{\mathrm{NW}}(x)</annotation></semantics></math> is <math id="A2.SS2.p6.m2" class="ltx_math_unparsed" alttext="\nabla f(x)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla f(x)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(x,H)</annotation></semantics></math>, the lower bound on <math id="A2.SS2.p6.m3" class="ltx_Math" alttext="|e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(y-te(y),H)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mn>1</mn><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|e(y)^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(y-te(y),H)|</annotation></semantics></math> alone does not guarantee order <math id="A2.SS2.p6.m4" class="ltx_Math" alttext="\Theta(\|H^{1/2}\|)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">‖</mo><msup><mi>H</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">‖</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Theta(\|H^{1/2}\|)</annotation></semantics></math>; we also require a sufficiently large normal derivative of <math id="A2.SS2.p6.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> along <math id="A2.SS2.p6.m6" class="ltx_Math" alttext="\partial D" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">\partial D</annotation></semantics></math>.</p>
</div>
<div id="A2.Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition B.1</span></span><span id="A2.Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(Extreme boundary gradient class)<span id="A2.Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition1.p1" class="ltx_para">
<p id="A2.Thmdefinition1.p1.1" class="ltx_p"><span id="A2.Thmdefinition1.p1.1.1" class="ltx_text ltx_font_italic">For any domain <math id="A2.Thmdefinition1.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> and constants <math id="A2.Thmdefinition1.p1.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> and <math id="A2.Thmdefinition1.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, we define a class of functions <math id="A2.Thmdefinition1.p1.m4" class="ltx_Math" alttext="\mathcal{E}(D,m,M)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}(D,m,M)</annotation></semantics></math>, where <math id="A2.Thmdefinition1.p1.m5" class="ltx_Math" alttext="f\in\mathcal{E}(D,m,M)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{E}(D,m,M)</annotation></semantics></math> iff there exist a measurable <math id="A2.Thmdefinition1.p1.m6" class="ltx_Math" alttext="\Gamma\subset\partial D" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo rspace="0.111em">⊂</mo><mrow><mo>∂</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\Gamma\subset\partial D</annotation></semantics></math> with <math id="A2.Thmdefinition1.p1.m7" class="ltx_Math" alttext="S(\Gamma)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S(\Gamma)&gt;0</annotation></semantics></math> and constants <math id="A2.Thmdefinition1.p1.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, <math id="A2.Thmdefinition1.p1.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> such that <math id="A2.Thmdefinition1.p1.m10" class="ltx_Math" alttext="|\partial_{e}f(y)|\geq m" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>e</mi></msub><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">|\partial_{e}f(y)|\geq m</annotation></semantics></math> and <math id="A2.Thmdefinition1.p1.m11" class="ltx_Math" alttext="||\nabla_{T}f(y)||&lt;M" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>T</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>&lt;</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">||\nabla_{T}f(y)||&lt;M</annotation></semantics></math> where <math id="A2.Thmdefinition1.p1.m12" class="ltx_math_unparsed" alttext="\partial_{e}f(y)=\nabla f(y)^{\top}e(y)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>e</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\partial_{e}f(y)=\nabla f(y)^{\top}e(y)</annotation></semantics></math> and <math id="A2.Thmdefinition1.p1.m13" class="ltx_math_unparsed" alttext="\nabla_{T}f(y)=(I-e(y)e(y)^{\top})\nabla f(y)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>T</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>−</mo><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mi>e</mi><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{T}f(y)=(I-e(y)e(y)^{\top})\nabla f(y)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS2.p7" class="ltx_para ltx_noindent">
<p id="A2.SS2.p7.1" class="ltx_p">Then we can prove that if the function to be estimated is within <math id="A2.SS2.p7.m1" class="ltx_Math" alttext="\mathcal{E}(D,m,M)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}(D,m,M)</annotation></semantics></math> where <math id="A2.SS2.p7.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> and <math id="A2.SS2.p7.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> are specifically chosen constants that are independent of <math id="A2.SS2.p7.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, the NW has an integral squared bias with high order.</p>
</div>
<div id="A2.Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmlemma3.2" class="ltx_text ltx_font_bold">Lemma B.3</span></span><span id="A2.Thmlemma3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmlemma3.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmlemma3.p1.1" class="ltx_p"><span id="A2.Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#A1.Thmassumption1" title="Assumption A.1. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, <a href="#A1.Thmassumption2" title="Assumption A.2. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>, and <a href="#A1.Thmassumption3" title="Assumption A.3. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, if <math id="A2.Thmlemma3.p1.m1" class="ltx_Math" alttext="f\in\mathcal{E}(D,m,M)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{E}(D,m,M)</annotation></semantics></math> with</span></p>
<table id="A2.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex63.m1" class="ltx_math_unparsed" alttext="c_{*}^{2}\,\kappa_{1}^{-1}m^{2}-2c_{*}\,\kappa_{1}^{-1/2}C_{*}\,mM\;\geq\;C_{1}&gt;0," display="block" intent=":literal"><semantics><mrow><mi>c</mi><msub><mrow></mrow><mo>∗</mo></msub><msup><mrow></mrow><mn>2</mn></msup><mi>κ</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mi>m</mi><msup><mrow></mrow><mn>2</mn></msup><mo>−</mo><mn>2</mn><mi>c</mi><msub><mrow></mrow><mo>∗</mo></msub><mi>κ</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>C</mi><msub><mrow></mrow><mo>∗</mo></msub><mi>m</mi><mi>M</mi><mo lspace="0.558em" rspace="0.558em">≥</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">c_{*}^{2}\,\kappa_{1}^{-1}m^{2}-2c_{*}\,\kappa_{1}^{-1/2}C_{*}\,mM\;\geq\;C_{1}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmlemma3.p1.2" class="ltx_p"><span id="A2.Thmlemma3.p1.2.1" class="ltx_text ltx_font_italic">then uniformly over <math id="A2.Thmlemma3.p1.m2" class="ltx_Math" alttext="H\in\mathcal{H}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">H\in\mathcal{H}_{n}</annotation></semantics></math>,</span></p>
<table id="A2.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex64.m1" class="ltx_math_unparsed" alttext="\int_{D}\mathrm{Bias}_{\mathrm{NW}}^{2}(x)\,dx=\Omega_{p}(\|H\|^{3/2})\qquad\text{and}\qquad\int_{D}\mathrm{Var}_{\mathrm{NW}}(x)\,dx=\Omega_{p}\!\bigl(n^{-1}|H|^{-1/2}\bigr)." display="block" intent=":literal"><semantics><mrow><msub><mo>∫</mo><mi>D</mi></msub><msubsup><mi>Bias</mi><mi>NW</mi><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><mi>x</mi><mo>=</mo><msub><mi mathvariant="normal">Ω</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>H</mi><msup><mo lspace="0em" rspace="0.167em">∥</mo><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mtext class="ltx_mathvariant_italic">and</mtext><msub><mo>∫</mo><mi>D</mi></msub><msub><mi>Var</mi><mi>NW</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><mi>d</mi><mi>x</mi><mo>=</mo><msub><mi mathvariant="normal">Ω</mi><mi>p</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>H</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{D}\mathrm{Bias}_{\mathrm{NW}}^{2}(x)\,dx=\Omega_{p}(\|H\|^{3/2})\qquad\text{and}\qquad\int_{D}\mathrm{Var}_{\mathrm{NW}}(x)\,dx=\Omega_{p}\!\bigl(n^{-1}|H|^{-1/2}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmremarkx1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremarkx1.2" class="ltx_text ltx_font_bold">Remark</span></span><span id="Thmremarkx1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremarkx1.p1" class="ltx_para">
<p id="Thmremarkx1.p1.1" class="ltx_p"><span id="Thmremarkx1.p1.1.1" class="ltx_text ltx_font_italic">It is easy to construct <math id="Thmremarkx1.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> and <math id="Thmremarkx1.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> satisfying Assumptions <a href="#A1.Thmassumption1" title="Assumption A.1. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, <a href="#A1.Thmassumption2" title="Assumption A.2. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> and <math id="Thmremarkx1.p1.m3" class="ltx_Math" alttext="f\in\mathcal{E}(D,m,M)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{E}(D,m,M)</annotation></semantics></math>. For example, on <math id="Thmremarkx1.p1.m4" class="ltx_Math" alttext="D=\{(x_{1},x_{2}):x_{1}^{2}+x_{2}^{2}\leq 1\}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D=\{(x_{1},x_{2}):x_{1}^{2}+x_{2}^{2}\leq 1\}</annotation></semantics></math>, <math id="Thmremarkx1.p1.m5" class="ltx_Math" alttext="f(x_{1},x_{2})=\frac{\sqrt{c_{1}\kappa_{1}}}{2c_{*}}(x_{1}^{2}+x_{2}^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><msqrt><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>κ</mi><mn>1</mn></msub></mrow></msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mo>∗</mo></msub></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>x</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(x_{1},x_{2})=\frac{\sqrt{c_{1}\kappa_{1}}}{2c_{*}}(x_{1}^{2}+x_{2}^{2})</annotation></semantics></math> works with suitable <math id="Thmremarkx1.p1.m6" class="ltx_Math" alttext="m,M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m,M</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p8" class="ltx_para ltx_noindent">
<p id="A2.SS2.p8.2" class="ltx_p"><span id="A2.SS2.p8.2.1" class="ltx_text">We first lower-bound bias. Choosing <math id="A2.SS2.p8.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> as the minimum <math id="A2.SS2.p8.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> given by Lemmas <a href="#A1.Thmlemma3" title="Lemma A.3. ‣ A.3 Integral Error Estimation of Local Constant Regression ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>, <a href="#A2.Thmlemma2" title="Lemma B.2. ‣ B.2 Integral Error Estimation ‣ Appendix B Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, we have</span></p>
<table id="A2.E24" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E24X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24X.m2" class="ltx_Math" alttext="\displaystyle\int\mathrm{Bias}_{\mathrm{NW}}^{2}(x)dx\geq\int_{\mathcal{B}(H)}\mathrm{Bias}_{\mathrm{NW}}^{2}(x)dx\geq\int_{\mathcal{C}(H,\alpha)}\mathrm{Bias}_{\mathrm{NW}}^{2}(x)dx" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msubsup><mi>Bias</mi><mi>NW</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mstyle><mo>≥</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mstyle><mrow><msubsup><mi>Bias</mi><mi>NW</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mstyle><mrow><msubsup><mi>Bias</mi><mi>NW</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int\mathrm{Bias}_{\mathrm{NW}}^{2}(x)dx\geq\int_{\mathcal{B}(H)}\mathrm{Bias}_{\mathrm{NW}}^{2}(x)dx\geq\int_{\mathcal{C}(H,\alpha)}\mathrm{Bias}_{\mathrm{NW}}^{2}(x)dx</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(24)</span></td></tr>
<tr id="A2.E24Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{\partial D}\int_{0}^{\alpha h_{n}(y)}\mathrm{Bias}_{\mathrm{NW}}^{2}(y-te(y))\text{det}\left(I-tS_{y}\right)dtdS(y)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo>∂</mo><mi>D</mi></mrow></msub></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup></mstyle><mrow><msubsup><mi>Bias</mi><mi>NW</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>det</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>I</mi><mo>−</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>y</mi></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>S</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\partial D}\int_{0}^{\alpha h_{n}(y)}\mathrm{Bias}_{\mathrm{NW}}^{2}(y-te(y))\text{det}\left(I-tS_{y}\right)dtdS(y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E24Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E24Xb.m2" class="ltx_Math" alttext="\displaystyle\geq C_{2}\int_{\Gamma}\int_{0}^{\alpha h_{n}(y)}\left((\nabla f(y-te(y))^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(y-te(y),H))^{2}\;+\;O_{p}(||H^{3/2}||)\right)dtdS(y)," display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi mathvariant="normal">Γ</mi></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>(</mo><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>y</mi><mo>−</mo><mi>t</mi><mi>e</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>H</mi><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mi>y</mi><mo>−</mo><mi>t</mi><mi>e</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><msup><mrow></mrow><mn>2</mn></msup><mo rspace="0.502em">+</mo><mi>O</mi><msub><mrow></mrow><mi>p</mi></msub><mo stretchy="false">(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>H</mi><msup><mrow></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">)</mo><mo>)</mo><mi>d</mi><mi>t</mi><mi>d</mi><mi>S</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq C_{2}\int_{\Gamma}\int_{0}^{\alpha h_{n}(y)}\left((\nabla f(y-te(y))^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(y-te(y),H))^{2}\;+\;O_{p}(||H^{3/2}||)\right)dtdS(y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p8.3" class="ltx_p"><span id="A2.SS2.p8.3.1" class="ltx_text">where the last inequality is derived from Lemma <a href="#A1.Thmlemma2" title="Lemma A.2. ‣ A.2 Point-wise Error Estimation of Local Constant Regression ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> and the boundedness of <math id="A2.SS2.p8.m3" class="ltx_Math" alttext="S_{y}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>y</mi></msub><annotation encoding="application/x-tex">S_{y}</annotation></semantics></math> from Assumption <a href="#A1.Thmassumption1" title="Assumption A.1. ‣ Appendix A Appendix: Proof of Proposition ‣ Local Linear Attention: An Optimal Interpolation of Linear and Softmax Attention For Test-Time Regression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>.</span></p>
</div>
<div id="A2.SS2.p9" class="ltx_para ltx_noindent">
<p id="A2.SS2.p9.1" class="ltx_p"><span id="A2.SS2.p9.1.1" class="ltx_text">For all <math id="A2.SS2.p9.m1" class="ltx_Math" alttext="t\in\alpha h_{n}(y)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in\alpha h_{n}(y)</annotation></semantics></math> and all <math id="A2.SS2.p9.m2" class="ltx_Math" alttext="\eta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in(0,1)</annotation></semantics></math>,</span></p>
