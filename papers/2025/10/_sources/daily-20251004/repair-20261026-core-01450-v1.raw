<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex65X.m2" class="ltx_Math" alttext="\displaystyle\left(\nabla f(y-te(y))^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(y-te(y),H)\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mi>y</mi><mo>−</mo><mi>t</mi><mi>e</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>H</mi><msup><mrow></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mi>y</mi><mo>−</mo><mi>t</mi><mi>e</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo><mo>)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\left(\nabla f(y-te(y))^{\top}H^{1/2}\bar{\mu}_{1}^{\star}(y-te(y),H)\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
