          <span id="algorithm1.4.15.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m26" class="ltx_Math" alttext="L\leftarrow u_{x}\cdot L_{\mathrm{final}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">←</mo><mrow><msub><mi>u</mi><mi>x</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>L</mi><mi>final</mi></msub></mrow></mrow><annotation encoding="application/x-tex">L\leftarrow u_{x}\cdot L_{\mathrm{final}}</annotation></semantics></math>
</div>
