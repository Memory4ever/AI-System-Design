<td id="S3.T1.7.19.8" class="ltx_td ltx_align_center" style="padding:0.75pt 4.0pt;"><math id="S3.T1.m53" class="ltx_Math" alttext="+5.2" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">5.2</mn></mrow><annotation encoding="application/x-tex">+5.2</annotation></semantics></math></td></tr>
