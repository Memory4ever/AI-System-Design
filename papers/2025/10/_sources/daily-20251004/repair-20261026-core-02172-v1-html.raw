<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>An Algorithm of the Per-prompt RESTRAIN Loss Function</h2>

<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>Per-prompt RESTRAIN Loss</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text ltx_font_bold">Input :</span> Responses <math id="algorithm1.m1" class="ltx_Math" alttext="\mathcal{O}=\{o_{1},\dots,o_{n}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>o</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>o</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}=\{o_{1},\dots,o_{n}\}</annotation></semantics></math>; prompt weight <math id="algorithm1.m2" class="ltx_Math" alttext="u_{x}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>x</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u_{x}&gt;0</annotation></semantics></math>; majority threshold <math id="algorithm1.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>; negative offset <math id="algorithm1.m4" class="ltx_Math" alttext="\delta\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta\geq 0</annotation></semantics></math>.
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text ltx_font_bold">Output :</span> Loss <math id="algorithm1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.
</div>
<div id="algorithm1.4.3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
          <math id="algorithm1.m6" class="ltx_Math" alttext="\mathcal{A}=\{a_{1},\dots,a_{m}\}\leftarrow\textnormal{{Set}}([\,\textnormal{{ExtractAnswer}}(o_{i})\,]_{i=1}^{n})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">Set</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mtext class="ltx_mathvariant_monospace">ExtractAnswer</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mi>i</mi></msub><mo rspace="0.170em" stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}=\{a_{1},\dots,a_{m}\}\leftarrow\textnormal{{Set}}([\,\textnormal{{ExtractAnswer}}(o_{i})\,]_{i=1}^{n})</annotation></semantics></math>; <math id="algorithm1.m7" class="ltx_Math" alttext="M(x)\leftarrow\max(\textnormal{{Count}}(a))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_monospace">Count</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M(x)\leftarrow\max(\textnormal{{Count}}(a))</annotation></semantics></math>
</div>
<div id="algorithm1.4.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_bold">2</span></span>
          <span id="algorithm1.4.4.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.4.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m8" class="ltx_Math" alttext="M(x)&lt;\kappa" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">M(x)&lt;\kappa</annotation></semantics></math></em> <span id="algorithm1.4.4.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.5.1" class="ltx_text ltx_font_bold">3</span></span>
          <math id="algorithm1.m9" class="ltx_Math" alttext="r_{i}\leftarrow 0\ \forall i" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mn>0</mn><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}\leftarrow 0\ \forall i</annotation></semantics></math>; <math id="algorithm1.m10" class="ltx_Math" alttext="\mathbf{adv}\leftarrow\textnormal{{CalculateAdvantages}}(\{r_{i}\}_{i=1}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>𝐚𝐝𝐯</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">CalculateAdvantages</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{adv}\leftarrow\textnormal{{CalculateAdvantages}}(\{r_{i}\}_{i=1}^{n})</annotation></semantics></math>; <math id="algorithm1.m11" class="ltx_Math" alttext="adv_{i}\leftarrow adv_{i}-\delta\ \forall i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo stretchy="false">←</mo><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><mi>δ</mi><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">adv_{i}\leftarrow adv_{i}-\delta\ \forall i</annotation></semantics></math>;
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.6.1" class="ltx_text ltx_font_bold">4</span></span>
          <span id="algorithm1.4.6.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m12" class="ltx_Math" alttext="L\leftarrow u_{x}\cdot\textnormal{{CalculateLoss}}(\mathbf{adv})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">←</mo><mrow><mrow><msub><mi>u</mi><mi>x</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext class="ltx_mathvariant_monospace">CalculateLoss</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐚𝐝𝐯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L\leftarrow u_{x}\cdot\textnormal{{CalculateLoss}}(\mathbf{adv})</annotation></semantics></math>
</div>
