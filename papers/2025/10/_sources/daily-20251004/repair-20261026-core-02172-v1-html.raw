          <math id="algorithm1.m17" class="ltx_Math" alttext="Z\leftarrow\sum_{j=1}^{m}\tilde{w}_{j}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo rspace="0.111em" stretchy="false">←</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Z\leftarrow\sum_{j=1}^{m}\tilde{w}_{j}</annotation></semantics></math>; <math id="algorithm1.m18" class="ltx_math_unparsed" alttext="w_{j}\leftarrow\tilde{w}_{j}/Z\ \forall j" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">←</mo><mover accent="true"><mi>w</mi><mo>~</mo></mover><msub><mrow></mrow><mi>j</mi></msub><mo>/</mo><mi>Z</mi><mo lspace="0.667em" rspace="0.167em">∀</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">w_{j}\leftarrow\tilde{w}_{j}/Z\ \forall j</annotation></semantics></math>;
</div>
