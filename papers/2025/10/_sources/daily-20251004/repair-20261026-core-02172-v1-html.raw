            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">12</span></span>
          <math id="algorithm1.m25" class="ltx_Math" alttext="L_{\mathrm{final}}\leftarrow L_{\mathrm{final}}+w_{j}\cdot\ell_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>final</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>L</mi><mi>final</mi></msub><mo>+</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{\mathrm{final}}\leftarrow L_{\mathrm{final}}+w_{j}\cdot\ell_{j}</annotation></semantics></math>
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
