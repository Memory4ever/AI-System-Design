</div>
<div id="algorithm1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.9.1" class="ltx_text ltx_font_bold">7</span></span>
          <math id="algorithm1.m15" class="ltx_Math" alttext="f_{j}\leftarrow c(t_{j})/n" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>j</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">f_{j}\leftarrow c(t_{j})/n</annotation></semantics></math>; <math id="algorithm1.m16" class="ltx_Math" alttext="\tilde{w}_{j}\leftarrow\textnormal{{CalculateWeight}}(f_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>w</mi><mo>~</mo></mover><mi>j</mi></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">CalculateWeight</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{w}_{j}\leftarrow\textnormal{{CalculateWeight}}(f_{j})</annotation></semantics></math>
</div>
