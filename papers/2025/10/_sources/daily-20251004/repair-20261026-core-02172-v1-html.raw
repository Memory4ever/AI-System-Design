<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold">11</span></span>
          <math id="algorithm1.m22" class="ltx_Math" alttext="r_{i}\leftarrow\textnormal{{RewardFn}}(\mathcal{A}[i],\,a_{j})\ \forall i" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">RewardFn</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><msub><mi>a</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}\leftarrow\textnormal{{RewardFn}}(\mathcal{A}[i],\,a_{j})\ \forall i</annotation></semantics></math>; <math id="algorithm1.m23" class="ltx_Math" alttext="\mathbf{adv}\leftarrow\textnormal{{CalculateAdvantages}}(\{r_{i}\}_{i=1}^{n})" display="inline" intent=":literal"><semantics><mrow><mi>𝐚𝐝𝐯</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">CalculateAdvantages</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{adv}\leftarrow\textnormal{{CalculateAdvantages}}(\{r_{i}\}_{i=1}^{n})</annotation></semantics></math>; <math id="algorithm1.m24" class="ltx_Math" alttext="\ell_{j}\leftarrow\textnormal{{CalculateLoss}}(\mathbf{adv})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">CalculateLoss</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐚𝐝𝐯</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell_{j}\leftarrow\textnormal{{CalculateLoss}}(\mathbf{adv})</annotation></semantics></math>;
</div>
