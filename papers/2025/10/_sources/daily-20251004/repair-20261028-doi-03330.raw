{"data":{"id":"10.48550/arxiv.2510.03330","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.03330","prefix":"10.48550","suffix":"arxiv.2510.03330","identifiers":[{"identifier":"2510.03330","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.03330"}],"creators":[{"name":"Wu, Andy","nameType":"Personal","givenName":"Andy","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Chun-Cheng","nameType":"Personal","givenName":"Chun-Cheng","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Yuehua","nameType":"Personal","givenName":"Yuehua","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Liaw, Rung-Tzuo","nameType":"Personal","givenName":"Rung-Tzuo","familyName":"Liaw","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Constant in an Ever-Changing World"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-10-01T18:46:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-07T00:02:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The training process of reinforcement learning often suffers from severe oscillations, leading to instability and degraded performance. In this paper, we propose a Constant in an Ever-Changing World (CIC) framework that enhances algorithmic stability to improve performance. CIC maintains both a representative policy and a current policy. Instead of updating the representative policy blindly, CIC selectively updates it only when the current policy demonstrates superiority. Furthermore, CIC employs an adaptive adjustment mechanism, enabling the representative and current policies to jointly facilitate critic training. We evaluate CIC on five MuJoCo environments, and the results show that CIC improves the performance of conventional algorithms without incurring additional computational cost.","descriptionType":"Abstract"},{"description":"in Chinese language","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.03330","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-07T02:47:18.000Z","registered":"2025-10-07T02:47:19.000Z","published":"2025","updated":"2025-10-07T02:47:19.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.03330","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}