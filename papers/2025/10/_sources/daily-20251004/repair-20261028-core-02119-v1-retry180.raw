<td id="S3.T1.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m1" class="ltx_Math" alttext="\Lambda_{G}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><annotation encoding="application/x-tex">\Lambda_{G}</annotation></semantics></math></td>
<td id="S3.T1.2.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.2" class="ltx_tr">
<th id="S3.T1.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;" rowspan="2"><span id="S3.T1.2.2.1.1" class="ltx_text">
<span id="S3.T1.2.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:26.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:26.2pt;transform:translate(-9.7pt,-9.7pt) rotate(-90deg) ;">
<span id="S3.T1.2.2.1.1.1.1" class="ltx_p"><span id="S3.T1.2.2.1.1.1.1.1" class="ltx_text ltx_font_bold">GDA</span></span>
</span></span></span></th>
<th id="S3.T1.2.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;">Fixed Gaussian GDA</th>
<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m3" class="ltx_Math" alttext="G_{j}\sim\mathrm{N}(0,\Lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{j}\sim\mathrm{N}(0,\Lambda)</annotation></semantics></math></td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math></td>
<td id="S3.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<th id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:1.5pt 4.0pt;">Gaussian mixture GDA</th>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m6" class="ltx_Math" alttext="G_{j}\sim\sum_{i=1}^{k}w_{i}\mathrm{N}(\mu_{i},\Lambda_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>j</mi></msub><mo rspace="0.111em">∼</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>i</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{j}\sim\sum_{i=1}^{k}w_{i}\mathrm{N}(\mu_{i},\Lambda_{i})</annotation></semantics></math></td>
<td id="S3.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m7" class="ltx_Math" alttext="\sum_{i=1}^{k}w_{i}\{\Lambda_{i}+\mu_{i}\mu_{i}^{\top}\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><mrow><msub><mi>w</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>+</mo><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>μ</mi><mi>i</mi><mo>⊤</mo></msubsup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{k}w_{i}\{\Lambda_{i}+\mu_{i}\mu_{i}^{\top}\}</annotation></semantics></math></td>
<td id="S3.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<th id="S3.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;" rowspan="3"><span id="S3.T1.2.4.1.1" class="ltx_text">
<span id="S3.T1.2.4.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:25.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:25.2pt;transform:translate(-9.2pt,-9.2pt) rotate(-90deg) ;">
<span id="S3.T1.2.4.1.1.1.1" class="ltx_p"><span id="S3.T1.2.4.1.1.1.1.1" class="ltx_text ltx_font_bold">TDA</span></span>
</span></span></span></th>
<th id="S3.T1.2.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;">Fixed Gaussian TDA</th>
<td id="S3.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m9" class="ltx_Math" alttext="X_{I_{j}}+Z_{j}\;,\;Z_{j}\sim\mathrm{N}(0,\Lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><msub><mi>I</mi><mi>j</mi></msub></msub><mo>+</mo><msub><mi>Z</mi><mi>j</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>Z</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{I_{j}}+Z_{j}\;,\;Z_{j}\sim\mathrm{N}(0,\Lambda)</annotation></semantics></math></td>
<td id="S3.T1.2.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m10" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math></td>
<td id="S3.T1.2.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.5" class="ltx_tr">
<th id="S3.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:1.5pt 4.0pt;">Random mask TDA</th>
<td id="S3.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m12" class="ltx_Math" alttext="X_{I_{j}}\odot Z_{j}\;,\;Z_{j}\sim\mathrm{Ber}(\rho)^{\otimes d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><msub><mi>I</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>Z</mi><mi>j</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>Z</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>Ber</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{I_{j}}\odot Z_{j}\;,\;Z_{j}\sim\mathrm{Ber}(\rho)^{\otimes d}</annotation></semantics></math></td>
<td id="S3.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m13" class="ltx_Math" alttext="\rho(1-\rho)\operatorname{diag}(C_{X})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho(1-\rho)\operatorname{diag}(C_{X})</annotation></semantics></math></td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m14" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></td></tr>
<tr id="S3.T1.2.6" class="ltx_tr">
<th id="S3.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding:1.5pt 4.0pt;">Salt &amp; Pepper TDA</th>
<td id="S3.T1.2.6.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m15" class="ltx_Math" alttext="X_{I_{j}}\odot Z_{j}+(1-Z_{j})\odot\mathrm{N}(0,\sigma^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><msub><mi>I</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>Z</mi><mi>j</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>Z</mi><mi>j</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msup><mi>σ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{I_{j}}\odot Z_{j}+(1-Z_{j})\odot\mathrm{N}(0,\sigma^{2})</annotation></semantics></math></td>
<td id="S3.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m16" class="ltx_Math" alttext="\rho(1-\rho)\operatorname{diag}(C_{X})+(1-\rho)\sigma^{2}\operatorname{I}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\rho(1-\rho)\operatorname{diag}(C_{X})+(1-\rho)\sigma^{2}\operatorname{I}_{d}</annotation></semantics></math></td>
<td id="S3.T1.2.6.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:1.5pt 4.0pt;"><math id="S3.T1.m17" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1: </span>Various augmentation procedures and corresponding <math id="S3.T1.m21" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and <math id="S3.T1.m22" class="ltx_Math" alttext="\Lambda_{G}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><annotation encoding="application/x-tex">\Lambda_{G}</annotation></semantics></math>. We used the notation <math id="S3.T1.m23" class="ltx_Math" alttext="I_{j}\sim\mathrm{Unif}(\{1,\cdots,n\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{j}\sim\mathrm{Unif}(\{1,\cdots,n\})</annotation></semantics></math>. For more details, we refer to <a href="#A1" title="Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">A</span></a>.</figcaption>
</figure>
<div id="S3.p4" class="ltx_para ltx_noindent">
<p id="S3.p4.1" class="ltx_p">Our second assumption on <math id="S3.p4.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> suppose that <math id="S3.p4.m2" class="ltx_Math" alttext="\mathbf{X}\mapsto\nu_{\mathbf{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><msub><mi>ν</mi><mi>𝐗</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto\nu_{\mathbf{X}}</annotation></semantics></math> and <math id="S3.p4.m3" class="ltx_Math" alttext="\mathbf{X}\mapsto\Lambda_{G}(\mathbf{X})" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto\Lambda_{G}(\mathbf{X})</annotation></semantics></math> are Lipschitz. More precisely:</p>
</div>
<div id="Thmassumption4" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption4.8" class="ltx_text ltx_font_bold">H 4</span></span><span id="Thmassumption4.9" class="ltx_text ltx_font_bold"> </span>(<span id="Thmassumption4.10" class="ltx_text ltx_font_bold">Smoothness of the artificial distribution</span>)<span id="Thmassumption4.11" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption4.p1" class="ltx_para ltx_noindent">
<p id="Thmassumption4.p1.1" class="ltx_p"><span id="Thmassumption4.p1.1.1" class="ltx_text ltx_font_italic">There exist <math id="Thmassumption4.p1.m1" class="ltx_Math" alttext="\mathtt{L}_{G}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝙻</mi><mi>G</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathtt{L}_{G}\geq 0</annotation></semantics></math> and <math id="Thmassumption4.p1.m2" class="ltx_Math" alttext="\mathtt{L}_{\Lambda}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝙻</mi><mi mathvariant="normal">Λ</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathtt{L}_{\Lambda}\geq 0</annotation></semantics></math> such that for any <math id="Thmassumption4.p1.m3" class="ltx_Math" alttext="\mathbf{X},\mathbf{Y}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐗</mi><mo>,</mo><mi>𝐘</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{X},\mathbf{Y}\in\mathbb{R}^{d\times n}</annotation></semantics></math>, and <math id="Thmassumption4.p1.m4" class="ltx_Math" alttext="m\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">m\in\mathbb{N}</annotation></semantics></math>,</span></p>
<table id="S3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="W_{1}(\nu_{\mathbf{X}}^{\otimes m},\nu_{\mathbf{Y}}^{\otimes m})\leq\sqrt{m}\mathtt{L}_{G}\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;,\qquad\|\Lambda_{G}(\mathbf{X})-\Lambda_{G}(\mathbf{Y})\|_{\mathrm{F}}\leq\mathtt{L}_{\Lambda}\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo>,</mo><msubsup><mi>ν</mi><mi>𝐘</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝙻</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>≤</mo><mrow><msub><mi>𝙻</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W_{1}(\nu_{\mathbf{X}}^{\otimes m},\nu_{\mathbf{Y}}^{\otimes m})\leq\sqrt{m}\mathtt{L}_{G}\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;,\qquad\|\Lambda_{G}(\mathbf{X})-\Lambda_{G}(\mathbf{Y})\|_{\mathrm{F}}\leq\mathtt{L}_{\Lambda}\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.p5" class="ltx_para ltx_noindent">
<p id="S3.p5.1" class="ltx_p">Note that the DA examples <a href="#S3.T1" title="In 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a> all satisfy this assumption provided <math id="S3.p5.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has compact support. Otherwise, we believe that our results are robust enough to hold only when <math id="S3.p5.m2" class="ltx_Math" alttext="\Lambda_{G}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><annotation encoding="application/x-tex">\Lambda_{G}</annotation></semantics></math> and <math id="S3.p5.m3" class="ltx_Math" alttext="\mathbf{X}\mapsto\nu_{\mathbf{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><msub><mi>ν</mi><mi>𝐗</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto\nu_{\mathbf{X}}</annotation></semantics></math> are locally Lipschitz, albeit with slightly weaker convergence guarantees.</p>
</div>
<div id="Thmassumption5" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption5.8" class="ltx_text ltx_font_bold">H 5</span></span><span id="Thmassumption5.9" class="ltx_text ltx_font_bold"> </span>(<span id="Thmassumption5.10" class="ltx_text ltx_font_bold">Stability of the artificial distribution</span>)<span id="Thmassumption5.11" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption5.p1" class="ltx_para">
<ol id="S3.I2" class="ltx_enumerate" style="--ltx-enum-leftmargin:15pt;">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S3.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The map </span><math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="\mathbf{X}\mapsto\nu_{\mathbf{X}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo stretchy="false">↦</mo><msub><mi>ν</mi><mi>𝐗</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{X}\mapsto\nu_{\mathbf{X}}</annotation></semantics></math><span id="S3.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> is invariant under
permutation of the columns of </span><math id="S3.I2.i1.p1.m2" class="ltx_Math" alttext="\mathbf{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\mathbf{X}</annotation></semantics></math><span id="S3.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">, i.e., for any
permutation </span><math id="S3.I2.i1.p1.m3" class="ltx_Math" alttext="\varsigma:\{1,\ldots,n\}\to\{1,\ldots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>ς</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varsigma:\{1,\ldots,n\}\to\{1,\ldots,n\}</annotation></semantics></math><span id="S3.I2.i1.p1.1.4" class="ltx_text ltx_font_italic">,
</span><math id="S3.I2.i1.p1.m4" class="ltx_Math" alttext="\nu_{\mathbf{X}}=\nu_{\mathbf{X}_{\varsigma}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>𝐗</mi></msub><mo>=</mo><msub><mi>ν</mi><msub><mi>𝐗</mi><mi>ς</mi></msub></msub></mrow><annotation encoding="application/x-tex">\nu_{\mathbf{X}}=\nu_{\mathbf{X}_{\varsigma}}</annotation></semantics></math><span id="S3.I2.i1.p1.1.5" class="ltx_text ltx_font_italic"> where
</span><math id="S3.I2.i1.p1.m5" class="ltx_Math" alttext="\mathbf{X}_{\varsigma}=[\mathbf{X}_{\varsigma(1)},\ldots,\mathbf{X}_{\varsigma(n)}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐗</mi><mi>ς</mi></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐗</mi><mrow><mi>ς</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝐗</mi><mrow><mi>ς</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{X}_{\varsigma}=[\mathbf{X}_{\varsigma(1)},\ldots,\mathbf{X}_{\varsigma(n)}]</annotation></semantics></math><span id="S3.I2.i1.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S3.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">Furthermore, we assume that there exists </span><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="\mathtt{K}\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>𝙺</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathtt{K}\geq 0</annotation></semantics></math><span id="S3.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, such that for any
</span><math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="m\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">m\in\mathbb{N}</annotation></semantics></math><span id="S3.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">,</span></p>
<table id="S3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E22.m1" class="ltx_Math" alttext="W_{1}(\nu_{X}^{\otimes m},\nu_{X^{-}}^{\otimes m})\leq\sqrt{m}\mathtt{K}\;,\quad\text{a.s.}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ν</mi><mi>X</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo>,</mo><msubsup><mi>ν</mi><msup><mi>X</mi><mo>−</mo></msup><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝙺</mi></mrow></mrow><mo lspace="0.280em" rspace="1.167em">,</mo><mtext class="ltx_mathvariant_italic">a.s.</mtext></mrow><annotation encoding="application/x-tex">W_{1}(\nu_{X}^{\otimes m},\nu_{X^{-}}^{\otimes m})\leq\sqrt{m}\mathtt{K}\;,\quad\text{a.s.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S3.p6" class="ltx_para ltx_noindent">
<p id="S3.p6.1" class="ltx_p">Typically, <math id="S3.p6.m1" class="ltx_Math" alttext="\mathtt{K}" display="inline" intent=":literal"><semantics><mi>𝙺</mi><annotation encoding="application/x-tex">\mathtt{K}</annotation></semantics></math> should remain bounded with respect to both <math id="S3.p6.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="S3.p6.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. <a href="#Thmassumption5" title="H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">5</span></a> can be interpreted as a condition ensuring that the data augmentation procedure used to generate the <math id="S3.p6.m4" class="ltx_Math" alttext="\{G_{j}\}_{j=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>G</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{G_{j}\}_{j=1}^{m}</annotation></semantics></math> does not depend on any specific individual sample. It is met by various data augmentation procedures found in the literature.
We provide in our next result a condition on <math id="S3.p6.m5" class="ltx_Math" alttext="\nu_{X}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\nu_{X}</annotation></semantics></math> and <math id="S3.p6.m6" class="ltx_Math" alttext="\nu_{X^{-}}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><msup><mi>X</mi><mo>−</mo></msup></msub><annotation encoding="application/x-tex">\nu_{X^{-}}</annotation></semantics></math> only, which implies <a href="#Thmassumption5" title="H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">5</span></a>-<a href="#S3.I2.i2" title="Item (ii) ‣ H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(ii)</span></a>. It proof is postponed to <a href="#A1" title="Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_bold">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmproposition2.p1" class="ltx_para">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Suppose that <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="W_{2}(\nu_{X},\nu_{X^{-}})\leq\mathtt{K}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mi>X</mi></msub><mo>,</mo><msub><mi>ν</mi><msup><mi>X</mi><mo>−</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>𝙺</mi></mrow><annotation encoding="application/x-tex">W_{2}(\nu_{X},\nu_{X^{-}})\leq\mathtt{K}</annotation></semantics></math>. Then, <a href="#Thmassumption5" title="H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">5</span></a>-<a href="#S3.I2.i2" title="Item (ii) ‣ H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(ii)</span></a> holds.</span></p>
</div>
</div>
<div id="Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark1.2" class="ltx_text ltx_font_bold">Remark 1</span></span><span id="Thmremark1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark1.p1" class="ltx_para ltx_noindent">
<p id="Thmremark1.p1.1" class="ltx_p"><span id="Thmremark1.p1.1.1" class="ltx_text ltx_font_italic">As a non-trivial example of a DA scheme that satisfies <a href="#Thmassumption4" title="H 4 (Smoothness of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">4</span></a> and <a href="#Thmassumption5" title="H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">5</span></a>, let us consider the Random mask TDA, described in <a href="#S3.T1" title="In 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a>.
We further illustrate our assumptions on other DA strategies in <a href="#A1" title="Appendix A In-depth justification of the hypothesis ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Appendix</span> <span class="ltx_text ltx_ref_tag">A</span></a>. Let <math id="Thmremark1.p1.m1" class="ltx_Math" alttext="\mathbf{X},\mathbf{Y}\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐗</mi><mo>,</mo><mi>𝐘</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{X},\mathbf{Y}\in\mathbb{R}^{d\times n}</annotation></semantics></math>, and consider the coupling of <math id="Thmremark1.p1.m2" class="ltx_Math" alttext="\nu_{\mathbf{X}}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>𝐗</mi></msub><annotation encoding="application/x-tex">\nu_{\mathbf{X}}</annotation></semantics></math> and <math id="Thmremark1.p1.m3" class="ltx_Math" alttext="\nu_{\mathbf{Y}}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>𝐘</mi></msub><annotation encoding="application/x-tex">\nu_{\mathbf{Y}}</annotation></semantics></math>, defined as for <math id="Thmremark1.p1.m4" class="ltx_Math" alttext="j\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\ldots,m\}</annotation></semantics></math>, <math id="Thmremark1.p1.m5" class="ltx_Math" alttext="G_{j}=Z_{j}\odot\mathbf{X}_{I_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>j</mi></msub><mo>=</mo><mrow><msub><mi>Z</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐗</mi><msub><mi>I</mi><mi>j</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">G_{j}=Z_{j}\odot\mathbf{X}_{I_{j}}</annotation></semantics></math>, <math id="Thmremark1.p1.m6" class="ltx_Math" alttext="G^{\prime}_{j}=Z_{j}\odot\mathbf{Y}_{I_{j}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi>j</mi><mo>′</mo></msubsup><mo>=</mo><mrow><msub><mi>Z</mi><mi>j</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><msub><mi>𝐘</mi><msub><mi>I</mi><mi>j</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}_{j}=Z_{j}\odot\mathbf{Y}_{I_{j}}</annotation></semantics></math>, where <math id="Thmremark1.p1.m7" class="ltx_Math" alttext="I_{j}\sim\mathrm{Unif}(\{1,\cdots,n\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{j}\sim\mathrm{Unif}(\{1,\cdots,n\})</annotation></semantics></math>, <math id="Thmremark1.p1.m8" class="ltx_Math" alttext="Z_{j}\sim\mathrm{Ber}(\rho)^{\otimes d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>Ber</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">Z_{j}\sim\mathrm{Ber}(\rho)^{\otimes d}</annotation></semantics></math>, and <math id="Thmremark1.p1.m9" class="ltx_Math" alttext="\odot" display="inline" intent=":literal"><semantics><mo>⊙</mo><annotation encoding="application/x-tex">\odot</annotation></semantics></math> is the elementwise multiplication. Then we have by the Cauchy-Schwarz inequality,</span></p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E23.m1" class="ltx_Math" alttext="\displaystyle W_{1}(\nu_{\mathbf{X}}^{\otimes m},\nu_{\mathbf{Y}}^{\otimes m})\leq\sqrt{m}W_{2}(\nu_{\mathbf{X}},\nu_{\mathbf{Y}})\leq\sqrt{m}\sqrt{\mathbb{E}\left[\|(\mathbf{X}_{I_{1}}-\mathbf{Y}_{I_{1}})\odot Z_{1}\|_{2}^{2}\right]}\leq\sqrt{m}\rho\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ν</mi><mi>𝐗</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo>,</mo><msubsup><mi>ν</mi><mi>𝐘</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mi>𝐗</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>𝐘</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐗</mi><msub><mi>I</mi><mn>1</mn></msub></msub><mo>−</mo><msub><mi>𝐘</mi><msub><mi>I</mi><mn>1</mn></msub></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>Z</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow><mo>≤</mo><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐗</mi><mo>−</mo><mi>𝐘</mi></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle W_{1}(\nu_{\mathbf{X}}^{\otimes m},\nu_{\mathbf{Y}}^{\otimes m})\leq\sqrt{m}W_{2}(\nu_{\mathbf{X}},\nu_{\mathbf{Y}})\leq\sqrt{m}\sqrt{\mathbb{E}\left[\|(\mathbf{X}_{I_{1}}-\mathbf{Y}_{I_{1}})\odot Z_{1}\|_{2}^{2}\right]}\leq\sqrt{m}\rho\|\mathbf{X}-\mathbf{Y}\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="Thmremark1.p1.2" class="ltx_p"><span id="Thmremark1.p1.2.1" class="ltx_text ltx_font_italic">Furthermore, from <a href="#S3.T1" title="In 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a>, we know that <math id="Thmremark1.p1.m10" class="ltx_Math" alttext="\Lambda_{G}(\mathbf{X})=\tfrac{1-\rho}{\rho}\operatorname{diag}(C_{\mathbf{X}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mi>ρ</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>𝐗</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{G}(\mathbf{X})=\tfrac{1-\rho}{\rho}\operatorname{diag}(C_{\mathbf{X}})</annotation></semantics></math>, therefore it is locally-Lipschitz only. However, assuming that <math id="Thmremark1.p1.m11" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is bounded, we can always find another function <math id="Thmremark1.p1.m12" class="ltx_Math" alttext="\tilde{\Lambda}_{G}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>~</mo></mover><mi>G</mi></msub><annotation encoding="application/x-tex">\tilde{\Lambda}_{G}</annotation></semantics></math> satisfying <a href="#Thmassumption3" title="H 3 (Concentration of 𝐺). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">3</span></a>-<a href="#S3.I1.i2" title="Item (ii) ‣ H 3 (Concentration of 𝐺). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">(ii)</span></a> and which is Lipschitz.</span></p>
</div>
<div id="Thmremark1.p2" class="ltx_para">
<p id="Thmremark1.p2.1" class="ltx_p"><span id="Thmremark1.p2.1.1" class="ltx_text ltx_font_italic">We show through similar computations and using <a href="#Thmproposition2" title="Proposition 2. ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2</span></a> that <a href="#Thmassumption5" title="H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">5</span></a> is satisfied</span></p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E24.m1" class="ltx_Math" alttext="\displaystyle W_{2}(\nu_{\mathbf{X}},\nu_{\mathbf{X^{-}}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ν</mi><mi>𝐗</mi></msub><mo>,</mo><msub><mi>ν</mi><msup><mi>𝐗</mi><mo>−</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle W_{2}(\nu_{\mathbf{X}},\nu_{\mathbf{X^{-}}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E24.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{\mathbb{E}\left[\|(X_{I_{1}}-X^{-}_{I_{1}})\odot Z_{1}\|_{2}^{2}\right]}\leq\rho\sqrt{n^{-1}\mathbb{E}\left[\|X_{1}\|_{2}^{2}\right]}=\rho\sqrt{n^{-1}\operatorname{tr}\left(\Sigma_{X}\right)}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>X</mi><msub><mi>I</mi><mn>1</mn></msub></msub><mo>−</mo><msubsup><mi>X</mi><msub><mi>I</mi><mn>1</mn></msub><mo>−</mo></msubsup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>Z</mi><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt><mo>≤</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>X</mi><mn>1</mn></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo>)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{\mathbb{E}\left[\|(X_{I_{1}}-X^{-}_{I_{1}})\odot Z_{1}\|_{2}^{2}\right]}\leq\rho\sqrt{n^{-1}\mathbb{E}\left[\|X_{1}\|_{2}^{2}\right]}=\rho\sqrt{n^{-1}\operatorname{tr}\left(\Sigma_{X}\right)}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.p7" class="ltx_para ltx_noindent">
<p id="S3.p7.3" class="ltx_p">We are now ready to introduce our estimate of <math id="S3.p7.m1" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{Aug}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{Aug}}(\lambda)</annotation></semantics></math>. To this end, for any <math id="S3.p7.m2" class="ltx_Math" alttext="\mathfrak{a}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>𝔞</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathfrak{a}\geq 1</annotation></semantics></math>,</p>
<table id="S3.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E25.m1" class="ltx_Math" alttext="\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}}(\lambda):=\left(\left(1-\alpha\right)C_{X}+\dfrac{\alpha\Lambda_{G}(X)+\alpha\beta C_{X}}{\mathfrak{a}}+\lambda\operatorname{I}_{d}\right)^{-1}\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mi>𝔞</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mfrac><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow></mrow><mi>𝔞</mi></mfrac><mo>+</mo><mrow><mi>λ</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}}(\lambda):=\left(\left(1-\alpha\right)C_{X}+\dfrac{\alpha\Lambda_{G}(X)+\alpha\beta C_{X}}{\mathfrak{a}}+\lambda\operatorname{I}_{d}\right)^{-1}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S3.p7.4" class="ltx_p">where <math id="S3.p7.m3" class="ltx_Math" alttext="\alpha=m/(n+m)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi>m</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha=m/(n+m)</annotation></semantics></math>. In addition, we also consider the quantities</p>
<table id="S3.E26" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E26X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E26X.m2" class="ltx_Math" alttext="\displaystyle\mathfrak{a}_{x}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathfrak{a}_{x}(X)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E26X.m3" class="ltx_Math" alttext="\displaystyle=1+\dfrac{1-(1-\beta/\mathfrak{a}_{g}(X))\alpha}{n}X_{1}^{\top}\mathbb{E}\left[R_{X^{-}\sqcup G}(\lambda)\mid X\right]X_{1}\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>β</mi><mo>/</mo><msub><mi>𝔞</mi><mi>g</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>X</mi><mn>1</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mrow><msup><mi>X</mi><mo>−</mo></msup><mo>⊔</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mn>1</mn></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+\dfrac{1-(1-\beta/\mathfrak{a}_{g}(X))\alpha}{n}X_{1}^{\top}\mathbb{E}\left[R_{X^{-}\sqcup G}(\lambda)\mid X\right]X_{1}\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(26)</span></td></tr>
<tr id="S3.E26Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E26Xa.m2" class="ltx_Math" alttext="\displaystyle\mathfrak{a}_{g}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathfrak{a}_{g}(X)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E26Xa.m3" class="ltx_Math" alttext="\displaystyle=1+\dfrac{\alpha}{m}\operatorname{tr}\left(\{\beta C_{X}+\Lambda_{G}(X)\}\mathbb{E}\left[R_{X\sqcup G}(\lambda)\mid X\right]\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mi>m</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>X</mi></msub></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>R</mi><mrow><mi>X</mi><mo>⊔</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+\dfrac{\alpha}{m}\operatorname{tr}\left(\{\beta C_{X}+\Lambda_{G}(X)\}\mathbb{E}\left[R_{X\sqcup G}(\lambda)\mid X\right]\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.5" class="ltx_p">and the two functions</p>
<table id="S3.E27" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E27X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E27X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{1}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{1}(X)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E27X.m3" class="ltx_Math" alttext="\displaystyle=\dfrac{(1-d/n)}{d}\operatorname{tr}\left(R_{X}(0)\left(\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\lambda\operatorname{I}_{d}\right)^{-1}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo>/</mo><mi>n</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>λ</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{(1-d/n)}{d}\operatorname{tr}\left(R_{X}(0)\left(\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\lambda\operatorname{I}_{d}\right)^{-1}\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(27)</span></td></tr>
<tr id="S3.E27Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E27Xa.m2" class="ltx_Math" alttext="\displaystyle\Phi_{2}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{2}(X)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E27Xa.m3" class="ltx_Math" alttext="\displaystyle=\dfrac{1-(1-\beta/\mathfrak{a}_{g}(X))\alpha}{d\mathfrak{a}_{x}(X)}\operatorname{tr}\left(\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}(\lambda)\left(\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\lambda\operatorname{I}_{d}\right)^{-1}\right)\;," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>β</mi><mo>/</mo><msub><mi>𝔞</mi><mi>g</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔞</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>R</mi><mo>¯</mo></mover><mrow><mi>G</mi><mo fence="false">|</mo><mi>X</mi></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>𝔞</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>λ</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>I</mi><mi>d</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\dfrac{1-(1-\beta/\mathfrak{a}_{g}(X))\alpha}{d\mathfrak{a}_{x}(X)}\operatorname{tr}\left(\bar{\operatorname{R}}_{G\mid X}^{\mathfrak{a}_{g}(X)}(\lambda)\left(\dfrac{\alpha\Lambda_{G}(X)}{\mathfrak{a}_{g}(X)}+\lambda\operatorname{I}_{d}\right)^{-1}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.6" class="ltx_p">Finally, we set</p>
<table id="S3.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E28.m1" class="ltx_Math" alttext="\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda):=\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{\mathrm{Aug}}(\lambda)^{2}\right)-2(\Phi_{1}(X)-\Phi_{2}(X))+\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-2}\right)\;." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Φ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi mathvariant="normal">Σ</mi><mi>X</mi><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda):=\dfrac{1}{d}\operatorname{tr}\left(\operatorname{R}_{\mathrm{Aug}}(\lambda)^{2}\right)-2(\Phi_{1}(X)-\Phi_{2}(X))+\dfrac{1}{d}\operatorname{tr}\left(\Sigma_{X}^{-2}\right)\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Assume <a href="#Thmassumption1" title="H 1 (Concentration of 𝑋). ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">1</span></a> to <a href="#Thmassumption5" title="H 5 (Stability of the artificial distribution). ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span> <span class="ltx_text ltx_ref_tag">5</span></a>. Let <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)</annotation></semantics></math> be defined in (<a href="#S3.E28" title="Equation 28 ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>). Denoting <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="\varepsilon=\min\{\eta,\lambda\}" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>η</mi><mo>,</mo><mi>λ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon=\min\{\eta,\lambda\}</annotation></semantics></math>, for two scalars <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="\tau_{1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\tau_{1}</annotation></semantics></math> and <math id="Thmtheorem2.p1.m4" class="ltx_Math" alttext="\tau_{2}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\tau_{2}</annotation></semantics></math>, (also independant of <math id="Thmtheorem2.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, <math id="Thmtheorem2.p1.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and <math id="Thmtheorem2.p1.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>, and depending polynomially on <math id="Thmtheorem2.p1.m8" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>) defined in (<a href="#A4.E758" title="Equation 758 ‣ D.2.3 Conclusion on the proof of ‣ D.2 Proof of ‣ Appendix D Proof of ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">758</span></a>), it holds</span></p>
<table id="S3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E29.m1" class="ltx_Math" alttext="\mathbb{P}\left(\left|\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)-\mathcal{E}_{\mathrm{Aug}}(\lambda)\right|\geq t+\Delta_{\mathrm{Aug}}\right)\lesssim n\exp\left(-k(n+m)\min\{\varepsilon^{9}t^{2}/\tau_{2},\varepsilon^{7}t/\tau_{1}\}\right)\;," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mrow><mi>t</mi><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>Aug</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>≲</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msup><mi>ε</mi><mn>9</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo>/</mo><msub><mi>τ</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><mrow><msup><mi>ε</mi><mn>7</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>/</mo><msub><mi>τ</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo rspace="0.280em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\left(\left|\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)-\mathcal{E}_{\mathrm{Aug}}(\lambda)\right|\geq t+\Delta_{\mathrm{Aug}}\right)\lesssim n\exp\left(-k(n+m)\min\{\varepsilon^{9}t^{2}/\tau_{2},\varepsilon^{7}t/\tau_{1}\}\right)\;,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where</span></p>
<table id="S3.E30" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E30X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E30X.m2" class="ltx_Math" alttext="\displaystyle\Delta_{\mathrm{Aug}}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>Aug</mi></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{\mathrm{Aug}}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E30X.m3" class="ltx_Math" alttext="\displaystyle\tilde{C}_{1}\dfrac{(\sigma_{X}^{2}+\sigma_{G}^{2})(1+c_{X}^{-1})(\|\Sigma_{X}\|_{\mathrm{op}}^{4}\kappa+\|\Sigma_{X}\|_{\mathrm{op}}\kappa^{4})}{(1-\alpha)n\uplambda_{d}(\Sigma_{X})^{2}\varepsilon^{7}}+\tilde{C}_{2}\dfrac{\mathbb{E}\left[\|\Lambda_{G}(X)-\bar{\Lambda}_{G}\|_{\mathrm{F}}\right]}{\varepsilon^{3}\sqrt{d}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>σ</mi><mi>X</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>σ</mi><mi>G</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msubsup><mi>c</mi><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ε</mi><mn>7</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub><mo>]</mo></mrow></mrow><mrow><msup><mi>ε</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{C}_{1}\dfrac{(\sigma_{X}^{2}+\sigma_{G}^{2})(1+c_{X}^{-1})(\|\Sigma_{X}\|_{\mathrm{op}}^{4}\kappa+\|\Sigma_{X}\|_{\mathrm{op}}\kappa^{4})}{(1-\alpha)n\uplambda_{d}(\Sigma_{X})^{2}\varepsilon^{7}}+\tilde{C}_{2}\dfrac{\mathbb{E}\left[\|\Lambda_{G}(X)-\bar{\Lambda}_{G}\|_{\mathrm{F}}\right]}{\varepsilon^{3}\sqrt{d}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(30)</span></td></tr>
<tr id="S3.E30Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E30Xa.m2" class="ltx_Math" alttext="\displaystyle+\dfrac{\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\sqrt{d}\lambda^{2}}\|\Sigma_{X}\bar{\Lambda}_{G}-\bar{\Lambda}_{G}\Sigma_{X}\|_{\mathrm{F}}\;." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mn>2</mn></msubsup><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\dfrac{\|\Sigma_{X}\|_{\mathrm{op}}^{2}}{\sqrt{d}\lambda^{2}}\|\Sigma_{X}\bar{\Lambda}_{G}-\bar{\Lambda}_{G}\Sigma_{X}\|_{\mathrm{F}}\;.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.3" class="ltx_p"><span id="Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">and the constant <math id="Thmtheorem2.p1.m9" class="ltx_Math" alttext="\tilde{C}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{C}_{1}</annotation></semantics></math> and <math id="Thmtheorem2.p1.m10" class="ltx_Math" alttext="\tilde{C}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mn>2</mn></msub><annotation encoding="application/x-tex">\tilde{C}_{2}</annotation></semantics></math> depend polynomially on <math id="Thmtheorem2.p1.m11" class="ltx_Math" alttext="\uplambda_{d}(\Sigma_{X})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\uplambda_{d}(\Sigma_{X})</annotation></semantics></math>, <math id="Thmtheorem2.p1.m12" class="ltx_Math" alttext="\|\Sigma_{X}\|_{\mathrm{op}}^{-1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><mo stretchy="false">‖</mo></mrow><mi>op</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\|\Sigma_{X}\|_{\mathrm{op}}^{-1}</annotation></semantics></math>, <math id="Thmtheorem2.p1.m13" class="ltx_Math" alttext="\kappa^{-1}" display="inline" intent=":literal"><semantics><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\kappa^{-1}</annotation></semantics></math>, <math id="Thmtheorem2.p1.m14" class="ltx_Math" alttext="n/m" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>/</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">n/m</annotation></semantics></math>, <math id="Thmtheorem2.p1.m15" class="ltx_Math" alttext="\mathtt{K}" display="inline" intent=":literal"><semantics><mi>𝙺</mi><annotation encoding="application/x-tex">\mathtt{K}</annotation></semantics></math>, <math id="Thmtheorem2.p1.m16" class="ltx_Math" alttext="\mathtt{L}_{G}" display="inline" intent=":literal"><semantics><msub><mi>𝙻</mi><mi>G</mi></msub><annotation encoding="application/x-tex">\mathtt{L}_{G}</annotation></semantics></math> and <math id="Thmtheorem2.p1.m17" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.p8" class="ltx_para ltx_noindent">
<p id="S3.p8.1" class="ltx_p">In the statement above, the three contributions to <math id="S3.p8.m1" class="ltx_Math" alttext="\Delta_{\mathrm{Aug}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi>Aug</mi></msub><annotation encoding="application/x-tex">\Delta_{\mathrm{Aug}}</annotation></semantics></math> are small under natural conditions.
The first term decays like <math id="S3.p8.m2" class="ltx_Math" alttext="n^{-1}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">n^{-1}</annotation></semantics></math> provided the covariance matrices <math id="S3.p8.m3" class="ltx_Math" alttext="\Sigma_{X}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\Sigma_{X}</annotation></semantics></math> and <math id="S3.p8.m4" class="ltx_Math" alttext="\Lambda_{G}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{G}(X)</annotation></semantics></math> remain well-conditioned and the fraction of artificial samples stays bounded away from one.
The second term vanishes if the fluctuations of <math id="S3.p8.m5" class="ltx_Math" alttext="\Lambda_{G}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{G}(X)</annotation></semantics></math> are adequately controlled.
Finally, the third term is negligible only when <math id="S3.p8.m6" class="ltx_Math" alttext="\bar{\Lambda}_{G}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><annotation encoding="application/x-tex">\bar{\Lambda}_{G}</annotation></semantics></math> approximately commutes with <math id="S3.p8.m7" class="ltx_Math" alttext="\Sigma_{X}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\Sigma_{X}</annotation></semantics></math>,
for instance, when the eigenvectors of <math id="S3.p8.m8" class="ltx_Math" alttext="\Sigma_{X}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\Sigma_{X}</annotation></semantics></math> are known, when the augmentation is isotropic on average (so that <math id="S3.p8.m9" class="ltx_Math" alttext="\bar{\Lambda}_{G}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><annotation encoding="application/x-tex">\bar{\Lambda}_{G}</annotation></semantics></math> is a scalar matrix),
or more generally when <math id="S3.p8.m10" class="ltx_Math" alttext="\bar{\Lambda}_{G}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Λ</mi><mo>¯</mo></mover><mi>G</mi></msub><annotation encoding="application/x-tex">\bar{\Lambda}_{G}</annotation></semantics></math> splits into a low-rank component plus a multiple of the identity (as in Gaussian mixture augmentations with few components relative to <math id="S3.p8.m11" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, c.f. <a href="#S3.T1" title="In 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">table</span> <span class="ltx_text ltx_ref_tag">1</span></a>).</p>
</div>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Numerical experiments</h2>

<div id="S4.p1" class="ltx_para ltx_noindent">
<p id="S4.p1.1" class="ltx_p">In this section, we illustrate <a href="#Thmtheorem1" title="Theorem 1. ‣ 2 Inverse covariance estimation using shrinkage method ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1</span></a> and <a href="#Thmtheorem2" title="Theorem 2. ‣ 3 Precision matrix estimation using generic data augmentation ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a> on real datasets. We use MNIST and CIFAR10, consisting of <math id="S4.p1.m1" class="ltx_Math" alttext="70{,}000" display="inline" intent=":literal"><semantics><mn>70,000</mn><annotation encoding="application/x-tex">70{,}000</annotation></semantics></math> labeled <math id="S4.p1.m2" class="ltx_Math" alttext="28\times 28" display="inline" intent=":literal"><semantics><mrow><mn>28</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>28</mn></mrow><annotation encoding="application/x-tex">28\times 28</annotation></semantics></math> images and <math id="S4.p1.m3" class="ltx_Math" alttext="60{,}000" display="inline" intent=":literal"><semantics><mn>60,000</mn><annotation encoding="application/x-tex">60{,}000</annotation></semantics></math> labeled <math id="S4.p1.m4" class="ltx_Math" alttext="32\times 32" display="inline" intent=":literal"><semantics><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>32</mn></mrow><annotation encoding="application/x-tex">32\times 32</annotation></semantics></math> images, respectively, with the following preprocessing:</p>
<ol id="S4.I1" class="ltx_enumerate" style="--ltx-enum-leftmargin:15pt;">
<li id="S4.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S4.I1.ix1.1" class="ltx_text ltx_font_bold">MNIST.</span></span> 
<div id="S4.I1.ix1.p1" class="ltx_para ltx_noindent">
<p id="S4.I1.ix1.p1.1" class="ltx_p">We discard the labels, normalize pixel values to <math id="S4.I1.ix1.p1.m1" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>, and add pixel-level Gaussian noise with standard deviation <math id="S4.I1.ix1.p1.m2" class="ltx_Math" alttext="\sigma=0.1" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\sigma=0.1</annotation></semantics></math> to ensure that the covariance matrix <math id="S4.I1.ix1.p1.m3" class="ltx_Math" alttext="\Sigma_{X}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>X</mi></msub><annotation encoding="application/x-tex">\Sigma_{X}</annotation></semantics></math> is well-conditioned.</p>
</div></li>
<li id="S4.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="S4.I1.ix2.1" class="ltx_text ltx_font_bold">CIFAR10.</span></span> 
<div id="S4.I1.ix2.p1" class="ltx_para">
<p id="S4.I1.ix2.p1.1" class="ltx_p">We discard the labels and convert images to grayscale.</p>
</div></li>
</ol>
</div>
<div id="S4.p2" class="ltx_para ltx_noindent">
<p id="S4.p2.1" class="ltx_p">For both datasets, we denote by <math id="S4.p2.m1" class="ltx_Math" alttext="X=[X_{1},\dots,X_{n}]\in\mathbb{R}^{d\times n}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X=[X_{1},\dots,X_{n}]\in\mathbb{R}^{d\times n}</annotation></semantics></math> the matrix formed by the first <math id="S4.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> samples, for varying <math id="S4.p2.m3" class="ltx_Math" alttext="n&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n&gt;0</annotation></semantics></math>. To approximate <math id="S4.p2.m4" class="ltx_Math" alttext="\mathcal{E}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}(\lambda)</annotation></semantics></math> and <math id="S4.p2.m5" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{Aug}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{Aug}}(\lambda)</annotation></semantics></math>, we use the sample covariance matrix <math id="S4.p2.m6" class="ltx_Math" alttext="\hat{\Sigma}_{X}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>^</mo></mover><mi>X</mi></msub><annotation encoding="application/x-tex">\hat{\Sigma}_{X}</annotation></semantics></math> computed from all available samples (<math id="S4.p2.m7" class="ltx_Math" alttext="70{,}000" display="inline" intent=":literal"><semantics><mn>70,000</mn><annotation encoding="application/x-tex">70{,}000</annotation></semantics></math> for MNIST, <math id="S4.p2.m8" class="ltx_Math" alttext="60{,}000" display="inline" intent=":literal"><semantics><mn>60,000</mn><annotation encoding="application/x-tex">60{,}000</annotation></semantics></math> for CIFAR10), and consider the proxies</p>
<table id="S4.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E31.m1" class="ltx_Math" alttext="\mathcal{E}_{X}^{\mathcal{D}}(\lambda):=\frac{1}{d}\bigl\|\operatorname{R}_{X}(\lambda)-\hat{\Sigma}_{X}^{-1}\bigr\|_{\mathrm{F}}^{2}\quad\text{and}\quad\mathcal{E}_{\mathrm{Aug}}^{\mathcal{D}}(\lambda):=\frac{1}{d}\bigl\|\operatorname{R}_{\mathrm{Aug}}(\lambda)-\hat{\Sigma}_{X}^{-1}\bigr\|_{\mathrm{F}}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>^</mo></mover><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>d</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mi>R</mi><mi>Aug</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>^</mo></mover><mi>X</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}^{\mathcal{D}}(\lambda):=\frac{1}{d}\bigl\|\operatorname{R}_{X}(\lambda)-\hat{\Sigma}_{X}^{-1}\bigr\|_{\mathrm{F}}^{2}\quad\text{and}\quad\mathcal{E}_{\mathrm{Aug}}^{\mathcal{D}}(\lambda):=\frac{1}{d}\bigl\|\operatorname{R}_{\mathrm{Aug}}(\lambda)-\hat{\Sigma}_{X}^{-1}\bigr\|_{\mathrm{F}}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="S4.p2.2" class="ltx_p">which are expected to closely approximate <math id="S4.p2.m9" class="ltx_Math" alttext="\mathcal{E}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}(\lambda)</annotation></semantics></math> and <math id="S4.p2.m10" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{Aug}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{Aug}}(\lambda)</annotation></semantics></math> since the sample size greatly exceeds the data dimension.</p>
</div>
<div id="S4.p3" class="ltx_para ltx_noindent">
<p id="S4.p3.1" class="ltx_p"><a href="#S4.F1" title="In 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1</span></a> summarizes our results for MNIST. In particular, <a href="#S4.F1.sf1" title="In Figure 1 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">figure</span> <span class="ltx_text ltx_ref_tag">1(a)</span></a> reports <math id="S4.p3.m1" class="ltx_Math" alttext="\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">↦</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)</annotation></semantics></math> for various <math id="S4.p3.m2" class="ltx_Math" alttext="\gamma=784/n" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mn>784</mn><mo>/</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\gamma=784/n</annotation></semantics></math> over <math id="S4.p3.m3" class="ltx_Math" alttext="\lambda\in[10^{-3},1]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[10^{-3},1]</annotation></semantics></math>, and compares it with the proxy above. <a href="#S4.F1.sf2" title="In Figure 1 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1(b)</span></a> and <a href="#S4.F1.sf3" title="In Figure 1 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">1(c)</span></a> present <math id="S4.p3.m4" class="ltx_Math" alttext="\hat{\mathcal{E}}_{\mathrm{Aug}}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{\mathrm{Aug}}(0)</annotation></semantics></math> as a function of <math id="S4.p3.m5" class="ltx_Math" alttext="\alpha=m/(n+m)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi>m</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha=m/(n+m)</annotation></semantics></math> under two data-augmentation schemes. The first is a <math id="S4.p3.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-centroid Gaussian-mixture GDA,</p>
<table id="S4.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E32.m1" class="ltx_Math" alttext="G_{j}=m_{I_{j}}(X)+\sigma\mathrm{N}(0,\operatorname{I}_{d})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>j</mi></msub><mo>=</mo><mrow><mrow><msub><mi>m</mi><msub><mi>I</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">G_{j}=m_{I_{j}}(X)+\sigma\mathrm{N}(0,\operatorname{I}_{d}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="S4.p3.2" class="ltx_p">where the centroids <math id="S4.p3.m7" class="ltx_Math" alttext="\{m_{i}\}_{i=1}^{k}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>m</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></msubsup><annotation encoding="application/x-tex">\{m_{i}\}_{i=1}^{k}</annotation></semantics></math> are estimated via EM on <math id="S4.p3.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S4.p3.m9" class="ltx_Math" alttext="I_{j}\sim\mathrm{Unif}(\{1,\dots,k\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{j}\sim\mathrm{Unif}(\{1,\dots,k\})</annotation></semantics></math>. The second is a Gaussian-noise TDA,</p>
<table id="S4.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E33.m1" class="ltx_Math" alttext="G_{j}=X_{I_{j}}+\sigma\mathrm{N}(0,\operatorname{I}_{d})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>j</mi></msub><mo>=</mo><mrow><msub><mi>X</mi><msub><mi>I</mi><mi>j</mi></msub></msub><mo>+</mo><mrow><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>I</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">G_{j}=X_{I_{j}}+\sigma\mathrm{N}(0,\operatorname{I}_{d}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="S4.p3.3" class="ltx_p">with <math id="S4.p3.m10" class="ltx_Math" alttext="I_{j}\sim\mathrm{Unif}(\{1,\dots,n\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{j}\sim\mathrm{Unif}(\{1,\dots,n\})</annotation></semantics></math>. In both cases, the minimizers of <math id="S4.p3.m11" class="ltx_Math" alttext="\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">↦</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)</annotation></semantics></math> and <math id="S4.p3.m12" class="ltx_Math" alttext="\lambda\mapsto\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">↦</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\mapsto\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)</annotation></semantics></math> are consistently close to those of the proxies <math id="S4.p3.m13" class="ltx_Math" alttext="\mathcal{E}_{X}^{\mathcal{D}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}^{\mathcal{D}}(\lambda)</annotation></semantics></math> and <math id="S4.p3.m14" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{Aug}}^{\mathcal{D}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{Aug}}^{\mathcal{D}}(\lambda)</annotation></semantics></math>, which should very closely approximate the true errors.</p>
</div>
<div id="S4.p4" class="ltx_para ltx_noindent">
<p id="S4.p4.1" class="ltx_p">Symmetrically, for CIFAR10 (after grayscale conversion, so <math id="S4.p4.m1" class="ltx_Math" alttext="d=1024" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1024</mn></mrow><annotation encoding="application/x-tex">d=1024</annotation></semantics></math>),
<a href="#S4.F2.sf1" title="In Figure 2 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">figure</span> <span class="ltx_text ltx_ref_tag">2(a)</span></a> reports
<math id="S4.p4.m2" class="ltx_Math" alttext="\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">↦</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)</annotation></semantics></math> for various <math id="S4.p4.m3" class="ltx_Math" alttext="\gamma=1024/n" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mn>1024</mn><mo>/</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\gamma=1024/n</annotation></semantics></math> over <math id="S4.p4.m4" class="ltx_Math" alttext="\lambda\in[10^{-3},1]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[10^{-3},1]</annotation></semantics></math>
and compares it with the proxy in (<a href="#S4.E31" title="Equation 31 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>).
<a href="#S4.F2.sf2" title="In Figure 2 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figures</span> <span class="ltx_text ltx_ref_tag">2(b)</span></a> and <a href="#S4.F2.sf3" title="Figure 2(c) ‣ Figure 2 ‣ 4 Numerical experiments ‣ Non-Asymptotic Analysis Of Data Augmentation For Precision Matrix Estimation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2(c)</span></a> present
<math id="S4.p4.m5" class="ltx_Math" alttext="\hat{\mathcal{E}}_{\mathrm{Aug}}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{E}}_{\mathrm{Aug}}(0)</annotation></semantics></math> as a function of <math id="S4.p4.m6" class="ltx_Math" alttext="\alpha=m/(n+m)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mi>m</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha=m/(n+m)</annotation></semantics></math> under the same
<math id="S4.p4.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-centroid Gaussian-mixture GDA and Gaussian-noise TDA schemes as above.
In all cases, the minimizers of <math id="S4.p4.m8" class="ltx_Math" alttext="\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">↦</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\mapsto\hat{\mathcal{E}}_{X}(\lambda)</annotation></semantics></math> and
<math id="S4.p4.m9" class="ltx_Math" alttext="\lambda\mapsto\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo stretchy="false">↦</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>^</mo></mover><mi>Aug</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\mapsto\hat{\mathcal{E}}_{\mathrm{Aug}}(\lambda)</annotation></semantics></math> closely match those of the proxies
<math id="S4.p4.m10" class="ltx_Math" alttext="\mathcal{E}_{X}^{\mathcal{D}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>X</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{X}^{\mathcal{D}}(\lambda)</annotation></semantics></math> and <math id="S4.p4.m11" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{Aug}}^{\mathcal{D}}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>Aug</mi><mi class="ltx_font_mathcaligraphic">𝒟</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{Aug}}^{\mathcal{D}}(\lambda)</annotation></semantics></math>.</p>
</div>
