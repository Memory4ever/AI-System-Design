<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E301.m1" class="ltx_Math" alttext="\displaystyle\leq\dfrac{2}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>R</mi><mi>X</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟙</mn><msub><mi>𝖠</mi><mi>η</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\dfrac{2}{\lambda d}\left|\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)-\mathbb{E}\left[\operatorname{tr}\left(\operatorname{R}_{X}(0)\right)\mathbbm{1}_{\mathsf{A}_{\eta}}(X)\right]\right|</annotation></semantics></math></td>
